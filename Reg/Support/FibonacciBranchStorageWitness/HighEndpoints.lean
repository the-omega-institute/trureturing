theorem suffixU11 (r : ℕ) (hr : r ≤ 86) :
    compose ((high true).drop r) hiU =
      eval (valuesU11[r]'(by change r < 87; omega)) := by
  exact suffix_table (high true) valuesU11 (by decide) recurrenceU11 r hr


theorem certHigh (i : Bool) : EndpointCertificate budget loU hiU (high i) (colors i) := by
  intro r hr
  have bound : r < 86 := by rw [lengths.2.2.2.2 i] at hr; exact hr
  refine ⟨⟨suffix_supported .G1 .G1 (high i) (legal.2.2.1 i) loU endpoint_support.1 r,?_⟩,
    ⟨suffix_supported .G1 .G1 (high i) (legal.2.2.1 i) hiU endpoint_support.2.1 r,?_⟩⟩
  all_goals cases i
  all_goals simp only [colors_false,colors_true]
  all_goals simp only [max_le_iff,suffixU00 r bound.le,suffixU01 r bound.le,
    suffixU10 r bound.le,suffixU11 r bound.le]
  all_goals interval_cases r
  all_goals norm_num [valuesU00,valuesU01,valuesU10,valuesU11,high,colors,returns,returnWord,returnColors,repeatWord,block,U,C,
    colorsD,colorsE,loU,hiU,compose_eval,composePair,step,shiftPair,budget,eval,cut,T2,lam,g,phi,max_le_iff]
  all_goals repeat' constructor
  all_goals linarith [precise_t.1,precise_t.2]


