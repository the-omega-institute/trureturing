theorem recurrenceV11 :
    List.zipWith step (low true) valuesV11.tail = valuesV11.take 86 := by
  norm_num [valuesV11,low,returns,returnWord,repeatWord,block,V,C,
    step,shiftPair,List.zipWith,List.take,List.tail]

theorem suffixV11 (r : ℕ) (hr : r ≤ 86) :
    compose ((low true).drop r) hiV =
      eval (valuesV11[r]'(by change r < 87; omega)) := by
  exact suffix_table (low true) valuesV11 (by decide) recurrenceV11 r hr


theorem certLow (i : Bool) : EndpointCertificate budget loV hiV (low i) (colors i) := by
  intro r hr
  have bound : r < 86 := by rw [lengths.2.2.2.2 i] at hr; exact hr
  refine ⟨⟨suffix_supported .G1 .G1 (low i) (legal.2.2.2 i) loV endpoint_support.2.2.1 r,?_⟩,
    ⟨suffix_supported .G1 .G1 (low i) (legal.2.2.2 i) hiV endpoint_support.2.2.2 r,?_⟩⟩
  all_goals cases i
  all_goals simp only [colors_false,colors_true]
  all_goals simp only [max_le_iff,suffixV00 r bound.le,suffixV01 r bound.le,
    suffixV10 r bound.le,suffixV11 r bound.le]
  all_goals interval_cases r
  all_goals norm_num [valuesV00,valuesV01,valuesV10,valuesV11,low,colors,returns,returnWord,returnColors,repeatWord,block,V,C,
    colorsD,colorsE,loV,hiV,compose_eval,composePair,step,shiftPair,budget,eval,cut,T2,lam,g,phi,max_le_iff]
  all_goals repeat' constructor
  all_goals linarith [precise_t.1,precise_t.2]


