import LeanInformationAuditInterface.Contract.Registration
import D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality
import Reg.Support.DependentFamily
import Reg.Support.FieldLift

/-! Source-bound audit of generation by the Lotka–Volterra integrals. -/

namespace Reg.D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality

open _root_.D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality
open _root_.D5.S3.ConceptDynamics.InformationEscape.DependentFamily

set_option autoImplicit false
set_option relaxedAutoImplicit false
noncomputable section
universe u

/-- Observe the intermediate field generated by a set in the rational function field. -/
abbrev signature : Signature where
  Params := Σ F : Type u, Σ _ : Field F, ℕ
  State p := letI := p.2.1; Set (FunctionField p.1 p.2.2)
  Role := Unit
  finiteRole := inferInstance
  nonemptyRole := inferInstance
  Output _ p := letI := p.2.1; IntermediateField p.1 (FunctionField p.1 p.2.2)
  Anchor := Empty
  finiteAnchor := inferInstance

def actual : Realization signature.{u} :=
  realize signature (fun _ p s => letI := p.2.1; IntermediateField.adjoin p.1 s)
    (fun e => nomatch e)

def rejected : Realization signature.{u} :=
  realize signature (fun _ p _ => letI := p.2.1; ⊥) (fun e => nomatch e)

/-- Retain the complete field, characteristic and dimension telescope of `claim`. -/
abbrev arena : Arena where
  signature := signature.{u}
  Law r := ∀ (F : Type u) [field : Field F] [CharZero F] (n : ℕ), 2 ≤ n →
    r.readout () ⟨F, field, n⟩ (Set.range (inputs F n)) = ⊤

private theorem bottom_ne_top (F : Type u) [Field F] :
    (⊥ : IntermediateField F (FunctionField F 2)) ≠ ⊤ := by
  intro h
  let z : FunctionField F 2 :=
    algebraMap (MvPolynomial (Fin 2) F) _ (MvPolynomial.X (0 : Fin 2))
  have hz : z ∈ (⊥ : IntermediateField F (FunctionField F 2)) := by
    rw [h]
    trivial
  obtain ⟨a, ha⟩ := IntermediateField.mem_bot.mp hz
  have hp : MvPolynomial.C a = (MvPolynomial.X (0 : Fin 2) : MvPolynomial (Fin 2) F) := by
    apply IsFractionRing.injective (MvPolynomial (Fin 2) F) (FunctionField F 2)
    calc
      algebraMap (MvPolynomial (Fin 2) F) (FunctionField F 2) (MvPolynomial.C a) =
          algebraMap F (FunctionField F 2) a := by
        rw [IsScalarTower.algebraMap_apply F (MvPolynomial (Fin 2) F) (FunctionField F 2),
          MvPolynomial.algebraMap_eq]
      _ = _ := ha
  have hc := congrArg
    (fun p : MvPolynomial (Fin 2) F => p.coeff (Finsupp.single (0 : Fin 2) 1)) hp
  have hn : (Finsupp.single (0 : Fin 2) 1 : Fin 2 →₀ ℕ) ≠ 0 := by
    intro he
    have hh := congrArg (fun d : Fin 2 →₀ ℕ => d 0) he
    simp at hh
  exact zero_ne_one (by
    simpa only [MvPolynomial.coeff_C_of_ne_zero hn, MvPolynomial.coeff_X_same] using hc)

theorem rejected_law : ¬ arena.{u}.Law rejected := by
  intro h
  exact bottom_ne_top (ULift.{u} ℚ) (h (ULift.{u} ℚ) 2 (by decide))

theorem dependence : ObservationalDependence signature.{u} actual := by
  intro i
  refine ⟨⟨ULift.{u} ℚ, inferInstance, 2⟩, ∅, Set.univ, ?_⟩
  change IntermediateField.adjoin (ULift.{u} ℚ) (∅ : Set (FunctionField (ULift.{u} ℚ) 2)) ≠
    IntermediateField.adjoin (ULift.{u} ℚ) Set.univ
  simpa only [IntermediateField.adjoin_empty, IntermediateField.adjoin_univ] using
    bottom_ne_top (ULift.{u} ℚ)

def source_registration : Registration arena.{u} claim.{u} where
  actual := actual
  bridge := Iff.rfl
  variation := ⟨result, rejected, rejected_law⟩
  sensitivity := by
    constructor
    · intro i
      exact ⟨rejected, fun j hj => (hj (Subsingleton.elim j i)).elim, rfl, rejected_law⟩
    · intro e
      exact nomatch e
  dependence := dependence

def registration :
    LeanInformationAudit.Contract.Registration.{_, _, _, 0, 0, 0, _, _, _, _, _, 0}
      (@_root_.D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality.result.{u})
      (Realization signature.{u}) Unit Unit := {
  unitName := `Reg.D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality.unit
  realizationName :=
    `Reg.D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality.source_registration
  realizationSource := none
  generated := false
  arena := .source ⟨arena.{u}⟩
  objectArena := .source ⟨arena.{u}⟩
  catalog := Lean.Name.anonymous
  localNames := false
  realization := .source arena.{u} ⟨source_registration.{u}⟩
  correspondence := { stage := .evidence, objectStage := .evidence }
  bundleNonempty := .absent
  readout := some
    (realize signature.{u}
      (fun _ p s => letI := p.2.1; IntermediateField.adjoin p.1 s)
      (fun e => nomatch e))
  variation := .absent
  sensitivity := .absent
  partialSensitivity := none
  escapeFrom := none
  sourceSelection := some {
    owner := `D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality
    definition := some {
      owner := `D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality
      name := `D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality.claim
      path := #[] }
    coordinates := #[0, 3]
    readouts := #[{
      path := #["body", "body", "body", "body", "body", "fn", "arg"]
      stateBinder := 0
      functionOperand := false
      stateOperand := some #["arg"]
      booleanPredicate := false }] }
  continuation := .unknown
  familyRecord := none
  options := #[] }

#print axioms source_registration
#print axioms registration

end
end Reg.D5.S3.FluidDynamics.Solitons.LotkaVolterraIntegralBirationality
