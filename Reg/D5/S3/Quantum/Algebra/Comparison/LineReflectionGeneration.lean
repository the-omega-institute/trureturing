import LeanInformationAuditInterface.Contract.Registration
import D5.S3.Quantum.Algebra.Comparison.LineReflectionGeneration
import Reg.Support.DependentFamily
import Mathlib.Analysis.InnerProductSpace.PiL2

/-! Source-bound audit of the subgroup generated by the line reflections of a finite-dimensional
real inner product space. The readout is the determinant of the isometry. -/

namespace Reg.D5.S3.Quantum.Algebra.Comparison.LineReflectionGeneration

open _root_.D5.S3.Quantum.Algebra.Comparison.LineReflectionGeneration
open _root_.D5.S3.ConceptDynamics.InformationEscape.DependentFamily
open Module Submodule

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option linter.style.longLine false
noncomputable section
universe u

/-- A real inner product space in universe `u`: the carrier and its two dictionaries. -/
abbrev Params := Σ F : Type u, Σ _ : NormedAddCommGroup F, InnerProductSpace ℝ F

/-- The isometries of the space, observed through their determinant. -/
abbrev signature : Signature where
  Params := Params.{u}
  State p := letI := p.2.1; letI := p.2.2; p.1 ≃ₗᵢ[ℝ] p.1
  Role := Unit
  finiteRole := inferInstance
  nonemptyRole := inferInstance
  Output _ _ := ℝ
  Anchor := Empty
  finiteAnchor := inferInstance

/-- The determinant of an isometry, as a real number. -/
def observe (p : Params.{u}) : signature.{u}.State p → ℝ :=
  letI := p.2.1; letI := p.2.2
  fun g => LinearMap.det (g.toLinearEquiv : p.1 →ₗ[ℝ] p.1)

def actual : Realization signature.{u} :=
  realize signature (fun _ => observe) (fun e => nomatch e)

/-- The constant reading `0`. -/
def rejected : Realization signature.{u} :=
  realize signature (fun _ _ _ => 0) (fun e => nomatch e)

/-- Retain the complete space, dictionary, isometry and conclusion telescope of
`mem_closure_lineReflections_iff`; only the determinant is read out. -/
abbrev arena : Arena where
  signature := signature.{u}
  Law r := ∀ {F : Type u} [i₁ : NormedAddCommGroup F] [i₂ : InnerProductSpace ℝ F]
    [FiniteDimensional ℝ F] (g : F ≃ₗᵢ[ℝ] F),
    g ∈ Subgroup.closure {ρ : F ≃ₗᵢ[ℝ] F | ∃ v : F, v ≠ 0 ∧ ρ = (ℝ ∙ v).reflection} ↔
      Even (Module.finrank ℝ F) ∨ r.readout () ⟨F, i₁, i₂⟩ g = 1

/-- The real line `ℝ¹` in universe `u`. -/
abbrev Line := EuclideanSpace ℝ (ULift.{u} (Fin 1))

theorem finrank_line : Module.finrank ℝ Line.{u} = 1 := by
  rw [finrank_euclideanSpace, Fintype.card_ulift, Fintype.card_fin]

/-- With the constant reading `0`, the identity of the line would have to fail to lie in the
generated subgroup, since the dimension one is odd. -/
theorem rejected_law : ¬ arena.{u}.Law rejected := by
  intro h
  have hh := (h (F := Line.{u}) 1).1 (Subgroup.one_mem _)
  rw [finrank_line] at hh
  rcases hh with hh | hh
  · exact Nat.not_even_one hh
  · exact zero_ne_one hh

/-- On the line, the identity has determinant `1` and `-1` has determinant `-1`. -/
theorem dependence : ObservationalDependence signature.{u} actual := by
  intro i
  cases i
  refine ⟨⟨Line.{u}, inferInstance, inferInstance⟩, 1, LinearIsometryEquiv.neg ℝ, ?_⟩
  change LinearMap.det ((1 : Line.{u} ≃ₗᵢ[ℝ] Line.{u}).toLinearEquiv : Line.{u} →ₗ[ℝ] Line.{u}) ≠
    LinearMap.det ((LinearIsometryEquiv.neg ℝ : Line.{u} ≃ₗᵢ[ℝ] Line.{u}).toLinearEquiv :
      Line.{u} →ₗ[ℝ] Line.{u})
  have h1 : LinearMap.det ((1 : Line.{u} ≃ₗᵢ[ℝ] Line.{u}).toLinearEquiv :
      Line.{u} →ₗ[ℝ] Line.{u}) = 1 := LinearMap.det_id
  rw [h1, ← reflection_bot, det_reflection, bot_orthogonal_eq_top, finrank_top, finrank_line]
  norm_num

/-- The exact statement of the source theorem. -/
abbrev sourceStatement : Prop := type_of% @mem_closure_lineReflections_iff.{u}

def source_registration : Registration arena.{u} sourceStatement.{u} where
  actual := actual
  bridge := Iff.rfl
  variation := ⟨@mem_closure_lineReflections_iff.{u}, rejected, rejected_law⟩
  sensitivity := by
    constructor
    · intro i
      exact ⟨rejected, fun j hj => (hj (Subsingleton.elim j i)).elim, rfl, rejected_law⟩
    · intro e
      exact nomatch e
  dependence := dependence

def mem_closure_lineReflections_iff_registration :
    LeanInformationAudit.Contract.Registration.{_, _, _, 0, 0, 0, _, _, _, _, _, 0}
      (@mem_closure_lineReflections_iff.{u}) (Realization signature.{u}) Unit Unit := {
  unitName := `Reg.D5.S3.Quantum.Algebra.Comparison.LineReflectionGeneration.mem_closure_lineReflections_iff_unit
  realizationName := `Reg.D5.S3.Quantum.Algebra.Comparison.LineReflectionGeneration.source_registration
  realizationSource := none
  generated := false
  arena := .source ⟨arena.{u}⟩
  objectArena := .source ⟨arena.{u}⟩
  catalog := Lean.Name.anonymous
  localNames := false
  realization := .source arena.{u} ⟨source_registration.{u}⟩
  correspondence := { stage := .evidence, objectStage := .evidence }
  bundleNonempty := .absent
  readout := some (realize signature.{u} (fun _ => observe) (fun e => nomatch e))
  variation := .absent
  sensitivity := .absent
  partialSensitivity := none
  escapeFrom := none
  sourceSelection := some {
    owner := `D5.S3.Quantum.Algebra.Comparison.LineReflectionGeneration
    definition := none
    coordinates := #[0]
    readouts := #[{
      path := #["body", "body", "body", "body", "body", "arg", "arg", "fn", "arg"]
      stateBinder := 4
      functionOperand := false
      stateOperand := none
      booleanPredicate := false }] }
  continuation := .unknown
  familyRecord := none
  options := #[] }

end
end Reg.D5.S3.Quantum.Algebra.Comparison.LineReflectionGeneration
