<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>StrataLint.ArchitectureTests</RootNamespace>
    <AssemblyName>StrataLint.ArchitectureTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../StrataLint.Engine/StrataLint.Engine.csproj" />
    <ProjectReference Include="../../StrataLint.Cli/StrataLint.Cli.csproj" />
    <ProjectReference Include="../../StrataLint.Scribe/StrataLint.Scribe.csproj" />
    <ProjectReference Include="../../StrataLint.Scribe.Documents/StrataLint.Scribe.Documents.csproj" />
    <ProjectReference Include="../../StrataLint.EngineeringScope/StrataLint.EngineeringScope.csproj" />
    <ProjectReference Include="../StrataLint.Tests/StrataLint.Tests.csproj" />
    <ProjectReference Include="../StrataLint.EngineeringScope.Tests/StrataLint.EngineeringScope.Tests.csproj" />
    <ProjectReference Include="../StrataLint.Scribe.Documents.Tests/StrataLint.Scribe.Documents.Tests.csproj" />
    <ProjectReference Include="../StrataLint.Scribe.Tests/StrataLint.Scribe.Tests.csproj" />
    <!-- The official analyzer is admitted because compiler diagnostics enforce source
         calls before binaries exist. Reflection is sufficient for assembly and type
         architecture, so ArchUnitNET and NetArchTest are not admitted. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
