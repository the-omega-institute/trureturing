<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>StrataLint.Scribe</RootNamespace>
    <AssemblyName>StrataLint.Scribe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../StrataLint.Engine/StrataLint.Engine.csproj" />
    <ProjectReference Include="../Trureturing.Truth/Trureturing.Truth.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" GeneratePathProperty="true" />
    <None Include="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.BannedApiAnalyzers.dll"
          Link="Scripting/Microsoft.CodeAnalysis.BannedApiAnalyzers.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PkgMicrosoft_CodeAnalysis_BannedApiAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll"
          Link="Scripting/Microsoft.CodeAnalysis.CSharp.BannedApiAnalyzers.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Architecture/BannedSymbols*.txt" Link="Scripting/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Vendor/Katex/katex.min.js" LogicalName="katex.min.js" />
    <PackageReference Include="Jint" />
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Tomlyn" />
    <AdditionalFiles Include="../Architecture/BannedSymbols.txt" />
    <AdditionalFiles Include="../Architecture/BannedSymbols.Determinism.txt" />
    <AdditionalFiles Include="../Architecture/BannedSymbols.Guid.txt" />
  </ItemGroup>
</Project>
