+        old.theoremValue.type == entry.theoremValue.type &&
+        old.theoremValue.value == entry.theoremValue.value)) Array.push }
+
+private def retainCompilerTheoremInjective (env : Environment) (name : Name) : Environment :=
+  match env.find? name with
+  | some (.thmInfo theoremValue) =>
+      compilerProducedTheoremsInjective.addEntry env { owner := env.header.mainModule, theoremValue }
+  | _ => env
+
