    {
      "id": "a11-computed-default-stop",
      "kind": "behavioral",
      "target": "LeanInformationAudit.Tests.RegistrationGates.Round7ComputedStatement",
      "mutation": "Treat an unresolved registered statement head as a completed recognized stop, recreating the round-7 default admission.",
      "before": "  return .unclassified \u27e8\"unclassified_statement_head\", name,\n    namespaceLabel (\u2190 getEnv) name, (\u2190 get).theoremName\u27e9",
      "after": "  return .recognized (witness .statementInductive head)",
      "predicted_red_names": [
        "ComputedRegisteredProof",
        "ComputedRegisteredNominalPayload",
        "ComputedRegisteredDecision",
        "ComputedRegisteredProofDiagnostic",
        "ComputedRegisteredNominalPayloadDiagnostic",
        "ComputedRegisteredDecisionDiagnostic"
      ]
    },
    {
      "id": "a11-carrier-default-kind",
      "kind": "behavioral",
      "target": "LeanInformationAudit.Tests.RegistrationGates.Round7PackedConsumer",
      "mutation": "Default-admit nominal carrier-valued and abstract fields by their kind, recreating the round-7 unaudited external carrier boundary.",
      "before": "            if carrierValued ||\n                (concrete.isFVar && !parameter && !auditedFamily) then",
      "after": "            if false && (carrierValued ||\n                (concrete.isFVar && !parameter && !auditedFamily)) then",
      "predicted_red_names": [
        "PackedCarrierHidden",
        "PackedCarrierOpaqueClean",
        "PackedCarrierHiddenDiagnostic",
        "PackedCarrierOpaqueCleanDiagnostic"
      ]
    },
    {
      "id": "a11-own-clean-prop-argument",
      "kind": "behavioral",
      "target": "LeanInformationAudit.Tests.RegistrationGates.AllowlistRules",
      "mutation": "Classify every Prop-typed argument as allowlisted immediately after bounded inference, bypassing its statement type check. visitOccurrence still erases the proof body; direct application identity check is retained.",
      "before": "    let some type \u2190 occurrenceType occurrence | return .incomplete\n    let exact \u2190 exactScalarStatement type",
      "after": "    let some type \u2190 occurrenceType occurrence | return .incomplete\n    let some proof \u2190 boundedMeta (Meta.isProp type) `mutant_prop_clean | return .incomplete\n    if proof then return .allowlisted (witness .proofBoundary type)\n    let exact \u2190 exactScalarStatement type",
      "predicted_red_names": [
        "ImportedLibraryPrivateProof",
        "IndependentProofConstant",
        "ClosedStatementInhabitant",
        "InlineClosedStatementInhabitant",
        "NominalLiteral"
      ]
    },
    {
      "id": "a11-own-remove-classical-choice",
      "kind": "behavioral",
      "target": "LeanInformationAudit.Tests.RegistrationGates.AllowlistRules",
      "mutation": "Remove executable Classical namespace rejection; retain the independent unlisted_decision_producer fallback. Predict diagnostic-class assertion reds, not false admission.",
      "before": "    if pos == .dataPos && n.getRoot == `Classical then\n      noteUnclassified \u27e8\"classical_choice\", n, namespaceLabel env n, origin\u27e9",
      "after": "    if false && pos == .dataPos && n.getRoot == `Classical then\n      noteUnclassified \u27e8\"classical_choice\", n, namespaceLabel env n, origin\u27e9",
      "predicted_red_names": [
        "ClassicalDirect",
        "TypeBeforeClassicalData",
        "UnclassifiedPayloadParses"
      ]
    },
