namespace CensusForgedProvenance

abbrev arena : StructuralArena := ⟨Nat⟩
def lawArena : StructuralPrimitiveLawArena arena where
  signature := ⟨Unit, inferInstance, fun _ => Nat⟩
  Law r := r.readout () 0 = r.readout () 1
def readouts : StructuralPrimitiveRealization arena lawArena.signature :=
  ⟨fun _ n => n / 2 + 5⟩
theorem nondegenerate : lawArena.Nondegenerate := by
  refine ⟨readouts, ⟨fun _ n => n⟩, rfl, ?_⟩
  exact Nat.zero_ne_one

theorem ordinary : lawArena.Law readouts := rfl
def unit := readouts.toTheoremUnit (lawArena.Law readouts) ordinary
def testCatalog : StructuralCatalog arena :=
  ⟨Unit, inferInstance, inferInstance, fun _ => unit⟩
theorem registration : StructuralRegistrationEvidence ``ordinary
    arena unit testCatalog () (lawArena.Law readouts) := ⟨rfl, rfl⟩
def witness : StructuralStrictnessCertificate testCatalog () where
  inclusion := by intro _ _ _ i ne; exact (ne rfl).elim
  left := 0
  right := 2
  without_agrees := by intro i ne; exact (ne rfl).elim
  full_separates := by
    intro full
    have impossible : (5 : Nat) = 6 := full () (Set.mem_univ ()) ()
    exact (by decide : (5 : Nat) ≠ 6) impossible
theorem strictness : testCatalog.StructurallyLowersEscape () :=
  testCatalog.structurallyLowersEscape_of_certificate () witness
def inventory : DispositionInventory := ⟨"forged-head", #[
  ⟨⟨``ordinary, "ordinary-id"⟩, .structuralOccurrence
    ⟨``arena, ``registration, ``readouts, ``strictness, ``witness⟩⟩]⟩

-- The pass-5 private-name lookup and coherent addEntry attack.
run_cmd do
  let env ← getEnv
  let some (registryName, _) := env.constants.toList.find? (fun (name, _) =>
      privateToUserName? name == some `LeanInformationAudit.DispositionCensus.structuralRegistry)
    | throwError "private structural registry not found"
  let registryId := mkIdent registryName
  elabCommand (← `(command| run_cmd do
    let info ← getConstInfo ``ordinary
    let some proof := info.value? (allowOpaque := true) | throwError "missing proof"
    -- Preserve the pass-5 record shape: the omitted syntax field must default
    -- into the public provenance check, where this ordinary-theorem entry is rejected.
    let entry : StructuralProvenanceEntry := {
      theoremName := ``ordinary
      lawArenaConst := ``lawArena
      realizationConst := ``readouts
      unitConst := ``unit
      statementExpr := info.type
      proofExpr := proof
      levelParams := info.levelParams
      certificateName := ``nondegenerate
      registrationModule := (← getEnv).header.mainModule
      canonicalArena := ``arena }
    modifyEnv fun current => ($registryId).addEntry current entry))

/--
info: IE-C037 DispositionClassMismatch theorem=CensusForgedProvenance.ordinary class=structural_occurrence invalid=realization.provenance.syntax
---
info: rejected=true output-absent=true certificate-absent=true
-/
#guard_msgs in
run_cmd do
  expectRejectedCensus (← getEnv).header.mainModule ``inventory `forgedCoverage inventory
    (classError ``ordinary "structural_occurrence" "realization.provenance.syntax")

end CensusForgedProvenance

namespace CensusQuotedProvenance

abbrev arena : StructuralArena := RegisteredClosedTruth.arena
def law : StructuralPrimitiveLawArena arena := RegisteredClosedTruth.lawArena

-- Even invoking the real generator from run_cmd is not a source declaration.
run_cmd elabCommand (← `(command|
  structural_theorem generated in law realization RegisteredClosedTruth.readouts
    nondegeneracy RegisteredClosedTruth.nondegenerate := rfl))

def testCatalog : StructuralCatalog arena :=
  ⟨Unit, inferInstance, inferInstance, fun _ => generated.__structural_unit⟩
theorem registration : StructuralRegistrationEvidence ``generated
    arena generated.__structural_unit testCatalog () (law.Law RegisteredClosedTruth.readouts) :=
  ⟨rfl, rfl⟩
def witness : StructuralStrictnessCertificate testCatalog () := RegisteredClosedTruth.witness
theorem strictness : testCatalog.StructurallyLowersEscape () :=
  testCatalog.structurallyLowersEscape_of_certificate () witness
def inventory : DispositionInventory := ⟨"quoted-head", #[
  ⟨⟨``generated, "quoted-id"⟩, .structuralOccurrence
    ⟨``arena, ``registration, ``generated.__structural_realization, ``strictness, ``witness⟩⟩]⟩

/--
info: IE-C037 DispositionClassMismatch theorem=CensusQuotedProvenance.generated class=structural_occurrence invalid=realization.provenance.syntax
---
info: rejected=true output-absent=true certificate-absent=true
-/
#guard_msgs in
run_cmd do
  expectRejectedCensus (← getEnv).header.mainModule ``inventory `quotedCoverage inventory
    (classError ``generated "structural_occurrence" "realization.provenance.syntax")

end CensusQuotedProvenance
