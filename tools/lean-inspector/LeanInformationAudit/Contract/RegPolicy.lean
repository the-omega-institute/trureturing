/-- Extract the actual final call position in the three pinned skeletons. -/
def catalogCall (command : Syntax) : Option Syntax := do
  guard (command.getKind == `Lean.runCmd)
  let mut items := command[1][0].getArgs
  if items.size == 1 && items[0]![0].isOfKind ``Parser.Term.doNested then
    items := items[0]![0][1][0].getArgs
  let last ← items.back?
  guard (last[0].isOfKind ``Parser.Term.doExpr)
  let call := last[0][0]
  guard (call.isOfKind ``Parser.Term.app && call[0].isIdent)
  guard (call[1].getArgs.size == 1)
  return call

end LeanInformationAudit.Contract.RegPolicy
