/-- Source-info-free syntax identity; identifiers, atoms, kinds and child order
all contribute. Hashing never expands syntax or executes a source command. -/
partial def syntaxKey (s : Syntax) : String :=
  if s.isIdent then "id:" ++ reprStr s.getId
  else if s.isAtom then "atom:" ++ reprStr s.getAtomVal
  else "node:" ++ reprStr s.getKind ++ "[" ++
    String.intercalate "," (s.getArgs.toList.map syntaxKey) ++ "]"

def fingerprint (s : Syntax) : String := Sha256.hex (syntaxKey s).toUTF8

