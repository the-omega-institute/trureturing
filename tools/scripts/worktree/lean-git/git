#!/usr/bin/env python3
"""Run reader Git diffs against disposable indexes; forward other commands intact."""
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


def command_offset(arguments):
    position = 0
    while position < len(arguments) and arguments[position].startswith("-"):
        argument = arguments[position]
        if argument in ("-h", "--help", "-v", "--version", "--exec-path",
                        "--html-path", "--man-path", "--info-path"):
            return len(arguments)
        position += 2 if argument in ("-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env") else 1
    return position


def main():
    git = os.environ["STRATALINT_LEAN_READER_GIT"]
    if not Path(git).is_absolute() or Path(git).resolve() == Path(__file__).resolve():
        raise ValueError("reader Git executable must be an absolute native executable")
    arguments = sys.argv[1:]
    offset = command_offset(arguments)
    if offset >= len(arguments) or arguments[offset] != "diff" or "--no-index" in arguments[offset + 1:]:
        os.execv(git, [git, *arguments])
    prefix = arguments[:offset]
    probe = subprocess.run([git, *prefix, "rev-parse", "--path-format=absolute", "--git-path", "index"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, close_fds=False)
    if probe.returncode != 0:
        os.execv(git, [git, *arguments])
    index = Path(os.fsdecode(probe.stdout.removesuffix(b"\n")))
    with tempfile.TemporaryDirectory(prefix="lean-git-index-") as directory:
        temporary_index = Path(directory) / "index"
        try:
            shutil.copyfile(index, temporary_index)
        except FileNotFoundError:
            pass
        environment = dict(os.environ, GIT_INDEX_FILE=str(temporary_index))
        # Refresh stat data in the private index. Keep a split index from writing
        # a new sharedindex file into the dependency's actual Git directory.
        result = subprocess.run([git, *prefix, "-c", "diff.autoRefreshIndex=true",
                                 "-c", "core.splitIndex=false", *arguments[offset:]],
                                env=environment, close_fds=False)
        return result.returncode if result.returncode >= 0 else 128 - result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError) as error:
        print("lean-git: " + str(error), file=sys.stderr)
        sys.exit(2)
