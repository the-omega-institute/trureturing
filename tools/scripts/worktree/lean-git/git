#!/usr/bin/env python3
"""Use local pinned Git sources and disposable diff indexes for Lake readers."""
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile


def command_offset(arguments):
    position = 0
    while position < len(arguments) and arguments[position].startswith("-"):
        argument = arguments[position]
        if argument in ("-h", "--help", "-v", "--version", "--exec-path",
                        "--html-path", "--man-path", "--info-path"):
            return len(arguments)
        position += 2 if argument in ("-C", "-c", "--git-dir", "--work-tree", "--namespace", "--config-env") else 1
    return position


def main_package_source(git, package):
    root = package.parents[2]
    result = subprocess.run([git, "-C", str(root), "worktree", "list", "--porcelain", "-z"],
                            stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    paths = [Path(os.fsdecode(field.removeprefix(b"worktree "))) for field in result.stdout.split(b"\0")
             if field.startswith(b"worktree ")]
    if result.returncode == 0 and root in paths[1:]:
        source = paths[0] / ".lake" / "packages" / package.name
        if source.resolve() == source and (source / ".git").is_dir() and not (source / ".git").is_symlink():
            return source
    return None


def try_local_package_command(git, arguments):
    # Lake materializes Git packages in their private directory, with one fetch
    # of the manifest revision. Fetch just its source tree, keeping origin intact.
    fetch = (arguments[:-1] == ["fetch", "--tags", "--force", "--filter=tree:0", "origin"]
             and re.fullmatch(r"[0-9a-fA-F]{40}", arguments[-1]))
    prune = arguments == ["remote", "prune", "origin"]
    if not (fetch or prune):
        return False
    package = Path.cwd()
    if package.parent.parts[-2:] != (".lake", "packages"):
        return False
    source = main_package_source(git, package)
    if source is None:
        return False
    if fetch:
        protocols = os.environ.get("GIT_ALLOW_PROTOCOL")
        if protocols is not None and "file" not in protocols.split(":"):
            return False
        result = subprocess.run([git, "fetch", "--no-tags", "--depth=1", "--",
                                 str(source), arguments[-1]],
                                env=dict(os.environ, GIT_NO_LAZY_FETCH="1", GIT_ALLOW_PROTOCOL="file"))
        return result.returncode == 0
    # The local fetch above creates no tracking refs. Lake follows checkout with
    # remote prune, which would contact origin even with nothing to prune.
    refspec = subprocess.run([git, "config", "--get-all", "remote.origin.fetch"], stdout=subprocess.PIPE)
    if refspec.stdout.splitlines() != [b"+refs/heads/*:refs/remotes/origin/*"]:
        return False
    refs = subprocess.run([git, "for-each-ref", "--count=1", "refs/remotes/origin/"], stdout=subprocess.PIPE)
    return refs.returncode == 0 and not refs.stdout


def main():
    git = os.environ["STRATALINT_LEAN_READER_GIT"]
    if not Path(git).is_absolute() or Path(git).resolve() == Path(__file__).resolve():
        raise ValueError("reader Git executable must be an absolute native executable")
    arguments = sys.argv[1:]
    if try_local_package_command(git, arguments):
        return 0
    offset = command_offset(arguments)
    if offset >= len(arguments) or arguments[offset] != "diff" or "--no-index" in arguments[offset + 1:]:
        os.execv(git, [git, *arguments])
    prefix = arguments[:offset]
    probe = subprocess.run([git, *prefix, "rev-parse", "--path-format=absolute", "--git-path", "index"],
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, close_fds=False)
    if probe.returncode != 0:
        os.execv(git, [git, *arguments])
    index = Path(os.fsdecode(probe.stdout.removesuffix(b"\n")))
    with tempfile.TemporaryDirectory(prefix="lean-git-index-") as directory:
        temporary_index = Path(directory) / "index"
        try:
            shutil.copyfile(index, temporary_index)
        except FileNotFoundError:
            pass
        environment = dict(os.environ, GIT_INDEX_FILE=str(temporary_index))
        # Refresh stat data in the private index. Keep a split index from writing
        # a new sharedindex file into the dependency's actual Git directory.
        result = subprocess.run([git, *prefix, "-c", "diff.autoRefreshIndex=true",
                                 "-c", "core.splitIndex=false", *arguments[offset:]],
                                env=environment, close_fds=False)
        return result.returncode if result.returncode >= 0 else 128 - result.returncode


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError) as error:
        print("lean-git: " + str(error), file=sys.stderr)
        sys.exit(2)
