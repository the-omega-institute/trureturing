<Project>
  <!-- The SDK computes switches in a separate project instance. NonExistentFile
       forces only its CoreCompile; SkipCompilerExecution never runs csc/generators.
       Compile retains SDK preparation, reference aliases, resources and options. -->
  <Target Name="CaptureCiCompilerMetadata" AfterTargets="Build" BeforeTargets="RecordCiBuildOutputs"
      Condition="'$(CiRepositoryRoot)' != '' and '$(CiMetadataInstance)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="WriteCiCompilerMetadata"
      Properties="CiMetadataInstance=true;BuildProjectReferences=false;SkipCompilerExecution=true;ProvideCommandLineArgs=true;NonExistentFile=$(IntermediateOutputPath)ci-metadata-never-written" />
  </Target>
  <Target Name="WriteCiCompilerMetadata" DependsOnTargets="BuildOnlySettings;PrepareForBuild;PrepareResources;Compile"
      Condition="'$(CiMetadataInstance)' == 'true'">
    <WriteLinesToFile File="$(IntermediateOutputPath)ci-compiler-arguments.txt"
      Lines="@(CscCommandLineArgs)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <PropertyGroup>
      <_CiProject>$([MSBuild]::MakeRelative('$(CiRepositoryRoot)', '$(MSBuildProjectFullPath)'))</_CiProject>
      <_CiNative>$(CiBuildOutputRoot)/$(_CiProject).native</_CiNative>
    </PropertyGroup>
    <!-- Observed generated files are not attested as current by this metadata pass. -->
    <ItemGroup><_CiGeneratedSource Include="$(CompilerGeneratedFilesOutputPath)/**/*.cs" Condition="'$(CompilerGeneratedFilesOutputPath)' != ''" /></ItemGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_CiNative)'))" Condition="'$(CiBuildOutputRoot)' != ''" />
    <WriteLinesToFile File="$(_CiNative)" Overwrite="true" Condition="'$(CiBuildOutputRoot)' != ''"
      Lines="generated_provenance=not-rerun;@(_CiGeneratedSource->'generated=%(FullPath)');@(Compile->'compile=%(FullPath)');@(ReferencePath->'reference=%(FullPath)');@(ProjectReference->'project=%(FullPath)');@(CscCommandLineArgs->'argument=%(Identity)')" />
  </Target>
  <!-- FileWrites is populated by the real compiler and copy targets, including
       on an incremental Build. Metadata capture does not own emitting outputs. -->
  <Target Name="RecordCiBuildOutputs" AfterTargets="Build" Condition="'$(CiBuildOutputRoot)' != '' and '$(CiMetadataInstance)' != 'true'">
    <PropertyGroup>
      <_CiProject>$([MSBuild]::MakeRelative('$(CiRepositoryRoot)', '$(MSBuildProjectFullPath)'))</_CiProject>
      <_CiManifest>$(CiBuildOutputRoot)/$(_CiProject).outputs</_CiManifest>
      <_CiReference Condition="'$(ProduceReferenceAssembly)' == 'true'">$(TargetRefPath)</_CiReference>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(_CiManifest)'))" />
    <WriteLinesToFile File="$(_CiManifest)" Overwrite="true"
      Lines="$(MSBuildProjectFullPath);$(TargetPath);$(TargetDir);$(ProjectAssetsFile);reference=$(_CiReference);@(FileWrites->'%(FullPath)')" />
  </Target>
</Project>
