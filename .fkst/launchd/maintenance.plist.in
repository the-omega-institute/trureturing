<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@@FKST_MAINTENANCE_LAUNCHD_LABEL@@</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/make</string>
    <string>-C</string>
    <string>@@FKST_HOST_ROOT@@</string>
    <string>hourly-maintenance</string>
    <string>HOST_CONFIG=@@HOST_CONFIG@@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@@PATH@@</string>
    <key>FKST_GITHUB_BOT_LOGIN</key>
    <string>@@FKST_GITHUB_BOT_LOGIN@@</string>
    <key>FKST_DEVLOOP_INTEGRATION_BRANCH</key>
    <string>@@FKST_DEVLOOP_INTEGRATION_BRANCH@@</string>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>@@FKST_MAINTENANCE_LAUNCHER_LOG@@</string>
  <key>StandardErrorPath</key>
  <string>@@FKST_MAINTENANCE_LAUNCHER_LOG@@</string>
</dict>
</plist>
