<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>@@FKST_LAUNCHD_LABEL@@</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>@@FKST_ZSH_BIN@@</string>
		<string>-lc</string>
		<string>set -a; source @@FKST_HOST_CONFIG@@; set +a; cd "$FKST_HOST_ROOT"; exec @@FKST_BASH_BIN@@ "$FKST_PLATFORM_ROOT/scripts/run.sh" supervise --project-root "$FKST_HOST_ROOT" --platform-root "$FKST_PLATFORM_ROOT" --platform-packages "@@FKST_PLATFORM_PACKAGES@@" --host-packages "@@FKST_HOST_PACKAGES@@" --local-packages "$FKST_HOST_ROOT/packages" --durable-root "$FKST_DURABLE_ROOT" --runtime-root "$FKST_RUNTIME_ROOT" --restart</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>@@FKST_SUPERVISE_LAUNCHER_LOG@@</string>
	<key>StandardOutPath</key>
	<string>@@FKST_SUPERVISE_LAUNCHER_LOG@@</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>WorkingDirectory</key>
	<string>@@FKST_HOST_ROOT@@</string>
</dict>
</plist>
