# Copy this file to .fkst/env (gitignored) and fill in local paths:
#   cp .fkst/env.example .fkst/env
# .fkst/scripts/run.sh loads BIN from the filled .fkst/env when the caller does
# not provide BIN.

# BIN resolution order: caller environment, .fkst/env, PATH, then the sibling
# fkst-substrate checkout relative to .fkst.
BIN=/path/to/fkst-substrate/target/debug/fkst-framework

# Runtime state defaults under .fkst/run/. Tests replace the scratch root with
# a directory under mktemp.
FKST_RUNTIME_ROOT=.fkst/run/runtime

# Durable delivery state: unused in M1 (forward-looking operator guidance).
# Operators must keep this outside FKST_RUNTIME_ROOT and preserve it across
# runtime cleanup when supervise uses reliable subscriptions.
FKST_DURABLE_ROOT=.fkst/run/durable

# Leave FKST_GITHUB_WRITE unset for dry-run posture. Milestone M1 contains no
# live GitHub write path, even when that variable is set.

# This package is an integration probe, not a delivered automatic development loop.
