# .fkst/deploy.env — standard fkst github-devloop launch config for this repo.
#
# Committed (versioned, reproducible). This is the source of truth for the devloop
# BEHAVIOUR of the deployment. The host-local launcher (`~/.fkst/<repo>/host.env`,
# gitignored) supplies machine PATHS and SECRETS only, and `set -a; source`s this
# file so these values populate the supervise environment.
#
# CROSS-REPO USE: copy this file into another repo's `.fkst/`, then adjust the two
# repo-scoped sections (identity + local gate). The "portable behaviour" section is
# identical for every repo run under this fkst standard.
#
# DELIBERATELY NOT HERE (they live only in the gitignored host.env, never in git):
#   BIN, FKST_HOST_ROOT, FKST_PLATFORM_ROOT, FKST_DURABLE_ROOT, FKST_RUNTIME_ROOT,
#   FKST_RATE_POOL_ROOT, FKST_WORKFLOW_CATALOG_ROOT   (machine paths)
#   GH_TOKEN / any credential                          (secrets)

# ── portable behaviour (identical across repos) ──────────────────────────────
FKST_GITHUB_WRITE=1                              # real GitHub writes (not dry-run)
FKST_GITHUB_AUTHORIZE_ORG_MEMBERS=1              # org allowlist: authorise org members
FKST_GITHUB_PROXY_POLL_LABEL_PREFIX=fkst-dev:    # devloop control-label namespace
FKST_DEVLOOP_ROLLUP_MERGE=auto                   # auto rollup integration -> upstream

# ── repo identity (edit per repo) ────────────────────────────────────────────
FKST_GITHUB_REPO=the-omega-institute/trureturing
FKST_GITHUB_BOT_LOGIN=ElonSG
FKST_DEVLOOP_MANAGED_BOT_LOGINS=ElonSG,loning,AlyciaBHZ
FKST_DEVLOOP_UPSTREAM_BRANCH=dev
FKST_DEVLOOP_INTEGRATION_BRANCH=integration-ElonSG

# ── local gate (edit per repo: the repo's local==CI verification command) ────
# codex runs this from the repo root before finishing an implement/fix so PRs are
# born green. For trureturing it is `make preflight` (pre-proves both CI required
# checks: engineering + content-addressed baseline admission, against origin/dev).
FKST_DEVLOOP_LOCAL_TEST_COMMAND="make preflight"

# Base-health probe command (implement base-probe). When a candidate's local gate is
# RED the base-probe checks out the frozen base_sha and runs THIS to decide: is the
# base itself broken (-> BASE_RED, retry) or is the candidate diff bad (-> impl-fail)?
# It must be base-INDEPENDENT: `make preflight`'s trailing baseline-admission gate is
# base-RELATIVE and reds out on origin/dev drift unrelated to base health (which would
# loop genuinely broken candidates forever). So this drops admission and runs only the
# engineering stages -- build + test + selftest, exactly the task's "is base_sha
# healthy?". A genuinely broken base (compile error / failing test / selftest
# regression) still reds here and stays BASE_RED.
FKST_DEVLOOP_BASE_HEALTH_COMMAND="make dotnet && make test && make selftest"
