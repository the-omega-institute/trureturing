{
  "schema_version": 1,
  "report_semantic_version": 8,
  "report_execution": {
    "tools": ["lake", "lean"],
    "platform": ["system", "machine"],
    "environment": ["LEAN_PATH", "LEAN_SRC_PATH", "LEAN_SYSROOT", "ELAN_TOOLCHAIN", "LEAN_OPTS"]
  },
  "report_modules": {"include": [{"pattern": "Trureturing.lean", "optional": false}, {"pattern": "D5/**/*.lean", "optional": true}, {"pattern": "Reg/**/*.lean", "optional": true}], "exclude": []},
