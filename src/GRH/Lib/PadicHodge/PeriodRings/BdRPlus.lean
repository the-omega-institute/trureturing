import GRH.Lib.PadicHodge.PeriodRings.AmaxStructure
-- Adapted from grh-lean (compact edition) for the trureturing module layout.

/-! Part of: Fontaine's period rings and the fundamental exact sequence (known result; see
Lib.PadicHodge.PeriodRings.BdR).

This file: B_max^+ is a domain, kernel of theta; B_dR^+ is a discrete valuation ring. -/

noncomputable section

attribute [-simp] map_eq_zero isUnit_map_iff algebraMap.coe_inj IsUnit.dvd


open algebraMap Ideal Polynomial IsLocalization.Away IsScalarTower Algebra Amax Function BPlus
variable {p R} [ThePrime p] {y : BPlus} [CommRing R] [Algebra R BPlus] {x : BdRPlus} {a : Ainf}
attribute [local simp] IsUnit.pow smul_def theta_eq_zero_iff_xi_dvd sub_eq_iff_eq_add
  IsUnit.mul_right_inj IsUnit.mul_right_eq_zero mul_assoc mem_span_singleton mul_pow SModEq.sub_mem
attribute [local simp ←] IsScalarTower.algebraMap_apply mul_sub mul_sub_one

lemma injective_Amax_BPlus : Injective ((↑) : Amax → BPlus) :=
  IsLocalization.injective _ (Submonoid.powers_le.2 p_mem_nonZeroDivisors)

lemma BPlus.exists_p_pow_mul_eq_amax : ∃ m b, p ^ m * y =
  (b : Amax) := by grind [surj (p : Amax) y, map_natCast]

lemma tau_dvd_xi_sub_p : tau ∣ xi - p :=
  tau_dvd_of_theta_frobEnd (by simpa [iterate_fixed] using theta_iterate_frobEnd_xi)

/-- Let e in A_inf divide μ and let y be in B^+. If e^n y lies in the image of A, then so does
p^(2n) y. -/
lemma amaxImage.p_pow_mul_mem_of_dvd_mu {e n} : e ∣ mu → e ^ n • y ∈ amaxImage →
  p ^ (2 * n) * y ∈ amaxImage := by
  grw [← xi_mul_tau, tau_dvd_xi_sub_p]
  exact fun ⟨t, k⟩ ⟨c, _⟩ ↦ let ⟨m, b, _⟩ := (p ^ (2 * n) * y).exists_p_pow_mul_eq_amax
    (b.p_pow_dvd_of_monic_mul ((monic_X.mul (monic_X_sub_C 1)).pow n) m ⟨t ^ n • c,
      injective_Amax_BPlus (by
    replace k := congr(($k : Amax) ^ n • y)
    simp_all [pow_mul']; grind)⟩).imp (by aesop)

/-- For y in B^+ and natural numbers k, n there are m, an element a of A_inf and w in the image
of A with p^m y = a + p^(m+k) μ^n w. -/
lemma BPlus.exists_Ainf_approx y k n : ∃ m a, ∃ w ∈ amaxImage, p ^ m * y =
  ↑(a : Ainf) + p ^ (m + k) * mu ^ n * w := y.exists_p_pow_mul_eq_amax.rec fun m ⟨b,
  _⟩ ↦ let ⟨d, c, w, _⟩ := b.exists_algebraMap_eq_p_pow_mul_sub (m + k + n + n)
  let ⟨a, z, _⟩ := w.exists_p_pow_mul_eq_add ⟨1, tau_dvd_xi_sub_p.trans (by simp)⟩ n
  let ⟨e, x, _⟩ := z.exists_p_pow_mul_eq_add ⟨0, dvd_rfl⟩ n
  ⟨d + m, c + p ^ (d + m + k) * (p ^ n * a + tau ^ n * e), _, ⟨x, rfl⟩, by
  simp_all [← injective_Amax_BPlus.eq_iff, ← xi_mul_tau, pow_add, -p_mul_X]; grind⟩

@[simp] lemma BPlus.iterate_frobEnd_algebraMap j : frobEnd^[j] (a : BPlus) = frobEnd^[j] a :=
  j.rec (by simp) (by aesop) a

/-- Let ν be in A_inf and s: ℕ → ℕ, and suppose ν divides every a in A_inf with θ(φ^(s(j)) a) =
0 for all j. Then ν divides in B^+ every y with θ(φ^(s(j)) y) = 0 for all j. -/
lemma BPlus.dvd_of_thetaBPlus_frobEnd_eq_zero y {ν} {s : ℕ → ℕ} (H : ∀ {a},
  (∀ j, theta (frobEnd^[s j] a) = 0) → ν ∣ a) (h : ∀ j, thetaBPlus (frobEnd^[s j] y) = 0) :
  ↑ν ∣ y := let ⟨n, a, z, _, e⟩ := y.exists_Ainf_approx 0 1
  by grw [← IsUnit.dvd_mul_left, e, dvd_add_right (map_dvd _ (H (by
            simpa [h] using congr(thetaBPlus <| frobEnd^[s ·] $e.symm)))), @H mu] <;> simp

/-- For y in B^+, θ(y) = 0 if and only if ξ divides y in B^+; that is, the kernel of θ: B^+ →
C_p is ξB^+. -/
@[local simp ←] lemma thetaBPlus_eq_zero_iff : thetaBPlus y = 0 ↔ ↑xi ∣ y :=
  ⟨by simpa using @y.dvd_of_thetaBPlus_frobEnd_eq_zero p _ xi 0, by simp_all [dvd_def]⟩

/-- Let a be in A_inf. Then an element of B^+ divisible by (ξ − pa)^n for every n is zero. -/
lemma BPlus.eq_zero_of_forall_pow_dvd a (h : ∀ n, algebraMap _ _ (xi - p * a) ^ n ∣ y) : y = 0 := by
  by_contra
  obtain ⟨⟨n, b, hb⟩, F, H⟩ := y.exists_p_pow_mul_eq_amax, Amax.exists_reduction_mod_p
  obtain ⟨k, c, rfl, hc⟩ := exists_eq_pow_mul_of_not_forall_dvd ↑p b
    (mt _root_.eq_zero_of_forall_pow_dvd (by aesop : b ≠ 0))
  grw [algebraMap_apply _ Amax, Dvd.intro_left _ hb] at h; simp_all
  have t {n} : aeval _ ((.X - C a) ^ n) ∣ c := let ⟨w, _⟩ := h n
    w.exists_p_pow_mul_eq_amax.rec fun m ⟨d, _⟩ ↦ (d.p_pow_dvd_of_monic_mul ((monic_X_sub_C a).pow
      n) m ⟨c, injective_Amax_BPlus (by simp; grind)⟩).imp fun _ _ ↦ injective_Amax_BPlus (by aesop)
  apply pow_rootMultiplicity_not_dvd hc; simpa [↓H] using map_dvd F t

instance : FaithfulSMul Ainf BPlus := .of_injective (ofId Ainf _) (injective_Amax_BPlus.comp
  (by simp_all [Injective, @IsHausdorff.eq_iff_smodEq _ _ (span {↑p, xi}) Ainf,
  mem_span_pow_of_p_pow_dvd]))

lemma BPlus.mu_ne_zero : (mu : BPlus) ≠ 0 := mod_cast ne_zero_of_map constantCoeff_mu_ne_zero

/-- The isomorphism of Q_p-algebras from B^+/ξB^+ onto C_p induced by the surjective extension
of θ to B^+, whose kernel is generated by ξ. -/
def thetaEquiv := (quotientEquivAlgOfEq _ (by aesop : span {↑xi} = _)).trans
  (quotientKerAlgEquivOfSurjective thetaBPlus_surjective)

/-- The ring homomorphism θ from B_dR^+ to C_p: projection to B^+/ξB^+ followed by the
isomorphism of that quotient with C_p. -/
def thetaBdR : BdRPlus →ₐ[ℚ_[p]] ℂ_[p] := .comp thetaEquiv ⟨(AdicCompletion.evalOneₐ _).1, by tauto⟩

/-- The map θ: B_dR^+ → C_p extends θ on B^+: for a in B^+, θ of the image of a in B_dR^+ equals
θ(a). -/
@[simp] lemma thetaBdR_algebraMap_BPlus : thetaBdR y = thetaBPlus y := (rfl)

@[simp] lemma thetaBdR_ainf : thetaBdR a = (theta a).1 := thetaBPlus_ainf a

/-- For y in B^+ and a natural number n, ξ^n divides the image of y in B_dR^+ if and only if ξ^n
divides y in B^+. -/
lemma BdRPlus.xi_pow_dvd_iff {n} : (xi : BdRPlus) ^ n ∣ y ↔ (xi : BPlus) ^ n ∣ y :=
  pow_dvd_iff (y := y)

open BdRPlus

lemma BdRPlus.exists_xi_pow_dvd_sub x n : ∃ y : BPlus, (xi : BdRPlus) ^ n ∣ x - y :=
  exists_approx ..

/-- For every x in B_dR^+ and every natural number n there are a natural number m and r in A_inf
such that ξ^n divides p^m x − r in B_dR^+. -/
lemma BdRPlus.exists_Ainf_approx x n : ∃ m, ∃ r : Ainf, (xi : BdRPlus) ^ n ∣ p ^ m * x - r
  := (x.exists_xi_pow_dvd_sub n).rec fun z ⟨c, h⟩ ↦
  (z.exists_Ainf_approx 0 n).imp fun m ⟨a, v, _, e⟩ ↦ ⟨a, by
  replace e := congr(($e : BdRPlus))
  simp_all [← xi_mul_tau, mul_add, ← add_sub, dvd_add, Dvd.dvd.mul_left]⟩

/-- For x in B_dR^+, θ(x) = 0 if and only if ξ divides x. -/
@[local simp ←] lemma thetaBdR_eq_zero_iff : thetaBdR x = 0 ↔ ↑xi ∣ x := by
  obtain ⟨_, _, _, _⟩ := @xi_pow_dvd_iff (n := 1), x.exists_xi_pow_dvd_sub 1
  simp_all [dvd_add_right]

@[simp] lemma BdRPlus.isUnit_iff : IsUnit x ↔ thetaBdR x ≠ 0 := ⟨(·.map _ |>.ne_zero),
  isUnit_of_dvd_unit ⟨↑(surjInv thetaBPlus_surjective (thetaBdR x)⁻¹), rfl⟩ ∘ @isUnit_of_dvd_sub
    _ _ _ _ _ isAdicComplete isUnit_one ∘ thetaBdR_eq_zero_iff.1 ∘ by simp_all [surjInv_eq]⟩

lemma BdRPlus.exists_associated_xi_pow (h : x ≠ 0) : ∃ n, Associated (xi ^ n : BdRPlus) x :=
  (exists_eq_pow_mul_of_not_forall_dvd
  ↑xi x (h <| _root_.eq_zero_of_forall_pow_dvd ·)).imp (by simp_all [associated_mul_unit_right])

instance [FaithfulSMul R BPlus] : FaithfulSMul R BdRPlus := .of_injective (toAlgHom _ BPlus _)
  (.of_ker _ fun _ ↦ BPlus.eq_zero_of_forall_pow_dvd 0 ∘ by simp_all [← xi_pow_dvd_iff])

/-- The image of ξ in B_dR^+ is a prime element. -/
lemma BdRPlus.prime_xi : Prime (xi : BdRPlus) := by simp [Prime, Ainf.prime_xi.1]

instance : IsDomain BdRPlus := @NoZeroDivisors.to_isDomain _ _ ⟨_, _, prime_xi.1⟩ ⟨by
  by_contra! ⟨_, _, e, h, k⟩; simpa [e, ← map_pow, ← map_mul, Ainf.prime_xi.1] using
    (exists_associated_xi_pow h).choose_spec.mul_mul (exists_associated_xi_pow k).choose_spec⟩

instance : IsDiscreteValuationRing BdRPlus :=
  .ofHasUnitMulPowIrreducibleFactorization ⟨_, prime_xi.irreducible, exists_associated_xi_pow⟩

instance : IsDomain BPlus := .of_faithfulSMul _ BdRPlus

instance : IsDomain Amax := injective_Amax_BPlus.isDomain

instance : CharZero Amax := thetaAmax.charZero

instance : IsDomain Bcris := isDomain _ mu_ne_zero

/-- The localisation map B^+ → B = B^+[1/μ] is injective. -/
lemma injective_BPlus_Bcris : Injective ((↑) : BPlus → Bcris) :=
  IsLocalization.injective _ (powers_le_nonZeroDivisors_of_noZeroDivisors mu_ne_zero)

lemma Amax.nonempty_adicBasis (Λ : Type) [CommRing Λ] [Algebra Λ Amax] {I} (h : I = span {(p : Λ)})
    [I.IsMaximal] [IsAdicComplete I Λ] : Nonempty (Lift.AdicBasis I Amax) :=
  (Lift.exists_adicBasis (h ▸ span_insert_zero.symm) (by simp [NeZero.ne])).nonempty
