import GRH.Lib.General.Geometry.LocalTerms
import GRH.Lib.PadicHodge.PeriodRings.Ainf
-- Adapted from grh-lean (compact edition) for the trureturing module layout.

/-! Part of: Crystalline comparison: p-adic étale cohomology with good reduction is crystalline
(known result; see Lib.PadicComparison.Crystalline.CrystallineClasses).

This file: Divided power ideal, p-complete torsion-free algebras, reduction modulo divided
powers. -/


open CategoryTheory ObjectProperty Ideal Nat Finset
variable {p} [ThePrime p] (S) [CommRing.{0} S] {B k} [CommRing B] [CommRing k] (f : B →+* k)

/-- The ideal 𝔡(S) of the elements x of S such that n! divides x^n for every n. -/
def pdIdeal : Ideal S := ⟨⟨⟨{x | ∀ n, ↑n ! ∣ x ^ n}, fun a b n ↦ @add_pow .. ▸
  dvd_sum (by grw [← a ·, ← b _, ← choose_mul_factorial_mul_factorial <| mem_range_succ_iff.1 ·,
  mul_rotate]; simp)⟩, by rintro ⟨⟩ <;> simp⟩, by simp_all [mul_pow, Dvd.dvd.mul_left]⟩

lemma pdIdeal_le_comap : pdIdeal B ≤ comap f (pdIdeal k) := fun _ ↦
  (by simpa using map_dvd f <| · ·)

/-- The quotient map S → S/𝔡(S), where 𝔡(S) = `pdIdeal` S is the ideal of the x with n!
dividing x^n for all n. -/
abbrev pdQuotientMk := Ideal.Quotient.mk (pdIdeal S)

/-- For a ring homomorphism f: B → k, the induced homomorphism B/𝔡(B) → k/𝔡(k), where 𝔡 is the
ideal `pdIdeal`. -/
abbrev pdQuotientMap := quotientMap _ f (pdIdeal_le_comap f)

/-- The ring S is p-torsion-free and p-adically complete. -/
structure IsCompleteTorsionFree [ThePrime p] where
  (regular : IsSMulRegular S p) complete : IsAdicComplete (span {(p : S)}) S

/-- The full subcategory of commutative S-algebras that are p-torsion-free and p-adically
complete. -/
abbrev CrysTest := @FullSubcategory (CommAlg S) _ (IsCompleteTorsionFree ·)

/-- For a ring map r: k → B/𝔡(B), the functor A ↦ A/𝔡(A) from p-torsion-free p-adically complete
B-algebras to k-algebras, with 𝔡 the ideal `pdIdeal`. -/
def pdReduction (r : k →+* B ⧸ pdIdeal B) : CrysTest B ⥤ CommAlg k := by
  let (A : CrysTest B) := ((pdQuotientMap (algebraMap _ A.1)).comp r).toAlgebra
  refine ⟨(.of _ <| ·.1.1 ⧸ _), fun f ↦ ConcreteCategory.ofHom ⟨pdQuotientMap _, (by
  simp [algebraMap]; rcases r ·; exact congr($(f.1.1.2 _)))⟩, ?_, ?_⟩ <;> intros <;> ext ⟨⟩ <;> rfl

/-- Restriction of scalars along S → B, from p-torsion-free p-complete B-algebras to p-torsion-free
p-complete S-algebras. -/
def CrysTest.restrictScalars [Algebra S B] : CrysTest B ⥤ CrysTest S :=
  lift _ (ι _ ⋙ restrictAlg ..) (·.2)

/-- For a commutative ring S, its completion with respect to the ideal generated by p. -/
abbrev PadicCompletion (p : ℕ) := AdicCompletion (span {(p : S)}) S

lemma isCompleteTorsionFree_completion (h : IsSMulRegular B p) :
  IsCompleteTorsionFree (PadicCompletion B p) := ⟨isSMulRegular_completion h, isAdicComplete⟩
