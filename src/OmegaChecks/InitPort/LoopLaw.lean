/-! The law compares two loops only at a callback with a well-founded relation. -/

open Std Std.Iterators Std.IterM.DefaultConsumers

namespace OmegaChecks.InitPort.LoopLaw

/-- Each inverse rewrite in the interface checker is an instance of this equation. -/
public theorem computation {m : Type w → Type w'} {α β : Type w} [Iterator α m β]
    {n : Type x → Type x'} [Monad n] (lift : ∀ γ δ, (γ → n δ) → m γ → n δ)
    (γ : Type x) (Pl : β → γ → ForInStep γ → Prop) (wf : IteratorLoop.WellFounded α m Pl)
    (it : IterM (α := α) m β) (init : γ) (P : β → Prop)
    (hP : ∀ b, it.IsPlausibleIndirectOutput b → P b)
    (f : (b : β) → P b → (c : γ) → n (Subtype (Pl b c))) :
    IterM.DefaultConsumers.forIn'.wf lift γ Pl wf it init P hP f =
      IterM.DefaultConsumers.forIn' lift γ Pl it init P hP f := by
  symm
  haveI : Nonempty γ := ⟨init⟩
  rw [IterM.DefaultConsumers.forIn', WellFounded.extrinsicFix₃_eq_fix]
  rotate_left
  · apply InvImage.wf
    exact wf
  · fun_induction forIn'.wf lift γ Pl wf it init P hP f
    rename_i ihy ihs
    rw [WellFounded.fix_eq]
    congr 1
    ext step
    cases step.inflate using PlausibleIterStep.casesOn
    · apply bind_congr
      intro forInStep
      match forInStep with
      | ⟨.yield c, h⟩ => simp (discharger := assumption) [ihy]
      | ⟨.done c, h⟩ => simp
    · simp (discharger := assumption) [ihs]
    · simp

/-- Generate the official class and its eliminators with the given termination witness. -/
public class Model (α : Type w) (m : Type w → Type w') (n : Type x → Type x')
    [Monad m] [Monad n] [Iterator α m β] [i : IteratorLoop α m n] where
  lawful lift [Std.Internal.LawfulMonadLiftBindFunction lift] γ it init
      (Pl : β → γ → ForInStep γ → Prop) (wf : IteratorLoop.WellFounded α m Pl)
      (f : (b : β) → it.IsPlausibleIndirectOutput b → (c : γ) → n (Subtype (Pl b c))) :
    i.forIn lift γ Pl it init f =
      IterM.DefaultConsumers.forIn'.wf lift γ Pl wf it init _ (fun _ => id) f


open Lean

public def familyMember (n : Name) : Bool :=
  [``Std.LawfulIteratorLoop, ``Std.LawfulIteratorLoop.mk, ``Std.LawfulIteratorLoop.rec,
   ``Std.LawfulIteratorLoop.casesOn, ``Std.LawfulIteratorLoop.recOn, ``Std.LawfulIteratorLoop.lawful].contains n

/-- Embed only the replacement field and the expressions generated by the kernel for it. -/
public def declaration (env : Environment) (upstream : ConstantInfo) : ConstantInfo := Id.run do
  unless familyMember upstream.name do return upstream
  let modelName := upstream.name.replacePrefix ``Std.LawfulIteratorLoop ``Model
  let some model := env.find? modelName | return upstream
  let rehome (e : Expr) :=
    (e.instantiateLevelParams model.levelParams (upstream.levelParams.map Level.param)).replace fun
      | .const n us => if (``Model).isPrefixOf n then some (.const (n.replacePrefix ``Model ``Std.LawfulIteratorLoop) us) else none
      | .proj n i a => if n == ``Model then some (.proj ``Std.LawfulIteratorLoop i a) else none
      | _ => none
  let type := rehome model.type
  match upstream, model with
  | .ctorInfo x, .ctorInfo _ => return .ctorInfo {x with type}
  | .recInfo x, .recInfo y =>
    let rules := (x.rules.zip y.rules).map fun (original, guarded) => {original with rhs := rehome guarded.rhs}
    return .recInfo {x with type, rules}
  | .defnInfo x, .defnInfo y => return .defnInfo {x with type, value := rehome y.value}
  | .thmInfo x, .thmInfo y => return .thmInfo {x with type, value := rehome y.value}
  | _, _ => return upstream

/-- The unrestricted call has the same binders apart from the well-foundedness witness.
Apply this only inside the six declarations generated for the guarded loop law. -/
public def originalCalls (e : Expr) : Expr :=
  e.replace fun term => do
    let .const n us := term.getAppFn | none
    guard (n == ``Std.IterM.DefaultConsumers.forIn'.wf && term.getAppNumArgs == 15)
    return mkAppN (.const ``Std.IterM.DefaultConsumers.forIn' us) (term.getAppArgs.eraseIdx! 9)

/-- Validate the exact arguments and both sides used when translating the loop field. -/
public def checkCertificate (reference : Environment) : IO Unit := do
  let some run := reference.find? ``Std.IterM.DefaultConsumers.forIn'.wf
    | throw <| IO.userError "missing official well-founded loop"
  let some certificate := reference.find? ``computation
    | throw <| IO.userError "missing guarded loop computation certificate"
  let levels := run.levelParams.map Level.param
  let expected : MetaM Expr := Meta.forallTelescope run.type fun xs _ => do
    let call := mkAppN (.const run.name levels) xs
    let original := originalCalls call
    if original == call then throwError "missing guarded loop application"
    Meta.mkForallFVars xs (← Meta.mkEq call original)
  let type ← expected.run' |>.toIO' {fileName := "<guarded loop>", fileMap := default} {env := reference}
  let owner := (reference.getModuleIdxFor? certificate.name).bind (reference.header.moduleNames[·]?)
  unless certificate.isTheorem && certificate.numLevelParams == run.numLevelParams &&
      owner == some `OmegaChecks.InitPort.LoopLaw do
    throw <| IO.userError "invalid guarded loop comparison certificate"
  let statement := certificate.type.instantiateLevelParams certificate.levelParams levels
  unless Kernel.isDefEqGuarded reference {} type statement do
    throw <| IO.userError "guarded loop certificate does not prove the complete computation"
  let axioms ← (collectAxioms certificate.name : CoreM _).toIO' {fileName := "<guarded loop>", fileMap := default} {env := reference}
  unless axioms.all (#[`propext, `Classical.choice, `Quot.sound].contains ·) do
    throw <| IO.userError "inadmissible axiom in guarded loop comparison"

end OmegaChecks.InitPort.LoopLaw
