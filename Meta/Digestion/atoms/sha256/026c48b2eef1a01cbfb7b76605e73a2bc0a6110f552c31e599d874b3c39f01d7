\|L_{\rm J}F_{\rm J}(c_{\rm J})\|_\infty<10^{-20},\qquad
\sup_{x\in X_{\rm J}}\|I-L_{\rm J}DF_{\rm J}(x)\|_\infty<10^{-4}.                       \tag{40.8}
$$

