y_3-y_0&=D+(36a-2D/7)(r+b+c),\\
y_4-y_0&=D+(24a-D/7)(1+2b),\\
y_5-y_0&=D+(10a-D/21)m_F,\\
m_J&=b+c+2r,\qquad m_M=r+b+c+1+2b,\\
