| 59.R2 | $(A,1),(A,3)$ | 2 |
| 59.R3 | $(A,4),(B,1)$ | 2 |
| 59.R4 | $(B,0),(B,3)$ | 1 |
| 59.R5 | $(B,2),(B,4)$ | 1 |
| 59.R6 | $(C,0),(C,2)$ | 1 |
| 59.R7 | $(C,1),(C,3)$ | 1 |
| 59.R8 | $(C,4),(D,1)$ | 1 |
| 59.R9 | $(D,0),(D,3)$ | 1 |
