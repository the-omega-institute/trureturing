12765068132,-8911595079,55889179310,\\
&-127755649252,367729251274,709892709460,\\
&482515359696,207188455720,32969082600),\\[2mm]
\operatorname{coeff}_{\downarrow}(Q_{12})=(&3523306032,
14115530736,35825657643,-25329237978,\\
