u=e_j,\qquad X=I_2,\qquad w=-\frac1{c_j}e_j\in\mathcal W,\\
\alpha_+=\frac13,\quad \alpha_-=1,\qquad
\beta_+=\frac23\left(c_j-\frac1{c_j}\right),\quad
