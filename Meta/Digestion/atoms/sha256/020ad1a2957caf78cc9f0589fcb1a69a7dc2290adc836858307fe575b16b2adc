$$
h^-=(\beta\beta)^{100}\beta\alpha\mid\beta\beta\alpha\alpha,
\qquad
h^+=(\alpha\alpha)^{100}(\beta\beta)^{100}
       \beta\alpha\mid\beta\beta\alpha\alpha
$$

