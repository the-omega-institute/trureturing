 7/8&i\sqrt3/8\\-i\sqrt3/8&1/8
 \end{pmatrix},\\
 E_j&=(TF_jT^\dagger)^{\mathsf T},& j&\in\{\mathrm p,\mathrm m\}.
\end{aligned}
\tag{40.26}
$$

These are actual original pairs with
$\rho(E_{\mathrm p},U_0)=\rho(E_{\mathrm m},U_0)=25/8$.
