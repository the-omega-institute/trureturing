E=\bigoplus_{i,j,k}\operatorname{Herm}_{n_in_jn_k}(\mathbb C),\\
\rho_i\ge0,\quad\sum_i\operatorname{Tr}\rho_i=1,\quad0\le f_i\le I_i,\qquad
