 r_4&=\frac1{10}+\frac1x+\frac9{40x^2}.
 \end{aligned}
 \tag{52.3}
$$

For $x\ge4$, $r_1>0$ and

$$
 \delta_x-r_1=\frac1{4x}-\frac9{40x^2}>0.
