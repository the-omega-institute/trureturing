| $AABAC$ | $A$ |
| $AABCC$ | $A$ |
| $ABAAC$ | $A$ |
| $ABABC$ | $B$ |
| $ABACA$ | $A$ |
| $ABBBC$ | $B$ |
| $ABBCB$ | $B$ |
