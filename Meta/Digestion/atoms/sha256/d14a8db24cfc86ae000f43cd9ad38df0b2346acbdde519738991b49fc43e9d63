 &-46yz-46yq-3yv-46zq-3zv-3qv-3vh,\\
E_2={}&166+46k-46k(k-1)/2+3v(1-k-h),\\
E_3={}&209+3(z+q+v)-46zq-3v(z+q+h),\\
E_4={}&175-43q-3qv-3vh,\\
E_5={}&132-3v-3vh,\qquad E_6=43,\quad E_7=76.
