 u_i(v,c)=\langle v,\operatorname{bin}_k(i)\rangle\mathbin\oplus c,
 \quad1\le i\le H,\quad v\in\mathbb F_2^k,\quad c\in\mathbb F_2,
 \tag{ACR.55}
