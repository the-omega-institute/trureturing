def mul_at(x, y, reference):
    z = mul(x,y)
    events = dict(z.e)
    for key in z.w:
        t0,p0,s0,r0 = events[key]
        events[key] = (t0,tuple(a-b for a,b in zip(p0,reference)),s0,r0)
    return valid(replace(z,e=events))

