A_3={}&846r^3+3665r^2-5583r-410,\\
B_3={}&423r^3+1138r^2-2055r-50,\\
D_3={}&846r^3-4669r^2+3255r+1450,\\
E_2={}&11891r^2-31719r+20410,\\
