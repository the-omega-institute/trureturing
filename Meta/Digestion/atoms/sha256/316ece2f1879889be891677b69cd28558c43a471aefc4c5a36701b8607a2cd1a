$$
\boxed{
\begin{aligned}
\text{金字塔五模式} &\longrightarrow \text{局部合法状态空间},\\
\text{跨窗口接缝} &\longrightarrow \text{时间方向与未来可能性},\\
\kappa,\Delta &\longrightarrow \text{隐藏关系与不可恢复信息},\\
