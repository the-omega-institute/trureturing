    for pr3_v0, pr3_eta in product(sorted(pr3_D, key=repr), (0, 1)):
        pr3_f = {}
        for pr3_Q in pr3_powerset:
            pr3_f[pr3_Q] = pr3_probe(pr3_x, pr3_Q, pr3_v0, pr3_eta)
            pr3_expected = sum(pr3_x.e[e][2] for e in pr3_x.w
