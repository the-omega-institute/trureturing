def history_map(x, y, mapping):
    assert set(mapping) == set(x.e) and set(mapping.values()) == set(y.e)
    assert len(set(mapping.values())) == len(mapping)
    assert all(x.e[e] == y.e[mapping[e]] for e in x.e)
