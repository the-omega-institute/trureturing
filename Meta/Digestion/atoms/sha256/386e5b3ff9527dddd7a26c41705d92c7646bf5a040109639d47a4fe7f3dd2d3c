k_{\delta,1}(F)&=\sum_e\int_0^1|F'_e|^2dx,\\
k_{\delta,2}(F)&=\sum_{e,q}\int_0^1|\partial_xF(e,x;q)|^2dx
 +\sum_{p,e}\int_0^1|\partial_yF(p;e,y)|^2dy\\
 &\quad+\delta\sum_{e,f}\int_{C_{ef}}
                (|\partial_xF|^2+|\partial_yF|^2)dxdy.
\end{aligned}
\tag{77.4}
$$

