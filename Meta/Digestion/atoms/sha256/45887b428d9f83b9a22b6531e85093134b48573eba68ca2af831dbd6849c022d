$$
C_i=\mathbf1_{\{\alpha_i\ne0,\ \ell_B\ne0\}}
   +\mathbf1_{\{\beta_i\ne0,\ \ell_A\ne0\}},
\qquad C_*:=\max_i C_i\in\{1,2\}.
\tag{48.8}
