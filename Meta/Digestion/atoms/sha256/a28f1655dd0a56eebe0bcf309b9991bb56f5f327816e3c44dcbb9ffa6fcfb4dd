B_{FE}=K_F\cap\mathcal F(H_{5F}^*,E,v_{FE}),\qquad T_{FM}=\{W_{F1},W_{F2}\},\quad T_{FJ}=\{W_{F3},W_{F4}\}. \tag{51.2}
