| 61.4-x1 | $RWRWR$ | $(1,1,2,2,3)$ | $(0,0,1)$ |
| 61.4-x2 | $RWR$ | $(2,2,3)$ | $(0,1)$ |
| 61.4-x3 | $RWRWR$ | $(3,3,4,4,5)$ | $(1,1,1)$ |
| 61.4-x4 | $RWRWR$ | $(4,4,5,5,6)$ | $(1,1,2)$ |
| 61.4-x5 | $RWR$ | $(5,5,6)$ | $(1,2)$ |
