\rho_\theta
\left(
H(w)^m
\right)
\right|_{\theta=0}
=
2m^2k(w)^2.
}
\tag{786.5}
$$

所以：

$$
\boxed{
-
\left.
\partial_\theta^2
\log
\mathcal R_{\mathrm{obs}}(s,\theta)
\right|_{\theta=0}
}
$$

