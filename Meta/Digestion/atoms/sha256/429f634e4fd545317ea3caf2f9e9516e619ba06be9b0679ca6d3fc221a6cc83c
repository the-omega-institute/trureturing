$$
\begin{aligned}
C_0&=[-1,-1/2],&
C_1&=(-1/2,0],&
C_2&=(0,t/2],\\
C_3&=(t/2,3t/2),&
C_4&=[3t/2,2t],&
C_5&=(2t,\phi].
\end{aligned}
$$

