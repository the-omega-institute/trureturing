$$
\begin{aligned}
p(W_0)=p(W_1)=p(W_2)&=p_J,\\
u_J(W_0)=u_J(W_1)=u_J(W_2)&=u_J,\\
f_{JJ}(W_0)=f_{JJ}(W_1)&=a_J,\\
f_{JM}(W_0)=f_{JM}(W_2)&=a_M.
\end{aligned}
\tag{8.5}
