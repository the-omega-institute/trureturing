&\longrightarrow
\text{裸 }\varphi\text{ 与奇向破缺};\\
\text{Galois 共轭配对}
&\longrightarrow
\text{六维有理完成};\\
\text{完整 regulator 圆}
&\longrightarrow
\text{反射与周期闭合};\\
\text{截断圆弧／单通道}
&\longrightarrow
\text{边界破缺};\\
\text{黄金 Euler germ}
&\longrightarrow
\text{逐阶 ζ 因子抽取};\\
\text{每一新定义}
&\longrightarrow
\text{可审计的逃逸深度变化}.
\end{aligned}
}
$$

