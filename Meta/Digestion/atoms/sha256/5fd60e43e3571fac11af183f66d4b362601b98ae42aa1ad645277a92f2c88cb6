$$
a\sim_{\mathcal M}a'
\quad\Longleftrightarrow\quad
\exists S\in\mathcal M\ \exists d\in\mathbb Z\setminus\{0\}:\quad
 a_i-a'_i=d\quad(i\in S).
\tag{NAR.14.4}
