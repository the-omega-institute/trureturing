$$
\boxed{
P_\varphi=2\log\varphi,
}
$$

$$
\boxed{
\omega_\varphi=\frac{\pi}{\log\varphi},
}
$$

$$
\boxed{
g_\varphi(\sigma)
=
\mathscr C_1^\infty(\sigma).
}
$$

