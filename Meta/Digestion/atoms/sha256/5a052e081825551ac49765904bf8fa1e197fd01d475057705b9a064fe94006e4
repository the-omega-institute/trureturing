```lean
def JointEq
    (q : (i : ι) → X → O i)
    (J : Finset ι)
    (x y : X) : Prop :=
  ∀ i, i ∈ J → q i x = q i y
```

```lean
def LocalGlobalResidual
    (q : (i : ι) → X → O i) : Type _ :=
  {xy : X × X // xy.1 ≠ xy.2 ∧ ∀ i, q i xy.1 = q i xy.2}
```

```lean
def PrimeTraceEq
    (F : X → X)
    (q : (i : ι) → X → O i)
    (J : Finset ι)
    (x y : X) : Prop :=
  ∀ n i, i ∈ J → q i (F^[n] x) = q i (F^[n] y)
```

