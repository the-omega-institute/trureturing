$$
\boxed{(\mathbb{C}^2\setminus\{0\})/U(1)\cong\mathbb{R}^3\setminus\{0\},}
\qquad
\boxed{\mathbb{CP}^1\cong S^2,}
$$

以及

$$
\boxed{\text{共同相位不变多项式的最低非平凡生成层是二次关系。}}
