$$
\begin{aligned}
r_0&:\{\{1,2\},\{3\}\},&
D_0&=\{V(t,t,\rho t):t\in\mathcal T\},\\
r_1&:\{\{1\},\{2,3\}\},&
D_1&=\{V(t,\rho t,\rho t):t\in\mathcal T\}.
