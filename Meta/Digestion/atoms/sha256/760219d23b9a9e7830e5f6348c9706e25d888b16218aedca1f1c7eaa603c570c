$$
\begin{array}{llll}
q_1=1,&q_2=s,&q_3=s^{-1},&q_4=t,\\
q_5=ts,&q_6=ts^{-1},&q_7=st,&q_8=sts,\\
q_9=sts^{-1},&q_{10}=s^{-1}t,&q_{11}=s^{-1}ts,&q_{12}=s^{-1}ts^{-1},\\
q_{13}=t^{-1},&q_{14}=t^{-1}s,&q_{15}=t^{-1}s^{-1},&q_{16}=st^{-1},\\
q_{17}=st^{-1}s,&q_{18}=st^{-1}s^{-1},&q_{19}=s^{-1}t^{-1},&q_{20}=s^{-1}t^{-1}s,\\
q_{21}=s^{-1}t^{-1}s^{-1},&q_{22}=t^{-1}st^{-1},&q_{23}=st^{-1}st^{-1},&q_{24}=s^{-1}t^{-1}st^{-1}.
