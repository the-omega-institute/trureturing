$$
T^X_\xi(x)=\inf\{f(x):0\le f\le u_X,\ f(\xi)=1\},\qquad
T^X_\xi\!\left(\sum_rv_r\eta_r\right)=\sum_rv_rT^X_{\eta_r}(\xi). \tag{79.1}
