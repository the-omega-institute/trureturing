\[
\Delta_T:=\mathbb E D(\mu_{Y_T}\Vert\mathcal R\nu_{Y_T})
=I(Z;Y_T\mid u),
\qquad
\boxed{\Delta_T=\frac{T^3}{6s}n_u+O(T^4).}
