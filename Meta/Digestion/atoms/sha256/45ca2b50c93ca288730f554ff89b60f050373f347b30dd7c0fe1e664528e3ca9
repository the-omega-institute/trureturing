$$
\boxed{
\mathcal V_s(T)
=
\sum_{\substack{
\delta_\rho>0\\
|\gamma_\rho|\le T
}}
m_\rho\,
\delta_\rho^s,
\qquad
s>0.
}
\tag{1264.1}
$$

