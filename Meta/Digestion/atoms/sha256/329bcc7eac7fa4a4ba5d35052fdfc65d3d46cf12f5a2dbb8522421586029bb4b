| 1 | $(0.04644285937,0.04644285939)$ | $+$ | $-$ |
| 2 | $(0.1199999998,0.1200000002)$ | $-$ | $+$ |
| 3 | $(0.1353256377,0.1353256382)$ | $+$ | $-$ |
| 4 | $(0.74789116120,0.74789116127)$ | $-$ | $+$ |
