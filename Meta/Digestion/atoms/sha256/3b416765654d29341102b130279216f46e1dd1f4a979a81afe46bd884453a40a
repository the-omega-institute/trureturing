(\mathcal V_M|_I,T_M,\mathcal J_M,Y_M,
 L_M|_{[-A,A]},C_M|_{[-A,A]},Z_M^{\rm dip})
\Longrightarrow
(\mathcal V|_I,N_2,\mathcal J_\infty,Y,
 L|_{[-A,A]},C|_{[-A,A]},Z),\qquad A>0.
