$$

$$
\Phi^f_\ell(\mathcal B)(X)=
 w_\ell\left(\int_{\mathcal B}g(u)du\right)
 \operatorname{tr}(EME^\dagger X)P_f
\quad(\mathcal B\subseteq[0,1]\text{ Borel}).
\tag{AC.76}
