$$
\boxed{
\mathcal R(\mathfrak O)
=
\left(
R_{\mathrm{id}},
R_T,
R_{\mathrm{dyn}},
R_{\mathrm{img}},
R_{\mathrm{glue}},
R_{\mathrm{metric}},
