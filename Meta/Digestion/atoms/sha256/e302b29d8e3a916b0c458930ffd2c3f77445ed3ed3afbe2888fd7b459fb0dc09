$$
\begin{aligned}
(p_r,x_r,y_r)&=
\begin{cases}(p_e,0,1-p_e),&r=e,\\
(p_i,x_i,1-p_i-x_i),&r=i,\end{cases}\\
v_{0r}&=p_r,\qquad v_{1r}=(x_r+3y_r)/4,\qquad
v_{2r}=(3x_r+y_r)/4,\\
