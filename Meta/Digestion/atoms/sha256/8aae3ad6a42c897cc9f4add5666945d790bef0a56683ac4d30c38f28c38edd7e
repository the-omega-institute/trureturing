\begin{gathered}
\Pr[\|\widehat D-D_h(n)\|_\infty\le e]\ge1-e,\\
T_V=q=3k\le L,\qquad
T_{\rm reset}=15\ell+1\le Q,\qquad
T_{\rm terminal}=1,\qquad T_R=q+1.
\end{gathered}
\tag{20.10}
