\begin{aligned}
\overline\delta
&:=\sup_{n,h}\frac12\left\|
 \Omega_{n,h}-\tau_h\otimes\operatorname{Tr}_R\Omega_{n,h}
 \right\|_1\\
&\le B_e
 \le\min\left\{1,
 \frac{160\sqrt{\log(18/e)}}{e\sqrt m}\right\}.
