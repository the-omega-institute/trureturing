  "audit_source": "import D5.S1.Recurrence.Parity.DiagonalIterateEven\nimport Lean\nopen Lean Elab Command\nrun_cmd do\n  let env \u2190 getEnv\n  let modulePrefix := \"D5.S1.Recurrence.Parity.DiagonalIterateEven\"\n  for tail in [\"generating_equation\", \"generating_unique\", \"hanna_conjecture\"] do\n    let root := (modulePrefix ++ \".\" ++ tail).toName\n    let mut pending := [root]\n    let mut seen : NameSet := {}\n    let mut localNames : Array String := #[]\n    let mut frozenNames : Array String := #[]\n    while !pending.isEmpty do\n      let name := pending.head!\n      pending := pending.tail!\n      if seen.contains name then continue\n      seen := seen.insert name\n      let text := name.toString\n      if text.contains \"DiagonalIterateEven\" then\n        localNames := localNames.push text\n      else if text.startsWith \"D5.\" then\n        frozenNames := frozenNames.push text\n        continue\n      else continue\n      if let some info := env.find? name then\n        let dependencies := info.type.getUsedConstants ++\n          ((info.value? (allowOpaque := true)).map Expr.getUsedConstants).getD #[]\n        for dependency in dependencies do\n          pending := dependency :: pending\n    logInfo (Json.mkObj [(\"theorem\", toJson root.toString),\n      (\"local_closure\", toJson localNames), (\"frozen_boundary\", toJson frozenNames)]).compress\n",
