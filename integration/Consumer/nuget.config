<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The integration workflow packs Trureturing.Truth into <repo>/localfeed; this path is relative
         to this nuget.config (integration/Consumer). -->
    <add key="local-truth-feed" value="../../localfeed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
