import D5.S1.Dynamics.Shadowing.MittagLefflerInverseLimit
import Mathlib.Topology.UniformSpace.HeineCantor
import Mathlib.Topology.MetricSpace.Basic

open TopologicalSpace Set Function Filter UniformSpace

open scoped Uniformity

namespace D5.S1.Dynamics.Shadowing

/-- Forward errors controlled by one entourage. -/
def UniformPseudoOrbit {X : Type*} (f : X → X) (D : Set (X × X))
    (a : ℕ → X) : Prop := ∀ n, (f (a n), a (n + 1)) ∈ D

/-- Every observation is chosen before the sequence. -/
def UniformHasShadowing {X : Type*} [UniformSpace X] (f : X → X) : Prop :=
  ∀ E ∈ 𝓤 X, ∃ D ∈ 𝓤 X, ∀ a : ℕ → X,
    UniformPseudoOrbit f D a → ∃ b, ∀ n, (f^[n] b, a n) ∈ E

/-- Relative tracing of an upstairs pseudo-orbit over a universally prescribed point. -/
def SourceRelativeTracing {X Y : Type*} [UniformSpace X] [UniformSpace Y]
    (p : Y → X) (g : Y → Y) (f : X → X) : Prop :=
  ∀ E ∈ 𝓤 Y, ∃ D ∈ 𝓤 Y, ∃ V ∈ 𝓤 X,
    ∀ a : ℕ → Y, ∀ x : X, UniformPseudoOrbit g D a →
      (∀ n, (p (a n), f^[n] x) ∈ V) →
      ∃ b, p b = x ∧ ∀ n, (g^[n] b, a n) ∈ E

/-- Exact-orbit lifting near a universally prescribed downstairs orbit. -/
def OrbitLifting {X Y : Type*} [UniformSpace X] [UniformSpace Y]
    (p : Y → X) (g : Y → Y) (f : X → X) : Prop :=
  ∀ E ∈ 𝓤 Y, ∃ V ∈ 𝓤 X, ∀ a : Y, ∀ x : X,
    (∀ n, (p (g^[n] a), f^[n] x) ∈ V) →
      ∃ b, p b = x ∧ ∀ n, (g^[n] b, g^[n] a) ∈ E

/-- The diagonal relation generated by an actual finite open cover. -/
def coverPairs {X : Type*} [TopologicalSpace X] (C : Finset (Opens X)) : Set (X × X) :=
  {xy | ∃ U ∈ C, xy.1 ∈ U ∧ xy.2 ∈ U}

private theorem coverPairs_mem {X : Type*} [UniformSpace X] [CompactSpace X]
    (C : Finset (Opens X)) (hC : IsOpenCover (fun U : C => U.1)) :
    coverPairs C ∈ 𝓤 X := by
  obtain ⟨D, hD, hDC⟩ := lebesgue_number_lemma (isCompact_univ : IsCompact (univ : Set X))
    (fun U : C => U.1.isOpen) (by
      intro x _
      obtain ⟨U, hx⟩ := hC.exists_mem x
      exact mem_iUnion.mpr ⟨U, hx⟩)
  apply mem_of_superset hD
  intro xy hxy
  obtain ⟨U, hU⟩ := hDC xy.1 (mem_univ _)
  exact ⟨U.1, U.2, hU (refl_mem_uniformity hD), hU hxy⟩

private theorem small_cover {X : Type*} [UniformSpace X] [CompactSpace X]
    (E : Set (X × X)) (hE : E ∈ 𝓤 X) :
    ∃ C : Finset (Opens X), IsOpenCover (fun U : C => U.1) ∧ coverPairs C ⊆ E := by
  classical
  obtain ⟨H, hH, hs, hHE⟩ := comp_symm_mem_uniformity_sets hE
  let : SetRel.IsSymm H := hs
  have hu : ∀ x : X, ∃ U : Opens X, x ∈ U ∧ (U : Set X) ⊆ ball x H := by
    intro x
    obtain ⟨U, hU, ho, hx⟩ := _root_.mem_nhds_iff.mp (ball_mem_nhds x hH)
    exact ⟨⟨U, ho⟩, hx, hU⟩
  choose U hx hU using hu
  obtain ⟨s, hscover⟩ := (isCompact_univ : IsCompact (univ : Set X)).elim_finite_subcover
    (fun x => (U x : Set X)) (fun x => (U x).isOpen)
    (fun x _ => mem_iUnion.mpr ⟨x, hx x⟩)
  refine ⟨s.image U, ?_, ?_⟩
  · rw [IsOpenCover, eq_top_iff]
    intro x _
    obtain ⟨y, hy, hxy⟩ := mem_iUnion₂.mp (hscover (mem_univ x))
    exact Opens.mem_iSup.mpr ⟨⟨U y, Finset.mem_image.mpr ⟨y, hy, rfl⟩⟩, hxy⟩
  · rintro xy ⟨T, hT, hxT, hyT⟩
    obtain ⟨x, _, rfl⟩ := Finset.mem_image.mp hT
    exact hHE (mem_comp_of_mem_ball (hU x hxT) (hU x hyT))

/-- On compact uniform spaces this is exactly the existing finite-cover contract.
No nonempty-space or onto-dynamics hypothesis is imposed. -/
theorem cover_shadowing_iff_uniform {X : Type*} [UniformSpace X] [CompactSpace X]
    (f : X → X) : HasShadowing f ↔ UniformHasShadowing f := by
  constructor
  · intro h E hE
    obtain ⟨C, hC, hCE⟩ := small_cover E hE
    obtain ⟨D, hD, ht⟩ := h C hC
    refine ⟨coverPairs D, coverPairs_mem D hD, fun a ha => ?_⟩
    obtain ⟨b, hb⟩ := ht a ha
    exact ⟨b, fun n => hCE (hb n)⟩
  · intro h C hC
    obtain ⟨D, hD, ht⟩ := h (coverPairs C) (coverPairs_mem C hC)
    obtain ⟨B, hB, hBD⟩ := small_cover D hD
    refine ⟨B, hB, fun a ha => ?_⟩
    obtain ⟨b, hb⟩ := ht a (fun n => hBD (ha n))
    exact ⟨b, hb⟩

/-- SR and OL are equivalent when the upstairs system shadows and p is uniformly continuous. -/
theorem source_relative_iff_orbit_lifting {X Y : Type*} [UniformSpace X] [UniformSpace Y]
    (p : Y → X) (g : Y → Y) (f : X → X) (hp : UniformContinuous p)
    (hg : UniformHasShadowing g) :
    SourceRelativeTracing p g f ↔ OrbitLifting p g f := by
  constructor
  · intro h E hE
    obtain ⟨D, hD, V, hV, ht⟩ := h E hE
    refine ⟨V, hV, fun a x hx => ht (fun n => g^[n] a) x ?_ hx⟩
    intro n
    simpa only [iterate_succ_apply'] using (refl_mem_uniformity hD (x := g (g^[n] a)))
  · intro h E hE
    obtain ⟨H, hH, _, hHE⟩ := comp_symm_mem_uniformity_sets hE
    obtain ⟨V₀, hV₀, hol⟩ := h H hH
    obtain ⟨V, hV, _, hVV⟩ := comp_symm_mem_uniformity_sets hV₀
    let L := H ∩ (fun yy : Y × Y => (p yy.1, p yy.2)) ⁻¹' V
    have hL : L ∈ 𝓤 Y := inter_mem hH (hp hV)
    obtain ⟨D, hD, htrace⟩ := hg L hL
    refine ⟨D, hD, V, hV, fun a x ha hx => ?_⟩
    obtain ⟨c, hc⟩ := htrace a ha
    obtain ⟨b, hbx, hb⟩ := hol c x (fun n => hVV ⟨p (a n), (hc n).2, hx n⟩)
    exact ⟨b, hbx, fun n => hHE ⟨g^[n] c, hb n, (hc n).1⟩⟩

/-- Positive expansivity uses all forward times, including zero. -/
def PositivelyExpansive {X : Type*} [MetricSpace X] (f : X → X) : Prop :=
  ∃ c : ℝ, 0 < c ∧ ∀ x y, (∀ n, dist (f^[n] x) (f^[n] y) < c) → x = y

/-- Any actual shadowing extension of a positively expansive metric system has SR.
Surjectivity and zero-dimensionality are unnecessary for this supplier. -/
theorem positive_expansivity_source_relative {X Y : Type*} [MetricSpace X]
    [UniformSpace Y] [CompactSpace Y] (p : Y → X) (g : Y → Y) (f : X → X)
    (hp : Continuous p) (he : Semiconj p g f) (hs : HasShadowing g)
    (hf : PositivelyExpansive f) : SourceRelativeTracing p g f := by
  apply (source_relative_iff_orbit_lifting p g f
    (CompactSpace.uniformContinuous_of_continuous hp)
    ((cover_shadowing_iff_uniform g).mp hs)).mpr
  obtain ⟨c, hc, hex⟩ := hf
  intro E hE
  refine ⟨{xy | dist xy.1 xy.2 < c}, Metric.dist_mem_uniformity hc, fun a x hx => ?_⟩
  have hax : p a = x := hex (p a) x (fun n => by
    simpa only [Set.mem_setOf_eq, ← he.iterate_right n a] using hx n)
  exact ⟨a, hax, fun n => refl_mem_uniformity hE⟩

#print axioms cover_shadowing_iff_uniform
#print axioms source_relative_iff_orbit_lifting
#print axioms positive_expansivity_source_relative

end D5.S1.Dynamics.Shadowing
