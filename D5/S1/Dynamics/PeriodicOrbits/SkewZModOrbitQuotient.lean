import D5.S1.Dynamics.PeriodicOrbits.SkewZModPeriodicOrbit
import Mathlib.GroupTheory.QuotientGroup.Basic

/-! # Holonomy quotients of cyclic skew orbits -/

set_option autoImplicit false

namespace D5.S1.Dynamics.PeriodicOrbits.SkewZModOrbitQuotient

open Function
open D5.S1.Dynamics.PeriodicOrbits.SkewAdditiveReturn
open D5.S1.Dynamics.PeriodicOrbits.SkewZModPeriodicOrbit

variable {X : Type*} {q : ℕ}

/-- The additive subgroup generated by the holonomy of the base cycle. -/
noncomputable def skewHolonomySubgroup (f : X → X) (c : X → ZMod q) (x : X) :
    AddSubgroup (ZMod q) :=
  AddSubgroup.zmultiples (birkhoffSum f c (minimalPeriod f x) x)

/-- Equality of quotient representatives is exactly equality of lifted periodic orbits. -/
theorem skew_periodicOrbit_quotient_eq_iff
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f)
    [NeZero q] (a b : ZMod q) :
    (QuotientAddGroup.mk' (skewHolonomySubgroup f c x) a :
        ZMod q ⧸ skewHolonomySubgroup f c x) =
      QuotientAddGroup.mk' (skewHolonomySubgroup f c x) b ↔
      Function.periodicOrbit (skewStep f c) (x, a) =
        Function.periodicOrbit (skewStep f c) (x, b) := by
  simp only [QuotientAddGroup.mk'_apply]
  rw [QuotientAddGroup.eq_iff_sub_mem]
  constructor
  · intro hab
    apply (skew_periodicOrbit_eq_iff f c x hx a b).2
    simpa only [skewHolonomySubgroup, neg_sub] using
      (skewHolonomySubgroup f c x).neg_mem hab
  · intro horb
    simpa only [skewHolonomySubgroup, neg_sub] using
      (skewHolonomySubgroup f c x).neg_mem
        ((skew_periodicOrbit_eq_iff f c x hx a b).1 horb)

#print axioms skew_periodicOrbit_quotient_eq_iff

end D5.S1.Dynamics.PeriodicOrbits.SkewZModOrbitQuotient
