set_option autoImplicit false

namespace D5.S1.Dynamics.PeriodicOrbits.SkewZModPeriodicOrbit

open Function
open D5.S1.Dynamics.PeriodicOrbits.SkewAdditiveReturn

variable {X : Type*} {q : ℕ}

/-- Two lifted periodic points over the same base point lie on the same forward orbit
exactly when their fiber displacement is an integer multiple of the base holonomy. -/
theorem skew_periodicOrbit_eq_iff
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f)
    [NeZero q] (a b : ZMod q) :
    Function.periodicOrbit (skewStep f c) (x, a) =
        Function.periodicOrbit (skewStep f c) (x, b) ↔
      b - a ∈ AddSubgroup.zmultiples
        (birkhoffSum f c (Function.minimalPeriod f x) x) := by
  have hq : q • birkhoffSum f c (Function.minimalPeriod f x) x = 0 := by
    rw [nsmul_eq_mul, ZMod.natCast_self, zero_mul]
  have hper (z : ZMod q) :
      (x, z) ∈ Function.periodicPts (skewStep f c) := by
    apply Function.mk_mem_periodicPts (n := Function.minimalPeriod f x * q)
      (Nat.mul_pos
        (Function.minimalPeriod_pos_of_mem_periodicPts hx)
        (Nat.pos_of_ne_zero (NeZero.ne q)))
    change (skewStep f c)^[Function.minimalPeriod f x * q] (x, z) = (x, z)
    rw [skew_iterate_block f c
      (Function.isPeriodicPt_minimalPeriod f x) q z, hq, add_zero]
  constructor
  · intro horb
    have hmem : (x, b) ∈ periodicOrbit (skewStep f c) (x, a) := by
      rw [horb]
      exact self_mem_periodicOrbit (hper b)
    obtain ⟨n, hn⟩ := (mem_periodicOrbit_iff (hper a)).mp hmem
    have hbase : f^[n] x = x := by
      have hfst := congrArg Prod.fst hn
      simpa only [skew_iterate] using hfst
    have hdiv : Function.minimalPeriod f x ∣ n :=
      (Function.isPeriodicPt_iff_minimalPeriod_dvd).mp hbase
    obtain ⟨k, rfl⟩ := hdiv
    rw [skew_iterate_block f c
      (Function.isPeriodicPt_minimalPeriod f x) k a] at hn
    have hab : a + k • birkhoffSum f c (Function.minimalPeriod f x) x = b :=
      congrArg Prod.snd hn
    refine AddSubgroup.mem_zmultiples_iff.mpr ⟨(k : ℤ), ?_⟩
    apply (eq_sub_iff_add_eq).2
    simpa [add_comm] using hab
  · intro hmem
    obtain ⟨k, hk⟩ := AddSubgroup.mem_zmultiples_iff.mp hmem
    let n : ℕ := k.natMod q
    have hcast : (n : ZMod q) = (k : ZMod q) := by
      dsimp [n, Int.natMod]
      have hnonneg : 0 ≤ k % (q : ℤ) :=
        Int.emod_nonneg _ (by exact_mod_cast (NeZero.ne q))
      calc
        (((k % (q : ℤ)).toNat : ℕ) : ZMod q) =
            ((((k % (q : ℤ)).toNat : ℕ) : ℤ) : ZMod q) := by
              rw [Int.cast_natCast]
        _ = ((k % (q : ℤ) : ℤ) : ZMod q) := by
              rw [Int.toNat_of_nonneg hnonneg]
        _ = (k : ZMod q) := ZMod.intCast_mod k q
    have hsmul : n • birkhoffSum f c (Function.minimalPeriod f x) x =
        k • birkhoffSum f c (Function.minimalPeriod f x) x := by
      rw [nsmul_eq_mul, zsmul_eq_mul, hcast]
    have hab : a + n • birkhoffSum f c (Function.minimalPeriod f x) x = b := by
      apply (eq_sub_iff_add_eq').mp
      exact hsmul.trans hk
    have hit :
        (skewStep f c)^[Function.minimalPeriod f x * n] (x, a) = (x, b) := by
      rw [skew_iterate_block f c
        (Function.isPeriodicPt_minimalPeriod f x) n a, hab]
    have horb := periodicOrbit_apply_iterate_eq (hper a)
      (Function.minimalPeriod f x * n)
    rw [hit] at horb
    exact horb.symm

/-- The additive subgroup generated by the holonomy of the base cycle. -/
noncomputable def skewHolonomySubgroup (f : X → X) (c : X → ZMod q) (x : X) :
    AddSubgroup (ZMod q) :=
  AddSubgroup.zmultiples (birkhoffSum f c (minimalPeriod f x) x)

/-- Equality of quotient representatives is exactly equality of lifted periodic orbits. -/
theorem skew_periodicOrbit_quotient_eq_iff
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f)
    [NeZero q] (a b : ZMod q) :
    (QuotientAddGroup.mk' (skewHolonomySubgroup f c x) a :
        ZMod q ⧸ skewHolonomySubgroup f c x) =
      QuotientAddGroup.mk' (skewHolonomySubgroup f c x) b ↔
      Function.periodicOrbit (skewStep f c) (x, a) =
        Function.periodicOrbit (skewStep f c) (x, b) := by
  simp only [QuotientAddGroup.mk'_apply]
  rw [QuotientAddGroup.eq_iff_sub_mem]
  constructor
  · intro hab
    apply (skew_periodicOrbit_eq_iff f c x hx a b).2
    simpa only [skewHolonomySubgroup, neg_sub] using
      (skewHolonomySubgroup f c x).neg_mem hab
  · intro horb
    simpa only [skewHolonomySubgroup, neg_sub] using
      (skewHolonomySubgroup f c x).neg_mem
        ((skew_periodicOrbit_eq_iff f c x hx a b).1 horb)

/-- Fiber translations preserving one lifted periodic orbit are exactly the
holonomy subgroup. -/
theorem skew_periodicOrbit_fiber_stabilizer_eq
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f)
    [NeZero q] (a : ZMod q) :
    {t : ZMod q |
      Function.periodicOrbit (skewStep f c) (x, a + t) =
        Function.periodicOrbit (skewStep f c) (x, a)} =
      (skewHolonomySubgroup f c x : Set (ZMod q)) := by
  ext t
  change (Function.periodicOrbit (skewStep f c) (x, a + t) =
      Function.periodicOrbit (skewStep f c) (x, a)) ↔
    t ∈ (skewHolonomySubgroup f c x : Set (ZMod q))
  rw [eq_comm, skew_periodicOrbit_eq_iff f c x hx a (a + t)]
  change (a + t - a ∈ AddSubgroup.zmultiples
      (birkhoffSum f c (Function.minimalPeriod f x) x)) ↔ _
  simp only [add_sub_cancel_left]
  rfl

/-- The family of lifted periodic orbits above a fixed periodic base point. -/
def skewOrbitFamily (f : X → X) (c : X → ZMod q) (x : X) :
    Set (Cycle (X × ZMod q)) :=
  Set.range (fun a : ZMod q =>
    Function.periodicOrbit (skewStep f c) (x, a))

private noncomputable def skewOrbitQuotientToFamily
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f) [NeZero q] :
    (ZMod q ⧸ skewHolonomySubgroup f c x) →
      {o : Cycle (X × ZMod q) // o ∈ skewOrbitFamily f c x} :=
  Quotient.lift
    (fun a : ZMod q =>
      (⟨Function.periodicOrbit (skewStep f c) (x, a), ⟨a, rfl⟩⟩ :
        {o : Cycle (X × ZMod q) // o ∈ skewOrbitFamily f c x}))
    (by
      intro a b hab
      apply Subtype.ext
      have hquot :
          (QuotientAddGroup.mk' (skewHolonomySubgroup f c x) a :
            ZMod q ⧸ skewHolonomySubgroup f c x) =
            QuotientAddGroup.mk' (skewHolonomySubgroup f c x) b :=
        Quot.sound hab
      have hmem' : a - b ∈ skewHolonomySubgroup f c x :=
        (QuotientAddGroup.eq_iff_sub_mem).mp hquot
      apply (skew_periodicOrbit_eq_iff f c x hx a b).2
      simpa only [skewHolonomySubgroup, neg_sub] using
        (skewHolonomySubgroup f c x).neg_mem hmem')

@[simp]
private theorem skewOrbitQuotientToFamily_mk
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f) [NeZero q] (a : ZMod q) :
    skewOrbitQuotientToFamily f c x hx
        (QuotientAddGroup.mk' (skewHolonomySubgroup f c x) a) =
      (⟨Function.periodicOrbit (skewStep f c) (x, a), ⟨a, rfl⟩⟩ :
        {o : Cycle (X × ZMod q) // o ∈ skewOrbitFamily f c x}) := rfl

private theorem skewOrbitQuotientToFamily_injective
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f) [NeZero q] :
    Function.Injective (skewOrbitQuotientToFamily f c x hx) := by
  intro u v huv
  obtain ⟨a, rfl⟩ := QuotientAddGroup.mk'_surjective
    (skewHolonomySubgroup f c x) u
  obtain ⟨b, rfl⟩ := QuotientAddGroup.mk'_surjective
    (skewHolonomySubgroup f c x) v
  apply (QuotientAddGroup.eq_iff_sub_mem).2
  have horb :
      Function.periodicOrbit (skewStep f c) (x, a) =
        Function.periodicOrbit (skewStep f c) (x, b) :=
    congrArg Subtype.val huv
  simpa only [skewHolonomySubgroup, neg_sub] using
    (skewHolonomySubgroup f c x).neg_mem
      ((skew_periodicOrbit_eq_iff f c x hx a b).1 horb)

private theorem skewOrbitQuotientToFamily_surjective
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f) [NeZero q] :
    Function.Surjective (skewOrbitQuotientToFamily f c x hx) := by
  intro o
  rcases o.property with ⟨a, ha⟩
  refine ⟨QuotientAddGroup.mk' (skewHolonomySubgroup f c x) a, ?_⟩
  apply Subtype.ext
  exact ha

/-- Quotienting the fiber by holonomy labels the lifted periodic orbit family. -/
noncomputable def skewOrbitQuotientEquivFamily
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f) [NeZero q] :
    (ZMod q ⧸ skewHolonomySubgroup f c x) ≃
      {o : Cycle (X × ZMod q) // o ∈ skewOrbitFamily f c x} :=
  Equiv.ofBijective (skewOrbitQuotientToFamily f c x hx)
    ⟨skewOrbitQuotientToFamily_injective f c x hx,
      skewOrbitQuotientToFamily_surjective f c x hx⟩

theorem skewOrbitFamily_card
    (f : X → X) (c : X → ZMod q) (x : X)
    (hx : x ∈ Function.periodicPts f) [NeZero q] :
    Nat.card {o : Cycle (X × ZMod q) // o ∈ skewOrbitFamily f c x} =
      q / addOrderOf (birkhoffSum f c (Function.minimalPeriod f x) x) := by
  let H := skewHolonomySubgroup f c x
  let h := birkhoffSum f c (Function.minimalPeriod f x) x
  calc
    Nat.card {o : Cycle (X × ZMod q) // o ∈ skewOrbitFamily f c x} =
        Nat.card (ZMod q ⧸ H) :=
      (Nat.card_congr (skewOrbitQuotientEquivFamily f c x hx)).symm
    _ = H.index := H.index_eq_card.symm
    _ = Nat.card (ZMod q) / Nat.card H := by
      rw [← H.card_mul_index, Nat.mul_div_cancel_left _ Nat.card_pos]
    _ = q / addOrderOf h := by
      rw [Nat.card_zmod q]
      rw [show Nat.card H = addOrderOf h by
        change Nat.card (AddSubgroup.zmultiples h) = addOrderOf h
        rw [Nat.card_eq_fintype_card]
        exact Fintype.card_zmultiples (x := h)]

#print axioms skew_periodicOrbit_eq_iff
#print axioms skew_periodicOrbit_quotient_eq_iff
#print axioms skew_periodicOrbit_fiber_stabilizer_eq
#print axioms skewOrbitFamily_card

end D5.S1.Dynamics.PeriodicOrbits.SkewZModPeriodicOrbit
