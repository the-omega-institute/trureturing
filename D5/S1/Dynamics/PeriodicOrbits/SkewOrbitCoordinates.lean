/- GID: D5/S1/Dynamics/PeriodicOrbits/SkewOrbitCoordinates
   generality: G
   mirror-B: D5/B/S1/Dynamics/PeriodicOrbits/SkewOrbitCoordinates
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: A lifted periodic orbit has unique base-position and holonomy-subgroup coordinates. -/

import D5.S1.Dynamics.PeriodicOrbits.SkewAdditiveReturn
import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

set_option autoImplicit false

namespace D5.S1.Dynamics.PeriodicOrbits.SkewOrbitCoordinates

open Function
open D5.S1.Dynamics.PeriodicOrbits.SkewAdditiveReturn

variable {X A : Type*} [AddCommGroup A]

/-- A periodic lifted orbit is a product of the base positions and the subgroup
generated by one-turn holonomy. At base position `i`, its phases form the coset
`a + birkhoffSum f c i x + zmultiples h`. Only the holonomy must have finite
order; the fiber group may be infinite and the base map need not be invertible. -/
theorem skew_orbit_coordinates (f : X → X) (c : X → A) (x : X) (a : A)
    (hx : x ∈ periodicPts f)
    (hh : IsOfFinAddOrder (birkhoffSum f c (minimalPeriod f x) x)) :
    Set.BijOn
      (fun z : Fin (minimalPeriod f x) ×
          AddSubgroup.zmultiples (birkhoffSum f c (minimalPeriod f x) x) =>
        (f^[z.1.val] x, a + (z.2 : A) + birkhoffSum f c z.1.val x))
      Set.univ {y | y ∈ periodicOrbit (skewStep f c) (x, a)} := by
  have hper : (x, a) ∈ periodicPts (skewStep f c) := by
    apply mk_mem_periodicPts
      (n := minimalPeriod f x * addOrderOf (birkhoffSum f c (minimalPeriod f x) x))
      (Nat.mul_pos (minimalPeriod_pos_of_mem_periodicPts hx) hh.addOrderOf_pos)
    change (skewStep f c)^[_] (x, a) = (x, a)
    rw [skew_iterate_block f c (isPeriodicPt_minimalPeriod f x)]
    simp
  refine ⟨?_, ?_, ?_⟩
  · intro z _
    obtain ⟨k, hk⟩ := hh.mem_multiples_iff_mem_zmultiples.mpr z.2.property
    apply (mem_periodicOrbit_iff hper).mpr
    refine ⟨z.1.val + minimalPeriod f x * k, ?_⟩
    rw [iterate_add_apply,
      skew_iterate_block f c (isPeriodicPt_minimalPeriod f x), skew_iterate]
    simpa only [hk]
  · intro z _ w _ heq
    have hi : z.1 = w.1 := Fin.ext
      ((iterate_eq_iterate_iff_of_lt_minimalPeriod z.1.isLt w.1.isLt).mp
        (congrArg Prod.fst heq))
    have hs := congrArg Prod.snd heq
    change a + (z.2 : A) + birkhoffSum f c z.1.val x =
      a + (w.2 : A) + birkhoffSum f c w.1.val x at hs
    rw [hi] at hs
    exact Prod.ext hi (Subtype.ext (add_left_cancel (add_right_cancel hs)))
  · intro y hy
    obtain ⟨n, rfl⟩ := (mem_periodicOrbit_iff hper).mp hy
    refine ⟨(⟨n % minimalPeriod f x,
      Nat.mod_lt _ (minimalPeriod_pos_of_mem_periodicPts hx)⟩,
      ⟨(n / minimalPeriod f x) • birkhoffSum f c (minimalPeriod f x) x,
        AddSubgroup.nsmul_mem _ (AddSubgroup.mem_zmultiples _) _⟩),
      Set.mem_univ _, ?_⟩
    conv_rhs => rw [← Nat.mod_add_div n (minimalPeriod f x)]
    rw [iterate_add_apply,
      skew_iterate_block f c (isPeriodicPt_minimalPeriod f x), skew_iterate]

#print axioms skew_orbit_coordinates

end D5.S1.Dynamics.PeriodicOrbits.SkewOrbitCoordinates
