import Mathlib.Data.Bool.Basic
import Mathlib.Dynamics.PeriodicPts.Lemmas
import Mathlib.Tactic

/- Library-search audit trail (2026-08-17):
   * Exact pinned-Mathlib hits `Function.IsPeriodicPt.minimalPeriod_pos`,
     `Function.IsPeriodicPt.minimalPeriod_le`, and
     `Function.minimalPeriod_eq_one_iff_isFixedPt` supply the period API.
   * Exact pinned-Mathlib hit `Bool.not_ne_self` excludes period one.
   * Loogle query `Function.minimalPeriod = 2` returned zero declarations;
     pinned-Mathlib and D5 searches likewise found no theorem stating that
     Boolean negation has minimal period exactly two. -/

namespace D5.S1.Dynamics.PeriodicOrbits.BooleanReversal

/-- Every Boolean state lies on the two-cycle generated by negation, and two
is its minimal positive return time. -/
theorem boolean_reversal_has_minimal_period_two (state : Bool) :
    Function.minimalPeriod Bool.not state = 2 := by
  have period_two : Function.IsPeriodicPt Bool.not 2 state := by
    cases state <;> rfl
  have period_pos : 0 < Function.minimalPeriod Bool.not state :=
    period_two.minimalPeriod_pos (by omega)
  have period_ne_one : Not (Function.minimalPeriod Bool.not state = 1) := by
    intro period_one
    have fixed : Function.IsFixedPt Bool.not state :=
      Function.minimalPeriod_eq_one_iff_isFixedPt.mp period_one
    exact Bool.not_ne_self state fixed
  have period_le_two : Function.minimalPeriod Bool.not state <= 2 :=
    period_two.minimalPeriod_le (by omega)
  omega

#print axioms boolean_reversal_has_minimal_period_two

end D5.S1.Dynamics.PeriodicOrbits.BooleanReversal
