open D5.S1.Words
open D5.S1.Words.Powers
open GoldenDesubstitutionLength
open GoldenDisplacementEulerProduct

namespace D5.S1.Deficit.Displacement.DisplacementSeriesDivergence

theorem nS_prime {p : ℕ} (hp : p.Prime) : nS p = p ^ 2 := by
  have hstart : goldenSubstStart 1 = 2 := by
    rw [goldenSubstStart_step_true goldenWord_zero, goldenSubstStart_zero]
  simpa [hstart] using nS_prime_pow hp 1

private theorem dTerm_prime {s w : ℝ} {p : ℕ} (hp : p.Prime) :
    dTerm s w p = (p : ℝ) ^ (-(2 * s + w)) := by
  have hpR : (0 : ℝ) < p := by exact_mod_cast hp.pos
  rw [← pow_one p, dTerm_prime_pow hp 1, pow_one, show goldenSubstStart 1 = 2 by
    rw [goldenSubstStart_step_true goldenWord_zero, goldenSubstStart_zero]]
  rw [← Real.rpow_natCast, ← Real.rpow_mul hpR.le, ← Real.rpow_add hpR]
  congr 1
  · norm_num
  · ring

theorem dTerm_not_summable_of_two_mul_add_le_one {s w : ℝ}
    (h : 2 * s + w <= 1) : Not (Summable (dTerm s w)) := by
  intro hsum
  have hprimes : Summable (fun p : Nat.Primes => dTerm s w p) :=
    hsum.subtype Nat.Prime
  have hrpow : Summable (fun p : Nat.Primes => (p : ℝ) ^ (-(2 * s + w))) :=
    hprimes.congr fun p => dTerm_prime p.prop
  have hexponent : -(2 * s + w) < -1 := Nat.Primes.summable_rpow.mp hrpow
  linarith

theorem summable_dTerm_zero_iff {w : ℝ} : Summable (dTerm 0 w) <-> 1 < w := by
  constructor
  · intro hsum
    by_contra hw
    exact dTerm_not_summable_of_two_mul_add_le_one (s := 0) (w := w)
      (by simpa using not_lt.mp hw) hsum
  · intro hw
    exact (dTerm_summable (s := 0) (w := w) (by norm_num) (by simpa using hw)).of_norm

#print axioms nS_prime
#print axioms dTerm_not_summable_of_two_mul_add_le_one
#print axioms summable_dTerm_zero_iff

