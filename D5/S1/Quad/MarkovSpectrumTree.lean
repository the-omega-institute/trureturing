   digest: The integer solutions of the Markov equation a²+b²+c²=3abc form a tree generated by the Vieta-jump edge c ↦ 3ab−c; the base triples give the Markov numbers 1, 2, 5. -/

import Mathlib

namespace D5.S1.Quad.MarkovSpectrumTree

/-- A Markov triple: an integer solution of the Markov equation `a² + b² + c² = 3abc`. -/
def IsMarkov (a b c : ℤ) : Prop := a ^ 2 + b ^ 2 + c ^ 2 = 3 * a * b * c

/-- The Vieta-jump edge of the Markov tree: fixing `a, b`, the map `c ↦ 3ab − c`
sends one Markov triple to another (the two roots of `x² − 3ab·x + (a²+b²)` sum to `3ab`). -/
theorem markov_vieta_step (a b c : ℤ) (h : IsMarkov a b c) :
    IsMarkov a b (3 * a * b - c) := by
  unfold IsMarkov at h ⊢
  linear_combination h

-- Seed triples: the Markov numbers 1, 2, 5 appear at the base of the tree.
example : IsMarkov 1 1 1 := by norm_num [IsMarkov]
example : IsMarkov 1 1 2 := by norm_num [IsMarkov]
example : IsMarkov 1 2 5 := by norm_num [IsMarkov]

-- Tree generation: the Vieta step generates the Markov number 5 from a base triple,
-- and 13 from the next branch — no re-proof, the theorem does the work.
example : IsMarkov 1 2 5 := markov_vieta_step 1 2 1 (by norm_num [IsMarkov])
example : IsMarkov 1 5 13 := markov_vieta_step 1 5 2 (by norm_num [IsMarkov])

end D5.S1.Quad.MarkovSpectrumTree
