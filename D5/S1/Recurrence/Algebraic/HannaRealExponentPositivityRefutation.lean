import Mathlib.Algebra.Polynomial.CoeffList
import Mathlib.Basic.Real.Basic
import Mathlib.RingTheory.PowerSeries.Log



namespace D5.S1.Recurrence.Algebraic.HannaRealExponentPositivityRefutation

/-- G = exp(G⁻¹ Integral G^t dx), with the integral constant zero and G(0) = 1.
The equations for J specify the formal primitive without duplicating an integral operator. -/
def IsSourceSeries (t : ℝ) (G : PowerSeries ℝ) : Prop :=
  PowerSeries.constantCoeff G = 1 ∧
    ∃ J : PowerSeries ℝ,
      PowerSeries.constantCoeff J = 0 ∧
      PowerSeries.derivative J =
        (PowerSeries.exp ℝ).subst (t • PowerSeries.logOf G) ∧
      G = (PowerSeries.exp ℝ).subst (G⁻¹ * J)

/-- The source's assertion, with existence explicit for each fixed real t. -/
def claim : Prop :=
  ∀ t : ℝ,
    (∃ G : PowerSeries ℝ, IsSourceSeries t G) ∧
      ∀ G : PowerSeries ℝ, IsSourceSeries t G →
        ((∀ j : ℕ, 0 ≤ PowerSeries.coeff j G) ↔ (8 : ℝ) / 3 ≤ t)

end D5.S1.Recurrence.Algebraic.HannaRealExponentPositivityRefutation

namespace D5.S1.Recurrence.Algebraic.HannaRealExponentPositivityRefutation
section BridgeSection
open PowerSeries

private theorem exp_log {G : PowerSeries ℝ} (hG : constantCoeff G = 1) :
    (exp ℝ).subst (logOf G) = G := by
  have hs : HasSubst (G-1) := .of_constantCoeff_zero (by
    change constantCoeff (G-1)=0
    rw [map_sub, map_one, hG, sub_self])
  rw [logOf_eq, ← subst_comp_subst_apply HasSubst.log hs (exp ℝ), subst_exp_log,
    ← coe_substAlgHom hs (R := ℝ), map_add, map_one]
  rw [coe_substAlgHom, subst_X hs]
  ring

private theorem log_exp {y : PowerSeries ℝ} (hy : constantCoeff y = 0) :
    logOf ((exp ℝ).subst y) = y := by
  rw [logOf_eq]
  have he : (exp ℝ).subst y - 1 = (exp ℝ - 1).subst y := by
    rw [← coe_substAlgHom (.of_constantCoeff_zero hy) (R := ℝ), map_sub, map_one]
  rw [he, ← subst_comp_subst_apply HasSubst.exp_sub_one
    (.of_constantCoeff_zero hy) (log ℝ), subst_log_exp_sub_one]
  exact subst_X (.of_constantCoeff_zero hy)

private theorem exp_smul_pow {y : PowerSeries ℝ} (hy : constantCoeff y = 0)
    (n : ℕ) : ((exp ℝ).subst y)^n = (exp ℝ).subst ((n : ℝ) • y) := by
  let hs : HasSubst y := .of_constantCoeff_zero hy
  rw [← subst_pow hs, exp_pow_eq_rescale_exp, rescale_eq_subst,
    subst_comp_subst_apply (HasSubst.smul_X' (n : ℝ)) hs,
    subst_smul hs, subst_X hs]

private theorem source_bridge {G : PowerSeries ℝ} (hG : IsSourceSeries (8/3) G) :
    ∃ y E u : PowerSeries ℝ,
      constantCoeff y = 0 ∧ constantCoeff E = 1 ∧ constantCoeff u = 1 ∧
      G = E^3 ∧ derivative G = E^8 * u ∧
      derivative y = E^5 * u ∧
      derivative E = C (1/3 : ℝ) * E^6 * u ∧
      derivative u = - E^5 * u^3 ∧ (1+y)*u = 1 := by
  obtain ⟨h0,J,hJ0,hJd,hJ⟩ := hG
  let y := logOf G
  have hy : constantCoeff y = 0 := constantCoeff_logOf h0
  have hGexp : G = (exp ℝ).subst y := (exp_log h0).symm
  have harg : constantCoeff (G⁻¹ * J) = 0 := by simp [hJ0]
  have hyJ : y = G⁻¹ * J := by
    dsimp [y]
    conv_lhs => rw [hJ]
    exact log_exp harg
  have hGy : G * y = J := by
    rw [hyJ, ← mul_assoc, PowerSeries.mul_inv_cancel G (by rw [h0]; norm_num), one_mul]
  let E := (exp ℝ).subst ((1/3 : ℝ) • y)
  have hE0 : constantCoeff E = 1 := by
    dsimp [E]
    rw [constantCoeff_eq, constantCoeff_subst_of_constantCoeff_zero (by simp [← constantCoeff_eq, hy])]
    simp
  have hEp (n : ℕ) : E^n = (exp ℝ).subst (((n : ℝ)/3) • y) := by
    rw [exp_smul_pow (by simp [← constantCoeff_eq, hy])]
    simp only [smul_smul, div_eq_mul_inv, one_mul]
  have hG3 : G = E^3 := by
    rw [hEp]
    norm_num
    exact hGexp
  have hGd : derivative G = G * derivative y := by
    conv_lhs => rw [hGexp]
    rw [derivative_subst (.of_constantCoeff_zero hy), derivative_exp, ← hGexp]
  have hEq : G * ((1+y) * derivative y) = E^8 := by
    rw [hEp]
    norm_num only [Nat.cast_ofNat]
    change G * ((1+y)*derivative y) = (exp ℝ).subst ((8/3 : ℝ) • logOf G)
    rw [← hJd]
    rw [← hGy, Derivation.leibniz, smul_eq_mul, smul_eq_mul, hGd]
    ring
  have hEi : E^3 * E^5 = E^8 := (pow_add E 3 5).symm
  have hEq' : (1+y) * derivative y = E^5 := by
    apply mul_left_cancel₀ (show G ≠ 0 from fun h => by simp [h] at h0)
    rw [hEq, hG3, hEi]
  let u := (1+y)⁻¹
  have hu0 : constantCoeff u = 1 := by simp [u, hy]
  have hu : (1+y)*u = 1 := PowerSeries.mul_inv_cancel _ (by simp [← constantCoeff_eq, hy])
  have hyd : derivative y = E^5 * u := by
    calc derivative y = derivative y * ((1+y)*u) := by rw [hu, mul_one]
         _ = ((1+y)*derivative y)*u := by ring
         _ = E^5*u := by rw [hEq']
  have hEd : derivative E = C (1/3 : ℝ) * E^6 * u := by
    dsimp [E] at ⊢
    rw [derivative_subst (.of_constantCoeff_zero (by simp [← constantCoeff_eq, hy])), derivative_exp,
      derivative.map_smul, hyd]
    change E * ((1/3 : ℝ) • (E^5*u)) = C (1/3 : ℝ)*E^6*u
    rw [smul_eq_C_mul (E^5*u)]
    ring
  have hud : derivative u = -E^5*u^3 := by
    dsimp [u]
    rw [derivative_inv', map_add, derivative_one, zero_add, hyd]
    change -u^2*(E^5*u) = _
    ring
  refine ⟨y,E,u,hy,hE0,hu0,hG3,?_,hyd,hEd,hud,hu⟩
  rw [hGd, hyd, hG3]
  ring


private theorem source_weights {G : PowerSeries ℝ} (hG : IsSourceSeries (8/3) G) :
    ∃ y B V : PowerSeries ℝ,
      constantCoeff y = 0 ∧ constantCoeff B = 1 ∧ constantCoeff V = (1/3 : ℝ) ∧
      derivative G = B ∧
      derivative B = B*V*(C 8*(1+y)-C 3) ∧
      derivative V = V^2*(C 5*(1+y)-C 6) ∧
      derivative y = C 3*(1+y)*V := by
  obtain ⟨y,E,u,hy,hE0,hu0,hG3,hGd,hyd,hEd,hud,hu⟩ := source_bridge hG
  let B := E^8*u
  let V := C (1/3 : ℝ)*E^5*u^2
  have hB0 : constantCoeff B = 1 := by simp [B,hE0,hu0]
  have hV0 : constantCoeff V = (1/3 : ℝ) := by simp [V,hE0,hu0]
  have hc : (3 : PowerSeries ℝ)*C (1/3 : ℝ)=1 := by
    calc _ = C ((3:ℝ)*(1/3)) := by rw [map_mul]; rw [map_ofNat C 3]
         _ = 1 := by norm_num
  refine ⟨y,B,V,hy,hB0,hV0,hGd,?_,?_,?_⟩
  · dsimp [B,V]
    simp only [Derivation.leibniz, derivative_pow, hEd, hud, smul_eq_mul]
    norm_num only [Nat.cast_ofNat, map_ofNat]
    linear_combination -(8*C (1/3 : ℝ)*E^13*u^2)*hu + (E^13*u^3)*hc
  · dsimp [V]
    simp only [Derivation.leibniz, derivative_C, derivative_pow, hEd, hud,
      smul_eq_mul, zero_mul, zero_add]
    norm_num only [Nat.cast_ofNat, map_ofNat]
    linear_combination -(5*(C (1/3 : ℝ))^2*E^10*u^3)*hu + (2*C (1/3 : ℝ)*E^10*u^4)*hc
  · dsimp [V]
    rw [hyd]
    norm_num only [map_ofNat]
    linear_combination -(3*C (1/3 : ℝ)*E^5*u)*hu - (E^5*u)*hc

end BridgeSection
section PolynomialSection
private def rowAux (a b c prev : ℤ) : List ℤ → List ℤ
  | [] => [b*prev]
  | h :: t => (a*h+b*prev+c*t.headD 0) :: rowAux (a+3) b (c+3) h t

private def rowStep (n : ℕ) (l : List ℤ) : List ℤ :=
  rowAux (6-(n : ℤ)) (5*(n : ℤ)+3) 3 0 l

private def qRows : ℕ → List ℤ
  | 0 => [1]
  | n+1 => rowStep (n+1) (qRows n)

open Polynomial
private theorem row_decompose (l : List ℤ) :
    C (l.headD 0) + X*ofCoeffList l.tail = ofCoeffList l := by
  cases l <;> simp [ofCoeffList]


private theorem rowAux_polynomial (a b c prev : ℤ) (l : List ℤ) :
    ofCoeffList (rowAux a b c prev l) =
      (C a+C b*X)*ofCoeffList l + C 3*(1+X)*(ofCoeffList l).derivative +
        C (c-3)*ofCoeffList l.tail + C (b*prev) := by
  induction l generalizing a c prev with
  | nil => simp [rowAux, ofCoeffList]
  | cons h t ih =>
    rw [rowAux, ofCoeffList_cons, ih, ofCoeffList_cons]
    simp only [List.tail_cons, derivative_add, derivative_C, derivative_mul,
      derivative_X, zero_add, one_mul, map_add, map_mul, map_sub, map_ofNat]
    linear_combination (C c) * row_decompose t

private theorem rowStep_polynomial (n : ℕ) (l : List ℤ) :
    ofCoeffList (rowStep n l) =
      (C (5*(n : ℤ)+3)*X+C (6-(n : ℤ)))*ofCoeffList l +
        C 3*(1+X)*(ofCoeffList l).derivative := by
  rw [rowStep, rowAux_polynomial]
  simp only [mul_zero, sub_self, map_zero, zero_mul, add_zero]
  ring

private noncomputable def Q (n : ℕ) : Polynomial ℤ := ofCoeffList (qRows n)
private theorem Q_zero : Q 0 = 1 := by
  simp only [Q, qRows, ofCoeffList_cons, ofCoeffList_nil, mul_zero, add_zero, map_one]
private theorem Q_step (n : ℕ) :
    Q (n+1) = (C (5*((n+1 : ℕ) : ℤ)+3)*X+C (6-((n+1 : ℕ) : ℤ)))*Q n +
      C 3*(1+X)*(Q n).derivative := by
  change ofCoeffList (rowStep (n+1) (qRows n)) = _
  exact rowStep_polynomial (n+1) (qRows n)

end PolynomialSection
open PowerSeries

private noncomputable def QR (n : ℕ) : Polynomial ℝ := (Q n).map (Int.castRingHom ℝ)

private theorem QR_step (n : ℕ) :
    QR (n+1) = (Polynomial.C (5*(n:ℝ)+8)*Polynomial.X+Polynomial.C (5-(n:ℝ)))*QR n +
      Polynomial.C 3*(1+Polynomial.X)*(QR n).derivative := by
  unfold QR
  rw [Q_step]
  simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X,
    Polynomial.map_one, Polynomial.derivative_map, Int.coe_castRingHom, Int.cast_add,
    Int.cast_sub, Int.cast_mul, Int.cast_natCast, Nat.cast_add, Nat.cast_one, Int.cast_ofNat]
  congr 3 <;> ring

private theorem weight_power (V W : PowerSeries ℝ)
    (hV : PowerSeries.derivative V = V^2*W) (n : ℕ) :
    PowerSeries.derivative (V^n) = (n : PowerSeries ℝ)*V^(n+1)*W := by
  cases n with
  | zero => simp
  | succ n =>
    rw [derivative_pow, hV]
    simp only [Nat.add_sub_cancel]
    ring


private theorem derivative_certificate (G y B V : PowerSeries ℝ)
    (hG : PowerSeries.derivative G = B)
    (hB : PowerSeries.derivative B = B*V*(C 8*(1+y)-C 3))
    (hV : PowerSeries.derivative V = V^2*(C 5*(1+y)-C 6))
    (hy : PowerSeries.derivative y = C 3*(1+y)*V) (n : ℕ) :
    (PowerSeries.derivative (R := ℝ))^[n+1] G = B*V^n*Polynomial.aeval y (QR n) := by
  induction n with
  | zero =>
    simpa [QR,Q_zero] using hG
  | succ n ih =>
    rw [Function.iterate_succ_apply', ih]
    rw [Derivation.leibniz, Derivation.leibniz,
      Derivation.comp_aeval_eq, weight_power V _ hV n, hB, hy]
    have hrec := congrArg (Polynomial.aeval y) (QR_step n)
    simp only [map_add, map_mul, map_one, Polynomial.aeval_C, Polynomial.aeval_X] at hrec
    rw [hrec]
    simp only [smul_eq_mul, Nat.cast_add, Nat.cast_one, pow_succ, map_add, map_sub,
      map_mul, map_natCast, map_ofNat]
    ring


private theorem constant_eval (p : Polynomial ℝ) (y : PowerSeries ℝ)
    (hy : constantCoeff y = 0) :
    constantCoeff (Polynomial.aeval y p) = p.coeff 0 := by
  rw [Polynomial.aeval_def, Polynomial.hom_eval₂]
  simp only [hy]
  have hc : (constantCoeff (R := ℝ)).comp (algebraMap ℝ (PowerSeries ℝ)) = RingHom.id ℝ := by
    exact PowerSeries.constantCoeff_comp_C
  rw [hc]
  simpa only [Polynomial.eval₂_at_zero, RingHom.id_apply]

private theorem source_coefficient {G : PowerSeries ℝ}
    (hG : IsSourceSeries (8/3) G) (n : ℕ) :
    (((n+1).factorial : ℕ) : ℝ) * coeff (n+1) G =
      (1/3 : ℝ)^n * ((Q n).coeff 0 : ℝ) := by
  obtain ⟨y,B,V,hy0,hB0,hV0,hGd,hBd,hVd,hyd⟩ := source_weights hG
  have hc := congrArg (constantCoeff (R := ℝ))
    (derivative_certificate G y B V hGd hBd hVd hyd n)
  rw [constantCoeff_iterate_derivative] at hc
  simp only [map_mul, map_pow, hB0, hV0, one_mul, constant_eval _ _ hy0] at hc
  rw [QR, Polynomial.coeff_map] at hc
  exact hc

private def runRows (start : ℕ) : ℕ → List ℤ → List ℤ
  | 0, l => l
  | k+1, l => rowStep (start+k+1) (runRows start k l)

private theorem qRows_add (start count : ℕ) :
    qRows (start+count) = runRows start count (qRows start) := by
  induction count with
  | zero => rfl
  | succ count ih =>
    rw [Nat.add_succ, qRows]
    exact congrArg (rowStep (start+count+1)) ih

private def checkpoint : List ℤ := [,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,]

attribute [irreducible] qRows runRows checkpoint

set_option maxRecDepth 10000 in
private theorem checkpoint_eq : qRows 360 = checkpoint := by
  set_option maxHeartbeats 0 in
    decide +kernel

set_option maxRecDepth 10000 in
private theorem tail_negative : (runRows 360 359 checkpoint).getD 0 0 < 0 := by
  set_option maxHeartbeats 0 in
    decide +kernel

private theorem numeric_negative : (qRows 719).getD 0 0 < 0 := by
  rw [show 719 = 360+359 from rfl, qRows_add, checkpoint_eq]
  exact tail_negative

private theorem Q_negative : (Q 719).coeff 0 < 0 := by
  simpa only [Q, Polynomial.coeff_ofCoeffList] using numeric_negative

theorem result : ¬ claim := by
  intro h
  obtain ⟨G,hG⟩ := (h ((8:ℝ)/3)).1
  have hp := ((h ((8:ℝ)/3)).2 G hG).mpr (le_rfl)
  have hc := source_coefficient hG 719
  have hq : ((Q 719).coeff 0 : ℝ) < 0 := by
    exact_mod_cast Q_negative
  have hcneg : ((720:ℕ).factorial : ℝ) * coeff 720 G < 0 := by
    rw [hc]
    exact mul_neg_of_pos_of_neg (by positivity) hq
  have hcpos : 0 ≤ ((720:ℕ).factorial : ℝ) * coeff 720 G := mul_nonneg (by positivity) (hp 720)
  exact (not_lt_of_ge hcpos) hcneg


end D5.S1.Recurrence.Algebraic.HannaRealExponentPositivityRefutation
