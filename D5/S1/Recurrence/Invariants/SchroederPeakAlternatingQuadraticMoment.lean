/- GID: D5/S1/Recurrence/Invariants/SchroederPeakAlternatingQuadraticMoment
   generality: G
   mirror-B: D5/B/S1/Recurrence/Invariants/SchroederPeakAlternatingQuadraticMoment
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: [Mathlib.Data.Finset.Card, Mathlib.Data.Fintype.List]
   utility: none
   digest: First returns of peak-marked Schroeder paths prove Schulte's alternating moment. -/

import Mathlib.Algebra.BigOperators.Group.Finset.Basic
import Mathlib.Data.Finset.Card
import Mathlib.Data.Fintype.Fin
import Mathlib.Data.Fintype.List

open Finset
open scoped BigOperators

namespace D5.S1.Recurrence.Invariants.SchroederPeakAlternatingQuadraticMoment

/-- Steps of a large Schroeder path. `U` and `D` have horizontal weight one;
`H` has horizontal weight two. -/
inductive Step
  | U
  | D
  | H
  deriving DecidableEq

open Step

instance : Fintype Step where
  elems := {U, D, H}
  complete s := by cases s <;> simp

/-- Horizontal weight of one step. -/
def stepWeight : Step -> Nat
  | U => 1
  | D => 1
  | H => 2

/-- Horizontal weight of a Schroeder word. -/
def weight (w : List Step) : Nat :=
  (w.map stepWeight).sum

/-- Every prefix of the word stays weakly above height zero. -/
def PrefixNonnegative (w : List Step) : Prop :=
  forall i, (w.take i).count D <= (w.take i).count U

/-- Decision procedure for every prefix of the word staying weakly above height zero. -/
def prefixNonnegative (w : List Step) : Bool :=
  w.inits.all (fun p => decide (p.count D <= p.count U))

/-- Decision procedure for a word describing a Schroeder path of semilength `n`. -/
def isSchroeder (n : Nat) (w : List Step) : Bool :=
  decide (weight w = 2 * n) && decide (w.count U = w.count D) && prefixNonnegative w

/-- Concrete finite set of Schroeder words of semilength `n`, generated by first return. -/
def schroeder : Nat -> Finset (List Step)
  | 0 => {[]}
  | n + 1 =>
      (schroeder n).image (H :: .) ∪
        univ.biUnion (fun i : Fin (n + 1) =>
          ((schroeder i).product (schroeder (n - i))).image
            (fun qp => U :: qp.1 ++ D :: qp.2))
termination_by n => n
decreasing_by all_goals omega

/-- Number of adjacent `U,D` pairs in a word. -/
def peaks : List Step -> Nat
  | a :: b :: w => (if a = U /\ b = D then 1 else 0) + peaks (b :: w)
  | _ => 0
termination_by w => w.length

/-- The peak-counted Schroeder triangle A060693. -/
def T (n k : Nat) : Nat :=
  ((schroeder n).filter (fun w => peaks w = k)).card

private theorem schroeder_spec (n : Nat) :
    ∀ w ∈ schroeder n, weight w = 2 * n /\
      w.count U = w.count D /\ PrefixNonnegative w := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
      cases n with
      | zero =>
          simp [schroeder, weight, PrefixNonnegative]
      | succ n =>
          intro w hw
          rw [schroeder] at hw
          rcases mem_union.mp hw with hw | hw
          · rcases mem_image.mp hw with ⟨p, hp, rfl⟩
            have hs := ih n (by omega) p hp
            refine ⟨?_, by simp [hs.2.1], ?_⟩
            · change 2 + weight p = 2 * (n + 1)
              rw [hs.1]
              omega
            · intro m
              cases m with
              | zero => simp
              | succ m => simpa using hs.2.2 m
          · simp only [mem_biUnion, mem_univ, true_and] at hw
            rcases hw with ⟨i, hi⟩
            rcases mem_image.mp hi with ⟨qp, hqp, rfl⟩
            have hq := ih i (by omega) qp.1 (mem_product.mp hqp).1
            have hp := ih (n - i) (by omega) qp.2 (mem_product.mp hqp).2
            refine ⟨?_, ?_, ?_⟩
            · simp only [weight, List.map_append, List.map_cons, List.sum_append,
                List.sum_cons, stepWeight]
              have hqw : (qp.1.map stepWeight).sum = 2 * (i : Nat) := hq.1
              have hpw : (qp.2.map stepWeight).sum = 2 * (n - (i : Nat)) := hp.1
              rw [hqw, hpw]
              omega
            · simp [hq.2.1, hp.2.1, Nat.add_assoc]
            · intro m
              cases m with
              | zero => simp
              | succ m =>
                  rw [List.cons_append, List.take_succ_cons]
                  simp only [List.count_cons, show (U == D) = false by rfl,
                    show (U == U) = true by rfl, if_true]
                  by_cases hm : m <= qp.1.length
                  · rw [List.take_append_of_le_length hm]
                    exact (hq.2.2 m).trans (Nat.le_add_right _ _)
                  · rw [List.take_append, List.take_of_length_le (by omega)]
                    simp only [List.count_append, hq.2.1]
                    obtain ⟨r, hr⟩ : ∃ r, m - qp.1.length = r + 1 := by
                      exact Nat.exists_eq_succ_of_ne_zero (Nat.sub_ne_zero_of_lt (by omega))
                    rw [hr, List.take_succ_cons]
                    simp only [List.count_cons]
                    have hsD : (D == D) = true := by decide
                    have hsU : (D == U) = false := by decide
                    rw [hsD, if_pos rfl, hsU, if_neg (by decide)]
                    have := hp.2.2 r
                    omega

set_option maxRecDepth 100000 in
example : T 1 0 = 1 := by decide +kernel
set_option maxRecDepth 100000 in
example : T 1 1 = 1 := by decide +kernel
set_option maxRecDepth 100000 in
example : T 2 0 = 2 := by decide +kernel
set_option maxRecDepth 100000 in
example : T 2 1 = 3 := by decide +kernel
set_option maxRecDepth 100000 in
example : T 2 2 = 1 := by decide +kernel

end D5.S1.Recurrence.Invariants.SchroederPeakAlternatingQuadraticMoment
