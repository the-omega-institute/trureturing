private def maskb (g s : ℕ) : Bool := (List.range (4*g+1)).all (fun i => ((s / 3^i) % 3 == 0) == (i % 4 == 0))

private theorem states_len : states.length = 9685 := by decide
private theorem states_map_step : states.map step = states.tail ++ [states[739]] := by decide
private theorem states_mask_free : states.all (fun s => !(maskb 11 s)) = true := by decide

private theorem step_mem {s : ℕ} (hs : s ∈ states) : step s ∈ states := by
  have hm : step s ∈ states.map step := List.mem_map.mpr ⟨s, hs, rfl⟩
  rw [states_map_step] at hm
  rcases (List.mem_append.mp hm) with h | h
  · exact List.mem_of_mem_tail h
  · have he : step s = states[739] := by simpa using h
    rw [he]
    exact List.getElem_mem (by decide)

private theorem orbit_mem (j : ℕ) : ((step^[j]) 1) ∈ states := by
  have hclosed : Set.MapsTo step {s | s ∈ states} {s | s ∈ states} :=
    fun _ hs => step_mem hs
  exact hclosed.iterate j
    (List.getElem_mem (l := states) (n := 0) (by rw [states_len]; decide))

private def maskP (g s : ℕ) : Prop := ∀ i : ℕ, i ≤ 4*g → ((s / 3^i) % 3 = 0 ↔ i % 4 = 0)

private theorem maskb_eq_true_iff (g s : ℕ) : maskb g s = true ↔ maskP g s := by
  simp [maskb, maskP, List.all_eq_true]

private theorem orbit_not_mask (j : ℕ) : ¬ maskP 11 (((step^[j]) 1)) := by
  intro h
  have hm := (List.all_eq_true.mp states_mask_free) (((step^[j]) 1)) (orbit_mem j)
  have hn : maskb 11 (((step^[j]) 1)) = false := by simpa using hm
  have ht : maskb 11 (((step^[j]) 1)) = true := (maskb_eq_true_iff 11 (((step^[j]) 1))).mpr h
  rw [ht] at hn
  contradiction

private theorem mul_add_div (r c a : ℕ) (hc : c < 3) :
    (3*r+c)/(3*a) = r/a := by
  rw [← Nat.div_div_eq_div_mul, Nat.mul_add_div (by decide : 0 < 3),
    Nat.div_eq_of_lt hc, Nat.add_zero]

private theorem digit_step {s i : ℕ} (hi : i < 60) :
    (step s / 3^(i+1) % 3) = (s / 3^i % 3) := by
  unfold step M
  rw [show 3^(i+1) = 3^i * 3 by rw [pow_succ', Nat.mul_comm]]
  have c_lt : (s % 3 + (s / 3^60)^2) % 3 < 3 := Nat.mod_lt _ (by decide)
  have hsmall : (3 * (s % 3^60) + (s % 3 + (s / 3^60)^2) % 3) /
      (3^i * 3) = (s % 3^60) / 3^i := by
    rw [show 3^i * 3 = 3 * 3^i by omega]
    exact mul_add_div (s % 3^60) ((s % 3 + (s / 3^60)^2) % 3) (3^i) c_lt
  rw [hsmall]
  have hpow : 3^i * 3 ∣ 3^60 := by
    have hp : 3^(i+1) ∣ 3^60 := pow_dvd_pow 3 (by omega)
    simpa [pow_succ', Nat.mul_comm] using hp
  have hmod : (s % 3^60) % (3^i * 3) = s % (3^i * 3) := by
    exact Nat.mod_mod_of_dvd s hpow
  have hdm := (by simpa only [Nat.mod_mod] using congrArg (fun t : ℕ => t % 3) (Nat.mod_mul_right_div_self s (3^i) 3).symm : (s / 3^i) % 3 = (s % (3^i*3) / 3^i) % 3)
  rw [hdm]
  have hdmr := (by simpa only [Nat.mod_mod] using congrArg (fun t : ℕ => t % 3) (Nat.mod_mul_right_div_self (s % 3^60) (3^i) 3).symm : (s % 3^60 / 3^i) % 3 = (s % 3^60 % (3^i*3) / 3^i) % 3)
  calc
    (s % 3^60 / 3^i) % 3 = (s % 3^60 % (3^i*3) / 3^i) % 3 := hdmr
    _ = (s % (3^i*3) / 3^i) % 3 := congrArg (fun t => t / (3^i) % 3) hmod


private theorem new_digit (s : ℕ) :
    (step s / 3 ^ 0 % 3) = ((s / 3 ^ 0 % 3 + (s / 3 ^ 60 % 3)^2) % 3) := by
  simp [step, M, Nat.add_mod, Nat.pow_mod]

private theorem digit_shift (j : ℕ) (i : ℕ) (hi : i ≤ 60) :
    ((((step^[(j+i)]) 1)) / 3 ^ i % 3) = ((((step^[j]) 1)) / 3 ^ 0 % 3) := by
  induction i with
  | zero => simp
  | succ i ih =>
    have hil : i < 60 := by exact Nat.lt_of_succ_le hi
    rw [show j + i.succ = (j+i)+1 by omega]
    rw [show ((step^[(j+i+1)]) 1) = step (((step^[(j+i)]) 1)) by
      simp [Function.iterate_succ_apply']]
    rw [digit_step hil]
    exact ih (by omega)

private def X (n : ℕ) : ZMod 3 :=
  if 61 ≤ n then ((((((step^[(n-61)]) 1)) / 3 ^ 0 % 3) : ℕ) : ZMod 3) else 0

private theorem X_zero (n : ℕ) (hn : n < 61) : X n = 0 := by simp [X, hn]

private theorem X_61 : X 61 = 1 := by norm_num [X]

private theorem initial_old : ∀ j : Fin 60, ((((step^[j.val]) 1)) / 3 ^ 60 % 3) = 0 := by decide

private theorem X_old (j : ℕ) :
    X (j+1) = ((((((step^[j]) 1)) / 3 ^ 60 % 3) : ℕ) : ZMod 3) := by
  by_cases hj : j < 60
  · have h := initial_old ⟨j, hj⟩
    rw [h]
    simp [X, show ¬ 61 ≤ j + 1 by omega]
  · have hj' : 60 ≤ j := by exact Nat.le_of_not_lt hj
    have hsub : j+1 - 61 = j-60 := by exact Nat.succ_sub_succ_eq_sub j 60
    have hsplit : j = (j-60)+60 := by exact (Nat.sub_add_cancel hj').symm
    unfold X
    rw [ite_eq_left (by omega), hsub, hsplit]
    have hcancel : j-60+60-60 = j-60 := by exact Nat.add_sub_cancel (j-60) 60
    rw [hcancel, digit_shift (j-60) 60 (by omega)]

private theorem X_recurrence (n : ℕ) (hn : 61+1 ≤ n) :
    X n = X (n-1) + X (n-61)^2 := by
  let j := n-62
  have hjn : n = j+62 := by exact (Nat.sub_add_cancel hn).symm
  have hXn : X n = ((((((step^[(j+1)]) 1)) / 3 ^ 0 % 3) : ℕ) : ZMod 3) := by
    rw [hjn]
    simp [X]
  have hXprev : X (n-1) = ((((((step^[j]) 1)) / 3 ^ 0 % 3) : ℕ) : ZMod 3) := by
    rw [hjn]
    simp [X]
  have hXlag : X (n-61) = ((((((step^[j]) 1)) / 3 ^ 60 % 3) : ℕ) : ZMod 3) := by
    rw [hjn]
    have hsub : j + 62 - 61 = j + 1 := by exact Nat.add_sub_assoc (by decide : 61 ≤ 62) j
    rw [hsub]
    exact X_old j
  rw [hXn, hXprev, hXlag]
  rw [show ((step^[(j+1)]) 1) = step (((step^[j]) 1)) by
    simp [Function.iterate_succ_apply']]
  rw [new_digit ((step^[j]) 1)]
  norm_num [ZMod.natCast_mod]


private theorem X_source : Trureturing.OpenProblems.FinchConjecture23CaptureOffset.IsSourceSequence 61 X := by
  refine ⟨?_, ?_, ?_⟩
  · intro n hn1 hnk
    exact X_zero n (by omega)
  · exact X_61
  · intro n hn
    exact X_recurrence n hn

private theorem digit_cast_eq_X (j i : ℕ) (hi : i ≤ j) (hi60 : i ≤ 60) :
    ((((((step^[j]) 1)) / 3 ^ i % 3) : ℕ) : ZMod 3) = X (j+61-i) := by
  have hsplit : j = (j-i)+i := by exact (Nat.sub_add_cancel hi).symm
  have hsub : j+61-i-61 = j-i := by exact Nat.add_sub_add_right j 61 i
  unfold X
  rw [ite_eq_left (by omega), hsub]
  have hd := congrArg (fun d : ℕ => (d : ZMod 3)) (digit_shift (j-i) i hi60)
  have hj : j-i+i = j := by exact Nat.sub_add_cancel hi
  rw [hj] at hd
  exact hd

private theorem digit_zero_cast (d : ℕ) (hd : d < 3) :
    ((d : ZMod 3) = 0 ↔ d = 0) := by
  simpa only [ZMod.val_natCast_of_lt hd] using (ZMod.val_eq_zero (d : ZMod 3)).symm

private theorem run_mask {r : ℕ} (hr : 62 ≤ r)
    (h : Trureturing.OpenProblems.FinchConjecture23CaptureOffset.IsRun 61 X r 15) : maskP 11 (((step^[(r-17)]) 1)) := by
  intro i hi
  have hi44 : i ≤ 44 := by omega
  have hij : i ≤ r-17 := by omega
  have hcast := digit_cast_eq_X (r-17) i hij (by omega)
  have hdigit : ((((step^[(r-17)]) 1)) / 3 ^ i % 3) < 3 := Nat.mod_lt _ (by decide)
  have hmod : i % 4 = 0 ↔ (44-i) % 4 = 0 := by omega
  by_cases hi4 : i % 4 = 0
  · have ht4 : (44-i) % 4 = 0 := hmod.mp hi4
    have ht : 44-i = 4*((44-i)/4) := by
      exact (Nat.mul_div_cancel' (Nat.dvd_of_mod_eq_zero ht4)).symm
    have hq : (44-i)/4 ≤ 15 := by omega
    have hz := h.2.2.1 ((44-i)/4) hq
    have hzero : X ((r-17)+61-i) = 0 := by
      rw [show (r-17)+61-i = r+(44-i) by omega, ht]
      exact hz
    have hzero' : ((((((step^[(r-17)]) 1)) / 3 ^ i % 3) : ℕ) : ZMod 3) = 0 := hcast.trans hzero
    constructor
    · intro _
      exact hi4
    · intro _
      exact (digit_zero_cast _ hdigit).mp hzero'
  · have ht4 : (44-i) % 4 ≠ 0 := by
      intro hh; exact hi4 (hmod.mpr hh)
    have htpos : 0 < 44-i := by exact Nat.pos_of_ne_zero (fun h0 => ht4 (by rw [h0]))
    have hnr : r < r+(44-i) := by exact Nat.lt_add_of_pos_right htpos
    have hupper : r+(44-i) < r+60 := by omega
    have hmodnr : (r+(44-i)-r) % 4 ≠ 0 := by
      rw [Nat.add_sub_cancel_left]
      exact ht4
    have hnon := h.2.2.2 (r+(44-i)) hnr hupper hmodnr
    have hnonzero : X ((r-17)+61-i) ≠ 0 := by
      rw [show (r-17)+61-i = r+(44-i) by omega]
      exact hnon
    have hcastne : ((((((step^[(r-17)]) 1)) / 3 ^ i % 3) : ℕ) : ZMod 3) ≠ 0 := by
      intro hz
      apply hnonzero
      exact hcast.symm.trans hz
    have hdne : ((((step^[(r-17)]) 1)) / 3 ^ i % 3) ≠ 0 := by
      intro hd0
      exact hcastne ((digit_zero_cast _ hdigit).mpr hd0)
    constructor
    · intro hd0
      exact (hdne hd0).elim
    · intro hi4eq
      exact (hi4 hi4eq).elim

theorem result : ¬ claim := by
  intro hc
  have h61 := (hc 61 (by norm_num)).2
  have hruns := h61 X X_source (by norm_num) (by norm_num)
  rcases hruns with ⟨r, hr⟩
  have hm := run_mask hr.1 hr
  have hnot := orbit_not_mask (r-17)
  exact hnot hm


end D5.S1.Recurrence.FinchZeroRunsModThree
