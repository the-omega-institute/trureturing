import Mathlib.Algebra.LinearRecurrence
import Mathlib.RingTheory.PowerSeries.Inverse
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace D5.S1.Recurrence.BoerdijkCoxeterGeneratingFunctions

abbrev Point := Fin 3 → ℚ

def sqDist (a b : Point) : ℚ := ∑ i, (a i - b i) ^ 2

def faceCenter (b c d : Point) : Point :=
  fun i => (b i + c i + d i) / 3

def reflected (a b c d : Point) : Point :=
  fun i => 2 * faceCenter b c d i - a i

def regular (a b c d : Point) : Prop :=
  sqDist a b = sqDist a c ∧ sqDist a b = sqDist a d ∧
  sqDist a b = sqDist b c ∧ sqDist a b = sqDist b d ∧
  sqDist a b = sqDist c d

def faceOrthogonal (a b c d x : Point) : Prop :=
  (∑ i, (a i - faceCenter b c d i) *
    (x i - faceCenter b c d i)) = 0

def faceNoncollinear (b c d : Point) : Prop :=
  ¬ ∃ q : ℚ, ∀ i, d i - b i = q * (c i - b i)

set_option maxHeartbeats 1000000 in
-- Expanding three squared coordinates makes the ring identities large.
private theorem reflection_bridge (a b c d : Point)
    (h : regular a b c d) :
    faceOrthogonal a b c d b ∧
    faceOrthogonal a b c d c ∧
    faceOrthogonal a b c d d ∧
    (∀ i, (a i + reflected a b c d i) / 2 = faceCenter b c d i) ∧
    regular b c d (reflected a b c d) := by
  rcases h with ⟨habac, habad, habbc, habbd, habcd⟩
  simp [regular, sqDist, faceOrthogonal, faceCenter, reflected,
    Fin.sum_univ_succ] at *
  refine ⟨?_, ?_, ?_, ?_⟩
  · linear_combination (-1/6 : ℚ) * habac - 1/6 * habad -
      1/18 * habbc - 1/18 * habbd + 1/9 * habcd
  · linear_combination (1/3 : ℚ) * habac - 1/6 * habad -
      1/18 * habbc + 1/9 * habbd - 1/18 * habcd
  · linear_combination (-1/6 : ℚ) * habac + 1/3 * habad +
      1/9 * habbc - 1/18 * habbd - 1/18 * habcd
  · refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · exact habbc.symm.trans habbd
    · linear_combination (2/3 : ℚ) * habac + 2/3 * habad -
        7/9 * habbc + 2/9 * habbd - 4/9 * habcd
    · exact habbc.symm.trans habcd
    · linear_combination (-1/3 : ℚ) * habac + 2/3 * habad -
        7/9 * habbc - 4/9 * habbd + 2/9 * habcd
    · linear_combination (2/3 : ℚ) * habac - 1/3 * habad -
        13/9 * habbc + 2/9 * habbd + 2/9 * habcd

private def stepRecurrence : LinearRecurrence ℚ :=
  ⟨4, ![(-1 : ℚ), 2 / 3, 2 / 3, 2 / 3]⟩

private def initial : Fin 4 → Point :=
  fun j i =>
    if j = 0 then -1
    else if j = 1 then if i = 0 then -1 else 1
    else if j = 2 then if i = 1 then -1 else 1
    else if i = 2 then -1 else 1

/-- Vertices in the ordered OEIS orientation, generated by face reflection. -/
def vertex (n : ℕ) : Point :=
  fun i => stepRecurrence.mkSol (fun j => initial j i) n

private theorem vertex_initial (j : Fin 4) (i : Fin 3) :
    vertex j i = initial j i := by
  exact stepRecurrence.mkSol_eq_init (fun k => initial k i) j

private theorem vertex_step (n : ℕ) (i : Fin 3) :
    vertex (n + 4) i =
      (2 / 3) * (vertex (n + 1) i + vertex (n + 2) i + vertex (n + 3) i) -
        vertex n i := by
  have h := stepRecurrence.is_sol_mkSol (fun j => initial j i) n
  change vertex (n + 4) i =
    ∑ j : Fin 4, stepRecurrence.coeffs j * vertex (n + j) i at h
  simp [stepRecurrence, Fin.sum_univ_succ] at h
  convert h using 1 <;> ring

private theorem vertex_step_reflected (n : ℕ) :
    vertex (n + 4) = reflected (vertex n) (vertex (n + 1))
      (vertex (n + 2)) (vertex (n + 3)) := by
  funext i
  rw [vertex_step]
  simp [reflected, faceCenter]
  ring

private theorem regular_initial :
    regular (vertex 0) (vertex 1) (vertex 2) (vertex 3) := by
  have hv (j : Fin 4) : vertex j = initial j := by
    funext i
    exact vertex_initial j i
  change regular (vertex (0 : Fin 4)) (vertex (1 : Fin 4))
    (vertex (2 : Fin 4)) (vertex (3 : Fin 4))
  rw [hv 0, hv 1, hv 2, hv 3]
  simp [regular, sqDist, initial, Fin.sum_univ_succ]
  norm_num

private theorem regular_vertices (n : ℕ) :
    regular (vertex n) (vertex (n + 1))
      (vertex (n + 2)) (vertex (n + 3)) := by
  induction n with
  | zero => simpa using regular_initial
  | succ n ih =>
      have h := (reflection_bridge _ _ _ _ ih).2.2.2.2
      rw [← vertex_step_reflected n] at h
      simpa [Nat.add_assoc] using h

private theorem edge_length (n : ℕ) :
    sqDist (vertex n) (vertex (n + 1)) = 8 := by
  induction n with
  | zero =>
      have hv (j : Fin 4) : vertex j = initial j := by
        funext i
        exact vertex_initial j i
      change sqDist (vertex (0 : Fin 4)) (vertex (1 : Fin 4)) = 8
      rw [hv 0, hv 1]
      simp [sqDist, initial, Fin.sum_univ_succ]
      norm_num
  | succ n ih =>
      have h := (regular_vertices n).2.2.1
      simpa [Nat.add_assoc] using h.symm.trans ih

set_option maxHeartbeats 1000000 in
-- The altitude identity expands six squared-distance equations in three coordinates.
private theorem altitude_sq (a b c d : Point) (h : regular a b c d) :
    sqDist a (faceCenter b c d) = (2 / 3) * sqDist a b := by
  rcases h with ⟨habac, habad, habbc, habbd, habcd⟩
  simp [sqDist, faceCenter, Fin.sum_univ_succ] at *
  linear_combination (-1/3 : ℚ) * habac - 1/3 * habad +
    1/9 * habbc + 1/9 * habbd + 1/9 * habcd

private theorem face_normal_ne_zero (n : ℕ) :
    vertex n ≠ faceCenter (vertex (n + 1)) (vertex (n + 2))
      (vertex (n + 3)) := by
  intro heq
  have hz : sqDist (vertex n)
      (faceCenter (vertex (n + 1)) (vertex (n + 2))
        (vertex (n + 3))) = 0 := by
    rw [heq]
    simp [sqDist]
  have ha := altitude_sq _ _ _ _ (regular_vertices n)
  rw [hz, edge_length] at ha
  norm_num at ha

private theorem face_noncollinear (n : ℕ) :
    faceNoncollinear (vertex (n + 1)) (vertex (n + 2))
      (vertex (n + 3)) := by
  let b := vertex (n + 1)
  let c := vertex (n + 2)
  let d := vertex (n + 3)
  intro ⟨q, hq⟩
  have hbc : sqDist b c = 8 := by
    calc
      sqDist b c = sqDist (vertex n) b :=
        (regular_vertices n).2.2.1.symm
      _ = 8 := edge_length n
  have hbd : sqDist b d = 8 := by
    calc
      sqDist b d = sqDist (vertex n) b :=
        (regular_vertices n).2.2.2.1.symm
      _ = 8 := edge_length n
  have hcd : sqDist c d = 8 := by
    calc
      sqDist c d = sqDist (vertex n) b :=
        (regular_vertices n).2.2.2.2.symm
      _ = 8 := edge_length n
  have hbdq : sqDist b d = q ^ 2 * sqDist b c := by
    change (∑ i, (b i - d i) ^ 2) =
      q ^ 2 * ∑ i, (b i - c i) ^ 2
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    have hi : b i - d i = q * (b i - c i) := by
      linear_combination -(hq i)
    rw [hi]
    ring
  have hcdq : sqDist c d = (1 - q) ^ 2 * sqDist b c := by
    change (∑ i, (c i - d i) ^ 2) =
      (1 - q) ^ 2 * ∑ i, (b i - c i) ^ 2
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    have hi : c i - d i = (1 - q) * (c i - b i) := by
      linear_combination -(hq i)
    rw [hi]
    ring
  rw [hbc, hbd] at hbdq
  rw [hbc, hcd] at hcdq
  nlinarith

/-- The OEIS scaling factor, equal to one through index three. -/
def scale (n : ℕ) : ℚ :=
  if n ≤ 3 then 1 else (3 : ℚ) ^ (n - 3)

/-- An exact rational coordinate of the scaled helix. -/
def scaled (n : ℕ) (i : Fin 3) : ℚ :=
  scale n * vertex n i

private theorem scale_tail (n : ℕ) (hn : 3 ≤ n) :
    scale n = (3 : ℚ) ^ (n - 3) := by
  by_cases h : n = 3
  · subst n
    norm_num [scale]
  · have h4 : 4 ≤ n := by omega
    simp [scale, show ¬ n ≤ 3 by omega]

private theorem scaled_tail (n : ℕ) (hn : 3 ≤ n) (i : Fin 3) :
    scaled (n + 4) i =
      2 * scaled (n + 3) i + 6 * scaled (n + 2) i +
        18 * scaled (n + 1) i - 81 * scaled n i := by
  have hs (k : ℕ) : scale (n + k) = (3 : ℚ) ^ (n - 3) * 3 ^ k := by
    rw [scale_tail _ (by omega), show n + k - 3 = (n - 3) + k by omega,
      pow_add]
  have hs0 : scale n = (3 : ℚ) ^ (n - 3) := scale_tail n hn
  simp only [scaled, hs0, hs 1, hs 2, hs 3, hs 4]
  rw [vertex_step n i]
  ring

private def denominator : PowerSeries ℚ :=
  1 + PowerSeries.C (-2) * PowerSeries.X ^ 1 +
    PowerSeries.C (-6) * PowerSeries.X ^ 2 +
    PowerSeries.C (-18) * PowerSeries.X ^ 3 +
    PowerSeries.C 81 * PowerSeries.X ^ 4

private theorem denominator_coeff (i : Fin 3) (n : ℕ) :
    PowerSeries.coeff n
      (denominator * PowerSeries.mk (fun k => scaled k i)) =
    scaled n i -
      2 * (if 1 ≤ n then scaled (n - 1) i else 0) -
      6 * (if 2 ≤ n then scaled (n - 2) i else 0) -
      18 * (if 3 ≤ n then scaled (n - 3) i else 0) +
      81 * (if 4 ≤ n then scaled (n - 4) i else 0) := by
  simp only [denominator, add_mul, one_mul, map_add,
    mul_assoc, PowerSeries.coeff_C_mul,
    PowerSeries.coeff_X_pow_mul', PowerSeries.coeff_mk]
  simp only [mul_ite, mul_zero]
  split_ifs <;> ring

private theorem vertex_four (i : Fin 3) : vertex 4 i = 5 / 3 := by
  have h := vertex_step 0 i
  have h0 := vertex_initial (0 : Fin 4) i
  have h1 := vertex_initial (1 : Fin 4) i
  have h2 := vertex_initial (2 : Fin 4) i
  have h3 := vertex_initial (3 : Fin 4) i
  norm_num at h0 h1 h2 h3
  norm_num at h
  rw [h0, h1, h2, h3] at h
  fin_cases i <;> simp [initial] at h ⊢ <;> linarith

private theorem vertex_five (i : Fin 3) :
    vertex 5 i = if i = 0 then 31 / 9 else 1 / 9 := by
  have h := vertex_step 1 i
  have h1 := vertex_initial (1 : Fin 4) i
  have h2 := vertex_initial (2 : Fin 4) i
  have h3 := vertex_initial (3 : Fin 4) i
  norm_num at h1 h2 h3
  norm_num at h
  rw [h1, h2, h3, vertex_four] at h
  fin_cases i <;> simp [initial] at h ⊢ <;> linarith

private theorem vertex_six (i : Fin 3) :
    vertex 6 i = if i = 0 then 83 / 27 else if i = 1 then 77 / 27 else -13 / 27 := by
  have h := vertex_step 2 i
  have h2 := vertex_initial (2 : Fin 4) i
  have h3 := vertex_initial (3 : Fin 4) i
  norm_num at h2 h3
  norm_num at h
  rw [h2, h3, vertex_four, vertex_five] at h
  fin_cases i <;> simp [initial] at h ⊢ <;> linarith

private theorem scaled_prefix (i : Fin 3) :
    scaled 0 i = initial 0 i ∧
    scaled 1 i = initial 1 i ∧
    scaled 2 i = initial 2 i ∧
    scaled 3 i = initial 3 i ∧
    scaled 4 i = 5 ∧
    scaled 5 i = (if i = 0 then 31 else 1) ∧
    scaled 6 i = (if i = 0 then 83 else if i = 1 then 77 else -13) := by
  have h0 := vertex_initial (0 : Fin 4) i
  have h1 := vertex_initial (1 : Fin 4) i
  have h2 := vertex_initial (2 : Fin 4) i
  have h3 := vertex_initial (3 : Fin 4) i
  norm_num at h0 h1 h2 h3
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa [scaled, scale] using h0
  · simpa [scaled, scale] using h1
  · simpa [scaled, scale] using h2
  · simpa [scaled, scale] using h3
  · norm_num [scaled, scale, vertex_four]
  · fin_cases i <;> norm_num [scaled, scale, vertex_five]
  · fin_cases i <;> norm_num [scaled, scale, vertex_six]

private def numerator (i : Fin 3) : PowerSeries ℚ :=
  let X := PowerSeries.X (R := ℚ)
  if i = 0 then
    PowerSeries.C (-1) + PowerSeries.C 1 * X ^ 1 +
      PowerSeries.C 9 * X ^ 2 + PowerSeries.C 23 * X ^ 3 +
      PowerSeries.C (-66) * X ^ 4 + PowerSeries.C (-84) * X ^ 5 +
      PowerSeries.C 54 * X ^ 6
  else if i = 1 then
    PowerSeries.C (-1) + PowerSeries.C 3 * X ^ 1 +
      PowerSeries.C 3 * X ^ 2 + PowerSeries.C 15 * X ^ 3 +
      PowerSeries.C (-90) * X ^ 4 + PowerSeries.C 84 * X ^ 5 +
      PowerSeries.C (-54) * X ^ 6
  else
    PowerSeries.C (-1) + PowerSeries.C 3 * X ^ 1 +
      PowerSeries.C 5 * X ^ 2 + PowerSeries.C 9 * X ^ 3 +
      PowerSeries.C (-98) * X ^ 4 + PowerSeries.C 60 * X ^ 5 +
      PowerSeries.C 54 * X ^ 6

private theorem denominator_mul_series (i : Fin 3) :
    denominator * PowerSeries.mk (fun n => scaled n i) = numerator i := by
  ext n
  rw [denominator_coeff]
  by_cases hn : 7 ≤ n
  · have ht := scaled_tail (n - 4) (by omega) i
    have he : n - 4 + 4 = n := by omega
    have he1 : n - 4 + 3 = n - 1 := by omega
    have he2 : n - 4 + 2 = n - 2 := by omega
    have he3 : n - 4 + 1 = n - 3 := by omega
    rw [he, he1, he2, he3] at ht
    simp only [if_pos (show 1 ≤ n by omega), if_pos (show 2 ≤ n by omega),
      if_pos (show 3 ≤ n by omega), if_pos (show 4 ≤ n by omega)]
    have hn0 : n ≠ 0 := by omega
    have hn1 : n ≠ 1 := by omega
    have hn2 : n ≠ 2 := by omega
    have hn3 : n ≠ 3 := by omega
    have hn4 : n ≠ 4 := by omega
    have hn5 : n ≠ 5 := by omega
    have hn6 : n ≠ 6 := by omega
    have hz : PowerSeries.coeff n (numerator i) = 0 := by
      fin_cases i <;>
        simp [numerator, PowerSeries.coeff_C_mul_X_pow, PowerSeries.coeff_X,
          hn0, hn1, hn2, hn3, hn4, hn5, hn6]
    rw [hz]
    linear_combination ht
  · have hlt : n < 7 := by omega
    rcases scaled_prefix i with ⟨h0, h1, h2, h3, h4, h5, h6⟩
    interval_cases n <;> simp only [h0, h1, h2, h3, h4, h5, h6] <;>
      fin_cases i <;>
      simp [numerator, PowerSeries.coeff_C_mul_X_pow,
        PowerSeries.coeff_X, initial] <;> norm_num

private theorem series_eq_numerator (i : Fin 3) :
    PowerSeries.mk (fun n => scaled n i) =
      numerator i * PowerSeries.invOfUnit denominator 1 := by
  have hc : PowerSeries.constantCoeff denominator = (1 : ℚ) := by
    simp [denominator]
  calc
    PowerSeries.mk (fun n => scaled n i) =
        1 * PowerSeries.mk (fun n => scaled n i) := by rw [one_mul]
    _ = (PowerSeries.invOfUnit denominator 1 * denominator) *
        PowerSeries.mk (fun n => scaled n i) := by
          rw [PowerSeries.invOfUnit_mul denominator 1 hc]
    _ = PowerSeries.invOfUnit denominator 1 *
        (denominator * PowerSeries.mk (fun n => scaled n i)) := by rw [mul_assoc]
    _ = PowerSeries.invOfUnit denominator 1 * numerator i := by
          rw [denominator_mul_series]
    _ = numerator i * PowerSeries.invOfUnit denominator 1 := by rw [mul_comm]

private theorem coeff_cast (n : ℕ) :
    PowerSeries.C (n : ℚ) = (n : PowerSeries ℚ) := by
  exact map_natCast (PowerSeries.C (R := ℚ)) n

private theorem denominator_factored :
    denominator =
      (3 * PowerSeries.X - 1) ^ 2 *
        (9 * PowerSeries.X ^ 2 + 4 * PowerSeries.X + 1 : PowerSeries ℚ) := by
  norm_num [denominator, coeff_cast]
  have h2 : PowerSeries.C (2 : ℚ) = (2 : PowerSeries ℚ) := coeff_cast 2
  have h6 : PowerSeries.C (6 : ℚ) = (6 : PowerSeries ℚ) := coeff_cast 6
  have h18 : PowerSeries.C (18 : ℚ) = (18 : PowerSeries ℚ) := coeff_cast 18
  have h81 : PowerSeries.C (81 : ℚ) = (81 : PowerSeries ℚ) := coeff_cast 81
  rw [h2, h6, h18, h81]
  ring

private theorem numerator_x :
    numerator 0 =
      (54 * PowerSeries.X ^ 6 - 84 * PowerSeries.X ^ 5 -
        66 * PowerSeries.X ^ 4 + 23 * PowerSeries.X ^ 3 +
        9 * PowerSeries.X ^ 2 + PowerSeries.X - 1 : PowerSeries ℚ) := by
  norm_num [numerator, coeff_cast]
  have h9 : PowerSeries.C (9 : ℚ) = (9 : PowerSeries ℚ) := coeff_cast 9
  have h23 : PowerSeries.C (23 : ℚ) = (23 : PowerSeries ℚ) := coeff_cast 23
  have h66 : PowerSeries.C (66 : ℚ) = (66 : PowerSeries ℚ) := coeff_cast 66
  have h84 : PowerSeries.C (84 : ℚ) = (84 : PowerSeries ℚ) := coeff_cast 84
  have h54 : PowerSeries.C (54 : ℚ) = (54 : PowerSeries ℚ) := coeff_cast 54
  rw [h9, h23, h66, h84, h54]
  ring

private theorem numerator_y :
    numerator 1 =
      (-54 * PowerSeries.X ^ 6 + 84 * PowerSeries.X ^ 5 -
        90 * PowerSeries.X ^ 4 + 15 * PowerSeries.X ^ 3 +
        3 * PowerSeries.X ^ 2 + 3 * PowerSeries.X - 1 : PowerSeries ℚ) := by
  norm_num [numerator, coeff_cast]
  have h3 : PowerSeries.C (3 : ℚ) = (3 : PowerSeries ℚ) := coeff_cast 3
  have h15 : PowerSeries.C (15 : ℚ) = (15 : PowerSeries ℚ) := coeff_cast 15
  have h90 : PowerSeries.C (90 : ℚ) = (90 : PowerSeries ℚ) := coeff_cast 90
  have h84 : PowerSeries.C (84 : ℚ) = (84 : PowerSeries ℚ) := coeff_cast 84
  have h54 : PowerSeries.C (54 : ℚ) = (54 : PowerSeries ℚ) := coeff_cast 54
  rw [h3, h15, h90, h84, h54]
  ring

private def zDenominator : PowerSeries ℚ :=
  27 * PowerSeries.X ^ 3 + 3 * PowerSeries.X ^ 2 - PowerSeries.X - 1

private def zNumerator : PowerSeries ℚ :=
  18 * PowerSeries.X ^ 5 + 26 * PowerSeries.X ^ 4 -
    24 * PowerSeries.X ^ 3 - 5 * PowerSeries.X ^ 2 + 1

private theorem z_factor_denominator :
    denominator = (3 * PowerSeries.X - 1) * zDenominator := by
  norm_num [denominator, zDenominator, coeff_cast]
  have h2 : PowerSeries.C (2 : ℚ) = (2 : PowerSeries ℚ) := coeff_cast 2
  have h6 : PowerSeries.C (6 : ℚ) = (6 : PowerSeries ℚ) := coeff_cast 6
  have h18 : PowerSeries.C (18 : ℚ) = (18 : PowerSeries ℚ) := coeff_cast 18
  have h81 : PowerSeries.C (81 : ℚ) = (81 : PowerSeries ℚ) := coeff_cast 81
  rw [h2, h6, h18, h81]
  ring

private theorem z_factor_numerator :
    numerator 2 = (3 * PowerSeries.X - 1) * zNumerator := by
  norm_num [numerator, zNumerator, coeff_cast]
  have h20 : (2 : Fin 3) ≠ 0 := by decide
  have h21 : (2 : Fin 3) ≠ 1 := by decide
  simp only [if_neg h20, if_neg h21]
  have h3 : PowerSeries.C (3 : ℚ) = (3 : PowerSeries ℚ) := coeff_cast 3
  have h5 : PowerSeries.C (5 : ℚ) = (5 : PowerSeries ℚ) := coeff_cast 5
  have h9 : PowerSeries.C (9 : ℚ) = (9 : PowerSeries ℚ) := coeff_cast 9
  have h98 : PowerSeries.C (98 : ℚ) = (98 : PowerSeries ℚ) := coeff_cast 98
  have h60 : PowerSeries.C (60 : ℚ) = (60 : PowerSeries ℚ) := coeff_cast 60
  have h54 : PowerSeries.C (54 : ℚ) = (54 : PowerSeries ℚ) := coeff_cast 54
  rw [h3, h5, h9, h98, h60, h54]
  ring

private theorem z_series :
    PowerSeries.mk (fun n => scaled n (2 : Fin 3)) =
      zNumerator * PowerSeries.invOfUnit zDenominator (-1) := by
  have hprod := denominator_mul_series (2 : Fin 3)
  rw [z_factor_denominator, z_factor_numerator, mul_assoc] at hprod
  have hn : (3 * PowerSeries.X - 1 : PowerSeries ℚ) ≠ 0 := by
    intro h
    have hc := congrArg PowerSeries.constantCoeff h
    norm_num at hc
  have hz : zDenominator * PowerSeries.mk (fun n => scaled n (2 : Fin 3)) =
      zNumerator := mul_left_cancel₀ hn hprod
  have hc : PowerSeries.constantCoeff zDenominator = (-1 : ℚ) := by
    simp [zDenominator]
  calc
    PowerSeries.mk (fun n => scaled n (2 : Fin 3)) =
        1 * PowerSeries.mk (fun n => scaled n (2 : Fin 3)) := by rw [one_mul]
    _ = (PowerSeries.invOfUnit zDenominator (-1) * zDenominator) *
        PowerSeries.mk (fun n => scaled n (2 : Fin 3)) := by
          rw [PowerSeries.invOfUnit_mul zDenominator (-1) hc]
    _ = PowerSeries.invOfUnit zDenominator (-1) *
        (zDenominator * PowerSeries.mk (fun n => scaled n (2 : Fin 3))) := by
          rw [mul_assoc]
    _ = PowerSeries.invOfUnit zDenominator (-1) * zNumerator := by rw [hz]
    _ = zNumerator * PowerSeries.invOfUnit zDenominator (-1) := by rw [mul_comm]

/-- The ordered geometric tetrahelix and Kagey's three conjectured coordinate series. -/
theorem result :
    (∀ n,
      regular (vertex n) (vertex (n + 1)) (vertex (n + 2)) (vertex (n + 3)) ∧
      sqDist (vertex n) (vertex (n + 1)) = 8 ∧
      vertex n ≠ faceCenter (vertex (n + 1)) (vertex (n + 2))
        (vertex (n + 3)) ∧
      faceNoncollinear (vertex (n + 1)) (vertex (n + 2))
        (vertex (n + 3)) ∧
      vertex (n + 4) = reflected (vertex n) (vertex (n + 1))
        (vertex (n + 2)) (vertex (n + 3)) ∧
      faceOrthogonal (vertex n) (vertex (n + 1))
        (vertex (n + 2)) (vertex (n + 3)) (vertex (n + 1)) ∧
      faceOrthogonal (vertex n) (vertex (n + 1))
        (vertex (n + 2)) (vertex (n + 3)) (vertex (n + 2)) ∧
      faceOrthogonal (vertex n) (vertex (n + 1))
        (vertex (n + 2)) (vertex (n + 3)) (vertex (n + 3)) ∧
      ∀ i, (vertex n i + vertex (n + 4) i) / 2 =
        faceCenter (vertex (n + 1)) (vertex (n + 2)) (vertex (n + 3)) i) ∧
    PowerSeries.mk (fun n => scaled n (0 : Fin 3)) =
      (54 * PowerSeries.X ^ 6 - 84 * PowerSeries.X ^ 5 -
        66 * PowerSeries.X ^ 4 + 23 * PowerSeries.X ^ 3 +
        9 * PowerSeries.X ^ 2 + PowerSeries.X - 1 : PowerSeries ℚ) *
      PowerSeries.invOfUnit
        ((3 * PowerSeries.X - 1) ^ 2 *
          (9 * PowerSeries.X ^ 2 + 4 * PowerSeries.X + 1)) 1 ∧
    PowerSeries.mk (fun n => scaled n (1 : Fin 3)) =
      (-54 * PowerSeries.X ^ 6 + 84 * PowerSeries.X ^ 5 -
        90 * PowerSeries.X ^ 4 + 15 * PowerSeries.X ^ 3 +
        3 * PowerSeries.X ^ 2 + 3 * PowerSeries.X - 1 : PowerSeries ℚ) *
      PowerSeries.invOfUnit
        ((3 * PowerSeries.X - 1) ^ 2 *
          (9 * PowerSeries.X ^ 2 + 4 * PowerSeries.X + 1)) 1 ∧
    PowerSeries.mk (fun n => scaled n (2 : Fin 3)) =
      (18 * PowerSeries.X ^ 5 + 26 * PowerSeries.X ^ 4 -
        24 * PowerSeries.X ^ 3 - 5 * PowerSeries.X ^ 2 + 1 : PowerSeries ℚ) *
      PowerSeries.invOfUnit
        (27 * PowerSeries.X ^ 3 + 3 * PowerSeries.X ^ 2 -
          PowerSeries.X - 1) (-1) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro n
    have hr := regular_vertices n
    have hb := reflection_bridge _ _ _ _ hr
    rw [← vertex_step_reflected n] at hb
    exact ⟨hr, edge_length n, face_normal_ne_zero n,
      face_noncollinear n,
      vertex_step_reflected n, hb.1, hb.2.1,
      hb.2.2.1, hb.2.2.2.1⟩
  · rw [series_eq_numerator (0 : Fin 3), numerator_x, denominator_factored]
  · rw [series_eq_numerator (1 : Fin 3), numerator_y, denominator_factored]
  · simpa [zNumerator, zDenominator] using z_series

#print axioms result

end D5.S1.Recurrence.BoerdijkCoxeterGeneratingFunctions
