/- GID: D5/S1/Digit/CompositeGasOrder
   generality: I
   mirror-B: none(waiver:formal-unit-only)
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Actual parameterized beta orders and their honest distinguished-root unit criterion. -/

import D5.S1.Digit.CompositeGasPronic
import D5.S1.Digit.CompositeGasUnit
import Mathlib.Algebra.GCDMonoid.IntegrallyClosed
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed

namespace D5.S1.Digit

/-- A parameter is pronic when it is a product of two consecutive naturals. -/
def E6Pronic (c : ℕ) : Prop := ∃ m : ℕ, c = m * (m + 1)

/-- The actual integral order generated by the positive real characteristic root. -/
abbrev E6BetaOrder (c : ℕ) := Algebra.adjoin ℤ ({e6Beta c} : Set ℝ)

/-- The distinguished root as an element of its actual generated order. -/
noncomputable def e6BetaOrderRoot (c : ℕ) : E6BetaOrder c :=
  ⟨e6Beta c, Algebra.subset_adjoin (Set.mem_singleton _)⟩

/-- The quadratic presentation `a + bβ`, with relation `β² = β + c`.

This is a presentation ring, not always the actual order: at pronic parameters
its real evaluation has a kernel. Accordingly, `e6QuadNorm` below is the
quadratic presentation (characteristic) norm. It is not claimed to be the
intrinsic norm of `E6BetaOrder c` in the pronic, degree-one case.

For `c = 1` these coordinates visibly match `GoldenInt`; that equivalence is
deliberately not constructed here because no unit argument below needs it.
-/
@[ext]
structure E6Quad (c : ℕ) where
  a : ℤ
  b : ℤ
  deriving DecidableEq

instance (c : ℕ) : Zero (E6Quad c) := ⟨⟨0, 0⟩⟩
instance (c : ℕ) : One (E6Quad c) := ⟨⟨1, 0⟩⟩
instance (c : ℕ) : Add (E6Quad c) :=
  ⟨fun x y => ⟨x.a + y.a, x.b + y.b⟩⟩
instance (c : ℕ) : Neg (E6Quad c) := ⟨fun x => ⟨-x.a, -x.b⟩⟩
instance (c : ℕ) : Mul (E6Quad c) :=
  ⟨fun x y =>
    ⟨x.a * y.a + (c : ℤ) * x.b * y.b,
      x.a * y.b + x.b * y.a + x.b * y.b⟩⟩

@[simp] private theorem e6_quad_a_zero (c : ℕ) : (0 : E6Quad c).a = 0 := rfl
@[simp] private theorem e6_quad_b_zero (c : ℕ) : (0 : E6Quad c).b = 0 := rfl
@[simp] private theorem e6_quad_a_one (c : ℕ) : (1 : E6Quad c).a = 1 := rfl
@[simp] private theorem e6_quad_b_one (c : ℕ) : (1 : E6Quad c).b = 0 := rfl
@[simp] private theorem e6_quad_a_add {c : ℕ} (x y : E6Quad c) :
    (x + y).a = x.a + y.a := rfl
@[simp] private theorem e6_quad_b_add {c : ℕ} (x y : E6Quad c) :
    (x + y).b = x.b + y.b := rfl
@[simp] private theorem e6_quad_a_neg {c : ℕ} (x : E6Quad c) :
    (-x).a = -x.a := rfl
@[simp] private theorem e6_quad_b_neg {c : ℕ} (x : E6Quad c) :
    (-x).b = -x.b := rfl
@[simp] private theorem e6_quad_a_mul {c : ℕ} (x y : E6Quad c) :
    (x * y).a = x.a * y.a + (c : ℤ) * x.b * y.b := rfl
@[simp] private theorem e6_quad_b_mul {c : ℕ} (x y : E6Quad c) :
    (x * y).b = x.a * y.b + x.b * y.a + x.b * y.b := rfl

instance e6QuadAddCommGroup (c : ℕ) : AddCommGroup (E6Quad c) := by
  refine
    { sub := fun x y => x + -y
      nsmul := @nsmulRec (E6Quad c) ⟨0⟩ ⟨(· + ·)⟩
      zsmul := @zsmulRec (E6Quad c) ⟨0⟩ ⟨(· + ·)⟩ ⟨Neg.neg⟩
        (@nsmulRec (E6Quad c) ⟨0⟩ ⟨(· + ·)⟩)
      add_assoc := ?_
      zero_add := ?_
      add_zero := ?_
      neg_add_cancel := ?_
      add_comm := ?_ } <;>
    intros <;> ext <;> simp [add_comm, add_left_comm]

instance e6QuadAddGroupWithOne (c : ℕ) : AddGroupWithOne (E6Quad c) :=
  { e6QuadAddCommGroup c with
    natCast := fun n => ⟨n, 0⟩
    intCast := fun z => ⟨z, 0⟩ }

@[simp] private theorem e6_quad_a_intCast (c : ℕ) (z : ℤ) :
    (z : E6Quad c).a = z := rfl
@[simp] private theorem e6_quad_b_intCast (c : ℕ) (z : ℤ) :
    (z : E6Quad c).b = 0 := rfl

instance e6QuadCommRing (c : ℕ) : CommRing (E6Quad c) := by
  refine
    { e6QuadAddGroupWithOne c with
      npow := @npowRec (E6Quad c) ⟨1⟩ ⟨(· * ·)⟩
      mul_assoc := ?_
      one_mul := ?_
      mul_one := ?_
      left_distrib := ?_
      right_distrib := ?_
      zero_mul := ?_
      mul_zero := ?_
      add_comm := ?_
      mul_comm := ?_ } <;>
    intros <;> ext <;> simp <;> ring

/-- The distinguished generator of the quadratic presentation. -/
def e6QuadBeta (c : ℕ) : E6Quad c := ⟨0, 1⟩

/-- Characteristic conjugation on the quadratic presentation. -/
def e6QuadConj {c : ℕ} (x : E6Quad c) : E6Quad c := ⟨x.a + x.b, -x.b⟩

/-- The quadratic presentation norm `a² + ab - cb²`.

At pronic parameters this remains the norm of the displayed degree-two
presentation, while the actual real order has degree one. Thus this name does
not assert an intrinsic norm on the actual order in that branch.
-/
def e6QuadNorm {c : ℕ} (x : E6Quad c) : ℤ :=
  x.a ^ 2 + x.a * x.b - (c : ℤ) * x.b ^ 2

theorem e6_quad_norm_mul {c : ℕ} (x y : E6Quad c) :
    e6QuadNorm (x * y) = e6QuadNorm x * e6QuadNorm y := by
  rcases x with ⟨a, b⟩
  rcases y with ⟨d, e⟩
  simp [e6QuadNorm]
  ring

/-- The presentation norm as a monoid homomorphism. -/
def e6QuadNormMonoidHom (c : ℕ) : E6Quad c →* ℤ where
  toFun := e6QuadNorm
  map_one' := rfl
  map_mul' := e6_quad_norm_mul

/-- Evaluation of the quadratic presentation at the positive real root. -/
noncomputable def e6QuadEval (c : ℕ) : E6Quad c →+* ℝ where
  toFun := fun x => x.a + x.b * e6Beta c
  map_zero' := by simp
  map_one' := by simp
  map_add' := by intros; simp; ring
  map_mul' := by
    intro x y
    change
      ((x.a * y.a + (c : ℤ) * x.b * y.b : ℤ) : ℝ) +
          ((x.a * y.b + x.b * y.a + x.b * y.b : ℤ) : ℝ) * e6Beta c = _
    push_cast
    linear_combination -((x.b : ℝ) * (y.b : ℝ)) * (e6_beta_sq c)

/-- Evaluation at the other characteristic root `1 - β`. -/
noncomputable def e6QuadEvalCharConj (c : ℕ) : E6Quad c →+* ℝ where
  toFun := fun x => x.a + x.b * e6BetaConjChar c
  map_zero' := by simp
  map_one' := by simp
  map_add' := by intros; simp; ring
  map_mul' := by
    intro x y
    change
      ((x.a * y.a + (c : ℤ) * x.b * y.b : ℤ) : ℝ) +
          ((x.a * y.b + x.b * y.a + x.b * y.b : ℤ) : ℝ) * e6BetaConjChar c = _
    rw [e6BetaConjChar]
    push_cast
    linear_combination -((x.b : ℝ) * (y.b : ℝ)) * (e6_beta_sq c)

/-- Presentation norm is multiplication by the presentation conjugate. -/
theorem e6_quad_norm_eq_mul_conj {c : ℕ} (x : E6Quad c) :
    (e6QuadNorm x : E6Quad c) = x * e6QuadConj x := by
  apply E6Quad.ext
  · change e6QuadNorm x = x.a * (x.a + x.b) + (c : ℤ) * x.b * -x.b
    simp [e6QuadNorm]
    ring
  · change 0 = x.a * -x.b + x.b * (x.a + x.b) + x.b * -x.b
    ring

/-- An element of the quadratic presentation is a unit exactly when its
presentation norm is an integer unit. -/
theorem e6_quad_isUnit_iff_norm_isUnit {c : ℕ} (x : E6Quad c) :
    IsUnit x ↔ IsUnit (e6QuadNorm x) := by
  constructor
  · intro hx
    exact hx.map (e6QuadNormMonoidHom c)
  · intro hn
    rcases Int.isUnit_iff.mp hn with hnorm | hnorm
    · refine isUnit_iff_exists_inv.mpr ⟨e6QuadConj x, ?_⟩
      rw [← e6_quad_norm_eq_mul_conj, hnorm]
      rfl
    · refine isUnit_iff_exists_inv.mpr ⟨-e6QuadConj x, ?_⟩
      calc
        x * -e6QuadConj x = -(x * e6QuadConj x) := by rw [mul_neg]
        _ = -(e6QuadNorm x : E6Quad c) := by rw [← e6_quad_norm_eq_mul_conj]
        _ = 1 := by rw [hnorm]; norm_num

@[simp] theorem e6_quad_norm_beta (c : ℕ) :
    e6QuadNorm (e6QuadBeta c) = -(c : ℤ) := by
  simp [e6QuadNorm, e6QuadBeta]

/-- On the active domain, the presentation root is a unit only at `c = 1`. -/
theorem e6_quad_beta_isUnit_iff (c : ℕ) (hc : 1 ≤ c) :
    IsUnit (e6QuadBeta c) ↔ c = 1 := by
  rw [e6_quad_isUnit_iff_norm_isUnit, e6_quad_norm_beta, Int.isUnit_iff]
  omega

/-- The cast presentation norm is the product of the two characteristic
evaluations. -/
theorem e6_quad_cast_norm_eq_eval_mul_evalCharConj (c : ℕ) (x : E6Quad c) :
    ((e6QuadNorm x : ℤ) : ℝ) =
      e6QuadEval c x * e6QuadEvalCharConj c x := by
  change
    ((x.a ^ 2 + x.a * x.b - (c : ℤ) * x.b ^ 2 : ℤ) : ℝ) =
      (x.a + x.b * e6Beta c) * (x.a + x.b * e6BetaConjChar c)
  rw [e6BetaConjChar]
  push_cast
  nlinarith [e6_beta_sq c]

/-- The presentation norm of the root agrees with the frozen characteristic
norm identity for the two real evaluations. -/
theorem e6_quad_norm_beta_agrees_e6_beta_char_norm (c : ℕ) :
    ((e6QuadNorm (e6QuadBeta c) : ℤ) : ℝ) =
      e6Beta c * e6BetaConjChar c := by
  rw [e6_quad_norm_beta, e6_beta_char_norm]
  norm_num

private theorem e6_quad_eval_surjective_to_order (c : ℕ) :
    ∀ x : E6BetaOrder c, ∃ y : E6Quad c, e6QuadEval c y = x := by
  rintro ⟨x, hx⟩
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
      rw [Set.mem_singleton_iff] at hx
      subst x
      exact ⟨e6QuadBeta c, by simp [e6QuadEval, e6QuadBeta]⟩
  | algebraMap z =>
      exact ⟨(z : E6Quad c), by simp [e6QuadEval]⟩
  | add x y _ _ hx hy =>
      rcases hx with ⟨u, hu⟩
      rcases hy with ⟨v, hv⟩
      exact ⟨u + v, by simp [hu, hv]⟩
  | mul x y _ _ hx hy =>
      rcases hx with ⟨u, hu⟩
      rcases hy with ⟨v, hv⟩
      exact ⟨u * v, by simp [hu, hv]⟩

private theorem e6_quad_eval_not_injective_of_pronic {c : ℕ} (hc : E6Pronic c) :
    ¬Function.Injective (e6QuadEval c) := by
  rcases hc with ⟨m, rfl⟩
  intro hinj
  have hsame :
      e6QuadEval (m * (m + 1))
          (⟨-((m : ℤ) + 1), 1⟩ : E6Quad (m * (m + 1))) =
        e6QuadEval (m * (m + 1)) 0 := by
    simp [e6QuadEval, e6_beta_pronic]
  have := hinj hsame
  have hb := congr_arg E6Quad.b this
  simp at hb

private theorem e6_quad_eval_injective_of_not_pronic {c : ℕ} (hc : ¬E6Pronic c) :
    Function.Injective (e6QuadEval c) := by
  intro x y hxy
  have hrel :
      ((x.a - y.a : ℤ) : ℝ) + ((x.b - y.b : ℤ) : ℝ) * e6Beta c = 0 := by
    change (x.a : ℝ) + (x.b : ℝ) * e6Beta c =
      (y.a : ℝ) + (y.b : ℝ) * e6Beta c at hxy
    push_cast
    linarith
  by_contra hne
  have hb : x.b - y.b ≠ 0 := by
    intro hb
    have hab_real : ((x.a - y.a : ℤ) : ℝ) = 0 := by simpa [hb] using hrel
    have hab : x.a - y.a = 0 := by exact_mod_cast hab_real
    apply hne
    ext
    · omega
    · omega
  let q : ℚ := -(x.a - y.a : ℚ) / (x.b - y.b : ℚ)
  have hq_real : (q : ℝ) = e6Beta c := by
    push_cast at hrel
    dsimp [q]
    push_cast
    rw [div_eq_iff]
    · linear_combination -hrel
    · exact_mod_cast hb
  have hq_sq : q ^ 2 = q + c := by
    exact_mod_cast (hq_real.symm ▸ e6_beta_sq c)
  have hq_integral : IsIntegral ℤ q := by
    let p : Polynomial ℤ :=
      Polynomial.X ^ 2 - (Polynomial.X + Polynomial.C (c : ℤ))
    refine ⟨p, ?_, ?_⟩
    · apply Polynomial.monic_X_pow_sub
      rw [Polynomial.degree_X_add_C]
      norm_num
    · simp [p]
      linarith
  letI : IsIntegrallyClosed ℤ := GCDMonoid.toIsIntegrallyClosed
  obtain ⟨z, hz⟩ := IsIntegrallyClosed.isIntegral_iff.mp hq_integral
  have hz_real : (z : ℝ) = e6Beta c := by
    have hzq : (z : ℚ) = q := hz
    calc
      (z : ℝ) = ((q : ℚ) : ℝ) := by exact_mod_cast hzq
      _ = e6Beta c := hq_real
  have hz_nonneg : 0 ≤ z := by
    have hz_nonneg_real : (0 : ℝ) ≤ (z : ℝ) := by
      rw [hz_real]
      exact (e6_beta_pos c).le
    exact_mod_cast hz_nonneg_real
  have hnat : e6Beta c = ((z.toNat : ℕ) : ℝ) := by
    rw [← hz_real]
    exact_mod_cast (Int.toNat_of_nonneg hz_nonneg).symm
  apply hc
  exact (e6_beta_eq_nat_iff_pronic c).mp ⟨z.toNat, hnat⟩

/-- Real evaluation is injective exactly away from the pronic degeneration. -/
theorem e6_quad_eval_injective_iff_not_pronic (c : ℕ) :
    Function.Injective (e6QuadEval c) ↔ ¬E6Pronic c := by
  constructor
  · intro hinj hp
    exact e6_quad_eval_not_injective_of_pronic hp hinj
  · exact e6_quad_eval_injective_of_not_pronic

/-- At a pronic parameter the actual positive-root order collapses to the
integer subalgebra. This uses the frozen L3a root evaluation. -/
theorem e6_beta_order_eq_bot_of_pronic {c m : ℕ} (h : c = m * (m + 1)) :
    Algebra.adjoin ℤ ({e6Beta c} : Set ℝ) = ⊥ := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    intro x hx
    rw [Set.mem_singleton_iff] at hx
    subst x
    rw [h, e6_beta_pronic]
    refine ⟨(m + 1 : ℤ), ?_⟩
    norm_num
  · exact bot_le

private noncomputable def e6QuadOrderEquiv (c : ℕ) (hc : ¬E6Pronic c) :
    E6Quad c ≃+* E6BetaOrder c := by
  let f : E6Quad c →+* E6BetaOrder c :=
    { toFun := fun x =>
        ⟨e6QuadEval c x, by
          change (x.a : ℝ) + (x.b : ℝ) * e6Beta c ∈ E6BetaOrder c
          exact (E6BetaOrder c).add_mem
            ((E6BetaOrder c).algebraMap_mem x.a)
            ((E6BetaOrder c).mul_mem ((E6BetaOrder c).algebraMap_mem x.b)
              (Algebra.subset_adjoin (Set.mem_singleton _)))⟩
      map_zero' := Subtype.ext (e6QuadEval c).map_zero
      map_one' := Subtype.ext (e6QuadEval c).map_one
      map_add' := fun x y => Subtype.ext ((e6QuadEval c).map_add x y)
      map_mul' := fun x y => Subtype.ext ((e6QuadEval c).map_mul x y) }
  apply RingEquiv.ofBijective f
  constructor
  · intro x y hxy
    apply (e6_quad_eval_injective_iff_not_pronic c).mpr hc
    exact congr_arg Subtype.val hxy
  · intro x
    rcases e6_quad_eval_surjective_to_order c x with ⟨y, hy⟩
    exact ⟨y, Subtype.ext hy⟩

private theorem e6_quad_order_equiv_beta (c : ℕ) (hc : ¬E6Pronic c) :
    e6QuadOrderEquiv c hc (e6QuadBeta c) = e6BetaOrderRoot c := by
  apply Subtype.ext
  change e6QuadEval c (e6QuadBeta c) = e6Beta c
  simp [e6QuadEval, e6QuadBeta]

private noncomputable def e6PronicOrderEquivInt {c m : ℕ}
    (h : c = m * (m + 1)) : E6BetaOrder c ≃+* ℤ :=
  (Subalgebra.equivOfEq (E6BetaOrder c) ⊥
      (e6_beta_order_eq_bot_of_pronic h)).toRingEquiv.trans
    (Algebra.botEquivOfInjective (R := ℤ) (A := ℝ) Int.cast_injective).toRingEquiv

private theorem e6_pronic_order_equiv_root {c m : ℕ} (h : c = m * (m + 1)) :
    e6PronicOrderEquivInt h (e6BetaOrderRoot c) = (m + 1 : ℤ) := by
  let hcast : Function.Injective (algebraMap ℤ ℝ) := Int.cast_injective
  let e := Algebra.botEquivOfInjective hcast
  change e ((Subalgebra.equivOfEq (E6BetaOrder c) ⊥
    (e6_beta_order_eq_bot_of_pronic h)) (e6BetaOrderRoot c)) = (m + 1 : ℤ)
  apply e.symm.injective
  rw [e.symm_apply_apply]
  apply Subtype.ext
  simp [e, e6BetaOrderRoot, h, e6_beta_pronic]

/-- The honest root-unit criterion in the actual real order.

Away from pronic parameters, evaluation identifies the quadratic presentation
with the actual order and transfers the presentation norm criterion. At a
pronic parameter the actual order is instead `ℤ`; this branch uses the integer
unit criterion and makes no intrinsic-norm-equals-`-c` claim. The lower bound
is essential because `e6Beta 0 = 1` is also a unit.
-/
theorem e6_beta_order_root_isUnit_iff (c : ℕ) (hc : 1 ≤ c) :
    IsUnit (e6BetaOrderRoot c) ↔ c = 1 := by
  constructor
  · intro hu
    by_cases hp : E6Pronic c
    · rcases hp with ⟨m, hm⟩
      have hunit_int : IsUnit (m + 1 : ℤ) := by
        rw [← e6_pronic_order_equiv_root hm]
        exact hu.map (e6PronicOrderEquivInt hm).toMonoidHom
      rcases Int.isUnit_iff.mp hunit_int with hpos | hneg
      · have hm1 : m + 1 = 1 := by exact_mod_cast hpos
        have hm0 : m = 0 := by omega
        subst m
        norm_num at hm
        omega
      · have hmneg : (m + 1 : ℤ) = -1 := hneg
        omega
    · have hunit_pair : IsUnit (e6QuadBeta c) := by
        have hmapped :
            IsUnit (e6QuadOrderEquiv c hp (e6QuadBeta c)) := by
          simpa [e6_quad_order_equiv_beta c hp] using hu
        simpa using hmapped.map (e6QuadOrderEquiv c hp).symm.toMonoidHom
      exact (e6_quad_beta_isUnit_iff c hc).mp hunit_pair
  · rintro rfl
    refine isUnit_iff_exists_inv.mpr ⟨e6BetaOrderRoot 1 - 1, ?_⟩
    apply Subtype.ext
    change e6Beta 1 * (e6Beta 1 - 1) = 1
    rw [mul_sub, mul_one, ← pow_two, e6_beta_sq]
    norm_num

end D5.S1.Digit
