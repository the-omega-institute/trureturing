/- GID: D5/S1/Eigenstructure/EigenframeInvariance
   generality: G
   mirror-B: D5/B/S1/Eigenstructure/EigenframeInvariance
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: A basis of eigenvectors has invariant coordinate lines. -/

import Mathlib.LinearAlgebra.Eigenspace.Basic

namespace D5.S1.Eigenstructure.EigenframeInvariance

/-- If every vector of a basis is an eigenvector of an endomorphism, then the
one-dimensional submodule generated by each basis vector is invariant. -/
theorem eigenframe_coordinate_line_invariant
    {R M ι : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (f : Module.End R M) (b : Module.Basis ι R M) (eigenvalues : ι → R)
    (hEigen : ∀ i, f.HasEigenvector (eigenvalues i) (b i)) :
    ∀ i, Submodule.map f (R ∙ b i) ≤ R ∙ b i := by
  intro i
  rw [Submodule.map_le_iff_le_comap, Submodule.span_singleton_le_iff_mem]
  change f (b i) ∈ R ∙ b i
  rw [(hEigen i).apply_eq_smul]
  exact Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _)

-- The scalar line over the rationals provides an inhabited basis and satisfies
-- the eigenframe premise for the identity endomorphism.
example :
    ∀ i : Unit,
      Module.End.HasEigenvector (1 : Module.End ℚ ℚ)
        1 (Module.Basis.singleton Unit ℚ i) := by
  intro i
  rw [Module.End.hasEigenvector_iff, Module.End.mem_eigenspace_iff]
  simp

end D5.S1.Eigenstructure.EigenframeInvariance
