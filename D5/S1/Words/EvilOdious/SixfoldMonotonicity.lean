private theorem prefix_certificate (n : ℕ) (hl : 2048 ≤ n) (hu : n < 4096) :
    24 * prefixB n < n ^ 4 := by
  let block : Fin 64 := ⟨(n-2048)/32, by omega⟩
  have h := List.all_eq_true.mp (prefixcertificate_checked block) ((n-2048)%32)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have hn : 2048 + 32 * block.val + (n-2048)%32 = n := by dsimp [block]; omega
  simpa only [prefixChunk, hn, decide_eq_true_eq] using h

private theorem initial_r (n : ℕ) (hl : 38 ≤ n) (hu : n < 2048) : r 6 (n-1) < r 6 n := by
  let block : Fin 64 := ⟨n/32, by omega⟩
  have hb := List.all_eq_true.mp (initialr_checked block) (n%32)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have hn : 32 * block.val + n%32 = n := by dsimp [block]; omega
  have hc : 0 < ((n+4).choose 4 : ℤ) + tableError 1 n := by
    rw [Nat.choose_eq_descFactorial_div_factorial, show Nat.factorial 4 = 24 by decide]
    have hs : 38 ≤ n → 0 < ((Nat.descFactorial (n+4) 4 / 24 : ℕ) : ℤ) + tableError 1 n := by
      simpa only [initialChunk, hn, decide_eq_true_eq] using hb
    exact hs hl
  rw [← tableError_sound 1 n (by omega), ← r_difference n (by omega)] at hc
  omega

private theorem initial_s (n : ℕ) (hl : 6 ≤ n) (hu : n < 2048) : s 6 (n-1) < s 6 n := by
  let block : Fin 64 := ⟨n/32, by omega⟩
  have hb := List.all_eq_true.mp (initials_checked block) (n%32)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have hn : 32 * block.val + n%32 = n := by dsimp [block]; omega
  have hc : 0 < ((n+4).choose 4 : ℤ) + tableError (-1) n := by
    rw [Nat.choose_eq_descFactorial_div_factorial, show Nat.factorial 4 = 24 by decide]
    have hs : 6 ≤ n → 0 < ((Nat.descFactorial (n+4) 4 / 24 : ℕ) : ℤ) + tableError (-1) n := by
      simpa only [initialChunk, hn, decide_eq_true_eq] using hb
    exact hs hl
  rw [← tableError_sound (-1) n (by omega), ← s_difference n (by omega)] at hc
  omega




set_option autoImplicit false

private theorem choose_lower (n : ℕ) : n ^ 4 ≤ 24 * (n+4).choose 4 := by
  have hh := Nat.descFactorial_eq_factorial_mul_choose (n+4) 4
  norm_num [Nat.descFactorial, Nat.factorial] at hh
  rw [show n+4-3 = n+1 by omega, show n+4-2 = n+2 by omega] at hh
  calc
    n ^ 4 = n * n * n * n := by ring
    _ ≤ (n+4)*(n+3)*(n+2)*(n+1) := by gcongr <;> omega
    _ = 24 * (n+4).choose 4 := by nlinarith [hh]

private theorem prefix_exists (n : ℕ) (hn : 2048 ≤ n) :
    ∃ p : ℕ, ∃ w : List Bool, 2048 ≤ p ∧ p < 4096 ∧ n = appendValue p w := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    by_cases hs : n < 4096
    · exact ⟨n, [], hn, hs, rfl⟩
    · obtain ⟨p,w,hp,hp',hw⟩ := ih (n/2) (by omega) (by omega)
      rcases Nat.mod_two_eq_zero_or_one n with hb | hb
      · refine ⟨p,false::w,hp,hp',?_⟩
        simp only [appendValue_cons, Bool.false_eq_true, if_false, Nat.add_zero]
        omega
      · refine ⟨p,true::w,hp,hp',?_⟩
        simp only [appendValue_cons, eq_self_iff_true, if_true]
        omega

private theorem prefix_scale_lower (p : ℕ) (w : List Bool) : p * 2 ^ w.length ≤ appendValue p w := by
  induction w with
  | nil => simp [appendValue]
  | cons b w ih =>
    simp only [List.length_cons, Nat.pow_succ, appendValue_cons]
    calc
      p * (2 ^ w.length * 2) = 2 * (p * 2 ^ w.length) := by ring
      _ ≤ 2 * appendValue p w := Nat.mul_le_mul_left 2 ih
      _ ≤ 2 * appendValue p w + (if b then 1 else 0) := Nat.le_add_right _ _

private theorem tail_domination (p B m n : ℕ) (hc : 24 * B < p^4) (hn : p * 2^m ≤ n) :
    16^m * B < (n+4).choose 4 := by
  have hs : 0 < 16^m := pow_pos (by decide) m
  have hp : (p*2^m)^4 = p^4 * 16^m := by
    rw [mul_pow, ← pow_mul, Nat.mul_comm m 4, pow_mul]
    norm_num
  have hpow : (p*2^m)^4 ≤ n^4 := Nat.pow_le_pow_left hn 4
  have hb := Nat.mul_lt_mul_of_pos_right hc hs
  have hchoose := choose_lower n
  nlinarith




