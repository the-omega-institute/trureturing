open Finset

private theorem error_prefix (sigma : ℤ) (hsigma : sigma = 1 ∨ sigma = -1)
    (p0 : ℕ) (hl : 2048 ≤ p0) (hu : p0 < 4096) (w : List Bool) :
    (errorTerm sigma (appendValue p0 w)).natAbs ≤ 16 ^ w.length * prefixB p0 := by
  have hsign (j : ℕ) : (sigma ^ j).natAbs = 1 := by
    rcases hsigma with rfl | rfl <;> simp [Int.natAbs_pow]
  have hh (j : ℕ) (hj : j ∈ Finset.Icc 1 5) :
      ((recur (p j) (appendValue p0 w))).natAbs ≤ 16 ^ w.length * seedH j p0 := by
    have hb := h_dyadic j p0 w.length (appendValue 0 w) hj hl hu (lowWord_bound w)
    rw [← appendValue_decompose, ← seedH_exact j p0 hj hu] at hb
    exact hb
  have hc :
      ((recur (p 6) (appendValue p0 w))).natAbs ≤ 2 * 16 ^ w.length * seedC p0 ∧
      ((recur (p 6) (appendValue p0 w - 1))).natAbs ≤ 2 * 16 ^ w.length * seedC p0 := by
    have hb := c_dyadic p0 w.length (appendValue 0 w) hl hu (lowWord_bound w)
    rw [← appendValue_decompose, ← seedC_exact p0 hu] at hb
    exact hb
  have hs : (∑ j ∈ Finset.Icc 1 5,
      sigma ^ j * (Nat.choose 6 j : ℤ) * (recur (p j) (appendValue p0 w))).natAbs ≤
      16 ^ w.length * ∑ j ∈ Finset.Icc 1 5, Nat.choose 6 j * seedH j p0 := by
    calc
      _ ≤ ∑ j ∈ Finset.Icc 1 5,
          (sigma ^ j * (Nat.choose 6 j : ℤ) * (recur (p j) (appendValue p0 w))).natAbs :=
        Int.natAbs_sum_le _ _
      _ ≤ ∑ j ∈ Finset.Icc 1 5, Nat.choose 6 j * (16 ^ w.length * seedH j p0) := by
        apply Finset.sum_le_sum
        intro j hj
        simp only [Int.natAbs_mul, hsign, Int.natAbs_natCast, one_mul]
        exact Nat.mul_le_mul_left _ (hh j hj)
      _ = _ := by rw [Finset.mul_sum]; apply Finset.sum_congr rfl; intros; ring
  calc
    _ ≤ ((∑ j ∈ Finset.Icc 1 5,
        sigma ^ j * (Nat.choose 6 j : ℤ) * (recur (p j) (appendValue p0 w))) +
        (recur (p 6) (appendValue p0 w))).natAbs + ((recur (p 6) (appendValue p0 w - 1))).natAbs :=
      Int.natAbs_sub_le _ _
    _ ≤ (∑ j ∈ Finset.Icc 1 5,
        sigma ^ j * (Nat.choose 6 j : ℤ) * (recur (p j) (appendValue p0 w))).natAbs +
        ((recur (p 6) (appendValue p0 w))).natAbs + ((recur (p 6) (appendValue p0 w - 1))).natAbs :=
      Nat.add_le_add_right (Int.natAbs_add_le _ _) _
    _ ≤ 16 ^ w.length * (∑ j ∈ Finset.Icc 1 5, Nat.choose 6 j * seedH j p0) +
        2 * 16 ^ w.length * seedC p0 + 2 * 16 ^ w.length * seedC p0 := by
      exact Nat.add_le_add (Nat.add_le_add hs hc.1) hc.2
    _ = _ := by unfold prefixB; ring





set_option autoImplicit false

theorem tail_positive (sigma : ℤ) (hsigma : sigma = 1 ∨ sigma = -1)
    (n : ℕ) (hn : 2048 ≤ n) :
    0 < ((n+4).choose 4 : ℤ) + errorTerm sigma n := by
  obtain ⟨p0,w,hl,hu,hw⟩ := prefix_exists n hn
  have hc := prefix_certificate p0 hl hu
  have hs := prefix_scale_lower p0 w
  rw [← hw] at hs
  have hd := tail_domination p0 (prefixB p0) w.length n hc hs
  have he := error_prefix sigma hsigma p0 hl hu w
  rw [← hw] at he
  have hh := he.trans_lt hd
  have ha : -(errorTerm sigma n) ≤ ((errorTerm sigma n).natAbs : ℤ) := by
    simpa using Int.le_natAbs (a := -(errorTerm sigma n))
  omega

private theorem r_strict (n : ℕ) (hn : 37 ≤ n) : r 6 n < r 6 (n+1) := by
  by_cases hs : n+1 < 2048
  · simpa using initial_r (n+1) (by omega) hs
  · have hh := tail_positive 1 (Or.inl rfl) (n+1) (by omega)
    rw [← r_difference (n+1) (by omega)] at hh
    simp only [Nat.add_sub_cancel] at hh
    omega

private theorem s_strict (n : ℕ) (hn : 5 ≤ n) : s 6 n < s 6 (n+1) := by
  by_cases hs : n+1 < 2048
  · simpa using initial_s (n+1) (by omega) hs
  · have hh := tail_positive (-1) (Or.inr rfl) (n+1) (by omega)
    rw [← s_difference (n+1) (by omega)] at hh
    simp only [Nat.add_sub_cancel] at hh
    omega

