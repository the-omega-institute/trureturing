open Finset

def tableValue (table : BinaryTree (ℕ × ℤ)) (index : ℕ) : ℤ :=
  match table with
  | .nil => 0
  | .node (key, value) left right =>
      if index = key then value else if index < key then tableValue left index else tableValue right index

def tableStep (q : List ℤ) (v : ℕ → ℤ) (n : ℕ) : ℤ :=
  if n = 0 then 1 else ∑ k ∈ Finset.range q.length,
    if k ≤ n ∧ 2 ∣ n - k then (List.getD q k 0) * v ((n - k) / 2) else 0

def tableCheck (q : List ℤ) (table : BinaryTree (ℕ × ℤ)) (bound : ℕ) : Bool :=
  (List.range bound).all (fun n => tableValue table n == tableStep q (tableValue table) n)

theorem tableCheck_sound (q : List ℤ) (table : BinaryTree (ℕ × ℤ)) (bound : ℕ)
    (hc : tableCheck q table bound = true) :
    ∀ n, n < bound → recur q n = tableValue table n := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro hn
    have hh := List.all_eq_true.mp hc n (List.mem_range.mpr hn)
    have hv : tableValue table n = tableStep q (tableValue table) n := by simpa using hh
    cases n with
    | zero => simpa [tableStep, recur] using hv.symm
    | succ n =>
      rw [hv, recur]
      simp only [tableStep, Nat.succ_ne_zero, if_false]
      apply Finset.sum_congr rfl
      intro k hk
      split_ifs with h
      · rw [ih _ (by omega) (by omega)]
      · rfl

private def tableChunk (q : List ℤ) (table : BinaryTree (ℕ × ℤ)) (base : ℕ) : Bool :=
  (List.range 32).all (fun k =>
    tableValue table (base + k) == tableStep q (tableValue table) (base + k))

private theorem tableCheck_of_chunks (q : List ℤ) (table : BinaryTree (ℕ × ℤ))
    (hc : ∀ block : Fin 128, tableChunk q table (32 * block.val) = true) :
    tableCheck q table 4096 = true := by
  apply List.all_eq_true.mpr
  intro n hn
  have hnlt : n < 4096 := List.mem_range.mp hn
  let block : Fin 128 := ⟨n / 32, by omega⟩
  have hh := List.all_eq_true.mp (hc block) (n % 32)
    (List.mem_range.mpr (Nat.mod_lt _ (by decide)))
  have heq : 32 * block.val + n % 32 = n := by dsimp [block]; omega
  simpa only [tableChunk, heq] using hh




