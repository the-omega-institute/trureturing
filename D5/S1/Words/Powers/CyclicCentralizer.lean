/- GID: D5/S1/Words/Powers/CyclicCentralizer
   generality: G
   mirror-B: D5/B/S1/Words/Powers/CyclicCentralizer
   mirror-E: none(waiver:abstract-word-classification-without-separate-evidence-artifact)
   anchors: []
   utility: none
   digest: The centralizer of a nonempty finite word has a unique nonempty word generator. -/


import D5.S1.Words.Powers.CommutingWords
import D5.S1.Words.Powers.CommonPositivePowers

set_option Elab.async false

/-!
A shortest nonempty positive-power root of a nonempty word generates all its
positive-power roots. The separate CommonPositivePowers dependency supplies
the common-positive-power commutation theorem, with four private period and
reassembly helpers and one public theorem transplanted from IETFree.
Applying the pairwise common-power theorem then gives the whole centralizer.
Mutual power representations and positive lengths give uniqueness. The
alphabet is an arbitrary type in an arbitrary universe. The port's copyright,
author notice, immutable source locator, license and retirement condition
accompany CommonPositivePowers.
-/


namespace D5.S1.Words.Powers.CyclicCentralizer

universe u

variable {α : Type u}

/-- Composition of literal powers, directly from nested list replication. -/
private theorem wordPower_mul (m n : Nat) (r : List α) :
    wordPower m (wordPower n r) = wordPower (m * n) r := by
  unfold wordPower
  calc
    (List.replicate m ((List.replicate n r).flatten)).flatten =
        ((List.replicate m (List.replicate n r)).map List.flatten).flatten := by
          rw [List.map_replicate]
    _ = ((List.replicate m (List.replicate n r)).flatten).flatten :=
      List.flatten_flatten.symm
    _ = (List.replicate (m * n) r).flatten := by
      rw [List.flatten_replicate_replicate]

private theorem shortest_positive_root (w : List α) (hw : w ≠ []) :
    ∃ r : List α, r ≠ [] ∧ (∃ k : Nat, k ≠ 0 ∧ w = wordPower k r) ∧
      ∀ s : List α, s ≠ [] → (∃ k : Nat, k ≠ 0 ∧ w = wordPower k s) →
        r.length ≤ s.length := by
  classical
  have hex : ∃ d : Nat, ∃ r : List α, r.length = d ∧ r ≠ [] ∧
      ∃ k : Nat, k ≠ 0 ∧ w = wordPower k r :=
    ⟨w.length, w, rfl, hw, 1, Nat.one_ne_zero, by exact (wordPower_one _).symm⟩
  obtain ⟨r, hlen, hr, hrw⟩ := Nat.find_spec hex
  refine ⟨r, hr, hrw, ?_⟩
  intro s hs hsw
  have hmin := Nat.find_min' hex ⟨s, rfl, hs, hsw⟩
  omega

/-- All positive-power roots of the same nonempty word are powers of a shortest one. -/
private theorem root_is_power_of_shortest {w r : List α} (hr : r ≠ [])
    (hrw : ∃ k : Nat, k ≠ 0 ∧ w = wordPower k r)
    (hmin : ∀ s : List α, s ≠ [] →
      (∃ k : Nat, k ≠ 0 ∧ w = wordPower k s) → r.length ≤ s.length)
    {s : List α} (hsw : ∃ k : Nat, k ≠ 0 ∧ w = wordPower k s) :
    ∃ n : Nat, s = wordPower n r := by
  obtain ⟨k, hk, hwk⟩ := hrw
  obtain ⟨l, hl, hwl⟩ := hsw
  have hrs : r ++ s = s ++ r :=
    CommonPositivePowers.append_comm_of_flatten_replicate_eq hk hl (hwk.symm.trans hwl)
  obtain ⟨t, a, b, hrt, hst⟩ :=
    (CommutingWords.commute_iff_common_power r s).mp hrs
  have ht : t ≠ [] := by
    intro h
    exact hr (by simpa only [h, wordPower, List.flatten_replicate_nil] using hrt)
  have ha : a ≠ 0 := by
    intro h
    exact hr (by simpa only [h, wordPower_zero] using hrt)
  have htw : ∃ j : Nat, j ≠ 0 ∧ w = wordPower j t := by
    refine ⟨k * a, Nat.mul_ne_zero hk ha, ?_⟩
    rw [hwk, hrt, wordPower_mul]
  have hle := hmin t ht htw
  have htpos : 0 < t.length := List.length_pos_of_ne_nil ht
  have ha_le : a ≤ 1 := Nat.le_of_mul_le_mul_right
    (by simpa only [hrt, length_wordPower, Nat.one_mul] using hle) htpos
  have ha_one : a = 1 := by omega
  have hrt' : r = t := by simpa only [ha_one, wordPower_one] using hrt
  exact ⟨b, by simpa only [hrt'] using hst⟩

/-- The centralizer of a nonempty word over any alphabet is generated by exactly
one nonempty word. Zero powers include the empty commuting word. -/
theorem exists_unique_centralizer_root (w : List α) (hw : w ≠ []) :
    ∃! r : List α, r ≠ [] ∧
      ∀ v : List α, w ++ v = v ++ w ↔ ∃ n : Nat, v = wordPower n r := by
  classical
  obtain ⟨r, hr, hrw, hmin⟩ := shortest_positive_root w hw
  have classification : ∀ v : List α,
      w ++ v = v ++ w ↔ ∃ n : Nat, v = wordPower n r := by
    intro v
    constructor
    · intro hwv
      obtain ⟨s, m, n, hwm, hvn⟩ :=
        (CommutingWords.commute_iff_common_power w v).mp hwv
      have hm : m ≠ 0 := by
        intro h
        exact hw (by simpa only [h, wordPower_zero] using hwm)
      obtain ⟨j, hsj⟩ := root_is_power_of_shortest hr hrw hmin ⟨m, hm, hwm⟩
      exact ⟨n * j, by rw [hvn, hsj, wordPower_mul]⟩
    · rintro ⟨n, hvn⟩
      obtain ⟨k, _, hwk⟩ := hrw
      exact (CommutingWords.commute_iff_common_power w v).mpr ⟨r, k, n, hwk, hvn⟩
  refine ⟨r, ⟨hr, classification⟩, ?_⟩
  intro s hs
  have hws : w ++ s = s ++ w := (hs.2 s).mpr ⟨1, by exact (wordPower_one _).symm⟩
  have hwr : w ++ r = r ++ w := (classification r).mpr ⟨1, by exact (wordPower_one _).symm⟩
  obtain ⟨n, hsn⟩ := (classification s).mp hws
  obtain ⟨m, hrm⟩ := (hs.2 r).mp hwr
  have hn : n ≠ 0 := by
    intro h
    exact hs.1 (by simpa only [h, wordPower_zero] using hsn)
  have hm : m ≠ 0 := by
    intro h
    exact hr (by simpa only [h, wordPower_zero] using hrm)
  have hlenS : s.length = n * r.length := by rw [hsn, length_wordPower]
  have hlenR : r.length = m * s.length := by rw [hrm, length_wordPower]
  have hle : s.length ≤ r.length := by
    have h := Nat.mul_le_mul_right s.length (Nat.one_le_iff_ne_zero.mpr hm)
    simpa only [Nat.one_mul, ← hlenR] using h
  have hn_le : n ≤ 1 := Nat.le_of_mul_le_mul_right
    (by simpa only [Nat.one_mul, ← hlenS] using hle)
    (List.length_pos_of_ne_nil hr)
  have hn_one : n = 1 := by omega
  simpa only [hn_one, wordPower_one] using hsn

end D5.S1.Words.Powers.CyclicCentralizer
