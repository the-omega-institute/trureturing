import D5.S1.Words.GoldenFactorComplexity
import D5.S1.Words.Powers.GoldenDesubstitution
import D5.S1.Words.Powers.WordPower

namespace D5.S1.Words.Powers

open D5.S1.Words
open D5.S0.Tower.GoldenGapWord

/-! ### Windows with a period

`GoldenPeriodic a p L` says the golden word repeats with period `p` throughout the window
`[a, a + L)`.  A fourth power of period `p` is exactly `GoldenPeriodic a p (4 * p)`.

The proof of fourth power freeness is a desubstitution descent.  A period-`p` window whose
length is at least `4 * p - 1` pushes back through the Fibonacci substitution to a period-`c`
window of length at least `4 * c - 1` with `c < p`, and the period-one case is impossible
because the golden word has neither `false false` nor `true true true`.  The threshold
`4 * p - 1` rather than `4 * p` is what makes the descent close: the last two blocks of the
window cover at least three letters, which is exactly the slack the step consumes.

Provenance.  Fourth power freeness of the Fibonacci word is not new: it is due to Karhumäki,
*On cube-free omega-words generated by binary morphisms*, Discrete Applied Mathematics 5
(1983) 279-297, and the sharp form -- the index of the Fibonacci word is exactly `2 + phi` --
is due to Mignosi and Pirillo, *Repetitions in the Fibonacci infinite word*, RAIRO
Informatique Theorique et Applications 26 (1992) 199-204.  This module is an independent
formalization of the statement, not a new theorem.  The literature reference is prose only:
this unit carries `mirror-B: none(waiver:formal-unit-only)`, so there is no machine-checked
Library attestation behind it.

Deliberately deferred, and not claimed anywhere in this module:
* the sharp critical exponent `2 + phi`.  `golden_no_periodic` gives the weaker bound
  `4 - 1/p` on the exponent of a period-`p` repetition, which is what the descent yields and
  is strictly coarser than the Mignosi-Pirillo constant;
* the classification of the squares and cubes that do occur, and of the periods that realize
  the maximal exponent.  `golden_cube_witness` only exhibits one cube; it classifies nothing.
  In particular the golden word is *not* cube free, so fourth power freeness is the first
  integer exponent that fails. -/

/-- The golden word repeats with period `p` throughout the window `[a, a + L)`. -/
def GoldenPeriodic (a p L : Nat) : Prop :=
  ∀ q, a ≤ q → q + p < a + L → goldenWord q = goldenWord (q + p)

/-- A periodic window that starts on `false` extends one letter to the left. -/
theorem goldenPeriodic_shift_left {b p L : Nat} (hpL : p + 1 ≤ L)
    (hper : GoldenPeriodic (b + 1) p L) (hb : goldenWord (b + 1) = false) :
    GoldenPeriodic b p (L + 1) := by
  intro q hq hq2
  rcases Nat.eq_or_lt_of_le hq with heq | hlt
  · subst heq
    have hb1 : goldenWord b = true := by
      by_contra hbb
      have hbb' : goldenWord b = false := by simpa using hbb
      rw [golden_no_two_false hbb'] at hb
      exact Bool.noConfusion hb
    have hmid : goldenWord (b + 1 + p) = false := by
      have h := hper (b + 1) le_rfl (by omega)
      rw [← h]; exact hb
    have hb2 : goldenWord (b + p) = true := by
      by_contra hbb
      have hbb' : goldenWord (b + p) = false := by simpa using hbb
      have hnext := golden_no_two_false hbb'
      have he : b + p + 1 = b + 1 + p := by omega
      rw [he, hmid] at hnext
      exact Bool.noConfusion hnext
    rw [hb1, hb2]
  · exact hper q hlt (by omega)

/-! ### The descent step -/

/-- Matching blocks force matching preimage letters, and the block offset carries over. -/
private theorem block_step {a p L k c : Nat} (hper : GoldenPeriodic a p L)
    (hk : goldenSubstStart k = a) (m : Nat)
    (hphi : goldenSubstStart (k + m + c) = goldenSubstStart (k + m) + p)
    (hrange : goldenSubstStart (k + m) + 1 + p < a + L) :
    goldenWord (k + m) = goldenWord (k + m + c) ∧
      goldenSubstStart (k + m + 1 + c) = goldenSubstStart (k + m + 1) + p := by
  have hge : a ≤ goldenSubstStart (k + m) := by
    rw [← hk]; exact goldenSubstStart_mono (by omega)
  have hq := hper (goldenSubstStart (k + m) + 1) (by omega) (by omega)
  have hletter : goldenWord (k + m) = goldenWord (k + m + c) := by
    have h1 := goldenWord_goldenSubstStart_succ (k + m)
    have h2 := goldenWord_goldenSubstStart_succ (k + m + c)
    rw [hphi] at h2
    have he : goldenSubstStart (k + m) + 1 + p = goldenSubstStart (k + m) + p + 1 := by omega
    rw [he, h1, h2] at hq
    simpa using hq
  refine ⟨hletter, ?_⟩
  have e1 : goldenSubstStart (k + m + 1 + c) = goldenSubstStart (k + m + c)
      + (subst (goldenWord (k + m + c))).length := by
    have he : k + m + 1 + c = (k + m + c) + 1 := by omega
    rw [he]
    exact goldenSubstStart_succ (k + m + c)
  rw [e1, goldenSubstStart_succ (k + m), ← hletter]
  omega

/-- The block offset `p` survives every step whose block stays inside the window. -/
private theorem phi_iter {a p L k c : Nat} (hper : GoldenPeriodic a p L)
    (hk : goldenSubstStart k = a)
    (hphi0 : goldenSubstStart (k + c) = goldenSubstStart k + p) :
    ∀ m : Nat, (∀ j, j < m → goldenSubstStart (k + j) + 1 + p < a + L) →
      goldenSubstStart (k + m + c) = goldenSubstStart (k + m) + p := by
  intro m
  induction m with
  | zero => intro _; simpa using hphi0
  | succ m ih =>
      intro hall
      have hprev := ih fun j hj => hall j (by omega)
      exact (block_step hper hk m hprev (hall m (by omega))).2

/-- Preimage letters at distance `c` agree whenever their blocks stay inside the window. -/
private theorem letter_eq {a p L k c : Nat} (hper : GoldenPeriodic a p L)
    (hk : goldenSubstStart k = a)
    (hphi0 : goldenSubstStart (k + c) = goldenSubstStart k + p) (m : Nat)
    (hall : ∀ j, j ≤ m → goldenSubstStart (k + j) + 1 + p < a + L) :
    goldenWord (k + m) = goldenWord (k + m + c) := by
  have hprev := phi_iter hper hk hphi0 m fun j hj => hall j (by omega)
  exact (block_step hper hk m hprev (hall m le_rfl)).1

/-- Desubstitution descent: a long period-`p` window yields a long period-`c` window,
with `c` strictly smaller. -/
theorem golden_descent {p a L : Nat} (hp : 2 ≤ p) (hL : 4 * p ≤ L + 1)
    (ha : goldenWord a = true) (hper : GoldenPeriodic a p L) :
    ∃ c k, 1 ≤ c ∧ c < p ∧ GoldenPeriodic k c (4 * c - 1) := by
  obtain ⟨k, hk⟩ := exists_goldenSubstStart_of_true ha
  have hap : goldenWord (a + p) = true := by
    have h := hper a le_rfl (by omega)
    rw [← h]; exact ha
  obtain ⟨k1, hk1⟩ := exists_goldenSubstStart_of_true hap
  have hklt : k < k1 := by
    have hlt : goldenSubstStart k < goldenSubstStart k1 := by rw [hk, hk1]; omega
    exact goldenSubstStart_strictMono.lt_iff_lt.mp hlt
  obtain ⟨c, hc1, hck⟩ : ∃ c, 1 ≤ c ∧ k + c = k1 := ⟨k1 - k, by omega, by omega⟩
  have hphi0 : goldenSubstStart (k + c) = goldenSubstStart k + p := by
    rw [hck, hk1, hk]
  -- second period
  have hrange1 : ∀ j, j < c → goldenSubstStart (k + j) + 1 + p < a + L := by
    intro j hj
    have hlt : goldenSubstStart (k + j) < goldenSubstStart (k + c) :=
      goldenSubstStart_strictMono (by omega)
    rw [hphi0, hk] at hlt
    omega
  have hphi_c := phi_iter hper hk hphi0 c hrange1
  have hs2 : goldenSubstStart (k + 2 * c) = a + 2 * p := by
    have he : k + 2 * c = k + c + c := by omega
    rw [he, hphi_c, hphi0, hk]
    omega
  -- third period
  have hrange2 : ∀ j, j < 2 * c → goldenSubstStart (k + j) + 1 + p < a + L := by
    intro j hj
    have hlt : goldenSubstStart (k + j) < goldenSubstStart (k + 2 * c) :=
      goldenSubstStart_strictMono (by omega)
    rw [hs2] at hlt
    omega
  have hphi_2c := phi_iter hper hk hphi0 (2 * c) hrange2
  have hs3 : goldenSubstStart (k + 3 * c) = a + 3 * p := by
    have he : k + 3 * c = k + 2 * c + c := by omega
    rw [he, hphi_2c, hs2]
    omega
  -- the last two blocks of the window span at least three letters
  have hsum : ∀ j : Nat,
      3 ≤ (subst (goldenWord j)).length + (subst (goldenWord (j + 1))).length := by
    intro j
    by_cases hb : goldenWord j = true
    · have h2 : (subst (goldenWord j)).length = 2 := by rw [hb]; rfl
      have h3 := substLength_pos (goldenWord (j + 1))
      omega
    · have hb' : goldenWord j = false := by simpa using hb
      have h1 : (subst (goldenWord j)).length = 1 := by rw [hb']; rfl
      have h2 : (subst (goldenWord (j + 1))).length = 2 := by
        rw [golden_no_two_false hb']; rfl
      omega
  have hstep2 : ∀ j : Nat, goldenSubstStart (j + 2) =
      goldenSubstStart j + (subst (goldenWord j)).length
        + (subst (goldenWord (j + 1))).length := by
    intro j
    have e1 : goldenSubstStart (j + 2) = goldenSubstStart (j + 1)
        + (subst (goldenWord (j + 1))).length := goldenSubstStart_succ (j + 1)
    rw [e1, goldenSubstStart_succ j]
  have hbound : goldenSubstStart (k + (3 * c - 2)) + 3 ≤ a + 3 * p := by
    have he : k + 3 * c = (k + (3 * c - 2)) + 2 := by omega
    have h := hstep2 (k + (3 * c - 2))
    rw [← he] at h
    have hs := hsum (k + (3 * c - 2))
    omega
  have hrange3 : ∀ j, j ≤ 3 * c - 2 → goldenSubstStart (k + j) + 1 + p < a + L := by
    intro j hj
    have hmono : goldenSubstStart (k + j) ≤ goldenSubstStart (k + (3 * c - 2)) :=
      goldenSubstStart_mono (by omega)
    omega
  -- the descended period is strictly smaller
  have hcp : c < p := by
    by_contra hcon
    have hge := goldenSubstStart_add_le k c
    have hceq : c = p := by omega
    have hf0 : goldenWord k = false := by
      by_contra hb
      have hb' : goldenWord k = true := by simpa using hb
      have h1 := goldenSubstStart_step_true hb'
      have h2 := goldenSubstStart_add_le (k + 1) (c - 1)
      have he : (k + 1) + (c - 1) = k + c := by omega
      rw [he] at h2
      omega
    have hf1 : goldenWord (k + 1) = true := golden_no_two_false hf0
    have h1 := goldenSubstStart_step_false hf0
    have h2 : goldenSubstStart (k + 2) = goldenSubstStart (k + 1) + 2 :=
      goldenSubstStart_step_true hf1
    have h3 := goldenSubstStart_add_le (k + 2) (c - 2)
    have he : (k + 2) + (c - 2) = k + c := by omega
    rw [he] at h3
    omega
  refine ⟨c, k, hc1, hcp, ?_⟩
  intro q hq hq2
  obtain ⟨m, rfl⟩ : ∃ m, q = k + m := ⟨q - k, by omega⟩
  have hmle : m ≤ 3 * c - 2 := by omega
  exact letter_eq hper hk hphi0 m fun j hj => hrange3 j (by omega)

/-- No window of the golden word has period `p` and length `4 * p - 1` or more. -/
theorem golden_no_periodic : ∀ p, 1 ≤ p → ∀ a L, 4 * p ≤ L + 1 → ¬ GoldenPeriodic a p L := by
  have key : ∀ n p, p ≤ n → 1 ≤ p → ∀ a L, 4 * p ≤ L + 1 → ¬ GoldenPeriodic a p L := by
    intro n
    induction n with
    | zero => intro p hpn hp; omega
    | succ n ihn =>
        intro p hpn hp a L hL hper
        rcases Nat.lt_or_ge p 2 with hp1 | hp2
        · have hpe : p = 1 := by omega
          subst hpe
          have e1 : goldenWord a = goldenWord (a + 1) := hper a le_rfl (by omega)
          have e2 : goldenWord (a + 1) = goldenWord (a + 2) :=
            hper (a + 1) (by omega) (by omega)
          by_cases hb : goldenWord a = true
          · have h1 : goldenWord (a + 1) = true := by rw [← e1]; exact hb
            have h2 : goldenWord (a + 2) = true := by rw [← e2]; exact h1
            rw [golden_no_three_true hb h1] at h2
            exact Bool.noConfusion h2
          · have hb' : goldenWord a = false := by simpa using hb
            have h1 : goldenWord (a + 1) = true := golden_no_two_false hb'
            rw [← e1, hb'] at h1
            exact Bool.noConfusion h1
        · have hdesc : ∃ c k, 1 ≤ c ∧ c < p ∧ GoldenPeriodic k c (4 * c - 1) := by
            by_cases hb : goldenWord a = true
            · exact golden_descent hp2 hL hb hper
            · have hb' : goldenWord a = false := by simpa using hb
              have hane : a ≠ 0 := by
                intro h0
                rw [h0, goldenWord_zero] at hb'
                exact Bool.noConfusion hb'
              obtain ⟨b, rfl⟩ : ∃ b, a = b + 1 := ⟨a - 1, by omega⟩
              have hshift : GoldenPeriodic b p (L + 1) :=
                goldenPeriodic_shift_left (by omega) hper hb'
              have hbtrue : goldenWord b = true := by
                by_contra hbb
                have hbb' : goldenWord b = false := by simpa using hbb
                rw [golden_no_two_false hbb'] at hb'
                exact Bool.noConfusion hb'
              exact golden_descent hp2 (by omega) hbtrue hshift
          obtain ⟨c, k, hc1, hcp, hcper⟩ := hdesc
          exact ihn c (by omega) hc1 k (4 * c - 1) (by omega) hcper
  intro p hp a L hL
  exact key p p le_rfl hp a L hL

/-! ### Fourth powers -/

/-- The word `u` occurs `k` times in a row starting at position `i` of the golden word. -/
def IsGoldenPowerFactor (k : Nat) (u : List Bool) (i : Nat) : Prop :=
  goldenFactor (k * u.length) i = wordPower k u

theorem isGoldenPowerFactor_iff (k : Nat) (u : List Bool) (i : Nat) :
    IsGoldenPowerFactor k u i ↔
      goldenFactor (k * u.length) i = (List.replicate k u).flatten :=
  Iff.rfl

private theorem goldenFactor_getElem? {n i j : Nat} (hj : j < n) :
    (goldenFactor n i)[j]? = some (goldenWord (i + j)) := by
  rw [goldenFactor, List.getElem?_eq_getElem (by simpa using hj)]
  simp

/-- A power factor makes its window periodic. -/
theorem goldenPeriodic_of_isGoldenPowerFactor {k : Nat} {u : List Bool} {i : Nat}
    (h : IsGoldenPowerFactor k u i) : GoldenPeriodic i u.length (k * u.length) := by
  intro q hq hq2
  obtain ⟨m, rfl⟩ : ∃ m, q = i + m := ⟨q - i, by omega⟩
  have hm : m + u.length < k * u.length := by omega
  have e1 : (goldenFactor (k * u.length) i)[m]? = some (goldenWord (i + m)) :=
    goldenFactor_getElem? (by omega)
  have e2 : (goldenFactor (k * u.length) i)[m + u.length]? =
      some (goldenWord (i + (m + u.length))) := goldenFactor_getElem? (by omega)
  rw [h] at e1 e2
  have e3 : (wordPower k u)[m]? = (wordPower k u)[m + u.length]? :=
    wordPower_period_getElem? k u m hm
  rw [e1, e2] at e3
  have he : i + (m + u.length) = i + m + u.length := by omega
  rw [he] at e3
  exact Option.some.inj e3

/-- **The golden word is fourth power free.** No nonempty word occurs four times in a row. -/
theorem golden_word_fourth_power_free (i : Nat) (u : List Bool) (hu : u ≠ []) :
    ¬ IsGoldenPowerFactor 4 u i := by
  intro h
  have hp1 : 1 ≤ u.length := by
    rcases u with _ | ⟨x, xs⟩
    · exact absurd rfl hu
    · simp
  exact golden_no_periodic u.length hp1 i (4 * u.length) (by omega)
    (goldenPeriodic_of_isGoldenPowerFactor h)

/-! ### Regression anchors

These are kernel-checked finite facts.  The cube witness shows the exponent bound is not
vacuous: cubes do occur, so fourth power freeness is the first exponent that fails. -/

/-- The golden word is not cube free: `true false true` occurs three times at index `5`. -/
theorem golden_cube_witness :
    goldenFactor 9 5 = wordPower 3 [true, false, true] := by
  decide

theorem golden_no_fourth_power_small :
    ∀ i < 6, ∀ p < 4, 0 < p →
      goldenFactor (4 * p) i ≠ wordPower 4 (goldenFactor p i) := by
  decide

#print axioms golden_word_fourth_power_free
#print axioms golden_no_periodic
#print axioms golden_cube_witness

end D5.S1.Words.Powers
