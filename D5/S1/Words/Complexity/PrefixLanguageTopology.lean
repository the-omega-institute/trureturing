/- GID: D5/S1/Words/Complexity/PrefixLanguageTopology
   generality: G
   mirror-B: D5/B/S1/Words/Complexity/PrefixLanguageTopology
   mirror-E: none(waiver:generic-topology)
   anchors: []
   utility: none
   digest: Finite prefix cylinders reconstruct closed word sets and descend under forward shift. -/

import Mathlib.Topology.MetricSpace.PiNat
import Mathlib.Topology.Instances.Discrete

open Set Function

namespace D5.S1.Words.Complexity.PrefixLanguageTopology

universe u

variable {A : Type u}

/-- The length-`n` cylinder approximation generated by the finite prefixes
of a set of one-sided words.  It is intentionally defined with `PiNat`
cylinders so no choice of a finite coding alphabet is hidden in the target. -/
def prefixCylinder (S : Set (ℕ → A)) (n : ℕ) : Set (ℕ → A) :=
  ⋃ x : S, PiNat.cylinder (x : ℕ → A) n

@[simp] theorem mem_prefixCylinder_iff {S : Set (ℕ → A)} {n : ℕ}
    {x : ℕ → A} :
    x ∈ prefixCylinder S n ↔ ∃ y ∈ S, x ∈ PiNat.cylinder y n := by
  simp only [prefixCylinder, mem_iUnion]
  constructor
  · rintro ⟨y, hy⟩
    exact ⟨y, y.property, hy⟩
  · rintro ⟨y, hy, hxy⟩
    exact ⟨⟨y, hy⟩, hxy⟩

theorem isOpen_prefixCylinder [TopologicalSpace A] [DiscreteTopology A]
    {S : Set (ℕ → A)} (n : ℕ) :
    IsOpen (prefixCylinder S n) := by
  exact isOpen_iUnion fun y =>
    PiNat.isOpen_cylinder (E := fun _ : ℕ => A) (y : ℕ → A) n

theorem isClosed_prefixCylinder [TopologicalSpace A] [DiscreteTopology A]
    {S : Set (ℕ → A)} (n : ℕ) :
    IsClosed (prefixCylinder S n) := by
  rw [← isOpen_compl_iff]
  have hcomp : (prefixCylinder S n)ᶜ =
      ⋃ x : {x : ℕ → A // x ∈ (prefixCylinder S n)ᶜ},
        PiNat.cylinder (x : ℕ → A) n := by
    ext z
    constructor
    · intro hz
      exact Set.mem_iUnion.mpr ⟨⟨z, hz⟩, PiNat.self_mem_cylinder z n⟩
    · rintro hz
      obtain ⟨x, hx⟩ := Set.mem_iUnion.mp hz
      intro hzS
      obtain ⟨y, hyS, hzy⟩ := mem_prefixCylinder_iff.mp hzS
      apply x.property
      exact mem_prefixCylinder_iff.mpr ⟨y, hyS, fun i hi =>
        (PiNat.mem_cylinder_iff.mp hx i hi).symm.trans
          (PiNat.mem_cylinder_iff.mp hzy i hi)⟩
  rw [hcomp]
  exact isOpen_iUnion fun x =>
    PiNat.isOpen_cylinder (E := fun _ : ℕ => A) (x : ℕ → A) n

theorem prefixCylinder_succ_subset {S : Set (ℕ → A)} (n : ℕ) :
    prefixCylinder S (n + 1) ⊆ prefixCylinder S n := by
  intro x hx
  obtain ⟨y, hyS, hxy⟩ := mem_prefixCylinder_iff.mp hx
  exact mem_prefixCylinder_iff.mpr
    ⟨y, hyS, (PiNat.cylinder_anti y (Nat.le_succ n)) hxy⟩

/-- A closed set in the one-sided full shift is exactly the intersection of
all its finite-prefix cylinder approximations.  This is the basic compact/
infinite reflection theorem: an excluded word is separated by one finite
prefix, while a member supplies a witness at every level. -/
theorem closed_eq_iInter_prefixCylinder [TopologicalSpace A] [DiscreteTopology A] [Finite A]
    {S : Set (ℕ → A)} (hS : IsClosed S) :
    S = ⋂ n : ℕ, prefixCylinder S n := by
  apply Subset.antisymm
  · intro x hx
    simp only [mem_iInter]
    intro n
    rw [mem_prefixCylinder_iff]
    exact ⟨x, hx, PiNat.self_mem_cylinder x n⟩
  · intro x hx
    by_contra hxs
    have hxcompl : x ∈ Sᶜ := hxs
    have hb := PiNat.isTopologicalBasis_cylinders (fun _ : ℕ => A)
    obtain ⟨v, ⟨y, n, hv⟩, hxy, hycompl⟩ :=
      hb.exists_subset_of_mem_open hxcompl hS.isOpen_compl
    rw [hv] at hxy hycompl
    have hxn : x ∈ prefixCylinder S n := (mem_iInter.mp hx) n
    obtain ⟨z, hzS, hzx⟩ := (mem_prefixCylinder_iff.mp hxn)
    have hzy : z ∈ PiNat.cylinder y n := by
      intro i hi
      exact (PiNat.mem_cylinder_iff.mp hzx i hi).symm.trans
        (PiNat.mem_cylinder_iff.mp hxy i hi)
    exact (hycompl hzy) hzS

theorem closure_eq_iInter_prefixCylinder [TopologicalSpace A] [DiscreteTopology A]
    {S : Set (ℕ → A)} :
    closure S = ⋂ n : ℕ, prefixCylinder S n := by
  apply Subset.antisymm
  · refine closure_minimal ?_ (isClosed_iInter fun n => isClosed_prefixCylinder n)
    intro x hx
    simp only [mem_iInter]
    intro n
    exact mem_prefixCylinder_iff.mpr ⟨x, hx, PiNat.self_mem_cylinder x n⟩
  · intro x hx
    by_contra hxc
    have hopen : IsOpen (closure S)ᶜ := isClosed_closure.isOpen_compl
    have hb := PiNat.isTopologicalBasis_cylinders (fun _ : ℕ => A)
    obtain ⟨v, ⟨y, n, hv⟩, hxy, hycompl⟩ :=
      hb.exists_subset_of_mem_open hxc hopen
    rw [hv] at hxy hycompl
    have hxn : x ∈ prefixCylinder S n := (mem_iInter.mp hx) n
    obtain ⟨z, hzS, hzx⟩ := mem_prefixCylinder_iff.mp hxn
    have hzy : z ∈ PiNat.cylinder y n := by
      intro i hi
      exact (PiNat.mem_cylinder_iff.mp hzx i hi).symm.trans
        (PiNat.mem_cylinder_iff.mp hxy i hi)
    exact (hycompl hzy) (subset_closure hzS)

/-- One shift step lowers the required prefix length by one.  This is the
finite-stage transition used when the closed set is shift invariant. -/
theorem shift_mem_prefixCylinder_of_mem_succ
    {S : Set (ℕ → A)}
    (hshift : ∀ y ∈ S, (fun i => y (i + 1)) ∈ S)
    {x : ℕ → A} {n : ℕ}
    (hx : x ∈ prefixCylinder S (n + 1)) :
    (fun i => x (i + 1)) ∈ prefixCylinder S n := by
  obtain ⟨y, hyS, hxy⟩ := mem_prefixCylinder_iff.mp hx
  refine mem_prefixCylinder_iff.mpr ⟨fun i => y (i + 1), hshift y hyS, ?_⟩
  intro i hi
  change x (i + 1) = y (i + 1)
  exact (PiNat.mem_cylinder_iff.mp hxy) (i + 1) (by omega)

end D5.S1.Words.Complexity.PrefixLanguageTopology
