private theorem upper_checked : checkRows candidates wList upperCertificate = true := by
  decide +kernel

private theorem w_count_upper : distinctLyndon w ≤ 16 := by
  have hcov : ∀ i j : ℕ, 1 ≤ j → i + j ≤ 506 → IsLyndon (factor w i j) →
      factor w i j ∈ candidates := by
    intro i j hj hij hL
    have hfac : factor w i j = (wList.drop i).take j := by
      rw [factor, ← List.ofFn_eq_map, w_ofFn]
    rw [hfac] at hL ⊢
    exact check_rows_sound candidates wList upperCertificate upper_checked i j
      (by change i < 506; exact (Nat.lt_add_of_pos_right hj).trans_le hij) hj hij hL
  calc distinctLyndon w ≤ candidates.toFinset.card := distinct_le_of_cover w candidates hcov
       _ = 16 := by decide +kernel

private theorem w_count : distinctLyndon w = 16 := by
  apply Nat.le_antisymm w_count_upper
  let ps : List (ℕ × ℕ) := [(0,1),(2,1),(1,2),(0,3),(3,5),(0,8),(8,13),(29,18),(0,21),(21,26),(0,47),(47,73),(0,120),(120,193),(0,313),(0,506)]
  have hg : ∀ p ∈ ps, 1 ≤ p.2 ∧ p.1 + p.2 ≤ 506 ∧ LyndonTest (factor w p.1 p.2) := by
    decide +kernel
  have hc : (ps.map (fun p => factor w p.1 p.2)).toFinset.card = 16 := by decide +kernel
  simpa only [hc] using distinct_ge_of_witness w ps hg

