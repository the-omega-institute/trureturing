open D5.S1.Words.Complexity.LyndonBrackets.LyndonOrder (IsLyndon)

/-- Drop `i` letters and take at most `l` letters of `w`. -/
def factor {σ n : ℕ} (w : Fin n → Fin σ) (i l : ℕ) : List (Fin σ) :=
  ((List.finRange n).map w).drop i |>.take l

/-- Occurrences `(i, l)`, `l ≥ 1`, `i + l ≤ n`, of Lyndon factors of `w`. -/
noncomputable def lyndonOccurrences {σ n : ℕ} (w : Fin n → Fin σ) : Finset (ℕ × ℕ) := by
  classical
  exact ((Finset.range n ×ˢ Finset.range (n + 1)).filter fun p =>
    1 ≤ p.2 ∧ p.1 + p.2 ≤ n ∧ IsLyndon (factor w p.1 p.2))

/-- `D(W)`: the number of distinct Lyndon factors of `W`. -/
noncomputable def distinctLyndon {σ n : ℕ} (w : Fin n → Fin σ) : ℕ := by
  classical
  exact ((lyndonOccurrences w).image fun p => factor w p.1 p.2).card

/-- The (lower) Christoffel word of slope `p/n` over `{a, b} = {0, 1}`, `a < b`: its `i`-th letter is
`b` exactly when `⌊(i + 1)p/n⌋ - ⌊ip/n⌋ = 1`. It has length `n` and `p` letters `b`. -/
def christoffel (p n : ℕ) : Fin n → Fin 2 :=
  fun i => if ((i : ℕ) + 1) * p / n - (i : ℕ) * p / n = 1 then 1 else 0

/-- Glen–Simpson–Smyth, Open Problem 1: for every length `n ≥ 2`, the minimum number of distinct Lyndon
factors over all Lyndon words of length `n` (over any finite ordered alphabet) is attained by at least
one Christoffel word of length `n`. -/
def claim : Prop :=
  ∀ n : ℕ, 2 ≤ n → ∃ p : ℕ, 0 < p ∧ p < n ∧ Nat.Coprime p n ∧
    ∀ (k : ℕ) (w : Fin n → Fin k), IsLyndon (List.ofFn w) →
      distinctLyndon (christoffel p n) ≤ distinctLyndon w

open D5.S1.Words.Complexity.LyndonBrackets.LyndonOrder
variable {α : Type} [LinearOrder α]

private def LyndonTest (w : List α) : Prop :=
  w ≠ [] ∧ ∀ v ∈ w.tail.tails, v ≠ [] → w < v
private instance lyndonTestDecidable (w : List α) : Decidable (LyndonTest w) := by unfold LyndonTest; infer_instance

private theorem lyndon_test_iff (w : List α) : LyndonTest w ↔ IsLyndon w := by
  rw [isLyndon_iff_lt_suffix]
  constructor
  · rintro ⟨hn, ht⟩
    refine ⟨hn, ?_⟩
    intro v hv hvw hne
    rcases hvw with ⟨u, hu⟩
    cases u with
    | nil => exact (hne (by simpa using hu)).elim
    | cons a u =>
        have he : w.tail = u ++ v := by rw [← hu]; rfl
        exact ht v ((List.mem_tails v w.tail).mpr (by rw [he]; exact List.suffix_append u v)) hv
  · rintro ⟨hn, ht⟩
    refine ⟨hn, ?_⟩
    intro v hv hvne
    have hs := (List.mem_tails v w.tail).mp hv
    apply ht v hvne (hs.trans (List.tail_suffix w))
    intro he
    have hh := hs.length_le
    have hp := List.length_pos_of_ne_nil hn
    simp only [he, List.length_tail] at hh
    omega

private theorem take_order_mono {x y : List α} (h : x ≤ y) (n : ℕ) : x.take n ≤ y.take n := by
  rcases eq_or_lt_of_le h with rfl | hlt
  · exact le_rfl
  · clear h
    change List.Lex (fun a b : α => a < b) x y at hlt
    induction hlt generalizing n with
    | @nil a l =>
        cases n with
        | zero => exact le_rfl
        | succ n =>
            simp only [List.take_nil, List.take_succ_cons]
            apply le_of_lt
            change List.Lex (fun a b : α => a < b) [] (a :: l.take n)
            exact List.Lex.nil
    | rel hab =>
        cases n with
        | zero => exact le_rfl
        | succ n => exact le_of_lt (List.Lex.rel hab)
    | cons h ih =>
        cases n with
        | zero => exact le_rfl
        | succ n => exact List.cons_le_cons _ (ih n)

private theorem rejection_take {s : List α} {k : ℕ} (h : s.drop k ≤ s) (j : ℕ) :
    (s.take j).drop k ≤ s.take j := by
  rw [List.drop_take]
  have h₁ := take_order_mono h (j-k)
  have h₂ : s.take (j-k) ≤ s.take j :=
    le_of_not_gt (List.take_prefix_take_left (l := s) (Nat.sub_le j k)).le
  exact h₁.trans h₂

private theorem not_lyndon_of_bad_suffix (s : List α) (k : ℕ) (hk : 0 < k)
    (hkt : k < s.length) (hb : s.drop k ≤ s) : ¬ IsLyndon s := by
  intro hL
  have hh : s < s.drop k := by
    apply ((isLyndon_iff_lt_suffix s).mp hL).2
    · intro he
      have hl := congrArg List.length he
      simp only [List.length_drop, List.length_nil] at hl
      omega
    · exact List.drop_suffix k s
    · intro he
      have hl := congrArg List.length he
      simp only [List.length_drop] at hl
      omega
  exact not_lt_of_ge hb hh

private def SegmentGood (s : List α) (cs : List (List α)) (lo : ℕ) (q : ℕ × ℕ) : Prop :=
  lo ≤ q.1 ∧ q.1 ≤ s.length ∧
    if q.2 = 0 then q.1 = lo ∧ s.take q.1 ∈ cs
    else q.2 < lo ∧ (s.take q.1).drop q.2 ≤ s.take q.1
private instance segmentGoodDecidable (s : List α) (cs : List (List α)) (lo : ℕ) (q : ℕ × ℕ) :
    Decidable (SegmentGood s cs lo q) := by unfold SegmentGood; infer_instance

private def checkRow (s : List α) (cs : List (List α)) (lo : ℕ) : List (ℕ × ℕ) → Bool
  | [] => decide (s.length < lo)
  | q :: qs => decide (SegmentGood s cs lo q) && checkRow s cs (q.1 + 1) qs

private theorem check_row_sound (s : List α) (cs : List (List α)) (lo : ℕ) (qs : List (ℕ × ℕ))
    (h : checkRow s cs lo qs = true) (j : ℕ) (hlo : lo ≤ j) (hhi : j ≤ s.length)
    (hj : IsLyndon (s.take j)) : s.take j ∈ cs := by
  induction qs generalizing lo with
  | nil => simp only [checkRow, decide_eq_true_eq] at h; omega
  | cons q qs ih =>
      simp only [checkRow, Bool.and_eq_true, decide_eq_true_eq] at h
      by_cases hjq : j ≤ q.1
      · have hg := h.1
        rcases hg with ⟨hloq, hqs, hg⟩
        split at hg
        · have he : j = q.1 := le_antisymm hjq (hg.1.le.trans hlo)
          simpa only [he] using hg.2
        · rename_i hk
          have hp : 0 < q.2 := Nat.pos_of_ne_zero hk
          have hb : (s.take j).drop q.2 ≤ s.take j := by
            simpa only [List.take_take, Nat.min_eq_left hjq] using (rejection_take hg.2 j)
          exact (not_lyndon_of_bad_suffix (s.take j) q.2 hp
            (by rw [List.length_take_of_le hhi]; exact hg.1.trans_le hlo) hb hj).elim
      · exact ih (q.1 + 1) h.2 (Nat.succ_le_of_lt (lt_of_not_ge hjq))

private def checkRows (cs : List (List α)) : List α → List (List (ℕ × ℕ)) → Bool
  | [], _ => true
  | _ :: _, [] => false
  | a :: s, qs :: rest => checkRow (a :: s) cs 1 qs && checkRows cs s rest

private theorem check_rows_sound (cs : List (List α)) (s : List α) (cert : List (List (ℕ × ℕ)))
    (h : checkRows cs s cert = true) (i j : ℕ) (hi : i < s.length)
    (hj : 0 < j) (hij : i + j ≤ s.length)
    (hL : IsLyndon ((s.drop i).take j)) : (s.drop i).take j ∈ cs := by
  induction s generalizing cert i with
  | nil => simp at hi
  | cons a s ih =>
      cases cert with
      | nil => simp [checkRows] at h
      | cons qs rest =>
          simp only [checkRows, Bool.and_eq_true] at h
          cases i with
          | zero =>
              simp only [List.drop_zero] at hL ⊢
              exact check_row_sound (a :: s) cs 1 qs h.1 j hj (by simpa using hij) hL
          | succ i =>
              simp only [List.drop_succ_cons] at hL ⊢
              exact ih rest h.2 i (Nat.lt_of_succ_lt_succ hi)
                (Nat.le_of_succ_le_succ (by simpa only [Nat.succ_add, List.length_cons] using hij)) hL


private theorem distinct_le_of_cover {σ n : ℕ} (w : Fin n → Fin σ)
    (cs : List (List (Fin σ)))
    (hc : ∀ i j : ℕ, 1 ≤ j → i + j ≤ n → IsLyndon (factor w i j) →
      factor w i j ∈ cs) : distinctLyndon w ≤ cs.toFinset.card := by
  classical
  apply Finset.card_le_card
  intro t ht
  obtain ⟨p, hp, rfl⟩ := Finset.mem_image.mp ht
  have h := (Finset.mem_filter.mp hp).2
  exact List.mem_toFinset.mpr (hc p.1 p.2 h.1 h.2.1 h.2.2)

private theorem distinct_ge_of_witness {σ n : ℕ} (w : Fin n → Fin σ)
    (ps : List (ℕ × ℕ))
    (hg : ∀ p ∈ ps, 1 ≤ p.2 ∧ p.1 + p.2 ≤ n ∧ LyndonTest (factor w p.1 p.2)) :
    (ps.map (fun p => factor w p.1 p.2)).toFinset.card ≤ distinctLyndon w := by
  classical
  apply Finset.card_le_card
  intro t ht
  obtain ⟨p, hp, rfl⟩ := List.mem_map.mp (List.mem_toFinset.mp ht)
  obtain ⟨hl, hn, hL⟩ := hg p hp
  apply Finset.mem_image.mpr
  refine ⟨p, Finset.mem_filter.mpr ⟨?_, hl, hn, (lyndon_test_iff _).mp hL⟩, rfl⟩
  exact Finset.mem_product.mpr ⟨Finset.mem_range.mpr ((Nat.lt_add_of_pos_right hl).trans_le hn),
    Finset.mem_range.mpr (Nat.lt_succ_of_le ((Nat.le_add_left p.2 p.1).trans hn))⟩

