private def LowerCheck (p : ℕ) (ps : List (ℕ × ℕ)) : Prop :=
  17 ≤ (ps.map (fun q => factor (christoffel p 506) q.1 q.2)).toFinset.card ∧
  ∀ q ∈ ps, 1 ≤ q.2 ∧ q.1 + q.2 ≤ 506 ∧
    LyndonTest (factor (christoffel p 506) q.1 q.2)

private theorem lower_checked : ∀ row ∈ lowerCertificate, LowerCheck row.1 row.2 := by
  simp only [lowerCertificate, List.forall_mem_cons]
  repeat' apply And.intro
  all_goals first | exact List.forall_mem_nil _ | decide +kernel

private theorem lower_complete : ∀ p : Fin 506, 0 < p.val → Nat.Coprime p.val 506 →
    p.val ∈ lowerCertificate.map Prod.fst := by
  change ∀ p : Fin 506, 0 < p.val → Nat.Coprime p.val 506 →
    p.val ∈ ([1, 3, 5, 7, 9, 13, 15, 17, 19, 21, 25, 27, 29, 31, 35, 37, 39, 41, 43, 45, 47, 49, 51, 53, 57, 59, 61, 63, 65, 67, 71, 73, 75, 79, 81, 83, 85, 87, 89, 91, 93, 95, 97, 101, 103, 105, 107, 109, 111, 113, 117, 119, 123, 125, 127, 129, 131, 133, 135, 137, 139, 141, 145, 147, 149, 151, 153, 155, 157, 159, 163, 167, 169, 171, 173, 175, 177, 179, 181, 183, 185, 189, 191, 193, 195, 197, 199, 201, 203, 205, 211, 213, 215, 217, 219, 221, 223, 225, 227, 229, 233, 235, 237, 239, 241, 243, 245, 247, 249, 251, 255, 257, 259, 261, 263, 265, 267, 269, 271, 273, 277, 279, 281, 283, 285, 287, 289, 291, 293, 295, 301, 303, 305, 307, 309, 311, 313, 315, 317, 321, 323, 325, 327, 329, 331, 333, 335, 337, 339, 343, 347, 349, 351, 353, 355, 357, 359, 361, 365, 367, 369, 371, 373, 375, 377, 379, 381, 383, 387, 389, 393, 395, 397, 399, 401, 403, 405, 409, 411, 413, 415, 417, 419, 421, 423, 425, 427, 431, 433, 435, 439, 441, 443, 445, 447, 449, 453, 455, 457, 459, 461, 463, 465, 467, 469, 471, 475, 477, 479, 481, 485, 487, 489, 491, 493, 497, 499, 501, 503, 505] : List ℕ)
  decide +kernel

private theorem christoffel_lower (p : ℕ) (hp : 0 < p) (hpn : p < 506)
    (hcop : Nat.Coprime p 506) : 17 ≤ distinctLyndon (christoffel p 506) := by
  obtain ⟨row, hr, he⟩ := List.mem_map.mp (lower_complete ⟨p,hpn⟩ hp hcop)
  have h := lower_checked row hr
  rw [he] at h
  exact h.1.trans (distinct_ge_of_witness _ row.2 h.2)

theorem result : ¬ claim := by
  intro hc
  obtain ⟨p, hp, hpn, hcop, hmin⟩ := hc 506 (by omega)
  have hu := hmin 2 w w_lyndon
  have hl := christoffel_lower p hp hpn hcop
  have hw := w_count
  omega

end D5.S1.Words.Complexity.LyndonFactorChristoffelMinimumRefutation
