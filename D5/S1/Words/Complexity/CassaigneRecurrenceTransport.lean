noncomputable def factorLanguage (u : ℕ → Bool) (n : ℕ) : Set (List Bool) :=
  {w | ∃ i : ℕ, w = List.ofFn (fun j : Fin n => u (i + j.1))}

def HasPeriod (w : List Bool) (p : ℕ) : Prop :=
  0 < p ∧ ∀ i : ℕ, i + p < w.length → w.getD i false = w.getD (i + p) false

noncomputable def per (w : List Bool) : ℕ := sInf {p : ℕ | HasPeriod w p}

noncomputable def exponent (w : List Bool) : ℝ≥0∞ :=
  (w.length : ℝ≥0∞) / (per w : ℝ≥0∞)

noncomputable def indexAt (u : ℕ → Bool) (n : ℕ) : ℝ≥0∞ :=
  ⨆ (w : {w : List Bool // w ∈ factorLanguage u n}), exponent w.1

noncomputable def indStar (u : ℕ → Bool) : ℝ≥0∞ :=
  ⨅ N : ℕ, ⨆ n : ℕ, if N ≤ n then indexAt u n else 0

def HasRecurrenceBound (u : ℕ → Bool) (n N : ℕ) : Prop :=
  ∀ w : List Bool, w ∈ factorLanguage u N →
    ∀ x : List Bool, x ∈ factorLanguage u n →
      ∃ i : ℕ, i + x.length ≤ w.length ∧
        ∀ j : Fin x.length, x.getD j.1 false = w.getD (i + j.1) false

def recurrenceCandidates (u : ℕ → Bool) (n : ℕ) : Set ℕ∞ :=
  {r | ∃ N : ℕ, r = (N : ℕ∞) ∧ HasRecurrenceBound u n N}

noncomputable def recurrenceFunction (u : ℕ → Bool) (n : ℕ) : ℕ∞ :=
  sInf (recurrenceCandidates u n)

noncomputable def recurrenceRatio (u : ℕ → Bool) (n : ℕ) : ℝ≥0∞ :=
  if n = 0 then 0 else
    (fun r : ℕ∞ => (r : ℝ≥0∞)) (recurrenceFunction u n) / (n : ℝ≥0∞)

noncomputable def rhoStar (u : ℕ → Bool) : ℝ≥0∞ :=
  ⨅ n₀ : ℕ, ⨆ n : ℕ, if n₀ ≤ n then recurrenceRatio u n else 0

def floorCoding (u : ℕ → Bool) (α β : ℝ) : Prop :=
  ∀ n : ℕ, u n = true ↔
    ⌊α * (n : ℝ) + β⌋ = ⌊α * ((n + 1 : ℕ) : ℝ) + β⌋

def ceilCoding (u : ℕ → Bool) (α β : ℝ) : Prop :=
  ∀ n : ℕ, u n = true ↔
    ⌈α * (n : ℝ) + β⌉ = ⌈α * ((n + 1 : ℕ) : ℝ) + β⌉

def IsSturmian (u : ℕ → Bool) : Prop :=
  ∃ α β : ℝ, Irrational α ∧ α ∈ Set.Icc 0 1 ∧
    (floorCoding u α β ∨ ceilCoding u α β)

def replicated (k : ℕ) (u : ℕ → Bool) (n : ℕ) : Bool := u (n / k)

private theorem factorLanguage_eq_image (u : ℕ → Bool) (n : ℕ) :
    factorLanguage u n = Set.image List.ofFn {v | v ∈ wordFactorSet u n} := by
  ext w
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨wordFactor u n i, mem_wordFactorSet.mpr ⟨i, rfl⟩, rfl⟩
  · rintro ⟨v, hv, rfl⟩
    obtain ⟨i, rfl⟩ := mem_wordFactorSet.mp hv
    exact ⟨i, rfl⟩

private theorem containsFactor_iff_infix (x w : List Bool) :
    (∃ i : ℕ, i + x.length ≤ w.length ∧
      ∀ j : Fin x.length, x.getD j.1 false = w.getD (i + j.1) false) ↔
      List.IsInfix x w := by
  rw [List.infix_iff_getElem?]
  constructor
  · rintro ⟨i, hi, he⟩
    refine ⟨i, by omega, ?_⟩
    intro j hj
    have hij : i+j < w.length := by omega
    have hji : j+i < w.length := by omega
    have hh := he ⟨j, hj⟩
    simpa [List.getD_eq_getElem, hj, hij, hji, Nat.add_comm j i] using hh.symm
  · rintro ⟨i, hi, he⟩
    refine ⟨i, by omega, ?_⟩
    intro j
    have hij : i+j.1 < w.length := by omega
    have hji : j.1+i < w.length := by omega
    have hh := he j.1 j.2
    simpa [List.getD_eq_getElem, j.2, hij, hji, Nat.add_comm j.1 i] using hh.symm

private theorem lower_no_two_constant_bigrams (α β : ℝ) (h0 : 0 ≤ α) (h1 : α < 1)
    (i j : ℕ)
    (hi : lowerMechanicalWord α β i = true ∧ lowerMechanicalWord α β (i+1) = true)
    (hj : lowerMechanicalWord α β j = false ∧ lowerMechanicalWord α β (j+1) = false) :
    False := by
  have hb := lowerMechanicalWord_balanced_one (rho := β) h0 h1 i j 2
  simp only [lowerMechanicalWindowTrueCount,
    show Finset.range 2 = {0,1} from rfl,
    Finset.filter_insert, Finset.filter_singleton, Nat.add_zero,
    hi.1, hi.2, hj.1, hj.2] at hb
  norm_num at hb

private theorem floorCoding_complement {u : ℕ → Bool} {α β : ℝ}
    (h0 : 0 ≤ α) (h1 : α < 1) (h : floorCoding u α β) (n : ℕ) :
    lowerMechanicalWord α β n = !u n := by
  have he := lowerMechanicalLetter_eq_zero_or_one (rho := β) h0 h1 n
  have hc := h n
  rw [lowerMechanicalLetter] at he
  have ee : (⌊β + ((n+1 : ℕ) : ℝ) * α⌋ = ⌊β + (n : ℝ) * α⌋) ↔ u n = true := by
    rw [hc]
    simp only [add_comm β, mul_comm α]
    exact eq_comm
  cases hu : u n
  · change lowerMechanicalWord α β n = true
    rw [lowerMechanicalWord_eq_true_iff, lowerMechanicalLetter]
    have hne : ⌊β + ((n+1 : ℕ) : ℝ) * α⌋ ≠ ⌊β + (n : ℝ) * α⌋ := by
      intro heq
      have := ee.mp heq
      simp [hu] at this
    omega
  · change lowerMechanicalWord α β n = false
    apply Bool.eq_false_iff.mpr
    intro heq
    rw [lowerMechanicalWord_eq_true_iff, lowerMechanicalLetter] at heq
    have eqf := ee.mpr hu
    omega

private theorem ceilCoding_lower {u : ℕ → Bool} {α β : ℝ}
    (h : ceilCoding u α β) (n : ℕ) :
    lowerMechanicalWord (1-α) (-β) n = u n := by
  have e0 : ⌊-β + (n : ℝ) * (1-α)⌋ = (n : ℤ) - ⌈α * (n : ℝ) + β⌉ := by
    have e : -β + (n : ℝ) * (1-α) = -(α * (n : ℝ) + β) + (n : ℤ) := by push_cast; ring
    rw [e, Int.floor_add_intCast, Int.floor_neg]
    omega
  have e1 : ⌊-β + ((n+1 : ℕ) : ℝ) * (1-α)⌋ = ((n+1 : ℕ) : ℤ) - ⌈α * ((n+1 : ℕ) : ℝ) + β⌉ := by
    have e : -β + ((n+1 : ℕ) : ℝ) * (1-α) = -(α * ((n+1 : ℕ) : ℝ) + β) + ((n+1 : ℕ) : ℤ) := by push_cast; ring
    rw [e, Int.floor_add_intCast, Int.floor_neg]
    omega
  apply Bool.eq_iff_iff.mpr
  rw [lowerMechanicalWord_eq_true_iff, lowerMechanicalLetter, e0, e1]
  have hc := h n
  simp only [Nat.cast_add, Nat.cast_one] at hc e0 e1 ⊢
  rw [hc]
  omega

private theorem not_sturmian_of_constant_bigrams {u : ℕ → Bool}
    (hi : ∃ i, u i = true ∧ u (i+1) = true)
    (hj : ∃ j, u j = false ∧ u (j+1) = false) : ¬ IsSturmian u := by
  rintro ⟨α,β,hirr,hα,hcode⟩
  have hlt : α < 1 := lt_of_le_of_ne hα.2 (hirr.ne_one)
  have hpos : 0 < α := lt_of_le_of_ne hα.1 (Ne.symm hirr.ne_zero)
  obtain ⟨i,hi0,hi1⟩ := hi
  obtain ⟨j,hj0,hj1⟩ := hj
  rcases hcode with hf | hc
  · apply lower_no_two_constant_bigrams α β hα.1 hlt j i
    · simp [floorCoding_complement hα.1 hlt hf, hj0, hj1]
    · simp [floorCoding_complement hα.1 hlt hf, hi0, hi1]
  · apply lower_no_two_constant_bigrams (1-α) (-β) (by linarith) (by linarith) i j
    · simp [ceilCoding_lower hc, hi0, hi1]
    · simp [ceilCoding_lower hc, hj0, hj1]

private theorem vk_constant_bigrams (k : ℕ) (hk : 2 ≤ k) :
    (∃ i, (replicated k D5.S1.Words.goldenWord) i = true ∧ (replicated k D5.S1.Words.goldenWord) (i+1) = true) ∧
    (∃ i, (replicated k D5.S1.Words.goldenWord) i = false ∧ (replicated k D5.S1.Words.goldenWord) (i+1) = false) := by
  have hone : goldenWord 1 = false := by
    simpa [D5.S1.Words.Powers.goldenSubstStart_zero,
      D5.S1.Words.Powers.goldenWord_zero] using
      D5.S1.Words.Powers.goldenWord_goldenSubstStart_succ 0
  have hp : 0 < k := Nat.zero_lt_of_lt hk
  have d0 : 0/k = 0 := Nat.zero_div k
  have d1 : 1/k = 0 := Nat.div_eq_of_lt (by omega)
  have dk : k/k = 1 := Nat.div_self hp
  have dk1 : (k+1)/k = 1 := by
    apply (Nat.div_eq_iff hp).mpr
    constructor <;> omega
  exact ⟨⟨0,by simpa [replicated,d0] using D5.S1.Words.Powers.goldenWord_zero,
      by simpa [replicated,d1] using D5.S1.Words.Powers.goldenWord_zero⟩,
    ⟨k,by simpa [replicated,dk] using hone,
      by simpa [replicated,dk1] using hone⟩⟩

theorem vk_not_sturmian (k : ℕ) (hk : 2 ≤ k) : ¬ IsSturmian ((replicated k D5.S1.Words.goldenWord)) := by
  rcases vk_constant_bigrams k hk with ⟨hi,hj⟩
  exact not_sturmian_of_constant_bigrams hi hj

theorem contains_block_iff (u v : ℕ → Bool) (i j n N : ℕ) :
    List.IsInfix ((rayPrefix (fun index => u (i + index)) n)) ((rayPrefix (fun index => v (j + index)) N)) ↔
      ∃ t, t+n ≤ N ∧ ∀ r < n, u (i+r) = v (j+(t+r)) := by
  rw [List.infix_iff_getElem?]
  constructor
  · rintro ⟨t, ht, he⟩
    have ht' : t+n ≤ N := by simpa only [rayPrefix, List.length_ofFn, Nat.add_comm n t] using ht
    refine ⟨t, ht', ?_⟩
    intro r hr
    have hrt : r+t < N := by omega
    have htr : t+r < N := by omega
    have hh := he r (by simpa only [rayPrefix, List.length_ofFn] using hr)
    simpa only [rayPrefix, List.getElem?_ofFn, List.getElem_ofFn, hrt, htr,
      ↓reduceDIte, Option.some.injEq, Nat.add_comm r t] using hh.symm
  · rintro ⟨t, ht, he⟩
    refine ⟨t, by simpa only [rayPrefix, List.length_ofFn, Nat.add_comm n t] using ht, ?_⟩
    intro r hr
    have hr' : r < n := by simpa only [rayPrefix, List.length_ofFn] using hr
    have hrt : r+t < N := by omega
    have htr : t+r < N := by omega
    simpa only [rayPrefix, List.getElem?_ofFn, List.getElem_ofFn, hrt, htr,
      ↓reduceDIte, Option.some.injEq, Nat.add_comm r t] using (he r hr').symm

private theorem recurrence_bound_iff (u : ℕ → Bool) (n N : ℕ) :
    HasRecurrenceBound u n N ↔
      ∀ i j, ∃ t, t+n ≤ N ∧ ∀ r < n, u (i+r) = u (j+(t+r)) := by
  have howner : HasRecurrenceBound u n N ↔
      ∀ w : List Bool, w ∈ factorLanguage u N →
        ∀ x : List Bool, x ∈ factorLanguage u n → List.IsInfix x w := by
    simp only [HasRecurrenceBound, containsFactor_iff_infix]
  rw [howner]
  constructor
  · intro h i j
    apply (contains_block_iff u u i j n N).mp
    apply h (rayPrefix (fun index => u (j + index)) N)
    · rw [factorLanguage_eq_image]
      exact ⟨wordFactor u N j, mem_wordFactorSet.mpr ⟨j, rfl⟩, rfl⟩
    · exact ⟨i, rfl⟩
  · intro h w hw x hx
    obtain ⟨j, rfl⟩ := hw
    obtain ⟨i, rfl⟩ := hx
    exact (contains_block_iff u u i j n N).mpr (h i j)

theorem replicated_transition_aligned (k : ℕ) (u : ℕ → Bool)
    (i : ℕ) (h : replicated k u i ≠ replicated k u (i+1)) : k ∣ i+1 := by
  by_contra hnd
  exact h (congrArg u (Nat.succ_div_of_not_dvd hnd).symm)

private theorem division_shift (k : ℕ) (hk : 0 < k) (i r : ℕ) :
    (i+r)/k = i/k + (i%k+r)/k := by
  conv_lhs => rw [← Nat.div_add_mod i k]
  rw [Nat.add_assoc, Nat.mul_add_div hk]

private theorem recurrence_bound_replicated (k : ℕ) (hk : 0 < k) (u : ℕ → Bool)
    (n M : ℕ) (h : HasRecurrenceBound u (n/k+2) M) :
    HasRecurrenceBound (replicated k u) n (k*M+2*k) := by
  rw [recurrence_bound_iff] at h ⊢
  intro i j
  obtain ⟨t,ht,he⟩ := h (i/k) (j/k+1)
  let q := j/k+1+t
  let P := k*q+i%k
  have hq : q+(n/k+2) ≤ j/k+1+M := by dsimp [q]; omega
  have hj : j ≤ P := by
    have hd := Nat.div_add_mod j k
    have hm := Nat.mod_lt j hk
    have hmul : k*(j/k+1) ≤ k*q := Nat.mul_le_mul_left k (by dsimp [q]; omega)
    dsimp [P]
    rw [Nat.mul_add] at hmul
    omega
  have hlen : i%k+n ≤ k*(n/k+2) := by
    have hn := Nat.div_add_mod n k
    have hnmod := Nat.mod_lt n hk
    have himod := Nat.mod_lt i hk
    rw [Nat.mul_add, Nat.mul_two]
    omega
  simp only [Nat.mul_add,Nat.mul_two] at hlen
  have hend : P+n ≤ j+(k*M+2*k) := by
    have hmul := Nat.mul_le_mul_left k hq
    have hd := Nat.div_add_mod j k
    dsimp [P]
    simp only [Nat.mul_add,Nat.mul_one] at hmul
    omega
  refine ⟨P-j,by omega,?_⟩
  intro r hr
  have hr' : (i%k+r)/k < n/k+2 := by
    apply (Nat.div_lt_iff_lt_mul hk).mpr
    rw [Nat.mul_comm]
    simp only [Nat.mul_add,Nat.mul_two]
    omega
  have hij : j+(P-j+r) = P+r := by omega
  change u ((i+r)/k) = u ((j+(P-j+r))/k)
  rw [hij,division_shift k hk i r]
  have hp : (P+r)/k = q+(i%k+r)/k := by
    dsimp [P]
    rw [Nat.add_assoc,Nat.mul_add_div hk]
  rw [hp]
  simpa [q,Nat.add_assoc] using he ((i%k+r)/k) hr'

private theorem recurrence_bound_decode (k : ℕ) (hk : 0 < k) (u : ℕ → Bool)
    (n N : ℕ) (h : HasRecurrenceBound (replicated k u) (k*n) N) :
    HasRecurrenceBound u n (N/k) := by
  rw [recurrence_bound_iff] at h ⊢
  intro i j
  obtain ⟨t,ht,he⟩ := h (k*i) (k*j)
  refine ⟨t/k,?_,?_⟩
  · have hd := Nat.div_le_div_right (c := k) ht
    simpa [Nat.add_mul_div_left, hk] using hd
  · intro r hr
    have hkr : k*r < k*n := Nat.mul_lt_mul_of_pos_left hr hk
    have hh := he (k*r) hkr
    change u ((k*i+k*r)/k) = u ((k*j+(t+k*r))/k) at hh
    have hleft : (k*i+k*r)/k = i+r := by
      rw [← Nat.mul_add,Nat.mul_div_right _ hk]
    have hright : (k*j+(t+k*r))/k = j+(t/k+r) := by
      rw [Nat.mul_add_div hk, Nat.add_mul_div_left _ _ hk]
    rwa [hleft,hright] at hh

private theorem recurrence_lower (k : ℕ) (hk : 0 < k) (u : ℕ → Bool) (n : ℕ) :
    (k : ℕ∞) * recurrenceFunction u n ≤ recurrenceFunction (replicated k u) (k*n) := by
  apply le_sInf
  rintro r ⟨N,rfl,hN⟩
  have hd := recurrence_bound_decode k hk u n N hN
  have hle : recurrenceFunction u n ≤ (N/k : ℕ∞) :=
    sInf_le ⟨N/k,rfl,hd⟩
  calc
    _ ≤ (k : ℕ∞)*(N/k : ℕ∞) := mul_le_mul_right hle _
    _ ≤ (N : ℕ∞) := by exact_mod_cast Nat.mul_div_le N k

private theorem recurrence_upper (k : ℕ) (hk : 0 < k) (u : ℕ → Bool) (n : ℕ) :
    recurrenceFunction (replicated k u) n ≤
      (k : ℕ∞)*recurrenceFunction u (n/k+2)+2*k := by
  by_cases he : recurrenceCandidates u (n/k+2) = ∅
  · have ht : recurrenceFunction u (n/k+2) = ⊤ := by
      unfold recurrenceFunction; rw [he,sInf_empty]
    simp [ht,show (k : ℕ∞) ≠ 0 by exact_mod_cast hk.ne']
  · obtain ⟨M,hM,hb⟩ := (csInf_mem (Set.nonempty_iff_ne_empty.mpr he) :
        recurrenceFunction u (n/k+2) ∈ recurrenceCandidates u (n/k+2))
    change recurrenceFunction u (n/k+2) = (M : ℕ∞) at hM
    rw [hM]
    have hb' := recurrence_bound_replicated k hk u n M hb
    have hh : recurrenceFunction (replicated k u) n ≤ (k*M+2*k : ℕ∞) :=
      sInf_le ⟨k*M+2*k,rfl,hb'⟩
    simpa only [Nat.cast_add,Nat.cast_mul, Nat.cast_ofNat] using hh

private theorem recurrence_ratio_lower (k : ℕ) (hk : 0 < k) (u : ℕ → Bool) (n : ℕ) :
    recurrenceRatio u n ≤ recurrenceRatio (replicated k u) (k*n) := by
  by_cases hn : n=0
  · subst n; simp [recurrenceRatio]
  have hkn : k*n ≠ 0 := Nat.mul_ne_zero hk.ne' hn
  simp only [recurrenceRatio,hn,hkn,↓reduceIte]
  have hh := ENat.toENNReal_mono (recurrence_lower k hk u n)
  simp only [ENat.toENNReal_mul,ENat.toENNReal_coe] at hh
  have hdiv := ENNReal.div_le_div_right hh (k*n : ℕ)
  simp only [Nat.cast_mul] at *
  rwa [ENNReal.mul_div_mul_left _ _ (by exact_mod_cast hk.ne') (by simp)] at hdiv

private theorem rhoStar_le_replicated (k : ℕ) (hk : 0 < k) (u : ℕ → Bool) :
    rhoStar u ≤ rhoStar (replicated k u) := by
  unfold rhoStar
  apply le_iInf
  intro N
  apply le_trans (iInf_le _ N)
  apply iSup_le
  intro n
  by_cases hn : N ≤ n
  · rw [if_pos hn]
    have hn' : N ≤ k*n := le_trans hn (Nat.le_mul_of_pos_left n hk)
    exact le_trans (recurrence_ratio_lower k hk u n)
      (le_iSup_of_le (k*n) (by rw [if_pos hn']))
  · rw [if_neg hn]
    exact bot_le

private theorem recurrence_ratio_upper (k : ℕ) (hk : 0 < k) (u : ℕ → Bool)
    (n : ℕ) (hn : n ≠ 0) :
    recurrenceRatio (replicated k u) n ≤
      recurrenceRatio u (n/k+2)*(1+(2*k : ℕ)/(n : ℝ≥0∞))+(2*k : ℕ)/(n : ℝ≥0∞) := by
  have hn0 : (n : ℝ≥0∞) ≠ 0 := Nat.cast_ne_zero.mpr hn
  have hnt : (n : ℝ≥0∞) ≠ ⊤ := ENNReal.natCast_ne_top n
  let m : ℕ := n/k+2
  have hm0 : m ≠ 0 := Nat.succ_ne_zero _
  have hlen : k*m ≤ n+2*k := by
    have hd := Nat.mul_div_le n k
    dsimp [m]
    rw [Nat.mul_add,Nat.mul_two]
    omega
  have hlen' : (k : ℝ≥0∞)*(m : ℝ≥0∞) ≤ (n : ℝ≥0∞)+(2*k : ℕ) := by
    exact_mod_cast hlen
  have hh := ENat.toENNReal_mono (recurrence_upper k hk u n)
  simp only [ENat.toENNReal_add,ENat.toENNReal_mul,ENat.toENNReal_coe,
    ENat.toENNReal_ofNat] at hh
  have hm : recurrenceRatio u m*(m : ℝ≥0∞) = (fun r : ℕ∞ => (r : ℝ≥0∞)) (recurrenceFunction u m) := by
    rw [recurrenceRatio,if_neg hm0]
    exact ENNReal.div_mul_cancel (by exact_mod_cast hm0) (by simp)
  have hb : (n : ℝ≥0∞)*((2*k : ℕ)/(n : ℝ≥0∞)) = (2*k : ℕ) :=
    ENNReal.mul_div_cancel hn0 hnt
  rw [recurrenceRatio,if_neg hn]
  apply (ENNReal.div_le_iff' hn0 hnt).mpr
  calc
    (fun r : ℕ∞ => (r : ℝ≥0∞)) (recurrenceFunction (replicated k u) n)
      ≤ (k : ℝ≥0∞)*(fun r : ℕ∞ => (r : ℝ≥0∞)) (recurrenceFunction u m)+(2*k : ℕ) := by
        simpa [m,Nat.cast_mul] using hh
    _ = recurrenceRatio u m*((k : ℝ≥0∞)*(m : ℝ≥0∞))+(2*k : ℕ) := by
      rw [← hm]; ring
    _ ≤ recurrenceRatio u m*((n : ℝ≥0∞)+(2*k : ℕ))+(2*k : ℕ) :=
      add_le_add (mul_le_mul_right hlen' _) (le_refl _)
    _ = (n : ℝ≥0∞)*(recurrenceRatio u m*(1+(2*k : ℕ)/(n : ℝ≥0∞))+
        (2*k : ℕ)/(n : ℝ≥0∞)) := by
      simp only [mul_add,mul_one,← mul_assoc]
      rw [mul_comm (n : ℝ≥0∞) (recurrenceRatio u m),mul_assoc,hb]

theorem rhoStar_eq_limsup (u : ℕ → Bool) :
    rhoStar u = Filter.limsup (recurrenceRatio u) Filter.atTop := by
  rw [Filter.limsup_eq_iInf_iSup_of_nat]
  unfold rhoStar
  congr 1
  funext N
  apply le_antisymm
  · apply iSup_le
    intro n
    split_ifs with hn
    · exact le_iSup_of_le n (le_iSup_of_le hn (le_refl _))
    · exact bot_le
  · apply iSup_le
    intro n
    apply iSup_le
    intro hn
    exact le_iSup_of_le n (by rw [if_pos hn])

set_option maxHeartbeats 1600000 in

theorem rhoStar_replicated (k : ℕ) (hk : 0 < k) (u : ℕ → Bool) :
    rhoStar (replicated k u) = rhoStar u := by
  apply le_antisymm ?_ (rhoStar_le_replicated k hk u)
  rw [rhoStar_eq_limsup,rhoStar_eq_limsup]
  let B : ℕ → ℝ≥0∞ := fun n => (2*k : ℕ)/(n : ℝ≥0∞)
  let f : ℕ → ℝ≥0∞ := fun n => recurrenceRatio u (n/k+2)
  have hB : Filter.Tendsto B Filter.atTop (nhds 0) := by
    simpa [B,div_eq_mul_inv] using
      (ENNReal.Tendsto.const_mul ENNReal.tendsto_inv_nat_nhds_zero
        (a := ((2*k : ℕ) : ℝ≥0∞)) (Or.inr (ENNReal.natCast_ne_top _)))
  have h1B : Filter.Tendsto (fun n => 1+B n) Filter.atTop (nhds 1) := by
    simpa using Filter.Tendsto.add (tendsto_const_nhds (x := (1 : ℝ≥0∞))) hB
  have hidx : Filter.Tendsto (fun n : ℕ => n/k+2) Filter.atTop Filter.atTop := by
    apply Filter.tendsto_atTop_atTop.mpr
    intro b
    refine ⟨k*b,?_⟩
    intro a ha
    have hd : b ≤ a/k := (Nat.le_div_iff_mul_le hk).mpr (by simpa [Nat.mul_comm] using ha)
    omega
  have hfl : Filter.limsup f Filter.atTop ≤ Filter.limsup (recurrenceRatio u) Filter.atTop :=
    hidx.limsup_comp_le_limsup (u := recurrenceRatio u)
  have hmul : Filter.limsup (fun n => f n*(1+B n)) Filter.atTop ≤
      Filter.limsup f Filter.atTop := by
    have hh := ENNReal.limsup_mul_le' (u := f) (v := fun n => 1+B n)
      (f := Filter.atTop) (Or.inr (by rw [h1B.limsup_eq]; simp))
      (Or.inr (by rw [h1B.limsup_eq]; simp))
    change Filter.limsup (fun n => f n*(1+B n)) Filter.atTop ≤
      Filter.limsup f Filter.atTop * Filter.limsup (fun n => 1+B n) Filter.atTop at hh
    rwa [h1B.limsup_eq,mul_one] at hh
  calc
    Filter.limsup (recurrenceRatio (replicated k u)) Filter.atTop
      ≤ Filter.limsup (fun n => f n*(1+B n)+B n) Filter.atTop := by
        apply Filter.limsup_le_limsup ?_ (by isBoundedDefault) (by isBoundedDefault)
        filter_upwards [Filter.eventually_ge_atTop 1] with n hn
        exact recurrence_ratio_upper k hk u n (by omega)
    _ = Filter.limsup (fun n => f n*(1+B n)) Filter.atTop :=
      ENNReal.limsup_add_of_right_tendsto_zero hB _
    _ ≤ Filter.limsup f Filter.atTop := hmul
    _ ≤ Filter.limsup (recurrenceRatio u) Filter.atTop := hfl

end D5.S1.Words.Complexity.CassaigneRecurrenceTransport
