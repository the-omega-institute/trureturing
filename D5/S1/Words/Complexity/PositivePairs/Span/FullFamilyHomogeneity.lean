   digest: Actual full-family leading differences are homogeneous in their true degree. -/

import D5.S1.Words.Complexity.PositivePairs.Coefficients.PositivePairLeadingCoefficients

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S1.Words.Complexity.PositivePairs.Span.FullFamilyHomogeneity

open D5.S1.Words.Complexity.LyndonBrackets.LyndonBracketAlgebra
open D5.S1.Words.Complexity.PositivePairs.Coefficients.CutoffCoefficientAlgebra
open D5.S1.Words.Complexity.PositivePairs.Coefficients.MagnusWordCoefficients
open D5.S1.Words.Complexity.PositivePairs.Coefficients.PositivePairFiltration
open D5.S1.Words.Complexity.PositivePairs.Coefficients.PositivePairLeadingCoefficients

variable {A : Type*}

def RationalHomogeneous (p : RationalWordPolynomial A) (r : ℕ) : Prop :=
  ∀ w ∈ p.coeff.support, FreeMonoid.length w = r

/-- The actual level-`r` Magnus difference, lifted from its complete degree
cutoff.  Filtration will show that this is exactly its homogeneous lead. -/
noncomputable def actualLeadingDifference [Finite A] (r : ℕ)
    (index : PositivePairIndex A r) : RationalWordPolynomial A :=
  cutoffLift r
    (cutoffMagnus r (positivePairWords r index).1 -
      cutoffMagnus r (positivePairWords r index).2)

/-- The subspace generated by every actual indexed leading difference. -/
noncomputable def fullFamilySpan [Finite A] (r : ℕ) :
    Submodule ℚ (RationalWordPolynomial A) :=
  Submodule.span ℚ (Set.range (actualLeadingDifference (A := A) r))

private theorem actualLeadingDifference_homogeneous [Finite A] (r : ℕ)
    (index : PositivePairIndex A r) :
    RationalHomogeneous (actualLeadingDifference r index) r := by
  classical
  intro w hw
  by_contra hne
  have hcoeff : (actualLeadingDifference r index).coeff w ≠ 0 :=
    Finsupp.mem_support_iff.mp hw
  rcases Nat.lt_or_gt_of_ne hne with hlt | hgt
  · exact hcoeff (by
      have hrestrict : cutoffRestriction r
          (cutoffLift r
            (cutoffMagnus r (positivePairWords r index).1 -
              cutoffMagnus r (positivePairWords r index).2)) =
            cutoffMagnus r (positivePairWords r index).1 -
              cutoffMagnus r (positivePairWords r index).2 := by
        funext z
        simp [cutoffRestriction, cutoffLift,
          Finsupp.mapDomain_apply Subtype.val_injective]
      have hlift := congrFun hrestrict ⟨w, Nat.le_of_lt hlt⟩
      have hcoeffAt : (actualLeadingDifference r index).coeff w =
          (cutoffMagnus r (positivePairWords r index).1 -
            cutoffMagnus r (positivePairWords r index).2)
            ⟨w, Nat.le_of_lt hlt⟩ := by
        change cutoffRestriction r (cutoffLift r _) ⟨w, Nat.le_of_lt hlt⟩ = _
        exact hlift
      rw [hcoeffAt]
      exact (full_positivePair_ratio_filtration r r index).1
        ⟨w, Nat.le_of_lt hlt⟩ hlt)
  · exact hcoeff (by
      simp only [actualLeadingDifference, cutoffLift,
        MonoidAlgebra.coeff_ofCoeff]
      apply Finsupp.mapDomain_of_notMem_range
      rintro ⟨u, rfl⟩
      exact (not_le_of_gt hgt) u.2)

private theorem rationalAbelianization_homogeneous [LinearOrder A]
    (source : List A) :
    RationalHomogeneous (toRationalWordPolynomial (wordAbelianization source)) 1 := by
  classical
  induction source with
  | nil =>
      intro w hw
      simp [wordAbelianization] at hw
  | cons a source ih =>
      have ha : RationalHomogeneous
          (toRationalWordPolynomial (wordMonomial [a])) 1 := by
        intro w hw
        rw [Finsupp.mem_support_iff] at hw
        have hcoeff : (wordMonomial [a]).coeff w ≠ 0 := by
          intro hzero
          exact hw (by simp [toRationalWordPolynomial, hzero])
        have hm := Finsupp.mem_support_iff.mpr hcoeff
        simp [wordMonomial] at hm
        simpa [hm]
      have hadd : RationalHomogeneous
          (toRationalWordPolynomial (wordMonomial [a]) +
            toRationalWordPolynomial (wordAbelianization source)) 1 := by
        intro w hw
        by_cases haw :
            (toRationalWordPolynomial (wordMonomial [a])).coeff w = 0
        · have hsource :
              (toRationalWordPolynomial
                (wordAbelianization source)).coeff w ≠ 0 := by
            intro hzero
            exact (Finsupp.mem_support_iff.mp hw) (by simp [haw, hzero])
          exact ih w (Finsupp.mem_support_iff.mpr hsource)
        · exact ha w (Finsupp.mem_support_iff.mpr haw)
      simpa [wordAbelianization] using hadd

private theorem actualLeadingDifference_one [Finite A] [LinearOrder A]
    (index : PositivePairIndex A 1) :
    actualLeadingDifference 1 index =
      toRationalWordPolynomial (wordMonomial [index 0]) := by
  have hcut :
      cutoffMagnus 1 (positivePairWords 1 index).1 -
          cutoffMagnus 1 (positivePairWords 1 index).2 =
        cutoffRestriction 1
          (toRationalWordPolynomial (wordMonomial [index 0])) := by
    funext w
    simp [positivePairWords, cutoffMagnus, cutoffRestriction,
      magnusPolynomial]
  rw [actualLeadingDifference, hcut]
  have hp : RationalHomogeneous
      (toRationalWordPolynomial (wordMonomial [index 0])) 1 := by
    classical
    intro w hw
    rw [Finsupp.mem_support_iff] at hw
    have hcoeff : (wordMonomial [index 0]).coeff w ≠ 0 := by
      intro hzero
      exact hw (by simp [toRationalWordPolynomial, hzero])
    have hm := Finsupp.mem_support_iff.mpr hcoeff
    simp [wordMonomial] at hm
    simpa [hm]
  apply MonoidAlgebra.coeff_injective
  apply Finsupp.ext
  intro w
  by_cases hw : FreeMonoid.length w ≤ 1
  · have hrestrict : cutoffRestriction 1
        (cutoffLift 1 (cutoffRestriction 1
          (toRationalWordPolynomial (wordMonomial [index 0])))) =
          cutoffRestriction 1
            (toRationalWordPolynomial (wordMonomial [index 0])) := by
      funext z
      simp [cutoffRestriction, cutoffLift,
        Finsupp.mapDomain_apply Subtype.val_injective]
    exact congrFun hrestrict ⟨w, hw⟩
  · have hliftZero :
        (cutoffLift 1
          (cutoffRestriction 1
            (toRationalWordPolynomial (wordMonomial [index 0])))).coeff w = 0 := by
      simp only [cutoffLift, MonoidAlgebra.coeff_ofCoeff]
      apply Finsupp.mapDomain_of_notMem_range
      rintro ⟨u, rfl⟩
      exact hw u.2
    rw [hliftZero]
    symm
    rw [← Finsupp.notMem_support_iff]
    intro hmem
    exact hw (by rw [hp w hmem])

private theorem actualLeadingDifference_successor
    [Finite A] [LinearOrder A] (r : ℕ)
    (index : PositivePairIndex A (r + 2)) :
    let previous := positivePairWords (r + 1) (Fin.init index)
    let a := index (Fin.last (r + 1))
    actualLeadingDifference (r + 2) index =
      ⁅
        (actualLeadingDifference (r + 1) (Fin.init index))
        , toRationalWordPolynomial
          (wordAbelianization previous.2 + wordMonomial [a])⁆ := by
  classical
  let cutoff := r + 2
  let previous := positivePairWords (r + 1) (Fin.init index)
  let a := index (Fin.last (r + 1))
  let c := cutoffMagnus cutoff previous.1 - cutoffMagnus cutoff previous.2
  let p := actualLeadingDifference (r + 1) (Fin.init index)
  let q := toRationalWordPolynomial
    (wordAbelianization previous.2 + wordMonomial [a])
  let x := cutoffRestriction cutoff q
  have hp : RationalHomogeneous p (r + 1) := by
    simpa [p] using actualLeadingDifference_homogeneous (r + 1) (Fin.init index)
  have hq : RationalHomogeneous q 1 := by
    have ha : RationalHomogeneous
        (toRationalWordPolynomial (wordMonomial [a])) 1 := by
      intro w hw
      rw [Finsupp.mem_support_iff] at hw
      have hcoeff : (wordMonomial [a]).coeff w ≠ 0 := by
        intro hzero
        exact hw (by simp [toRationalWordPolynomial, hzero])
      have hm := Finsupp.mem_support_iff.mpr hcoeff
      simp [wordMonomial] at hm
      simpa [hm]
    have hadd : RationalHomogeneous
        (toRationalWordPolynomial (wordAbelianization previous.2) +
          toRationalWordPolynomial (wordMonomial [a])) 1 := by
      intro w hw
      by_cases hab :
          (toRationalWordPolynomial
            (wordAbelianization previous.2)).coeff w = 0
      · have haCoeff :
            (toRationalWordPolynomial (wordMonomial [a])).coeff w ≠ 0 := by
          intro hzero
          exact (Finsupp.mem_support_iff.mp hw) (by simp [hab, hzero])
        exact ha w (Finsupp.mem_support_iff.mpr haCoeff)
      · exact rationalAbelianization_homogeneous previous.2 w
          (Finsupp.mem_support_iff.mpr hab)
    simpa [q] using hadd
  have herror : VanishesBelow cutoff (r + 2)
      (c - cutoffRestriction cutoff p) := by
    intro w hw
    have hw' : FreeMonoid.length w.1 ≤ r + 1 := by omega
    change c w - p.coeff w.1 = 0
    have hrestrict : cutoffRestriction (r + 1)
        (cutoffLift (r + 1)
          (cutoffMagnus (r + 1) (positivePairWords (r + 1) (Fin.init index)).1 -
            cutoffMagnus (r + 1)
              (positivePairWords (r + 1) (Fin.init index)).2)) =
          cutoffMagnus (r + 1) (positivePairWords (r + 1) (Fin.init index)).1 -
            cutoffMagnus (r + 1)
              (positivePairWords (r + 1) (Fin.init index)).2 := by
      funext z
      simp [cutoffRestriction, cutoffLift,
        Finsupp.mapDomain_apply Subtype.val_injective]
    have hlift := congrFun hrestrict ⟨w.1, hw'⟩
    have hcoeffAt : p.coeff w.1 =
        (cutoffMagnus (r + 1)
            (positivePairWords (r + 1) (Fin.init index)).1 -
          cutoffMagnus (r + 1)
            (positivePairWords (r + 1) (Fin.init index)).2) ⟨w.1, hw'⟩ := by
      change cutoffRestriction (r + 1) (cutoffLift (r + 1) _)
        ⟨w.1, hw'⟩ = _
      exact hlift
    rw [hcoeffAt]
    simp [c, previous, cutoffMagnus, cutoffRestriction]
  have hx : VanishesBelow cutoff 1 x := by
    intro w hw
    change q.coeff w.1 = 0
    rw [← Finsupp.notMem_support_iff]
    intro hmem
    exact (Nat.ne_of_lt hw) (hq w.1 hmem)
  have hrightVan := cutoffMul_vanishesBelow cutoff (r + 2) 1
    (c - cutoffRestriction cutoff p) x herror hx
  have hleftVan := cutoffMul_vanishesBelow cutoff 1 (r + 2)
    x (c - cutoffRestriction cutoff p) hx herror
  have hrightZero :
      cutoffMul cutoff (c - cutoffRestriction cutoff p) x = 0 := by
    funext w
    exact hrightVan w (by have := w.2; omega)
  have hleftZero :
      cutoffMul cutoff x (c - cutoffRestriction cutoff p) = 0 := by
    funext w
    exact hleftVan w (by have := w.2; omega)
  have hright : cutoffMul cutoff c x =
      cutoffMul cutoff (cutoffRestriction cutoff p) x := by
    rw [← sub_eq_zero]
    have hdistrib : cutoffMul cutoff c x -
        cutoffMul cutoff (cutoffRestriction cutoff p) x =
          cutoffMul cutoff (c - cutoffRestriction cutoff p) x := by
      funext w
      simp [cutoffMul, Finset.sum_sub_distrib, sub_mul]
    rw [hdistrib, hrightZero]
  have hleft : cutoffMul cutoff x c =
      cutoffMul cutoff x (cutoffRestriction cutoff p) := by
    rw [← sub_eq_zero]
    have hdistrib : cutoffMul cutoff x c -
        cutoffMul cutoff x (cutoffRestriction cutoff p) =
          cutoffMul cutoff x (c - cutoffRestriction cutoff p) := by
      funext w
      simp [cutoffMul, Finset.sum_sub_distrib, mul_sub]
    rw [hdistrib, hleftZero]
  have hsuccessor :
      cutoffMagnus cutoff (positivePairWords cutoff index).1 -
          cutoffMagnus cutoff (positivePairWords cutoff index).2 =
        cutoffMul cutoff c x - cutoffMul cutoff x c := by
    have hqdef : q =
        toRationalWordPolynomial (wordAbelianization previous.2) +
          toRationalWordPolynomial (wordMonomial [a]) := by
      simp [q]
    have hxdef : x = cutoffRestriction cutoff
        (toRationalWordPolynomial (wordAbelianization previous.2) +
          toRationalWordPolynomial (wordMonomial [a])) := by
      change cutoffRestriction cutoff q = _
      rw [hqdef]
    rw [hxdef]
    simpa [cutoff, previous, a, c] using
      full_positivePair_successor_leading_bracket r index
  have hcutoff :
      cutoffMagnus cutoff (positivePairWords cutoff index).1 -
          cutoffMagnus cutoff (positivePairWords cutoff index).2 =
        cutoffRestriction cutoff ⁅p, q⁆ := by
    rw [hsuccessor, hright, hleft]
    funext w
    rw [Pi.sub_apply, ← cutoffRestriction_mul, ← cutoffRestriction_mul]
    rfl
  have hcomm : RationalHomogeneous ⁅p, q⁆ cutoff := by
    have hmul {f g : RationalWordPolynomial A} {i j : ℕ}
        (hf : RationalHomogeneous f i) (hg : RationalHomogeneous g j) :
        RationalHomogeneous (f * g) (i + j) := by
      intro w hw
      have hsubset := MonoidAlgebra.support_coeff_mul_subset f g hw
      rcases Finset.mem_mul.mp hsubset with ⟨u, hu, v, hv, huv⟩
      rw [← huv, FreeMonoid.length_mul, hf u hu, hg v hv]
    have hneg {f : RationalWordPolynomial A} {i : ℕ}
        (hf : RationalHomogeneous f i) : RationalHomogeneous (-f) i := by
      intro w hw
      apply hf w
      rw [Finsupp.mem_support_iff] at hw ⊢
      simpa using hw
    have hadd {f g : RationalWordPolynomial A} {i : ℕ}
        (hf : RationalHomogeneous f i) (hg : RationalHomogeneous g i) :
        RationalHomogeneous (f + g) i := by
      intro w hw
      by_cases hfw : f.coeff w = 0
      · have hgw : g.coeff w ≠ 0 := by
          intro hzero
          exact (Finsupp.mem_support_iff.mp hw) (by simp [hfw, hzero])
        exact hg w (Finsupp.mem_support_iff.mpr hgw)
      · exact hf w (Finsupp.mem_support_iff.mpr hfw)
    have hqp : RationalHomogeneous (q * p) (r + 1 + 1) := by
      simpa [Nat.add_comm] using hmul hq hp
    simpa [cutoff, Ring.lie_def, sub_eq_add_neg] using
      hadd (hmul hp hq) (hneg hqp)
  change cutoffLift cutoff
      (cutoffMagnus cutoff (positivePairWords cutoff index).1 -
        cutoffMagnus cutoff (positivePairWords cutoff index).2) = _
  rw [hcutoff]
  apply MonoidAlgebra.coeff_injective
  apply Finsupp.ext
  intro w
  by_cases hw : FreeMonoid.length w ≤ cutoff
  · have hrestrict : cutoffRestriction cutoff
        (cutoffLift cutoff (cutoffRestriction cutoff ⁅p, q⁆)) =
          cutoffRestriction cutoff ⁅p, q⁆ := by
      funext z
      simp [cutoffRestriction, cutoffLift,
        Finsupp.mapDomain_apply Subtype.val_injective]
    exact congrFun hrestrict ⟨w, hw⟩
  · have hliftZero :
        (cutoffLift cutoff
          (cutoffRestriction cutoff ⁅p, q⁆)).coeff w = 0 := by
      simp only [cutoffLift, MonoidAlgebra.coeff_ofCoeff]
      apply Finsupp.mapDomain_of_notMem_range
      rintro ⟨u, rfl⟩
      exact hw u.2
    rw [hliftZero]
    symm
    rw [← Finsupp.notMem_support_iff]
    intro hmem
    exact hw (by rw [hcomm w hmem])


