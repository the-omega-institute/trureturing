import D5.S1.Words.Palindromes.FridPrefix.EndpointAutomaton
import D5.S1.Words.Palindromes.FridPrefix.RankAutomata

namespace D5.S1.Words.FridPrefix

/-- Membership in grouped reachable third coordinates. -/
def rawMember (raw : Array (Array (List ℕ))) (q p s : ℕ) : Bool :=
  ((raw.getD q #[]).getD p []).contains s

/-- Membership in a bit mask of co-accessible third coordinates. -/
def coreMember (core : Array (Array ℕ)) (q p s : ℕ) : Bool :=
  ((core.getD q #[]).getD p 0).testBit s

/-- Decode the three-bit integral potential at a grouped product coordinate. -/
def potential (digits : Array (Array ℕ)) (q p s : ℕ) : ℤ :=
  ((((digits.getD q #[]).getD p 0 >>> (3*s)) % 8 : ℕ) : ℤ)-2

/-- The chunk moves are exactly those generated by the endpoint transition relation. -/
def movesCheck (width : ℕ) (moves : Array (Array (ℕ × ℕ × ℕ))) : Bool :=
  moves.size == 17 &&
  (List.range 17).all (fun q =>
    let generated := movesFrom q width
    generated.all (fun t => (moves[q]!).contains t) &&
    (moves[q]!).all (fun t => generated.contains t))

def isAccept (q : ℕ) : Bool := decide (q ∈ [3,9,11])

/-- Check forward closure, backward potential inequalities and the terminal cap. -/
def rowCheck (rank : ChunkRank) (moves : Array (Array (ℕ × ℕ × ℕ)))
    (raw : Array (Array (List ℕ))) (core digits : Array (Array ℕ)) (q p s : ℕ) : Bool :=
  (if isAccept q then coreMember core q p s && decide (potential digits q p s ≤ 1)
    else true) &&
  (moves[q]!).all (fun (x,y,t) =>
    let p1 := (rank.transitions.getD p #[]).getD x 0
    let s1 := (rank.transitions.getD s #[]).getD y 0
    let gain := (rank.weights.getD s #[]).getD y 0 - (rank.weights.getD p #[]).getD x 0
    rawMember raw t p1 s1 &&
    (if coreMember core t p1 s1 then coreMember core q p s &&
      decide (potential digits q p s+gain ≤ potential digits t p1 s1) else true))

/-- One endpoint-state block checks every reachable pair of rank states. -/
def groupCheck (rank : ChunkRank) (moves : Array (Array (ℕ × ℕ × ℕ)))
    (raw : Array (Array (List ℕ))) (core digits : Array (Array ℕ)) (q : ℕ) : Bool :=
  (List.range rank.transitions.size).all (fun p =>
    ((raw.getD q #[]).getD p []).all (fun s => rowCheck rank moves raw core digits q p s))

end D5.S1.Words.FridPrefix
