    let t := (baseTable e.1).1
    (e.1, row.2.1 || (s[14]?.getD 0 == 0 && t[10]?.getD 0 == 0 && t[12]?.getD 0 != 0),
      e.2.1, e.2.2.1, e.2.2.2.1, e.2.2.2.2)

private def terminal (i : ℕ) : Bool :=
  let row := minimumTable i
  let s := (baseTable row.1).1
  row.2.1 && baseTerminal s && (s[18]?.getD 0 == 0)

private def rowCheck (i : ℕ) : Bool :=
  let row := minimumTable i
  let actual := row.2.2.1.map fun e =>
    let t := minimumTable e.1
    (t.1, t.2.1, e.2.1, e.2.2.1, e.2.2.2.1, e.2.2.2.2)
  let expected := successors i
  let transitions := row.1 < 1492 && expected.all actual.contains &&
    actual.all expected.contains && row.2.2.1.all (fun e => e.1 < 1710)
  let sources := if i < 7 then
    (row.1 == i) && (row.2.1 == false) &&
      (match row.2.2.2 with | none => true | some V => decide (0 ≤ V))
    else true
  let goals := if terminal i then
    match row.2.2.2 with | none => false | some V => V ≤ 0
    else true
  let edges := row.2.2.1.all fun e =>
    match (minimumTable e.1).2.2.2 with
    | none => true
    | some W =>
      match row.2.2.2 with
      | none => false
      | some V => V + e.2.1 ≤ W
  transitions && sources && goals && edges

private def blockCheck (start count : ℕ) : Bool :=
  (List.range count).all fun k => rowCheck (start + k)

/-- Every listed edge carries f, q, and its two actual input bits. -/
def minimumAutomaton : NFA (ℤ × ℤ × ℤ × ℤ) (Fin 1710) where
  start := {i | i.val < 7}
  step i a := {j | (j.val, a) ∈ (minimumTable i.val).2.2.1}
  accept := {i | terminal i.val}

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- The complete lowest-position-escape graph has accepted weight at most zero. -/
theorem minimum_accepted_bound
    {s t : Fin 1710} {xs : List (ℤ × ℤ × ℤ × ℤ)}
    (hs : s ∈ minimumAutomaton.start) (ht : t ∈ minimumAutomaton.accept)
    (p : minimumAutomaton.Path s t xs) : pathCharge (fun _ a _ => a.1) p ≤ 0 := by
  have checked (i : ℕ) (hi : i < 1710) : rowCheck i = true := by
    have blocks : ∀ b : Fin 27,
        blockCheck (64 * b.val) (min 64 (1710 - 64 * b.val)) = true := by
      intro b
      fin_cases b
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
      · decide
    have hb := blocks ⟨i / 64, by omega⟩
    simp only [blockCheck] at hb
    have hrem : i % 64 < min 64 (1710 - 64 * (i / 64)) := by omega
    have hr := List.all_eq_true.mp hb (i % 64) (List.mem_range.mpr hrem)
    have he : 64 * (i / 64) + i % 64 = i := by omega
    simpa only [he] using hr
  let V : Fin 1710 → Option ℤ := fun i => (minimumTable i.val).2.2.2
  have bound := accepted_path_bound_partial minimumAutomaton (fun _ a _ => a.1)
    V (fun _ => 0) 0
  suffices h : pathCharge (fun _ a _ => a.1) p + 0 ≤ 0 by simpa using h
  apply bound ?_ ?_ ?_ hs ht p
  · intro i hi A hA
    have hr := checked i.val i.isLt
    simp only [rowCheck, Bool.and_eq_true] at hr
    have hsrc := hr.1.1.2
    simp only [minimumAutomaton, Set.mem_setOf_eq] at hi
    simp only [hi, ↓reduceIte] at hsrc
    dsimp [V] at hA
    simp only [hA] at hsrc
    have hx : ((minimumTable i.val).1 = i.val ∧ (minimumTable i.val).2.1 = false) ∧
        0 ≤ A := by
      simpa only [Bool.and_eq_true, beq_iff_eq, decide_eq_true_eq] using hsrc
    exact hx.2
  · intro i j a hij A hA
    have hr := checked i.val i.isLt
    simp only [rowCheck, Bool.and_eq_true] at hr
    have he := List.all_eq_true.mp hr.2 (j.val, a) hij
    dsimp [V] at hA
    simp only [hA] at he
    cases hV : V i with
    | none =>
      dsimp [V] at hV
      simp only [hV] at he
      contradiction
    | some B =>
      refine ⟨B, rfl, ?_⟩
      dsimp [V] at hV
      simp only [hV] at he
      exact of_decide_eq_true he
  · intro i hi
    have hr := checked i.val i.isLt
    simp only [rowCheck, Bool.and_eq_true] at hr
    have hgoal := hr.1.2
    simp only [minimumAutomaton, Set.mem_setOf_eq] at hi
    simp only [hi, ↓reduceIte] at hgoal
    cases hV : V i with
    | none =>
      dsimp [V] at hV
      simp only [hV] at hgoal
      contradiction
    | some A =>
      refine ⟨A, rfl, ?_⟩
      dsimp [V] at hV
      simp only [hV] at hgoal
      simpa using of_decide_eq_true hgoal

end D5.S1.Words.Palindromes.PeriodDoubling.MinimumPositionCertificate

