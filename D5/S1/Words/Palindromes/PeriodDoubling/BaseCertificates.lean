private def sourceIds : List ℕ := [0, 1, 2, 3, 4, 5, 6]
private def baseRowCheck (i : ℕ) (charge : Bool) : Bool :=
  let row := baseTable i
  let state := row.1
  let edges := row.2.1
  let potential := if charge then row.2.2.2 else row.2.2.1
  let actual := edges.map fun edge =>
    ((baseTable edge.1).1,
      edge.2.1, edge.2.2.1, edge.2.2.2.1, edge.2.2.2.2)
  let expected := baseSuccessors state
  let transitions := expected.all actual.contains && actual.all expected.contains &&
    edges.all (fun edge => edge.1 < 1492)
  let goals := if baseTerminal state &&
      (state[18]?.getD 0 == if charge then 0 else 1) then
    match potential with
    | none => false
    | some V => V + (if charge then baseOffset state else 0) ≤ if charge then 3 else 0
    else true
  let sources := if sourceIds.contains i then
    initialStates.contains state &&
      (match potential with | none => true | some V => 0 ≤ V)
    else true
  let inequalities := edges.all fun edge =>
    let target := baseTable edge.1
    let targetPotential := if charge then target.2.2.2 else target.2.2.1
    match targetPotential with
    | none => true
    | some W =>
      match potential with
      | none => false
      | some V => V + (if charge then 3 else 1) * edge.2.1 +
          (if charge then edge.2.2.1 else 0) ≤ W
  transitions && goals && sources && inequalities

private def baseBlockCheck (start count : ℕ) (charge : Bool) : Bool :=
  (List.range count).all fun k => baseRowCheck (start + k) charge


/-- Both certificates use this same fully listed graph, with different terminal tests. -/
def baseAutomaton (charge : Bool) : NFA (ℤ × ℤ × ℤ × ℤ) (Fin 1492) where
  start := {i | sourceIds.contains i.val}
  step i a := {j | (j.val, a) ∈ (baseTable i.val).2.1}
  accept := {i | baseTerminal (baseTable i.val).1 &&
    ((baseTable i.val).1[18]?.getD 0 == if charge then 0 else 1)}

/-- Every accepted run obeys the concrete zero or three potential bound. -/
theorem base_accepted_bound (charge : Bool)
    {s t : Fin 1492} {xs : List (ℤ × ℤ × ℤ × ℤ)}
    (hs : s ∈ (baseAutomaton charge).start)
    (ht : t ∈ (baseAutomaton charge).accept)
    (p : (baseAutomaton charge).Path s t xs) :
    pathCharge (fun _ a _ => (if charge then 3 else 1) * a.1 +
      (if charge then a.2.1 else 0)) p +
        (if charge then baseOffset (baseTable t.val).1 else 0) ≤
          if charge then 3 else 0 := by
  have checked (i : ℕ) (hi : i < 1492) : baseRowCheck i charge = true := by
    have blocks : ∀ b : Fin 24,
        baseBlockCheck (64 * b.val) (min 64 (1492 - 64 * b.val)) charge = true := by
      intro b
      fin_cases b
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
    have hb := blocks ⟨i / 64, by omega⟩
    simp only [baseBlockCheck] at hb
    have hrem : i % 64 < min 64 (1492 - 64 * (i / 64)) := by omega
    have hr := List.all_eq_true.mp hb (i % 64) (List.mem_range.mpr hrem)
    have he : 64 * (i / 64) + i % 64 = i := by omega
    simpa only [he] using hr
  let V : Fin 1492 → Option ℤ := fun i =>
    if charge then (baseTable i.val).2.2.2 else (baseTable i.val).2.2.1
  apply accepted_path_bound_partial (baseAutomaton charge)
    (fun _ a _ => (if charge then 3 else 1) * a.1 + (if charge then a.2.1 else 0))
    V (fun t => if charge then baseOffset (baseTable t.val).1 else 0)
    (if charge then 3 else 0) ?_ ?_ ?_ hs ht p
  · intro i hi A hA
    have hr := checked i.val i.isLt
    simp only [baseRowCheck, Bool.and_eq_true] at hr
    have hsrc := hr.1.2
    simp only [baseAutomaton, Set.mem_setOf_eq] at hi
    simp only [hi, ↓reduceIte] at hsrc
    dsimp [V] at hA
    simp only [hA] at hsrc
    have hx : initialStates.contains (baseTable i.val).1 = true ∧ 0 ≤ A := by
      simpa only [Bool.and_eq_true, decide_eq_true_eq] using hsrc
    exact hx.2
  · intro i j a hij A hA
    have hr := checked i.val i.isLt
    simp only [baseRowCheck, Bool.and_eq_true] at hr
    have hedges := hr.2
    have he := List.all_eq_true.mp hedges (j.val, a) hij
    dsimp [V] at hA
    simp only [hA] at he
    cases hV : V i with
    | none =>
      dsimp [V] at hV
      simp only [hV] at he
      contradiction
    | some B =>
      refine ⟨B, rfl, ?_⟩
      dsimp [V] at hV
      simp only [hV] at he
      have he' := of_decide_eq_true he
      omega
  · intro i hi
    have hr := checked i.val i.isLt
    simp only [baseRowCheck, Bool.and_eq_true] at hr
    have hgoal := hr.1.1.2
    simp only [baseAutomaton, Set.mem_setOf_eq] at hi
    simp only [Bool.and_eq_true] at hi
    simp only [hi, ↓reduceIte] at hgoal
    cases hV : V i with
    | none =>
      dsimp [V] at hV
      simp only [hV] at hgoal
      contradiction
    | some A =>
      refine ⟨A, rfl, ?_⟩
      dsimp [V] at hV
      simp only [hV] at hgoal
      exact of_decide_eq_true hgoal

