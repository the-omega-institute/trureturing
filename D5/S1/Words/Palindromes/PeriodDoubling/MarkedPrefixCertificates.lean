      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide
      · cases charge <;> decide

    have hb := blocks ⟨i / 64, by omega⟩
    simp only [blockCheck] at hb
    have hrem : i % 64 < min 64 (4262 - 64 * (i / 64)) := by omega
    have hr := List.all_eq_true.mp hb (i % 64) (List.mem_range.mpr hrem)
    have he : 64 * (i / 64) + i % 64 = i := by omega
    simpa only [he] using hr
  let V : Fin 4262 → Option ℤ := fun i =>
    if charge then (prefixTable i.val).2.2.2 else (prefixTable i.val).2.2.1
  apply accepted_path_bound_partial (prefixAutomaton charge)
    (fun _ a _ => (if charge then 5 else 1) * a.1 + (if charge then a.2.1 else 0))
    V (fun t => if charge then prefixOffset (prefixTable t.val).1 else 0)
    (if charge then 5 else 0) ?_ ?_ ?_ hs ht p
  · intro i hi A hA
    have hr := checked i.val i.isLt
    simp only [rowCheck, Bool.and_eq_true] at hr
    have hsrc := hr.1.2
    simp only [prefixAutomaton, Set.mem_ofPred_eq] at hi
    simp only [hi, ↓reduceIte] at hsrc
    dsimp [V] at hA
    simp only [hA] at hsrc
    have hx : initialStates.contains (prefixTable i.val).1 = true ∧ 0 ≤ A := by
      simpa only [Bool.and_eq_true, decide_eq_true_eq] using hsrc
    exact hx.2
  · intro i j a hij A hA
    have hr := checked i.val i.isLt
    simp only [rowCheck, Bool.and_eq_true] at hr
    have he := List.all_eq_true.mp hr.2 (j.val, a) hij
    dsimp [V] at hA
    simp only [hA] at he
    cases hV : V i with
    | none =>
      dsimp [V] at hV
      simp only [hV] at he
      contradiction
    | some B =>
      refine ⟨B, rfl, ?_⟩
      dsimp [V] at hV
      simp only [hV] at he
      have he' := of_decide_eq_true he
      omega
  · intro i hi
    have hr := checked i.val i.isLt
    simp only [rowCheck, Bool.and_eq_true] at hr
    have hgoal := hr.1.1.2
    simp only [prefixAutomaton, Set.mem_ofPred_eq, Bool.and_eq_true] at hi
    simp only [hi] at hgoal
    cases hV : V i with
    | none =>
      dsimp [V] at hV
      simp only [hV] at hgoal
      contradiction
    | some A =>
      refine ⟨A, rfl, ?_⟩
      dsimp [V] at hV
      simp only [hV] at hgoal
      exact of_decide_eq_true hgoal

