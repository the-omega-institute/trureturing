def nextMarker (full : List ℤ) (e : ℕ × ℤ × ℤ × ℤ × ℤ) :
    List (List ℤ × ℤ × ℤ × ℤ × ℤ) :=
  let s := (baseTable (full[0]?.getD 0).toNat).1
  let ns := (baseTable e.1).1
  let nd := ns[10]?.getD 0
  let jd := ns[12]?.getD 0
  let m := full[1]?.getD 0
  let flip := full[2]?.getD 0 != 0
  let parity := full[3]?.getD 0
  let keep := full[4]?.getD 0
  let ni := full[5]?.getD 0
  let nj := full[6]?.getD 0
  let bad := full[7]?.getD 0 != 0
  let finish := fun (state : List ℤ) => (state, e.2.1, e.2.2.1, e.2.2.2.1, e.2.2.2.2)
  if ns[18]?.getD 0 != 0 then [] else
  if m = 0 then
    let unmarked := finish [e.1,0,Bool.toNat (flip && nd + jd == 0),0,0,0,0,0]
    if nd = 1 ∧ s[10]?.getD 0 = 0 ∧ s[11]?.getD 0 = 0 then
      let an := s[16]?.getD 0 < 0 || (s[16]?.getD 0 == 0 && s[2]?.getD 0 == 1)
      let aj := s[17]?.getD 0 < 0 || (s[17]?.getD 0 == 0 && s[3]?.getD 0 == 1)
      let kp := jd == 1
      let bd := s[12]?.getD 0 != 0 || s[13]?.getD 0 != 0 ||
        (jd != 0 && jd != 1) || (!kp && (!an || aj || !flip))
      [unmarked, finish [e.1,1,Bool.toNat flip,s[1]?.getD 0,
        Bool.toNat kp,Bool.toNat an,Bool.toNat aj,Bool.toNat bd]]
    else [unmarked]
  else if m = 1 ∨ m = 2 then
    if nd != 0 then [] else
    [finish [e.1,m + 1,Bool.toNat flip,parity,keep,ni,nj,Bool.toNat (bad || nd != jd)]]
  else if m = 3 then
    if nd != 0 && nd != 1 then [] else
    [finish [e.1,(if nd = 1 then 1 else 4),Bool.toNat flip,parity,keep,ni,nj,
      Bool.toNat (bad || nd != jd)]]
  else if nd != 0 then [] else
    [finish [e.1,4,Bool.toNat flip,parity,keep,ni,nj,Bool.toNat (bad || nd != jd)]]

def successors (full : List ℤ) : List (List ℤ × ℤ × ℤ × ℤ × ℤ) :=
  (baseTable (full[0]?.getD 0).toNat).2.1.flatMap (nextMarker full)

/-- The indexed marker table contains every literal successor and valid target indices. -/
def prefixRealizationRowCheck (i : ℕ) : Bool :=
  let row:=prefixTable i
  let actual:=row.2.1.map fun e => ((prefixTable e.1).1,e.2)
  (successors row.1).all actual.contains && row.2.1.all (fun e => decide (e.1 < 4262))

/-- A bounded window of the literal reconstruction checker. -/
def prefixRealizationBlockCheck (start count : ℕ) : Bool :=
  (List.range count).all fun k => prefixRealizationRowCheck (start+k)

private def terminal (full : List ℤ) : Bool :=
  full[1]?.getD 0 == 4 && baseTerminal (baseTable (full[0]?.getD 0).toNat).1

/-- Charge correction for a retained or removed lowest marked digit. -/
def prefixOffset (full : List ℤ) : ℤ :=
  let w := 1 + 2 * full[3]?.getD 0
  baseOffset (baseTable (full[0]?.getD 0).toNat).1 +
    (if full[4]?.getD 0 != 0 then
      (w - 1) * (full[6]?.getD 0 - full[5]?.getD 0) else w + 1)

private def initialStates : List (List ℤ) :=
  [[1,0,1,0,0,0,0,0],[2,0,1,0,0,0,0,0],[3,0,1,0,0,0,0,0],
    [4,0,1,0,0,0,0,0],[5,0,1,0,0,0,0,0]]

private def rowCheck (i : ℕ) (charge : Bool) : Bool :=
  let row := prefixTable i
  let state := row.1
  let edges := row.2.1
  let potential := if charge then row.2.2.2 else row.2.2.1
  let actual := edges.map fun edge =>
    ((prefixTable edge.1).1,
      edge.2.1, edge.2.2.1, edge.2.2.2.1, edge.2.2.2.2)
  let expected := successors state
  let transitions := expected.all actual.contains && actual.all expected.contains &&
    edges.all (fun edge => edge.1 < 4262)
  let goals := if terminal state &&
      (state[7]?.getD 0 == if charge then 0 else 1) then
    match potential with
    | none => false
    | some V => V + (if charge then prefixOffset state else 0) ≤ if charge then 5 else 0
    else true
  let sources := if i < 5 then
    initialStates.contains state &&
      (match potential with | none => true | some V => 0 ≤ V)
    else true
  let inequalities := edges.all fun edge =>
    let target := prefixTable edge.1
    let targetPotential := if charge then target.2.2.2 else target.2.2.1
    match targetPotential with
    | none => true
    | some W =>
      match potential with
      | none => false
      | some V => V + (if charge then 5 else 1) * edge.2.1 +
          (if charge then edge.2.2.1 else 0) ≤ W
  transitions && goals && sources && inequalities

private def blockCheck (start count : ℕ) (charge : Bool) : Bool :=
  (List.range count).all fun k => rowCheck (start + k) charge

/-- Both marker certificates use the full product graph and different final flags. -/
def prefixAutomaton (charge : Bool) : NFA (ℤ × ℤ × ℤ × ℤ) (Fin 4262) where
  start := {i | i.val < 5}
  step i a := {j | (j.val, a) ∈ (prefixTable i.val).2.1}
  accept := {i | terminal (prefixTable i.val).1 &&
    ((prefixTable i.val).1[7]?.getD 0 == if charge then 0 else 1)}

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
/-- Exact finite certificates bound arbitrary accepted marker-product paths. -/
theorem prefix_accepted_bound (charge : Bool)
    {s t : Fin 4262} {xs : List (ℤ × ℤ × ℤ × ℤ)}
    (hs : s ∈ (prefixAutomaton charge).start)
    (ht : t ∈ (prefixAutomaton charge).accept)
    (p : (prefixAutomaton charge).Path s t xs) :
    pathCharge (fun _ a _ => (if charge then 5 else 1) * a.1 +
      (if charge then a.2.1 else 0)) p +
        (if charge then prefixOffset (prefixTable t.val).1 else 0) ≤
          if charge then 5 else 0 := by
  have checked (i : ℕ) (hi : i < 4262) : rowCheck i charge = true := by
    have blocks : ∀ b : Fin 67,
        blockCheck (64 * b.val) (min 64 (4262 - 64 * b.val)) charge = true := by
      intro b
      fin_cases b
      · cases charge <;> decide
      · cases charge <;> decide
