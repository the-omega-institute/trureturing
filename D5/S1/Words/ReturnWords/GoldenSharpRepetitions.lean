private theorem gaps_two_of_return_sum_le (a : ℝ) {N : ℕ}
    (h2 : 2 ≤ orbitCard a N) (hsum : mPlus a N h2 + mMinus a N h2 ≤ N)
    {x : ℝ} (hx : x ∈ gaps a N) : x = etaPos a N ∨ x = etaNeg a N := by
  rw [mem_gaps_iff] at hx
  rcases hx with ⟨i,hi,hx⟩ | hx
  · have hi' : i+1 < orbitCard a N := by omega
    have hv := sortedVal_mem a (by omega : i < orbitCard a N)
    have hv' := sortedVal_mem a hi'
    by_cases hA : canMul a N (sortedVal a N i) hv + mPlus a N h2 < N
    · left
      rw [← hx]
      exact gap_eq_etaPos a h2 hi' (fract_canMul a N hv) hA
    · have hB : canMul a N (sortedVal a N (i+1)) hv' + mMinus a N h2 < N := by
        by_contra hnB
        have hlt := corner_canMul_lt_mMinus a h2 hi' hv hv' hnB
        omega
      right
      rw [← hx]
      exact gap_eq_etaNeg a h2 hi' (fract_canMul a N hv') hB
  · right
    rw [hx,wraparound_eq_etaNeg a h2]

theorem orbitCard_eq_of_irrational (a : ℝ) (ha : Irrational a) (N : ℕ) : orbitCard a N = N := by
  classical
  by_cases hN : N = 0
  · subst N; simp [orbitCard, orbit]
  have hc := rotation_cut_set_card (-a) N ha.neg (Nat.pos_of_ne_zero hN)
  have ho : (orbit a N).card ≤ N := by
    exact (Finset.card_image_le).trans_eq (Finset.card_range N)
  have hi : (insert 1 (orbit a N)).card ≤ (orbit a N).card + 1 := Finset.card_insert_le _ _
  have he : (insert 1 (orbit a N)).card = N + 1 := by
    simpa only [rotationCutSet, D5.S1.Recurrence.RotationOrbitGapsPartition.rotationOrbit, neg_neg, orbit] using hc
  change (orbit a N).card = N
  omega

private theorem etaPos_eq_of_records (a : ℝ) {N p : ℕ} {e : ℝ}
    (h2 : 2 ≤ orbitCard a N) (hpN : p < N)
    (he : 0 < e) (hpe : Int.fract ((p : ℝ)*a) = e)
    (hmin : ∀ k, 0 < k → k < N → e ≤ Int.fract ((k : ℝ)*a)) :
    etaPos a N = e := by
  apply le_antisymm
  · apply no_orbit_below_etaPos a h2
    · exact (mem_orbit_iff a N e).mpr ⟨p,hpN,hpe⟩
    · exact he
  · have hm := posOrbit_subset_orbit a N (etaPos_mem a h2)
    obtain ⟨k,hk,heq⟩ := (mem_orbit_iff a N _).mp hm
    have hk0 : 0 < k := by
      by_contra hh
      have : k = 0 := by omega
      subst k
      simp at heq
      exact (ne_of_gt (etaPos_pos a h2)) heq.symm
    simpa [heq] using hmin k hk0 hk

private theorem etaNeg_eq_of_records (a : ℝ) {N p : ℕ} {e : ℝ}
    (h2 : 2 ≤ orbitCard a N) (hpN : p < N)
    (he : e < 1) (hpe : Int.fract ((p : ℝ)*a) = 1-e)
    (hmin : ∀ k, 0 < k → k < N → e ≤ 1-Int.fract ((k : ℝ)*a)) :
    etaNeg a N = e := by
  apply le_antisymm
  · have hh := le_one_sub_etaNeg a h2
      (x := 1-e) ((mem_posOrbit_iff a N _).mpr
        ⟨by linarith,(mem_orbit_iff a N _).mpr ⟨p,hpN,hpe⟩⟩)
    linarith
  · have hm := max_posOrbit_mem a h2
    obtain ⟨k,hk,heq⟩ := (mem_orbit_iff a N _).mp (posOrbit_subset_orbit a N hm)
    have hk0 : 0 < k := by
      by_contra hh
      have : k = 0 := by omega
      subst k
      have hpos := posOrbit_pos a N hm
      simp at heq
      linarith
    have hh := hmin k hk0 hk
    rw [heq] at hh
    linarith

theorem fract_fib_odd (q : ℕ) (hq : Odd q) :
    Int.fract ((Nat.fib q : ℝ)*Real.goldenRatio) = Real.goldenRatio⁻¹^q := by
  rw [fract_fib_mul_goldenRatio q hq,show Real.goldenConj = -Real.goldenRatio⁻¹ from
    neg_eq_iff_eq_neg.mp Real.inv_goldenRatio.symm,hq.neg_pow]
  ring

theorem fract_fib_even (q : ℕ) (hq : Even q) :
    Int.fract ((Nat.fib q : ℝ)*Real.goldenRatio) = 1-Real.goldenRatio⁻¹^q := by
  rw [fract_fib_mul_goldenRatio_of_even q hq,show Real.goldenConj = -Real.goldenRatio⁻¹ from
    neg_eq_iff_eq_neg.mp Real.inv_goldenRatio.symm,hq.neg_pow]

theorem golden_eta_odd (q : ℕ) (hq : 2 ≤ q) (ho : Odd q) :
    etaPos Real.goldenRatio (Nat.fib (q+2)) = Real.goldenRatio⁻¹^q ∧
    etaNeg Real.goldenRatio (Nat.fib (q+2)) = Real.goldenRatio⁻¹^(q+1) := by
  have h2 : 2 ≤ orbitCard Real.goldenRatio (Nat.fib (q+2)) := by
    rw [orbitCard_eq_of_irrational _ Real.goldenRatio_irrational]
    have h := Nat.fib_mono (show 3 ≤ q+2 by omega)
    norm_num at h
    omega
  have hqN : Nat.fib q < Nat.fib (q+2) := (Nat.fib_lt_fib hq).mpr (by omega)
  have hq1N : Nat.fib (q+1) < Nat.fib (q+2) := Nat.fib_lt_fib_succ (by omega)
  have hrec := D5.S1.Words.FibonacciMapFirstStart.fibonacci_one_sided_records q hq
  have hrec1 := D5.S1.Words.FibonacciMapFirstStart.fibonacci_one_sided_records (q+1) (by omega)
  constructor
  · exact etaPos_eq_of_records _ h2 hqN
      (pow_pos (inv_pos.mpr Real.goldenRatio_pos) _) (fract_fib_odd q ho) (hrec.1 ho)
  · apply etaNeg_eq_of_records _ h2 hq1N
      (pow_lt_one₀ (inv_nonneg.mpr Real.goldenRatio_pos.le)
        (inv_lt_one_of_one_lt₀ Real.one_lt_goldenRatio) (by omega : q+1 ≠ 0))
      (fract_fib_even (q+1) ho.add_one)
    intro k hk hkN
    exact hrec1.2 ho.add_one k hk (hkN.trans_le (Nat.fib_mono (by omega)))

theorem golden_eta_even (q : ℕ) (hq : 2 ≤ q) (he : Even q) :
    etaPos Real.goldenRatio (Nat.fib (q+2)) = Real.goldenRatio⁻¹^(q+1) ∧
    etaNeg Real.goldenRatio (Nat.fib (q+2)) = Real.goldenRatio⁻¹^q := by
  have h2 : 2 ≤ orbitCard Real.goldenRatio (Nat.fib (q+2)) := by
    rw [orbitCard_eq_of_irrational _ Real.goldenRatio_irrational]
    have h := Nat.fib_mono (show 3 ≤ q+2 by omega)
    norm_num at h
    omega
  have hqN : Nat.fib q < Nat.fib (q+2) := (Nat.fib_lt_fib hq).mpr (by omega)
  have hq1N : Nat.fib (q+1) < Nat.fib (q+2) := Nat.fib_lt_fib_succ (by omega)
  have hrec := D5.S1.Words.FibonacciMapFirstStart.fibonacci_one_sided_records q hq
  have hrec1 := D5.S1.Words.FibonacciMapFirstStart.fibonacci_one_sided_records (q+1) (by omega)
  constructor
  · apply etaPos_eq_of_records _ h2 hq1N
      (pow_pos (inv_pos.mpr Real.goldenRatio_pos) _) (fract_fib_odd (q+1) he.add_one)
    intro k hk hkN
    exact hrec1.1 he.add_one k hk (hkN.trans_le (Nat.fib_mono (by omega)))
  · exact etaNeg_eq_of_records _ h2 hqN
      (pow_lt_one₀ (inv_nonneg.mpr Real.goldenRatio_pos.le)
        (inv_lt_one_of_one_lt₀ Real.one_lt_goldenRatio) (by omega : q ≠ 0))
      (fract_fib_even q he) (hrec.2 he)

private theorem golden_return_sum_le (q : ℕ) (hq : 2 ≤ q)
    (h2 : 2 ≤ orbitCard Real.goldenRatio (Nat.fib (q+2))) :
    mPlus Real.goldenRatio (Nat.fib (q+2)) h2 +
      mMinus Real.goldenRatio (Nat.fib (q+2)) h2 ≤ Nat.fib (q+2) := by
  have hqN : Nat.fib q < Nat.fib (q+2) := (Nat.fib_lt_fib hq).mpr (by omega)
  have hq1N : Nat.fib (q+1) < Nat.fib (q+2) := Nat.fib_lt_fib_succ (by omega)
  rcases Nat.even_or_odd q with he | ho
  · have heta := golden_eta_even q hq he
    have hp : mPlus Real.goldenRatio (Nat.fib (q+2)) h2 ≤ Nat.fib (q+1) := by
      unfold mPlus
      apply canMul_le _ _ _ hq1N
      rw [heta.1]
      exact fract_fib_odd (q+1) he.add_one
    have hm : mMinus Real.goldenRatio (Nat.fib (q+2)) h2 ≤ Nat.fib q := by
      unfold mMinus
      apply canMul_le _ _ _ hqN
      rw [heta.2]
      exact fract_fib_even q he
    have hsum := @Nat.fib_add_two q
    omega
  · have heta := golden_eta_odd q hq ho
    have hp : mPlus Real.goldenRatio (Nat.fib (q+2)) h2 ≤ Nat.fib q := by
      unfold mPlus
      apply canMul_le _ _ _ hqN
      rw [heta.1]
      exact fract_fib_odd q ho
    have hm : mMinus Real.goldenRatio (Nat.fib (q+2)) h2 ≤ Nat.fib (q+1) := by
      unfold mMinus
      apply canMul_le _ _ _ hq1N
      rw [heta.2]
      exact fract_fib_even (q+1) ho.add_one
    have hsum := @Nat.fib_add_two q
    omega

private theorem golden_gap_upper_fib (q : ℕ) (hq : 2 ≤ q)
    {x : ℝ} (hx : x ∈ gaps Real.goldenRatio (Nat.fib (q+2))) :
    x ≤ Real.goldenRatio⁻¹^q := by
  have h2 : 2 ≤ orbitCard Real.goldenRatio (Nat.fib (q+2)) := by
    rw [orbitCard_eq_of_irrational _ Real.goldenRatio_irrational]
    have h := Nat.fib_mono (show 3 ≤ q+2 by omega)
    norm_num at h
    omega
  have hh := gaps_two_of_return_sum_le _ h2 (golden_return_sum_le q hq h2) hx
  have hp : Real.goldenRatio⁻¹^(q+1) ≤ Real.goldenRatio⁻¹^q := by
    rw [pow_succ]
    exact mul_le_of_le_one_right (pow_nonneg (inv_nonneg.mpr Real.goldenRatio_pos.le) _)
      (le_of_lt (inv_lt_one_of_one_lt₀ Real.one_lt_goldenRatio))
  rcases Nat.even_or_odd q with he | ho
  · rcases hh with h | h
    · rw [h,(golden_eta_even q hq he).1]; exact hp
    · rw [h,(golden_eta_even q hq he).2]
  · rcases hh with h | h
    · rw [h,(golden_eta_odd q hq ho).1]
    · rw [h,(golden_eta_odd q hq ho).2]; exact hp

private theorem rotation_cut_eq_threegap_sorted (a : ℝ) (N : ℕ)
    [Fact (Irrational a)] [NeZero N] (i : Fin N) :
    rotationCut a N i.castSucc = sortedVal (-a) N i.val := by
  classical
  have hc : (orbit (-a) N).card = N := orbitCard_eq_of_irrational (-a) (Fact.out : Irrational a).neg N
  have hm (j : Fin N) : rotationCut a N j.castSucc ∈ orbit (-a) N := by
    have hmem : rotationCut a N j.castSucc ∈ rotationCutSet a N :=
      Finset.orderEmbOfFin_mem _ _ _
    change rotationCut a N j.castSucc ∈ insert 1 (orbit (-a) N) at hmem
    rcases Finset.mem_insert.mp hmem with he | he
    · have hlt := (rotationCut a N).strictMono j.castSucc_lt_last
      rw [rotation_cut_last,he] at hlt
      exact (lt_irrefl (1 : ℝ) hlt).elim
    · exact he
  have hs : StrictMono (fun j : Fin N => rotationCut a N j.castSucc) := by
    intro x y hxy
    exact (rotationCut a N).strictMono (by exact hxy)
  have hh := Finset.orderEmbOfFin_unique hc hm hs
  rw [congrFun hh i,sortedVal,dif_pos (by simpa [orbitCard,hc] using i.isLt)]
  exact Finset.orderEmbOfFin_eq_orderEmbOfFin_iff.mpr rfl

theorem rotation_gap_length_mem_threegap (a : ℝ) (N : ℕ)
    [Fact (Irrational a)] [NeZero N] (i : Fin N) :
    rotationCut a N i.succ - rotationCut a N i.castSucc ∈ gaps (-a) N := by
  have hcard : orbitCard (-a) N = N := orbitCard_eq_of_irrational (-a) (Fact.out : Irrational a).neg N
  have hN : 0 < N := Nat.pos_of_ne_zero NeZero.out
  rw [mem_gaps_iff]
  rw [rotation_cut_eq_threegap_sorted]
  by_cases hi : i.val+1 < N
  · left
    let j : Fin N := ⟨i.val+1,hi⟩
    have heq : i.succ = j.castSucc := by ext; rfl
    rw [heq,rotation_cut_eq_threegap_sorted]
    exact ⟨i.val,by omega,rfl⟩
  · right
    have heq : i.succ = Fin.last N := by ext; simp only [Fin.val_succ,Fin.val_last]; omega
    rw [heq,rotation_cut_last,sortedVal_zero_eq_zero (-a) hN]
    have hidx : i.val = orbitCard (-a) N-1 := by omega
    rw [hidx]
    ring

private theorem same_rotation_arc_phase_distance (a : ℝ) (N : ℕ)
    [Fact (Irrational a)] [NeZero N] {x y : ℝ} (i : Fin N)
    (hx : x ∈ rotationGapArc a N i) (hy : y ∈ rotationGapArc a N i)
    {e : ℝ} (he : rotationCut a N i.succ-rotationCut a N i.castSucc ≤ e) :
    |x-y| < e := by
  change rotationCut a N i.castSucc ≤ x ∧ x < rotationCut a N i.succ at hx
  change rotationCut a N i.castSucc ≤ y ∧ y < rotationCut a N i.succ at hy
  apply abs_lt.mpr
  constructor <;> linarith


private theorem neg_rotation_fract (a : ℝ) (ha : Irrational a) (k : ℕ) (hk : 0 < k) :
    Int.fract ((k : ℝ)*(-a)) = 1-Int.fract ((k : ℝ)*a) := by
  rw [mul_neg,Int.fract_neg (D5.S1.Words.GoldenArcFirstReturnInternal.irrational_nat_mul_fract_ne_zero ha hk)]

theorem negative_returns_swap (a : ℝ) (ha : Irrational a) {N : ℕ}
    (h2 : 2 ≤ orbitCard a N) :
    etaPos (-a) N = etaNeg a N ∧ etaNeg (-a) N = etaPos a N := by
  have h2neg : 2 ≤ orbitCard (-a) N := by
    rw [orbitCard_eq_of_irrational (-a) ha.neg,← orbitCard_eq_of_irrational a ha N]
    exact h2
  have hpneg (k : ℕ) (hk : k < N) (hk0 : 0 < k) :
      Int.fract ((k : ℝ)*a) ∈ posOrbit a N := by
    rw [mem_posOrbit_iff]
    exact ⟨D5.S1.Words.GoldenArcFirstReturnInternal.irrational_nat_mul_fract_ne_zero ha hk0,(mem_orbit_iff a N _).mpr ⟨k,hk,rfl⟩⟩
  constructor
  · apply etaPos_eq_of_records (-a) h2neg (mMinus_lt a N h2) (etaNeg_pos a h2)
    · have hne : Int.fract ((mMinus a N h2 : ℝ)*a) ≠ 0 := by
        rw [fract_mMinus]
        exact ne_of_gt (posOrbit_pos a N (max_posOrbit_mem a h2))
      rw [mul_neg,Int.fract_neg hne,fract_mMinus]
      ring
    · intro k hk hkN
      rw [neg_rotation_fract a ha k hk]
      have hh := le_one_sub_etaNeg a h2 (hpneg k hkN hk)
      linarith
  · apply etaNeg_eq_of_records (-a) h2neg (mPlus_lt a N h2)
      (posOrbit_lt_one a N (etaPos_mem a h2))
    · have hne : Int.fract ((mPlus a N h2 : ℝ)*a) ≠ 0 := by
        rw [fract_mPlus]
        exact ne_of_gt (etaPos_pos a h2)
      rw [mul_neg,Int.fract_neg hne,fract_mPlus]
    · intro k hk hkN
      rw [neg_rotation_fract a ha k hk]
      have hh := etaPos_le a h2 (hpneg k hkN hk)
      linarith

private theorem negative_return_indices_swap (a : ℝ) (ha : Irrational a) {N : ℕ}
    (h2 : 2 ≤ orbitCard a N) (hn : 2 ≤ orbitCard (-a) N) :
    mPlus (-a) N hn = mMinus a N h2 ∧ mMinus (-a) N hn = mPlus a N h2 := by
  have hcard : ((Finset.range N).image (fun k : ℕ => Int.fract ((k : ℝ)*(-a)))).card = (Finset.range N).card := by
    simpa only [orbitCard,orbit,Finset.card_range] using orbitCard_eq_of_irrational (-a) ha.neg N
  have hinj := Finset.injOn_of_card_image_eq hcard
  have hs := negative_returns_swap a ha h2
  constructor
  · apply hinj (Finset.mem_range.mpr (mPlus_lt (-a) N hn)) (Finset.mem_range.mpr (mMinus_lt a N h2))
    change Int.fract ((mPlus (-a) N hn : ℝ)*(-a)) = Int.fract ((mMinus a N h2 : ℝ)*(-a))
    rw [fract_mPlus,hs.1]
    have hne : Int.fract ((mMinus a N h2 : ℝ)*a) ≠ 0 := by
      rw [fract_mMinus]
      exact ne_of_gt (posOrbit_pos a N (max_posOrbit_mem a h2))
    rw [mul_neg,Int.fract_neg hne,fract_mMinus]
    ring
  · apply hinj (Finset.mem_range.mpr (mMinus_lt (-a) N hn)) (Finset.mem_range.mpr (mPlus_lt a N h2))
    change Int.fract ((mMinus (-a) N hn : ℝ)*(-a)) = Int.fract ((mPlus a N h2 : ℝ)*(-a))
    rw [fract_mMinus,hs.2]
    have hne : Int.fract ((mPlus a N h2 : ℝ)*a) ≠ 0 := by
      rw [fract_mPlus]
      exact ne_of_gt (etaPos_pos a h2)
    rw [mul_neg,Int.fract_neg hne,fract_mPlus]

private theorem golden_negative_gap_upper_fib (q : ℕ) (hq : 2 ≤ q)
    {x : ℝ} (hx : x ∈ gaps (-Real.goldenRatio) (Nat.fib (q+2))) :
    x ≤ Real.goldenRatio⁻¹^q := by
  have h2 : 2 ≤ orbitCard Real.goldenRatio (Nat.fib (q+2)) := by
    rw [orbitCard_eq_of_irrational _ Real.goldenRatio_irrational]
    have h := Nat.fib_mono (show 3 ≤ q+2 by omega)
    norm_num at h
    omega
  have hn : 2 ≤ orbitCard (-Real.goldenRatio) (Nat.fib (q+2)) := by
    rw [orbitCard_eq_of_irrational _ Real.goldenRatio_irrational.neg,
      ← orbitCard_eq_of_irrational _ Real.goldenRatio_irrational (Nat.fib (q+2))]
    exact h2
  have hind := negative_return_indices_swap _ Real.goldenRatio_irrational h2 hn
  have hsum : mPlus (-Real.goldenRatio) (Nat.fib (q+2)) hn +
      mMinus (-Real.goldenRatio) (Nat.fib (q+2)) hn ≤ Nat.fib (q+2) := by
    rw [hind.1,hind.2,Nat.add_comm]
    exact golden_return_sum_le q hq h2
  have hs := negative_returns_swap _ Real.goldenRatio_irrational h2
  have hh := gaps_two_of_return_sum_le _ hn hsum hx
  rcases hh with hh | hh
  · rw [hh,hs.1]
    exact golden_gap_upper_fib q hq (etaNeg_is_gap _ h2)
  · rw [hh,hs.2]
    exact golden_gap_upper_fib q hq (etaPos_is_gap _ h2)

private theorem orbit_int_add (a : ℝ) (z : ℤ) (N : ℕ) :
    orbit (a+z) N = orbit a N := by
  apply Finset.image_congr
  intro i hi
  change Int.fract ((i : ℝ)*(a+z)) = Int.fract ((i : ℝ)*a)
  rw [mul_add]
  have he : (i : ℝ)*(z : ℝ) = ((i : ℤ)*z : ℤ) := by push_cast; ring
  rw [he,Int.fract_add_intCast]

theorem golden_negative_slope_orbit (N : ℕ) :
    orbit (-goldenMechanicalSlope) N = orbit (-Real.goldenRatio) N := by
  have he : -goldenMechanicalSlope = -Real.goldenRatio+(1 : ℤ) := by
    rw [golden_mechanical_slope_eq_goldenRatio_sub_one]
    push_cast
    ring
  rw [he,orbit_int_add]

private theorem golden_negative_slope_gaps (N : ℕ) :
    gaps (-goldenMechanicalSlope) N = gaps (-Real.goldenRatio) N := by
  have he := golden_negative_slope_orbit N
  simp only [gaps,sortedVal,orbitCard,orbitEmb,he]
  rfl



private theorem golden_rotation_arc_length_upper (q : ℕ) (hq : 2 ≤ q)
    [NeZero (Nat.fib (q+2))] (r : Fin (Nat.fib (q+2))) :
    rotationCut goldenMechanicalSlope (Nat.fib (q+2)) r.succ -
      rotationCut goldenMechanicalSlope (Nat.fib (q+2)) r.castSucc ≤ Real.goldenRatio⁻¹^q := by
  have hn : Nat.fib (q+2) ≠ 0 := (Nat.fib_pos.mpr (by omega : 0 < q+2)).ne'
  letI : NeZero (Nat.fib (q+2)) := ⟨hn⟩
  have hh := rotation_gap_length_mem_threegap goldenMechanicalSlope (Nat.fib (q+2)) r
  rw [golden_negative_slope_gaps] at hh
  exact golden_negative_gap_upper_fib q hq hh


private theorem min_displacement_le_phase_distance {x y : ℝ}
    (hx : x ∈ Set.Ico (0 : ℝ) 1) (hy : y ∈ Set.Ico (0 : ℝ) 1) :
    min (Int.fract (y-x)) (1-Int.fract (y-x)) ≤ |y-x| := by
  by_cases hh : 0 ≤ y-x
  · rw [Int.fract_eq_self.mpr ⟨hh,by linarith [hx.1,hx.2,hy.1,hy.2]⟩,abs_of_nonneg hh]
    exact min_le_left _ _
  · have hh' : y-x < 0 := lt_of_not_ge hh
    have hfrac : Int.fract (y-x) = y-x+1 := by
      rw [show y-x = (y-x+1)-(1 : ℤ) by push_cast; ring,Int.fract_sub_intCast]
      have hf : Int.fract (y-x+1)=y-x+1 := Int.fract_eq_self.mpr (by constructor <;> linarith [hx.1,hx.2,hy.1,hy.2])
      rw [hf]
      push_cast
      ring
    rw [hfrac,abs_of_neg hh']
    exact (min_le_right _ _).trans (by linarith)

private theorem golden_inverse_power_le_complement (q : ℕ) (hq : 2 ≤ q) :
    Real.goldenRatio⁻¹^q ≤ 1-Real.goldenRatio⁻¹^q := by
  have hp := inv_pos.mpr Real.goldenRatio_pos
  have hlt := inv_lt_one_of_one_lt₀ Real.one_lt_goldenRatio
  have hhalf : (1/2 : ℝ) < Real.goldenRatio⁻¹ := by
    have hh := mul_lt_mul_of_pos_left Real.goldenRatio_lt_two hp
    rw [inv_mul_cancel₀ Real.goldenRatio_ne_zero] at hh
    linarith
  have hsq := D5.S1.Words.Powers.inv_golden_sq_add_inv_golden
  have hpow := pow_le_pow_of_le_one hp.le hlt.le hq
  nlinarith

theorem golden_slope_fract_eq (p : ℕ) :
    Int.fract ((p : ℝ)*goldenMechanicalSlope) =
      Int.fract ((p : ℝ)*Real.goldenRatio) := by
  rw [golden_mechanical_slope_eq_goldenRatio_sub_one,mul_sub,mul_one,Int.fract_sub_natCast]

private theorem golden_phase_distance_fib (a q : ℕ) (hq : 2 ≤ q) :
    Real.goldenRatio⁻¹^q ≤ |goldenPhase (a+Nat.fib q)-goldenPhase a| := by
  have hx : goldenPhase a ∈ Set.Ico (0 : ℝ) 1 := ⟨Int.fract_nonneg _,Int.fract_lt_one _⟩
  have hy : goldenPhase (a+Nat.fib q) ∈ Set.Ico (0 : ℝ) 1 := ⟨Int.fract_nonneg _,Int.fract_lt_one _⟩
  have hh := min_displacement_le_phase_distance hx hy
  have hdiff : Int.fract (goldenPhase (a+Nat.fib q)-goldenPhase a) =
      Int.fract ((Nat.fib q : ℝ)*Real.goldenRatio) := by
    rw [D5.S1.Words.ReturnWords.GoldenPhaseShift.golden_phase_add]
    have hself : Int.fract (goldenPhase a) = goldenPhase a := Int.fract_eq_self.mpr hx
    calc
      Int.fract (Int.fract (goldenPhase a+(Nat.fib q : ℝ)*goldenMechanicalSlope)-goldenPhase a) =
          Int.fract (Int.fract (goldenPhase a+(Nat.fib q : ℝ)*goldenMechanicalSlope)-Int.fract (goldenPhase a)) := by rw [hself]
      _ = Int.fract ((goldenPhase a+(Nat.fib q : ℝ)*goldenMechanicalSlope)-goldenPhase a) :=
        fract_sub_fract_eq _ _
      _ = Int.fract ((Nat.fib q : ℝ)*goldenMechanicalSlope) := by congr 1; ring
      _ = Int.fract ((Nat.fib q : ℝ)*Real.goldenRatio) := golden_slope_fract_eq _
  rw [hdiff] at hh
  have heps := golden_inverse_power_le_complement q hq
  rcases Nat.even_or_odd q with he | ho
  · rw [fract_fib_even q he] at hh
    have hmin : min (1-Real.goldenRatio⁻¹^q) (1-(1-Real.goldenRatio⁻¹^q)) = Real.goldenRatio⁻¹^q := by
      rw [sub_sub_cancel,min_eq_right heps]
    simpa only [hmin] using hh
  · rw [fract_fib_odd q ho,min_eq_left heps] at hh
    exact hh

private theorem rotation_gap_width_cast (a : ℝ) {N M : ℕ}
    [Fact (Irrational a)] [NeZero N] [NeZero M] (h : N=M)
    (r : Fin N) (s : Fin M) (hrs : r.val=s.val) :
    rotationCut a N r.succ-rotationCut a N r.castSucc =
      rotationCut a M s.succ-rotationCut a M s.castSucc := by
  subst M
  have he : r=s := Fin.ext hrs
  subst s
  rfl

private theorem rotation_gap_arc_cast (a : ℝ) {N M : ℕ}
    [Fact (Irrational a)] [NeZero N] [NeZero M] (h : N=M)
    (r : Fin N) (s : Fin M) (hrs : r.val=s.val) :
    rotationGapArc a N r = rotationGapArc a M s := by
  subst M
  have he : r=s := Fin.ext hrs
  subst s
  rfl

private theorem golden_equal_factors_phase_distance (q : ℕ) (hq : 2 ≤ q) (a b : ℕ)
    (heq : goldenFactor (Nat.fib (q+2)-1) a = goldenFactor (Nat.fib (q+2)-1) b) :
    |goldenPhase a-goldenPhase b| < Real.goldenRatio⁻¹^q := by
  have hn : 0 < Nat.fib (q+2) := Nat.fib_pos.mpr (by omega)
  have hi : Nat.fib (q+2)-1+1 = Nat.fib (q+2) := by omega
  let n := Nat.fib (q+2)-1
  have hn' : n+1=Nat.fib (q+2) := hi
  letI : NeZero (Nat.fib (q+2)) := ⟨hn.ne'⟩
  have hphase : goldenPhase a ∈ Set.Ico (0 : ℝ) 1 := ⟨Int.fract_nonneg _,Int.fract_lt_one _⟩
  rw [← iUnion_rotation_gap_arc goldenMechanicalSlope (Nat.fib (q+2))] at hphase
  obtain ⟨r,hr⟩ := Set.mem_iUnion.mp hphase
  let s : Fin (n+1) := ⟨r.val,by omega⟩
  have harc : rotationGapArc goldenMechanicalSlope (n+1) s =
      rotationGapArc goldenMechanicalSlope (Nat.fib (q+2)) r :=
    rotation_gap_arc_cast _ hn' s r rfl
  have hrr := (golden_cylinder_rank_iff_mem_rotation_gap_arc n a s).mpr (by rw [harc]; exact hr)
  have hrank := (golden_factor_eq_iff_cylinder_rank_eq n a b).mp heq
  have hbr : goldenPhase b ∈ rotationGapArc goldenMechanicalSlope (Nat.fib (q+2)) r := by
    have hh := (golden_cylinder_rank_iff_mem_rotation_gap_arc n b s).mp
      (hrank.symm.trans hrr)
    rw [harc] at hh
    exact hh
  exact same_rotation_arc_phase_distance _ _ r hr hbr (golden_rotation_arc_length_upper q hq r)

private theorem golden_periodic_factor_eq {a p L n : ℕ}
    (hper : D5.S1.Words.Powers.GoldenPeriodic a p L) (hn : n+p ≤ L) :
    goldenFactor n a = goldenFactor n (a+p) := by
  apply List.ext_get
  · simp [goldenFactor]
  · intro j hj hj'
    have hjn : j < n := by simpa only [goldenFactor,List.length_ofFn] using hj
    simpa [goldenFactor,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using
      hper (a+j) (by omega) (by omega)

private theorem golden_fibonacci_period_length_sharp (a L q : ℕ) (hq : 2 ≤ q)
    (hper : D5.S1.Words.Powers.GoldenPeriodic a (Nat.fib q) L) :
    L < Nat.fib q+Nat.fib (q+2)-1 := by
  by_contra hn
  have hp := Nat.fib_pos.mpr (by omega : 0 < q+2)
  have hh := golden_periodic_factor_eq hper
    (n := Nat.fib (q+2)-1) (by omega)
  have hd := golden_equal_factors_phase_distance q hq a (a+Nat.fib q) hh
  have hl := golden_phase_distance_fib a q hq
  rw [abs_sub_comm] at hd
  exact (not_lt_of_ge hl) hd

private theorem removed_last_gap_ge_returns (a : ℝ) (N : ℕ) (hN : 2 ≤ N)
    [Fact (Irrational a)] [NeZero (N-1)] :
    ∃ r : Fin (N-1), etaPos (-a) N + etaNeg (-a) N ≤
      rotationCut a (N-1) r.succ - rotationCut a (N-1) r.castSucc := by
  have ha : Irrational a := Fact.out
  have h2 : 2 ≤ orbitCard (-a) N := by rw [orbitCard_eq_of_irrational _ ha.neg N]; exact hN
  have hc : orbitCard (-a) (N-1) = N-1 := orbitCard_eq_of_irrational _ ha.neg _
  let j := N-1
  let x := Int.fract ((j : ℝ)*(-a))
  have hx0 : 0 < x := lt_of_le_of_ne (Int.fract_nonneg _) (Ne.symm (D5.S1.Words.GoldenArcFirstReturnInternal.irrational_nat_mul_fract_ne_zero ha.neg (by dsimp [j]; omega)))
  have hx1 : x < 1 := Int.fract_lt_one _
  have hxm : x ∈ Set.Ico (0 : ℝ) 1 := ⟨hx0.le,hx1⟩
  rw [← iUnion_rotation_gap_arc a (N-1)] at hxm
  obtain ⟨r,hr⟩ := Set.mem_iUnion.mp hxm
  let l := rotationCut a (N-1) r.castSucc
  let u := rotationCut a (N-1) r.succ
  change l ≤ x ∧ x < u at hr
  have hlmem : l ∈ orbit (-a) (N-1) := by
    dsimp [l]
    rw [rotation_cut_eq_threegap_sorted]
    exact sortedVal_mem (-a) (by rw [hc]; exact r.isLt)
  obtain ⟨i,hi,he⟩ := (mem_orbit_iff (-a) (N-1) l).mp hlmem
  have hxl : l < x := by
    apply lt_of_le_of_ne hr.1
    intro hh
    have hcard : ((Finset.range N).image (fun k : ℕ => Int.fract ((k : ℝ)*(-a)))).card = (Finset.range N).card := by
      simpa only [orbitCard,orbit,Finset.card_range] using orbitCard_eq_of_irrational (-a) ha.neg N
    have hij := (Finset.injOn_of_card_image_eq hcard)
      (Finset.mem_range.mpr (by omega : i < N))
      (Finset.mem_range.mpr (by dsimp [j]; omega : j < N)) (he.trans hh)
    dsimp [j] at hij
    omega
  have hfr : Int.fract (((j-i : ℕ) : ℝ)*(-a)) = x-l := by
    rw [Nat.cast_sub (by dsimp [j]; omega),sub_mul,← fract_sub_fract_eq,he]
    change Int.fract (x-l)=x-l
    apply Int.fract_eq_self.mpr
    constructor
    · linarith
    · have hl0 := (orbit_subset_Ico (-a) (N-1) hlmem).1
      linarith
  have hleft : etaPos (-a) N ≤ x-l := by
    apply no_orbit_below_etaPos (-a) h2
    · exact (mem_orbit_iff (-a) N _).mpr ⟨j-i,by dsimp [j]; omega,hfr⟩
    · linarith
  have hright : etaNeg (-a) N ≤ u-x := by
    by_cases hrs : r.val+1 < N-1
    · let s : Fin (N-1) := ⟨r.val+1,hrs⟩
      have heq : r.succ=s.castSucc := by ext; rfl
      have humem : u ∈ orbit (-a) (N-1) := by
        dsimp [u]
        rw [heq,rotation_cut_eq_threegap_sorted]
        exact sortedVal_mem (-a) (by rw [hc]; exact s.isLt)
      obtain ⟨i',hi',he'⟩ := (mem_orbit_iff (-a) (N-1) u).mp humem
      have hu1 := (orbit_subset_Ico (-a) (N-1) humem).2
      have hfr' : Int.fract (((j-i' : ℕ) : ℝ)*(-a)) = x-u+1 := by
        rw [Nat.cast_sub (by dsimp [j]; omega),sub_mul,← fract_sub_fract_eq,he']
        change Int.fract (x-u)=x-u+1
        rw [show x-u=(x-u+1)-(1 : ℤ) by push_cast; ring,Int.fract_sub_intCast]
        have hf : Int.fract (x-u+1)=x-u+1 := Int.fract_eq_self.mpr (by constructor <;> linarith)
        rw [hf]
        push_cast
        ring
      have hp : x-u+1 ∈ posOrbit (-a) N := by
        apply (mem_posOrbit_iff (-a) N _).mpr
        exact ⟨by linarith,(mem_orbit_iff (-a) N _).mpr ⟨j-i',by dsimp [j]; omega,hfr'⟩⟩
      have hh := le_one_sub_etaNeg (-a) h2 hp
      linarith
    · have hlast : r.succ = Fin.last (N-1) := by ext; simp only [Fin.val_succ,Fin.val_last]; omega
      have hu : u=1 := by dsimp [u]; rw [hlast,rotation_cut_last]
      have hp : x ∈ posOrbit (-a) N := by
        apply (mem_posOrbit_iff (-a) N x).mpr
        exact ⟨hx0.ne',(mem_orbit_iff (-a) N x).mpr ⟨j,by dsimp [j]; omega,rfl⟩⟩
      have hh := le_one_sub_etaNeg (-a) h2 hp
      rw [hu]
      linarith
  refine ⟨r,?_⟩
  change etaPos (-a) N + etaNeg (-a) N ≤ u-l
  linarith

private theorem golden_negative_slope_return_sum (q : ℕ) (hq : 2 ≤ q) :
    etaPos (-goldenMechanicalSlope) (Nat.fib (q+2)) +
      etaNeg (-goldenMechanicalSlope) (Nat.fib (q+2)) =
      Real.goldenRatio⁻¹^q+Real.goldenRatio⁻¹^(q+1) := by
  have he : posOrbit (-goldenMechanicalSlope) (Nat.fib (q+2)) =
      posOrbit (-Real.goldenRatio) (Nat.fib (q+2)) := by
    simp only [posOrbit,golden_negative_slope_orbit]
  have hp : etaPos (-goldenMechanicalSlope) (Nat.fib (q+2)) =
      etaPos (-Real.goldenRatio) (Nat.fib (q+2)) := by simp only [etaPos,he]
  have hm : etaNeg (-goldenMechanicalSlope) (Nat.fib (q+2)) =
      etaNeg (-Real.goldenRatio) (Nat.fib (q+2)) := by simp only [etaNeg,he]
  have h2 : 2 ≤ orbitCard Real.goldenRatio (Nat.fib (q+2)) := by
    rw [orbitCard_eq_of_irrational _ Real.goldenRatio_irrational]
    have hh := Nat.fib_mono (show 3 ≤ q+2 by omega)
    norm_num at hh
    omega
  have hs := negative_returns_swap _ Real.goldenRatio_irrational h2
  rw [hp,hm,hs.1,hs.2]
  rcases Nat.even_or_odd q with he | ho
  · rw [(golden_eta_even q hq he).1,(golden_eta_even q hq he).2]
  · rw [(golden_eta_odd q hq ho).1,(golden_eta_odd q hq ho).2]
    ring

private theorem golden_large_arc_before_fib (q : ℕ) (hq : 2 ≤ q) :
    ∃ r : Fin (Nat.fib (q+2)-2+1),
      Real.goldenRatio⁻¹^q <
        rotationCut goldenMechanicalSlope (Nat.fib (q+2)-2+1) r.succ -
          rotationCut goldenMechanicalSlope (Nat.fib (q+2)-2+1) r.castSucc := by
  have hN : 2 ≤ Nat.fib (q+2) := by
    have hh := Nat.fib_mono (show 3 ≤ q+2 by omega)
    norm_num at hh
    omega
  have hi : Nat.fib (q+2)-2+1=Nat.fib (q+2)-1 := by omega
  letI : NeZero (Nat.fib (q+2)-1) := ⟨by omega⟩
  obtain ⟨r,hr⟩ := removed_last_gap_ge_returns goldenMechanicalSlope (Nat.fib (q+2)) hN
  rw [golden_negative_slope_return_sum q hq] at hr
  have hh : Real.goldenRatio⁻¹^q <
      rotationCut goldenMechanicalSlope (Nat.fib (q+2)-1) r.succ -
        rotationCut goldenMechanicalSlope (Nat.fib (q+2)-1) r.castSucc := by
    have hp := pow_pos (inv_pos.mpr Real.goldenRatio_pos) (q+1)
    linarith
  let s : Fin (Nat.fib (q+2)-2+1) := ⟨r.val,by omega⟩
  refine ⟨s,?_⟩
  rw [rotation_gap_width_cast goldenMechanicalSlope hi s r rfl]
  exact hh

private theorem golden_periodic_of_factor_eq (a p n : ℕ)
    (h : goldenFactor n a = goldenFactor n (a+p)) :
    D5.S1.Words.Powers.GoldenPeriodic a p (p+n) := by
  intro z hz hz'
  have ht : z-a < n := by omega
  have he := congrArg (fun w : List Bool => w[z-a]?) h
  simp only [goldenFactor,List.getElem?_ofFn,ht,↓reduceDIte,Option.some.injEq] at he
  have he0 : a+(z-a)=z := Nat.add_sub_of_le hz
  have he1 : a+p+(z-a)=z+p := by omega
  simpa only [he0,he1] using he

theorem golden_fibonacci_long_period_exists (q : ℕ) (hq : 2 ≤ q) :
    ∃ a, D5.S1.Words.Powers.GoldenPeriodic a (Nat.fib q)
      (Nat.fib q+Nat.fib (q+2)-2) := by
  let n := Nat.fib (q+2)-2
  obtain ⟨r,hr⟩ := golden_large_arc_before_fib q hq
  let l := rotationCut goldenMechanicalSlope (n+1) r.castSucc
  let u := rotationCut goldenMechanicalSlope (n+1) r.succ
  have hl0 : 0 ≤ l := by
    calc
      0 = rotationCut goldenMechanicalSlope (n+1) 0 := (rotation_cut_zero _ _).symm
      _ ≤ l := (rotationCut _ _).monotone (Fin.zero_le _)
  have hu1 : u ≤ 1 := by
    calc
      u ≤ rotationCut goldenMechanicalSlope (n+1) (Fin.last (n+1)) := (rotationCut _ _).monotone (Fin.le_last _)
      _ = 1 := rotation_cut_last _ _
  change Real.goldenRatio⁻¹^q < u-l at hr
  have hp : 0 < Real.goldenRatio⁻¹^q := pow_pos (inv_pos.mpr Real.goldenRatio_pos) _
  have hpq : 0 < Nat.fib q := Nat.fib_pos.mpr (by omega)
  have hfr := golden_slope_fract_eq (Nat.fib q)
  have heq : ∃ a, goldenFactor n a = goldenFactor n (a+Nat.fib q) := by
    rcases Nat.even_or_odd q with he | ho
    · rw [fract_fib_even q he] at hfr
      obtain ⟨a,ha⟩ := D5.S1.Words.GoldenArcFirstReturnInternal.exists_orbit_phase_mem_Ioo golden_mechanical_slope_irrational
        (show 0 ≤ l+Real.goldenRatio⁻¹^q by linarith)
        (show l+Real.goldenRatio⁻¹^q < u by linarith) hu1
      change goldenPhase a ∈ Set.Ioo (l+Real.goldenRatio⁻¹^q) u at ha
      have hshift : goldenPhase (a+Nat.fib q) = goldenPhase a-Real.goldenRatio⁻¹^q := by
        rw [D5.S1.Words.ReturnWords.GoldenPhaseShift.golden_phase_add]
        have hw := D5.S1.Words.GoldenArcFirstReturnInternal.fract_add_displacement_of_wrap golden_mechanical_slope_irrational hpq
          (Int.fract_lt_one (((a+1 : ℕ) : ℝ)*goldenMechanicalSlope))
          (show 1 ≤ goldenPhase a+forwardDisplacement goldenMechanicalSlope (Nat.fib q) by
            change 1 ≤ goldenPhase a+Int.fract ((Nat.fib q : ℝ)*goldenMechanicalSlope)
            rw [hfr]; linarith [ha.1,ha.2])
        change Int.fract (goldenPhase a+(Nat.fib q : ℝ)*goldenMechanicalSlope) =
          goldenPhase a-backwardDisplacement goldenMechanicalSlope (Nat.fib q) at hw
        rw [hw,backward_displacement_eq_one_sub_forward golden_mechanical_slope_irrational hpq]
        change goldenPhase a-(1-Int.fract ((Nat.fib q : ℝ)*goldenMechanicalSlope))= _
        rw [hfr]
        ring
      have ha0 : goldenPhase a ∈ rotationGapArc goldenMechanicalSlope (n+1) r := by
        change l ≤ goldenPhase a ∧ goldenPhase a < u
        constructor <;> linarith [ha.1,ha.2]
      have ha1 : goldenPhase (a+Nat.fib q) ∈ rotationGapArc goldenMechanicalSlope (n+1) r := by
        change l ≤ goldenPhase (a+Nat.fib q) ∧ goldenPhase (a+Nat.fib q) < u
        rw [hshift]
        constructor <;> linarith [ha.1,ha.2]
      exact ⟨a,(golden_factor_eq_iff_cylinder_rank_eq n _ _).mpr
        (((golden_cylinder_rank_iff_mem_rotation_gap_arc n a r).mpr ha0).trans
          ((golden_cylinder_rank_iff_mem_rotation_gap_arc n (a+Nat.fib q) r).mpr ha1).symm)⟩
    · rw [fract_fib_odd q ho] at hfr
      obtain ⟨a,ha⟩ := D5.S1.Words.GoldenArcFirstReturnInternal.exists_orbit_phase_mem_Ioo golden_mechanical_slope_irrational hl0
        (show l < u-Real.goldenRatio⁻¹^q by linarith)
        (show u-Real.goldenRatio⁻¹^q ≤ 1 by linarith)
      change goldenPhase a ∈ Set.Ioo l (u-Real.goldenRatio⁻¹^q) at ha
      have hshift : goldenPhase (a+Nat.fib q) = goldenPhase a+Real.goldenRatio⁻¹^q := by
        rw [D5.S1.Words.ReturnWords.GoldenPhaseShift.golden_phase_add]
        have hdisp : forwardDisplacement goldenMechanicalSlope (Nat.fib q)=Real.goldenRatio⁻¹^q := hfr
        rw [fract_add_displacement_of_no_wrap (x := goldenPhase a) (Nat.fib q) (Int.fract_nonneg _)
          (show goldenPhase a+forwardDisplacement goldenMechanicalSlope (Nat.fib q)<1 by rw [hdisp]; linarith [ha.1,ha.2]),hdisp]
      have ha0 : goldenPhase a ∈ rotationGapArc goldenMechanicalSlope (n+1) r := by
        change l ≤ goldenPhase a ∧ goldenPhase a < u
        constructor <;> linarith [ha.1,ha.2]
      have ha1 : goldenPhase (a+Nat.fib q) ∈ rotationGapArc goldenMechanicalSlope (n+1) r := by
        change l ≤ goldenPhase (a+Nat.fib q) ∧ goldenPhase (a+Nat.fib q) < u
        rw [hshift]
        constructor <;> linarith [ha.1,ha.2]
      exact ⟨a,(golden_factor_eq_iff_cylinder_rank_eq n _ _).mpr
        (((golden_cylinder_rank_iff_mem_rotation_gap_arc n a r).mpr ha0).trans
          ((golden_cylinder_rank_iff_mem_rotation_gap_arc n (a+Nat.fib q) r).mpr ha1).symm)⟩
  obtain ⟨a,ha⟩ := heq
  have hh := golden_periodic_of_factor_eq a (Nat.fib q) n ha
  have hN : 2 ≤ Nat.fib (q+2) := by
    have hh := Nat.fib_mono (show 3 ≤ q+2 by omega)
    norm_num at hh
    omega
  refine ⟨a,?_⟩
  convert hh using 1 <;> dsimp [n] <;> omega


theorem periodic_mod (a p L : ℕ) (hper : GoldenPeriodic a p L)
    (j : ℕ) (hj : j < L) : goldenWord (a+j) = goldenWord (a+j%p) := by
  have hlist : List.HasPeriod (goldenFactor L a) p := by
    rw [List.hasPeriod_iff_getElem?]
    intro i hi
    simp only [goldenFactor,List.length_ofFn] at hi
    have hiL : i < L := by omega
    have hip : i+p < L := by omega
    have he := hper (a+i) (by omega) (by omega)
    simpa [goldenFactor,hiL,hip,Nat.add_assoc] using congrArg some he
  have hm : j%p < L := (Nat.mod_le j p).trans_lt hj
  have he := (hlist.getElem?_mod p j (goldenFactor L a) (by simpa [goldenFactor] using hj)).symm
  simpa [goldenFactor,hj,hm] using he

private theorem cube_of_periodic (a p L : ℕ) (hp : 0 < p) (h3 : 3*p ≤ L)
    (hper : GoldenPeriodic a p L) : IsGoldenPowerFactor 3 (goldenFactor p a) a := by
  unfold IsGoldenPowerFactor
  simp only [goldenFactor,List.length_ofFn]
  change goldenFactor (3*p) a = wordPower 3 (goldenFactor p a)
  apply List.ext_getElem?'
  intro j hj
  have hj3 : j < 3*p := by simpa [goldenFactor,length_wordPower] using hj
  have hm : j%p < p := Nat.mod_lt j hp
  rw [wordPower_getElem? 3 (goldenFactor p a) j (by simpa [goldenFactor] using hj3)]
  simp only [goldenFactor,List.length_ofFn,List.getElem?_ofFn,hj3,hm,↓reduceDIte,Option.some.injEq]
  exact periodic_mod a p L hper j (hj3.trans_le h3)

private theorem periodic_sharp_real_bound (a p L : ℕ) (hp : 0 < p)
    (hper : GoldenPeriodic a p L) : (L : ℝ) ≤ (2+Real.goldenRatio)*(p : ℝ) := by
  by_cases h3 : 3*p ≤ L
  · have hcube := cube_of_periodic a p L hp h3 hper
    obtain ⟨q,hq,hpF⟩ := golden_cube_root_length_eq_fib
      (u := goldenFactor p a) (by simp [goldenFactor,hp.ne']) hcube
    have hpF' : p=Nat.fib q := by simpa [goldenFactor] using hpF
    have hl := golden_fibonacci_period_length_sharp a L q (by omega) (by simpa [hpF'] using hper)
    have hL : L+2 ≤ Nat.fib q+Nat.fib (q+2) := by omega
    have hL' : (L : ℝ)+2 ≤ (Nat.fib q : ℝ)+(Nat.fib (q+2) : ℝ) := by exact_mod_cast hL
    have hsum : (Nat.fib (q+2) : ℝ)=(Nat.fib (q+1) : ℝ)+(Nat.fib q : ℝ) := by simpa only [Nat.cast_add,add_comm] using congrArg (fun n : ℕ => (n : ℝ)) (@Nat.fib_add_two q)
    rw [hsum] at hL'
    have hf := Real.fib_succ_sub_goldenRatio_mul_fib q
    have habs : |Real.goldenConj| ≤ 1 :=
      D5.S3.Axis.AxisConvergence.goldenConj_abs_lt_one.le
    have hb : Real.goldenConj^q ≤ 1 := (le_abs_self _).trans (by rw [abs_pow]; exact pow_le_one₀ (abs_nonneg _) habs)
    rw [hpF']
    nlinarith
  · have hL : (L : ℝ) < 3*(p : ℝ) := by exact_mod_cast (lt_of_not_ge h3)
    have hp' : (0 : ℝ) < p := Nat.cast_pos'.mpr hp
    nlinarith [Real.one_lt_goldenRatio]

private theorem golden_indexAt_le_sharp (n : ℕ) :
    indexAt goldenWord n ≤ ENNReal.ofReal (2+Real.goldenRatio) := by
  apply iSup_le
  rintro ⟨w,hw⟩
  obtain ⟨a, rfl⟩ := hw
  have hp := per_is_period ((rayPrefix (fun index => goldenWord (a + index)) n))
  have hpoint := (hasPeriod_block_iff _ _ _ _).mp hp
  have hgold : GoldenPeriodic a (per ((rayPrefix (fun index => goldenWord (a + index)) n))) n := by
    intro z hz hz'
    have he := hpoint.2 (z-a) (by omega)
    have heq : a+(z-a)=z := Nat.add_sub_of_le hz
    simpa [← Nat.add_assoc,heq] using he
  have hh := periodic_sharp_real_bound a _ n hp.1 hgold
  change exponent ((rayPrefix (fun index => goldenWord (a + index)) n)) ≤ ENNReal.ofReal (2+Real.goldenRatio)
  rw [exponent_eq_ofReal,rayPrefix,List.length_ofFn]
  apply ENNReal.ofReal_le_ofReal
  exact (div_le_iff₀ (Nat.cast_pos'.mpr hp.1)).mpr hh

private theorem golden_indStar_le_sharp :
    indStar goldenWord ≤ ENNReal.ofReal (2+Real.goldenRatio) := by
  apply le_trans (iInf_le _ 0)
  apply iSup_le
  intro n
  simpa using golden_indexAt_le_sharp n

theorem long_period_ratio_tendsto :
    Tendsto (fun k : ℕ =>
      ((Nat.fib (k+4)+Nat.fib (k+6)-2 : ℕ) : ℝ)/(Nat.fib (k+4) : ℝ))
      atTop (𝓝 (2+Real.goldenRatio)) := by
  have tfib : Tendsto (fun k : ℕ => (Nat.fib (k+4) : ℝ)) atTop atTop := by
    apply tendsto_atTop_mono (f := fun k : ℕ => (k : ℝ)) _ tendsto_natCast_atTop_atTop
    intro k
    have hh := index_lt_diagonal_level (k+2)
    rw [fibWord_length] at hh
    simp only [Nat.add_assoc,Nat.reduceAdd] at hh
    exact_mod_cast (show k ≤ Nat.fib (k+4) by omega)
  have hi : Tendsto (fun k : ℕ => ((Nat.fib (k+4) : ℝ))⁻¹) atTop (𝓝 0) := tendsto_inv_atTop_zero.comp tfib
  have hr := tendsto_fib_succ_div_fib_atTop.comp (tendsto_add_atTop_nat 4)
  have hc : Tendsto (fun k : ℕ => (2 : ℝ)+(Nat.fib (k+5) : ℝ)/(Nat.fib (k+4) : ℝ)-2*((Nat.fib (k+4) : ℝ))⁻¹)
      atTop (𝓝 (2+Real.goldenRatio)) := by
    simpa only [mul_zero,sub_zero,Function.comp_apply,Nat.add_assoc,Nat.reduceAdd] using
      (hr.const_add (2 : ℝ)).sub (hi.const_mul (2 : ℝ))
  convert hc using 1
  funext k
  have hf : 2 ≤ Nat.fib (k+4) := by
    have hh := Nat.fib_mono (show 3 ≤ k+4 by omega)
    norm_num at hh
    exact hh
  have hsum : Nat.fib (k+6)=Nat.fib (k+5)+Nat.fib (k+4) := by have hh := @Nat.fib_add_two (k+4); simp only [Nat.add_assoc,Nat.reduceAdd] at hh; omega
  have hp : (Nat.fib (k+4) : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  rw [Nat.cast_sub (by omega : 2 ≤ Nat.fib (k+4)+Nat.fib (k+6)),hsum]
  push_cast
  field_simp
  ring

private theorem golden_indStar_ge_sharp :
    ENNReal.ofReal (2+Real.goldenRatio) ≤ indStar goldenWord := by
  apply le_iInf
  intro N
  have ht := ENNReal.tendsto_ofReal long_period_ratio_tendsto
  apply le_of_tendsto ht
  filter_upwards [eventually_ge_atTop N] with k hk
  obtain ⟨a,hper⟩ := golden_fibonacci_long_period_exists (k+4) (by omega)
  let L := Nat.fib (k+4)+Nat.fib (k+6)-2
  have hp : 0 < Nat.fib (k+4) := Nat.fib_pos.mpr (by omega)
  have hper' : HasPeriod ((rayPrefix (fun index => goldenWord (a + index)) L)) (Nat.fib (k+4)) := by
    rw [hasPeriod_block_iff]
    refine ⟨hp,?_⟩
    intro j hj
    have hp0 : GoldenPeriodic a (Nat.fib (k+4)) L := by simpa only [Nat.add_assoc,Nat.reduceAdd,L] using hper
    have hh := hp0 (a+j) (by omega) (by omega)
    simpa [Nat.add_assoc] using hh
  have hleast := per_le_of_period _ _ hper'
  have he : ENNReal.ofReal ((L : ℝ)/(Nat.fib (k+4) : ℝ)) ≤ exponent ((rayPrefix (fun index => goldenWord (a + index)) L)) := by
    rw [exponent_eq_ofReal,rayPrefix,List.length_ofFn]
    apply ENNReal.ofReal_le_ofReal
    exact div_le_div_of_nonneg_left (Nat.cast_nonneg L)
      (Nat.cast_pos'.mpr (per_is_period _).1) (by exact_mod_cast hleast)
  have hlarge : N ≤ L := by
    have hh := index_lt_diagonal_level (k+2)
    rw [fibWord_length] at hh
    simp only [Nat.add_assoc,Nat.reduceAdd] at hh
    have hf : 2 ≤ Nat.fib (k+6) := by
      have hh := Nat.fib_mono (show 3 ≤ k+6 by omega)
      norm_num at hh
      exact hh
    dsimp [L]
    omega
  exact he.trans (block_exponent_le_tail _ a L N hlarge)

theorem golden_indStar_eq_sharp :
    indStar goldenWord = ENNReal.ofReal (2+Real.goldenRatio) :=
  le_antisymm golden_indStar_le_sharp golden_indStar_ge_sharp


end D5.S1.Words.ReturnWords.GoldenSharpRepetitions
