/-!
# Secondary boundary factorization graphs

The definitions follow Chomicz, arXiv:2609.04000v1, Sections 2 and 3. The arithmetic
argument is attributed to public issue 28454 and producer
07b67e50-10a4-41b3-9622-660f37c654a5. The graph uses fiber-local support chains.
-/

namespace D5.NumberTheory.NumericalSemigroups.SecondaryBoundaryBetti

abbrev Generators := Fin 4 → ℕ
abbrev Factorization := Fin 4 → ℕ
abbrev CriticalCoefficients := Fin 4 → ℕ
abbrev PositiveCriticalCoefficients := Fin 4 → Fin 4 → ℕ

/-- The additive submonoid generated by the four displayed natural numbers. -/
def semigroup (d : Generators) : AddSubmonoid ℕ :=
  AddSubmonoid.closure (Set.range d)

/-- The source factorization morphism, evaluated in the ambient natural numbers. -/
def eval (d : Generators) (z : Factorization) : ℕ :=
  ∑ i : Fin 4, z i * d i

def factorizations (d : Generators) (n : ℕ) : Set Factorization :=
  {z | eval d z = n}

abbrev Factorizations (d : Generators) (n : ℕ) :=
  {z : Factorization // z ∈ factorizations d n}

def support (z : Factorization) : Set (Fin 4) := {i | 0 < z i}

/-- The graph has the factorization fiber itself as its vertex type. -/
def factorizationGraph (d : Generators) (n : ℕ) : SimpleGraph (Factorizations d n) :=
  SimpleGraph.fromRel (fun z w => ∃ i : Fin 4, 0 < z.val i ∧ 0 < w.val i)

/-- R-chains remain inside the factorization fiber. -/
def RRelated (d : Generators) (n : ℕ) (z w : Factorizations d n) : Prop :=
  (factorizationGraph d n).Reachable z w

def Betti (d : Generators) : Set ℕ :=
  {n | n ∈ semigroup d ∧ ∃ z w : Factorizations d n, ¬ RRelated d n z w}

/-- Positivity, gcd one, and minimal generation give embedding dimension four. -/
def IsNumericalGeneratingTuple (d : Generators) : Prop :=
  (∀ i : Fin 4, 0 < d i) ∧
  Nat.gcd (Nat.gcd (d 0) (d 1)) (Nat.gcd (d 2) (d 3)) = 1 ∧
  ∀ i : Fin 4, d i ∉ AddSubmonoid.closure (d '' {j : Fin 4 | j ≠ i})

/-- The least positive coefficient a_ii; off-diagonal coefficients are the entries of z. -/
def IsCriticalCoefficient (d : Generators) (i : Fin 4) (a : ℕ) : Prop :=
  IsLeast {n : ℕ | 0 < n ∧ ∃ z : Factorization, z i = 0 ∧ eval d z = n * d i} a

def IsCriticalData (d : Generators) (a : CriticalCoefficients) : Prop :=
  ∀ i : Fin 4, IsCriticalCoefficient d i (a i)

/-- The least positive d_m-positive coefficient b_(m,ii), with i distinct from m. -/
def IsPositiveCriticalCoefficient (d : Generators) (m i : Fin 4) (b : ℕ) : Prop :=
  IsLeast {n : ℕ | 0 < n ∧ ∃ z : Factorization,
    z i = 0 ∧ 0 < z m ∧ eval d z = n * d i} b

/-- The diagonal entries b_(m,mm) are unused and fixed to zero. -/
def IsPositiveCriticalData (d : Generators) (b : PositiveCriticalCoefficients) : Prop :=
  (∀ m : Fin 4, b m m = 0) ∧
  ∀ m i : Fin 4, i ≠ m → IsPositiveCriticalCoefficient d m i (b m i)

/-- A source minimal relation, including a particular allowed choice of a_ij. -/
def IsMinimalRelation (d : Generators) (i : Fin 4) (a : ℕ)
    (z : Factorization) : Prop :=
  IsCriticalCoefficient d i a ∧ z i = 0 ∧ eval d z = a * d i

/-- A source d_m-positive minimal relation, including a particular allowed choice of b_(m,ij). -/
def IsPositiveMinimalRelation (d : Generators) (m i : Fin 4) (b : ℕ)
    (z : Factorization) : Prop :=
  i ≠ m ∧ IsPositiveCriticalCoefficient d m i b ∧
    z i = 0 ∧ 0 < z m ∧ eval d z = b * d i

/-- For m=0 the source abbreviates b_(0,ii) to b_ii. -/
def boundaryCoefficient (b : PositiveCriticalCoefficients) (i : Fin 4) : ℕ := b 0 i

def IsPrimary (a : CriticalCoefficients) (b : PositiveCriticalCoefficients) : Prop :=
  ∃ m i j : Fin 4, i ≠ m ∧ j ≠ m ∧ i ≠ j ∧ a i = b m i ∧ a j = b m j

def pure (i : Fin 4) (n : ℕ) : Factorization := fun j => if j = i then n else 0

/-- The ordering convention for secondary semigroups, including the two distinct critical degrees. -/
def HasSecondaryOrdering (d : Generators) (a : CriticalCoefficients) : Prop :=
  a 0 * d 0 ≠ a 2 * d 2 ∧
  factorizations d (a 0 * d 0) = {pure 0 (a 0), pure 1 (a 1)} ∧
  factorizations d (a 1 * d 1) = {pure 0 (a 0), pure 1 (a 1)} ∧
  factorizations d (a 2 * d 2) = {pure 2 (a 2), pure 3 (a 3)} ∧
  factorizations d (a 3 * d 3) = {pure 2 (a 2), pure 3 (a 3)}

def IsOrderedSecondary (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) : Prop :=
  IsNumericalGeneratingTuple d ∧ IsCriticalData d a ∧ IsPositiveCriticalData d b ∧
    ¬ IsPrimary a b ∧ HasSecondaryOrdering d a

def leftPair (d : Generators) (n : ℕ) : Set (Factorizations d n) :=
  {z | z.val 2 = 0 ∧ z.val 3 = 0}

def rightPair (d : Generators) (n : ℕ) : Set (Factorizations d n) :=
  {z | z.val 0 = 0 ∧ z.val 1 = 0}

/-- The two components are exactly the fibers supported on the two critical pairs. -/
def HasExactlyPairComponents (d : Generators) (n : ℕ) : Prop :=
  ∃ c₀ c₁ : (factorizationGraph d n).ConnectedComponent,
    c₀ ≠ c₁ ∧ c₀.supp = leftPair d n ∧ c₁.supp = rightPair d n ∧
      ∀ c : (factorizationGraph d n).ConnectedComponent, c = c₀ ∨ c = c₁

/-- Source coefficient existence is asserted, so the implicit minimum objects cannot be absent. -/
def claim : Prop :=
  (∀ d : Generators, IsNumericalGeneratingTuple d →
    ∃ (a : CriticalCoefficients) (b : PositiveCriticalCoefficients),
      IsCriticalData d a ∧ IsPositiveCriticalData d b) ∧
  ∀ (d : Generators) (a : CriticalCoefficients) (b : PositiveCriticalCoefficients),
    IsOrderedSecondary d a b →
    ∀ i : Fin 4, (i = 2 ∨ i = 3) →
      let p : ℕ := Nat.gcd (d 0) (d 1)
      let r : ℕ := p / Nat.gcd p (d i)
      let n : ℕ := boundaryCoefficient b i * d i
      (n ∈ Betti d ↔ boundaryCoefficient b i = r) ∧
      (boundaryCoefficient b i = r → HasExactlyPairComponents d n) ∧
      (boundaryCoefficient b i ≠ r → (factorizationGraph d n).Connected)

end D5.NumberTheory.NumericalSemigroups.SecondaryBoundaryBetti

namespace D5.NumberTheory.NumericalSemigroups.SecondaryBoundaryBetti

private theorem eval_pure (d : Generators) (i : Fin 4) (n : ℕ) :
    eval d (pure i n) = n * d i := by
  classical
  simp [eval, pure]

private theorem eval_add (d : Generators) (z w : Factorization) :
    eval d (z + w) = eval d z + eval d w := by
  simp [eval, add_mul, Finset.sum_add_distrib]

private theorem eval_mem (d : Generators) (z : Factorization) :
    eval d z ∈ semigroup d := by
  apply AddSubmonoid.sum_mem
  intro i _
  simpa [nsmul_eq_mul] using
    (semigroup d).nsmul_mem (AddSubmonoid.subset_closure (Set.mem_range_self i)) (z i)

private theorem exists_positive_coefficient (d : Generators) (hd : ∀ i, 0 < d i)
    (m i : Fin 4) (hi : i ≠ m) :
    ∃ b, IsPositiveCriticalCoefficient d m i b := by
  classical
  have hs : {n : ℕ | 0 < n ∧ ∃ z : Factorization,
      z i = 0 ∧ 0 < z m ∧ eval d z = n * d i}.Nonempty := by
    refine ⟨d m, hd m, pure m (d i), ?_, ?_, ?_⟩
    · simp [pure, hi]
    · simpa [pure] using hd i
    · rw [eval_pure, Nat.mul_comm]
  exact ⟨_, hs.isLeast_natFind⟩

private theorem coefficient_data_exists (d : Generators) (hd : ∀ i, 0 < d i) :
    ∃ (a : CriticalCoefficients) (b : PositiveCriticalCoefficients),
      IsCriticalData d a ∧ IsPositiveCriticalData d b := by
  classical
  have ha : ∀ i : Fin 4, ∃ a, IsCriticalCoefficient d i a := by
    intro i
    let m : Fin 4 := if i = 0 then 1 else 0
    have hm : i ≠ m := by dsimp [m]; split_ifs <;> simp_all
    obtain ⟨b, hb⟩ := exists_positive_coefficient d hd m i hm
    have hs : {n : ℕ | 0 < n ∧ ∃ z : Factorization,
        z i = 0 ∧ eval d z = n * d i}.Nonempty :=
      ⟨b, hb.1.1, hb.1.2.choose, hb.1.2.choose_spec.1,
        hb.1.2.choose_spec.2.2⟩
    exact ⟨_, hs.isLeast_natFind⟩
  choose a ha using ha
  have hb : ∀ m i : Fin 4, ∃ b, (i = m → b = 0) ∧
      (i ≠ m → IsPositiveCriticalCoefficient d m i b) := by
    intro m i
    by_cases hi : i = m
    · exact ⟨0, fun _ => rfl, fun h => (h hi).elim⟩
    · obtain ⟨b, hb⟩ := exists_positive_coefficient d hd m i hi
      exact ⟨b, fun h => (hi h).elim, fun _ => hb⟩
  choose b hb using hb
  exact ⟨a, b, ha, (fun m => (hb m m).1 rfl), fun m i hi => (hb m i).2 hi⟩

/-- Deleting the forbidden coordinate contradicts the positive coefficient's leastness.
The statement ranges over every factorization, independently of the chosen relation witness. -/
theorem positive_minimum_excludes_coordinate (d : Generators) (hd : ∀ j, 0 < d j)
    (m i : Fin 4) (hi : i ≠ m) (b : ℕ)
    (hb : IsPositiveCriticalCoefficient d m i b) (z : Factorization)
    (hz : eval d z = b * d i) (hm : 0 < z m) : z i = 0 := by
  classical
  by_contra hzi
  have hzip : 0 < z i := Nat.pos_of_ne_zero hzi
  let w : Factorization := Function.update z i 0
  have hw : eval d w + z i * d i = eval d z := by
    simp only [eval]
    rw [← Finset.sum_erase_add _ _ (Finset.mem_univ i)]
    rw [← Finset.sum_erase_add _ _ (Finset.mem_univ i)]
    simp only [w, Function.update_self, zero_mul, add_zero]
    congr 1
    apply Finset.sum_congr rfl
    intro j hj
    rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
  have hwm : 0 < w m := by simpa [w, Function.update_of_ne hi.symm] using hm
  have hepos : 0 < eval d w := by
    have hle := Finset.single_le_sum (fun j (_ : j ∈ Finset.univ) => Nat.zero_le (w j * d j))
      (Finset.mem_univ m)
    exact lt_of_lt_of_le (Nat.mul_pos hwm (hd m)) hle
  have hzib : z i < b := by nlinarith [hd i]
  have hwb : eval d w = (b - z i) * d i := by
    rw [Nat.sub_mul]
    omega
  have hlt := hb.2 ⟨Nat.sub_pos_of_lt hzib, w, by simp [w], hwm, hwb⟩
  omega

private theorem pair_normalization (d : Generators) (hd : ∀ i, 0 < d i)
    (x y : Fin 4) (hxy : x ≠ y) (A B : ℕ)
    (hA : IsCriticalCoefficient d x A)
    (hf : factorizations d (A * d x) = {pure x A, pure y B}) :
    A = d y / Nat.gcd (d x) (d y) ∧
      B = d x / Nat.gcd (d x) (d y) := by
  have hg : 0 < Nat.gcd (d x) (d y) := Nat.gcd_pos_of_pos_left _ (hd x)
  let g := Nat.gcd (d x) (d y)
  let u := d x / g
  let v := d y / g
  have hD : g * u = d x := Nat.mul_div_cancel' (Nat.gcd_dvd_left _ _)
  have hE : g * v = d y := Nat.mul_div_cancel' (Nat.gcd_dvd_right _ _)
  have hu : 0 < u := Nat.div_gcd_pos_of_pos_left _ (hd x)
  have hv : 0 < v := Nat.div_gcd_pos_of_pos_right _ (hd y)
  have hcop : Nat.Coprime u v := Nat.coprime_div_gcd_div_gcd hg
  have hpair : B * d y = A * d x := by
    have hmem : pure y B ∈ factorizations d (A * d x) := by rw [hf]; simp
    exact (eval_pure d y B).symm.trans hmem
  have hpair' : A * u = B * v := by nlinarith
  have hvA : v ∣ A := (hcop.symm.dvd_mul_right).mp ⟨B, by nlinarith only [hpair']⟩
  have hlow : v ≤ A := Nat.le_of_dvd hA.1.1 hvA
  have hupp : A ≤ v := hA.2 ⟨hv, pure y u, by simp [pure, hxy], by
    rw [eval_pure]; nlinarith⟩
  have hAv : A = v := le_antisymm hupp hlow
  have hBu : B = u := by nlinarith
  exact ⟨hAv, hBu⟩

/-- The complete two-point critical fiber forces a representation positive at both pair
coordinates of the first gcd-compatible multiple of any other generator.
This is the positive-representation argument attributed to public issue 28454. -/
theorem critical_pair_positive_representation (d : Generators) (hd : ∀ i, 0 < d i)
    (x y c : Fin 4) (hxy : x ≠ y) (hcx : c ≠ x) (hcy : c ≠ y)
    (A B : ℕ) (hA : IsCriticalCoefficient d x A)
    (hf : factorizations d (A * d x) = {pure x A, pure y B}) :
    ∃ α β : ℕ, 0 < α ∧ 0 < β ∧
      (Nat.gcd (d x) (d y) / Nat.gcd (Nat.gcd (d x) (d y)) (d c)) * d c =
        α * d x + β * d y := by
  classical
  let g := Nat.gcd (d x) (d y)
  let u := d x / g
  let v := d y / g
  let h := Nat.gcd g (d c)
  let r := g / h
  let w := d c / h
  have hg : 0 < g := Nat.gcd_pos_of_pos_left _ (hd x)
  have hh : 0 < h := Nat.gcd_pos_of_pos_left _ hg
  have hu : 0 < u := Nat.div_gcd_pos_of_pos_left _ (hd x)
  have hv : 0 < v := Nat.div_gcd_pos_of_pos_right _ (hd y)
  have hr : 0 < r := Nat.div_gcd_pos_of_pos_left _ hg
  have hD : g * u = d x := Nat.mul_div_cancel' (Nat.gcd_dvd_left _ _)
  have hE : g * v = d y := Nat.mul_div_cancel' (Nat.gcd_dvd_right _ _)
  have hrg : h * r = g := Nat.mul_div_cancel' (Nat.gcd_dvd_left _ _)
  have hwc : h * w = d c := Nat.mul_div_cancel' (Nat.gcd_dvd_right _ _)
  have hrc : r * d c = g * w := by nlinarith
  have hAv : A = v := (pair_normalization d hd x y hxy A B hA hf).1
  have hcop : Nat.Coprime u v := Nat.coprime_div_gcd_div_gcd hg
  obtain ⟨a, hav, hamod⟩ := Nat.exists_mul_mod_eq_of_coprime w hcop (Nat.ne_of_gt hv)
  let α := if a = 0 then v else a
  have hα : 0 < α ∧ α ≤ v := by dsimp [α]; split_ifs <;> omega
  have hmod : Nat.ModEq v (α * u) w := by
    dsimp [Nat.ModEq, α]
    split_ifs with ha
    · simpa [ha] using hamod
    · simpa [Nat.mul_comm] using hamod
  by_cases hlt : α * u < w
  · obtain ⟨β, hβ⟩ := hmod.dvd'
    have heq : w = α * u + β * v := by rw [Nat.mul_comm v β] at hβ; omega
    have hβp : 0 < β := by nlinarith
    refine ⟨α, β, hα.1, hβp, ?_⟩
    change r * d c = _
    calc
      r * d c = g * w := hrc
      _ = g * (α * u + β * v) := congrArg (g * ·) heq
      _ = α * (g * u) + β * (g * v) := by ring
      _ = α * d x + β * d y := by rw [hD, hE]
  · obtain ⟨β, hβ⟩ := hmod.symm.dvd'
    have heq : α * u = w + β * v := by rw [Nat.mul_comm v β] at hβ; omega
    let z : Factorization := pure c r + pure x (v - α) + pure y β
    have hz : z ∈ factorizations d (A * d x) := by
      change eval d z = A * d x
      simp only [z, eval_add, eval_pure]
      have hsub : v - α + α = v := Nat.sub_add_cancel hα.2
      rw [hAv]
      calc
        r * d c + (v - α) * d x + β * d y =
            g * (w + (v - α) * u + β * v) := by rw [hrc, ← hD, ← hE]; ring
        _ = g * (v * u) := by
          congr 1
          have hs := congrArg (· * u) hsub
          simp only [Nat.add_mul] at hs
          nlinarith only [heq, hs]
        _ = v * d x := by rw [← hD]; ring
    have hzc : z c = r := by simp [z, pure, hcx, hcy]
    rw [hf] at hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with hz | hz
    · have hc := congrFun hz c
      simp [pure, hcx, hzc] at hc
      omega
    · have hc := congrFun hz c
      simp [pure, hcy, hzc] at hc
      omega

private theorem right_fiber_vanishes (d : Generators) (a : CriticalCoefficients)
    (ho : HasSecondaryOrdering d a) (i : Fin 4) (hi : i = 2 ∨ i = 3)
    (z : Factorization) (hz : eval d z = a i * d i) : z 0 = 0 ∧ z 1 = 0 := by
  have hmem : z ∈ factorizations d (a i * d i) := hz
  rcases hi with rfl | rfl
  · rw [ho.2.2.2.1] at hmem
    rcases hmem with h | h <;> simp_all [pure]
  · rw [ho.2.2.2.2] at hmem
    rcases hmem with h | h <;> simp_all [pure]

/-- The positive boundary coefficient lies strictly above its critical coefficient and
at most at the first left-pair gcd-compatible multiple, for either right-pair index. -/
theorem secondary_boundary_bounds (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) (hs : IsOrderedSecondary d a b)
    (i : Fin 4) (hi : i = 2 ∨ i = 3) :
    a i < boundaryCoefficient b i ∧
      boundaryCoefficient b i ≤ Nat.gcd (d 0) (d 1) /
        Nat.gcd (Nat.gcd (d 0) (d 1)) (d i) := by
  classical
  have hi0 : i ≠ 0 := by rcases hi with rfl | rfl <;> decide
  have hi1 : i ≠ 1 := by rcases hi with rfl | rfl <;> decide
  have hb := hs.2.2.1.2 0 i hi0
  obtain ⟨z, hzi, hz0, hz⟩ := hb.1.2
  have hle : a i ≤ b 0 i := (hs.2.1 i).2 ⟨hb.1.1, z, hzi, hz⟩
  have hne : a i ≠ b 0 i := by
    intro heq
    have hvan := right_fiber_vanishes d a hs.2.2.2.2 i hi z (by simpa [heq] using hz)
    omega
  refine ⟨by change a i < b 0 i; omega, ?_⟩
  obtain ⟨α, β, hα, hβ, heq⟩ := critical_pair_positive_representation d hs.1.1
    0 1 i (by decide) hi0 hi1 (a 0) (a 1) (hs.2.1 0) hs.2.2.2.2.2.1
  apply hb.2
  refine ⟨Nat.div_gcd_pos_of_pos_left _ (Nat.gcd_pos_of_pos_left _ (hs.1.1 0)),
    pure 0 α + pure 1 β, ?_, ?_, ?_⟩
  · simp [pure, hi0, hi1]
  · simpa [pure] using hα
  · simpa only [eval_add, eval_pure] using heq.symm

private theorem left_exchange_bound (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) (hs : IsOrderedSecondary d a b) :
    a 1 < Nat.gcd (d 2) (d 3) / Nat.gcd (Nat.gcd (d 2) (d 3)) (d 1) := by
  classical
  obtain ⟨α, β, hα, hβ, heq⟩ := critical_pair_positive_representation d hs.1.1
    2 3 1 (by decide) (by decide) (by decide) (a 2) (a 3)
    (hs.2.1 2) hs.2.2.2.2.2.2.2.1
  let r := Nat.gcd (d 2) (d 3) / Nat.gcd (Nat.gcd (d 2) (d 3)) (d 1)
  let z : Factorization := pure 2 α + pure 3 β
  have hz : eval d z = r * d 1 := by simpa only [z, eval_add, eval_pure] using heq.symm
  have hle : a 1 ≤ r := (hs.2.1 1).2
    ⟨Nat.div_gcd_pos_of_pos_left _ (Nat.gcd_pos_of_pos_left _ (hs.1.1 2)), z,
      by simp [z, pure], hz⟩
  have hne : a 1 ≠ r := by
    intro h
    have hm : z ∈ factorizations d (a 1 * d 1) := by
      change eval d z = a 1 * d 1
      simpa [h] using hz
    rw [hs.2.2.2.2.2.2.1] at hm
    have hz2 : z 2 = α := by simp [z, pure]
    rcases hm with hm | hm <;> have hh := congrFun hm 2 <;> simp [pure, hz2] at hh <;> omega
  omega

private theorem eval_four (d : Generators) (z : Factorization) :
    eval d z = z 0 * d 0 + z 1 * d 1 + z 2 * d 2 + z 3 * d 3 := by
  simp [eval, Fin.sum_univ_succ]
  ring

private theorem threshold_divides_iff (p c k : ℕ) (hp : 0 < p) :
    p / Nat.gcd p c ∣ k ↔ p ∣ k * c := by
  rw [Nat.div_dvd_iff_dvd_mul (Nat.gcd_dvd_left p c) (Nat.gcd_pos_of_pos_left _ hp)]
  simpa only [Nat.mul_comm] using (Nat.dvd_gcd_mul_iff_dvd_mul (k := p) (n := c) (m := k))

private theorem pair_degrees (d : Generators) (a : CriticalCoefficients)
    (ho : HasSecondaryOrdering d a) :
    a 0 * d 0 = a 1 * d 1 ∧ a 2 * d 2 = a 3 * d 3 := by
  constructor
  · have h : pure 1 (a 1) ∈ factorizations d (a 0 * d 0) := by rw [ho.2.1]; simp
    exact h.symm.trans (eval_pure d 1 (a 1))
  · have h : pure 3 (a 3) ∈ factorizations d (a 2 * d 2) := by rw [ho.2.2.2.1]; simp
    exact h.symm.trans (eval_pure d 3 (a 3))

private theorem move_left (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) (hs : IsOrderedSecondary d a b)
    (n : ℕ) (hq : Nat.gcd (d 2) (d 3) ∣ n) (z : Factorization)
    (hz : eval d z = n) (hl : 0 < z 0 ∨ 0 < z 1) :
    ∃ w : Factorization, eval d w = n ∧ 0 < w 0 ∧ w 2 = z 2 ∧ w 3 = z 3 := by
  by_cases h0 : 0 < z 0
  · exact ⟨z, hz, h0, rfl, rfl⟩
  have hz0 : z 0 = 0 := by omega
  have hz1 : 0 < z 1 := hl.resolve_left h0
  have hdright : Nat.gcd (d 2) (d 3) ∣ z 2 * d 2 + z 3 * d 3 :=
    dvd_add (dvd_mul_of_dvd_right (Nat.gcd_dvd_left _ _) _) 
      (dvd_mul_of_dvd_right (Nat.gcd_dvd_right _ _) _)
  have hq1 : Nat.gcd (d 2) (d 3) ∣ z 1 * d 1 := by
    have hn : n = z 1 * d 1 + (z 2 * d 2 + z 3 * d 3) := by
      rw [← hz, eval_four, hz0]; simp; ring
    rw [hn] at hq
    exact (Nat.dvd_add_iff_left hdright).mpr hq
  have hs1 : Nat.gcd (d 2) (d 3) / Nat.gcd (Nat.gcd (d 2) (d 3)) (d 1) ∣ z 1 :=
    (threshold_divides_iff _ _ _ (Nat.gcd_pos_of_pos_left _ (hs.1.1 2))).mpr hq1
  have hle : a 1 ≤ z 1 := le_trans (Nat.le_of_lt (left_exchange_bound d a b hs))
    (Nat.le_of_dvd hz1 hs1)
  let w : Factorization := ![a 0, z 1 - a 1, z 2, z 3]
  refine ⟨w, ?_, ?_, by simp [w], by simp [w]⟩
  · rw [eval_four] at hz ⊢
    simp only [w, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
    have hsub := congrArg (· * d 1) (Nat.sub_add_cancel hle)
    simp only [Nat.add_mul] at hsub
    have hpair := (pair_degrees d a hs.2.2.2.2).1
    nlinarith only [hz, hsub, hpair, hz0]
  · simpa [w] using (hs.2.1 0).1.1

/-- At equality with the gcd threshold, every factorization is supported entirely on
one critical pair. There are no mixed-support vertices in the full fiber. -/
theorem equality_excludes_mixed (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) (hs : IsOrderedSecondary d a b)
    (i : Fin 4) (hi : i = 2 ∨ i = 3)
    (heq : b 0 i = Nat.gcd (d 0) (d 1) / Nat.gcd (Nat.gcd (d 0) (d 1)) (d i))
    (z : Factorization) (hz : eval d z = b 0 i * d i) :
    (z 0 = 0 ∧ z 1 = 0) ∨ (z 2 = 0 ∧ z 3 = 0) := by
  classical
  by_contra hn
  have hl : 0 < z 0 ∨ 0 < z 1 := by omega
  have hr : 0 < z 2 ∨ 0 < z 3 := by omega
  have hq : Nat.gcd (d 2) (d 3) ∣ b 0 i * d i := by
    rcases hi with rfl | rfl
    · exact dvd_mul_of_dvd_right (Nat.gcd_dvd_left _ _) _
    · exact dvd_mul_of_dvd_right (Nat.gcd_dvd_right _ _) _
  obtain ⟨w, hw, hw0, hw2, hw3⟩ := move_left d a b hs _ hq z hz hl
  have hi0 : i ≠ 0 := by rcases hi with rfl | rfl <;> decide
  have hwi := positive_minimum_excludes_coordinate d hs.1.1 0 i hi0 _
    (hs.2.2.1.2 0 i hi0) w hw hw0
  have hp : 0 < Nat.gcd (d 0) (d 1) := Nat.gcd_pos_of_pos_left _ (hs.1.1 0)
  have hpn : Nat.gcd (d 0) (d 1) ∣ b 0 i * d i :=
    (threshold_divides_iff _ _ _ hp).mp (by rw [heq])
  have hdleft : Nat.gcd (d 0) (d 1) ∣ w 0 * d 0 + w 1 * d 1 :=
    dvd_add (dvd_mul_of_dvd_right (Nat.gcd_dvd_left _ _) _)
      (dvd_mul_of_dvd_right (Nat.gcd_dvd_right _ _) _)
  have hpair := (pair_degrees d a hs.2.2.2.2).2
  rcases hi with rfl | rfl
  · have hw3p : 0 < w 3 := by omega
    have hd3 : Nat.gcd (d 0) (d 1) ∣ w 3 * d 3 := by
      have he : b 0 2 * d 2 = (w 0 * d 0 + w 1 * d 1) + w 3 * d 3 := by
        rw [← hw, eval_four, hwi]; simp
      rw [he] at hpn
      exact (Nat.dvd_add_iff_right hdleft).mpr hpn
    have hr3 := (threshold_divides_iff _ _ _ hp).mpr hd3
    have hbound := secondary_boundary_bounds d a b hs 3 (Or.inr rfl)
    have hle : a 3 ≤ w 3 := by
      have := Nat.le_of_dvd hw3p hr3
      change a 3 < b 0 3 ∧ b 0 3 ≤ _ at hbound
      omega
    let v : Factorization := ![w 0, w 1, a 2, w 3 - a 3]
    have hv : eval d v = b 0 2 * d 2 := by
      rw [eval_four] at hw ⊢
      simp only [v, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
      have hsub := congrArg (· * d 3) (Nat.sub_add_cancel hle)
      simp only [Nat.add_mul] at hsub
      nlinarith only [hw, hsub, hpair, hwi]
    have hv2 := positive_minimum_excludes_coordinate d hs.1.1 0 2 (by decide) _
      (hs.2.2.1.2 0 2 (by decide)) v hv (by simpa [v] using hw0)
    have ha2 := (hs.2.1 2).1.1
    have hzero : a 2 = 0 := by simpa [v] using hv2
    omega
  · have hw2p : 0 < w 2 := by omega
    have hd2 : Nat.gcd (d 0) (d 1) ∣ w 2 * d 2 := by
      have he : b 0 3 * d 3 = (w 0 * d 0 + w 1 * d 1) + w 2 * d 2 := by
        rw [← hw, eval_four, hwi]; simp
      rw [he] at hpn
      exact (Nat.dvd_add_iff_right hdleft).mpr hpn
    have hr2 := (threshold_divides_iff _ _ _ hp).mpr hd2
    have hbound := secondary_boundary_bounds d a b hs 2 (Or.inl rfl)
    have hle : a 2 ≤ w 2 := by
      have := Nat.le_of_dvd hw2p hr2
      change a 2 < b 0 2 ∧ b 0 2 ≤ _ at hbound
      omega
    let v : Factorization := ![w 0, w 1, w 2 - a 2, a 3]
    have hv : eval d v = b 0 3 * d 3 := by
      rw [eval_four] at hw ⊢
      simp only [v, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons]
      have hsub := congrArg (· * d 2) (Nat.sub_add_cancel hle)
      simp only [Nat.add_mul] at hsub
      nlinarith only [hw, hsub, hpair, hwi]
    have hv3 := positive_minimum_excludes_coordinate d hs.1.1 0 3 (by decide) _
      (hs.2.2.1.2 0 3 (by decide)) v hv (by simpa [v] using hw0)
    have ha3 := (hs.2.1 3).1.1
    have hzero : a 3 = 0 := by simpa [v] using hv3
    omega

private theorem shared_reachable (d : Generators) (n : ℕ)
    (z w : Factorizations d n) (h : ∃ k, 0 < z.val k ∧ 0 < w.val k) :
    (factorizationGraph d n).Reachable z w := by
  by_cases he : z = w
  · subst w; exact .rfl
  · apply SimpleGraph.Adj.reachable
    rw [factorizationGraph, SimpleGraph.fromRel_adj]
    exact ⟨he, Or.inl h⟩

private theorem right_hub (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) (hs : IsOrderedSecondary d a b)
    (i : Fin 4) (hi : i = 2 ∨ i = 3) :
    ∃ w : Factorizations d (b 0 i * d i),
      w.val 0 = 0 ∧ w.val 1 = 0 ∧ 0 < w.val 2 ∧ 0 < w.val 3 := by
  have hbound := (secondary_boundary_bounds d a b hs i hi).1
  change a i < b 0 i at hbound
  have hpair := (pair_degrees d a hs.2.2.2.2).2
  rcases hi with rfl | rfl
  · let z : Factorization := ![0,0,b 0 2 - a 2,a 3]
    have hz : eval d z = b 0 2 * d 2 := by
      rw [eval_four]; simp only [z, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons, zero_mul,
        zero_add]
      have hh := congrArg (· * d 2) (Nat.sub_add_cancel (Nat.le_of_lt hbound))
      simp only [Nat.add_mul] at hh
      nlinarith only [hh, hpair]
    exact ⟨⟨z,hz⟩, by simp [z], by simp [z], by simpa [z] using Nat.sub_pos_of_lt hbound,
      by simpa [z] using (hs.2.1 3).1.1⟩
  · let z : Factorization := ![0,0,a 2,b 0 3 - a 3]
    have hz : eval d z = b 0 3 * d 3 := by
      rw [eval_four]; simp only [z, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.head_cons, Matrix.tail_cons, zero_mul,
        zero_add]
      have hh := congrArg (· * d 3) (Nat.sub_add_cancel (Nat.le_of_lt hbound))
      simp only [Nat.add_mul] at hh
      nlinarith only [hh, hpair]
    exact ⟨⟨z,hz⟩, by simp [z], by simp [z], by simpa [z] using (hs.2.1 2).1.1,
      by simpa [z] using Nat.sub_pos_of_lt hbound⟩

private theorem strict_connected (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) (hs : IsOrderedSecondary d a b)
    (i : Fin 4) (hi : i = 2 ∨ i = 3)
    (hne : b 0 i ≠ Nat.gcd (d 0) (d 1) / Nat.gcd (Nat.gcd (d 0) (d 1)) (d i)) :
    (factorizationGraph d (b 0 i * d i)).Connected := by
  obtain ⟨w, hw0, hw1, hw2, hw3⟩ := right_hub d a b hs i hi
  rw [SimpleGraph.connected_iff_exists_forall_reachable]
  refine ⟨w, fun z => ?_⟩
  have hzright : 0 < z.val 2 ∨ 0 < z.val 3 := by
    by_contra hn
    have hz2 : z.val 2 = 0 := by omega
    have hz3 : z.val 3 = 0 := by omega
    have hp : Nat.gcd (d 0) (d 1) ∣ b 0 i * d i := by
      have hz := z.property
      change eval d z.val = b 0 i * d i at hz
      rw [eval_four, hz2, hz3] at hz
      simp only [zero_mul, add_zero] at hz
      rw [← hz]
      exact dvd_add (dvd_mul_of_dvd_right (Nat.gcd_dvd_left _ _) _)
        (dvd_mul_of_dvd_right (Nat.gcd_dvd_right _ _) _)
    have hr := (threshold_divides_iff _ _ _ (Nat.gcd_pos_of_pos_left _ (hs.1.1 0))).mpr hp
    have hi0 : i ≠ 0 := by rcases hi with rfl | rfl <;> decide
    have hpos := (hs.2.2.1.2 0 i hi0).1.1
    have hlow := Nat.le_of_dvd hpos hr
    have hupp := (secondary_boundary_bounds d a b hs i hi).2
    exact hne (Nat.le_antisymm hupp hlow)
  apply shared_reachable
  rcases hzright with hz | hz
  · exact ⟨2, hw2, hz⟩
  · exact ⟨3, hw3, hz⟩

private theorem pair_components_of_hubs (d : Generators) (n : ℕ)
    (l r : Factorizations d n)
    (hl : 0 < l.val 0 ∧ 0 < l.val 1 ∧ l.val 2 = 0 ∧ l.val 3 = 0)
    (hr : r.val 0 = 0 ∧ r.val 1 = 0 ∧ 0 < r.val 2 ∧ 0 < r.val 3)
    (hn : 0 < n)
    (hparts : ∀ z : Factorizations d n, z ∈ leftPair d n ∨ z ∈ rightPair d n) :
    HasExactlyPairComponents d n ∧ ¬ RRelated d n l r := by
  classical
  let G := factorizationGraph d n
  have hnonzero (z : Factorizations d n) :
      0 < z.val 0 ∨ 0 < z.val 1 ∨ 0 < z.val 2 ∨ 0 < z.val 3 := by
    have hz := z.property
    change eval d z.val = n at hz
    rw [eval_four] at hz
    by_contra h; push_neg at h
    have h0 : z.val 0 = 0 := by omega
    have h1 : z.val 1 = 0 := by omega
    have h2 : z.val 2 = 0 := by omega
    have h3 : z.val 3 = 0 := by omega
    simp [h0,h1,h2,h3] at hz
    omega
  have hleft (z : Factorizations d n) (hz : z ∈ leftPair d n) : G.Reachable z l := by
    apply shared_reachable
    have hpos := hnonzero z
    change z.val 2 = 0 ∧ z.val 3 = 0 at hz
    rcases (show 0 < z.val 0 ∨ 0 < z.val 1 by omega) with h | h
    · exact ⟨0,h,hl.1⟩
    · exact ⟨1,h,hl.2.1⟩
  have hright (z : Factorizations d n) (hz : z ∈ rightPair d n) : G.Reachable z r := by
    apply shared_reachable
    have hpos := hnonzero z
    change z.val 0 = 0 ∧ z.val 1 = 0 at hz
    rcases (show 0 < z.val 2 ∨ 0 < z.val 3 by omega) with h | h
    · exact ⟨2,h,hr.2.2.1⟩
    · exact ⟨3,h,hr.2.2.2⟩
  have hedge (z w : Factorizations d n) (hzw : G.Adj z w) :
      z ∈ leftPair d n ↔ w ∈ leftPair d n := by
    have hshared : ∃ k, 0 < z.val k ∧ 0 < w.val k := by
      change (factorizationGraph d n).Adj z w at hzw
      rw [factorizationGraph, SimpleGraph.fromRel_adj] at hzw
      rcases hzw.2 with h | h
      · exact h
      · obtain ⟨k,hk,hk'⟩ := h; exact ⟨k,hk',hk⟩
    have hpz := hparts z
    have hpw := hparts w
    change (z.val 2 = 0 ∧ z.val 3 = 0) ∨ (z.val 0 = 0 ∧ z.val 1 = 0) at hpz
    change (w.val 2 = 0 ∧ w.val 3 = 0) ∨ (w.val 0 = 0 ∧ w.val 1 = 0) at hpw
    change (z.val 2 = 0 ∧ z.val 3 = 0) ↔ (w.val 2 = 0 ∧ w.val 3 = 0)
    obtain ⟨k,hk,hk'⟩ := hshared
    fin_cases k
    · change 0 < z.val 0 at hk
      change 0 < w.val 0 at hk'
      omega
    · change 0 < z.val 1 at hk
      change 0 < w.val 1 at hk'
      omega
    · change 0 < z.val 2 at hk
      change 0 < w.val 2 at hk'
      omega
    · change 0 < z.val 3 at hk
      change 0 < w.val 3 at hk'
      omega
  have hreach (z w : Factorizations d n) (hzw : G.Reachable z w) :
      z ∈ leftPair d n ↔ w ∈ leftPair d n := by
    obtain ⟨p⟩ := hzw
    induction p with
    | nil => rfl
    | cons hadj _ ih => exact (hedge _ _ hadj).trans ih
  have hsep : ¬ G.Reachable l r := by
    intro h
    have hh := (hreach l r h).mp (show l ∈ leftPair d n from hl.2.2)
    change r.val 2 = 0 ∧ r.val 3 = 0 at hh
    omega
  have hlsupp : (G.connectedComponentMk l).supp = leftPair d n := by
    ext z
    rw [SimpleGraph.ConnectedComponent.mem_supp_iff, SimpleGraph.ConnectedComponent.eq]
    exact ⟨fun h => (hreach z l h).mpr hl.2.2, hleft z⟩
  have hrsupp : (G.connectedComponentMk r).supp = rightPair d n := by
    ext z
    rw [SimpleGraph.ConnectedComponent.mem_supp_iff, SimpleGraph.ConnectedComponent.eq]
    constructor
    · intro h
      rcases hparts z with hz | hz
      · exact (hsep ((hleft z hz).symm.trans h)).elim
      · exact hz
    · exact hright z
  refine ⟨⟨G.connectedComponentMk l, G.connectedComponentMk r, ?_, hlsupp, hrsupp, ?_⟩,
    hsep⟩
  · intro h; exact hsep (SimpleGraph.ConnectedComponent.exact h)
  · intro c
    induction c using SimpleGraph.ConnectedComponent.ind with
    | h z =>
      rcases hparts z with hz | hz
      · exact Or.inl (SimpleGraph.ConnectedComponent.sound (hleft z hz))
      · exact Or.inr (SimpleGraph.ConnectedComponent.sound (hright z hz))

private theorem equality_components (d : Generators) (a : CriticalCoefficients)
    (b : PositiveCriticalCoefficients) (hs : IsOrderedSecondary d a b)
    (i : Fin 4) (hi : i = 2 ∨ i = 3)
    (heq : b 0 i = Nat.gcd (d 0) (d 1) / Nat.gcd (Nat.gcd (d 0) (d 1)) (d i)) :
    HasExactlyPairComponents d (b 0 i * d i) ∧ b 0 i * d i ∈ Betti d := by
  classical
  have hi0 : i ≠ 0 := by rcases hi with rfl | rfl <;> decide
  have hi1 : i ≠ 1 := by rcases hi with rfl | rfl <;> decide
  obtain ⟨α, β, hα, hβ, he⟩ := critical_pair_positive_representation d hs.1.1
    0 1 i (by decide) hi0 hi1 (a 0) (a 1) (hs.2.1 0) hs.2.2.2.2.2.1
  let z : Factorization := pure 0 α + pure 1 β
  have hz : eval d z = b 0 i * d i := by rw [heq]; simpa [z,eval_add,eval_pure] using he.symm
  let l : Factorizations d (b 0 i * d i) := ⟨z,hz⟩
  obtain ⟨r,hr⟩ := right_hub d a b hs i hi
  have hn := Nat.mul_pos (hs.2.2.1.2 0 i hi0).1.1 (hs.1.1 i)
  have hpair := pair_components_of_hubs d _ l r
    (by simpa [l,z,pure] using And.intro hα hβ) hr hn (fun w => by
      have h := equality_excludes_mixed d a b hs i hi heq w.val w.property
      exact h.symm)
  refine ⟨hpair.1, ?_⟩
  refine ⟨?_, l, r, hpair.2⟩
  rw [← hz]
  exact eval_mem d z

/-- The complete registered assertion, including coefficient existence, both boundary
indices, the Betti criterion, exact nonempty pair components, and connected alternative. -/
theorem result : claim := by
  constructor
  · intro d hd
    exact coefficient_data_exists d hd.1
  · intro d a b hs i hi
    dsimp only
    have hc := strict_connected d a b hs i hi
    have he := equality_components d a b hs i hi
    refine ⟨?_, fun h => (he h).1, hc⟩
    constructor
    · intro hb
      by_contra hne
      obtain ⟨z,w,hnr⟩ := hb.2
      exact hnr ((hc hne).preconnected z w)
    · intro h
      exact (he h).2

end D5.NumberTheory.NumericalSemigroups.SecondaryBoundaryBetti

