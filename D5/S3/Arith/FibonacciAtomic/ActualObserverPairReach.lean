/- GID: D5/S3/Arith/FibonacciAtomic/ActualObserverPairReach
   generality: G
   mirror-B: none(waiver:unbounded-symbolic-proof)
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: Absorbing paired response reachability and exact all-history coarse factorization. -/

import D5.S3.Arith.FibonacciAtomic.ActualFiniteObserverAbsentElimination

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.FibonacciAtomic.ActualObserverPairReach

universe u

open ActualTreeReadoutAcquisition (Address Reply)
open ActualCoarseReadoutHistory (kappa kappa_hist)
open ActualFiniteObserverAbsentElimination
  (Observer RawHistory barStep responseState historyState historyAction)

variable {E : Type u} [Fintype E]

/-- The least paired relation generated by all coarse-equal raw replies.
No source, address, cache or execution predicate restricts a step. -/
inductive PairReach (M : Observer E) : E → E → Prop
  | initial : PairReach M M.e0 M.e0
  | step {e f : E} {y z : Reply} (prior : PairReach M e f)
      (same : kappa y = kappa z) :
      PairReach M (barStep M e y) (barStep M f z)

/-- Equality of actions on every pair in the generated relation. -/
def pairActionInvariant (M : Observer E) : Prop :=
  ∀ {e f : E}, PairReach M e f → M.action e = M.action f

/-- Coarsening a raw response word forgets only the branch/absent distinction. -/
def coarseResponseWord (word : List Reply) : List (Option Bool) := word.map kappa

/-- Equal-coarse words extend any generated pair, including absorbing rows. -/
theorem pairReach_response_words (M : Observer E) {e f : E}
    (prior : PairReach M e f) (w v : List Reply)
    (same : coarseResponseWord w = coarseResponseWord v) :
    PairReach M (responseState M e w) (responseState M f v) := by
  induction w generalizing e f v with
  | nil =>
    cases v with
    | nil => exact prior
    | cons z v => simp [coarseResponseWord] at same
  | cons y w ih =>
    cases v with
    | nil => simp [coarseResponseWord] at same
    | cons z v =>
      have parts : kappa y = kappa z ∧ coarseResponseWord w = coarseResponseWord v := by
        simpa only [coarseResponseWord, List.map_cons, List.cons.injEq] using same
      exact ih (PairReach.step prior parts.1) v parts.2

/-- A pair is generated exactly when two equal-coarse finite raw words
fold from the initial row to its components. -/
theorem pairReach_iff_equal_coarse_response_words (M : Observer E) (e f : E) :
    PairReach M e f ↔ ∃ w v : List Reply,
      responseState M M.e0 w = e ∧ responseState M M.e0 v = f ∧
      w.map kappa = v.map kappa := by
  constructor
  · intro reached
    induction reached with
    | initial => exact ⟨[], [], rfl, rfl, rfl⟩
    | @step e f y z prior same ih =>
      obtain ⟨w, v, left, right, coarse⟩ := ih
      refine ⟨w ++ [y], v ++ [z], ?_, ?_, ?_⟩
      · simpa only [responseState, List.foldl_append, List.foldl_cons,
          List.foldl_nil] using congrArg (fun e => barStep M e y) left
      · simpa only [responseState, List.foldl_append, List.foldl_cons,
          List.foldl_nil] using congrArg (fun f => barStep M f z) right
      · simp only [List.map_append, List.map_cons, List.map_nil, coarse, same]
  · rintro ⟨w, v, rfl, rfl, same⟩
    exact pairReach_response_words M PairReach.initial w v same

/-- The paired action condition is equivalent to coarse factorization on all
finite raw histories. Labels may be arbitrary, repeated or inconsistent, and
response words may continue after halting because barStep absorbs there. -/
theorem pairActionInvariant_iff_allHistoryFactorization (M : Observer E) :
    pairActionInvariant M ↔ Function.FactorsThrough (historyAction M) kappa_hist := by
  constructor
  · intro invariant h₁ h₂ same
    have words : (h₁.map Sigma.snd).map kappa = (h₂.map Sigma.snd).map kappa := by
      have projected := congrArg (List.map Sigma.snd) same
      simpa only [kappa_hist, List.map_map, Function.comp_def] using projected
    exact invariant ((pairReach_iff_equal_coarse_response_words M _ _).mpr
      ⟨h₁.map Sigma.snd, h₂.map Sigma.snd, rfl, rfl, words⟩)
  · intro factor e f reached
    obtain ⟨w, v, left, right, same⟩ :=
      (pairReach_iff_equal_coarse_response_words M e f).mp reached
    let encode : List Reply → RawHistory :=
      List.map (fun y => (⟨([] : Address), y⟩ : Sigma (fun _ : Address => Reply)))
    have histories : kappa_hist (encode w) = kappa_hist (encode v) := by
      have encoded := congrArg
        (List.map (fun y => (⟨([] : Address), y⟩ : Sigma (fun _ : Address => Option Bool))))
        same
      simpa only [encode, kappa_hist, List.map_map, Function.comp_def] using encoded
    have actions := factor histories
    simpa only [historyAction, historyState, encode, List.map_map,
      Function.comp_def, List.map_id', left, right] using actions

end D5.S3.Arith.FibonacciAtomic.ActualObserverPairReach
