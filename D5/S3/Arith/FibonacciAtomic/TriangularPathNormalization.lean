/- GID: D5/S3/Arith/FibonacciAtomic/TriangularPathNormalization
   generality: G
   mirror-B: D5/B/S3/Arith/FibonacciAtomic/TriangularPathNormalization
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: Canonical binary laws from arbitrary reduced triangular root paths. -/

import D5.S3.Arith.FibonacciAtomic.DyadicSupportLines
import Mathlib.Analysis.Real.OfDigits

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.FibonacciAtomic.TriangularPathNormalization

open scoped BigOperators

/-- The residual cylinder count and number of labels still sharing the anchor prefix. -/
structure State where
  r : ℕ
  e : ℕ

/-- A common one digit, or a zero anchor digit with a terminal block of labels. -/
inductive Action where
  | one
  | zero (h : ℕ)

/-- The successor in the reduced triangular graph. -/
def successor (s : State) : Action → State
  | .one => ⟨2 * s.r - s.e, s.e⟩
  | .zero h => ⟨2 * s.r - h, s.e - h⟩

/-- State bounds and the two admissible action conditions. -/
def Legal (m : ℕ) (s : State) (a : Action) : Prop :=
  0 < s.e ∧ s.r < s.e ∧ s.e ≤ m ∧
    match a with
    | .one => s.e ≤ 2 * s.r
    | .zero h => 2 * s.r < s.e ∧ h ≤ 2 * s.r

/-- An infinite legal path from (1,m); zero residual states retain their self-loop. -/
structure RootPath (m : ℕ) where
  state : ℕ → State
  action : ℕ → Action
  root : state 0 = ⟨1, m⟩
  legal : ∀ d, Legal m (state d) (action d)
  step : ∀ d, state (d + 1) = successor (state d) (action d)

/-- The anchor digit of an action. -/
def anchorDigit : Action → Fin 2
  | .one => 1
  | .zero _ => 0

/-- Label i represents the source label i+1. Labels outside the retained interval write zero. -/
def digit {m : ℕ} (γ : RootPath m) (i : Fin m) (d : ℕ) : Fin 2 :=
  if i.val < (γ.state d).e then
    match γ.action d with
    | .one => 1
    | .zero h => if (γ.state d).e - h ≤ i.val then 1 else 0
  else 0

/-- The law generated by the actual label columns. -/
noncomputable def probability {m : ℕ} (γ : RootPath m) (i : Fin m) : ℝ :=
  ∑' d : ℕ, (digit γ i d : ℝ) / (2 : ℝ) ^ (d + 1)

/-- The mass of the permanent anchor label. -/
noncomputable def anchorMass {m : ℕ} (γ : RootPath m) : ℝ :=
  ∑' d : ℕ, (anchorDigit (γ.action d) : ℝ) / (2 : ℝ) ^ (d + 1)

/-- Expected bit cost obtained from the layer residual cylinder counts. -/
noncomputable def pathCost {m : ℕ} (γ : RootPath m) : ℝ :=
  ∑' d : ℕ, ((γ.state d).r : ℝ) / (2 : ℝ) ^ d

/-- Integer value of the first D digits, including the empty prefix. -/
def binaryPrefix {m : ℕ} (γ : RootPath m) (i : Fin m) : ℕ → ℕ
  | 0 => 0
  | d + 1 => 2 * binaryPrefix γ i d + (digit γ i d).val

end D5.S3.Arith.FibonacciAtomic.TriangularPathNormalization
