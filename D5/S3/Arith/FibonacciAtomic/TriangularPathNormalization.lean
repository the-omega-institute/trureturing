/- GID: D5/S3/Arith/FibonacciAtomic/TriangularPathNormalization
   generality: G
   mirror-B: D5/B/S3/Arith/FibonacciAtomic/TriangularPathNormalization
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: Canonical binary laws from arbitrary reduced triangular root paths. -/

import D5.S3.Arith.FibonacciAtomic.DyadicSupportLines
import Mathlib.Analysis.Real.OfDigits

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.FibonacciAtomic.TriangularPathNormalization

open scoped BigOperators

/-- The residual cylinder count and number of labels still sharing the anchor prefix. -/
structure State where
  r : ℕ
  e : ℕ

/-- A common one digit, or a zero anchor digit with a terminal block of labels. -/
inductive Action where
  | one
  | zero (h : ℕ)

/-- The successor in the reduced triangular graph. -/
def successor (s : State) : Action → State
  | .one => ⟨2 * s.r - s.e, s.e⟩
  | .zero h => ⟨2 * s.r - h, s.e - h⟩

/-- State bounds and the two admissible action conditions. -/
def Legal (m : ℕ) (s : State) (a : Action) : Prop :=
  0 < s.e ∧ s.r < s.e ∧ s.e ≤ m ∧
    match a with
    | .one => s.e ≤ 2 * s.r
    | .zero h => 2 * s.r < s.e ∧ h ≤ 2 * s.r

/-- An infinite legal path from (1,m); zero residual states retain their self-loop. -/
structure RootPath (m : ℕ) where
  state : ℕ → State
  action : ℕ → Action
  root : state 0 = ⟨1, m⟩
  legal : ∀ d, Legal m (state d) (action d)
  step : ∀ d, state (d + 1) = successor (state d) (action d)

/-- The anchor digit of an action. -/
def anchorDigit : Action → Fin 2
  | .one => 1
  | .zero _ => 0

/-- Label i represents the source label i+1. Labels outside the retained interval write zero. -/
def digit {m : ℕ} (γ : RootPath m) (i : Fin m) (d : ℕ) : Fin 2 :=
  if i.val < (γ.state d).e then
    match γ.action d with
    | .one => 1
    | .zero h => if (γ.state d).e - h ≤ i.val then 1 else 0
  else 0

/-- The law generated by the actual label columns. -/
noncomputable def probability {m : ℕ} (γ : RootPath m) (i : Fin m) : ℝ :=
  ∑' d : ℕ, (digit γ i d : ℝ) / (2 : ℝ) ^ (d + 1)

/-- The mass of the permanent anchor label. -/
noncomputable def anchorMass {m : ℕ} (γ : RootPath m) : ℝ :=
  ∑' d : ℕ, (anchorDigit (γ.action d) : ℝ) / (2 : ℝ) ^ (d + 1)

/-- Expected bit cost obtained from the layer residual cylinder counts. -/
noncomputable def pathCost {m : ℕ} (γ : RootPath m) : ℝ :=
  ∑' d : ℕ, ((γ.state d).r : ℝ) / (2 : ℝ) ^ d

/-- Integer value of the first D digits, including the empty prefix. -/
def binaryPrefix {m : ℕ} (γ : RootPath m) (i : Fin m) : ℕ → ℕ
  | 0 => 0
  | d + 1 => 2 * binaryPrefix γ i d + (digit γ i d).val

/-- Every legal reduced root path generates a canonical probability law, with its
anchor as minimum and its layer bill equal to the classical dyadic cost. -/
theorem result (m : ℕ) (hm : 2 ≤ m) (γ : RootPath m) :
    (∀ i, 0 ≤ probability γ i) ∧
    (∑ i, probability γ i = 1) ∧
    (∀ (i : Fin m) (D : ℕ),
      ⌊(2 : ℝ) ^ D * probability γ i⌋ = (binaryPrefix γ i D : ℤ)) ∧
    (∃ hn : (Finset.univ : Finset (Fin m)).Nonempty,
      Finset.univ.inf' hn (probability γ) = anchorMass γ) ∧
    pathCost γ = DyadicSupportLines.cost (probability γ) ∧
    (0 < anchorMass γ → ∀ i, 0 < probability γ i) := by
  classical
  let T (D : ℕ) (i : Fin m) : ℝ :=
    Real.ofDigits (fun n => digit γ i (D + n))
  let A (D : ℕ) : ℝ :=
    Real.ofDigits (fun n => anchorDigit (γ.action (D + n)))
  have tail_step (a : ℕ → Fin 2) (D : ℕ) :
      2 * Real.ofDigits (fun n => a (D + n)) =
        (a D : ℝ) + Real.ofDigits (fun n => a (D + 1 + n)) := by
    have H := Real.ofDigits_eq_sum_add_ofDigits (fun n => a (D + n)) 1
    simp only [Finset.sum_range_one, Real.ofDigitsTerm, Nat.add_zero,
      Nat.cast_ofNat, pow_one] at H
    norm_num at H
    have heq : (fun n => a (D + (n + 1))) = (fun n => a (D + 1 + n)) := by
      funext n
      congr 1
      omega
    rw [heq] at H
    linarith only [H]
  have Tstep (D : ℕ) (i : Fin m) :
      2 * T D i = (digit γ i D : ℝ) + T (D + 1) i :=
    tail_step (digit γ i) D
  have Astep (D : ℕ) :
      2 * A D = (anchorDigit (γ.action D) : ℝ) + A (D + 1) :=
    tail_step (fun d => anchorDigit (γ.action d)) D
  have Tbounds (D : ℕ) (i : Fin m) : 0 ≤ T D i ∧ T D i ≤ 1 :=
    ⟨Real.ofDigits_nonneg _, Real.ofDigits_le_one _⟩
  have Abounds (D : ℕ) : 0 ≤ A D ∧ A D ≤ 1 :=
    ⟨Real.ofDigits_nonneg _, Real.ofDigits_le_one _⟩
  have retained : Antitone (fun D => (γ.state D).e) := by
    apply antitone_nat_of_succ_le
    intro D
    rw [γ.step D]
    cases γ.action D <;> simp [successor]
  have inactive (D : ℕ) (i : Fin m) (hi : (γ.state D).e ≤ i.val) : T D i = 0 := by
    change (∑' n, Real.ofDigitsTerm (fun n => digit γ i (D + n)) n) = 0
    calc
      _ = ∑' n : ℕ, (0 : ℝ) := by
        apply tsum_congr
        intro n
        have H : (γ.state (D + n)).e ≤ (γ.state D).e := retained (Nat.le_add_right D n)
        have hn : ¬i.val < (γ.state (D + n)).e := by omega
        simp only [Real.ofDigitsTerm, digit, hn, ite_false, Fin.val_zero, Nat.cast_zero, zero_mul]
      _ = 0 := tsum_zero
  have count (e : ℕ) (he : e ≤ m) :
      (∑ i : Fin m, if i.val < e then (1 : ℝ) else 0) = e := by
    simp [Finset.sum_boole, Fin.card_filter_val_lt, min_eq_right he]
  have column (D : ℕ) :
      (∑ i : Fin m, (digit γ i D : ℝ)) =
        2 * ((γ.state D).r : ℝ) - ((γ.state (D + 1)).r : ℝ) := by
    have hl := γ.legal D
    rw [γ.step D]
    cases ha : γ.action D with
    | one =>
      have hc : (γ.state D).e ≤ 2 * (γ.state D).r := by
        simpa [Legal, ha] using hl.2.2.2
      simp only [digit, ha, successor]
      simp only [apply_ite (fun x : Fin 2 => (x : ℝ)), Fin.val_one, Fin.val_zero,
        Nat.cast_one, Nat.cast_zero]
      rw [count _ hl.2.2.1, Nat.cast_sub hc]
      push_cast
      ring
    | zero h =>
      have hz : 2 * (γ.state D).r < (γ.state D).e ∧ h ≤ 2 * (γ.state D).r := by
        simpa only [ha] using hl.2.2.2
      have hc : h ≤ 2 * (γ.state D).r := hz.2
      have he : h ≤ (γ.state D).e := by
        have H := hz.1
        omega
      have db (i : Fin m) : (digit γ i D : ℝ) =
          (if i.val < (γ.state D).e then (1 : ℝ) else 0) -
          (if i.val < (γ.state D).e - h then (1 : ℝ) else 0) := by
        by_cases hi : i.val < (γ.state D).e
        · by_cases hj : i.val < (γ.state D).e - h
          · simp [digit, ha, hi, hj, show ¬(γ.state D).e - h ≤ i.val by omega]
          · simp [digit, ha, hi, hj, show (γ.state D).e - h ≤ i.val by omega]
        · have hj : ¬i.val < (γ.state D).e - h := by omega
          simp [digit, hi, hj]
      simp_rw [db]
      rw [Finset.sum_sub_distrib, count _ hl.2.2.1,
        count _ (Nat.le_trans (Nat.sub_le _ _) hl.2.2.1), Nat.cast_sub he]
      simp only [successor, Nat.cast_sub hc, Nat.cast_mul, Nat.cast_ofNat]
      ring
  have rsum (D : ℕ) :
      Summable (fun n : ℕ => ((γ.state (D + n)).r : ℝ) / (2 : ℝ) ^ n) := by
    apply Summable.of_nonneg_of_le (f := fun n => (m : ℝ) * (1 / 2 : ℝ) ^ n)
      (fun n => by positivity)
    · intro n
      have H : ((γ.state (D + n)).r : ℝ) ≤ m := by
        exact_mod_cast (Nat.le_trans (γ.legal (D + n)).2.1.le
          (γ.legal (D + n)).2.2.1)
      have hp : (1 / 2 : ℝ) ^ n = 1 / (2 : ℝ) ^ n := by rw [div_pow, one_pow]
      rw [hp, mul_one_div]
      exact div_le_div_of_nonneg_right H (by positivity)
    · exact (summable_geometric_of_abs_lt_one (by norm_num : |(1 / 2 : ℝ)| < 1)).mul_left (m : ℝ)
  have mass (D : ℕ) : ∑ i : Fin m, T D i = ((γ.state D).r : ℝ) := by
    have hs (i : Fin m) : Summable (fun n =>
        (digit γ i (D + n) : ℝ) / (2 : ℝ) ^ (n + 1)) := by
      convert (Real.summable_ofDigitsTerm (digits := fun n => digit γ i (D + n))) using 1
      ext n
      simp only [Real.ofDigitsTerm, Nat.cast_ofNat, div_eq_mul_inv]
    have ht := (rsum D).tsum_eq_zero_add
    have hshift : Summable (fun n : ℕ =>
        ((γ.state (D + (n + 1))).r : ℝ) / (2 : ℝ) ^ (n + 1)) :=
      (summable_nat_add_iff 1).mpr (rsum D)
    calc
      ∑ i : Fin m, T D i = ∑' n : ℕ, ∑ i : Fin m,
          (digit γ i (D + n) : ℝ) / (2 : ℝ) ^ (n + 1) := by
        simp only [T, Real.ofDigits, Real.ofDigitsTerm, ← div_eq_mul_inv]
        exact (Summable.tsum_finsetSum (fun i _ => hs i)).symm
      _ = ∑' n : ℕ, (((γ.state (D + n)).r : ℝ) / (2 : ℝ) ^ n -
          ((γ.state (D + (n + 1))).r : ℝ) / (2 : ℝ) ^ (n + 1)) := by
        apply tsum_congr
        intro n
        rw [← Finset.sum_div, column, pow_succ]
        simp only [Nat.add_assoc]
        field_simp
      _ = _ := by
        rw [(rsum D).tsum_sub hshift]
        simpa using (sub_eq_iff_eq_add.mpr ht)
  have compare_approx (n : ℕ) : ∀ D (i : Fin m), i.val < (γ.state D).e →
      A D ≤ T D i + (1 / 2 : ℝ) ^ n := by
    induction n with
    | zero =>
      intro D i hi
      have H := (Abounds D).2
      have H' := (Tbounds D i).1
      simp only [pow_zero]
      linarith only [H, H']
    | succ n ih =>
      intro D i hi
      have ta := Tstep D i
      have aa := Astep D
      have hn := γ.step D
      cases ha : γ.action D with
      | one =>
        have hi' : i.val < (γ.state (D + 1)).e := by rw [hn]; simpa [ha, successor] using hi
        have H := ih (D + 1) i hi'
        simp [digit, ha, hi, anchorDigit] at ta aa
        rw [pow_succ]
        linarith only [ta, aa, H]
      | zero h =>
        by_cases hi' : i.val < (γ.state (D + 1)).e
        · have hh : ¬(γ.state D).e - h ≤ i.val := by
            rw [hn] at hi'
            simp only [ha, successor] at hi'
            omega
          have H := ih (D + 1) i hi'
          simp [digit, ha, hi, hh, anchorDigit] at ta aa
          rw [pow_succ]
          linarith only [ta, aa, H]
        · have hh : (γ.state D).e - h ≤ i.val := by
            rw [hn] at hi'
            simp only [ha, successor] at hi'
            omega
          have H := inactive (D + 1) i (by omega)
          have H' := (Abounds (D + 1)).2
          have hpow : 0 ≤ (1 / 2 : ℝ) ^ (n + 1) := by positivity
          simp [digit, ha, hi, hh, anchorDigit, H] at ta aa
          linarith only [ta, aa, H', hpow]
  have compare (D : ℕ) (i : Fin m) (hi : i.val < (γ.state D).e) : A D ≤ T D i := by
    have ht : Filter.Tendsto (fun n : ℕ => T D i + (1 / 2 : ℝ) ^ n)
        Filter.atTop (nhds (T D i)) := by
      simpa using tendsto_const_nhds.add
        (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
          (by norm_num : (1 / 2 : ℝ) < 1))
    exact ge_of_tendsto ht (Filter.Eventually.of_forall (fun n => compare_approx n D i hi))
  have anchor_bound (D : ℕ) :
      0 ≤ A D ∧ A D ≤ ((γ.state D).r : ℝ) / (γ.state D).e ∧ A D < 1 := by
    have hprod : ((γ.state D).e : ℝ) * A D ≤ ((γ.state D).r : ℝ) := by
      have H := Finset.sum_le_sum (s := (Finset.univ : Finset (Fin m)))
        (fun i _ => show (if i.val < (γ.state D).e then A D else 0) ≤ T D i from by
          split_ifs with hi
          · exact compare D i hi
          · exact (Tbounds D i).1)
      have hc := count (γ.state D).e (γ.legal D).2.2.1
      have heq : (∑ i : Fin m, if i.val < (γ.state D).e then A D else 0) =
          ((γ.state D).e : ℝ) * A D := by
        rw [← hc, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro i _
        split_ifs <;> simp
      rw [heq, mass D] at H
      exact H
    have he : (0 : ℝ) < (γ.state D).e := by exact_mod_cast (γ.legal D).1
    have hr : ((γ.state D).r : ℝ) < (γ.state D).e := by
      exact_mod_cast (γ.legal D).2.1
    refine ⟨(Abounds D).1, (le_div_iff₀ he).mpr ?_, ?_⟩
    · simpa [mul_comm] using hprod
    · nlinarith only [hprod, he, hr]
  have onevalue : Real.ofDigits (fun _ : ℕ => (1 : Fin 2)) = 1 := by
    simpa using Real.ofDigits_const_last_eq_one 1
  have digit_active (D : ℕ) (i : Fin m) (hi : digit γ i D = 1) :
      i.val < (γ.state D).e := by
    by_contra H
    simp [digit, H] at hi
  have not_all_one (D : ℕ) (i : Fin m) :
      ¬∀ n : ℕ, digit γ i (D + n) = 1 := by
    intro hall
    have hanchor (n : ℕ) : anchorDigit (γ.action (D + n)) = 1 := by
      have hd := hall n
      have hn := digit_active (D + (n + 1)) i (hall (n + 1))
      cases ha : γ.action (D + n) with
      | one => rfl
      | zero h =>
        have hs := γ.step (D + n)
        simp only [ha, successor] at hs
        rw [show D + (n + 1) = D + n + 1 by omega, hs] at hn
        change i.val < (γ.state (D + n)).e - h at hn
        have hi := digit_active (D + n) i hd
        simp only [digit, hi, ite_true, ha] at hd
        have hh : ¬(γ.state (D + n)).e - h ≤ i.val := by omega
        simp [hh] at hd
    have heq : A D = 1 := by
      simp only [A, hanchor]
      exact onevalue
    linarith only [(anchor_bound D).2.2, heq]
  have strict_tail (D : ℕ) (i : Fin m) : T D i < 1 := by
    obtain ⟨n, hn⟩ := not_forall.mp (not_all_one D i)
    have hz : digit γ i (D + n) = 0 := by
      apply Fin.ext
      have H := (digit γ i (D + n)).isLt
      have H' : (digit γ i (D + n)).val ≠ 1 := by
        intro H'
        apply hn
        exact Fin.ext H'
      simp only [Fin.val_zero]
      omega
    have H := Summable.tsum_lt_tsum (i := n)
      (f := Real.ofDigitsTerm (fun k => digit γ i (D + k)))
      (g := Real.ofDigitsTerm (fun _ : ℕ => (1 : Fin 2)))
      (fun k => by
        convert (Real.ofDigitsTerm_le (digits := fun k => digit γ i (D + k)) (n := k)) using 1 <;>
          norm_num [Real.ofDigitsTerm]
        all_goals rfl)
      (by simp only [Real.ofDigitsTerm, hz, Fin.val_zero, Fin.val_one,
          Nat.cast_zero, Nat.cast_one, zero_mul, one_mul]
          positivity)
      Real.summable_ofDigitsTerm Real.summable_ofDigitsTerm
    change T D i < Real.ofDigits (fun _ : ℕ => (1 : Fin 2)) at H
    rwa [onevalue] at H
  have pT (i : Fin m) : probability γ i = T 0 i := by
    simp [probability, T, Real.ofDigits, Real.ofDigitsTerm, div_eq_mul_inv]
  have expansion (D : ℕ) (i : Fin m) :
      (2 : ℝ) ^ D * probability γ i = (binaryPrefix γ i D : ℝ) + T D i := by
    induction D with
    | zero => simp [binaryPrefix, pT]
    | succ D ih =>
      have H := Tstep D i
      simp only [binaryPrefix, Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat]
      rw [pow_succ, mul_right_comm, ih]
      linarith only [H]
  have floors (i : Fin m) (D : ℕ) :
      ⌊(2 : ℝ) ^ D * probability γ i⌋ = (binaryPrefix γ i D : ℤ) := by
    apply Int.floor_eq_iff.mpr
    have he := expansion D i
    have hb := (Tbounds D i).1
    have hs := strict_tail D i
    simp only [Int.cast_natCast]
    constructor <;> linarith only [he, hb, hs]
  have normalized : ∑ i : Fin m, probability γ i = 1 := by
    simp_rw [pT]
    simpa only [γ.root, Nat.cast_one] using mass 0
  have shared_digit (D : ℕ) (i : Fin m) (hi : i.val < (γ.state (D + 1)).e) :
      digit γ i D = anchorDigit (γ.action D) := by
    have he : (γ.state (D + 1)).e ≤ (γ.state D).e := retained (by omega)
    have hi0 : i.val < (γ.state D).e := by omega
    have hs := γ.step D
    cases ha : γ.action D with
    | one => simp [digit, ha, hi0, anchorDigit]
    | zero h =>
      rw [hs] at hi
      simp only [ha, successor] at hi
      have hh : ¬(γ.state D).e - h ≤ i.val := by omega
      simp [digit, ha, hi0, hh, anchorDigit]
  have departure_gap (D : ℕ) (i : Fin m)
      (hi : i.val < (γ.state D).e) (ho : (γ.state (D + 1)).e ≤ i.val) :
      probability γ i - anchorMass γ = (1 - A (D + 1)) / (2 : ℝ) ^ (D + 1) ∧
      0 < probability γ i - anchorMass γ := by
    have hp := Real.ofDigits_eq_sum_add_ofDigits (digit γ i) D
    have hb := Real.ofDigits_eq_sum_add_ofDigits (fun d => anchorDigit (γ.action d)) D
    have hp0 : Real.ofDigits (digit γ i) = probability γ i := by
      simp only [probability, Real.ofDigits, Real.ofDigitsTerm, Nat.cast_ofNat, div_eq_mul_inv]
    have hb0 : Real.ofDigits (fun d => anchorDigit (γ.action d)) = anchorMass γ := by
      simp only [anchorMass, Real.ofDigits, Real.ofDigitsTerm, Nat.cast_ofNat, div_eq_mul_inv]
    have hprefix : (∑ d ∈ Finset.range D, Real.ofDigitsTerm (digit γ i) d) =
        ∑ d ∈ Finset.range D, Real.ofDigitsTerm (fun d => anchorDigit (γ.action d)) d := by
      apply Finset.sum_congr rfl
      intro d hd
      have he : (γ.state D).e ≤ (γ.state (d + 1)).e :=
        retained (by have H := Finset.mem_range.mp hd; omega)
      have hh : i.val < (γ.state (d + 1)).e := by omega
      simp only [Real.ofDigitsTerm, shared_digit d i hh]
    rw [hp0, hprefix] at hp
    rw [hb0] at hb
    have ht : Real.ofDigits (fun n => digit γ i (n + D)) = T D i := by
      congr 1
      funext n
      rw [Nat.add_comm]
    have ha' : Real.ofDigits (fun n => anchorDigit (γ.action (n + D))) = A D := by
      congr 1
      funext n
      rw [Nat.add_comm]
    rw [ht] at hp
    rw [ha'] at hb
    have ta := Tstep D i
    have aa := Astep D
    have hinactive := inactive (D + 1) i ho
    have hs := γ.step D
    have hg : T D i - A D = (1 - A (D + 1)) / 2 := by
      cases ha : γ.action D with
      | one =>
        rw [hs] at ho
        simp only [ha, successor] at ho
        omega
      | zero h =>
        have hh : (γ.state D).e - h ≤ i.val := by
          rw [hs] at ho
          simpa only [ha, successor] using ho
        simp [digit, ha, hi, hh, anchorDigit, hinactive] at ta aa
        linarith only [ta, aa]
    have heq : probability γ i - anchorMass γ =
        (1 - A (D + 1)) / (2 : ℝ) ^ (D + 1) := by
      have hpow : (2 : ℝ) ^ D ≠ 0 := by positivity
      rw [pow_succ]
      field_simp
      field_simp at hp hb hg
      norm_num only [Nat.cast_ofNat] at hp hb
      nlinarith only [hp, hb, hg]
    refine ⟨heq, ?_⟩
    rw [heq]
    exact div_pos (sub_pos.mpr (anchor_bound (D + 1)).2.2) (by positivity)
  have lower (i : Fin m) : anchorMass γ ≤ probability γ i := by
    by_cases hall : ∀ D : ℕ, i.val < (γ.state D).e
    · have heq : probability γ i = anchorMass γ := by
        apply tsum_congr
        intro d
        rw [shared_digit d i (hall (d + 1))]
      exact heq.ge
    · have hex : ∃ D : ℕ, ¬i.val < (γ.state D).e := not_forall.mp hall
      have hn : ¬i.val < (γ.state (Nat.find hex)).e := Nat.find_spec hex
      have hnpos : 0 < Nat.find hex := by
        by_contra H
        have heq : Nat.find hex = 0 := by omega
        rw [heq, γ.root] at hn
        exact hn i.isLt
      let D := Nat.find hex - 1
      have hD : D + 1 = Nat.find hex := by dsimp [D]; omega
      have hi : i.val < (γ.state D).e := by
        by_contra H
        exact Nat.find_min hex (by dsimp [D]; omega) H
      have ho : (γ.state (D + 1)).e ≤ i.val := by rw [hD]; omega
      have H := (departure_gap D i hi ho).2
      linarith only [H]
  have anchor_is_label : probability γ ⟨0, by omega⟩ = anchorMass γ := by
    apply tsum_congr
    intro d
    have hd : digit γ ⟨0, by omega⟩ d = anchorDigit (γ.action d) := by
      have hl := γ.legal d
      have hi : 0 < (γ.state d).e := hl.1
      cases ha : γ.action d with
      | one => simp [digit, ha, hi, anchorDigit]
      | zero h =>
        have hh : ¬(γ.state d).e - h ≤ 0 := by
          have hz : 2 * (γ.state d).r < (γ.state d).e ∧ h ≤ 2 * (γ.state d).r := by
            simpa only [ha] using hl.2.2.2
          have hr := hz.1
          have hb := hz.2
          omega
        simp [digit, ha, hi, hh, anchorDigit]
    rw [hd]
  have residual_eq (D : ℕ) :
      DyadicSupportLines.residual (probability γ) D = ((γ.state D).r : ℝ) := by
    have H := congrArg (fun f : Fin m → ℝ => ∑ i, f i) (funext (expansion D))
    simp only [Finset.sum_add_distrib, ← Finset.mul_sum, normalized, mul_one,
      mass D] at H
    simp only [DyadicSupportLines.residual, floors]
    push_cast
    linarith only [H]
  refine ⟨fun i => pT i ▸ (Tbounds 0 i).1, normalized, floors, ?_, ?_, ?_⟩
  · have hn : (Finset.univ : Finset (Fin m)).Nonempty :=
      ⟨⟨0, by omega⟩, Finset.mem_univ _⟩
    refine ⟨hn, le_antisymm ?_ ?_⟩
    · rw [← anchor_is_label]
      exact Finset.inf'_le _ (Finset.mem_univ _)
    · exact Finset.le_inf' hn _ (fun i _ => lower i)
  · unfold pathCost DyadicSupportLines.cost
    simp_rw [residual_eq]
  · intro ht i
    exact lt_of_lt_of_le ht (lower i)

end D5.S3.Arith.FibonacciAtomic.TriangularPathNormalization
