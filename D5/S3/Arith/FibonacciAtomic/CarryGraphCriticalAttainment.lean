   generality: G
   mirror-B: D5/B/S3/Arith/FibonacciAtomic/CarryGraphCriticalAttainment
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: Bellman root prices and attainment of the full real minimum-atom slope. -/

import D5.S3.Arith.FibonacciAtomic.CarryGraphRealization
import D5.S3.Observer.DynamicProgramming.StationaryPolicyOptimality
import Mathlib.Order.ConditionallyCompleteLattice.Finset
import Mathlib.Data.Fintype.Pi

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.FibonacciAtomic.CarryGraphCriticalAttainment

open scoped BigOperators ENNReal BoundedContinuousFunction
open CarryGraphEmbedding MeasureTheory
open D5.S0.Tower.DBonacci.TerminalSampling (Tape fairTape)

local notation "S" => (fun m : ℕ => {s : State // IsState m s})
local notation "A" => (fun (m : ℕ) (s : State) => {a : Action // Legal m s a})
local notation "P" => (fun m : ℕ => ∀ s : S m, A m s.val)

/-- The infimum of the dyadic cost divided by the smallest mass, over all strictly
positive real probability laws. The minimizing index is allowed to be nonunique. -/
noncomputable def alpha (m : ℕ) : ℝ :=
  sInf {y : ℝ | ∃ (p : Fin m → ℝ) (k : Fin m),
    (∀ i, 0 < p i) ∧ (∑ i, p i) = 1 ∧ (∀ i, p k ≤ p i) ∧
      y = DyadicSupportLines.cost p / p k}

/-- The original carry graph's discounted minimum, over exactly its legal actions.
The anchor bit is discounted with the continuation, by one half. -/
noncomputable def bellman (m : ℕ) (x : ℝ) (v : S m → ℝ) (s : S m) : ℝ :=
  (s.val.r : ℝ) + (1 / 2 : ℝ) *
    ⨅ a : A m s.val,
      v ⟨successor s.val a.val, a.property.2.2⟩ - x * (a.val.b : ℝ)

/-- The actual state and action sequence generated by a deterministic stationary
table, starting at any legal state. -/
def policyPath (m : ℕ) (f : P m) (start : S m) : Path :=
  let step : S m → S m := fun s =>
    ⟨successor s.val (f s).val, (f s).property.2.2⟩
  ⟨fun d => (step^[d] start).val, fun d => (f (step^[d] start)).val⟩

end D5.S3.Arith.FibonacciAtomic.CarryGraphCriticalAttainment
