/- GID: D5/S3/Arith/FibonacciAtomic/CarryGraphCriticalAttainment
   generality: I
   mirror-B: D5/B/S3/Arith/FibonacciAtomic/CarryGraphCriticalAttainment
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: Bellman root prices and attainment of the full real minimum-atom slope. -/

import D5.S3.Arith.FibonacciAtomic.CarryGraphRealization
import D5.S3.Observer.DynamicProgramming.StationaryPolicyOptimality
import Mathlib.Order.ConditionallyCompleteLattice.Finset
import Mathlib.Data.Fintype.Pi

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.FibonacciAtomic.CarryGraphCriticalAttainment

open scoped BigOperators ENNReal BoundedContinuousFunction
open CarryGraphEmbedding MeasureTheory
open D5.S0.Tower.DBonacci.TerminalSampling (Tape fairTape)

local notation "S" => (fun m : ℕ => {s : State // IsState m s})
local notation "A" => (fun (m : ℕ) (s : State) => {a : Action // Legal m s a})
set_option quotPrecheck false in
local notation "P" => (fun m : ℕ => (s : S m) → A m s.val)

/-- The infimum of the dyadic cost divided by the smallest mass, over all strictly
positive real probability laws. The minimizing index is allowed to be nonunique. -/
noncomputable def alpha (m : ℕ) : ℝ :=
  sInf {y : ℝ | ∃ (p : Fin m → ℝ) (k : Fin m),
    (∀ i, 0 < p i) ∧ (∑ i, p i) = 1 ∧ (∀ i, p k ≤ p i) ∧
      y = DyadicSupportLines.cost p / p k}

/-- The original carry graph's discounted minimum, over exactly its legal actions.
The anchor bit is discounted with the continuation, by one half. -/
noncomputable def bellman (m : ℕ) (x : ℝ) (v : S m → ℝ) (s : S m) : ℝ :=
  (s.val.r : ℝ) + (1 / 2 : ℝ) *
    ⨅ a : A m s.val,
      v ⟨successor s.val a.val, a.property.2.2⟩ - x * (a.val.b : ℝ)

/-- The actual state and action sequence generated by a deterministic stationary
table, starting at any legal state. -/
def policyPath (m : ℕ) (f : P m) (start : S m) : Path :=
  let step : S m → S m := fun s =>
    ⟨successor s.val (f s).val, (f s).property.2.2⟩
  ⟨fun d => (step^[d] start).val, fun d => (f (step^[d] start)).val⟩

open D5.S3.Observer.DynamicProgramming.DiscountedBellmanContraction
open D5.S3.Observer.DynamicProgramming.StationaryPolicyOptimality

/-- The original carry graph has unique finite Bellman values at all real prices,
with stationary root-path minima. At the full real slope its zero root price forces
a positive anchor and an actual fair-bit tree attaining the dyadic cost ratio. -/
theorem result (m : ℕ) (hm : 2 ≤ m) :
    let o : S m := ⟨root m, by dsimp [IsState, root]; omega⟩
    ∃ V : ℝ → S m → ℝ, ∃ f : ℝ → P m,
      (∀ x, Function.IsFixedPt (bellman m x) (V x) ∧
        ∀ w, Function.IsFixedPt (bellman m x) w → w = V x) ∧
      (∀ x (s : S m), V x s = (s.val.r : ℝ) + 1 / 2 *
        (V x ⟨successor s.val (f x s).val, (f x s).property.2.2⟩ -
          x * ((f x s).val.b : ℝ))) ∧
      (∀ x, IsRootPath m (policyPath m (f x) o) ∧
        V x o = pathCost (policyPath m (f x) o) - x * anchorValue (policyPath m (f x) o) ∧
        ∀ γ : Path, IsRootPath m γ → V x o ≤ pathCost γ - x * anchorValue γ) ∧
      (∀ x, 0 ≤ V x o ↔ x ≤ alpha m) ∧ V (alpha m) o = 0 ∧
      let γ := policyPath m (f (alpha m)) o
      let p : Fin m → ℝ := fun i => Real.ofDigits (CarryGraphRealization.labelDigit γ i)
      0 < anchorValue γ ∧ (∀ i, 0 < p i) ∧ (∑ i, p i) = 1 ∧
      sInf (Set.range p) = anchorValue γ ∧
      (∀ᵐ tape ∂D5.S0.Tower.DBonacci.TerminalSampling.fairTape,
        ∃ i n, CarryGraphRealization.sample m γ tape = some (i, n)) ∧
      (∀ i : Fin m,
        D5.S0.Tower.DBonacci.TerminalSampling.fairTape
          {tape | ∃ n, CarryGraphRealization.sample m γ tape = some (i, n)} =
            ENNReal.ofReal (p i)) ∧
      (∫⁻ tape, CarryGraphRealization.bill m γ tape
        ∂D5.S0.Tower.DBonacci.TerminalSampling.fairTape) = ENNReal.ofReal (pathCost γ) ∧
      pathCost γ = DyadicSupportLines.cost p ∧
      DyadicSupportLines.cost p = alpha m * anchorValue γ := by
  classical
  haveI : Nonempty (Fin m) := ⟨⟨0, by omega⟩⟩
  let codeS : S m → Fin m × Fin m := fun s =>
    (⟨s.val.r.toNat, by have H := s.property; dsimp [IsState] at H; omega⟩,
     ⟨(s.val.e - 1).toNat, by have H := s.property; dsimp [IsState] at H; omega⟩)
  have codeS_injective : Function.Injective codeS := by
    rintro ⟨⟨sr, se⟩, hs⟩ ⟨⟨tr, te⟩, ht⟩ h
    have h1 := congrArg (fun z => z.1.val) h
    have h2 := congrArg (fun z => z.2.val) h
    dsimp [codeS] at h1 h2
    dsimp [IsState] at hs ht
    apply Subtype.ext
    dsimp
    congr <;> omega
  letI : Fintype (S m) := Fintype.ofInjective codeS codeS_injective
  let o : S m := ⟨root m, by dsimp [IsState, root]; omega⟩
  haveI : Nonempty (S m) := ⟨o⟩
  let codeA (s : S m) : A m s.val → Fin 2 × Fin m × Fin m := fun a =>
    (⟨a.val.b.toNat, by rcases a.property with ⟨_, h | h, _⟩ <;> omega⟩,
     ⟨a.val.h.toNat, by
       have hs := s.property
       rcases a.property with ⟨_, h | h, _⟩ <;> dsimp [IsState] at hs <;> omega⟩,
     ⟨a.val.c.toNat, by
       have hs := s.property
       rcases a.property with ⟨_, h | h, _⟩ <;> dsimp [IsState] at hs <;> omega⟩)
  have codeA_injective (s : S m) : Function.Injective (codeA s) := by
    rintro ⟨⟨ab, ah, ac⟩, ha⟩ ⟨⟨bb, bh, bc⟩, hb⟩ h
    have h1 := congrArg (fun z => z.1.val) h
    have h2 := congrArg (fun z => z.2.1.val) h
    have h3 := congrArg (fun z => z.2.2.val) h
    dsimp [codeA] at h1 h2 h3
    apply Subtype.ext
    dsimp
    rcases ha with ⟨_, ha | ha, _⟩ <;>
      rcases hb with ⟨_, hb | hb, _⟩ <;> dsimp at ha hb <;> congr <;> omega
  letI (s : S m) : Fintype (A m s.val) := Fintype.ofInjective (codeA s) (codeA_injective s)
  haveI (s : S m) : Nonempty (A m s.val) := by
    obtain ⟨a, ha⟩ := (CarryGraphEmbedding.result m hm).1 s.val s.property
    exact ⟨⟨a, ha⟩⟩
  letI : TopologicalSpace (S m) := ⊥
  haveI : DiscreteTopology (S m) := ⟨rfl⟩
  letI : Fintype (P m) := Pi.instFintype
  let base : P m := fun s => Classical.choice (inferInstance : Nonempty (A m s.val))
  haveI : Nonempty (P m) := ⟨base⟩
  let next (s : S m) (f : P m) : S m :=
    ⟨successor s.val (f s).val, (f s).property.2.2⟩
  let tr (s : S m) (f : P m) (t : S m) : ℝ := if t = next s f then 1 else 0
  have tr_nonneg : ∀ s f t, 0 ≤ tr s f t := by intro s f t; dsimp [tr]; split_ifs <;> norm_num
  have tr_sum : ∀ s f, ∑ t, tr s f t = 1 := by intro s f; simp [tr]
  let embed (v : S m → ℝ) : (S m) →ᵇ ℝ :=
    BoundedContinuousFunction.mkOfCompact ⟨v, continuous_of_discreteTopology⟩
  have solution (x : ℝ) : ∃ v : S m → ℝ, ∃ f : P m,
      Function.IsFixedPt (bellman m x) v ∧
      (∀ w, Function.IsFixedPt (bellman m x) w → w = v) ∧
      (∀ s : S m, v s = (s.val.r : ℝ) + (1 / 2 : ℝ) *
        (v ⟨successor s.val (f s).val, (f s).property.2.2⟩ - x * ((f s).val.b : ℝ))) := by
    let loss (s : S m) (f : P m) : ℝ := (s.val.r : ℝ) - x * ((f s).val.b : ℝ) / 2
    have bridge (v : (S m) →ᵇ ℝ) (s : S m) :
        discountedLossBellmanOperator loss tr (1 / 2) v s = bellman m x v s := by
      rw [discounted_loss_bellman_operator_apply]
      simp only [tr, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
      let q (a : A m s.val) : ℝ :=
        v ⟨successor s.val a.val, a.property.2.2⟩ - x * (a.val.b : ℝ)
      obtain ⟨a, hmin⟩ := exists_eq_ciInf_of_finite (f := q)
      have qmin : (⨅ a, q a) = q a := hmin.symm
      obtain ⟨f, hf⟩ := Function.surjective_eval (β := fun t : S m => A m t.val) s a
      change f s = a at hf
      change Finset.univ.inf' _ (fun f => loss s f + (↑(1 / 2 : NNReal) : ℝ) * v (next s f)) = _
      rw [show (↑(1 / 2 : NNReal) : ℝ) = 1 / 2 by norm_num]
      change _ = (s.val.r : ℝ) + (1 / 2 : ℝ) * ⨅ a, q a
      rw [qmin]
      apply le_antisymm
      · calc
          _ ≤ loss s f + 1 / 2 * v (next s f) := Finset.inf'_le _ (Finset.mem_univ f)
          _ = (s.val.r : ℝ) + 1 / 2 * q a := by dsimp [loss, next, q]; rw [hf]; ring
      · apply Finset.le_inf'
        intro g hg
        have H : q a ≤ q (g s) := by rw [hmin]; exact ciInf_le (Set.finite_range q).bddBelow _
        dsimp [loss, next, q] at *
        linarith
    obtain ⟨w, hw, hunique⟩ :=
      (discounted_bellman_contraction_and_unique_fixed_point
        (fun s f => -loss s f) tr (1 / 2) (by norm_num) (by norm_num) tr_nonneg tr_sum).2
    let v : S m → ℝ := fun s => -w s
    have fixed : Function.IsFixedPt (bellman m x) v := by
      funext s
      have H := congrArg (fun z : (S m) →ᵇ ℝ => z s) hw
      have B := bridge (-w) s
      simp only [discountedLossBellmanOperator, neg_neg] at B
      change -discountedBellmanOperator (fun s f => -loss s f) tr (1 / 2) w s = _ at B
      change bellman m x (fun s => -w s) s = -w s
      simp only [BoundedContinuousFunction.coe_neg] at B
      change bellman m x (-(w : S m → ℝ)) s = -w s
      exact B.symm.trans (congrArg Neg.neg H)
    have unique (u : S m → ℝ) (hu : Function.IsFixedPt (bellman m x) u) : u = v := by
      have hneg : Function.IsFixedPt
          (discountedBellmanOperator (fun s f => -loss s f) tr (1 / 2)) (-(embed u)) := by
        apply BoundedContinuousFunction.ext
        intro s
        have B := bridge (embed u) s
        have H := congrFun hu s
        simp only [discountedLossBellmanOperator] at B
        change -(discountedBellmanOperator (fun s f => -loss s f) tr (1 / 2)
          (-(embed u)) s) = _ at B
        change _ = -u s
        change _ = u s at H
        change -(discountedBellmanOperator (fun s f => -loss s f) tr (1 / 2)
          (-(embed u)) s) = bellman m x u s at B
        rw [H] at B
        linarith
      have H := hunique (-(embed u)) hneg
      funext s
      have hs := congrArg (fun z : (S m) →ᵇ ℝ => z s) H
      change -u s = w s at hs
      dsimp [v]
      linarith
    have greedy (s : S m) : ∃ a : A m s.val,
        v s = (s.val.r : ℝ) + 1 / 2 *
          (v ⟨successor s.val a.val, a.property.2.2⟩ - x * (a.val.b : ℝ)) := by
      let q (a : A m s.val) : ℝ :=
        v ⟨successor s.val a.val, a.property.2.2⟩ - x * (a.val.b : ℝ)
      obtain ⟨a, hmin⟩ := exists_eq_ciInf_of_finite (f := q)
      refine ⟨a, ?_⟩
      have qmin : (⨅ a, q a) = q a := hmin.symm
      rw [← congrFun fixed s]
      change _ = (s.val.r : ℝ) + 1 / 2 * q a
      exact congrArg (fun z => (s.val.r : ℝ) + 1 / 2 * z) qmin
    choose f hf using greedy
    exact ⟨v, f, fixed, unique, hf⟩
  have weighted (g : ℕ → ℝ) (M : ℝ) (hg : ∀ d, |g d| ≤ M) :
      Summable (fun d => g d / (2 : ℝ) ^ d) := by
    have geo : Summable (fun d : ℕ => M / (2 : ℝ) ^ d) := by
      simpa only [div_pow, one_pow, div_eq_mul_inv, one_mul, inv_pow] using
        (summable_geometric_of_abs_lt_one (r := (1 / 2 : ℝ)) (by norm_num)).mul_left M
    exact geo.of_norm_bounded fun d => by
      rw [Real.norm_eq_abs, abs_div, abs_of_pos (pow_pos (by norm_num : (0 : ℝ) < 2) d)]
      exact div_le_div_of_nonneg_right (hg d) (by positivity)
  have path_eval (x : ℝ) (v : S m → ℝ)
      (step : ∀ (s : S m) (a : A m s.val),
        v s ≤ (s.val.r : ℝ) + 1 / 2 *
          (v ⟨successor s.val a.val, a.property.2.2⟩ - x * (a.val.b : ℝ)))
      (γ : Path) (hγ : IsRootPath m γ) :
      v o ≤ pathCost γ - x * anchorValue γ ∧
      ((∀ d, v ⟨γ.state d, (hγ.2 d).1.1⟩ = ((γ.state d).r : ℝ) + 1 / 2 *
        (v ⟨γ.state (d + 1), (hγ.2 (d + 1)).1.1⟩ - x * ((γ.action d).b : ℝ))) →
        v o = pathCost γ - x * anchorValue γ) := by
    let states (d : ℕ) : S m := ⟨γ.state d, (hγ.2 d).1.1⟩
    let R (d : ℕ) : ℝ := (γ.state d).r / (2 : ℝ) ^ d
    let B (d : ℕ) : ℝ := (γ.action d).b / (2 : ℝ) ^ (d + 1)
    let Q (d : ℕ) : ℝ := v (states d) / (2 : ℝ) ^ d
    have rbound (d : ℕ) : |((γ.state d).r : ℝ)| ≤ m := by
      have H := (hγ.2 d).1.1
      have H0 : (0 : ℤ) ≤ (γ.state d).r := H.1
      have H1 : (γ.state d).r ≤ m := by have := H.2.1; omega
      rw [abs_of_nonneg (by exact_mod_cast H0)]
      exact_mod_cast H1
    have bbound (d : ℕ) : |((γ.action d).b : ℝ)| ≤ 1 := by
      have H := (hγ.2 d).1.2.1
      rcases H with H | H <;> rw [H.1] <;> norm_num
    have hr : Summable R := weighted (fun d => (γ.state d).r) m rbound
    have hb : Summable B := by
      simpa only [B, pow_succ, div_div] using
        (weighted (fun d => (γ.action d).b) 1 bbound).div_const 2
    obtain ⟨M, hM⟩ := (Set.finite_range (fun s : S m => |v s|)).bddAbove
    have hq : Summable Q := weighted (fun d => v (states d)) M
      (fun d => hM ⟨states d, rfl⟩)
    have hq' : Summable (fun d => Q (d + 1)) := (summable_nat_add_iff 1).mpr hq
    have qzero : Q 0 = v o := by
      simp only [Q, pow_zero, div_one]
      apply congrArg v
      exact Subtype.ext hγ.1
    have telescope : (∑' d, (Q d - Q (d + 1))) =
        v o := by
      rw [hq.tsum_sub hq']
      have H := hq.tsum_eq_zero_add
      rw [qzero] at H
      linarith
    have total : (∑' d, (R d - x * B d)) = pathCost γ - x * anchorValue γ := by
      rw [hr.tsum_sub (hb.mul_left x), tsum_mul_left]
      rfl
    have pointwise (d : ℕ) : Q d - Q (d + 1) ≤ R d - x * B d := by
      let a : A m (states d).val := ⟨γ.action d, (hγ.2 d).1⟩
      have H := step (states d) a
      have next_eq : (⟨successor (states d).val a.val, a.property.2.2⟩ : S m) =
          states (d + 1) := Subtype.ext (hγ.2 d).2.symm
      rw [next_eq] at H
      apply (sub_le_iff_le_add).mpr
      calc
        Q d ≤ (((γ.state d).r : ℝ) + 1 / 2 *
          (v (states (d + 1)) - x * ((γ.action d).b : ℝ))) / (2 : ℝ) ^ d :=
            div_le_div_of_nonneg_right H (by positivity)
        _ = R d - x * B d + Q (d + 1) := by
          dsimp [R, B, Q]
          rw [pow_succ, div_mul_eq_div_div, div_mul_eq_div_div]
          ring
    refine ⟨?_, ?_⟩
    · rw [← telescope, ← total]
      exact Summable.tsum_le_tsum pointwise (hq.sub hq') (hr.sub (hb.mul_left x))
    · intro equality
      rw [← telescope, ← total]
      apply tsum_congr
      intro d
      have H := equality d
      dsimp only [Q]
      rw [H]
      dsimp [R, B]
      rw [pow_succ, div_mul_eq_div_div, div_mul_eq_div_div]
      ring

  choose V f spec using solution
  have value_le (x : ℝ) (s : S m) (a : A m s.val) :
      V x s ≤ (s.val.r : ℝ) + 1 / 2 *
        (V x ⟨successor s.val a.val, a.property.2.2⟩ - x * (a.val.b : ℝ)) := by
    rw [← congrFun (spec x).1 s]
    dsimp only [bellman]
    exact add_le_add le_rfl (mul_le_mul_of_nonneg_left
      (ciInf_le (Set.finite_range _).bddBelow a)
      (by norm_num : (0 : ℝ) ≤ 1 / 2))
  have orbit_legal (g : P m) : IsRootPath m (policyPath m g o) := by
    let F : S m → S m := fun s => ⟨successor s.val (g s).val, (g s).property.2.2⟩
    constructor
    · rfl
    · intro d
      change Legal m (F^[d] o).val (g (F^[d] o)).val ∧
        (F^[d + 1] o).val = successor (F^[d] o).val (g (F^[d] o)).val
      refine ⟨(g (F^[d] o)).property, ?_⟩
      rw [Function.iterate_succ_apply']
  have orbit_eq (x : ℝ) (d : ℕ) :
      V x ⟨(policyPath m (f x) o).state d, ((orbit_legal (f x)).2 d).1.1⟩ =
        (((policyPath m (f x) o).state d).r : ℝ) + 1 / 2 *
          (V x ⟨(policyPath m (f x) o).state (d + 1),
            ((orbit_legal (f x)).2 (d + 1)).1.1⟩ -
            x * (((policyPath m (f x) o).action d).b : ℝ)) := by
    let F : S m → S m := fun s =>
      ⟨successor s.val (f x s).val, (f x s).property.2.2⟩
    change V x (F^[d] o) = ((F^[d] o).val.r : ℝ) + 1 / 2 *
      (V x (F^[d + 1] o) - x * ((f x (F^[d] o)).val.b : ℝ))
    rw [Function.iterate_succ_apply']
    exact (spec x).2.2 (F^[d] o)
  have optimal_path (x : ℝ) :
      IsRootPath m (policyPath m (f x) o) ∧
      V x o = pathCost (policyPath m (f x) o) - x * anchorValue (policyPath m (f x) o) ∧
      ∀ γ : Path, IsRootPath m γ → V x o ≤ pathCost γ - x * anchorValue γ :=
    ⟨orbit_legal (f x),
      (path_eval x (V x) (value_le x) _ (orbit_legal (f x))).2 (orbit_eq x),
      fun γ hγ => (path_eval x (V x) (value_le x) γ hγ).1⟩
  have root_cost (γ : Path) (hγ : IsRootPath m γ) : 1 ≤ pathCost γ := by
    have bounds (d : ℕ) : 0 ≤ ((γ.state d).r : ℝ) ∧ |((γ.state d).r : ℝ)| ≤ m := by
      have H := (hγ.2 d).1.1
      have H0 : (0 : ℤ) ≤ (γ.state d).r := H.1
      have H1 : (γ.state d).r ≤ m := by have := H.2.1; omega
      have H0' : (0 : ℝ) ≤ (γ.state d).r := by exact_mod_cast H0
      refine ⟨H0', ?_⟩
      rw [abs_of_nonneg H0']
      exact_mod_cast H1
    have hr := weighted (fun d => ((γ.state d).r : ℝ)) m (fun d => (bounds d).2)
    have H := hr.sum_le_tsum ({0} : Finset ℕ) (fun d _ =>
      div_nonneg (bounds d).1 (by positivity))
    simpa only [Finset.sum_singleton, hγ.1, root, pow_zero, div_one, Int.cast_one,
      pathCost] using H
  let ratios : Set ℝ := {y | ∃ (p : Fin m → ℝ) (k : Fin m),
    (∀ i, 0 < p i) ∧ (∑ i, p i) = 1 ∧ (∀ i, p k ≤ p i) ∧
      y = DyadicSupportLines.cost p / p k}
  have nonempty : ratios.Nonempty := by
    let p : Fin m → ℝ := fun _ => 1 / m
    let k : Fin m := ⟨0, by omega⟩
    refine ⟨DyadicSupportLines.cost p / p k, p, k, ?_, ?_, fun _ => le_rfl, rfl⟩
    · intro i; dsimp [p]; positivity
    · simp only [p, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      have hm0 : (m : ℝ) ≠ 0 := by exact_mod_cast (show m ≠ 0 by omega)
      field_simp
  have bounded : BddBelow ratios := by
    refine ⟨0, ?_⟩
    rintro y ⟨p, k, hp, hs, hk, rfl⟩
    obtain ⟨γ, hγ, _, _, _, _, hcost⟩ := (CarryGraphEmbedding.result m hm).2.2.2 p hp hs k hk
    have H := root_cost γ hγ
    rw [hcost] at H
    exact div_nonneg (by linarith) (hp k).le
  have alpha_bound (p : Fin m → ℝ) (k : Fin m) (hp : ∀ i, 0 < p i)
      (hs : ∑ i, p i = 1) (hk : ∀ i, p k ≤ p i) :
      alpha m * p k ≤ DyadicSupportLines.cost p := by
    have H : alpha m ≤ DyadicSupportLines.cost p / p k :=
      csInf_le bounded ⟨p, k, hp, hs, hk, rfl⟩
    exact (le_div_iff₀ (hp k)).mp H
  have minmass (p : Fin m → ℝ) (k : Fin m) (hs : ∑ i, p i = 1)
      (hk : ∀ i, p k ≤ p i) : p k ≤ 1 / m := by
    have H := Finset.sum_le_sum (s := Finset.univ) (fun i _ => hk i)
    simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul, hs] at H
    apply (le_div_iff₀ (by positivity : (0 : ℝ) < m)).mpr
    linarith
  have sign (x : ℝ) : 0 ≤ V x o ↔ x ≤ alpha m := by
    constructor
    · intro hx
      apply le_csInf nonempty
      rintro y ⟨p, k, hp, hs, hk, rfl⟩
      obtain ⟨γ, hγ, _, _, _, ha, hc⟩ :=
        (CarryGraphEmbedding.result m hm).2.2.2 p hp hs k hk
      have H := (optimal_path x).2.2 γ hγ
      rw [ha, hc] at H
      apply (le_div_iff₀ (hp k)).mpr
      linarith
    · intro hx
      let γ := policyPath m (f x) o
      have hγ := (optimal_path x).1
      let p : Fin m → ℝ := fun i => Real.ofDigits (CarryGraphRealization.labelDigit γ i)
      obtain ⟨hnonneg, hs, ha, hmin, hpos, _, _, _, _, _, _, _, _, _, hlower, _⟩ :=
        CarryGraphRealization.result m hm γ hγ
      change p ⟨0, by omega⟩ = anchorValue γ at ha
      change DyadicSupportLines.cost p ≤ pathCost γ at hlower
      have ht : 0 ≤ anchorValue γ := by rw [← ha]; exact hnonneg _
      have hvalue := (optimal_path x).2.1
      change V x o = pathCost γ - x * anchorValue γ at hvalue
      by_cases hz : anchorValue γ = 0
      · rw [hz, mul_zero, sub_zero] at hvalue
        have H := root_cost γ hγ
        linarith
      · have htpos : 0 < anchorValue γ := lt_of_le_of_ne ht (Ne.symm hz)
        have H := alpha_bound p ⟨0, by omega⟩ (hpos htpos) hs (fun i => by rw [ha]; exact hmin i)
        rw [ha] at H
        have Hx := mul_le_mul_of_nonneg_right hx ht
        linarith
  have critical_approx (ε : ℝ) (hε : 0 < ε) : V (alpha m) o < ε / m := by
    obtain ⟨y, hy, hlt⟩ := exists_lt_of_csInf_lt nonempty
      (show sInf ratios < alpha m + ε by change alpha m < alpha m + ε; linarith)
    rcases hy with ⟨p, k, hp, hs, hk, rfl⟩
    obtain ⟨γ, hγ, _, _, _, ha, hc⟩ :=
      (CarryGraphEmbedding.result m hm).2.2.2 p hp hs k hk
    have H := (optimal_path (alpha m)).2.2 γ hγ
    rw [ha, hc] at H
    have Hratio := (div_lt_iff₀ (hp k)).mp hlt
    have Hmass := mul_le_mul_of_nonneg_left (minmass p k hs hk) hε.le
    rw [← div_eq_mul_one_div] at Hmass
    nlinarith
  have critical_zero : V (alpha m) o = 0 := by
    apply le_antisymm
    · by_contra hz
      have hv : 0 < V (alpha m) o := lt_of_not_ge hz
      have H := critical_approx (V (alpha m) o) hv
      have H' := (lt_div_iff₀ (by positivity : (0 : ℝ) < m)).mp H
      have hm1 : (1 : ℝ) ≤ m := by exact_mod_cast (show 1 ≤ m by omega)
      nlinarith
    · exact (sign (alpha m)).mpr le_rfl
  refine ⟨V, f, (fun x => ⟨(spec x).1, (spec x).2.1⟩),
    (fun x => (spec x).2.2), optimal_path, sign, critical_zero, ?_⟩
  let γ := policyPath m (f (alpha m)) o
  let p : Fin m → ℝ := fun i => Real.ofDigits (CarryGraphRealization.labelDigit γ i)
  have hγ := (optimal_path (alpha m)).1
  obtain ⟨hnonneg, hs, ha, hmin, hpos, _, _, _, _, hreturn, _, hterminate, hexpect, _, hlower, _⟩ :=
    CarryGraphRealization.result m hm γ hγ
  change p ⟨0, by omega⟩ = anchorValue γ at ha
  change DyadicSupportLines.cost p ≤ pathCost γ at hlower
  have ht : 0 ≤ anchorValue γ := by rw [← ha]; exact hnonneg _
  have hvalue := (optimal_path (alpha m)).2.1
  change V (alpha m) o = pathCost γ - alpha m * anchorValue γ at hvalue
  have htpos : 0 < anchorValue γ := by
    by_contra hn
    have hz : anchorValue γ = 0 := le_antisymm (le_of_not_gt hn) ht
    have H := root_cost γ hγ
    rw [critical_zero, hz, mul_zero, sub_zero] at hvalue
    linarith
  have hc : pathCost γ = alpha m * anchorValue γ := by
    rw [critical_zero] at hvalue
    linarith
  have H := alpha_bound p ⟨0, by omega⟩ (hpos htpos) hs (fun i => by rw [ha]; exact hmin i)
  rw [ha] at H
  have hcost : DyadicSupportLines.cost p = alpha m * anchorValue γ :=
    le_antisymm (hlower.trans_eq hc) H
  have minimum : sInf (Set.range p) = anchorValue γ := by
    apply le_antisymm
    · rw [← ha]
      exact csInf_le (Set.finite_range p).bddBelow ⟨⟨0, by omega⟩, rfl⟩
    · apply le_csInf (Set.range_nonempty p)
      rintro y ⟨i, rfl⟩
      exact hmin i
  exact ⟨htpos, hpos htpos, hs, minimum, hterminate,
    (fun i => (hreturn i).2), hexpect, hc.trans hcost.symm, hcost⟩

end D5.S3.Arith.FibonacciAtomic.CarryGraphCriticalAttainment
