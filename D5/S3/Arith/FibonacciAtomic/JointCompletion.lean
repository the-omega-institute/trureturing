/- GID: D5/S3/Arith/FibonacciAtomic/JointCompletion
   generality: I
   mirror-B: D5/B/S3/Arith/FibonacciAtomic/JointCompletion
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: Joint finite observations give the compact completion of finite Fibonacci sources. -/

import D5.S3.Arith.FibonacciAtomic.RemoteVectorCompensation
import D5.S1.Dynamics.ProfiniteIntegers
import Mathlib.Topology.UniformSpace.AbstractCompletion

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.FibonacciAtomic.JointCompletion

noncomputable section

open D5.S1.Digit.Infinite.SuccessorContinuity (LegalDigits)
open D5.S1.Digit.Infinite.WindowSuccessorGraph (X P)
open D5.S1.Digit.Infinite.ClosedObservationCommonTailWidthModel (finiteTail)
open D5.S3.Arith.FibonacciAtomic.RemoteVectorCompensation (sourceComposition)
open D5.S3.Arith.FibonacciAtomic.GraftAffineClosure (residue)
open D5.S1.Dynamics (ProfiniteIntegers ResidueFamily)
open scoped Topology Uniformity
open Filter Function Set

local notation "K" => LegalDigits × (ProfiniteIntegers × ProfiniteIntegers)
local notation "D" => {b : LegalDigits // finiteTail b}

/-- All low-prefix and two-coordinate modular readings of a completion point.
The second index denotes the positive modulus one greater than that index. -/
def jointObservation (k : K) : ((i : ℕ × ℕ) → X i.1 × (ZMod (i.2 + 1) × ZMod (i.2 + 1))) :=
  fun i => (P i.1 k.1, k.2.1.val i.2, k.2.2.val i.2)

/-- The actual graph of an eventually zero legal source and its finite Fibonacci
composition. The domain retains the `finiteTail` condition. -/
def sourceGraph (b : D) : K :=
  (b.val, ProfiniteIntegers.natEmbedding (sourceComposition b.val).1,
    ProfiniteIntegers.natEmbedding (sourceComposition b.val).2)

/-- Prefix truncation and reduction of both residues are the bonding conditions
on a family of finite joint observations. -/
def compatibleObservations (q : ((i : ℕ × ℕ) → X i.1 × (ZMod (i.2 + 1) × ZMod (i.2 + 1)))) : Prop :=
  ∀ (L L' m m' : ℕ) (hL : L ≤ L') (hm : m + 1 ∣ m' + 1),
    (∀ j : Fin L, (q (L', m')).1.val ⟨j.val, lt_of_lt_of_le j.isLt hL⟩ =
      (q (L, m)).1.val j) ∧
    ZMod.castHom hm (ZMod (m + 1)) (q (L', m')).2.1 = (q (L, m)).2.1 ∧
    ZMod.castHom hm (ZMod (m + 1)) (q (L', m')).2.2 = (q (L, m)).2.2

/-- The uniform structure generated by equality of the finite joint readings
of actual sources, rather than by the address alone. -/
@[instance_reducible] def sourceUniformity : UniformSpace D :=
  letI : ∀ n : ℕ, UniformSpace (ZMod (n + 1)) := fun _ => ⊥
  ⨅ i : ℕ × ℕ, UniformSpace.comap (fun b : D =>
    ((jointObservation (sourceGraph b) i).1.val, (jointObservation (sourceGraph b) i).2))
    inferInstance

private theorem observation_embedding :
    letI : ∀ n : ℕ, UniformSpace (ZMod (n + 1)) := fun _ => ⊥
    IsUniformEmbedding (fun k : K => fun i : ℕ × ℕ =>
      ((jointObservation k i).1.val, (jointObservation k i).2)) := by
  letI : ∀ n : ℕ, UniformSpace (ZMod (n + 1)) := fun _ => ⊥
  have hraw : UniformContinuous (fun k : K => k.1.val) :=
    uniformContinuous_subtype_val.comp uniformContinuous_fst
  have hr1 : UniformContinuous (fun k : K => k.2.1.val) :=
    uniformContinuous_subtype_val.comp (uniformContinuous_fst.comp uniformContinuous_snd)
  have hr2 : UniformContinuous (fun k : K => k.2.2.val) :=
    uniformContinuous_subtype_val.comp (uniformContinuous_snd.comp uniformContinuous_snd)
  have hc : UniformContinuous (fun k : K => fun i : ℕ × ℕ =>
      ((jointObservation k i).1.val, (jointObservation k i).2)) := by
    apply uniformContinuous_pi.mpr
    intro i
    have hu : UniformContinuous (fun k : K => fun j : Fin i.1 => k.1.val j.val) :=
      (Pi.uniformContinuous_precomp (fun j : Fin i.1 => j.val)).comp hraw
    exact hu.prodMk (((Pi.uniformContinuous_proj _ i.2).comp hr1).prodMk
      ((Pi.uniformContinuous_proj _ i.2).comp hr2))
  let extract : ((i : ℕ × ℕ) → (Fin i.1 → Bool) ×
      (ZMod (i.2 + 1) × ZMod (i.2 + 1))) →
      (ℕ → Bool) × (ResidueFamily × ResidueFamily) := fun q =>
    (fun j => (q (j + 1, 0)).1 ⟨j, by omega⟩,
      (fun m => (q (0, m)).2.1), fun m => (q (0, m)).2.2)
  have he : UniformContinuous extract := by
    apply UniformContinuous.prodMk
    · apply uniformContinuous_pi.mpr
      intro j
      exact (Pi.uniformContinuous_proj _ ⟨j, Nat.lt_succ_self j⟩).comp
        (uniformContinuous_fst.comp
          (Pi.uniformContinuous_proj
            (fun i : ℕ × ℕ => (Fin i.1 → Bool) ×
              (ZMod (i.2 + 1) × ZMod (i.2 + 1))) (j + 1, 0)))
    · apply UniformContinuous.prodMk
      · apply uniformContinuous_pi.mpr
        intro m
        exact uniformContinuous_fst.comp
          (uniformContinuous_snd.comp (Pi.uniformContinuous_proj _ (0, m)))
      · apply uniformContinuous_pi.mpr
        intro m
        exact uniformContinuous_snd.comp
          (uniformContinuous_snd.comp (Pi.uniformContinuous_proj _ (0, m)))
  have hi : IsUniformEmbedding (fun k : K =>
      extract (fun i => ((jointObservation k i).1.val, (jointObservation k i).2))) :=
    isUniformEmbedding_subtype_val.prod
      (isUniformEmbedding_subtype_val.prod isUniformEmbedding_subtype_val)
  exact IsUniformEmbedding.of_comp hc he hi

private theorem inverse_limit (q : ((i : ℕ × ℕ) → X i.1 × (ZMod (i.2 + 1) × ZMod (i.2 + 1)))) :
    compatibleObservations q ↔ ∃! k : K, jointObservation k = q := by
  letI : ∀ n : ℕ, UniformSpace (ZMod (n + 1)) := fun _ => ⊥
  constructor
  · intro hq
    have hbit (L m j : ℕ) (hj : j < L) :
        (q (j + 1, 0)).1.val ⟨j, by omega⟩ = (q (L, m)).1.val ⟨j, hj⟩ :=
      ((hq (j + 1) L 0 m (by omega) (one_dvd _)).1 ⟨j, by omega⟩).symm
    let omega : LegalDigits := ⟨fun j => (q (j + 1, 0)).1.val ⟨j, by omega⟩, by
      intro j hj
      apply (q (j + 2, 0)).1.property j (by omega)
      exact ⟨(hbit (j + 2) 0 j (by omega)).symm.trans hj.1,
        (hbit (j + 2) 0 (j + 1) (by omega)).symm.trans hj.2⟩⟩
    let z1 : ProfiniteIntegers := ⟨fun m => (q (0, m)).2.1, by
      intro m m' hm
      exact (hq 0 0 m m' le_rfl hm).2.1⟩
    let z2 : ProfiniteIntegers := ⟨fun m => (q (0, m)).2.2, by
      intro m m' hm
      exact (hq 0 0 m m' le_rfl hm).2.2⟩
    have hk : jointObservation (omega, z1, z2) = q := by
      funext i
      apply Prod.ext
      · apply Subtype.ext
        funext j
        exact hbit i.1 i.2 j.val j.isLt
      · have hr := (hq 0 i.1 i.2 i.2 (Nat.zero_le _) (dvd_refl _)).2
        apply Prod.ext
        · simpa [jointObservation, z1, ZMod.castHom_apply] using hr.1.symm
        · simpa [jointObservation, z2, ZMod.castHom_apply] using hr.2.symm
    refine ⟨(omega, z1, z2), hk, ?_⟩
    intro k hk'
    apply observation_embedding.injective
    exact congrArg (fun q => fun i : ℕ × ℕ => ((q i).1.val, (q i).2))
      (hk'.trans hk.symm)
  · rintro ⟨k, rfl, _⟩
    intro L L' m m' hL hm
    exact ⟨fun _ => rfl, k.2.1.property hm, k.2.2.property hm⟩

/-- Each completion point admits a sequence of actual finite sources that
matches its factorial-stage readings and converges to that point. -/
private theorem approximating_sources (k : K) :
    ∃ s : ℕ → D,
      (∀ n, jointObservation (sourceGraph (s n)) (n, (n + 1).factorial - 1) =
        jointObservation k (n, (n + 1).factorial - 1)) ∧
      Tendsto (sourceGraph ∘ s) atTop (𝓝 k) := by
  classical
  let t : ℕ → ℕ := fun n => (n + 1).factorial - 1
  have ht (n : ℕ) : t n + 1 = (n + 1).factorial :=
    Nat.sub_add_cancel (Nat.factorial_pos _)
  have hex (n : ℕ) : ∃ b : D, P n b.val = P n k.1 ∧
      residue (t n + 1) (sourceComposition b.val) =
        (k.2.1.val (t n), k.2.2.val (t n)) := by
    obtain ⟨b, hb, hp, hr, _, _⟩ := RemoteVectorCompensation.result n (P n k.1)
      (t n + 1) (Nat.zero_lt_succ _) (k.2.1.val (t n), k.2.2.val (t n)) 0
    exact ⟨⟨b, hb⟩, hp, hr⟩
  choose s hsP hsR using hex
  have hbits (j n : ℕ) (hj : j < n) : (s n).val.val j = k.1.val j :=
    congrArg (fun p : X n => p.val ⟨j, hj⟩) (hsP n)
  have hmod (m n : ℕ) (hmn : m ≤ n) :
      (sourceGraph (s n)).2.1.val m = k.2.1.val m ∧
      (sourceGraph (s n)).2.2.val m = k.2.2.val m := by
    have hd : m + 1 ∣ t n + 1 := by
      rw [ht]
      exact Nat.dvd_factorial (Nat.zero_lt_succ _) (by omega)
    constructor
    · change ((sourceComposition (s n).val).1 : ZMod (m + 1)) = k.2.1.val m
      calc
        _ = ZMod.castHom hd (ZMod (m + 1))
            ((sourceComposition (s n).val).1 : ZMod (t n + 1)) := by simp
        _ = ZMod.castHom hd (ZMod (m + 1)) (k.2.1.val (t n)) :=
          congrArg (ZMod.castHom hd (ZMod (m + 1))) (congrArg Prod.fst (hsR n))
        _ = _ := k.2.1.property hd
    · change ((sourceComposition (s n).val).2 : ZMod (m + 1)) = k.2.2.val m
      calc
        _ = ZMod.castHom hd (ZMod (m + 1))
            ((sourceComposition (s n).val).2 : ZMod (t n + 1)) := by simp
        _ = ZMod.castHom hd (ZMod (m + 1)) (k.2.2.val (t n)) :=
          congrArg (ZMod.castHom hd (ZMod (m + 1))) (congrArg Prod.snd (hsR n))
        _ = _ := k.2.2.property hd
  refine ⟨s, ?_, ?_⟩
  · intro n
    exact Prod.ext (hsP n) (hsR n)
  · apply Filter.Tendsto.prodMk_nhds
    · apply tendsto_subtype_rng.mpr
      apply tendsto_pi_nhds.mpr
      intro j
      apply tendsto_const_nhds.congr'
      filter_upwards [eventually_ge_atTop (j + 1)] with n hn
      exact (hbits j n (by omega)).symm
    · apply Filter.Tendsto.prodMk_nhds
      · apply tendsto_subtype_rng.mpr
        apply tendsto_pi_nhds.mpr
        intro m
        apply tendsto_const_nhds.congr'
        filter_upwards [eventually_ge_atTop m] with n hn
        exact (hmod m n hn).1.symm
      · apply tendsto_subtype_rng.mpr
        apply tendsto_pi_nhds.mpr
        intro m
        apply tendsto_const_nhds.congr'
        filter_upwards [eventually_ge_atTop m] with n hn
        exact (hmod m n hn).2.symm

private theorem legal_compact : CompactSpace LegalDigits := by
  have hc : IsClosed {x : ℕ → Bool | ∀ j, ¬ (x j = true ∧ x (j + 1) = true)} := by
    simp only [Set.ofPred_forall]
    apply isClosed_iInter
    intro j
    have hd : IsClosed {p : Bool × Bool | p ≠ (true, true)} := isClosed_discrete _
    have hf : Continuous (fun x : ℕ → Bool => (x j, x (j + 1))) :=
      (continuous_apply j).prodMk (continuous_apply (j + 1))
    simpa only [Set.preimage_ofPred_eq, ne_eq, Prod.mk.injEq] using hd.preimage hf
  exact isCompact_iff_compactSpace.mp hc.isCompact

private theorem profinite_compact : CompactSpace ProfiniteIntegers := by
  have hc : IsClosed {x : ResidueFamily |
      ∀ (m n : ℕ) (h : m + 1 ∣ n + 1),
        ZMod.castHom h (ZMod (m + 1)) (x n) = x m} := by
    simp only [Set.ofPred_forall]
    apply isClosed_iInter
    intro m
    apply isClosed_iInter
    intro n
    apply isClosed_iInter
    intro h
    exact isClosed_eq (continuous_of_discreteTopology.comp (continuous_apply n))
      (continuous_apply m)
  exact isCompact_iff_compactSpace.mp hc.isCompact

/-- Actual finite sources have every finite joint reading; compatible readings
form exactly the product completion; the actual source graph is dense, with
factorial-modulus approximations; and the finite-observation uniform structure
has this compact product as an abstract completion. -/
theorem result :
    letI : ∀ n : ℕ, UniformSpace (ZMod (n + 1)) := fun _ => ⊥
    (∀ i : ℕ × ℕ, Surjective (fun b : D => jointObservation (sourceGraph b) i)) ∧
    (IsUniformEmbedding (fun k : K => fun i : ℕ × ℕ =>
        ((jointObservation k i).1.val, (jointObservation k i).2)) ∧
      ∀ q, compatibleObservations q ↔ ∃! k : K, jointObservation k = q) ∧
    (DenseRange sourceGraph ∧ ∀ k : K, ∃ s : ℕ → D,
      (∀ n, jointObservation (sourceGraph (s n)) (n, (n + 1).factorial - 1) =
        jointObservation k (n, (n + 1).factorial - 1)) ∧
      Tendsto (sourceGraph ∘ s) atTop (𝓝 k)) ∧
    (CompactSpace K ∧
      (letI : UniformSpace D := sourceUniformity
       IsUniformEmbedding sourceGraph ∧ ∃ c : AbstractCompletion D,
         c.space = K ∧ HEq c.uniformStruct (inferInstance : UniformSpace K) ∧
         HEq c.coe sourceGraph)) := by
  letI : ∀ n : ℕ, UniformSpace (ZMod (n + 1)) := fun _ => ⊥
  letI : UniformSpace D := sourceUniformity
  have hdense : DenseRange sourceGraph := by
    intro k
    obtain ⟨s, _, hs⟩ := approximating_sources k
    exact mem_closure_of_tendsto hs (Eventually.of_forall fun n => ⟨s n, rfl⟩)
  have hsource : IsUniformInducing sourceGraph := by
    have hq : IsUniformInducing (fun b : D => fun i : ℕ × ℕ =>
        ((jointObservation (sourceGraph b) i).1.val,
          (jointObservation (sourceGraph b) i).2)) := by
      rw [isUniformInducing_iff_uniformSpace]
      change _ = sourceUniformity
      simp only [sourceUniformity, Pi.uniformSpace_eq, UniformSpace.comap_iInf,
        ← UniformSpace.comap_comap, Function.comp_def]
    exact observation_embedding.isUniformInducing.of_comp_iff.mp hq
  have hsourceEmbedding : IsUniformEmbedding sourceGraph :=
    ⟨hsource, fun a b h => Subtype.ext (congrArg Prod.fst h)⟩
  letI : CompactSpace LegalDigits := legal_compact
  letI : CompactSpace ProfiniteIntegers := profinite_compact
  refine ⟨?_, ⟨observation_embedding, inverse_limit⟩,
    ⟨hdense, approximating_sources⟩, inferInstance, hsourceEmbedding, ?_⟩
  · intro i p
    obtain ⟨b, hb, hp, hr, _, _⟩ := RemoteVectorCompensation.result i.1 p.1
      (i.2 + 1) (Nat.zero_lt_succ _) p.2 0
    exact ⟨⟨b, hb⟩, Prod.ext hp hr⟩
  · exact ⟨{
      space := K
      coe := sourceGraph
      uniformStruct := inferInstance
      complete := inferInstance
      separation := inferInstance
      isUniformInducing := hsource
      dense := hdense }, rfl, HEq.rfl, HEq.rfl⟩

end

end D5.S3.Arith.FibonacciAtomic.JointCompletion
