      matrixM ^ 4 = matrixC ∧ Matrix.det matrixM = -1 ∧ Matrix.det matrixC = 1 ∧
      matrixC * !![5, -3; -3, 2] = 1 ∧ matrixM ^ 2 = matrixM + 1 ∧
      (∀ t ∈ graftSpace H w, step t ∈ graftSpace H w ∧
