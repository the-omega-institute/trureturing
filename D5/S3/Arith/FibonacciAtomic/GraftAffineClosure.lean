          List.length_cons, List.length_nil]
        omega
      · apply (zeroReadout _).mpr
        rw [hqty]; simp [c]
      · have hneH : readout H (run w W v') ≠ H := by
          intro hh
          have hz := (zeroReadout _).mp hh
          rw [hqty] at hz
          dsimp [c] at hz
          exact hdiff (eq_of_sub_eq_zero (by simpa only [sub_eq_add_neg] using hz)).symm
        have hle : readout H (run w W v') ≤ H :=
          Nat.le_of_dvd hH (Nat.gcd_dvd_right _ _)
        change readout H (run w W v') < H
        omega
    have classifier (v v' : ℕ × ℕ) : behavior H w v v' ↔ residue H v = residue H v' := by
      constructor
      · intro hb
        by_contra hne
        obtain ⟨k, A, B, _, _, _, _, _, hfirst, hsecond⟩ := separates v v' hne
        have hh := hb (realizationWord H k A B)
        rw [hfirst] at hh
        omega
      · intro heq W
        apply Eq.trans (residueDecoder _).symm
        apply Eq.trans _ (residueDecoder _)
        rw [castRun, castRun, heq]
    have lower (S : Type) (E : (ℕ × ℕ) → S) (δR δG : S → S) (o : S → ℕ)
        (hE : Autonomous H w E δR δG o) : (H ^ 2 : ℕ) ≤ Cardinal.mk (Set.range E) := by
      have transport (W : List Bool) (v : ℕ × ℕ) :
          E (run w W v) = W.foldl (fun s (op : Bool) => if op then δG s else δR s) (E v) := by
        apply Eq.symm
        exact List.foldl_hom E (by
          intro u op
          cases op <;> simp only [Bool.false_eq_true, if_false, if_true]
          · exact (hE.1 u).symm
          · exact (hE.2.1 u).symm)
      have fibers (v v' : ℕ × ℕ) (he : E v = E v') : behavior H w v v' := by
        intro W
        rw [← hE.2.2, ← hE.2.2, transport, transport, he]
      let f : (ZMod H × ZMod H) → Set.range E :=
        fun x => ⟨E (x.1.val, x.2.val), (x.1.val, x.2.val), rfl⟩
      have hf : Function.Injective f := by
        intro x y he
        have hb := fibers (x.1.val, x.2.val) (y.1.val, y.2.val) (congrArg Subtype.val he)
        simpa only [residue, ZMod.natCast_zmod_val] using (classifier _ _).mp hb
      rw [← count]
      exact Cardinal.mk_le_of_injective hf
    refine ⟨⟨hq, hq'⟩, hprimitive, hdOne, ?_, ?_, blockColumns j,
      hqtyCoprime,
      blockDet, classifier, separates, lower⟩
    · intro hj; rw [hw, hj]; rfl
    · intro hj
      obtain ⟨i, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hj.ne'
      simpa only [Nat.succ_eq_add_one, Nat.add_sub_cancel, blockSucc] using hw
  have spaceStable (t : ZMod H × ZMod H) (ht : t ∈ graftSpace H w) :
      step t ∈ graftSpace H w ∧ (t.2 - t.1, t.1) ∈ graftSpace H w := by
    obtain ⟨a, b, rfl⟩ := ht
    constructor
    · refine ⟨b, a + b, ?_⟩
      ext <;> simp [step, smul_eq_mul] <;> ring
    · refine ⟨b - a, a, ?_⟩
      ext <;> simp [step, smul_eq_mul] <;> ring
  have wordLength (k A B : ℕ) : (realizationWord H k A B).length = L + k + A + B := by
    simp only [realizationWord, List.length_append, List.length_replicate,
      List.length_cons, List.length_nil]
    omega
  have zeroTranslation (hd : d = H) (k : ℕ) (b : ℤ) (v : ℕ × ℕ) :
      Int.gcd (((quantity (step^[k] v) : ℕ) : ℤ) + d * b) H = readout H (step^[k] v) := by
    have hg := gcdCong H (x := ((quantity (step^[k] v) : ℕ) : ℤ) + d * b)
      (y := ((quantity (step^[k] v) : ℕ) : ℤ)) (by simp [hd])
    simpa only [readout, Int.gcd_natCast_natCast] using hg
  exact ⟨wordAffine, period, exactWord, allTranslations, gcdIdeal, ideal, tests, globalLabels,
    residueOnto, (fun x => ⟨(x.1.val, x.2.val), ZMod.val_lt _, ZMod.val_lt _, by
      simp [residue]⟩), observationOnto, observationLaws, observationIter, residueAutonomous, count,
    (by rw [residueOnto.range_eq]; simpa only [Cardinal.mk_univ] using count),
    observationInverse, by decide, by decide, by decide, by decide, by decide,
    spaceStable, wordLength, zeroTranslation, by intro h v; simp [h, readout], atomic⟩


#print axioms result

end D5.S3.Arith.FibonacciAtomic.GraftAffineClosure
