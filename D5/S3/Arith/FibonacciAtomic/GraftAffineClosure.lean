open D5.S3.Arith.Congruence.PrimePowerAffineBehavior (depth)

/-- The Fibonacci step acts on complete compositions. -/
def step {A : Type*} [Add A] (v : A × A) : A × A := (v.2, v.1 + v.2)

/-- The quantity of a composition. -/
def quantity {A : Type*} [Semiring A] (v : A × A) : A := 2 * v.1 + 3 * v.2

/-- The two consecutive quantity coordinates. -/
def observe {A : Type*} [Semiring A] (v : A × A) : A × A :=
  (quantity v, quantity (step v))

/-- Chronological words: false denotes the step and true denotes grafting. -/
def run {A : Type*} [Add A] (w : A × A) (W : List Bool) (v : A × A) : A × A :=
  W.foldl (fun u op => if op then u + w else step u) v

/-- The actual current gcd readout includes zero quantities. -/
def readout (H : ℕ) (v : ℕ × ℕ) : ℕ := Nat.gcd (quantity v) H

/-- Both sources execute the same arbitrary finite chronological word. -/
def behavior (H : ℕ) (w v v' : ℕ × ℕ) : Prop :=
  ∀ W : List Bool, readout H (run w W v) = readout H (run w W v')

/-- The exact congruence coordinates of an actual source. -/
def residue (H : ℕ) (v : ℕ × ℕ) : ZMod H × ZMod H := (v.1, v.2)

/-- The observable gcd of the complete graft composition. -/
def graftGcd (H : ℕ) (w : ℕ × ℕ) : ℕ := Nat.gcd (Nat.gcd w.1 w.2) H

/-- The module of translations generated by the graft and its next step. -/
def graftSpace (H : ℕ) (w : ℕ × ℕ) : Set (ZMod H × ZMod H) :=
  {t | ∃ a b : ZMod H, t = a • residue H w + b • step (residue H w)}

/-- A forward word with two graft blocks and one complete return period. -/
def realizationWord (H k A B : ℕ) : List Bool :=
  List.replicate k false ++ List.replicate A true ++
    List.replicate ((H ^ 2).factorial - 1) false ++
    List.replicate B true ++ [false]

/-- A translation-only classifier retains low depth or the complete high residue. -/
def psi (p h e : ℕ) (x : ℤ) : ℕ ⊕ ZMod (p ^ h) :=
  if depth p h x < e then .inl (depth p h x) else .inr (x : ZMod (p ^ h))

/-- An autonomous representation respects both operations and the current decoder. -/
def Autonomous {S : Type*} (H : ℕ) (w : ℕ × ℕ) (E : (ℕ × ℕ) → S)
    (δR δG : S → S) (o : S → ℕ) : Prop :=
  (∀ v, E (step v) = δR (E v)) ∧ (∀ v, E (v + w) = δG (E v)) ∧
    ∀ v, o (E v) = readout H v

/-- The actual Fibonacci block composition. -/
def atomicBlock (j : ℕ) : ℕ × ℕ := step^[j] (1, 0)

/-- The Fibonacci matrix on integer compositions. -/
def matrixM : Matrix (Fin 2) (Fin 2) ℤ := !![0, 1; 1, 1]

/-- The unimodular matrix of two consecutive quantities. -/
def matrixC : Matrix (Fin 2) (Fin 2) ℤ := !![2, 3; 3, 5]

/-- Columns are the actual block and its next actual step. -/
def blockMatrix (j : ℕ) : Matrix (Fin 2) (Fin 2) ℤ :=
  !![(atomicBlock j).1, (step (atomicBlock j)).1;
    (atomicBlock j).2, (step (atomicBlock j)).2]

/-- The decoder reads the gcd of a residue quantity. -/
def residueReadout (H : ℕ) (v : ZMod H × ZMod H) : ℕ := Nat.gcd (quantity v).val H

/-- Translation labels and the exact forward affine action of graft words. -/
theorem result :
    (∀ (p h e : ℕ), p.Prime → e ≤ h → ∀ x y : ℤ,
      (∀ b : ℤ, Int.gcd (x + (p : ℤ) ^ e * b) ((p : ℤ) ^ h) =
