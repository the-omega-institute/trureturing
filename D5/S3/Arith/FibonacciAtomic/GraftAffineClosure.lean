      (∀ j : ℕ, w = atomicBlock j →
        (quantity w = Nat.fib (j + 3) ∧ quantity (step w) = Nat.fib (j + 4)) ∧
        Nat.gcd w.1 w.2 = 1 ∧ graftGcd H w = 1 ∧
