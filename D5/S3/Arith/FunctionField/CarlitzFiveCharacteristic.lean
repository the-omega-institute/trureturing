private def lAdd {A : Type*} (add : A → A → A) : List A → List A → List A
  | [], ys => ys
  | xs, [] => xs
  | x :: xs, y :: ys => add x y :: lAdd add xs ys

private def lNeg {A : Type*} (neg : A → A) : List A → List A := List.map neg

private def lScale {A : Type*} (mul : A → A → A) (a : A) : List A → List A :=
  List.map (mul a)

private def lMul {A : Type*} (zero : A) (add mul : A → A → A) :
    List A → List A → List A
  | [], _ => []
  | a :: as, bs => lAdd add (lScale mul a bs) (zero :: lMul zero add mul as bs)

private def lEval {A R : Type*} [CommRing R] (f : A → R) (x : R) : List A → R
  | [] => 0
  | a :: as => f a + x * lEval f x as

private theorem lEval_add {A R : Type*} [CommRing R] (zero : A) (add : A → A → A)
    (f : A → R) (x : R) (_hz : f zero = 0) (ha : ∀ a b, f (add a b) = f a + f b)
    (p q : List A) : lEval f x (lAdd add p q) = lEval f x p + lEval f x q := by
  induction p generalizing q with
  | nil => simp [lAdd, lEval]
  | cons a p ih =>
      cases q with
      | nil => simp [lAdd, lEval]
      | cons b q => simp only [lAdd, lEval, ha, ih]; ring

private theorem lEval_neg {A R : Type*} [CommRing R] (neg : A → A) (f : A → R)
    (x : R) (hn : ∀ a, f (neg a) = -f a) (p : List A) :
    lEval f x (lNeg neg p) = -lEval f x p := by
  induction p with
  | nil => simp [lNeg, lEval]
  | cons a p ih =>
      simp only [lNeg, List.map, lEval, hn]
      rw [show lEval f x (List.map neg p) = -lEval f x p by simpa [lNeg] using ih]
      ring

private theorem lEval_scale {A R : Type*} [CommRing R] (mul : A → A → A)
    (f : A → R) (x : R) (hm : ∀ a b, f (mul a b) = f a * f b) (a : A) (p : List A) :
    lEval f x (lScale mul a p) = f a * lEval f x p := by
  induction p with
  | nil => simp [lScale, lEval]
  | cons b p ih =>
      simp only [lScale, List.map, lEval, hm]
      rw [show lEval f x (List.map (mul a) p) = f a * lEval f x p by
        simpa [lScale] using ih]
      ring

private theorem lEval_mul {A R : Type*} [CommRing R] (zero : A) (add mul : A → A → A)
    (f : A → R) (x : R) (hz : f zero = 0) (ha : ∀ a b, f (add a b) = f a + f b)
    (hm : ∀ a b, f (mul a b) = f a * f b) (p q : List A) :
    lEval f x (lMul zero add mul p q) = lEval f x p * lEval f x q := by
  induction p with
  | nil => simp [lMul, lEval]
  | cons a p ih =>
      simp only [lMul, lEval_add zero add f x hz ha, lEval_scale mul f x hm, lEval, ih, hz]
      ring

