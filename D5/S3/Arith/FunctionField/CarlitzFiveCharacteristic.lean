private def e1 {R : Type*} [CommRing R] (p : P1) (a : R) : R := lEval Int.cast a p
private def e2 {R : Type*} [CommRing R] (p : P2) (a b : R) : R := lEval (fun q => e1 q a) b p
private def e3 {R : Type*} [CommRing R] (p : P3) (a b c : R) : R := lEval (fun q => e2 q a b) c p
private def e4 {R : Type*} [CommRing R] (p : P4) (a b c d : R) : R := lEval (fun q => e3 q a b c) d p

