/-- The actual closed five-orbit condition confines prime characteristic to
2, 5, 19, 263, or 519555805809266011. The conclusion is stated as exact
integer divisibility, without assuming primality of the last displayed factor.
The proof supplies an integer ideal certificate and a characteristic-three
contradiction. It never assumes a Groebner-basis answer or a finite search bound. -/
theorem result {K : Type*} [Field K] (p : ℕ) [CharP K p]
    (hp : p.Prime) (sigma : K →+* K) (theta : K)
    (hcycle : sigma (sigma (sigma (sigma (sigma theta)))) = theta)
    (hroot : residual (sigma theta - theta)
      (sigma (sigma theta) - theta)
      (sigma (sigma (sigma theta)) - theta)
      (sigma (sigma (sigma (sigma theta))) - theta) = 0) :
    p ∣ 8 * 25 * 19 * 263 * 519555805809266011 := by
  let a := sigma theta - theta
  let b := sigma (sigma theta) - theta
  let c := sigma (sigma (sigma theta)) - theta
  let d := sigma (sigma (sigma (sigma theta))) - theta
  have h0 : residual a b c d = 0 := hroot
  have h1 : residual (b-a) (c-a) (d-a) (-a) = 0 := by
    have h := congrArg sigma h0
    dsimp [a, b, c, d, residual] at h ⊢
    simp only [map_sub, map_mul, map_one, map_zero, hcycle] at h
    convert h using 1 <;> ring
  have h2 : residual (c-b) (d-b) (-b) (a-b) = 0 := by
    have h := congrArg sigma h1
    dsimp [a, b, c, d, residual] at h ⊢
    simp only [map_sub, map_mul, map_neg, map_one, map_zero, hcycle] at h
    convert h using 1 <;> ring
  have h3 : residual (d-c) (-c) (a-c) (b-c) = 0 := by
    have h := congrArg sigma h2
    dsimp [a, b, c, d, residual] at h ⊢
    simp only [map_sub, map_mul, map_neg, map_one, map_zero, hcycle] at h
    convert h using 1 <;> ring
  have h4 : residual (-d) (a-d) (b-d) (c-d) = 0 := by
    have h := congrArg sigma h3
    dsimp [a, b, c, d, residual] at h ⊢
    simp only [map_sub, map_mul, map_neg, map_one, map_zero, hcycle] at h
    convert h using 1 <;> ring
