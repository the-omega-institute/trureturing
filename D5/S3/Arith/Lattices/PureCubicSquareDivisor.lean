/- GID: D5/S3/Arith/Lattices/PureCubicSquareDivisor
   generality: G
   mirror-B: D5/B/S3/Arith/Lattices/PureCubicSquareDivisor
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: A square divisor gives an integral element outside a pure cubic suborder. -/

import D5.S3.Arith.Lattices.PureCubicSuborder
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.Lattices.PureCubicSquareDivisor

open D5.S3.Arith.Lattices.PureCubicSuborder
open Module

/-- A prime square dividing the radicand gives an explicit integral element
outside the order generated by `1`, `theta`, and `(1 + theta + theta^2)/3`. -/
theorem square_divisor_obstructs_maximality
    {K : Type*} [Field K] [CharZero K] [Algebra ℚ K]
    (pb : PowerBasis ℚ K) (h3 : pb.dim = 3) (a : ℤ)
    (hroot : pb.gen ^ 3 = ((1 + 9 * a : ℤ) : K))
    (p : ℕ) (hp : p.Prime) (hp3 : p ≠ 3)
    (hdiv : (p : ℤ) ^ 2 ∣ 1 + 9 * a) :
    let z : K := pb.gen ^ 2 / (p : K)
    ∃ A : Subring K,
      (∀ x : K, x ∈ A ↔
        ∃ u v w : ℤ,
          x = (u : K) + (v : K) * pb.gen +
            (w : K) * ((1 + pb.gen + pb.gen ^ 2) / 3)) ∧
      (∀ x ∈ A, IsIntegral ℤ x) ∧ IsIntegral ℤ z ∧ z ∉ A := by
  let z : K := pb.gen ^ 2 / (p : K)
  change ∃ A : Subring K,
    (∀ x : K, x ∈ A ↔
      ∃ u v w : ℤ,
        x = (u : K) + (v : K) * pb.gen +
          (w : K) * ((1 + pb.gen + pb.gen ^ 2) / 3)) ∧
    (∀ x ∈ A, IsIntegral ℤ x) ∧ IsIntegral ℤ z ∧ z ∉ A
  have hpK : (p : K) ≠ 0 := by exact_mod_cast hp.ne_zero
  obtain ⟨t, ht⟩ := hdiv
  have hzcube : z ^ 3 = (((p : ℤ) * t ^ 2 : ℤ) : K) := by
    calc
      z ^ 3 = (pb.gen ^ 3) ^ 2 / (p : K) ^ 3 := by dsimp [z]; ring
      _ = (((p : ℤ) * t ^ 2 : ℤ) : K) := by
        rw [hroot, ht]
        field_simp [hpK]
        push_cast
        ring
  have hzint : IsIntegral ℤ z := by
    apply IsIntegral.of_pow (n := 3) (by norm_num)
    rw [hzcube]
    exact isIntegral_algebraMap
  let b : Basis (Fin 3) ℚ K := pb.basis.reindex (finCongr h3)
  have hb (i : Fin 3) : b i = pb.gen ^ (i : ℕ) := by
    simp [b, Basis.reindex_apply, pb.basis_eq_pow]
  have hcoord0 : b.coord 2 (1 : K) = 0 := by
    rw [← show b 0 = (1 : K) by simpa using hb 0]
    simp [Basis.coord_apply]
  have hcoord1 : b.coord 2 pb.gen = 0 := by
    rw [← show b 1 = pb.gen by simpa using hb 1]
    simp [Basis.coord_apply]
  have hcoord2 : b.coord 2 (pb.gen ^ 2) = 1 := by
    rw [← show b 2 = pb.gen ^ 2 by simpa using hb 2]
    simp [Basis.coord_apply]
  have hnot : ¬ ∃ u v w : ℤ,
      z = (u : K) + (v : K) * pb.gen +
        (w : K) * ((1 + pb.gen + pb.gen ^ 2) / 3) := by
    rintro ⟨u, v, w, heq⟩
    have heq' : (3 : K) * pb.gen ^ 2 =
        (p : K) * ((3 * (u : K) + (w : K)) +
          (3 * (v : K) + (w : K)) * pb.gen +
          (w : K) * pb.gen ^ 2) := by
      dsimp [z] at heq
      field_simp [hpK] at heq ⊢
      linear_combination heq
    have heq'' : (3 : ℚ) • pb.gen ^ 2 = (p : ℚ) •
        (((3 * (u : ℚ) + (w : ℚ)) • (1 : K)) +
          ((3 * (v : ℚ) + (w : ℚ)) • pb.gen) +
          ((w : ℚ) • pb.gen ^ 2)) := by
      convert heq' using 1 <;> norm_num [Algebra.smul_def]
    have hc := congrArg (fun x : K => b.coord 2 x) heq''
    simp only [map_add, map_smul] at hc
    have hc' : (3 : ℚ) = (p : ℚ) * (w : ℚ) := by
      simpa [hcoord0, hcoord1, hcoord2] using hc
    have hnat : p ∣ 3 := by
      have hw : (p : ℤ) * w = 3 := by exact_mod_cast hc'.symm
      have hdiv3 : (p : ℤ) ∣ 3 := ⟨w, hw.symm⟩
      exact_mod_cast hdiv3
    exact hp3 ((Nat.prime_dvd_prime_iff_eq hp (by norm_num : Nat.Prime 3)).mp hnat)
  obtain ⟨_, _, _, A, hA, hAint, _⟩ := pure_cubic_suborder pb h3 a hroot
  refine ⟨A, ?_, hAint, hzint, ?_⟩
  · simpa using hA
  · exact hnot ∘ (hA z).mp

#print axioms square_divisor_obstructs_maximality

end D5.S3.Arith.Lattices.PureCubicSquareDivisor
