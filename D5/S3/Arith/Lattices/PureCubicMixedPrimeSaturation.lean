/- GID: D5/S3/Arith/Lattices/PureCubicMixedPrimeSaturation
   generality: G
   mirror-B: D5/B/S3/Arith/Lattices/PureCubicMixedPrimeSaturation
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Local prime saturation of the mixed pure-cubic integral lattice. -/

import D5.S3.Arith.Lattices.PureCubicIntegralLattices
import Mathlib.RingTheory.Polynomial.Eisenstein.IsIntegral
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.Lattices.PureCubicMixedPrimeSaturation

open Polynomial Algebra

/-- A prime occurring once in either cubic radicand cannot enlarge the mixed
integral lattice generated by one, the original cubic root, and its third. -/
theorem pure_cubic_mixed_prime_saturation
    {K : Type*} [Field K] [CharZero K] [Algebra ℚ K]
    (pb : PowerBasis ℚ K) (h3 : pb.dim = 3)
    (m n c a k v : ℤ) (hm : m ≠ 0) (hn : n ≠ 0)
    (hv : v = 1 ∨ v = -1)
    (hroot : pb.gen ^ 3 = ((m * n ^ 2 : ℤ) : K))
    (hcubic : c ^ 3 * m * n ^ 2 = 1 + 9 * a)
    (hcv : c ^ 2 * n = v + 3 * k)
    (p : ℕ) (hp : p.Prime)
    (hlocal :
      ((p : ℤ) ∣ m * n ^ 2 ∧ ¬(p : ℤ) ^ 2 ∣ m * n ^ 2 ∧
        IsCoprime (p : ℤ) (3 * n)) ∨
      ((p : ℤ) ∣ m ^ 2 * n ∧ ¬(p : ℤ) ^ 2 ∣ m ^ 2 * n ∧
        IsCoprime (p : ℤ) (3 * m)))
    (z : K) (hzint : IsIntegral ℤ z)
    (hpz : ∃ u r s : ℤ,
      (p : K) * z = (u : K) + (r : K) * pb.gen +
        (s : K) * ((1 + (c : K) * pb.gen +
          (v : K) * (pb.gen ^ 2 / (n : K))) / 3)) :
    ∃ u r s : ℤ,
      z = (u : K) + (r : K) * pb.gen +
        (s : K) * ((1 + (c : K) * pb.gen +
          (v : K) * (pb.gen ^ 2 / (n : K))) / 3) := by
  letI : Module.Finite ℚ K := pb.finite
  let alpha : K := pb.gen
  let beta : K := alpha ^ 2 / (n : K)
  let gamma : K := (1 + (c : K) * alpha + (v : K) * beta) / 3
  have hnK : (n : K) ≠ 0 := by exact_mod_cast hn
  have hmK : (m : K) ≠ 0 := by exact_mod_cast hm
  have hvSq : (v : K) ^ 2 = 1 := by
    rcases hv with hv | hv <;> rw [hv] <;> norm_num
  have hbetaSq : beta ^ 2 = (m : K) * alpha := by
    dsimp [beta, alpha]
    field_simp [hnK]
    calc
      pb.gen ^ 4 = pb.gen * pb.gen ^ 3 := by ring
      _ = pb.gen * (n : K) ^ 2 * (m : K) := by
        rw [hroot]
        push_cast
        ring
  have hbetaCube : beta ^ 3 = ((m ^ 2 * n : ℤ) : K) := by
    dsimp [beta, alpha]
    calc
      (pb.gen ^ 2 / (n : K)) ^ 3 = (pb.gen ^ 3) ^ 2 / (n : K) ^ 3 := by ring
      _ = ((m ^ 2 * n : ℤ) : K) := by
        rw [hroot]
        field_simp [hnK]
        push_cast
        ring
  have hbetaRel : beta = (v : K) * (3 * gamma - 1 - (c : K) * alpha) := by
    calc
      beta = (v : K) ^ 2 * beta := by rw [hvSq]; ring
      _ = (v : K) * (3 * gamma - 1 - (c : K) * alpha) := by
        dsimp [gamma]
        field_simp
        ring
  have hgammaA : (3 * n : K) * gamma =
      (n : K) + ((c * n : ℤ) : K) * alpha + (v : K) * alpha ^ 2 := by
    dsimp [gamma, beta]
    field_simp [hnK]
    push_cast
    ring
  have hgammaB : (3 * m : K) * gamma =
      (m : K) + (c : K) * beta ^ 2 + ((v * m : ℤ) : K) * beta := by
    dsimp [gamma]
    rw [hbetaSq]
    push_cast
    ring
  let S : Set K := {x | ∃ u r s : ℤ,
    x = (u : K) + (r : K) * alpha + (s : K) * gamma}
  have hS_add {x y : K} (hx : x ∈ S) (hy : y ∈ S) : x + y ∈ S := by
    obtain ⟨u, r, s, rfl⟩ := hx
    obtain ⟨u', r', s', rfl⟩ := hy
    refine ⟨u + u', r + r', s + s', ?_⟩
    push_cast
    ring
  have hS_smul (d : ℤ) {x : K} (hx : x ∈ S) : (d : K) * x ∈ S := by
    obtain ⟨u, r, s, rfl⟩ := hx
    refine ⟨d * u, d * r, d * s, ?_⟩
    push_cast
    ring
  have hS_one : (1 : K) ∈ S := ⟨1, 0, 0, by simp⟩
  have hS_int (d : ℤ) : (d : K) ∈ S := by
    simpa using hS_smul d hS_one
  have hS_alpha : alpha ∈ S := ⟨0, 1, 0, by simp⟩
  have hS_gamma : gamma ∈ S := ⟨0, 0, 1, by simp⟩
  have hS_beta : beta ∈ S := by
    refine ⟨-v, -(v * c), 3 * v, ?_⟩
    rw [hbetaRel]
    push_cast
    ring
  have hS_alphaSq : alpha ^ 2 ∈ S := by
    have h : alpha ^ 2 = (n : K) * beta := by
      dsimp [beta]
      field_simp [hnK]
    rw [h]
    exact hS_smul n hS_beta
  have hS_betaSq : beta ^ 2 ∈ S := by
    rw [hbetaSq]
    exact hS_smul m hS_alpha
  -- Cubic reduction gives integer coordinates for each generated subring.
  have hspan (x : K) (d : ℤ) (hx : x ^ 3 = (d : K))
      {y : K} (hy : y ∈ adjoin ℤ ({x} : Set K)) :
      ∃ u r s : ℤ, y = (u : K) + (r : K) * x + (s : K) * x ^ 2 := by
    let T : Subring K := {
      carrier := {y | ∃ u r s : ℤ,
        y = (u : K) + (r : K) * x + (s : K) * x ^ 2}
      zero_mem' := ⟨0, 0, 0, by simp⟩
      one_mem' := ⟨1, 0, 0, by simp⟩
      add_mem' := by
        intro y y' hy hy'
        obtain ⟨u, r, s, rfl⟩ := hy
        obtain ⟨u', r', s', rfl⟩ := hy'
        refine ⟨u + u', r + r', s + s', ?_⟩
        push_cast
        ring
      neg_mem' := by
        intro y hy
        obtain ⟨u, r, s, rfl⟩ := hy
        refine ⟨-u, -r, -s, ?_⟩
        push_cast
        ring
      mul_mem' := by
        intro y y' hy hy'
        obtain ⟨u, r, s, rfl⟩ := hy
        obtain ⟨u', r', s', rfl⟩ := hy'
        refine ⟨u * u' + d * (r * s' + s * r'),
          u * r' + r * u' + d * s * s',
          u * s' + s * u' + r * r', ?_⟩
        push_cast
        linear_combination ((r : K) * s' + s * r' + (s : K) * s' * x) * hx
    }
    have hle : adjoin ℤ ({x} : Set K) ≤ subalgebraOfSubring T := by
      apply adjoin_le
      intro y hy
      simp only [Set.mem_singleton_iff] at hy
      subst y
      change x ∈ T
      exact ⟨0, 1, 0, by simp⟩
    exact hle hy
  have hAlphaInS {y : K} (hy : y ∈ adjoin ℤ ({alpha} : Set K)) : y ∈ S := by
    obtain ⟨u, r, s, hy⟩ := hspan alpha (m * n ^ 2) hroot hy
    rw [hy]
    exact hS_add (hS_add (hS_int u) (hS_smul r hS_alpha))
      (hS_smul s hS_alphaSq)
  have hBetaInS {y : K} (hy : y ∈ adjoin ℤ ({beta} : Set K)) : y ∈ S := by
    obtain ⟨u, r, s, hy⟩ := hspan beta (m ^ 2 * n) hbetaCube hy
    rw [hy]
    exact hS_add (hS_add (hS_int u) (hS_smul r hS_beta))
      (hS_smul s hS_betaSq)
  have hminZ (pbx : PowerBasis ℚ K) (hdim : pbx.dim = 3)
      (d : ℤ) (hx : pbx.gen ^ 3 = (d : K))
      (hxint : IsIntegral ℤ pbx.gen) :
      minpoly ℤ pbx.gen = (Polynomial.X : Polynomial ℤ) ^ 3 - Polynomial.C d := by
    have hminQ : minpoly ℚ pbx.gen =
        (Polynomial.X : Polynomial ℚ) ^ 3 - Polynomial.C (d : ℚ) := by
      have heval : Polynomial.aeval pbx.gen
          ((Polynomial.X : Polynomial ℚ) ^ 3 - Polynomial.C (d : ℚ)) = 0 := by
        simpa using sub_eq_zero.mpr hx
      have hdegree :
          (((Polynomial.X : Polynomial ℚ) ^ 3 - Polynomial.C (d : ℚ))).degree ≤
            (minpoly ℚ pbx.gen).degree := by
        rw [Polynomial.degree_X_pow_sub_C (by norm_num : 0 < 3),
          Polynomial.degree_eq_natDegree (minpoly.ne_zero pbx.isIntegral_gen),
          pbx.natDegree_minpoly, hdim]
      exact (minpoly.unique_of_degree_le_degree_minpoly ℚ pbx.gen
        (Polynomial.monic_X_pow_sub_C _ (by norm_num : 3 ≠ 0))
        heval hdegree).symm
    apply Polynomial.map_injective (algebraMap ℤ ℚ) (algebraMap ℤ ℚ).injective_int
    rw [← minpoly.isIntegrallyClosed_eq_field_fractions' ℚ hxint, hminQ]
    simp
  have hEisenstein (pbx : PowerBasis ℚ K) (hdim : pbx.dim = 3)
      (d : ℤ) (hx : pbx.gen ^ 3 = (d : K))
      (hxint : IsIntegral ℤ pbx.gen)
      (hpd : (p : ℤ) ∣ d) (hpsq : ¬(p : ℤ) ^ 2 ∣ d) :
      (minpoly ℤ pbx.gen).IsEisensteinAt (Submodule.span ℤ {(p : ℤ)}) := by
    have hpI : Prime (p : ℤ) := Nat.prime_iff_prime_int.mp hp
    rw [hminZ pbx hdim d hx hxint]
    apply (Polynomial.monic_X_pow_sub_C d (by norm_num : 3 ≠ 0)).isEisensteinAt_of_mem_of_notMem
    · exact Ideal.IsPrime.ne_top
        ((Ideal.span_singleton_prime (by exact_mod_cast hp.ne_zero)).2 hpI)
    · intro i hi
      rw [Ideal.submodule_span_eq, Ideal.mem_span_singleton]
      have hi3 : i < 3 := by
        simpa only [Polynomial.natDegree_X_pow_sub_C] using hi
      interval_cases i <;>
        simp [Polynomial.coeff_sub, Polynomial.coeff_X_pow, hpd]
      all_goals simp only [← Polynomial.C_eq_intCast d, Polynomial.coeff_C]
      all_goals simp
    · rw [Ideal.submodule_span_eq, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
      simpa [Polynomial.coeff_sub, Polynomial.coeff_X_pow, Polynomial.coeff_C] using
        (show ¬(p : ℤ) ^ 2 ∣ -d by simpa using hpsq)
  have hAlphaInt : IsIntegral ℤ alpha := by
    apply IsIntegral.of_pow (n := 3) (by norm_num)
    simpa [alpha, hroot] using
      (isIntegral_algebraMap : IsIntegral ℤ ((m * n ^ 2 : ℤ) : K))
  have hBetaInt : IsIntegral ℤ beta := by
    apply IsIntegral.of_pow (n := 3) (by norm_num)
    simpa [hbetaCube] using
      (isIntegral_algebraMap : IsIntegral ℤ ((m ^ 2 * n : ℤ) : K))
  have hPoly (x : K) (u r s : ℤ) :
      (u : K) + (r : K) * x + (s : K) * x ^ 2 ∈
        adjoin ℤ ({x} : Set K) := by
    have hx : x ∈ adjoin ℤ ({x} : Set K) :=
      subset_adjoin (Set.mem_singleton _)
    exact Subalgebra.add_mem _
      (Subalgebra.add_mem _ (Subalgebra.algebraMap_mem _ u)
        (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ r) hx))
      (Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ s)
        (Subalgebra.pow_mem _ hx 2))
  obtain ⟨u, r, s, hpz⟩ := hpz
  have hpzS : (p : K) * z ∈ S := ⟨u, r, s, hpz⟩
  have hfinish (t : ℤ) (hcop : IsCoprime (p : ℤ) t)
      (htz : (t : K) * z ∈ S) : z ∈ S := by
    obtain ⟨e, f, hef⟩ := hcop
    have hsum := hS_add (hS_smul e hpzS) (hS_smul f htz)
    have heq : z = (e : K) * ((p : K) * z) +
        (f : K) * ((t : K) * z) := by
      have heqK : (e : K) * (p : K) + (f : K) * (t : K) = 1 := by
        exact_mod_cast hef
      calc
        z = ((e : K) * (p : K) + (f : K) * (t : K)) * z := by rw [heqK, one_mul]
        _ = _ := by ring
    rw [heq]
    exact hsum
  rcases hlocal with ⟨hpd, hpsq, hcop⟩ | ⟨hpd, hpsq, hcop⟩
  · have hEis := hEisenstein pb h3 (m * n ^ 2) hroot hAlphaInt hpd hpsq
    have hcleared : (p : ℤ) • ((3 * n : K) * z) ∈
        adjoin ℤ ({alpha} : Set K) := by
      have hform : (p : ℤ) • ((3 * n : K) * z) =
          ((3 * n * u + n * s : ℤ) : K) +
          ((3 * n * r + c * n * s : ℤ) : K) * alpha +
          ((v * s : ℤ) : K) * alpha ^ 2 := by
        calc
          (p : ℤ) • ((3 * n : K) * z) =
              (p : K) * ((3 * n : K) * z) := by simp [Algebra.smul_def]
          _ =
              (3 * n : K) * ((p : K) * z) := by ring
          _ = _ := by
            rw [hpz]
            change (3 * n : K) *
              ((u : K) + (r : K) * alpha + (s : K) * gamma) = _
            calc
              (3 * n : K) *
                  ((u : K) + (r : K) * alpha + (s : K) * gamma) =
                  (3 * n : K) * (u : K) +
                    (3 * n : K) * (r : K) * alpha +
                    (s : K) * ((3 * n : K) * gamma) := by ring
              _ = _ := by rw [hgammaA]; push_cast; ring
      rw [hform]
      exact hPoly alpha _ _ _
    have hclearedInt : IsIntegral ℤ ((3 * n : K) * z) := by
      have ht : IsIntegral ℤ (3 * n : K) := by
        simpa using (isIntegral_algebraMap :
          IsIntegral ℤ (((3 * n : ℤ) : K)))
      exact ht.mul hzint
    have hzAdjoin := mem_adjoin_of_smul_prime_smul_of_minpoly_isEisensteinAt
      (Nat.prime_iff_prime_int.mp hp) hAlphaInt hclearedInt hcleared hEis
    have htz : ((3 * n : ℤ) : K) * z ∈ S := by
      convert hAlphaInS hzAdjoin using 1 <;> push_cast <;> ring
    exact (show ∃ u r s : ℤ, z =
      (u : K) + (r : K) * alpha + (s : K) * gamma from
        hfinish (3 * n) hcop htz)
  · have hbetaTop : adjoin ℚ ({beta} : Set K) = ⊤ := by
      apply PowerBasis.adjoin_eq_top_of_gen_mem_adjoin (B := pb)
      have hb : beta ∈ adjoin ℚ ({beta} : Set K) :=
        subset_adjoin (Set.mem_singleton _)
      have hbsq := Subalgebra.pow_mem (adjoin ℚ ({beta} : Set K)) hb 2
      have hbm := Subalgebra.smul_mem (adjoin ℚ ({beta} : Set K))
        hbsq (m : ℚ)⁻¹
      have heq : alpha = ((m : ℚ)⁻¹ : K) * beta ^ 2 := by
        rw [hbetaSq]
        push_cast
        field_simp [hmK]
      change alpha ∈ adjoin ℚ ({beta} : Set K)
      rw [heq]
      simpa [Algebra.smul_def] using hbm
    have hBetaRat : IsIntegral ℚ beta := by
      apply IsIntegral.of_pow (n := 3) (by norm_num)
      rw [hbetaCube]
      exact isIntegral_intCast (m ^ 2 * n)
    let pbBeta : PowerBasis ℚ K :=
      PowerBasis.ofAdjoinEqTop hBetaRat hbetaTop
    have hpbBetaGen : pbBeta.gen = beta := by
      simp [pbBeta]
    have hpbBetaDim : pbBeta.dim = 3 := by
      have hfin := pbBeta.finrank
      rw [pb.finrank, h3] at hfin
      exact hfin.symm
    have hEis : (minpoly ℤ pbBeta.gen).IsEisensteinAt
        (Submodule.span ℤ {(p : ℤ)}) := by
      exact hEisenstein pbBeta hpbBetaDim (m ^ 2 * n)
        (by simpa [hpbBetaGen] using hbetaCube)
        (by simpa [hpbBetaGen] using hBetaInt) hpd hpsq
    have hcleared : (p : ℤ) • ((3 * m : K) * z) ∈
        adjoin ℤ ({pbBeta.gen} : Set K) := by
      have hform : (p : ℤ) • ((3 * m : K) * z) =
          ((3 * m * u + m * s : ℤ) : K) +
          ((3 * r + c * s : ℤ) : K) * beta ^ 2 +
          ((v * m * s : ℤ) : K) * beta := by
        calc
          (p : ℤ) • ((3 * m : K) * z) =
              (p : K) * ((3 * m : K) * z) := by simp [Algebra.smul_def]
          _ =
              (3 * m : K) * ((p : K) * z) := by ring
          _ = _ := by
            rw [hpz]
            change (3 * m : K) *
              ((u : K) + (r : K) * alpha + (s : K) * gamma) = _
            calc
              (3 * m : K) *
                  ((u : K) + (r : K) * alpha + (s : K) * gamma) =
                  (3 * m : K) * (u : K) +
                    (3 * m : K) * (r : K) * alpha +
                    (s : K) * ((3 * m : K) * gamma) := by ring
              _ = _ := by
                rw [hgammaB]
                have hterm :
                    (3 * m : K) * (r : K) * alpha =
                      (3 * r : K) * beta ^ 2 := by
                  rw [hbetaSq]
                  push_cast
                  ring
                rw [hterm]
                push_cast
                ring
      rw [hform, hpbBetaGen]
      convert hPoly beta (3 * m * u + m * s) (v * m * s)
        (3 * r + c * s) using 1 <;> ring
    have hclearedInt : IsIntegral ℤ ((3 * m : K) * z) := by
      have ht : IsIntegral ℤ (3 * m : K) := by
        simpa using (isIntegral_algebraMap :
          IsIntegral ℤ (((3 * m : ℤ) : K)))
      exact ht.mul hzint
    have hzAdjoin := mem_adjoin_of_smul_prime_smul_of_minpoly_isEisensteinAt
      (Nat.prime_iff_prime_int.mp hp)
      (show IsIntegral ℤ pbBeta.gen by simpa [hpbBetaGen] using hBetaInt)
      hclearedInt hcleared hEis
    have hzBeta : (3 * m : K) * z ∈ adjoin ℤ ({beta} : Set K) := by
      simpa [hpbBetaGen] using hzAdjoin
    have htz : ((3 * m : ℤ) : K) * z ∈ S := by
      convert hBetaInS hzBeta using 1 <;> push_cast <;> ring
    exact (show ∃ u r s : ℤ, z =
      (u : K) + (r : K) * alpha + (s : K) * gamma from
        hfinish (3 * m) hcop htz)

#print axioms pure_cubic_mixed_prime_saturation

end D5.S3.Arith.Lattices.PureCubicMixedPrimeSaturation
