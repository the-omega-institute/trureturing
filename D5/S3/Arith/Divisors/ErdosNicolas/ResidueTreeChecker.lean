   generality: I
   mirror-B: none(waiver:proof-helper-in-main-import-closure)
   mirror-E: none(waiver:pure-mathematics-no-experimental-evidence-claim)
   anchors: []
   utility: kind=checker; basis=consumer=D5/S3/Arith/Divisors/ErdosNicolas/Main.erdos_nicolas; instance=D5/S3/Arith/Divisors/ErdosNicolas/Data/ResidueP23.chunk_checked
   digest: Sound prefix kernel direct leaf certificates cover the original residue box. -/

import D5.S3.Arith.Divisors.ErdosNicolas.ResidueDomain
import D5.S3.Arith.Divisors.ErdosNicolas.ResidueProfile
import D5.S3.Arith.Divisors.ErdosNicolas.FactorDivisors

/-! All branching, residue rows and direct divisor pairs are generated by the checker. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Arith.ErdosNicolas

open Finset

/-- Factor data for a prefix, in exactly the original prime-coordinate order. -/
def residuePrefixFactors (p : ℕ) (pre : List ℕ) : List (ℕ × ℕ) :=
  ((residuePrimeCoords p).map Fin.val).zip pre

private theorem take_zip_append (qs pre suffix : List ℕ) :
    (qs.zip (pre ++ suffix)).take pre.length = qs.zip pre := by
  induction pre generalizing qs with
  | nil => simp
  | cons e pre ih => cases qs <;> simp [ih]

/-- Prefixes of exponent lists select the corresponding actual factor-data prefix. -/
private theorem residuePrefixFactors_eq_take {p : ℕ} {v : Fin p → ℕ} {pre : List ℕ}
    (hpre : pre.IsPrefix (residueExponents p v)) :
    residuePrefixFactors p pre = (residueFactorData p v).take pre.length := by
  obtain ⟨suffix, hs⟩ := hpre
  have hzip : residueFactorData p v =
      ((residuePrimeCoords p).map Fin.val).zip (residueExponents p v) := by
    simp only [residueFactorData, residueExponents, List.zip_map']
  rw [hzip, ← hs, take_zip_append]
  rfl

private theorem sum_factor_divisors (fs : List (ℕ × ℕ)) (hf : checkFactors fs = true)
    (g : ℕ → ℕ) : (List.map g (factorDivisors fs)).sum =
      ∑ d ∈ (factorValue fs).divisors, g d := by
  have hd := factorDivisors_nodup hf
  have he := factorDivisors_toFinset hf
  rw [← he]
  clear he
  generalize factorDivisors fs = ds at *
  revert hd
  induction ds with
  | nil => intro _; simp
  | cons d ds ih =>
    intro hd
    have hh := List.nodup_cons.mp hd
    simp [List.toFinset_cons, hh.1, ih hh.2]

/-- Prime factor decompositions discharge the compatible-suffix hypotheses of the prefix theorem. -/
private theorem residue_factor_prefix_closes {p ell Q M : ℕ} {B : ℕ → ℕ}
    (hp : p.Prime) (fs gs : List (ℕ × ℕ)) (hf : checkFactors (fs ++ gs) = true)
    (hpm : ¬p ∣ factorValue (fs ++ gs))
    (hvector : residueVectorCheck p B (factorDivisors fs) M = true)
    (hkernel : residueKernelCheck p ell Q (factorDivisors fs).length M = true)
    (hB : ∀ d ∈ (factorValue (fs ++ gs)).divisors,
      (p * Q : ℕ) * f p (ell * p) (d % p) ≤ (B (d % p) : ℚ))
    (hA : hHat (factorValue (fs ++ gs)) ≤ ((factorValue (fs ++ gs)).divisors.card : ℚ)) :
    hHat (p * factorValue (fs ++ gs)) < ((p * factorValue (fs ++ gs)).divisors.card : ℚ) := by
  obtain ⟨hd, he, _⟩ := factorDivisors_products_sound hf
  exact residue_prefix_closes hp hpm _ _ hd he hvector hkernel hB hA

/-- Three methods used by actual residue-tree terminal certificates. -/
inductive ResidueLeafKind where
  | prefix
  | kernel
  | direct
  deriving DecidableEq

/-- A prefix and its terminal method; the integer bound is used by kernel leaves. -/
structure ResidueTerminal where
  exponents : List ℕ
  kind : ResidueLeafKind
  bound : ℕ

/-- Each terminal validates its own complete arithmetic, rather than an asserted leaf result. -/
def checkResidueTerminal (p ell Q : ℕ) (B : ℕ → ℕ) (c : ResidueTerminal) : Bool :=
  let fs := residuePrefixFactors p c.exponents
  let ds := factorDivisors fs
  match c.kind with
  | .prefix => residueVectorCheck p B ds c.bound &&
      residueKernelCheck p ell Q ds.length c.bound
  | .kernel => decide (c.exponents.length = (residuePrimeCoords p).length) &&
      decide (residueSum p B ds 1 ≤ c.bound) &&
      residueKernelCheck p ell Q ds.length c.bound
  | .direct =>
      let full := factorDivisors ((p, 1) :: fs)
      decide (c.exponents.length = (residuePrimeCoords p).length) &&
        decide (pairUpper Q full < Q * full.length)

/-- The complete initial vector is checked before it can be used by any terminal. -/
def checkResidueInitial (p ell Q : ℕ) (B : ℕ → ℕ) : Bool :=
  (List.range p).all fun r => decide (r = 0 ∨ roundedResidueNumerator p ell Q r ≤ B r)

/-- Complete finite coverage plus complete arithmetic at each of its terminal prefixes. -/
def checkResidueTree (p ell Q : ℕ) (B : ℕ → ℕ) (cs : List ResidueTerminal) : Bool :=
  decide (p.Prime ∧ (ell = 1 ∨ ell = 2 ∨ ell = 3) ∧ 0 < Q) &&
    checkResidueInitial p ell Q B &&
    checkPrefixCover (cs.map ResidueTerminal.exponents) [] (residueCaps p) &&
    cs.all (checkResidueTerminal p ell Q B)

/-- Initial-vector rounding is verified at every residue, with zero excluded only mathematically. -/
private theorem checkResidueInitial_sound {p ell Q : ℕ} {B : ℕ → ℕ}
    (hell : ell = 1 ∨ ell = 2 ∨ ell = 3)
    (h : checkResidueInitial p ell Q B = true) {r : ℕ} (hr : 0 < r) (hrp : r < p) :
    (p * Q : ℕ) * f p (ell * p) r ≤ (B r : ℚ) := by
  have hh := List.all_eq_true.mp h r (List.mem_range.mpr hrp)
  have hb : roundedResidueNumerator p ell Q r ≤ B r := by
    rcases of_decide_eq_true hh with hz | hb
    · omega
    · exact hb
  exact (roundedResidueNumerator_sound hell hr hrp).trans (by exact_mod_cast hb)

/-- A terminal prefix controls every original box vector that reaches it. -/
private theorem checkResidueTerminal_sound {p ell Q : ℕ} {B : ℕ → ℕ} {c : ResidueTerminal}
    (hp : p.Prime) (hQ : 0 < Q)
    (hB : ∀ r, 0 < r → r < p → (p * Q : ℕ) * f p (ell * p) r ≤ (B r : ℚ))
    (hc : checkResidueTerminal p ell Q B c = true)
    {v : Fin p → ℕ} (hv : v ∈ residueBox p)
    (hpre : c.exponents.IsPrefix (residueExponents p v))
    (hA : hHat (factorValue (residueFactorData p v)) ≤
      ((factorValue (residueFactorData p v)).divisors.card : ℚ)) :
    hHat (p * factorValue (residueFactorData p v)) <
      ((p * factorValue (residueFactorData p v)).divisors.card : ℚ) := by
  let fs := residueFactorData p v
  let pre := fs.take c.exponents.length
  let suffix := fs.drop c.exponents.length
  have hfs : checkFactors fs = true := residueFactorData_checked p v
  have hm := (checkFactors_sound hfs).1
  have hfree : ¬p ∣ factorValue fs := residueFactorData_primeFree hp v
  have hsplit : pre ++ suffix = fs := List.take_append_drop _ _
  have hpref : residuePrefixFactors p c.exponents = pre := residuePrefixFactors_eq_take hpre
  have hdivB : ∀ d ∈ (factorValue fs).divisors,
      (p * Q : ℕ) * f p (ell * p) (d % p) ≤ (B (d % p) : ℚ) := by
    intro d hd
    have hnd : ¬p ∣ d := fun hh => hfree (hh.trans (Nat.mem_divisors.mp hd).1)
    have hr : 0 < d % p := Nat.pos_of_ne_zero fun hz => hnd (Nat.dvd_of_mod_eq_zero hz)
    exact hB _ hr (Nat.mod_lt _ hp.pos)
  have hfull (hlen : c.exponents.length = (residuePrimeCoords p).length) : pre = fs := by
    apply List.take_of_length_le
    simp only [fs, residueFactorData, List.length_map]
    omega
  cases hk : c.kind with
  | «prefix» =>
    simp only [checkResidueTerminal, hk, hpref, Bool.and_eq_true] at hc
    have hh := residue_factor_prefix_closes hp pre suffix
      (by simpa only [hsplit] using hfs) (by simpa only [hsplit] using hfree)
      hc.1 hc.2 (by simpa only [hsplit] using hdivB) (by simpa only [hsplit] using hA)
    simpa only [hsplit] using hh
  | kernel =>
    simp only [checkResidueTerminal, hk, hpref, Bool.and_eq_true, decide_eq_true_eq] at hc
    have hpf := hfull hc.1.1
    rw [hpf] at hc
    have hsum : ∑ d ∈ (factorValue fs).divisors, B (d % p) ≤ c.bound := by
      have hh := hc.1.2
      simp only [residueSum, one_mul] at hh
      rwa [sum_factor_divisors fs hfs (fun d => B (d % p))] at hh
    have hker : residueKernelCheck p ell Q ((factorValue fs).divisors.card) c.bound = true := by
      simpa only [factorDivisors_length, (checkFactors_sound hfs).2] using hc.2
    exact residue_integer_closes hp hfree hker hdivB hsum hA
  | direct =>
    simp only [checkResidueTerminal, hk, hpref, Bool.and_eq_true, decide_eq_true_eq] at hc
    have hpf := hfull hc.1
    rw [hpf] at hc
    have hff : checkFactors ((p, 1) :: fs) = true := by
      simp only [checkFactors, Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨⟨hp, hfree⟩, hfs⟩
    have hcount : (factorValue ((p, 1) :: fs)).divisors.card =
        (factorDivisors ((p, 1) :: fs)).length := by
      rw [(checkFactors_sound hff).2, factorDivisors_length]
    have hh := hHat_lt_of_pairUpper hQ (factorDivisors_nodup hff)
      (factorDivisors_toFinset hff) hcount hc.2
    simpa only [factorValue, pow_one] using hh

/-- Soundness is stated on precisely the original complete residue-box domain. -/
theorem checkResidueTree_sound {p ell Q : ℕ} {B : ℕ → ℕ} {cs : List ResidueTerminal}
    (h : checkResidueTree p ell Q B cs = true) :
    ∀ v ∈ residueBox p,
      hHat (residueBoxValue p v / p) ≤ ((residueBoxValue p v / p).divisors.card : ℚ) →
      hHat (residueBoxValue p v) < ((residueBoxValue p v).divisors.card : ℚ) := by
  simp only [checkResidueTree, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨hp, hell, hQ⟩, hinit⟩, hcover⟩, hterminals⟩ := h
  apply residueBox_step_of_factorData hp
  intro v hv hA
  obtain ⟨pre, hpre, hprefix⟩ := checkPrefixCover_sound hcover
    (residueExponents p v) (residueExponents_bounded hv)
  obtain ⟨c, hc, rfl⟩ := List.mem_map.mp hpre
  apply checkResidueTerminal_sound hp hQ
    (fun r hr hrp => checkResidueInitial_sound hell hinit hr hrp)
    (List.all_eq_true.mp hterminals c hc) hv ?_ hA
  simpa only [List.nil_append] using hprefix

#print axioms residuePrefixFactors_eq_take
#print axioms residue_factor_prefix_closes
#print axioms checkResidueInitial_sound
#print axioms checkResidueTerminal_sound
#print axioms checkResidueTree_sound

end D5.S3.Arith.ErdosNicolas
