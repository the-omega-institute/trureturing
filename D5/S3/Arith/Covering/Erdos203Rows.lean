/-- All 252 original rows, with the seven base rows first. -/
def rows (i : Fin 252) : Row :=
  Fin.addCases (m := 7) (n := 245) (motive := fun _ => Row) baseRows tailRows i

/-- Integer representatives of all original phases, without any reduced-residue restriction. -/
abbrev Phases := Fin 252 → ℤ

/-- An event in its original modulus, also defined for zero and nonprimitive coefficients. -/
def Row.hits (r : Row) (c x y : ℤ) : Prop :=
  Int.ModEq (r.e : ℤ) (r.a*x+r.b*y) c

/-- All phases are transformed by the same integer translation. -/
def shiftPhases (c : Phases) (t : ℤ × ℤ) : Phases :=
  fun i => c i - ((rows i).a*t.1+(rows i).b*t.2)

/-- The first six canonical domains have product 96; the seventh is a singleton. -/
def phaseDomain : Fin 7 → ℕ := ![1,1,2,2,4,6,1]

/-- Canonical representatives of the seven base phases. -/
def Canonical (c : Phases) : Prop :=
  ∀ i : Fin 7, c (i.castLE (by decide : 7 ≤ 252)) %
    (rows (i.castLE (by decide : 7 ≤ 252))).e < (phaseDomain i : ℤ)

