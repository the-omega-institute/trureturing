      simp only [H,Nat.card_eq_fintype_card,Set.toFinset_card]
    have icard (j : Fin 245) : (I j).card =
        Nat.card {z : Torus // z ∈ sevenRegion U ∧ originalMap (tailIndex j) z=
          (c (tailIndex j) : ZMod (rows (tailIndex j)).e)} := by
      rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
      congr 1
      ext z
      simp only [I,F,Finset.mem_filter,Set.mem_toFinset,Finset.mem_univ,true_and]
    have each (j : Fin 245) : 95040*period*(I j).card ≤
        period^2*(weight j*histogramMaximum U (tailIndex j)) := by
      have hd : ∀ i : Fin 252, (rows i).e ∣ period := by decide +kernel
      have cap := (seventh_capacity U).2 j (c (tailIndex j))
      have ic := icard j
      dsimp only [tailIndex] at ic cap
      have cap2 : 11*(rows (tailIndex j)).e*8640*(I j).card ≤
          seventhFactor (tailIndex j)*period^2*restrictedGcd (tailIndex j)*
            histogramMaximum U (tailIndex j) := by
        calc
          _ = 11*(rows (tailIndex j)).e*8640*
              Nat.card {z : Torus // z ∈ sevenRegion U ∧ originalMap (tailIndex j) z=
                (c (tailIndex j) : ZMod (rows (tailIndex j)).e)} := by rw [icard j]
          _ ≤ _ := cap
      clear cap
      let e := (rows (tailIndex j)).e
      have he : period/e*e=period := Nat.div_mul_cancel (hd (tailIndex j))
      calc
        _ = (period/e)*(11*e*8640*(I j).card) := by
          rw [show (period/e)*(11*e*8640*(I j).card) =
            95040*((period/e)*e)*(I j).card by ring, he]
        _ ≤ (period/e)*(seventhFactor (tailIndex j)*period^2*restrictedGcd (tailIndex j)*
            histogramMaximum U (tailIndex j)) := Nat.mul_le_mul_left _ cap2
        _ = _ := by unfold weight seventhFactor; dsimp [e]; ring
    have sums : 95040*period*(∑ j : Fin 245, (I j).card) ≤
        period^2*(∑ j : Fin 245, weight j*histogramMaximum U (tailIndex j)) := by
      simp only [Finset.mul_sum]
      exact Finset.sum_le_sum (fun j hj => each j)
    have base := (seventh_capacity U).1
    rw [← fcard] at base
    have gap := certificate_bound k cert
    change 41512904387*(95040*period)+2792167686000*
      (∑ j : Fin 245,weight j*histogramMaximum U (tailIndex j)) ≤
        2792167686000*(10*U.card*period) at gap
    rw [← hcard]
    norm_num only [period,Nat.reduceMul,Nat.reducePow] at base gap sums ⊢
    omega
  have canonical_index (c : Phases) (hc : Canonical c) : ∃ k : Fin 96, ∀ j : Fin 7,
      (canonicalPhases k (j.castLE (by decide : 7 ≤ 252)) : ZMod (rows (j.castLE (by decide : 7 ≤ 252))).e) =
      (c (j.castLE (by decide : 7 ≤ 252)) : ZMod (rows (j.castLE (by decide : 7 ≤ 252))).e) := by
    have h0 := hc 0
    have h1 := hc 1
    have h2 := hc 2
    have h3 := hc 3
    have h4 := hc 4
    have h5 := hc 5
    have h6 := hc 6
    change c 0%4<1 at h0
    change c 1%6<1 at h1
    change c 2%10<2 at h2
    change c 3%12<2 at h3
    change c 4%16<4 at h4
    change c 5%18<6 at h5
    change c 6%11<1 at h6
    let v : ℤ := 48*(c 2%10)+24*(c 3%12)+6*(c 4%16)+(c 5%18)
    have hv : 0≤v ∧ v<96 := by dsimp [v]; omega
    let k : Fin 96 := ⟨v.toNat,by omega⟩
    have hk : (k.val : ℤ)=v := Int.toNat_of_nonneg hv.1
    refine ⟨k,?_⟩
    intro j
    apply (ZMod.intCast_eq_intCast_iff' _ _ _).mpr
    fin_cases j
    · change 0%4=c 0%4
      omega
    · change 0%6=c 1%6
      omega
    · change ((k.val:ℤ)/48)%10=c 2%10
      dsimp [v] at hk
      omega
    · change ((k.val:ℤ)/24%2)%12=c 3%12
      dsimp [v] at hk
      omega
    · change ((k.val:ℤ)/6%4)%16=c 4%16
      dsimp [v] at hk
      omega
    · change ((k.val:ℤ)%6)%18=c 5%18
      dsimp [v] at hk
      omega
    · change 0%11=c 6%11
      omega
  have certified (k : Fin 96) : Nonempty (CapacityCertificate k) := by
    fin_cases k
    · exact ⟨certificate0⟩
