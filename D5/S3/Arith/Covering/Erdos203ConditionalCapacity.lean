/-- Every unchanged original phase vector misses this exact positive fraction of the
full period. One common translation induces a bijection of the two hole sets. -/
theorem uniform_hole_bound :
    ∀ c : Phases, 41512904387*period^2 ≤ 2792167686000*Nat.card (Holes c) := by
  classical
  have transport (c : Phases) (t : ℤ × ℤ)
      (ht : ∀ (i : Fin 252) (x y : ℤ),
        (rows i).hits (shiftPhases c t i) x y ↔ (rows i).hits (c i) (x+t.1) (y+t.2)) :
      Nat.card (Holes (shiftPhases c t)) = Nat.card (Holes c) := by
    classical
    have ev (i : Fin 252) (z : Torus) :
        originalMap i z=(shiftPhases c t i : ZMod (rows i).e) ↔
          originalMap i (z+periodMap t)=(c i : ZMod (rows i).e) := by
      rcases z with ⟨x,y⟩
      obtain ⟨x,rfl⟩ := ZMod.intCast_surjective x
      obtain ⟨y,rfl⟩ := ZMod.intCast_surjective y
      have h := ((original_six_fibers.2.2.2 i).1 (shiftPhases c t i) x y).trans
        ((ht i x y).trans ((original_six_fibers.2.2.2 i).1 (c i) (x+t.1) (y+t.2)).symm)
      simpa only [periodMap,AddMonoidHom.coe_mk,ZeroHom.coe_mk,Prod.mk_add_mk,Int.cast_add] using h
    apply Nat.card_congr
    exact (Equiv.addRight (periodMap t)).subtypeEquiv (fun z =>
      forall_congr' (fun i => not_congr (ev i z)))
  intro c
  obtain ⟨t,hc,he⟩ := normalize_original_phases c
  have hb := canonical_hole_bound (shiftPhases c t) hc
  rw [transport c t he] at hb
  exact hb

/-- No globally fixed phase vector covers all integer exponent points. The proof
constructs an uncovered canonical point, lifts it, and transports it to the proposed
original phases. It does not project a negation from a conjunction or specialize the
all-phase bound. The 285-row construction and whole Erdos 203 problem are out of scope. -/
theorem result : ¬ globalCover := by
  classical
  rintro ⟨c,hcover⟩
  obtain ⟨t,hc,he⟩ := normalize_original_phases c
  have hb := canonical_hole_bound (shiftPhases c t) hc
  have positive : 0 < Nat.card (Holes (shiftPhases c t)) := by
    norm_num only [period,Nat.reducePow,Nat.reduceMul] at hb
    omega
  obtain ⟨⟨⟨x,y⟩,hz⟩⟩ := (Nat.card_pos_iff.mp positive).1
  obtain ⟨x,rfl⟩ := ZMod.intCast_surjective x
  obtain ⟨y,rfl⟩ := ZMod.intCast_surjective y
  obtain ⟨i,hi⟩ := hcover (x+t.1) (y+t.2)
  exact hz i (((original_six_fibers.2.2.2 i).1 (shiftPhases c t i) x y).mpr
    ((he i x y).mpr hi))
end D5.S3.Arith.Covering.Erdos203
