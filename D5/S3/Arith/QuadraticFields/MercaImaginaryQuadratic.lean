import D5.S3.Arith.QuadraticFields.QuadraticOrderMaximal
import Mathlib.Algebra.Ring.Int.Parity
import Mathlib.NumberTheory.FundamentalDiscriminant
import Mathlib.NumberTheory.NumberField.InfinitePlace.TotallyRealComplex
import Mathlib.NumberTheory.NumberField.DedekindZeta

/-!
The imaginary field in the Ma--Zhang note is the square-root field itself.
The order discriminant is not squarefree, so maximality is proved from
integral trace, integral norm and the parity obstruction modulo four.
No class number is defined by a character sum or a reduced-form count.
-/

set_option autoImplicit false
noncomputable section

namespace D5.S3.Arith.QuadraticFields.MercaImaginaryQuadratic

open QuadraticAlgebra NumberField NumberField.InfinitePlace
open scoped NumberField
open QuadraticOrderMaximal

/-- The algebra generated by a square root of minus the prime. -/
abbrev Field (r : ℕ) := QuadraticAlgebra ℚ ((-(r : ℤ) : ℤ) : ℚ) ((0 : ℤ) : ℚ)

variable (r : ℕ) [Fact r.Prime]

instance nonsquare_discr :
    Fact (¬ IsSquare (QuadraticAlgebra.discr ((-(r : ℤ) : ℤ) : ℚ) ((0 : ℤ) : ℚ))) := by
  constructor
  intro h
  have hp : (0 : ℚ) < r := by exact_mod_cast (Fact.out : r.Prime).pos
  have := h.nonneg
  simp only [QuadraticAlgebra.discr_def, Int.cast_zero, Int.cast_neg, Int.cast_natCast,
    zero_pow (by decide : 2 ≠ 0), zero_add] at this
  linarith

instance field_numberField : NumberField (Field r) := NumberField.of_module_finite ℚ _

private lemma squarefree_minus : Squarefree (-(r : ℤ)) :=
  (Int.prime_iff_natAbs_prime.mpr (by simpa using (Fact.out : r.Prime))).squarefree

private lemma integral_coordinates (hr : r % 8 = 5)
    (z : Field r) (hz : IsIntegral ℤ z) :
    ∃ x y : ℤ, z.re = x ∧ z.im = y := by
  have hs : IsIntegral ℤ (star z) := map_isIntegral_int (starRingEnd _) hz
  have ht : IsIntegral ℤ (QuadraticAlgebra.trace z) := by
    apply (isIntegral_algebraMap_iff (A := ℚ) (B := Field r)).mp
    rw [QuadraticAlgebra.algebraMap_trace_eq_add_star]
    exact hz.add hs
  have hn : IsIntegral ℤ (QuadraticAlgebra.norm z) := by
    apply (isIntegral_algebraMap_iff (A := ℚ) (B := Field r)).mp
    rw [QuadraticAlgebra.algebraMap_norm_eq_mul_star]
    exact hz.mul hs
  have him : IsIntegral ℤ ((-(r : ℤ) : ℚ) * (2 * z.im) ^ 2) := by
    have h : IsIntegral ℤ (QuadraticAlgebra.trace z ^ 2 - 4 * QuadraticAlgebra.norm z) :=
      (ht.pow 2).sub (isIntegral_algebraMap.mul hn)
    have heq : (-(r : ℤ) : ℚ) * (2 * z.im) ^ 2 =
        QuadraticAlgebra.trace z ^ 2 - 4 * QuadraticAlgebra.norm z := by
      simp only [QuadraticAlgebra.trace_def, QuadraticAlgebra.norm_def, Int.cast_zero,
        zero_mul, add_zero]
      push_cast
      ring
    rwa [← heq] at h
  obtain ⟨y, hy⟩ := integer_of_squarefree_mul_sq_integral (squarefree_minus r)
    (2 * z.im) him
  obtain ⟨x, hx⟩ := IsIntegrallyClosed.isIntegral_iff.mp ht
  obtain ⟨n, hn'⟩ := IsIntegrallyClosed.isIntegral_iff.mp hn
  change (x : ℚ) = QuadraticAlgebra.trace z at hx
  change (n : ℚ) = QuadraticAlgebra.norm z at hn'
  have hx' : (x : ℚ) = 2 * z.re := by
    change (x : ℚ) = 2 * z.re + 0 * z.im at hx
    simpa using hx
  have heq : x ^ 2 - (-(r : ℤ)) * y ^ 2 = 4 * n := by
    apply Int.cast_injective (α := ℚ)
    push_cast
    rw [hx', hy, hn']
    simp only [QuadraticAlgebra.norm_def, Int.cast_zero, zero_mul, add_zero]
    push_cast
    ring
  have hr4 : (-(r : ℤ)) % 4 = 3 := by omega
  have hmod := congrArg (fun a : ℤ => a % 4) heq
  have hnmod : (4 * n) % 4 = 0 := by omega
  rw [Int.sub_emod, Int.mul_emod, hr4, Int.sq_emod_four, Int.sq_emod_four, hnmod] at hmod
  have hx2 : x % 2 = 0 := by omega
  have hy2 : y % 2 = 0 := by omega
  refine ⟨x / 2, y / 2, ?_, ?_⟩
  · have h : (x : ℚ) = 2 * ((x / 2 : ℤ) : ℚ) := by
      exact_mod_cast (show x = 2 * (x / 2) by omega)
    linarith
  · have h : (y : ℚ) = 2 * ((y / 2 : ℤ) : ℚ) := by
      exact_mod_cast (show y = 2 * (y / 2) by omega)
    linarith

private theorem maximalOrder (hr : r % 8 = 5) :
    IsIntegralClosure (QuadraticAlgebra ℤ (-(r : ℤ)) 0) ℤ (Field r) where
  algebraMap_injective := FaithfulSMul.algebraMap_injective _ _
  isIntegral_iff {z} := by
    constructor
    · intro hz
      obtain ⟨x, y, hx, hy⟩ := integral_coordinates r hr z hz
      refine ⟨⟨x, y⟩, ?_⟩
      apply QuadraticAlgebra.ext
      · simpa using hx.symm
      · simpa using hy.symm
    · rintro ⟨z, rfl⟩
      exact (IsIntegral.of_finite ℤ z).algebraMap

/-- The square-root order is the actual integral closure, not a nonmaximal proxy. -/
def maximalOrderEquiv (hr : r % 8 = 5) :
    QuadraticAlgebra ℤ (-(r : ℤ)) 0 ≃ₐ[ℤ] 𝓞 (Field r) := by
  letI := maximalOrder r hr
  exact IsIntegralClosure.equiv ℤ (QuadraticAlgebra ℤ (-(r : ℤ)) 0) (Field r) _

private lemma field_discr (hr : r % 8 = 5) :
    NumberField.discr (Field r) = -4 * (r : ℤ) := by
  let e := maximalOrderEquiv r hr
  let B := (QuadraticAlgebra.basis (-(r : ℤ)) 0).map e.toLinearEquiv
  rw [← NumberField.discr_eq_discr _ B]
  change Algebra.discr ℤ (e ∘ QuadraticAlgebra.basis (-(r : ℤ)) 0) = _
  rw [← Algebra.discr_eq_discr_of_algEquiv, basis_discr]
  simp [QuadraticAlgebra.discr_def]

private lemma units_eq (hr : r % 8 = 5) (z : QuadraticAlgebra ℤ (-(r : ℤ)) 0)
    (hz : IsUnit z) : z = 1 ∨ z = -1 := by
  have hnorm := QuadraticAlgebra.isUnit_iff_norm_isUnit.mp hz
  have henergy : QuadraticAlgebra.norm z = z.re ^ 2 + (r : ℤ) * z.im ^ 2 := by
    simp [QuadraticAlgebra.norm_def]
    ring
  have hp : 2 ≤ (r : ℤ) := by exact_mod_cast (Fact.out : r.Prime).two_le
  have hn : QuadraticAlgebra.norm z = 1 := by
    rcases Int.isUnit_iff.mp hnorm with h | h
    · exact h
    · nlinarith [sq_nonneg z.re, mul_nonneg (by omega : 0 ≤ (r : ℤ)) (sq_nonneg z.im)]
  have him : z.im = 0 := by
    by_contra h
    have h1 : 1 ≤ z.im ^ 2 := by have := sq_pos_of_ne_zero h; omega
    nlinarith [sq_nonneg z.re,
      mul_nonneg (by omega : 0 ≤ (r : ℤ) - 2) (by omega : 0 ≤ z.im ^ 2 - 1)]
  have hre : z.re ^ 2 = 1 := by simpa [him] using henergy.symm.trans hn
  rcases sq_eq_one_iff.mp hre with h | h
  · left; ext <;> simp [h, him]
  · right; ext <;> simp [h, him]

/-- Actual discriminant, its fundamental-discriminant status and maximal-order
unit boundary for the imaginary quadratic field required in the sign theorem. -/
theorem field_structure (hr : r % 8 = 5) :
    NumberField.discr (Field r) = -4 * (r : ℤ) ∧
    Int.IsFundamentalDiscr (-4 * (r : ℤ)) ∧
    (∀ z : Field r, IsIntegral ℤ z ↔ ∃ x y : ℤ, z.re = x ∧ z.im = y) ∧
    (∀ u : (𝓞 (Field r))ˣ, (u : 𝓞 (Field r)) = 1 ∨ (u : 𝓞 (Field r)) = -1) := by
  refine ⟨field_discr r hr, ?_, ?_, ?_⟩
  · rw [show -4 * (r : ℤ) = 4 * (-(r : ℤ)) by ring,
      Int.isFundamentalDiscr_four_mul]
    exact ⟨squarefree_minus r, Or.inr (by omega)⟩
  · intro z
    constructor
    · exact integral_coordinates r hr z
    · rintro ⟨x, y, hx, hy⟩
      have hz : z = algebraMap (QuadraticAlgebra ℤ (-(r : ℤ)) 0) (Field r) ⟨x, y⟩ := by
        apply QuadraticAlgebra.ext
        · simpa using hx
        · simpa using hy
      rw [hz]
      exact (IsIntegral.of_finite ℤ (⟨x, y⟩ : QuadraticAlgebra ℤ (-(r : ℤ)) 0)).algebraMap
  · intro u
    let e := maximalOrderEquiv r hr
    rcases units_eq r hr (e.symm (u : 𝓞 (Field r))) (u.isUnit.map e.symm.toRingHom) with h | h
    · left; apply e.symm.injective; simpa using h
    · right; apply e.symm.injective; simpa using h

instance totallyComplex : NumberField.IsTotallyComplex (Field r) where
  isComplex w := by
    rw [← not_isReal_iff_isComplex]
    intro hw
    let φ := embedding_of_isReal hw
    let theta : Field r := QuadraticAlgebra.omega
    have htheta : theta * theta = -(r : Field r) := by
      simpa only [theta, Int.cast_neg, Int.cast_natCast, Int.cast_zero,
        map_neg, map_natCast, map_zero, zero_mul, add_zero] using
        (QuadraticAlgebra.omega_mul_omega_eq_algebraMap
          (a := ((-(r : ℤ) : ℤ) : ℚ)) (b := ((0 : ℤ) : ℚ)))
    have heq := congrArg φ htheta
    simp only [map_mul, map_neg, map_natCast] at heq
    have hp : (0 : ℝ) < r := by exact_mod_cast (Fact.out : r.Prime).pos
    nlinarith [sq_nonneg (φ theta)]

private lemma complexPlaces : nrComplexPlaces (Field r) = 1 := by
  have h := NumberField.IsTotallyComplex.finrank (Field r)
  rw [QuadraticAlgebra.finrank_eq_two] at h
  omega

private lemma unitRank : NumberField.Units.rank (Field r) = 0 := by
  rw [NumberField.Units.rank, card_eq_nrRealPlaces_add_nrComplexPlaces,
    NumberField.IsTotallyComplex.nrRealPlaces_eq_zero, complexPlaces]

private lemma regulator : NumberField.Units.regulator (Field r) = 1 := by
  classical
  have hc := Fintype.card_congr (NumberField.Units.equivFinRank (Field r))
  rw [Fintype.card_fin, unitRank] at hc
  letI : IsEmpty {v : InfinitePlace (Field r) //
      v ≠ NumberField.Units.dirichletUnitTheorem.w₀} :=
    Fintype.card_eq_zero_iff.mp hc.symm
  rw [NumberField.Units.regulator_eq_det' (Field r)]
  simp

private lemma torsionOrder (hr : r % 8 = 5) : NumberField.Units.torsionOrder (Field r) = 2 := by
  classical
  letI := Fintype.ofFinite (NumberField.Units.torsion (Field r))
  rw [NumberField.Units.torsionOrder, Nat.card_eq_fintype_card]
  apply Finset.card_eq_two.mpr
  refine ⟨1, ⟨-1, neg_one_mem_torsion⟩,
    by simp [← Subtype.coe_ne_coe], Finset.ext fun x => ⟨fun _ => ?_, fun _ => Finset.mem_univ _⟩⟩
  rw [Finset.mem_insert, Finset.mem_singleton, ← Subtype.val_inj, ← Subtype.val_inj]
  rcases (field_structure r hr).2.2.2 x.1 with h | h
  · exact Or.inl (Units.ext h)
  · exact Or.inr (Units.ext h)

/-- The invariants in the analytic class-number residue are computed on the
actual maximal order. This does not assert the still separate signed finite-sum bridge. -/
theorem field_invariants (hr : r % 8 = 5) :
    nrRealPlaces (Field r) = 0 ∧ nrComplexPlaces (Field r) = 1 ∧
    NumberField.Units.rank (Field r) = 0 ∧ NumberField.Units.regulator (Field r) = 1 ∧
    NumberField.Units.torsionOrder (Field r) = 2 ∧
    NumberField.dedekindZeta_residue (Field r) =
      Real.pi * (NumberField.classNumber (Field r) : ℝ) / (2 * Real.sqrt (r : ℝ)) := by
  refine ⟨NumberField.IsTotallyComplex.nrRealPlaces_eq_zero _, complexPlaces r,
    unitRank r, regulator r, torsionOrder r hr, ?_⟩
  rw [NumberField.dedekindZeta_residue_def,
    NumberField.IsTotallyComplex.nrRealPlaces_eq_zero, complexPlaces,
    regulator, torsionOrder r hr, field_discr r hr]
  simp only [pow_zero, pow_one, one_mul, mul_one, Int.cast_mul, Int.cast_neg,
    Int.cast_ofNat, Int.cast_natCast, Nat.cast_ofNat]
  have hs : Real.sqrt |-(4 : ℝ) * r| = 2 * Real.sqrt (r : ℝ) := by
    rw [abs_mul, abs_neg, abs_of_pos (by norm_num : (0 : ℝ) < 4),
      abs_of_nonneg (Nat.cast_nonneg r), Real.sqrt_mul (by norm_num : (0 : ℝ) ≤ 4)]
    rw [show (4 : ℝ) = (2 : ℝ) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  rw [hs]
  ring

end D5.S3.Arith.QuadraticFields.MercaImaginaryQuadratic
