/-! Rational trace coordinates for signed normalized quadratic approximations. -/

noncomputable section

namespace D5.S3.Arith.QuadraticFields.QuadraticAccumulation

open QuadraticAlgebra Set Filter
open scoped Topology

/-- The rational quadratic algebra with its distinguished square root. -/
abbrev K (D : ℤ) := QuadraticAlgebra ℚ (D : ℚ) 0

/-- The quadratic number in rational coordinates. -/
def alpha (D : ℤ) (A B : ℚ) : K D := ⟨A, B⟩

/-- The lattice generated by one and the quadratic number. -/
def lattice (D : ℤ) (A B : ℚ) : Submodule ℤ (K D) :=
  Submodule.span ℤ ({1, alpha D A B} : Set (K D))

/-- Duality uses the actual algebra trace form. -/
def traceDual (D : ℤ) (A B : ℚ) : Submodule ℤ (K D) :=
  (Algebra.traceForm ℚ (K D)).dualSubmodule (lattice D A B)

/-- Signed normalized approximation values, with no primitivity restriction. -/
def approximationValues (a : ℝ) : Set ℝ :=
  {x | ∃ q p : ℤ, q ≠ 0 ∧ x = |(q : ℝ)| * ((q : ℝ) * a - p)}

private theorem trace_coordinates (D : ℤ) (s : K D) :
    Algebra.trace ℚ (K D) s = 2 * s.re := by
  simpa [QuadraticAlgebra.trace_def] using
    QuadraticOrderMaximal.algebra_trace_eq (D : ℚ) 0 s

theorem norm_coordinates (D : ℤ) (s : K D) :
    Algebra.norm ℚ s = s.re ^ 2 - (D : ℚ) * s.im ^ 2 := by
  rw [Algebra.norm_eq_matrix_det (QuadraticAlgebra.basis (D : ℚ) 0)]
  simp [Matrix.det_fin_two, Algebra.leftMulMatrix_eq_repr_mul,
    QuadraticAlgebra.basis_repr_apply]
  ring

theorem mem_traceDual_iff (D : ℤ) (A B : ℚ) (s : K D) :
    s ∈ traceDual D A B ↔
      (∃ q : ℤ, (q : ℚ) = 2 * s.re) ∧
      (∃ p : ℤ, (p : ℚ) = 2 * (A * s.re + (D : ℚ) * B * s.im)) := by
  change (∀ y ∈ lattice D A B,
    Algebra.trace ℚ (K D) (s * y) ∈ (1 : Submodule ℤ ℚ)) ↔ _
  constructor
  · intro h
    have h1 := h 1 (Submodule.subset_span (by simp))
    have ha := h (alpha D A B) (Submodule.subset_span (by simp))
    simp only [mul_one, trace_coordinates, Submodule.mem_one] at h1
    refine ⟨h1, ?_⟩
    simpa [trace_coordinates, alpha, mul_comm, mul_left_comm, mul_assoc] using ha
  · rintro ⟨hq, hp⟩ y hy
    induction hy using Submodule.span_induction with
    | mem x hx =>
        rcases hx with rfl | hx
        · simpa [trace_coordinates, Submodule.mem_one] using hq
        · have hx' : x = alpha D A B := Set.mem_singleton_iff.mp hx
          subst x
          simpa [trace_coordinates, alpha, Submodule.mem_one,
            mul_comm, mul_left_comm, mul_assoc] using hp
    | zero => simp
    | add x y _ _ hx hy => simpa [mul_add] using add_mem hx hy
    | smul z x _ hx =>
        simpa only [mul_smul_comm, map_zsmul] using (1 : Submodule ℤ ℚ).smul_mem z hx

theorem sqrt_nonsquare (D : ℤ) (hD : 2 ≤ D) (hs : Squarefree D) :
    ¬ IsSquare D := by
  rintro ⟨z, hz⟩
  have hzsq : Squarefree (z ^ 2) := by simpa [hz, sq] using hs
  by_cases hu : IsUnit z
  · rcases Int.isUnit_iff.mp hu with rfl | rfl <;> norm_num at hz <;> omega
  · have := hzsq.eq_zero_or_one_of_pow_of_not_isUnit hu
    omega

/-- The real embedding sending the distinguished root to the positive square root. -/
def realEmbedding (D : ℤ) (hD : 0 ≤ D) : K D →ₐ[ℚ] ℝ :=
  QuadraticAlgebra.lift ⟨Real.sqrt (D : ℝ), by
    simpa [smul_eq_mul] using Real.mul_self_sqrt (show (0 : ℝ) ≤ D by exact_mod_cast hD)⟩

theorem realEmbedding_apply (D : ℤ) (hD : 0 ≤ D) (s : K D) :
    realEmbedding D hD s = (s.re : ℝ) + (s.im : ℝ) * Real.sqrt (D : ℝ) := by
  simp [realEmbedding, QuadraticAlgebra.lift, Algebra.smul_def]

private theorem norm_embeddings (D : ℤ) (hD : 0 ≤ D) (s : K D) :
    (Algebra.norm ℚ s : ℝ) =
      realEmbedding D hD s * realEmbedding D hD (star s) := by
  rw [norm_coordinates]
  simp only [realEmbedding_apply, QuadraticAlgebra.re_star, QuadraticAlgebra.im_star,
    zero_mul, add_zero,
    Rat.cast_sub, Rat.cast_mul, Rat.cast_pow, Rat.cast_intCast, Rat.cast_neg]
  nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ D by exact_mod_cast hD)]

private theorem trace_embeddings (D : ℤ) (hD : 0 ≤ D) (s : K D) :
    (Algebra.trace ℚ (K D) s : ℝ) =
      realEmbedding D hD s + realEmbedding D hD (star s) := by
  rw [trace_coordinates]
  simp [realEmbedding_apply, QuadraticAlgebra.re_star, QuadraticAlgebra.im_star]
  ring

private theorem exists_expanding_multiplier (D : ℤ) (hD : 2 ≤ D)
    (hs : Squarefree D) (A B : ℚ) (hB : B ≠ 0) :
    ∃ u : K D, Algebra.norm ℚ u = 1 ∧
      1 < realEmbedding D (by omega) u ∧
      ∀ s ∈ traceDual D A B, u * s ∈ traceDual D A B := by
  let f : Fin 3 → ℚ := ![A / B, (A ^ 2 - (D : ℚ) * B ^ 2) / B, 1 / B]
  obtain ⟨m, hm⟩ :=
    IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors ℤ) f
  have hm0 : (m : ℤ) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp m.property
  obtain ⟨a, ha⟩ := hm 0
  obtain ⟨b, hb⟩ := hm 1
  obtain ⟨c, hc⟩ := hm 2
  change (a : ℚ) = (m : ℤ) * (A / B) at ha
  change (b : ℚ) = (m : ℤ) * ((A ^ 2 - (D : ℚ) * B ^ 2) / B) at hb
  change (c : ℚ) = (m : ℤ) * (1 / B) at hc
  let N : ℤ := (m : ℤ) ^ 2
  have hN : 0 < N := sq_pos_of_ne_zero hm0
  have hN0 : (N : ℚ) ≠ 0 := by exact_mod_cast ne_of_gt hN
  have hd : 0 < D * N ^ 2 := mul_pos (by omega) (sq_pos_of_pos hN)
  have hns : ¬ IsSquare (D * N ^ 2) := by
    rintro ⟨z, hz⟩
    apply sqrt_nonsquare D hD hs
    apply Rat.isSquare_intCast_iff.mp
    refine ⟨(z : ℚ) / N, ?_⟩
    have hz' : (D : ℚ) * (N : ℚ) ^ 2 = (z : ℚ) * z := by exact_mod_cast hz
    field_simp
    nlinarith [hz']
  obtain ⟨v, hvx, hvy⟩ := Pell.Solution₁.exists_pos_of_not_isSquare hd hns
  let t : ℤ := N * v.y
  let u : K D := ⟨v.x, t⟩
  have hnorm : Algebra.norm ℚ u = 1 := by
    rw [norm_coordinates]
    change (v.x : ℚ) ^ 2 - (D : ℚ) * (t : ℚ) ^ 2 = 1
    have hv := v.prop
    dsimp [t]
    push_cast
    exact_mod_cast (show v.x ^ 2 - D * (N * v.y) ^ 2 = 1 by nlinarith [hv])
  refine ⟨u, hnorm, ?_, ?_⟩
  · rw [realEmbedding_apply]
    change 1 < (v.x : ℝ) + (t : ℝ) * Real.sqrt (D : ℝ)
    have ht : (0 : ℝ) < t := by exact_mod_cast mul_pos hN hvy
    have hx : (1 : ℝ) < v.x := by exact_mod_cast hvx
    have := mul_nonneg ht.le (Real.sqrt_nonneg (D : ℝ))
    linarith
  · intro s hs'
    obtain ⟨⟨q, hq⟩, ⟨p, hp⟩⟩ := (mem_traceDual_iff D A B s).mp hs'
    apply (mem_traceDual_iff D A B (u * s)).mpr
    have htA : (t : ℚ) * (A / B) = (m : ℤ) * v.y * a := by
      rw [ha]
      dsimp [t, N]
      push_cast
      ring
    have htB : (t : ℚ) * ((A ^ 2 - (D : ℚ) * B ^ 2) / B) =
        (m : ℤ) * v.y * b := by
      rw [hb]
      dsimp [t, N]
      push_cast
      ring
    have htC : (t : ℚ) * (1 / B) = (m : ℤ) * v.y * c := by
      rw [hc]
      dsimp [t, N]
      push_cast
      ring
    constructor
    · refine ⟨(v.x - (m : ℤ) * v.y * a) * q + (m : ℤ) * v.y * c * p, ?_⟩
      change _ = 2 * ((v.x : ℚ) * s.re + (D : ℚ) * (t : ℚ) * s.im)
      push_cast
      rw [hq, hp, ← htA, ← htC]
      field_simp
      ring
    · refine ⟨(v.x + (m : ℤ) * v.y * a) * p - (m : ℤ) * v.y * b * q, ?_⟩
      change _ = 2 * (A * ((v.x : ℚ) * s.re + (D : ℚ) * (t : ℚ) * s.im) +
        (D : ℚ) * B * ((v.x : ℚ) * s.im + (t : ℚ) * s.re + 0 * (t : ℚ) * s.im))
      simp only [zero_mul, add_zero]
      push_cast
      rw [hq, hp, ← htA, ← htB]
      field_simp
      ring


private theorem positive_orbit (D : ℤ) (hD : 2 ≤ D) (hs : Squarefree D)
    (A B : ℚ) (hB : B ≠ 0) (s : K D) (hsL : s ∈ traceDual D A B)
    (hspos : 0 < realEmbedding D (by omega) s)
    (hsstar : realEmbedding D (by omega) (star s) ≠ 0) :
    ∃ f : ℕ → ℝ, Function.Injective f ∧
      (∀ n, f n ∈ approximationValues ((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ))) ∧
      (∀ n, f n ≠ 2 * (B : ℝ) * Real.sqrt (D : ℝ) * (Algebra.norm ℚ s : ℝ)) ∧
      Tendsto f atTop
        (𝓝 (2 * (B : ℝ) * Real.sqrt (D : ℝ) * (Algebra.norm ℚ s : ℝ))) := by
  obtain ⟨u, hun, hup, huL⟩ := exists_expanding_multiplier D hD hs A B hB
  let σ := realEmbedding D (show 0 ≤ D by omega)
  let a : ℝ := σ s
  let b : ℝ := σ (star s)
  let U : ℝ := σ u
  let r : ℝ := U⁻¹
  let δ : ℝ := 2 * (B : ℝ) * Real.sqrt (D : ℝ)
  have hU : 1 < U := hup
  have hU0 : 0 < U := lt_trans zero_lt_one hU
  have hr0 : 0 < r := inv_pos.mpr hU0
  have hr1 : r < 1 := inv_lt_one_of_one_lt₀ hU
  have hδ : δ ≠ 0 := mul_ne_zero (mul_ne_zero (by norm_num) (by exact_mod_cast hB))
    (ne_of_gt (Real.sqrt_pos.mpr (by exact_mod_cast (show 0 < D by omega))))
  have huconj : σ (star u) = r := by
    have ht : U * σ (star u) = 1 := by
      rw [← norm_embeddings D (show 0 ≤ D by omega), hun]
      norm_num
    exact (eq_inv_of_mul_eq_one_left (by simpa [mul_comm] using ht))
  let z : ℕ → K D := fun n => u ^ n * s
  have hzL : ∀ n, z n ∈ traceDual D A B := by
    intro n
    induction n with
    | zero => simpa [z] using hsL
    | succ n ih => simpa [z, pow_succ, mul_assoc, mul_comm, mul_left_comm] using huL (z n) ih
  have hzσ : ∀ n, σ (z n) = U ^ n * a := by intro n; simp [z, U, a]
  have hzσ' : ∀ n, σ (star (z n)) = r ^ n * b := by
    intro n
    simp [z, star_mul, huconj, b, mul_comm]
  have hqn : ∀ n, ∃ q : ℤ, (q : ℝ) = U ^ n * a + r ^ n * b := by
    intro n
    obtain ⟨⟨q, hq⟩, _⟩ := (mem_traceDual_iff D A B (z n)).mp (hzL n)
    refine ⟨q, ?_⟩
    rw [← hzσ n, ← hzσ' n, ← trace_embeddings]
    exact_mod_cast (hq.trans (trace_coordinates D (z n)).symm)
  have hpn : ∀ n, ∃ p : ℤ,
      (p : ℝ) = ((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ)) * (U ^ n * a) +
        ((A : ℝ) - (B : ℝ) * Real.sqrt (D : ℝ)) * (r ^ n * b) := by
    intro n
    obtain ⟨_, ⟨p, hp⟩⟩ := (mem_traceDual_iff D A B (z n)).mp (hzL n)
    refine ⟨p, ?_⟩
    have ht := trace_embeddings D (show 0 ≤ D by omega) (alpha D A B * z n)
    change _ = σ (alpha D A B * z n) + σ (star (alpha D A B * z n)) at ht
    rw [map_mul σ (alpha D A B) (z n), star_mul,
      map_mul σ (star (z n)) (star (alpha D A B)), hzσ n, hzσ' n] at ht
    have hp' : (p : ℚ) = Algebra.trace ℚ (K D) (alpha D A B * z n) := by
      rw [trace_coordinates]
      simpa [alpha, mul_comm, mul_left_comm, mul_assoc] using hp
    have hpc : (p : ℝ) = (Algebra.trace ℚ (K D) (alpha D A B * z n) : ℝ) :=
      by exact_mod_cast hp'
    rw [hpc]
    convert ht using 1; simp [σ, realEmbedding_apply, alpha]; ring
  have hnorm : (Algebra.norm ℚ s : ℝ) = a * b := norm_embeddings D (by omega) s
  have hUr : U * r = 1 := mul_inv_cancel₀ (ne_of_gt hU0)
  have hUrn : ∀ n, U ^ n * r ^ n = 1 := by intro n; rw [← mul_pow, hUr, one_pow]
  have hrseq : Tendsto (fun n : ℕ => r ^ n) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one hr0.le hr1
  have hqscaled : Tendsto (fun n : ℕ => a + b * (r ^ n) ^ 2) atTop (𝓝 a) := by
    simpa using tendsto_const_nhds.add (tendsto_const_nhds.mul (hrseq.pow 2))
  have hqevent : ∀ᶠ n : ℕ in atTop, 0 < U ^ n * a + r ^ n * b := by
    filter_upwards [hqscaled.eventually (Ioi_mem_nhds hspos)] with n hn
    have he : (U ^ n * a + r ^ n * b) * r ^ n = a + b * (r ^ n) ^ 2 := by
      nlinarith [hUrn n]
    have hn' : 0 < (U ^ n * a + r ^ n * b) * r ^ n := by rwa [he]
    exact (mul_pos_iff_of_pos_right (pow_pos hr0 n)).mp hn'
  obtain ⟨N, hN⟩ := eventually_atTop.mp hqevent
  let f : ℕ → ℝ := fun n => δ * (Algebra.norm ℚ s : ℝ) + δ * b ^ 2 * (r ^ (n + N)) ^ 2
  refine ⟨f, ?_, ?_, ?_, ?_⟩
  · intro i j hij
    have hb : b ≠ 0 := hsstar
    have hpow : r ^ (i + N) = r ^ (j + N) := by
      have he : (r ^ (i + N)) ^ 2 = (r ^ (j + N)) ^ 2 := by
        dsimp [f] at hij
        exact mul_left_cancel₀ (mul_ne_zero hδ (pow_ne_zero 2 hb)) (add_left_cancel hij)
      nlinarith [pow_pos hr0 (i + N), pow_pos hr0 (j + N)]
    have := pow_right_injective₀ hr0 (ne_of_lt hr1) hpow
    omega
  · intro n
    obtain ⟨q, hq⟩ := hqn (n + N)
    obtain ⟨p, hp⟩ := hpn (n + N)
    have hqpos : (0 : ℝ) < q := by rw [hq]; exact hN _ (by omega)
    refine ⟨q, p, by exact_mod_cast ne_of_gt hqpos, ?_⟩
    rw [abs_of_pos hqpos, hq, hp]
    dsimp [f, δ]
    rw [hnorm]
    calc
      _ = (2 * (B : ℝ) * Real.sqrt (D : ℝ) * (a * b)) *
          (U ^ (n + N) * r ^ (n + N)) +
          2 * (B : ℝ) * Real.sqrt (D : ℝ) * b ^ 2 * (r ^ (n + N)) ^ 2 := by
            rw [hUrn]
            ring
      _ = _ := by ring
  · intro n
    dsimp [f]
    intro he
    have hnz := mul_ne_zero (mul_ne_zero hδ (pow_ne_zero 2 hsstar))
      (pow_ne_zero 2 (pow_ne_zero (n + N) (ne_of_gt hr0)))
    apply hnz
    linarith
  · have hrshift := hrseq.comp (tendsto_add_atTop_nat N)
    simpa [f] using tendsto_const_nhds.add
      (tendsto_const_nhds.mul (hrshift.pow 2))

/-- An injective sequence in the punctured set, with its specified limit. -/
def HasDistinctApproximationSequence (S : Set ℝ) (x : ℝ) : Prop :=
  ∃ f : ℕ → ℝ, Function.Injective f ∧ (∀ n, f n ∈ S ∧ f n ≠ x) ∧
    Tendsto f atTop (𝓝 x)

/-- Every signed nonzero trace-dual norm is approached by distinct genuine
normalized approximations and is therefore a set accumulation point. -/
private theorem coordinate_signed_norm_values_accumulate (D : ℤ) (hD : 2 ≤ D) (hs : Squarefree D)
    (A B : ℚ) (hB : B ≠ 0) (s : K D) (hsL : s ∈ traceDual D A B) (hs0 : s ≠ 0) :
    let S := approximationValues ((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ))
    let c := 2 * (B : ℝ) * Real.sqrt (D : ℝ) * (Algebra.norm ℚ s : ℝ)
    ∀ x ∈ ({c, -c} : Set ℝ), HasDistinctApproximationSequence S x ∧ x ∈ derivedSet S := by
  let : Fact (¬ IsSquare (D : ℚ)) :=
    ⟨by simpa only [Rat.isSquare_intCast_iff] using sqrt_nonsquare D hD hs⟩
  let σ := realEmbedding D (show 0 ≤ D by omega)
  have hσs : σ s ≠ 0 := by
    intro h
    apply hs0
    apply σ.injective
    simpa using h
  have hσs' : σ (star s) ≠ 0 := by
    intro h
    have he : star s = 0 := σ.injective (by simpa using h)
    exact hs0 (star_eq_zero.mp he)
  have hex : ∃ t : K D, t ∈ traceDual D A B ∧ 0 < σ t ∧ σ (star t) ≠ 0 ∧
      Algebra.norm ℚ t = Algebra.norm ℚ s := by
    rcases lt_or_gt_of_ne hσs with hn | hp
    · refine ⟨-s, Submodule.neg_mem _ hsL, ?_, ?_, ?_⟩
      · simpa using neg_pos.mpr hn
      · simpa using hσs'
      · simp only [norm_coordinates, QuadraticAlgebra.re_neg, QuadraticAlgebra.im_neg,
          even_two, Even.neg_pow]
    · exact ⟨s, hsL, hp, hσs', rfl⟩
  obtain ⟨t, htL, htpos, htstar, htnorm⟩ := hex
  obtain ⟨f, hfi, hfS, hfc, hft⟩ := positive_orbit D hD hs A B hB t htL htpos htstar
  rw [htnorm] at hfc hft
  dsimp only
  let S := approximationValues ((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ))
  let c := 2 * (B : ℝ) * Real.sqrt (D : ℝ) * (Algebra.norm ℚ s : ℝ)
  have hneg : ∀ x ∈ S, -x ∈ S := by
    rintro x ⟨q, p, hq, rfl⟩
    refine ⟨-q, -p, neg_ne_zero.mpr hq, ?_⟩
    simp only [Int.cast_neg, abs_neg]
    ring
  have hplus : HasDistinctApproximationSequence S c :=
    ⟨f, hfi, fun n => ⟨hfS n, hfc n⟩, hft⟩
  have hminus : HasDistinctApproximationSequence S (-c) := by
    refine ⟨fun n => -f n, fun i j h => hfi (neg_injective h), ?_, ?_⟩
    · intro n
      exact ⟨hneg _ (hfS n), fun h => hfc n (neg_injective h)⟩
    · exact hft.neg
  intro x hx
  have hw : HasDistinctApproximationSequence S x := by
    rcases hx with rfl | hx
    · exact hplus
    · have hx' : x = -c := Set.mem_singleton_iff.mp hx
      exact hx' ▸ hminus
  refine ⟨hw, ?_⟩
  obtain ⟨g, _, hg, hgt⟩ := hw
  apply accPt_principal_iff_clusterPt.mpr
  apply mem_closure_iff_clusterPt.mp
  exact mem_closure_of_tendsto hgt (Eventually.of_forall fun n => ⟨(hg n).1, (hg n).2⟩)

/-- The actual subfield of the reals generated by the quadratic irrational. -/
def RealField (D : ℤ) (A B : ℚ) : IntermediateField ℚ ℝ :=
  IntermediateField.adjoin ℚ {((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ))}

/-- The distinguished irrational in its generated real subfield. -/
def realAlpha (D : ℤ) (A B : ℚ) : RealField D A B :=
  ⟨_, IntermediateField.subset_adjoin ℚ _ (Set.mem_singleton _)⟩

/-- The original lattice inside the actual generated real subfield. -/
def realLattice (D : ℤ) (A B : ℚ) : Submodule ℤ (RealField D A B) :=
  Submodule.span ℤ ({1, realAlpha D A B} : Set (RealField D A B))

/-- The actual trace dual in the generated real subfield. -/
def realTraceDual (D : ℤ) (A B : ℚ) : Submodule ℤ (RealField D A B) :=
  (Algebra.traceForm ℚ (RealField D A B)).dualSubmodule (realLattice D A B)

/-- The coordinate presentation is isomorphic to the generated real subfield. -/
def coordinateEquiv (D : ℤ) (hD : 0 ≤ D) (A B : ℚ) (hB : B ≠ 0)
    [Fact (¬ IsSquare (D : ℚ))] : K D ≃ₐ[ℚ] RealField D A B := by
  let σ := realEmbedding D hD
  have hrange : σ.fieldRange = RealField D A B := by
    have hα : ((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ)) ∈ RealField D A B :=
      (realAlpha D A B).property
    have hsqrt : Real.sqrt (D : ℝ) ∈ RealField D A B := by
      have hm := (RealField D A B).div_mem
        ((RealField D A B).sub_mem hα ((RealField D A B).algebraMap_mem A))
        ((RealField D A B).algebraMap_mem B)
      have he : (((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ)) - A) / B =
          Real.sqrt (D : ℝ) := by
        field_simp
        ring
      change (((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ)) - A) / B ∈
        RealField D A B at hm
      rwa [he] at hm
    apply le_antisymm
    · rintro x ⟨z, rfl⟩
      change realEmbedding D hD z ∈ RealField D A B
      rw [realEmbedding_apply]
      exact (RealField D A B).add_mem ((RealField D A B).algebraMap_mem z.re)
        ((RealField D A B).mul_mem ((RealField D A B).algebraMap_mem z.im) hsqrt)
    · apply IntermediateField.adjoin_le_iff.mpr
      rw [Set.singleton_subset_iff]
      exact ⟨alpha D A B, by simp [σ, realEmbedding_apply, alpha]⟩
  exact σ.equivFieldRange.trans (IntermediateField.equivOfEq hrange)

theorem coordinateEquiv_coe (D : ℤ) (hD : 0 ≤ D) (A B : ℚ) (hB : B ≠ 0)
    [Fact (¬ IsSquare (D : ℚ))] (s : K D) :
    ((coordinateEquiv D hD A B hB s : RealField D A B) : ℝ) =
      realEmbedding D hD s := rfl

/-- In the actual generated real field, every signed nonzero trace-dual norm
is a genuine set accumulation point, with an injective approximating sequence. -/
theorem signed_norm_values_accumulate (D : ℤ) (hD : 2 ≤ D) (hs : Squarefree D)
    (A B : ℚ) (hB : B ≠ 0) (s : RealField D A B)
    (hsL : s ∈ realTraceDual D A B) (hs0 : s ≠ 0) :
    let S := approximationValues ((A : ℝ) + (B : ℝ) * Real.sqrt (D : ℝ))
    let c := 2 * (B : ℝ) * Real.sqrt (D : ℝ) * (Algebra.norm ℚ s : ℝ)
    ∀ x ∈ ({c, -c} : Set ℝ), HasDistinctApproximationSequence S x ∧ x ∈ derivedSet S := by
  let : Fact (¬ IsSquare (D : ℚ)) :=
    ⟨by simpa only [Rat.isSquare_intCast_iff] using sqrt_nonsquare D hD hs⟩
  let e := coordinateEquiv D (show 0 ≤ D by omega) A B hB
  let t : K D := e.symm s
  have het : e t = s := e.apply_symm_apply s
  have heα : e (alpha D A B) = realAlpha D A B := by
    apply Subtype.ext
    rw [coordinateEquiv_coe]
    simp [realEmbedding_apply, alpha, realAlpha]
  have htrace (v : K D) : Algebra.trace ℚ (K D) v =
      Algebra.trace ℚ (RealField D A B) (e v) :=
    (Algebra.trace_eq_of_algEquiv e v).symm
  have htL : t ∈ traceDual D A B := by
    have hq := hsL 1 (Submodule.subset_span (by simp))
    have hp := hsL (realAlpha D A B) (Submodule.subset_span (by simp))
    change Algebra.trace ℚ (RealField D A B) (s * 1) ∈ (1 : Submodule ℤ ℚ) at hq
    change Algebra.trace ℚ (RealField D A B) (s * realAlpha D A B) ∈
      (1 : Submodule ℤ ℚ) at hp
    rw [mul_one, ← het, ← htrace] at hq
    rw [← het, ← heα, ← map_mul, ← htrace] at hp
    apply (mem_traceDual_iff D A B t).mpr
    constructor
    · simpa [trace_coordinates, Submodule.mem_one] using hq
    · simpa [trace_coordinates, alpha, Submodule.mem_one,
        mul_comm, mul_left_comm, mul_assoc] using hp
  have ht0 : t ≠ 0 := by
    intro ht
    apply hs0
    rw [← het, ht, map_zero]
  have hn : Algebra.norm ℚ t = Algebra.norm ℚ s := by
    rw [← het]
    exact (Algebra.norm_eq_of_algEquiv e t).symm
  simpa only [hn] using coordinate_signed_norm_values_accumulate D hD hs A B hB t htL ht0

end D5.S3.Arith.QuadraticFields.QuadraticAccumulation
