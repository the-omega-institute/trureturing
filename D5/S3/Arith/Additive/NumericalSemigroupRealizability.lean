   digest: Every numerical semigroup is generated by a primitive finite jump set. -/

import Mathlib.NumberTheory.FrobeniusNumber

/-! # Numerical semigroups from primitive finite jump sets -/

/-
result:
  proof_shape: bind-only
  escape_witness: none
  admission_basis: open-problem-resolution (#29915)
  Direct frozen dependencies: none.
The construction uses finite generation, a bound on the finite complement, and
two consecutive elements above that bound. Finset.sup id expresses the maximum
of the nonempty natural-number set. No properness premise excludes the full monoid.
-/

set_option autoImplicit false

namespace D5.S3.Arith.Additive.NumericalSemigroupRealizability

/-- Every cofinite additive submonoid of the naturals has a positive finite jump set
whose maximum is `M`, whose gcd is one, and whose defect generators generate the monoid.
The full monoid is included; the maximum is chosen separately for each monoid. -/
theorem result (T : AddSubmonoid ℕ) (hT : (↑T : Set ℕ)ᶜ.Finite) :
    ∃ (M : ℕ) (S : Finset ℕ), 0 < M ∧ S.Nonempty ∧
      (∀ s ∈ S, 0 < s) ∧ S.sup id = M ∧ S.gcd id = 1 ∧
      AddSubmonoid.closure
        ({M} ∪ (fun s => M - s) '' (↑S : Set ℕ) ∪
          (fun s => M + s) '' (↑S : Set ℕ)) = T := by
  classical
  obtain ⟨N, hN⟩ := hT.bddAbove
  have htail (a : ℕ) (ha : N < a) : a ∈ T := by
    by_contra h
    exact (not_le_of_gt ha) (hN h)
  obtain ⟨H, hH⟩ := AddSubmonoid.isAddFG_iff.mp (Nat.addSubmonoid_fg T)
  let c := N + 1
  let G := insert c (insert (c + 1) H)
  let M := G.sup id + 1
  let S := insert M (G.image fun a => M - a)
  have hbound (a : ℕ) (ha : a ∈ G) : a < M := by
    exact Nat.lt_succ_of_le (Finset.le_sup (f := id) ha)
  have hc : c ∈ G := by simp [G]
  have hc1 : c + 1 ∈ G := by simp [G]
  have hM : N < M := by
    have := hbound c hc
    dsimp [c] at this
    omega
  have hG (a : ℕ) (ha : a ∈ G) : a ∈ T := by
    simp only [G, Finset.mem_insert] at ha
    rcases ha with rfl | rfl | ha
    · exact htail _ (by dsimp [c]; omega)
    · exact htail _ (by dsimp [c]; omega)
    · rw [← hH]
      exact AddSubmonoid.subset_closure ha
  have hS (s : ℕ) (hs : s ∈ S) : 0 < s ∧ s ≤ M := by
    simp only [S, Finset.mem_insert, Finset.mem_image] at hs
    rcases hs with rfl | ⟨a, ha, rfl⟩
    · exact ⟨by omega, le_rfl⟩
    · exact ⟨Nat.sub_pos_of_lt (hbound a ha), Nat.sub_le _ _⟩
  have hMS : M ∈ S := Finset.mem_insert_self _ _
  have hsup : S.sup id = M := by
    exact le_antisymm (Finset.sup_le fun s hs => (hS s hs).2)
      (Finset.le_sup (f := id) hMS)
  have hsc : M - c ∈ S := by
    exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hc)
  have hsc1 : M - (c + 1) ∈ S := by
    exact Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hc1)
  have hd1 : S.gcd id ∣ M - c := Finset.gcd_dvd hsc
  have hd2 : S.gcd id ∣ M - (c + 1) := Finset.gcd_dvd hsc1
  have hone : S.gcd id ∣ 1 := by
    have hb := hbound (c + 1) hc1
    convert Nat.dvd_sub hd1 hd2 using 1
    omega
  refine ⟨M, S, by omega, ⟨M, hMS⟩, (fun s hs => (hS s hs).1), hsup,
    Nat.dvd_one.mp hone, ?_⟩
  apply le_antisymm
  · apply AddSubmonoid.closure_le.mpr
    intro x hx
    rcases hx with (hx | ⟨s, hs, rfl⟩) | ⟨s, hs, rfl⟩
    · rcases hx with rfl
      exact htail M hM
    · change s ∈ S at hs
      simp only [S, Finset.mem_insert, Finset.mem_image] at hs
      rcases hs with rfl | ⟨a, ha, rfl⟩
      · simp
      · change M - (M - a) ∈ T
        rw [Nat.sub_sub_self (Nat.le_of_lt (hbound a ha))]
        exact hG a ha
    · change M + s ∈ T
      exact htail (M + s) (lt_of_lt_of_le hM (Nat.le_add_right M s))
  · rw [← hH]
    apply AddSubmonoid.closure_le.mpr
    intro a ha
    change a ∈ H at ha
    have haG : a ∈ G :=
      Finset.mem_insert_of_mem (Finset.mem_insert_of_mem ha)
    have haS : M - a ∈ S :=
      Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ haG)
    apply AddSubmonoid.subset_closure
    apply Or.inl
    apply Or.inr
    refine ⟨M - a, haS, ?_⟩
    exact Nat.sub_sub_self (Nat.le_of_lt (hbound a haG))


end D5.S3.Arith.Additive.NumericalSemigroupRealizability
