/- GID: D5/S3/Arith/FibonacciTransportFivePowerOrbit
   generality: G
   mirror-B: D5/B/S3/Arith/FibonacciTransportFivePowerOrbit
   mirror-E: none(waiver:algebraically-proved)
   anchors: []
   utility: none
   digest: Signed Fibonacci transport and the common CRT label at five-power moduli. -/

import Mathlib
import D5.S3.Arith.GoldenPrimePowerOrder
import D5.S3.Arith.GoldenFibonacciModulusPeriod

namespace D5.S3.Arith.FibonacciTransportFivePowerOrbit

open scoped Matrix
local notation "Mat" n => Matrix (Fin 2) (Fin 2) (ZMod n)
local notation "Vec" n => Fin 2 → ZMod n
local notation "GL" n => Matrix.GeneralLinearGroup (Fin 2) (ZMod n)

/-- The invertible Fibonacci transport matrix. -/
def transportG (n : ℕ) : GL n where
  val := !![-1, 1; 1, 0]
  inv := !![0, 1; 1, 1]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- The reflection which exchanges the two split eigenaxes. -/
def transportJ (n : ℕ) : GL n where
  val := !![1, 0; 1, -1]
  inv := !![1, 0; 1, -1]
  val_inv := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]
  inv_val := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_two]

/-- The subgroup generated by transport and the scalar sign. -/
def signedGroup (n : ℕ) : Subgroup (GL n) :=
  Subgroup.closure {transportG n, -1}

/-- The subgroup generated by transport and reflection. -/
def transportGroup (n : ℕ) : Subgroup (GL n) :=
  Subgroup.closure {transportG n, transportJ n}

/-- The actual matrix orbit of a vector under the transport group. -/
def vectorOrbit (n : ℕ) (v : Vec n) : Set (Vec n) :=
  {w | ∃ A : transportGroup n, (A.val : Mat n) *ᵥ v = w}

private theorem reflection_square (n : ℕ) : transportJ n ^ 2 = 1 := by
  apply Units.ext
  exact (transportJ n).val_inv

private theorem reflection_transport (n : ℕ) :
    transportJ n * transportG n * transportJ n = -(transportG n)⁻¹ := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [transportG, transportJ, Matrix.mul_apply, Fin.sum_univ_two]

private theorem reflection_axis :
    (transportJ 59 : Mat 59) *ᵥ ![1, 26] = ![1, 34] := by
  ext i
  fin_cases i <;>
    norm_num [transportJ, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

private theorem first_axis :
    (transportG 59 : Mat 59) *ᵥ ![1, 26] = (25 : ZMod 59) • ![1, 26] := by
  ext i
  fin_cases i <;>
    norm_num [transportG, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

private theorem second_axis :
    (transportG 59 : Mat 59) *ᵥ ![1, 34] = (33 : ZMod 59) • ![1, 34] := by
  ext i
  fin_cases i <;>
    norm_num [transportG, Matrix.mulVec, dotProduct, Fin.sum_univ_two]

private theorem coprime_five_power_twenty_nine (a : ℕ) :
    Nat.Coprime (5 ^ a) 29 := by
  exact (by decide : Nat.Coprime 5 29).pow_left a

private theorem coprime_six_five_power_twenty_nine (a : ℕ) :
    Nat.Coprime (6 * 5 ^ a) 29 := by
  rw [Nat.coprime_mul_iff_left]
  exact ⟨by decide, coprime_five_power_twenty_nine a⟩

private theorem lcm_three_four_five_power (a : ℕ) :
    Nat.lcm 3 (4 * 5 ^ a) = 12 * 5 ^ a := by
  have hpow : Nat.Coprime 3 (5 ^ a) :=
    (by decide : Nat.Coprime 3 5).pow_right a
  have hprod : Nat.Coprime 3 (4 * 5 ^ a) := by
    rw [Nat.coprime_mul_iff_right]
    exact ⟨by decide, hpow⟩
  rw [hprod.lcm_eq_mul]
  ring

/-- The common CRT period in the `2 * 59 * 5^a` family is
`lcm (3) (lcm (4 * 5^a) 58) = 348 * 5^a`.

This is the arithmetic CRT component used by the coherent-transport
five-power orbit calculation. -/
private theorem fibonacci_transport_five_power_crt_lcm (a : ℕ) :
    Nat.lcm (Nat.lcm 3 (4 * 5 ^ a)) 58 = 348 * 5 ^ a := by
  rw [lcm_three_four_five_power]
  have hfactor : Nat.lcm (12 * 5 ^ a) 58 =
      Nat.lcm (2 * (6 * 5 ^ a)) (2 * 29) := by
    congr 1 <;> ring
  rw [hfactor]
  rw [← lcm_eq_nat_lcm, lcm_mul_left]
  simp only [normalize_eq, lcm_eq_nat_lcm]
  rw [coprime_six_five_power_twenty_nine a |>.lcm_eq_mul]
  ring


end D5.S3.Arith.FibonacciTransportFivePowerOrbit
