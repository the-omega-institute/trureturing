/- GID: D5/S3/PrimeForms/Splitting/QuadraticCharacterProfileRedundancy
   generality: G
   mirror-B: D5/B/S3/PrimeForms/Splitting/QuadraticCharacterProfileRedundancy
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Every quadratic character modulo sixty is generated by the three splitting readings. -/

import D5.S3.Factorization.Galois.QuadraticObservationBound
import D5.S3.PrimeForms.Splitting.ThreeRingProfileFibers

/- Library-search audit trail (2026-08-26):
   * The frozen three-ring profile supplies the source Gaussian, Eisenstein,
     and golden readings and the exact two-element fibers on `(ZMod 60)ˣ`.
   * The frozen quadratic-observation family supplies the canonical
     multiplicative binary-character carrier `QuadraticObserver`.
   * Repository searches found general character-span redundancy theorems on
     the additive `ModN` dual, but no exact theorem on this mod-sixty carrier.
   * Pinned Mathlib searches found finite homomorphism and `ZMod` machinery,
     but no packaged enumeration of the three named splitting characters. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.PrimeForms.Splitting.QuadraticCharacterProfileRedundancy

open D5.S3.Factorization.Galois.QuadraticObservationBound
open D5.S3.PrimeForms.Splitting.ThreeRingProfileFibers

/-- Convert a split/inert reading to the multiplicative binary value, with
split represented by the identity and inert by the nonidentity value. -/
def splitReadingBit : SplitReading -> QuadraticBit
  | .split => 1
  | .inert => Multiplicative.ofAdd 1

/-- The quadratic character carried by the Gaussian reading modulo four. -/
def gaussianCharacter : QuadraticObserver ((ZMod 60)ˣ) where
  toFun u := splitReadingBit (gaussianReading u)
  map_one' := by decide
  map_mul' := by
    set_option maxRecDepth 100000 in
      decide

/-- The quadratic character carried by the Eisenstein reading modulo three. -/
def eisensteinCharacter : QuadraticObserver ((ZMod 60)ˣ) where
  toFun u := splitReadingBit (eisensteinReading u)
  map_one' := by decide
  map_mul' := by
    set_option maxRecDepth 100000 in
      decide

/-- The quadratic character carried by the golden reading modulo five. -/
def goldenCharacter : QuadraticObserver ((ZMod 60)ˣ) where
  toFun u := splitReadingBit (goldenReading u)
  map_one' := by decide
  map_mul' := by
    set_option maxRecDepth 100000 in
      decide

private def gaussianGenerator : (ZMod 60)ˣ :=
  ZMod.unitOfCoprime 19 (by decide)

private def eisensteinGenerator : (ZMod 60)ˣ :=
  ZMod.unitOfCoprime 29 (by decide)

private def goldenGenerator : (ZMod 60)ˣ :=
  ZMod.unitOfCoprime 13 (by decide)

private theorem binary_value_reconstruction (z : QuadraticBit) :
    Multiplicative.ofAdd (1 : ZMod 2) ^ (Multiplicative.toAdd z).val = z := by
  fin_cases z <;> decide

private theorem character_generator_values :
    gaussianCharacter gaussianGenerator = Multiplicative.ofAdd (1 : ZMod 2) ∧
      eisensteinCharacter gaussianGenerator = 1 ∧
      goldenCharacter gaussianGenerator = 1 ∧
      gaussianCharacter eisensteinGenerator = 1 ∧
      eisensteinCharacter eisensteinGenerator = Multiplicative.ofAdd (1 : ZMod 2) ∧
      goldenCharacter eisensteinGenerator = 1 ∧
      gaussianCharacter goldenGenerator = 1 ∧
      eisensteinCharacter goldenGenerator = 1 ∧
      goldenCharacter goldenGenerator = Multiplicative.ofAdd (1 : ZMod 2) := by
  decide

private theorem unit_decomposition :
    ∀ u : (ZMod 60)ˣ,
      ∃ a : ZMod 2, ∃ b : ZMod 2, ∃ c : ZMod 4,
        u = gaussianGenerator ^ a.val * eisensteinGenerator ^ b.val *
          goldenGenerator ^ c.val := by
  set_option maxRecDepth 100000 in
    decide

private theorem quadratic_observer_ext_on_generators
    (left right : QuadraticObserver ((ZMod 60)ˣ))
    (hGaussian : left gaussianGenerator = right gaussianGenerator)
    (hEisenstein : left eisensteinGenerator = right eisensteinGenerator)
    (hGolden : left goldenGenerator = right goldenGenerator) :
    left = right := by
  ext u
  obtain ⟨a, b, c, rfl⟩ := unit_decomposition u
  simp only [map_mul, map_pow, hGaussian, hEisenstein, hGolden]

/-- Every quadratic character of the units modulo sixty is a pointwise product
of the Gaussian, Eisenstein, and golden characters. Consequently it is constant
on every three-ring profile fiber, whose cardinality remains exactly two. -/
theorem quadratic_characters_are_three_ring_products_and_fiber_redundant :
    (∀ extra : QuadraticObserver ((ZMod 60)ˣ),
      ∃ coefficients : Fin 3 -> ZMod 2,
        ∀ u : (ZMod 60)ˣ,
          extra u =
            gaussianCharacter u ^ (coefficients 0).val *
              eisensteinCharacter u ^ (coefficients 1).val *
                goldenCharacter u ^ (coefficients 2).val) ∧
      (∀ extra : QuadraticObserver ((ZMod 60)ˣ),
        ∀ u v : (ZMod 60)ˣ,
          triRingImage u = triRingImage v -> extra u = extra v) ∧
      ∀ profile,
        Fintype.card {u : (ZMod 60)ˣ // triRingImage u = profile} = 2 := by
  have productClause :
      ∀ extra : QuadraticObserver ((ZMod 60)ˣ),
        ∃ coefficients : Fin 3 -> ZMod 2,
          ∀ u : (ZMod 60)ˣ,
            extra u =
              gaussianCharacter u ^ (coefficients 0).val *
                eisensteinCharacter u ^ (coefficients 1).val *
                  goldenCharacter u ^ (coefficients 2).val := by
    intro extra
    let coefficients : Fin 3 -> ZMod 2 := ![
      Multiplicative.toAdd (extra gaussianGenerator),
      Multiplicative.toAdd (extra eisensteinGenerator),
      Multiplicative.toAdd (extra goldenGenerator)]
    let combined : QuadraticObserver ((ZMod 60)ˣ) :=
      gaussianCharacter ^ (coefficients 0).val *
        eisensteinCharacter ^ (coefficients 1).val *
          goldenCharacter ^ (coefficients 2).val
    rcases character_generator_values with
      ⟨hGG, hEG, hGoldG, hGE, hEE, hGoldE, hGGold, hEGold, hGoldGold⟩
    have hGaussian : extra gaussianGenerator = combined gaussianGenerator := by
      simp only [combined, MonoidHom.mul_apply, MonoidHom.pow_apply,
        hGG, hEG, hGoldG, one_pow, mul_one]
      exact (binary_value_reconstruction (extra gaussianGenerator)).symm
    have hEisenstein : extra eisensteinGenerator = combined eisensteinGenerator := by
      simp only [combined, MonoidHom.mul_apply, MonoidHom.pow_apply,
        hGE, hEE, hGoldE, one_pow, one_mul, mul_one]
      exact (binary_value_reconstruction (extra eisensteinGenerator)).symm
    have hGolden : extra goldenGenerator = combined goldenGenerator := by
      simp only [combined, MonoidHom.mul_apply, MonoidHom.pow_apply,
        hGGold, hEGold, hGoldGold, one_pow, one_mul]
      exact (binary_value_reconstruction (extra goldenGenerator)).symm
    have hCombined : extra = combined :=
      quadratic_observer_ext_on_generators extra combined
        hGaussian hEisenstein hGolden
    refine ⟨coefficients, fun u => ?_⟩
    have hAtU := congrArg (fun character => character u) hCombined
    simpa only [combined, MonoidHom.mul_apply, MonoidHom.pow_apply] using hAtU
  refine ⟨productClause, ?_,
    tri_ring_image_surjective_with_fibers_of_card_two.2⟩
  intro extra u v hProfile
  obtain ⟨coefficients, hExtra⟩ := productClause extra
  have hGaussianReading : gaussianReading u = gaussianReading v := by
    have := congrArg ThreeRingProfile.gaussian hProfile
    simpa only [triRingImage] using this
  have hEisensteinReading : eisensteinReading u = eisensteinReading v := by
    have := congrArg ThreeRingProfile.eisenstein hProfile
    simpa only [triRingImage] using this
  have hGoldenReading : goldenReading u = goldenReading v := by
    have := congrArg ThreeRingProfile.golden hProfile
    simpa only [triRingImage] using this
  have hGaussianCharacter : gaussianCharacter u = gaussianCharacter v :=
    congrArg splitReadingBit hGaussianReading
  have hEisensteinCharacter : eisensteinCharacter u = eisensteinCharacter v :=
    congrArg splitReadingBit hEisensteinReading
  have hGoldenCharacter : goldenCharacter u = goldenCharacter v :=
    congrArg splitReadingBit hGoldenReading
  rw [hExtra u, hExtra v, hGaussianCharacter, hEisensteinCharacter,
    hGoldenCharacter]

#print axioms quadratic_characters_are_three_ring_products_and_fiber_redundant

end D5.S3.PrimeForms.Splitting.QuadraticCharacterProfileRedundancy
