/- GID: D5/S3/Quantum/Petz/OrderedMixingReduction
   generality: G
   mirror-B: none(waiver:formal-unit-only)
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Nonnegative pair directional derivatives imply monotonicity under finite majorization. -/
import D5.S3.Quantum.Petz.MixingIteration
import Mathlib.Analysis.Calculus.Deriv.MeanValue
import Mathlib.Analysis.Calculus.Deriv.Prod
import Mathlib.Tactic

open Set BigOperators

namespace D5.S3.Quantum.Petz.OrderedMixingReduction

open D5.S3.Quantum.Petz.MixingIteration

/-- The coordinate direction `eᵢ - eⱼ`, for distinct indices. -/
def pairDirection {n : ℕ} (i j : Fin n) : Fin n → ℝ :=
  fun a => if a = i then 1 else if a = j then -1 else 0

private theorem transfer_affine {n : ℕ} (x : Fin n → ℝ) (i j : Fin n)
    (hij : i ≠ j) (s t : ℝ) :
    transfer x i j s = fun a => transfer x i j t a +
      ((s - t) * (x j - x i)) * pairDirection i j a := by
  funext a
  by_cases hai : a = i
  · subst a
    simp [transfer, pairDirection]
    ring
  · by_cases haj : a = j
    · subst a
      simp [transfer, pairDirection, hij.symm]
      ring
    · simp [transfer, pairDirection, hai, haj]

private theorem transfer_positive {n : ℕ} (x : Fin n → ℝ)
    (hx : ∀ a, 0 < x a) (i j : Fin n) {t : ℝ}
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1 / 2) : ∀ a, 0 < transfer x i j t a := by
  intro a
  have h1 : 0 < 1 - t := by linarith
  have hi := hx i
  have hj := hx j
  have hi0 : 0 ≤ t * x i := mul_nonneg ht0 hi.le
  have hj0 : 0 ≤ t * x j := mul_nonneg ht0 hj.le
  by_cases hai : a = i
  · simp only [transfer, if_pos hai]
    exact add_pos_of_pos_of_nonneg (mul_pos h1 hi) hj0
  · by_cases haj : a = j
    · simp only [transfer, if_neg hai, if_pos haj]
      exact add_pos_of_nonneg_of_pos hi0 (mul_pos h1 hj)
    · simpa [transfer, hai, haj] using hx a

/-- Continuity at the half-transfer endpoint and nonnegative unit directional
derivatives at strictly ordered positive pairs suffice for every mixing step. -/
private theorem pair_transfer_mono_of_directional_derivative {n : ℕ}
    (S : (Fin n → ℝ) → ℝ)
    (hcont : ∀ x : Fin n → ℝ, (∀ a, 0 < x a) → ∀ i j, i ≠ j →
      ContinuousOn (fun t => S (transfer x i j t)) (Icc 0 (1 / 2)))
    (hdir : ∀ x : Fin n → ℝ, (∀ a, 0 < x a) → ∀ i j, i ≠ j → x i < x j →
      ∃ d : ℝ, HasDerivAt
        (fun r => S (fun a => x a + r * pairDirection i j a)) d 0 ∧ 0 ≤ d)
    (x : Fin n → ℝ) (hx : ∀ a, 0 < x a) (i j : Fin n)
    (hij : i ≠ j) (horder : x i < x j) (t : ℝ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1 / 2) :
    S x ≤ S (transfer x i j t) := by
  have hd : ∀ u ∈ Ioo (0 : ℝ) (1 / 2),
      ∃ d : ℝ, HasDerivAt (fun s => S (transfer x i j s)) d u ∧ 0 ≤ d := by
    intro u hu
    have hpositive := transfer_positive x hx i j hu.1.le hu.2.le
    have hordered : transfer x i j u i < transfer x i j u j := by
      simp [transfer, hij.symm]
      nlinarith [mul_pos (show 0 < 1 - 2 * u by linarith [hu.2]) (sub_pos.mpr horder)]
    obtain ⟨d, hderiv, hd0⟩ := hdir (transfer x i j u) hpositive i j hij hordered
    have ha : HasDerivAt (fun s : ℝ => (s - u) * (x j - x i)) (x j - x i) u := by
      simpa using ((hasDerivAt_id u).sub_const u).mul_const (x j - x i)
    have hcomp := hderiv.comp_of_eq u ha (by simp)
    refine ⟨d * (x j - x i), ?_, mul_nonneg hd0 (sub_pos.mpr horder).le⟩
    have heq : (fun s => S (fun a => transfer x i j u a +
        ((s - u) * (x j - x i)) * pairDirection i j a)) =
        (fun s => S (transfer x i j s)) := by
      funext s
      rw [← transfer_affine x i j hij s u]
    simpa only [Function.comp_def, heq] using hcomp
  have hmono : MonotoneOn (fun s => S (transfer x i j s)) (Icc 0 (1 / 2)) := by
    apply monotoneOn_of_deriv_nonneg (convex_Icc _ _) (hcont x hx i j hij)
    · intro u hu
      rw [interior_Icc] at hu
      exact (hd u hu).choose_spec.1.differentiableAt.differentiableWithinAt
    · intro u hu
      rw [interior_Icc] at hu
      obtain ⟨d, hd, hd0⟩ := hd u hu
      rwa [hd.deriv]
  have hzero : transfer x i j 0 = x := by
    funext a
    by_cases hai : a = i
    · subst a; simp [transfer]
    · by_cases haj : a = j
      · subst a; simp [transfer, hai]
      · simp [transfer, hai, haj]
  simpa only [hzero] using hmono (by constructor <;> norm_num) ⟨ht0, ht1⟩ ht0

/-- Finite prefix majorization is generated by permutations and positive
two-coordinate transfers. The initial vector need not be sorted. -/
theorem pair_transfer_reduction {n : ℕ} (S : (Fin n → ℝ) → ℝ)
    (hperm : ∀ x (σ : Equiv.Perm (Fin n)), S (x ∘ σ) = S x)
    (hstep : ∀ x, (∀ a, 0 < x a) → ∀ i j, i ≠ j → x i < x j →
      ∀ t : ℝ, 0 ≤ t → t ≤ 1 / 2 → S x ≤ S (transfer x i j t))
    (x y : Fin n → ℝ) (hx : ∀ a, 0 < x a) (hy : ∀ a, 0 < y a)
    (hys : Antitone y) (hsum : ∑ a, x a = ∑ a, y a)
    (hprefix : ∀ r, r ≤ n → prefixSum y r ≤ prefixSum x r) : S x ≤ S y :=
  MixingIteration.pair_transfer_reduction S hperm hstep x y hx hy hys hsum hprefix

/-- A derivative criterion for Schur concavity: permutation invariance,
differentiability on pair-transfer paths, and nonnegative derivatives in
`eᵢ - eⱼ` when the `i` coordinate is smaller imply majorization monotonicity. -/
theorem derivative_pair_transfer_reduction {n : ℕ} (S : (Fin n → ℝ) → ℝ)
    (hperm : ∀ x (σ : Equiv.Perm (Fin n)), S (x ∘ σ) = S x)
    (hpath : ∀ x : Fin n → ℝ, (∀ a, 0 < x a) → ∀ i j, i ≠ j →
      ∀ t ∈ Icc (0 : ℝ) (1 / 2),
        DifferentiableAt ℝ (fun r => S (transfer x i j r)) t)
    (hdir : ∀ x : Fin n → ℝ, (∀ a, 0 < x a) → ∀ i j, i ≠ j → x i < x j →
      ∃ d : ℝ, HasDerivAt
        (fun r => S (fun a => x a + r * pairDirection i j a)) d 0 ∧ 0 ≤ d)
    (x y : Fin n → ℝ) (hx : ∀ a, 0 < x a) (hy : ∀ a, 0 < y a)
    (hys : Antitone y) (hsum : ∑ a, x a = ∑ a, y a)
    (hprefix : ∀ r, r ≤ n → prefixSum y r ≤ prefixSum x r) : S x ≤ S y := by
  apply pair_transfer_reduction S hperm _ x y hx hy hys hsum hprefix
  intro z hz i j hij horder t ht0 ht1
  apply pair_transfer_mono_of_directional_derivative S _ hdir z hz i j hij horder t ht0 ht1
  intro w hw a b hab u hu
  exact (hpath w hw a b hab u hu).continuousAt.continuousWithinAt

end D5.S3.Quantum.Petz.OrderedMixingReduction
