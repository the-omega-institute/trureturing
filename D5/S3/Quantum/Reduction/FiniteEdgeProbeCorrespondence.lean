/- GID: D5/S3/Quantum/Reduction/FiniteEdgeProbeCorrespondence
   generality: G
   mirror-B: D5/B/S3/Quantum/Reduction/FiniteEdgeProbeCorrespondence
   mirror-E: none(waiver:finite-dimensional-argument)
   anchors: []
   utility: none
   digest: Labelled endpoint probes realize exact Hilbert component coordinates. -/

import D5.S3.Quantum.Reduction.OrthogonalCoherentEmbedding
import D5.S3.QuantumBounds.CHSHWitness
import Mathlib.LinearAlgebra.StdBasis
import Mathlib.LinearAlgebra.Dimension.Constructions

/-! Vertex and labelled-edge probes, with exact component and coordinate correspondence. -/

noncomputable section
attribute [local instance] Classical.propDecidable
open Matrix
namespace D5.S3.Quantum.Reduction.FiniteEdgeProbeCorrespondence
set_option autoImplicit false
set_option relaxedAutoImplicit false
open D5.S3.Quantum.Reduction.ProbeGraphDecomposition

/-- Orientation-free connectivity generated by the original edge labels. -/
def Connected {V E : Type*} (u v : E → V) : V → V → Prop :=
  Relation.EqvGen (fun a b => ∃ e, u e = a ∧ v e = b)

/-- Every vertex remains an index, and every edge label remains a separate index. -/
def anchor {V E : Type*} (u : E → V) : V ⊕ E → V := Sum.elim id u

/-- Loops contribute one basis vector, rather than an incorrectly normalized sum. -/
def probes {V E : Type*} [DecidableEq V] (u v : E → V) : V ⊕ E → V → ℂ
  | .inl a => Pi.single a 1
  | .inr e => if u e = v e then Pi.single (u e) 1 else
      (Real.sqrt 2 : ℂ)⁻¹ • (Pi.single (u e) 1 + Pi.single (v e) 1)

/-- Coordinate subspace on precisely the vertices connected to a. -/
def coordinates {V E : Type*} [Fintype V] (u v : E → V) (a : V) :
    Submodule ℂ (EuclideanSpace ℂ V) :=
  (Pi.spanSubset ℂ {b | Connected u v a b}).map
    (WithLp.linearEquiv 2 ℂ (V → ℂ)).symm.toLinearMap

private theorem support_connected {V E : Type*} [DecidableEq V] (u v : E → V)
    (j : V ⊕ E) (a : V) (h : probes u v j a ≠ 0) :
    Connected u v (anchor u j) a := by
  classical
  cases j with
  | inl b =>
      by_cases hb : b = a
      · subst a; exact Relation.EqvGen.refl _
      · exact (h (by simp [probes, hb])).elim
  | inr e =>
      by_cases he : u e = v e
      · simp only [probes, ite_eq_left he] at h
        by_cases ha : u e = a
        · subst a; exact Relation.EqvGen.refl _
        · exact (h (by simp [ha])).elim
      · by_cases ha : u e = a
        · subst a; exact Relation.EqvGen.refl _
        · by_cases hb : v e = a
          · exact Relation.EqvGen.rel _ _ ⟨e, rfl, hb⟩
          · exact (h (by simp [probes, he, ha, hb])).elim

private theorem unit_probes {V E : Type*} [Fintype V] [DecidableEq V]
    (u v : E → V) (j : V ⊕ E) : star (probes u v j) ⬝ᵥ probes u v j = 1 := by
  classical
  cases j with
  | inl a => simp [probes]
  | inr e =>
      by_cases he : u e = v e
      · simp [probes, he]
      · norm_num [probes, he, star_smul, star_add, dotProduct_smul,
          dotProduct_add, Ne.symm he, smul_eq_mul,
          D5.S3.QuantumBounds.CHSHWitness.complex_sqrt_two_inv_mul_self]

private theorem vertex_edge {V E : Type*} [Fintype V] [DecidableEq V]
    (u v : E → V) (e : E) (a : V) (ha : a = u e ∨ a = v e) :
    star (probes u v (.inl a)) ⬝ᵥ probes u v (.inr e) ≠ 0 := by
  have hn : (Real.sqrt 2 : ℂ) ≠ 0 := by
    exact_mod_cast Real.sqrt_ne_zero'.mpr (by norm_num : (0 : ℝ) < 2)
  rcases ha with rfl | rfl <;> by_cases he : u e = v e <;>
    simp_all [probes, smul_eq_mul]

private theorem anchor_iff {V E : Type*} [Fintype V] [DecidableEq V]
    (u v : E → V) (i j : V ⊕ E) :
    Relation.EqvGen (fun k l => star (probes u v k) ⬝ᵥ probes u v l ≠ 0) i j ↔
      Connected u v (anchor u i) (anchor u j) := by
  classical
  let P := fun k l => star (probes u v k) ⬝ᵥ probes u v l ≠ 0
  have lift_edge (e : E) : Relation.EqvGen P (.inl (u e)) (.inl (v e)) :=
    .trans _ _ _ (.rel _ _ (vertex_edge u v e _ (Or.inl rfl)))
      (.symm _ _ (.rel _ _ (vertex_edge u v e _ (Or.inr rfl))))
  have lift_path {a b : V} (h : Connected u v a b) :
      Relation.EqvGen P (.inl a) (.inl b) := by
    induction h with
    | rel a b h => obtain ⟨e, rfl, rfl⟩ := h; exact lift_edge e
    | refl a => exact .refl _
    | symm a b h ih => exact .symm _ _ ih
    | trans a b c h1 h2 ih1 ih2 => exact .trans _ _ _ ih1 ih2
  have attach (k : V ⊕ E) : Relation.EqvGen P (.inl (anchor u k)) k := by
    cases k with
    | inl a => exact .refl _
    | inr e => exact .rel _ _ (vertex_edge u v e _ (Or.inl rfl))
  constructor
  · intro h
    induction h with
    | rel k l h =>
        have hw : ∃ a, star (probes u v k a) * probes u v l a ≠ 0 := by
          by_contra hn
          apply h
          apply Finset.sum_eq_zero
          intro a _
          exact not_not.mp (not_exists.mp hn a)
        obtain ⟨a, ha⟩ := hw
        have hk := support_connected u v k a (fun hz => ha (by simp [hz]))
        have hl := support_connected u v l a (fun hz => ha (by simp [hz]))
        exact .trans _ _ _ hk (.symm _ _ hl)
    | refl k => exact .refl _
    | symm k l h ih => exact .symm _ _ ih
    | trans k l m h1 h2 ih1 ih2 => exact .trans _ _ _ ih1 ih2
  · intro h
    exact .trans _ _ _ (.symm _ _ (attach i)) (.trans _ _ _ (lift_path h) (attach j))

/-- The explicit menu is normalized and spanning, its anchor identifies exactly
    the generated components, and its actual Hilbert components have the original
    graph coordinate spaces and vertex cardinalities. No finiteness of E or
    nonemptiness of V is required. -/
theorem construction {V E : Type*} [Fintype V] [DecidableEq V] (u v : E → V) :
    (∀ j, star (probes u v j) ⬝ᵥ probes u v j = 1) ∧
    Submodule.span ℂ (Set.range (probes u v)) = ⊤ ∧
    (∀ i j, Relation.EqvGen
      (fun k l => star (probes u v k) ⬝ᵥ probes u v l ≠ 0) i j ↔
        Connected u v (anchor u i) (anchor u j)) ∧
    (∀ j, hilbertComponent (probes u v) (component (probes u v) j) =
      coordinates u v (anchor u j)) ∧
    (∀ j, Module.finrank ℂ (hilbertComponent (probes u v) (component (probes u v) j)) =
      Fintype.card {a : V // Connected u v (anchor u j) a}) := by
  classical
  have hs : Submodule.span ℂ (Set.range (probes u v)) = ⊤ := by
    apply (Submodule.eq_top_iff_forall_basis_mem (Pi.basisFun ℂ V)).mpr
    intro a
    rw [Pi.basisFun_apply]
    exact Submodule.subset_span ⟨.inl a, rfl⟩
  have hc (j : V ⊕ E) : hilbertComponent (probes u v) (component (probes u v) j) =
      coordinates u v (anchor u j) := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨i, hi, rfl⟩
      apply Submodule.mem_map.mpr
      refine ⟨probes u v i, ?_, rfl⟩
      apply Pi.mem_spanSubset_iff.mpr
      intro a ha
      by_contra hn
      apply ha
      exact Relation.EqvGen.trans _ _ _
        ((anchor_iff u v j i).mp (Quotient.exact hi.symm)) (support_connected u v i a hn)
    · rw [coordinates, Pi.spanSubset, Submodule.map_span]
      apply Submodule.span_le.mpr
      rintro _ ⟨x, ⟨a, ha, rfl⟩, rfl⟩
      apply Submodule.subset_span
      refine ⟨.inl a, ?_, ?_⟩
      · exact Quotient.sound ((anchor_iff u v (.inl a) j).mpr (.symm _ _ ha))
      · simp [probes, Pi.basisFun_apply]
  refine ⟨unit_probes u v, hs, anchor_iff u v, hc, ?_⟩
  intro j
  rw [hc, coordinates, LinearEquiv.finrank_map_eq]
  rw [Pi.spanSubset, Set.image_eq_range]
  exact finrank_span_eq_card ((Pi.basisFun ℂ V).linearIndependent.comp
    Subtype.val Subtype.val_injective)

/-- Restricting to any subset containing the endpoints commutes with the
    equivalence closure of those endpoints. This is a proved carrier change. -/
theorem restricted_endpoint_closure {A E : Type*} (S : Set A)
    (u v : E → S) (a b : S) :
    Connected u v a b ↔ Connected (fun e => (u e).val) (fun e => (v e).val) a.val b.val := by
  classical
  have forward {x y : S} (h : Connected u v x y) :
      Connected (fun e => (u e).val) (fun e => (v e).val) x.val y.val := by
    induction h with
    | rel x y h =>
        obtain ⟨e, rfl, rfl⟩ := h
        exact .rel _ _ ⟨e, rfl, rfl⟩
    | refl x => exact .refl _
    | symm x y h ih => exact .symm _ _ ih
    | trans x y z h1 h2 ih1 ih2 => exact .trans _ _ _ ih1 ih2
  refine ⟨forward, ?_⟩
  let retract : A → S := fun x => if h : x ∈ S then ⟨x, h⟩ else a
  have fixes (x : S) : retract x.val = x := by simp [retract, x.property]
  intro h
  have lift {x y : A}
      (h : Connected (fun e => (u e).val) (fun e => (v e).val) x y) :
      Connected u v (retract x) (retract y) := by
    induction h with
    | rel x y h =>
        obtain ⟨e, rfl, rfl⟩ := h
        rw [fixes, fixes]
        exact .rel _ _ ⟨e, rfl, rfl⟩
    | refl x => exact .refl _
    | symm x y h ih => exact .symm _ _ ih
    | trans x y z h1 h2 ih1 ih2 => exact .trans _ _ _ ih1 ih2
  simpa only [fixes] using lift h

#print axioms construction
#print axioms restricted_endpoint_closure
end D5.S3.Quantum.Reduction.FiniteEdgeProbeCorrespondence
