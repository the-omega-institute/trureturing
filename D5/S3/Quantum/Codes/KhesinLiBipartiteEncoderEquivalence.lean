/-- Exactly output permutations, input permutations, and additions of distinct input rows. -/
def BipartiteStep {k n : ℕ} (G H : SimpleGraph (Fin k ⊕ Fin n)) : Prop :=
  (∃ σ : Equiv.Perm (Fin n),
    H = G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding) ∨
  (∃ τ : Equiv.Perm (Fin k),
    H = G.map (Equiv.sumCongr τ (Equiv.refl (Fin n))).toEmbedding) ∨
  (∃ i j : Fin k, i ≠ j ∧ H = addInputRow G i j)

/-- Conjecture 8.3 for the equivalence generated by the frozen encoder operations. -/
def claim : Prop :=
  ∀ k n : ℕ, ∀ G H : SimpleGraph (Fin k ⊕ Fin n),
    G.IsBipartiteWith {v | v.isLeft} {v | v.isRight} →
      H.IsBipartiteWith {v | v.isLeft} {v | v.isRight} → Relation.EqvGen Step G H →
      Relation.ReflTransGen BipartiteStep G H

private noncomputable def biadjacency {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n)) :
    Matrix (Fin k) (Fin n) (ZMod 2) := by
  classical
  exact (cut G (Finset.univ.map Function.Embedding.inl)).submatrix
    (fun i => ⟨Sum.inl i, Finset.mem_map.mpr ⟨i, Finset.mem_univ _, rfl⟩⟩)
    (fun a => ⟨Sum.inr a, by simp⟩)

private theorem entropy_output_map {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (σ : Equiv.Perm (Fin n)) (S : Finset (Fin n)) :
    entropy (G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding)
      (S.map Function.Embedding.inr) =
      entropy G ((S.image σ.symm).map Function.Embedding.inr) := by
  rw [← SimpleGraph.comap_symm]
  change entropy (G.comap (Equiv.sumCongr (Equiv.refl (Fin k)) σ).symm)
    (S.map Function.Embedding.inr) = _
  rw [relabel]
  congr 1
  ext x
  cases x with
  | inl a => simp
  | inr a =>
    have he : σ a ∈ S ↔ ∃ b ∈ S, σ.symm b = a := by
      simpa only [Finset.mem_map, Equiv.symm_symm, Equiv.coe_toEmbedding] using
        (Finset.mem_map_equiv (s := S) (f := σ.symm) (b := a)).symm
    simpa using he

private theorem add_row_adjacencies {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (i j : Fin k) :
    (∀ a b : Fin k, (addInputRow G i j).Adj (Sum.inl a) (Sum.inl b) ↔
      G.Adj (Sum.inl a) (Sum.inl b)) ∧
    (∀ a b : Fin n, (addInputRow G i j).Adj (Sum.inr a) (Sum.inr b) ↔
      G.Adj (Sum.inr a) (Sum.inr b)) ∧
    (∀ (a : Fin k) (b : Fin n), (addInputRow G i j).Adj (Sum.inl a) (Sum.inr b) ↔
      if a = i then Xor (G.Adj (Sum.inl i) (Sum.inr b))
        (G.Adj (Sum.inl j) (Sum.inr b)) else G.Adj (Sum.inl a) (Sum.inr b)) := by
  constructor
  · intro a b
    change (_ ≠ _ ∧ (G.Adj (Sum.inl a) (Sum.inl b) ∨ G.Adj (Sum.inl b) (Sum.inl a))) ↔ _
    rw [G.adj_comm (Sum.inl b) (Sum.inl a), or_self]
    exact and_iff_right_of_imp G.ne_of_adj
  constructor
  · intro a b
    change (_ ≠ _ ∧ (G.Adj (Sum.inr a) (Sum.inr b) ∨ G.Adj (Sum.inr b) (Sum.inr a))) ↔ _
    rw [G.adj_comm (Sum.inr b) (Sum.inr a), or_self]
    exact and_iff_right_of_imp G.ne_of_adj
  · intro a b
    change ((Sum.inl a : Fin k ⊕ Fin n) ≠ Sum.inr b ∧ (_ ∨ _)) ↔ _
    change ((Sum.inl a : Fin k ⊕ Fin n) ≠ Sum.inr b ∧
      ((if a = i then _ else G.Adj (Sum.inl a) (Sum.inr b)) ∨
        (if a = i then _ else G.Adj (Sum.inr b) (Sum.inl a)))) ↔ _
    rw [G.adj_comm (Sum.inr b) (Sum.inl a), or_self]
    exact and_iff_right (Sum.inl_ne_inr)

private theorem add_row_bipartite {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (hG : G.IsBipartiteWith {v | v.isLeft} {v | v.isRight}) (i j : Fin k) : (addInputRow G i j).IsBipartiteWith {v | v.isLeft} {v | v.isRight} := by
  refine ⟨hG.disjoint, ?_⟩
  intro x y hxy
  cases x with
  | inl a =>
    cases y with
    | inl b =>
      simpa using hG.mem_of_adj ((add_row_adjacencies G i j).1 a b |>.mp hxy)
    | inr b => simp
  | inr a =>
    cases y with
    | inl b => simp
    | inr b =>
      simpa using hG.mem_of_adj ((add_row_adjacencies G i j).2.1 a b |>.mp hxy)

private theorem add_row_matrix {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (i j : Fin k) :
    biadjacency (addInputRow G i j) = Matrix.transvection i j (1 : ZMod 2) * biadjacency G := by
  classical
  ext a b
  by_cases ha : a = i
  · subst a
    rw [Matrix.transvection_mul_apply_same]
    change (if (addInputRow G i j).Adj (Sum.inl i) (Sum.inr b) then (1 : ZMod 2) else 0) =
      (if G.Adj (Sum.inl i) (Sum.inr b) then 1 else 0) +
        1 * (if G.Adj (Sum.inl j) (Sum.inr b) then 1 else 0)
    rw [(add_row_adjacencies G i j).2.2, ite_eq_left rfl]
    by_cases h1 : G.Adj (Sum.inl i) (Sum.inr b) <;>
      by_cases h2 : G.Adj (Sum.inl j) (Sum.inr b) <;>
      simp [h1, h2, Xor, CharTwo.add_self_eq_zero]
  · rw [Matrix.transvection_mul_apply_of_ne i j a b ha]
    change (if (addInputRow G i j).Adj (Sum.inl a) (Sum.inr b) then (1 : ZMod 2) else 0) =
      if G.Adj (Sum.inl a) (Sum.inr b) then 1 else 0
    rw [(add_row_adjacencies G i j).2.2, ite_eq_right ha]

private theorem bipartite_ext {k n : ℕ} (G H : SimpleGraph (Fin k ⊕ Fin n))
    (hG : G.IsBipartiteWith {v | v.isLeft} {v | v.isRight}) (hH : H.IsBipartiteWith {v | v.isLeft} {v | v.isRight})
    (h : biadjacency G = biadjacency H) : G = H := by
  classical
  have hc (a : Fin k) (b : Fin n) : G.Adj (Sum.inl a) (Sum.inr b) ↔
      H.Adj (Sum.inl a) (Sum.inr b) := by
    have he := congrFun (congrFun h a) b
    change (if G.Adj (Sum.inl a) (Sum.inr b) then (1 : ZMod 2) else 0) =
      (if H.Adj (Sum.inl a) (Sum.inr b) then 1 else 0) at he
    by_cases h1 : G.Adj (Sum.inl a) (Sum.inr b) <;>
      by_cases h2 : H.Adj (Sum.inl a) (Sum.inr b) <;> simp_all
  ext x y
  cases x with
  | inl a =>
    cases y with
    | inl b =>
      exact iff_of_false
        (fun (h : G.Adj (Sum.inl a) (Sum.inl b)) => by simpa using hG.mem_of_adj h)
        (fun (h : H.Adj (Sum.inl a) (Sum.inl b)) => by simpa using hH.mem_of_adj h)
    | inr b => exact hc a b
  | inr a =>
    cases y with
    | inl b => rw [G.adj_comm, H.adj_comm]; exact hc b a
    | inr b =>
      exact iff_of_false
        (fun (h : G.Adj (Sum.inr a) (Sum.inr b)) => by simpa using hG.mem_of_adj h)
        (fun (h : H.Adj (Sum.inr a) (Sum.inr b)) => by simpa using hH.mem_of_adj h)

private theorem entropy_row {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (i j : Fin k) (hij : i ≠ j) (S : Finset (Fin n)) :
    entropy (addInputRow G i j) (S.map Function.Embedding.inr) =
      entropy G (S.map Function.Embedding.inr) := by
  classical
  let A := S.map (Function.Embedding.inr : Fin n ↪ Fin k ⊕ Fin n)
  have hi (q : Fin k) : Sum.inl q ∉ A := by
    exact Finset.disjoint_left.mp
      (Finset.disjoint_map_inl_map_inr Finset.univ S)
      (Finset.mem_map.mpr ⟨_, Finset.mem_univ _, rfl⟩)
  let ci : {x // x ∉ A} := ⟨Sum.inl i, hi i⟩
  let cj : {x // x ∉ A} := ⟨Sum.inl j, hi j⟩
  have hne : cj ≠ ci := fun h => hij (Sum.inl.inj (congrArg Subtype.val h)).symm
  have hm : cut (addInputRow G i j) A =
      cut G A * Matrix.transvection cj ci (1 : ZMod 2) := by
    ext a b
    obtain ⟨o, _, ho⟩ := Finset.mem_map.mp a.2
    have ha : a.1 = Sum.inr o := ho.symm
    by_cases hb : b = ci
    · subst b
      rw [Matrix.mul_transvection_apply_same]
      simp only [cut, Matrix.submatrix_apply, SimpleGraph.adjMatrix_apply, ci, cj, ha]
      rw [(addInputRow G i j).adj_comm,
        (add_row_adjacencies G i j).2.2, ite_eq_left rfl]
      rw [G.adj_comm (Sum.inr o) (Sum.inl i), G.adj_comm (Sum.inr o) (Sum.inl j)]
      by_cases h1 : G.Adj (Sum.inl i) (Sum.inr o) <;>
        by_cases h2 : G.Adj (Sum.inl j) (Sum.inr o) <;>
        simp [h1, h2, Xor, CharTwo.add_self_eq_zero]
    · rw [Matrix.mul_transvection_apply_of_ne cj ci a b hb]
      simp only [cut, Matrix.submatrix_apply, SimpleGraph.adjMatrix_apply, ha]
      cases hx : b.1 with
      | inl q =>
        have hq : q ≠ i := fun h => hb (Subtype.ext (hx.trans (congrArg Sum.inl h)))
        rw [(addInputRow G i j).adj_comm,
          (add_row_adjacencies G i j).2.2, ite_eq_right hq, G.adj_comm]
      | inr q => rw [(add_row_adjacencies G i j).2.1]
  change (cut (addInputRow G i j) A).rank = (cut G A).rank
  rw [hm, Matrix.rank_mul_eq_left_of_isUnit_det _ _]
  rw [Matrix.det_transvection_of_ne _ _ hne]
  exact isUnit_one

private theorem step_profile {k n : ℕ} {G H : SimpleGraph (Fin k ⊕ Fin n)}
    (h : Step G H) : ∃ σ : Equiv.Perm (Fin n), ∀ S : Finset (Fin n),
      entropy H (S.map Function.Embedding.inr) =
        entropy G ((S.image σ).map Function.Embedding.inr) := by
  classical
  cases h with
  | complement v =>
    refine ⟨Equiv.refl _, ?_⟩
    intro S
    rw [← lc_source, lc_eq]
    simp only [Equiv.coe_refl, Finset.image_id]
  | permuteOutputs σ => exact ⟨σ.symm, entropy_output_map G σ⟩
  | permuteInputs τ =>
    refine ⟨Equiv.refl _, ?_⟩
    intro S
    rw [← SimpleGraph.comap_symm]
    change entropy (G.comap (Equiv.sumCongr τ (Equiv.refl (Fin n))).symm)
      (S.map Function.Embedding.inr) = _
    rw [relabel]
    congr 1
    ext x
    cases x <;> simp
  | rowOperation i j hij =>
    refine ⟨Equiv.refl _, ?_⟩
    intro S
    rw [entropy_row G i j hij S]
    simp only [Equiv.coe_refl, Finset.image_id]
  | removeInputEdge i j =>
    refine ⟨Equiv.refl _, ?_⟩
    intro S
    simp only [Equiv.coe_refl, Finset.image_id]
    change (cut _ _).rank = (cut G _).rank
    congr 1
    ext a b
    obtain ⟨o, _, ho⟩ := Finset.mem_map.mp a.2
    simp only [cut, Matrix.submatrix_apply, SimpleGraph.adjMatrix_apply,
      SimpleGraph.deleteEdges_adj, ← ho, Set.mem_singleton_iff, Sym2.eq_iff,
      Function.Embedding.inr_apply, Sum.inr_ne_inl, false_and, false_or,
      not_false_eq_true, and_true]

private theorem equivalence_profile {k n : ℕ} (G H : SimpleGraph (Fin k ⊕ Fin n))
    (h : Relation.EqvGen Step G H) :
    ∃ σ : Equiv.Perm (Fin n), ∀ S : Finset (Fin n),
      entropy H (S.map Function.Embedding.inr) =
        entropy (G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding)
          (S.map Function.Embedding.inr) := by
  classical
  have hp : ∀ {J K : SimpleGraph (Fin k ⊕ Fin n)}, Relation.EqvGen Step J K →
      ∃ σ : Equiv.Perm (Fin n), ∀ S : Finset (Fin n),
        entropy K (S.map Function.Embedding.inr) =
          entropy J ((S.image σ).map Function.Embedding.inr) := by
    intro J K hJK
    induction hJK with
    | rel J K hJK => exact step_profile hJK
    | refl J => exact ⟨Equiv.refl _, fun S => by simp⟩
    | symm J K _ hJK =>
      obtain ⟨σ, hσ⟩ := hJK
      refine ⟨σ.symm, ?_⟩
      intro S
      have he := hσ (S.image σ.symm)
      rw [Finset.image_image, σ.self_comp_symm, Finset.image_id] at he
      exact he.symm
    | trans J K L _ _ hJK hKL =>
      obtain ⟨σ, hσ⟩ := hJK
      obtain ⟨τ, hτ⟩ := hKL
      refine ⟨τ.trans σ, ?_⟩
      intro S
      rw [hτ S, hσ (S.image τ), Finset.image_image]
      rfl
  obtain ⟨σ, hσ⟩ := hp h
  refine ⟨σ.symm, ?_⟩
  intro S
  rw [entropy_output_map, Equiv.symm_symm]
  exact hσ S

private theorem permute_bipartite {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (hG : G.IsBipartiteWith {v | v.isLeft} {v | v.isRight}) (σ : Equiv.Perm (Fin n)) :
    (G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding).IsBipartiteWith
      {v | v.isLeft} {v | v.isRight} := by
  rw [← SimpleGraph.comap_symm]
  refine ⟨hG.disjoint, ?_⟩
  intro x y hxy
  cases x <;> cases y <;> simpa using hG.mem_of_adj hxy

private theorem bipartite_profile {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (hG : G.IsBipartiteWith {v | v.isLeft} {v | v.isRight}) (S : Finset (Fin n)) :
    entropy G (S.map Function.Embedding.inr) =
      ((biadjacency G).submatrix id (fun a : S => (a : Fin n))).rank := by
  classical
  let A := S.map (Function.Embedding.inr : Fin n ↪ Fin k ⊕ Fin n)
  let r : S ≃ {x // x ∈ A} :=
    Finset.equivMap (Function.Embedding.inr : Fin n ↪ Fin k ⊕ Fin n) S
  let M := (cut G A).submatrix r (Equiv.refl _)
  let D := (biadjacency G).submatrix id (fun a : S => (a : Fin n))
  have hi (i : Fin k) : Sum.inl i ∉ A := by
    exact Finset.disjoint_left.mp
      (Finset.disjoint_map_inl_map_inr Finset.univ S)
      (Finset.mem_map.mpr ⟨_, Finset.mem_univ _, rfl⟩)
  have hc (i : Fin k) : M.col ⟨Sum.inl i, hi i⟩ = D.transpose.col i := by
    funext a
    change (if G.Adj (Sum.inr a.1) (Sum.inl i) then (1 : ZMod 2) else 0) =
      if G.Adj (Sum.inl i) (Sum.inr a.1) then 1 else 0
    rw [G.adj_comm]
  have hz (a : Fin n) (ha : Sum.inr a ∉ A) : M.col ⟨Sum.inr a, ha⟩ = 0 := by
    funext b
    change (if G.Adj (Sum.inr b.1) (Sum.inr a) then (1 : ZMod 2) else 0) = 0
    exact ite_eq_right (fun h => by simpa using hG.mem_of_adj h)
  have hspan : Submodule.span (ZMod 2) (Set.range M.col) =
      Submodule.span (ZMod 2) (Set.range D.transpose.col) := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨x, rfl⟩
      obtain ⟨x, hx⟩ := x
      cases x with
      | inl i =>
        rw [hc]
        exact Submodule.subset_span ⟨i, rfl⟩
      | inr a =>
        rw [hz a hx]
        exact Submodule.zero_mem _
    · apply Submodule.span_le.mpr
      rintro _ ⟨i, rfl⟩
      rw [← hc i]
      exact Submodule.subset_span ⟨⟨Sum.inl i, hi i⟩, rfl⟩
  calc
    entropy G (S.map Function.Embedding.inr) = M.rank :=
      (Matrix.rank_submatrix (cut G A) r (Equiv.refl _)).symm
    _ = D.transpose.rank := by
      rw [Matrix.rank_eq_finrank_span_cols, Matrix.rank_eq_finrank_span_cols, hspan]
    _ = D.rank := Matrix.rank_transpose D

private theorem supported_kernel_card {k n : ℕ} (B : Matrix (Fin k) (Fin n) (ZMod 2))
    (S : Finset (Fin n)) :
    Nat.card {u : Fin n → ZMod 2 // B *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))} =
      2 ^ (S.card - (B.submatrix id (fun a : S => (a : Fin n))).rank) := by
  classical
  let D := B.submatrix id (fun a : S => (a : Fin n))
  let E : (S → ZMod 2) → Fin n → ZMod 2 :=
    fun u a => if h : a ∈ S then u ⟨a, h⟩ else 0
  have hE (u : S → ZMod 2) : B *ᵥ E u = D *ᵥ u := by
    ext i
    change (∑ a, B i a * (if h : a ∈ S then u ⟨a, h⟩ else 0)) =
      ∑ a : S, B i a * u a
    simp only [mul_dite, mul_zero]
    exact (Finset.sum_attach_eq_sum_dite S (fun a => B i a * u a)).symm
  let e : (LinearMap.ker D.mulVecLin) ≃
      {u : Fin n → ZMod 2 // B *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))} :=
    { toFun := fun u => ⟨E u, by
        constructor
        · rw [hE]; exact u.2
        · intro a ha
          by_contra hn
          change a ∉ S at hn
          exact ha (by simp only [E, dite_eq_right hn])⟩
      invFun := fun u => ⟨fun a => u.1 a, by
        rw [LinearMap.mem_ker, Matrix.mulVecLin_apply, ← hE]
        convert u.2.1 using 1
        congr 1
        funext a
        by_cases ha : a ∈ S
        · simp only [E, dite_eq_left ha]
        · simp only [E, dite_eq_right ha, Function.support_subset_iff'.mp u.2.2 a ha]⟩
      left_inv := fun u => by
        apply Subtype.ext
        funext a
        simp only [E, dite_eq_left a.2]
      right_inv := fun u => by
        apply Subtype.ext
        funext a
        by_cases ha : a ∈ S
        · simp only [E, dite_eq_left ha]
        · simp only [E, dite_eq_right ha, Function.support_subset_iff'.mp u.2.2 a ha] }
  rw [← Nat.card_congr e, Nat.card_eq_fintype_card,
    Module.card_eq_pow_finrank (K := ZMod 2),
    ZMod.card]
  congr 1
  have hr := D.mulVecLin.finrank_range_add_finrank_ker
  change D.rank + Module.finrank (ZMod 2) (LinearMap.ker D.mulVecLin) = _ at hr
  have hd : Module.finrank (ZMod 2) (S → ZMod 2) = S.card := by
    simpa only [Fintype.card_coe] using (Module.finrank_pi (ZMod 2) (ι := S))
  rw [hd] at hr
  change Module.finrank (ZMod 2) (LinearMap.ker D.mulVecLin) = S.card - D.rank
  omega

private theorem kernel_recovery {k n : ℕ} (B C : Matrix (Fin k) (Fin n) (ZMod 2))
    (h : ∀ S : Finset (Fin n),
      Nat.card {u : Fin n → ZMod 2 // B *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))} =
      Nat.card {u : Fin n → ZMod 2 // C *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))}) :
    LinearMap.ker B.mulVecLin = LinearMap.ker C.mulVecLin := by
  classical
  let e : Finset (Fin n) ≃ (Fin n → ZMod 2) :=
    (D5.S3.Quantum.MultifactorCorrelationSectorDecomposition.supportEquiv (ι := Fin n)).symm.trans
      (Equiv.piCongrRight (fun _ => finTwoEquiv.symm.trans (ZMod.finEquiv 2).toEquiv))
  let b : Finset (Fin n) → Fin n → ZMod 2 :=
    e
  have hs (T : Finset (Fin n)) : Function.support (b T) = (T : Set (Fin n)) := by
    have he : b T = (T : Set (Fin n)).indicator (fun _ => 1) := by
      funext a
      change (ZMod.finEquiv 2) (finTwoEquiv.symm (decide (a ∈ T))) = _
      by_cases ha : a ∈ T
      · rw [decide_eq_true ha,
          Set.indicator_of_mem (show a ∈ (T : Set (Fin n)) from ha)]
        rfl
      · rw [decide_eq_false ha,
          Set.indicator_of_notMem (show a ∉ (T : Set (Fin n)) from ha)]
        rfl
    rw [he]
    rw [Set.support_indicator, Function.support_const one_ne_zero, Set.inter_univ]
  have hc (D : Matrix (Fin k) (Fin n) (ZMod 2)) (S : Finset (Fin n)) :
      Nat.card {u : Fin n → ZMod 2 // D *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))} =
        ∑ T ∈ S.powerset, if D *ᵥ b T = 0 then (1 : ℕ) else 0 := by
    let eS := Equiv.subtypeEquiv e (p := fun T => D *ᵥ b T = 0 ∧ T ⊆ S)
      (q := fun u => D *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n)))
      (fun T => by change (_ ∧ T ⊆ S) ↔ (_ ∧ Function.support (b T) ⊆ _)
                   rw [hs]; rfl)
    rw [← Nat.card_congr eS, Nat.card_eq_fintype_card, Fintype.card_subtype]
    have hf : Finset.univ.filter (fun T => D *ᵥ b T = 0 ∧ T ⊆ S) =
        S.powerset.filter (fun T => D *ᵥ b T = 0) := by
      rw [← Finset.filter_univ_mem S.powerset, Finset.filter_filter]
      simp only [Finset.mem_powerset, and_comm]
    rw [hf, Finset.sum_boole]
    rfl
  let f : Matrix (Fin k) (Fin n) (ZMod 2) → Finset (Fin n) → ℝ :=
    fun D T => if D *ᵥ b T = 0 then 1 else 0
  have hf : (fun S : Finset (Fin n) => ∑ T ∈ S.powerset, f B T) =
      (fun S : Finset (Fin n) => ∑ T ∈ S.powerset, f C T) := by
    funext S
    have hS := h S
    rw [hc B S, hc C S] at hS
    dsimp only [f]
    exact_mod_cast hS
  have hmem (T : Finset (Fin n)) : B *ᵥ b T = 0 ↔ C *ᵥ b T = 0 := by
    have he := congrArg
      (fun F => D5.S3.Quantum.Information.EvenLeggedHyperlinkReconstruction.hyperlink F T) hf
    rw [D5.S3.Quantum.Information.EvenLeggedHyperlinkReconstruction.hyperlink_zeta,
      D5.S3.Quantum.Information.EvenLeggedHyperlinkReconstruction.hyperlink_zeta] at he
    dsimp only [f] at he
    split_ifs at he <;> simp_all
  ext u
  obtain ⟨T, rfl⟩ := e.surjective u
  exact hmem T

private theorem row_kernel_pairing {k n : ℕ} (D : Matrix (Fin k) (Fin n) (ZMod 2))
    (u : Fin n → ZMod 2) :
    Module.piEquiv (Fin n) (ZMod 2) (ZMod 2) u ∈
      (Submodule.span (ZMod 2) (Set.range D.row)).dualAnnihilator ↔
      u ∈ LinearMap.ker D.mulVecLin := by
  change (Module.piEquiv (Fin n) (ZMod 2) (ZMod 2) u ∈
    ((Submodule.span (ZMod 2) (Set.range D.row)).dualAnnihilator :
      Set (Module.Dual (ZMod 2) (Fin n → ZMod 2)))) ↔ _
  rw [Submodule.coe_dualAnnihilator_span]
  change (Set.range D.row ⊆
    (LinearMap.ker (Module.piEquiv (Fin n) (ZMod 2) (ZMod 2) u) : Set _)) ↔ _
  rw [Set.range_subset_iff]
  change (∀ i, Module.piEquiv (Fin n) (ZMod 2) (ZMod 2) u (D.row i) = 0) ↔ D *ᵥ u = 0
  constructor
  · intro h
    funext i
    have hi := h i
    rw [Module.piEquiv_apply_apply] at hi
    exact hi
  · intro h i
    rw [Module.piEquiv_apply_apply]
    exact congrFun h i

private theorem kernels_row_spaces {k n : ℕ} (B C : Matrix (Fin k) (Fin n) (ZMod 2))
    (h : LinearMap.ker B.mulVecLin = LinearMap.ker C.mulVecLin) :
    Submodule.span (ZMod 2) (Set.range B.row) =
      Submodule.span (ZMod 2) (Set.range C.row) := by
  classical
  apply Subspace.dualAnnihilator_inj.mp
  ext φ
  obtain ⟨u, rfl⟩ := (Module.piEquiv (Fin n) (ZMod 2) (ZMod 2)).surjective φ
  rw [row_kernel_pairing B u, row_kernel_pairing C u, h]

private theorem row_spaces_unit {k n : ℕ} (B C : Matrix (Fin k) (Fin n) (ZMod 2))
    (h : Submodule.span (ZMod 2) (Set.range B.row) =
      Submodule.span (ZMod 2) (Set.range C.row)) :
    ∃ R : (Matrix (Fin k) (Fin k) (ZMod 2))ˣ, C = R.val * B := by
  classical
  have hk : LinearMap.ker B.mulVecLin = LinearMap.ker C.mulVecLin := by
    ext u
    rw [← row_kernel_pairing B u, ← row_kernel_pairing C u, h]
  let e : LinearMap.range B.mulVecLin ≃ₗ[ZMod 2] LinearMap.range C.mulVecLin :=
    B.mulVecLin.quotKerEquivRange.symm.trans
      ((Submodule.quotEquivOfEq _ _ hk).trans C.mulVecLin.quotKerEquivRange)
  obtain ⟨t, ht⟩ := Submodule.exists_linearEquiv_restrict_eq e
  let R : (Matrix (Fin k) (Fin k) (ZMod 2))ˣ :=
    Units.map LinearMap.toMatrixAlgEquiv'.toMonoidHom
      (LinearMap.GeneralLinearGroup.ofLinearEquiv t)
  refine ⟨R, ?_⟩
  change C = LinearMap.toMatrix' t.toLinearMap * B
  apply Matrix.mulVec_injective
  funext u
  rw [← Matrix.mulVec_mulVec, LinearMap.toMatrix'_mulVec]
  have he := ht (B.mulVecLin.quotKerEquivRange (Submodule.Quotient.mk u))
  dsimp only [e] at he
  rw [LinearEquiv.trans_apply, LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply,
    Submodule.quotEquivOfEq_mk, LinearMap.quotKerEquivRange_apply_mk,
    LinearMap.quotKerEquivRange_apply_mk] at he
  exact he

private theorem realize_row_equivalence {k n : ℕ} (G H : SimpleGraph (Fin k ⊕ Fin n))
    (hG : G.IsBipartiteWith {v | v.isLeft} {v | v.isRight}) (hH : H.IsBipartiteWith {v | v.isLeft} {v | v.isRight})
    (R : (Matrix (Fin k) (Fin k) (ZMod 2))ˣ)
    (h : biadjacency H = R.val * biadjacency G) :
    Relation.ReflTransGen BipartiteStep G H := by
  classical
  let P : Matrix (Fin k) (Fin k) (ZMod 2) → Prop := fun M =>
    ∀ J : SimpleGraph (Fin k ⊕ Fin n), J.IsBipartiteWith {v | v.isLeft} {v | v.isRight} →
      ∃ K : SimpleGraph (Fin k ⊕ Fin n), K.IsBipartiteWith {v | v.isLeft} {v | v.isRight} ∧
        biadjacency K = M * biadjacency J ∧ Relation.ReflTransGen BipartiteStep J K
  have hP : P R.val := by
    apply Matrix.diagonal_transvection_induction_of_det_ne_zero P R.val
      (Matrix.isUnits_det_units R).ne_zero
    · intro D hD J hJ
      have hones : D = fun _ => 1 := by
        funext i
        have hi : D i ≠ 0 := (Finset.prod_ne_zero_iff.mp (by
          simpa only [Matrix.det_diagonal] using hD)) i (Finset.mem_univ i)
        exact (binary (D i)).resolve_left hi
      refine ⟨J, hJ, ?_, .refl⟩
      rw [hones, Matrix.diagonal_one, Matrix.one_mul]
    · intro t J hJ
      rcases binary t.c with ht | ht
      · refine ⟨J, hJ, ?_, .refl⟩
        change biadjacency J = Matrix.transvection t.i t.j t.c * biadjacency J
        rw [ht, Matrix.transvection_zero, Matrix.one_mul]
      · refine ⟨addInputRow J t.i t.j, add_row_bipartite J hJ t.i t.j, ?_,
          Relation.ReflTransGen.single (Or.inr (Or.inr ⟨t.i, t.j, t.hij, rfl⟩))⟩
        change biadjacency (addInputRow J t.i t.j) =
          Matrix.transvection t.i t.j t.c * biadjacency J
        rw [ht, add_row_matrix]
    · intro A B _ _ hA hB J hJ
      obtain ⟨K, hK, hKJ, hJK⟩ := hB J hJ
      obtain ⟨L, hL, hLK, hKL⟩ := hA K hK
      refine ⟨L, hL, ?_, hJK.trans hKL⟩
      rw [hLK, hKJ, Matrix.mul_assoc]
  obtain ⟨J, hJ, hJG, hGJ⟩ := hP G hG
  have he : J = H := bipartite_ext J H hJ hH (hJG.trans h.symm)
  exact he ▸ hGJ

theorem result : claim := by
  intro k n G H hG hH h
  obtain ⟨σ, hσ⟩ := equivalence_profile G H h
  let J := G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding
  have hJ : J.IsBipartiteWith {v | v.isLeft} {v | v.isRight} := permute_bipartite G hG σ
  have hp : ∀ S : Finset (Fin n),
      ((biadjacency J).submatrix id (fun a : S => (a : Fin n))).rank =
        ((biadjacency H).submatrix id (fun a : S => (a : Fin n))).rank := by
    intro S
    rw [← bipartite_profile J hJ S, ← bipartite_profile H hH S]
    exact (hσ S).symm
  have hk := kernel_recovery (biadjacency J) (biadjacency H) (fun S => by
    rw [supported_kernel_card, supported_kernel_card, hp S])
  obtain ⟨R, hR⟩ := row_spaces_unit (biadjacency J) (biadjacency H)
    (kernels_row_spaces _ _ hk)
  exact (Relation.ReflTransGen.single (show BipartiteStep G J from Or.inl ⟨σ, rfl⟩)).trans
    (realize_row_equivalence J H hJ hH R hR)

end D5.S3.Quantum.Codes.KhesinLiBipartiteEncoderEquivalence
