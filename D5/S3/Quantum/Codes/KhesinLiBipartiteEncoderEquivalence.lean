/- GID: D5/S3/Quantum/Codes/KhesinLiBipartiteEncoderEquivalence
   generality: I
   mirror-B: D5/B/S3/Quantum/Codes/KhesinLiBipartiteEncoderEquivalence
   mirror-E: none(waiver:external-open-problem-resolution)
   anchors: []
   utility: none
   digest: Bipartite encoder equivalence reduces to permutations and binary row additions. -/

import D5.S3.Quantum.Codes.KhesinLiEquivalenceClasses
import Mathlib.LinearAlgebra.Matrix.ElementaryRowOperations
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.Data.Nat.Choose.Sum

/-! Khesin–Li, arXiv:2406.12083v1, Conjecture 8.3, under the decoration-free
operation-generated reading of preregistration #26139. Both sides have only input–output edges.
The quantum equivalence of Definition 6.2 and Conjecture 6.3 are outside this statement. -/

namespace D5.S3.Quantum.Codes.KhesinLiBipartiteEncoderEquivalence

open D5.S3.Quantum.Codes.KhesinLiEquivalenceClasses (Step addInputRow)
open D5.S3.Quantum.Entanglement.GraphStateMonogamyForbiddenSubgraph (entropy)
open Matrix

/-- A bipartite form has no edges within either the inputs or the outputs. -/
def IsBipartiteForm {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n)) : Prop :=
  (∀ i j : Fin k, ¬ G.Adj (Sum.inl i) (Sum.inl j)) ∧
  (∀ a b : Fin n, ¬ G.Adj (Sum.inr a) (Sum.inr b))

/-- Exactly output permutations, input permutations, and additions of distinct input rows. -/
def BipartiteStep {k n : ℕ} (G H : SimpleGraph (Fin k ⊕ Fin n)) : Prop :=
  (∃ σ : Equiv.Perm (Fin n),
    H = G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding) ∨
  (∃ τ : Equiv.Perm (Fin k),
    H = G.map (Equiv.sumCongr τ (Equiv.refl (Fin n))).toEmbedding) ∨
  (∃ i j : Fin k, i ≠ j ∧ H = addInputRow G i j)

/-- Conjecture 8.3 for the equivalence generated by the frozen encoder operations. -/
def claim : Prop :=
  ∀ k n : ℕ, ∀ G H : SimpleGraph (Fin k ⊕ Fin n),
    IsBipartiteForm G → IsBipartiteForm H → Relation.EqvGen Step G H →
      Relation.ReflTransGen BipartiteStep G H

private noncomputable def biadjacency {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n)) :
    Matrix (Fin k) (Fin n) (ZMod 2) := by
  classical
  exact (G.adjMatrix (ZMod 2)).submatrix Sum.inl Sum.inr

private theorem equivalence_profile {k n : ℕ} (G H : SimpleGraph (Fin k ⊕ Fin n))
    (h : Relation.EqvGen Step G H) :
    ∃ σ : Equiv.Perm (Fin n), ∀ S : Finset (Fin n),
      entropy H (S.map Function.Embedding.inr) =
        entropy (G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding)
          (S.map Function.Embedding.inr) := by
  sorry

private theorem permute_bipartite {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (hG : IsBipartiteForm G) (σ : Equiv.Perm (Fin n)) :
    IsBipartiteForm (G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding) := by
  rw [← SimpleGraph.comap_symm]
  constructor
  · intro i j
    exact hG.1 i j
  · intro a b
    exact hG.2 (σ.symm a) (σ.symm b)

private theorem bipartite_profile {k n : ℕ} (G : SimpleGraph (Fin k ⊕ Fin n))
    (hG : IsBipartiteForm G) (S : Finset (Fin n)) :
    entropy G (S.map Function.Embedding.inr) =
      ((biadjacency G).submatrix id (fun a : S => (a : Fin n))).rank := by
  sorry

private theorem supported_kernel_card {k n : ℕ} (B : Matrix (Fin k) (Fin n) (ZMod 2))
    (S : Finset (Fin n)) :
    Nat.card {u : Fin n → ZMod 2 // B *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))} =
      2 ^ (S.card - (B.submatrix id (fun a : S => (a : Fin n))).rank) := by
  sorry

private theorem kernel_recovery {k n : ℕ} (B C : Matrix (Fin k) (Fin n) (ZMod 2))
    (h : ∀ S : Finset (Fin n),
      Nat.card {u : Fin n → ZMod 2 // B *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))} =
      Nat.card {u : Fin n → ZMod 2 // C *ᵥ u = 0 ∧ Function.support u ⊆ (S : Set (Fin n))}) :
    LinearMap.ker B.mulVecLin = LinearMap.ker C.mulVecLin := by
  sorry

private theorem kernels_row_spaces {k n : ℕ} (B C : Matrix (Fin k) (Fin n) (ZMod 2))
    (h : LinearMap.ker B.mulVecLin = LinearMap.ker C.mulVecLin) :
    Submodule.span (ZMod 2) (Set.range B.row) =
      Submodule.span (ZMod 2) (Set.range C.row) := by
  sorry

private theorem row_spaces_unit {k n : ℕ} (B C : Matrix (Fin k) (Fin n) (ZMod 2))
    (h : Submodule.span (ZMod 2) (Set.range B.row) =
      Submodule.span (ZMod 2) (Set.range C.row)) :
    ∃ R : (Matrix (Fin k) (Fin k) (ZMod 2))ˣ, C = R.val * B := by
  sorry

private theorem realize_row_equivalence {k n : ℕ} (G H : SimpleGraph (Fin k ⊕ Fin n))
    (hG : IsBipartiteForm G) (hH : IsBipartiteForm H)
    (R : (Matrix (Fin k) (Fin k) (ZMod 2))ˣ)
    (h : biadjacency H = R.val * biadjacency G) :
    Relation.ReflTransGen BipartiteStep G H := by
  sorry

theorem result : claim := by
  intro k n G H hG hH h
  obtain ⟨σ, hσ⟩ := equivalence_profile G H h
  let J := G.map (Equiv.sumCongr (Equiv.refl (Fin k)) σ).toEmbedding
  have hJ : IsBipartiteForm J := permute_bipartite G hG σ
  have hp : ∀ S : Finset (Fin n),
      ((biadjacency J).submatrix id (fun a : S => (a : Fin n))).rank =
        ((biadjacency H).submatrix id (fun a : S => (a : Fin n))).rank := by
    intro S
    rw [← bipartite_profile J hJ S, ← bipartite_profile H hH S]
    exact (hσ S).symm
  have hk := kernel_recovery (biadjacency J) (biadjacency H) (fun S => by
    rw [supported_kernel_card, supported_kernel_card, hp S])
  obtain ⟨R, hR⟩ := row_spaces_unit (biadjacency J) (biadjacency H)
    (kernels_row_spaces _ _ hk)
  exact (Relation.ReflTransGen.single (show BipartiteStep G J from Or.inl ⟨σ, rfl⟩)).trans
    (realize_row_equivalence J H hJ hH R hR)

end D5.S3.Quantum.Codes.KhesinLiBipartiteEncoderEquivalence
