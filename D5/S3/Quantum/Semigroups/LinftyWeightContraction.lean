     result: bind-only; designated refutation conclusion
   These proofs instantiate pinned Mathlib algebra, norm, derivative and
   filter results and normalize their consequences. Admission uses the
   external open-problem resolution exception, not an escape witness.
   For A = !![1, 2; -2, 1], the semigroup is exp(-t) times rotation by 2t,
   with sup-norm bound 2. Weighted unit vectors force both expressions
   exp(-t)(cos(2t) + c sin(2t)) ≤ 1 with c = g₀/g₁ and c = g₁/g₀.
   One coefficient exceeds 1/2, giving a positive derivative at zero
   and hence a contradiction at a positive time. -/

import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.SpecialFunctions.Trigonometric.Deriv
import Mathlib.Analysis.Calculus.DerivativeTest
import Mathlib.Topology.Algebra.Module.FiniteDimension
import Mathlib.Topology.Order.DenselyOrdered
import Mathlib.LinearAlgebra.Complex.Module
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.FinCases
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Ring

noncomputable section
namespace D5.S3.Quantum.Semigroups.LinftyWeightContraction
open Matrix SignType
open scoped Matrix Topology

/-- The sup norm for counting measure on `Fin n`, including the empty space. -/
noncomputable def supNorm {n : ℕ} (u : Fin n → ℂ) : ℝ := ‖u‖

/-- Accretivity and a uniform sector bound for the associated quadratic form. -/
def IsSectorialMatrix {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) : Prop :=
  ∃ C : ℝ, ∀ u : Fin n → ℂ,
    0 ≤ (∑ i, (A *ᵥ u) i * star (u i)).re ∧
      |(∑ i, (A *ᵥ u) i * star (u i)).im| ≤ C * (∑ i, (A *ᵥ u) i * star (u i)).re

/-- The matrix exponential semigroup generated by `-A`. -/
noncomputable def semigroup {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) (t : ℝ) :
    Matrix (Fin n) (Fin n) ℂ :=
  NormedSpace.exp ((-t : ℂ) • A)

def claim : Prop :=
  ∀ (n : ℕ) (A : Matrix (Fin n) (Fin n) ℂ), IsSectorialMatrix A →
    (∃ M : ℝ, ∀ t : ℝ, 0 ≤ t → ∀ u : Fin n → ℂ,
      supNorm (semigroup A t *ᵥ u) ≤ M * supNorm u) →
      ∃ g : Fin n → ℝ, (∀ i, 0 < g i) ∧
        ∀ t : ℝ, 0 ≤ t → ∀ u : Fin n → ℂ,
          supNorm (fun i => (g i : ℂ) * (semigroup A t *ᵥ u) i) ≤
            supNorm (fun i => (g i : ℂ) * u i)

private def A : Matrix (Fin 2) (Fin 2) ℂ := !![1, 2; -2, 1]
private def J : Matrix (Fin 2) (Fin 2) ℂ := !![0, 1; -1, 0]

private lemma sectorial : IsSectorialMatrix A := by
  refine ⟨2, fun u => ?_⟩
  simp only [A, Matrix.mulVec, dotProduct, Fin.sum_univ_two,
    Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im,
    Complex.star_def, Complex.conj_re, Complex.conj_im]
  norm_num
  constructor
  · nlinarith [sq_nonneg (u 0).re, sq_nonneg (u 0).im,
      sq_nonneg (u 1).re, sq_nonneg (u 1).im]
  · rw [abs_le]
    constructor
    · nlinarith [sq_nonneg ((u 0).re + (u 1).im),
        sq_nonneg ((u 0).im - (u 1).re)]
    · nlinarith [sq_nonneg ((u 0).re - (u 1).im),
        sq_nonneg ((u 0).im + (u 1).re)]

private lemma J_sq : J * J = -1 := by
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [J, Matrix.mul_apply, Fin.sum_univ_two]

private def φ : ℂ →ₐ[ℝ] Matrix (Fin 2) (Fin 2) ℂ := Complex.liftAux J J_sq

private lemma φ_apply (z : ℂ) : φ z = !![(z.re : ℂ), z.im; -z.im, z.re] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [φ, Complex.liftAux_apply, J, Matrix.algebraMap_eq_diagonal, Matrix.diagonal]

private lemma φ_continuous : Continuous φ :=
  φ.toLinearMap.continuous_of_finiteDimensional

set_option backward.isDefEq.respectTransparency false in
open scoped Norms.Operator in
private lemma semigroup_formula (t : ℝ) : semigroup A t =
    (Real.exp (-t) : ℂ) •
      !![(Real.cos (2*t) : ℂ), -(Real.sin (2*t) : ℂ);
        (Real.sin (2*t) : ℂ), (Real.cos (2*t) : ℂ)] := by
  have harg : (-t : ℂ) • A = φ ⟨-t, -2*t⟩ := by
    rw [φ_apply]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [A] <;> ring
  unfold semigroup
  rw [harg]
  have hmap := NormedSpace.map_exp φ φ_continuous (⟨-t, -2*t⟩ : ℂ)
  rw [← hmap, ← Complex.exp_eq_exp_ℂ, φ_apply]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Complex.exp_re, Complex.exp_im, Real.cos_neg, Real.sin_neg, neg_mul]

private lemma entry_bound (t : ℝ) (ht : 0 ≤ t) (i j : Fin 2) :
    ‖semigroup A t i j‖ ≤ 1 := by
  have he : Real.exp (-t) ≤ 1 := Real.exp_le_one_iff.mpr (neg_nonpos.mpr ht)
  have hc : Real.exp (-t) * |Real.cos (2*t)| ≤ 1 := by
    simpa using mul_le_mul he (Real.abs_cos_le_one (2*t)) (abs_nonneg _) zero_le_one
  have hs : Real.exp (-t) * |Real.sin (2*t)| ≤ 1 := by
    simpa using mul_le_mul he (Real.abs_sin_le_one (2*t)) (abs_nonneg _) zero_le_one
  rw [semigroup_formula]
  fin_cases i <;> fin_cases j
  · change ‖(Real.exp (-t) : ℂ) * (Real.cos (2*t) : ℂ)‖ ≤ 1
    simpa only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (Real.exp_pos (-t))] using hc
  · change ‖(Real.exp (-t) : ℂ) * -(Real.sin (2*t) : ℂ)‖ ≤ 1
    simpa only [norm_mul, norm_neg, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (Real.exp_pos (-t))] using hs
  · change ‖(Real.exp (-t) : ℂ) * (Real.sin (2*t) : ℂ)‖ ≤ 1
    simpa only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (Real.exp_pos (-t))] using hs
  · change ‖(Real.exp (-t) : ℂ) * (Real.cos (2*t) : ℂ)‖ ≤ 1
    simpa only [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (Real.exp_pos (-t))] using hc

private lemma bounded : ∃ M : ℝ, ∀ t : ℝ, 0 ≤ t → ∀ u : Fin 2 → ℂ,
    supNorm (semigroup A t *ᵥ u) ≤ M * supNorm u := by
  refine ⟨2, fun t ht u => ?_⟩
  apply (pi_norm_le_iff_of_nonneg (mul_nonneg (by norm_num) (norm_nonneg u))).mpr
  intro i
  calc
    ‖(semigroup A t *ᵥ u) i‖ ≤ ∑ j, ‖semigroup A t i j‖ * ‖u j‖ := by
      simpa only [Matrix.mulVec, dotProduct, norm_mul] using
        norm_sum_le (Finset.univ : Finset (Fin 2)) (fun j => semigroup A t i j * u j)
    _ ≤ ∑ _j : Fin 2, supNorm u := by
      apply Finset.sum_le_sum
      intro j _
      calc
        _ ≤ 1 * ‖u j‖ := mul_le_mul_of_nonneg_right (entry_bound t ht i j) (norm_nonneg _)
        _ ≤ supNorm u := by simpa [supNorm] using norm_le_pi_norm u j
    _ = 2 * supNorm u := by rw [Fin.sum_univ_two]; ring

private lemma positive_bump (c : ℝ) (hc : 1/2 < c) :
    ∃ t : ℝ, 0 < t ∧ 1 < Real.exp (-t) * (Real.cos (2*t) + c * Real.sin (2*t)) := by
  let f : ℝ → ℝ := fun t => Real.exp (-t) * (Real.cos (2*t) + c * Real.sin (2*t))
  have hd : HasDerivAt f (2*c-1) 0 := by
    convert (((hasDerivAt_id (0 : ℝ)).neg.exp).mul
      (((hasDerivAt_id (0 : ℝ)).const_mul 2).cos.add
        (((hasDerivAt_id (0 : ℝ)).const_mul 2).sin.const_mul c))) using 1 <;>
      first | rfl | (norm_num; ring)
  have hp : 0 < 2*c-1 := by linarith
  have hev : ∀ᶠ t in 𝓝[>] (0 : ℝ), sign (f t - 1) = sign (t - 0) :=
    (eventually_nhdsWithin_sign_eq_of_deriv_pos
      (f := fun t => f t - 1) (by rw [(hd.sub_const 1).deriv]; exact hp)
      (by norm_num [f])).filter_mono nhdsWithin_le_nhds
  have : (𝓝[>] (0 : ℝ)).NeBot := nhdsGT_neBot 0
  obtain ⟨t, hs, ht⟩ := (hev.and
    (self_mem_nhdsWithin : ∀ᶠ t in 𝓝[>] (0 : ℝ), 0 < t)).exists
  refine ⟨t, ht, ?_⟩
  have hpos : 0 < f t - 1 := by
    rw [sub_zero, sign_pos ht] at hs
    exact sign_eq_one_iff.mp hs
  change 1 < f t
  linarith

private lemma action (t : ℝ) (u : Fin 2 → ℂ) : semigroup A t *ᵥ u =
    ![(Real.exp (-t) : ℂ) * ((Real.cos (2*t) : ℂ) * u 0 - (Real.sin (2*t) : ℂ) * u 1),
      (Real.exp (-t) : ℂ) * ((Real.sin (2*t) : ℂ) * u 0 + (Real.cos (2*t) : ℂ) * u 1)] := by
  rw [semigroup_formula]
  funext i
  fin_cases i <;> simp [Matrix.mulVec, dotProduct, Fin.sum_univ_two] <;> ring

private lemma no_weight (g : Fin 2 → ℝ) (hg : ∀ i, 0 < g i)
    (hcontract : ∀ t : ℝ, 0 ≤ t → ∀ u : Fin 2 → ℂ,
      supNorm (fun i => (g i : ℂ) * (semigroup A t *ᵥ u) i) ≤
        supNorm (fun i => (g i : ℂ) * u i)) : False := by
  have hg0 : (g 0 : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt (hg 0))
  have hg1 : (g 1 : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt (hg 1))
  have hb (t : ℝ) (ht : 0 ≤ t) (u : Fin 2 → ℂ)
      (hu : supNorm (fun i => (g i : ℂ) * u i) ≤ 1) (i : Fin 2) :
      ((g i : ℂ) * (semigroup A t *ᵥ u) i).re ≤ 1 :=
    (Complex.re_le_norm _).trans ((norm_le_pi_norm _ i).trans ((hcontract t ht u).trans hu))
  have hzero (t : ℝ) (ht : 0 ≤ t) :
      Real.exp (-t) * (Real.cos (2*t) + (g 0 / g 1) * Real.sin (2*t)) ≤ 1 := by
    let u : Fin 2 → ℂ := ![(g 0 : ℂ)⁻¹, -(g 1 : ℂ)⁻¹]
    have hu : supNorm (fun i => (g i : ℂ) * u i) ≤ 1 := by
      apply (pi_norm_le_iff_of_nonneg zero_le_one).mpr
      intro i
      fin_cases i <;> simp [u, mul_inv_cancel₀ hg0, mul_inv_cancel₀ hg1]
    have heq : (g 0 : ℂ) * (semigroup A t *ᵥ u) 0 =
        (Real.exp (-t) * (Real.cos (2*t) + (g 0 / g 1) * Real.sin (2*t)) : ℝ) := by
      rw [action]
      simp only [u, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_fin_one, Complex.ofReal_mul, Complex.ofReal_add, Complex.ofReal_div]
      field_simp
      ring
    have hh := hb t ht u hu 0
    rw [heq, Complex.ofReal_re] at hh
    exact hh
  have hone (t : ℝ) (ht : 0 ≤ t) :
      Real.exp (-t) * (Real.cos (2*t) + (g 1 / g 0) * Real.sin (2*t)) ≤ 1 := by
    let u : Fin 2 → ℂ := ![(g 0 : ℂ)⁻¹, (g 1 : ℂ)⁻¹]
    have hu : supNorm (fun i => (g i : ℂ) * u i) ≤ 1 := by
      apply (pi_norm_le_iff_of_nonneg zero_le_one).mpr
      intro i
      fin_cases i <;> simp [u, mul_inv_cancel₀ hg0, mul_inv_cancel₀ hg1]
    have heq : (g 1 : ℂ) * (semigroup A t *ᵥ u) 1 =
        (Real.exp (-t) * (Real.cos (2*t) + (g 1 / g 0) * Real.sin (2*t)) : ℝ) := by
      rw [action]
      simp only [u, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_fin_one, Complex.ofReal_mul, Complex.ofReal_add, Complex.ofReal_div]
      field_simp
      ring
    have hh := hb t ht u hu 1
    rw [heq, Complex.ofReal_re] at hh
    exact hh
  by_cases hr : 1/2 < g 0 / g 1
  · obtain ⟨t, ht, hbump⟩ := positive_bump (g 0 / g 1) hr
    exact (not_lt_of_ge (hzero t ht.le)) hbump
  · have hr' : 1/2 < g 1 / g 0 := by
      have hratio : g 0 ≤ (1/2) * g 1 := (div_le_iff₀ (hg 1)).mp (le_of_not_gt hr)
      apply (lt_div_iff₀ (hg 0)).mpr
      linarith [hg 0, hg 1]
    obtain ⟨t, ht, hbump⟩ := positive_bump (g 1 / g 0) hr'
    exact (not_lt_of_ge (hone t ht.le)) hbump

/-- A bounded sectorial matrix semigroup need not admit a contractive positive weight. -/
theorem result : ¬ claim := by
  intro h
  obtain ⟨g, hg, hc⟩ := h 2 A sectorial bounded
  exact no_weight g hg hc

end D5.S3.Quantum.Semigroups.LinftyWeightContraction
