    simpa only [h] using cap11111000Accepted
  · have h : rightBox cap1111100Box 2 (midpoint cap1111100Box 2) = cap11111001Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap11111001Accepted

