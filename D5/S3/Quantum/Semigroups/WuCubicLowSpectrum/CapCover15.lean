import D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapRows

compile_only_with_mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 1800000
set_option linter.style.longLine false

namespace D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapCover15

open D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.Factored

open WuCubicLowSpectrumCover (Box Tree)
open private midpoint from D5.S3.Quantum.Semigroups.WuCubicLowSpectrumCover
open private leftBox rightBox from D5.S0.Certificates.BoxCover.CheckedRationalBoxCover

open D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapRows (table)

def cap11101011110Box : Box := ![(21 / 20, 11 / 10), (189 / 400, 441 / 800), (5 / 8, 3 / 4), (7 / 8, 1)]

private def cap111010111100Box : Box := ![(21 / 20, 11 / 10), (189 / 400, 441 / 800), (5 / 8, 11 / 16), (7 / 8, 1)]

private def cap1110101111000Box : Box := ![(21 / 20, 11 / 10), (189 / 400, 441 / 800), (5 / 8, 11 / 16), (7 / 8, 15 / 16)]

private def cap11101011110000Box : Box := ![(21 / 20, 43 / 40), (189 / 400, 441 / 800), (5 / 8, 11 / 16), (7 / 8, 15 / 16)]

private def cap11101011110000Tree : Option PackedTree := decode 6 

private theorem cap11101011110000Accepted : Accepted table cap11101011110000Box cap11101011110000Tree := by
  decide +kernel

private def cap11101011110001Box : Box := ![(43 / 40, 11 / 10), (189 / 400, 441 / 800), (5 / 8, 11 / 16), (7 / 8, 15 / 16)]

private def cap11101011110001Tree : Option PackedTree := decode 6 

private theorem cap11101011110001Accepted : Accepted table cap11101011110001Box cap11101011110001Tree := by
  decide +kernel

private def cap1110101111000Tree : Option PackedTree :=
  PackedTree.split 0 <$> cap11101011110000Tree <*> cap11101011110001Tree

private theorem cap1110101111000Accepted : Accepted table cap1110101111000Box cap1110101111000Tree := by
  apply acceptedSplit 0
  · have h : leftBox cap1110101111000Box 0 (midpoint cap1110101111000Box 0) = cap11101011110000Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap11101011110000Accepted
  · have h : rightBox cap1110101111000Box 0 (midpoint cap1110101111000Box 0) = cap11101011110001Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap11101011110001Accepted

private def cap1110101111001Box : Box := ![(21 / 20, 11 / 10), (189 / 400, 441 / 800), (5 / 8, 11 / 16), (15 / 16, 1)]

private def cap1110101111001Tree : Option PackedTree := decode 6 

private theorem cap1110101111001Accepted : Accepted table cap1110101111001Box cap1110101111001Tree := by
  decide +kernel

private def cap111010111100Tree : Option PackedTree :=
  PackedTree.split 3 <$> cap1110101111000Tree <*> cap1110101111001Tree

private theorem cap111010111100Accepted : Accepted table cap111010111100Box cap111010111100Tree := by
  apply acceptedSplit 3
  · have h : leftBox cap111010111100Box 3 (midpoint cap111010111100Box 3) = cap1110101111000Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap1110101111000Accepted
  · have h : rightBox cap111010111100Box 3 (midpoint cap111010111100Box 3) = cap1110101111001Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap1110101111001Accepted

private def cap111010111101Box : Box := ![(21 / 20, 11 / 10), (189 / 400, 441 / 800), (11 / 16, 3 / 4), (7 / 8, 1)]

private def cap111010111101Tree : Option PackedTree := decode 8 

private theorem cap111010111101Accepted : Accepted table cap111010111101Box cap111010111101Tree := by
  decide +kernel

def cap11101011110Tree : Option PackedTree :=
  PackedTree.split 2 <$> cap111010111100Tree <*> cap111010111101Tree

theorem cap11101011110Accepted : Accepted table cap11101011110Box cap11101011110Tree := by
  apply acceptedSplit 2
  · have h : leftBox cap11101011110Box 2 (midpoint cap11101011110Box 2) = cap111010111100Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap111010111100Accepted
  · have h : rightBox cap11101011110Box 2 (midpoint cap11101011110Box 2) = cap111010111101Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap111010111101Accepted

end D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapCover15
