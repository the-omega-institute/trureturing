def cap111000Box : Box := ![(1, 11 / 10), (63 / 200, 63 / 100), (1 / 2, 3 / 4), (1 / 2, 3 / 4)]

private def cap1110000Box : Box := ![(1, 11 / 10), (63 / 200, 189 / 400), (1 / 2, 3 / 4), (1 / 2, 3 / 4)]

private def cap11100000Box : Box := ![(1, 11 / 10), (63 / 200, 189 / 400), (1 / 2, 5 / 8), (1 / 2, 3 / 4)]

private def cap111000000Box : Box := ![(1, 11 / 10), (63 / 200, 189 / 400), (1 / 2, 5 / 8), (1 / 2, 5 / 8)]

private def cap111000000Tree : Option PackedTree := decode 5 

private theorem cap111000000Accepted : Accepted table cap111000000Box cap111000000Tree := by
  decide +kernel

private def cap111000001Box : Box := ![(1, 11 / 10), (63 / 200, 189 / 400), (1 / 2, 5 / 8), (5 / 8, 3 / 4)]

private def cap111000001Tree : Option PackedTree := decode 7 

private theorem cap111000001Accepted : Accepted table cap111000001Box cap111000001Tree := by
  decide +kernel

private def cap11100000Tree : Option PackedTree :=
  PackedTree.split 3 <$> cap111000000Tree <*> cap111000001Tree

private theorem cap11100000Accepted : Accepted table cap11100000Box cap11100000Tree := by
  apply acceptedSplit 3
  · have h : leftBox cap11100000Box 3 (midpoint cap11100000Box 3) = cap111000000Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap111000000Accepted
  · have h : rightBox cap11100000Box 3 (midpoint cap11100000Box 3) = cap111000001Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap111000001Accepted

