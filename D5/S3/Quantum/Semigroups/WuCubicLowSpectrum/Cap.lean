private theorem checkedCap :
    ∃ tree : Tree, tree.check (1 / 10000) WuCubicLowSpectrumCover.root = true :=
  acceptedTree D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapRows.tableChecked capAccepted

/-- The exact bisection gives a uniform floor throughout the ordered low-spectrum region. -/
theorem cap_floor (U : unitary Mat) {r m n q : ℝ}
    (hr : r ∈ Set.Icc (1 : ℝ) (6 / 5)) (hm : m ∈ Set.Icc (0 : ℝ) (63 / 100))
    (hmn : m ≤ n) (hnq : n ≤ q) (hq : q ≤ 1) :
    (1 / 10000 : ℝ) ≤ normalizedDeficit r U m n q := by
  obtain ⟨tree, checked⟩ := checkedCap
  simpa only [Rat.cast_div, Rat.cast_one, Rat.cast_ofNat] using
    tree.root_sound U checked hr hm hmn hnq hq

open WuCubicOperatorNormalization (operatorDeficit) in
/-- Wu (3.54) for positive semidefinite observables on two equal-cap CAR modes, at `p = 3`. -/
theorem operatorDeficit_nonneg_and_eq_zero_iff {r : ℝ} (hr : 1 ≤ r) (hrhi : r ≤ 6 / 5)
    {X : WuCubicOperatorBridge.Mat} (hX : X.PosSemidef) :
    0 ≤ operatorDeficit r X ∧
      (operatorDeficit r X = 0 ↔ ∃ c : ℝ, 0 ≤ c ∧
        X = (c : ℂ) • (1 : WuCubicOperatorBridge.Mat)) := by
  obtain ⟨tree, checked⟩ := checkedCap
  have hfloor : (0 : ℚ) < 1 / 10000 := by decide +kernel
  exact WuCubicWarmFullSpectrum.operatorDeficit_nonneg_and_eq_zero_iff tree hfloor checked hr hrhi hX

