private theorem acceptedSplitAt (axis : Fin 4)
    {box left right : Box} {lt rt : Option PackedTree}
    (hl : Accepted table left lt) (hr : Accepted table right rt)
    (hleft : leftBox box axis (midpoint box axis) = left)
    (hright : rightBox box axis (midpoint box axis) = right) :
    Accepted table box (PackedTree.split axis <$> lt <*> rt) := by
  apply acceptedSplit axis
  · simpa only [hleft] using hl
  · simpa only [hright] using hr

