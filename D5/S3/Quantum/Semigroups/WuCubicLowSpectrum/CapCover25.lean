import D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapRows

compile_only_with_mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxRecDepth 8192
set_option maxHeartbeats 1800000
set_option linter.style.longLine false

namespace D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapCover25

open D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.Factored

open WuCubicLowSpectrumCover (Box Tree)
open private midpoint from D5.S3.Quantum.Semigroups.WuCubicLowSpectrumCover
open private leftBox rightBox from D5.S0.Certificates.BoxCover.CheckedRationalBoxCover

open D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapRows (table)

def cap1110111100110Box : Box := ![(11 / 10, 23 / 20), (441 / 800, 63 / 100), (11 / 16, 3 / 4), (3 / 4, 13 / 16)]

private def cap11101111001100Box : Box := ![(11 / 10, 9 / 8), (441 / 800, 63 / 100), (11 / 16, 3 / 4), (3 / 4, 13 / 16)]

private def cap11101111001100Tree : Option PackedTree := decode 6 

private theorem cap11101111001100Accepted : Accepted table cap11101111001100Box cap11101111001100Tree := by
  decide +kernel

private def cap11101111001101Box : Box := ![(9 / 8, 23 / 20), (441 / 800, 63 / 100), (11 / 16, 3 / 4), (3 / 4, 13 / 16)]

private def cap111011110011010Box : Box := ![(9 / 8, 23 / 20), (441 / 800, 189 / 320), (11 / 16, 3 / 4), (3 / 4, 13 / 16)]

private def cap111011110011010Tree : Option PackedTree := decode 7 

private theorem cap111011110011010Accepted : Accepted table cap111011110011010Box cap111011110011010Tree := by
  decide +kernel

private def cap111011110011011Box : Box := ![(9 / 8, 23 / 20), (189 / 320, 63 / 100), (11 / 16, 3 / 4), (3 / 4, 13 / 16)]

private def cap111011110011011Tree : Option PackedTree := decode 7 

private theorem cap111011110011011Accepted : Accepted table cap111011110011011Box cap111011110011011Tree := by
  decide +kernel

private def cap11101111001101Tree : Option PackedTree :=
  PackedTree.split 1 <$> cap111011110011010Tree <*> cap111011110011011Tree

private theorem cap11101111001101Accepted : Accepted table cap11101111001101Box cap11101111001101Tree := by
  apply acceptedSplit 1
  · have h : leftBox cap11101111001101Box 1 (midpoint cap11101111001101Box 1) = cap111011110011010Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap111011110011010Accepted
  · have h : rightBox cap11101111001101Box 1 (midpoint cap11101111001101Box 1) = cap111011110011011Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap111011110011011Accepted

def cap1110111100110Tree : Option PackedTree :=
  PackedTree.split 0 <$> cap11101111001100Tree <*> cap11101111001101Tree

theorem cap1110111100110Accepted : Accepted table cap1110111100110Box cap1110111100110Tree := by
  apply acceptedSplit 0
  · have h : leftBox cap1110111100110Box 0 (midpoint cap1110111100110Box 0) = cap11101111001100Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap11101111001100Accepted
  · have h : rightBox cap1110111100110Box 0 (midpoint cap1110111100110Box 0) = cap11101111001101Box := by
      funext i
      fin_cases i <;> decide +kernel
    simpa only [h] using cap11101111001101Accepted

end D5.S3.Quantum.Semigroups.WuCubicLowSpectrum.CapCover25
