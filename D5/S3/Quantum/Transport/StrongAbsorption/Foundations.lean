import Mathlib.Probability.Moments.MGFAnalytic
import Mathlib.Analysis.SpecialFunctions.Gaussian.GaussianIntegral


namespace D5.S3.Quantum.Transport.StrongAbsorption.Foundations
open MeasureTheory ProbabilityTheory Set Real Finset Filter Asymptotics
open scoped Topology

noncomputable def weight (M : ℕ) (γ : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) : ℝ :=
  if (∀ i, 0 ≤ p.1 i) ∧ (∀ j, 0 ≤ p.2 j ∧ p.2 j ≤ γ) then
    Real.exp (-(M : ℝ) * (∑ i, p.1 i + ∑ j, p.2 j)) *
      (∏ i, ∏ j, if i < j then (p.1 i - p.1 j) ^ 2 * (p.2 i - p.2 j) ^ 2 else 1) *
      ∏ i, ∏ j, (γ + p.1 i - p.2 j)
  else 0

noncomputable def tauW (M : ℕ) (γ : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) : ℝ :=
  (M : ℝ)⁻¹ * ∑ i, 1 / (γ + p.1 i)

theorem integrable_power_exp {a : ℝ} (ha : 0 < a) (k : ℕ) :
    IntegrableOn (fun x : ℝ => x^k * Real.exp (-(a*x))) (Ici 0) := by
  apply (integrableOn_Ici_iff_integrableOn_Ioi).mpr
  simpa only [Real.rpow_natCast, Real.rpow_one, neg_mul] using
    integrableOn_rpow_mul_exp_neg_mul_rpow (s := (k : ℝ))
      (p := 1) (b := a)
      (by exact lt_of_lt_of_le (by norm_num) (Nat.cast_nonneg k)) (by norm_num) ha

theorem power_exp_integral {a : ℝ} (ha : 0 < a) (k : ℕ) :
    (∫ x : ℝ in Ici 0, x^k * Real.exp (-(a*x))) = (k.factorial : ℝ) / a^(k+1) := by
  rw [integral_Ici_eq_integral_Ioi]
  have h := Real.integral_rpow_mul_exp_neg_mul_Ioi
    (show 0 < (k : ℝ)+1 by positivity) ha
  simp only [add_sub_cancel_right, Real.rpow_natCast] at h
  rw [h, Real.Gamma_nat_eq_factorial]
  simp only [Real.rpow_add (by positivity : 0 < 1/a), Real.rpow_natCast, Real.rpow_one]
  simp only [one_div, div_eq_mul_inv, pow_add, pow_one, mul_inv_rev, inv_pow]
  ring

noncomputable def rawWeight (M : ℕ) (γ : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) : ℝ :=
  Real.exp (-(M : ℝ) * ((∑ i, p.1 i) + ∑ j, p.2 j)) *
    (∏ i, ∏ j, if i < j then (p.1 i - p.1 j)^2 * (p.2 i - p.2 j)^2 else 1) *
    ∏ i, ∏ j, (γ + p.1 i - p.2 j)

def supportSet (M : ℕ) (γ : ℝ) : Set ((Fin M → ℝ) × (Fin M → ℝ)) :=
  (Set.univ.pi (Function.const (Fin M) (Set.Ici 0))) ×ˢ (Set.univ.pi (Function.const (Fin M) (Set.Icc 0 γ)))

def strictSupportSet (M : ℕ) (γ : ℝ) : Set ((Fin M → ℝ) × (Fin M → ℝ)) :=
  (Set.univ.pi (Function.const (Fin M) (Set.Ioi 0))) ×ˢ (Set.univ.pi (Function.const (Fin M) (Set.Ioo 0 γ)))

noncomputable def center (M : ℕ) (γ : ℝ) : (Fin M → ℝ) × (Fin M → ℝ) :=
  (fun i => (i.val : ℝ)+1, fun i => γ*((i.val : ℝ)+1)/((M : ℝ)+1))

noncomputable def orthantMeasure (M : ℕ) : Measure (Fin M → ℝ) :=
  Measure.pi (Function.const (Fin M) ((volume : Measure ℝ).restrict (Ici 0)))

theorem exp_sum_prod (M : ℕ) (a : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    Real.exp (-a*((∑ i, p.1 i)+∑ j, p.2 j)) =
      (∏ i, Real.exp (-(a*p.1 i))) * ∏ j, Real.exp (-(a*p.2 j)) := by
  rw [← Real.exp_sum, ← Real.exp_sum, ← Real.exp_add]
  congr 1
  simp_rw [Finset.sum_neg_distrib, ← Finset.mul_sum]
  ring

private noncomputable def densityPolynomial (M : ℕ) (γ : ℝ) : MvPolynomial (Fin M ⊕ Fin M) ℝ :=
  (∏ i, ∏ j, if i < j then
    (MvPolynomial.X (Sum.inl i) - MvPolynomial.X (Sum.inl j))^2 *
      (MvPolynomial.X (Sum.inr i) - MvPolynomial.X (Sum.inr j))^2 else 1) *
    ∏ i, ∏ j, (MvPolynomial.C γ + MvPolynomial.X (Sum.inl i) - MvPolynomial.X (Sum.inr j))

noncomputable def powerSum (M r : ℕ) (x : Fin M → ℝ) : ℝ := ∑ i, x i ^ r

private theorem cgf_affine {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    (X : Ω → ℝ) (hX : ∀ t : ℝ, Integrable (fun p => Real.exp (t*X p)) μ) (a b t : ℝ) :
    cgf (fun p => a+b*X p) μ t = t*a+cgf X μ (b*t) := by
  unfold cgf
  rw [mgf_const_add, mgf_const_mul, Real.log_mul (Real.exp_ne_zero _)
    (mgf_pos (hX (b*t))).ne', Real.log_exp]

private theorem pow_linear_remainder (k : ℕ) {u z : ℝ} (hu : 0 ≤ u) (huz : u ≤ z) :
    0 ≤ u^(k+2)-z^(k+2)+(k+2 : ℝ)*z^(k+1)*(z-u) ∧
    u^(k+2)-z^(k+2)+(k+2 : ℝ)*z^(k+1)*(z-u) ≤
      ((k+2 : ℝ)*(k+1)/2)*(z-u)^2*z^k := by
  have hz : 0 ≤ z := hu.trans huz
  have hd : 0 ≤ z-u := sub_nonneg.mpr huz
  induction k with
  | zero => norm_num; constructor <;> nlinarith [sq_nonneg (z-u)]
  | succ k ih =>
    let E := u^(k+2)-z^(k+2)+(k+2 : ℝ)*z^(k+1)*(z-u)
    have he : u^(k+1+2)-z^(k+1+2)+(k+1+2 : ℝ)*z^(k+1+1)*(z-u) =
      u*E+(k+2 : ℝ)*z^(k+1)*(z-u)^2 := by
      dsimp [E]
      simp only [pow_succ]
      ring
    have hn : 0 ≤ (k+2 : ℝ)*z^(k+1)*(z-u)^2 := by positivity
    simp only [Nat.cast_add, Nat.cast_one]
    constructor
    · rw [he]
      exact add_nonneg (mul_nonneg hu ih.1) hn
    · rw [he]
      calc
        _ ≤ u*(((k+2 : ℝ)*(k+1)/2)*(z-u)^2*z^k)+(k+2 : ℝ)*z^(k+1)*(z-u)^2 :=
          add_le_add (mul_le_mul_of_nonneg_left ih.2 hu) le_rfl
        _ ≤ z*(((k+2 : ℝ)*(k+1)/2)*(z-u)^2*z^k)+(k+2 : ℝ)*z^(k+1)*(z-u)^2 := by
          exact add_le_add (mul_le_mul_of_nonneg_right huz (show 0 ≤ ((k+2 : ℝ)*(k+1)/2)*(z-u)^2*z^k by positivity)) le_rfl
        _ = _ := by simp only [pow_succ]; ring

def FirstOrder (f : ℝ → ℝ) (a b : ℝ) : Prop :=
  (fun γ => f γ-a-b*γ⁻¹) =O[atTop] (fun γ => γ⁻¹^2)

noncomputable def gammaCGF (d : ℝ) (t : ℝ) : ℝ := -d*Real.log (1-t/d)

noncomputable def correctionCGF (d : ℝ) (t : ℝ) : ℝ := t/(1-t/d)-2*t/(1-t/d)^2

noncomputable def inverseSlope (d : ℝ) (t : ℝ) : ℝ := (1-t/d)⁻¹

private theorem moment_cumulant_recurrence {Ω : Type*} [MeasurableSpace Ω]
    {μ : Measure Ω} [IsProbabilityMeasure μ] (X : Ω → ℝ)
    (hX : ∀ t : ℝ, Integrable (fun ω => Real.exp (t*X ω)) μ) (n : ℕ) :
    iteratedDeriv (n+1) (cgf X μ) 0 = (∫ ω, X ω^(n+1) ∂μ)-
      ∑ i ∈ range n, (n.choose i : ℝ)*iteratedDeriv (i+1) (cgf X μ) 0*
        (∫ ω, X ω^(n-i) ∂μ) := by
  have hs : integrableExpSet X μ = Set.univ :=
    eq_univ_of_univ_subset (fun {t} _ => hX t)
  have ht (t : ℝ) : t ∈ interior (integrableExpSet X μ) := by simp [hs]
  have hc (t : ℝ) : AnalyticAt ℝ (cgf X μ) t := analyticAt_cgf (ht t)
  have hm (t : ℝ) : AnalyticAt ℝ (mgf X μ) t := analyticAt_mgf (ht t)
  have he : deriv (mgf X μ) = fun t => deriv (cgf X μ) t*mgf X μ t := by
    funext t
    rw [deriv_cgf (ht t), deriv_mgf (ht t)]
    exact (div_mul_cancel₀ _ (mgf_pos (hX t)).ne').symm
  have h := congrArg (fun f : ℝ → ℝ => iteratedDeriv n f 0) he
  rw [← iteratedDeriv_succ', iteratedDeriv_mgf_zero (ht 0)] at h
  rw [iteratedDeriv_fun_mul (hc 0).deriv.contDiffAt (hm 0).contDiffAt] at h
  simp_rw [← iteratedDeriv_succ', iteratedDeriv_mgf_zero (ht 0)] at h
  simp only [Pi.pow_apply, Pi.one_apply] at h
  rw [Finset.sum_range_succ] at h
  simp only [Nat.choose_self, Nat.cast_one, one_mul, Nat.sub_self, pow_zero,
    integral_const, probReal_univ, smul_eq_mul, mul_one] at h
  linarith

noncomputable def law (M : ℕ) (γ : ℝ) : Measure ((Fin M → ℝ) × (Fin M → ℝ)) :=
  let μ := volume.withDensity (fun p => ENNReal.ofReal (weight M γ p))
  (μ Set.univ)⁻¹ • μ

theorem supportSet_membership (M : ℕ) (γ : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    p ∈ supportSet M γ ↔ (∀ i, 0 ≤ p.1 i) ∧ (∀ j, 0 ≤ p.2 j ∧ p.2 j ≤ γ) := by
  simp [supportSet, Pi.le_def, forall_and]

private theorem isClosed_supportSet (M : ℕ) (γ : ℝ) : IsClosed (supportSet M γ) := by
  unfold supportSet
  exact (isClosed_set_pi fun _ _ => isClosed_Ici).prod (isClosed_set_pi fun _ _ => isClosed_Icc)

private theorem continuous_rawWeight (M : ℕ) (γ : ℝ) : Continuous (rawWeight M γ) := by
  unfold rawWeight
  apply Continuous.mul
  · apply Continuous.mul
    · fun_prop
    · apply continuous_finsetProd
      intro i _
      apply continuous_finsetProd
      intro j _
      split_ifs <;> fun_prop
  · fun_prop

theorem weight_nonneg (M : ℕ) (γ : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    0 ≤ weight M γ p := by
  unfold weight
  split_ifs with h
  · apply mul_nonneg
    · apply mul_nonneg (Real.exp_pos _).le
      apply Finset.prod_nonneg
      intro i _
      apply Finset.prod_nonneg
      intro j _
      split_ifs
      · exact mul_nonneg (sq_nonneg _) (sq_nonneg _)
      · exact zero_le_one
    · apply Finset.prod_nonneg
      intro i _
      apply Finset.prod_nonneg
      intro j _
      linarith [h.1 i, (h.2 j).2]
  · exact le_refl _

private theorem rawWeight_pos {M : ℕ} {γ : ℝ} (p : (Fin M → ℝ) × (Fin M → ℝ))
    (hx : ∀ i, 0 < p.1 i) (hy : ∀ j, p.2 j < γ)
    (hxi : Function.Injective p.1) (hyi : Function.Injective p.2) :
    0 < rawWeight M γ p := by
  unfold rawWeight
  apply mul_pos
  · apply mul_pos (Real.exp_pos _)
    apply Finset.prod_pos
    intro i _
    apply Finset.prod_pos
    intro j _
    split_ifs with hij
    · apply mul_pos
      · exact sq_pos_of_ne_zero (sub_ne_zero.mpr (fun h => (ne_of_lt hij) (hxi h)))
      · exact sq_pos_of_ne_zero (sub_ne_zero.mpr (fun h => (ne_of_lt hij) (hyi h)))
    · exact zero_lt_one
  · apply Finset.prod_pos
    intro i _
    apply Finset.prod_pos
    intro j _
    linarith [hx i, hy j]

theorem strictSupportSet_membership (M : ℕ) (γ : ℝ)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    p ∈ strictSupportSet M γ ↔ (∀ i, 0 < p.1 i) ∧ (∀ j, 0 < p.2 j ∧ p.2 j < γ) := by
  simp [strictSupportSet, Set.mem_pi]

private theorem isOpen_strictSupportSet (M : ℕ) (γ : ℝ) : IsOpen (strictSupportSet M γ) := by
  exact (isOpen_set_pi Set.finite_univ fun _ _ => isOpen_Ioi).prod
    (isOpen_set_pi Set.finite_univ fun _ _ => isOpen_Ioo)

theorem orthant_restrict (M : ℕ) :
    (volume : Measure ((Fin M → ℝ) × (Fin M → ℝ))).restrict ((Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))) =
      (orthantMeasure M).prod (orthantMeasure M) := by
  rw [Measure.volume_eq_prod]
  change ((volume : Measure (Fin M → ℝ)).prod volume).restrict ((Set.Ici (0 : Fin M → ℝ)) ×ˢ (Set.Ici 0)) = _
  rw [← Measure.prod_restrict, ← Set.pi_univ_Ici (0 : Fin M → ℝ)]
  simp only [Function.const, volume_pi, Measure.restrict_pi_pi, orthantMeasure]
  rfl

theorem polynomial_exp_integrable {M : ℕ} {a : ℝ} (ha : 0 < a)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    Integrable (fun p : (Fin M → ℝ) × (Fin M → ℝ) =>
      Real.exp (-a*((∑ i, p.1 i)+∑ j, p.2 j)) *
        MvPolynomial.eval (Sum.elim p.1 p.2) P)
      ((orthantMeasure M).prod (orthantMeasure M)) := by
  simp_rw [exp_sum_prod, MvPolynomial.eval_eq', Finset.mul_sum]
  apply integrable_finsetSum
  intro d _
  have h1 : Integrable (fun x : Fin M → ℝ => ∏ i, x i ^ d (Sum.inl i) * Real.exp (-(a*x i)))
      (orthantMeasure M) := Integrable.fintype_prod (fun i => integrable_power_exp ha _)
  have h2 : Integrable (fun y : Fin M → ℝ => ∏ i, y i ^ d (Sum.inr i) * Real.exp (-(a*y i)))
      (orthantMeasure M) := Integrable.fintype_prod (fun i => integrable_power_exp ha _)
  have h := (h1.mul_prod h2).const_mul (P.coeff d)
  apply h.congr
  filter_upwards [] with p
  simp only [Fintype.prod_sum_type, Sum.elim_inl, Sum.elim_inr, Finset.prod_mul_distrib]
  ring

private theorem densityPolynomial_eval (M : ℕ) (γ : ℝ)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    MvPolynomial.eval (Sum.elim p.1 p.2) (densityPolynomial M γ) =
      (∏ i, ∏ j, if i < j then (p.1 i-p.1 j)^2 * (p.2 i-p.2 j)^2 else 1) *
        ∏ i, ∏ j, (γ+p.1 i-p.2 j) := by
  simp only [densityPolynomial, map_mul, map_prod, map_sub, map_add, map_pow,
    MvPolynomial.eval_X, MvPolynomial.eval_C, Sum.elim_inl, Sum.elim_inr]
  congr 1
  apply Finset.prod_congr rfl
  intro i _
  apply Finset.prod_congr rfl
  intro j _
  split_ifs <;> simp

private theorem tauW_mem_Icc {M : ℕ} (hM : 1 ≤ M) {γ : ℝ} (hγ : 0 < γ)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) (hx : ∀ i, 0 ≤ p.1 i) :
    tauW M γ p ∈ Set.Icc 0 γ⁻¹ := by
  have hmpos : 0 < (M : ℝ) := Nat.cast_pos'.mpr hM
  have h1 (i : Fin M) : 0 ≤ 1/(γ+p.1 i) := by have := hx i; positivity
  have h2 (i : Fin M) : 1/(γ+p.1 i) ≤ γ⁻¹ := by
    rw [one_div]
    apply inv_anti₀ hγ
    linarith [hx i]
  constructor
  · exact mul_nonneg (inv_nonneg.mpr hmpos.le) (Finset.sum_nonneg fun i _ => h1 i)
  · unfold tauW
    calc
      _ ≤ (M : ℝ)⁻¹ * (∑ i : Fin M, γ⁻¹) :=
        mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun i _ => h2 i) (inv_nonneg.mpr hmpos.le)
      _ = γ⁻¹ := by simp [mul_assoc, hmpos.ne']

private theorem cumulant_affine {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω} [IsProbabilityMeasure μ]
    (X : Ω → ℝ) (hX : ∀ t : ℝ, Integrable (fun p => Real.exp (t*X p)) μ)
    {n : ℕ} (hn : 2 ≤ n) (a b : ℝ) :
    iteratedDeriv n (cgf (fun p => a+b*X p) μ) 0 = b^n*iteratedDeriv n (cgf X μ) 0 := by
  have hset : integrableExpSet X μ = Set.univ :=
    eq_univ_of_univ_subset (fun {t} _ => hX t)
  have hc : ContDiff ℝ n (cgf X μ) := by
    apply contDiff_iff_contDiffAt.mpr
    intro t
    apply AnalyticAt.contDiffAt
    apply analyticAt_cgf
    simp [hset]
  have he : cgf (fun p => a+b*X p) μ = fun t => t*a+cgf X μ (b*t) := by
    funext t
    exact cgf_affine X hX a b t
  rw [he, iteratedDeriv_fun_add (by fun_prop) (by fun_prop)]
  rw [iteratedDeriv_comp_const_mul hc]
  have hn0 : n ≠ 0 := Nat.ne_zero_of_lt hn
  have hn1 : n ≠ 1 := Ne.symm (Nat.ne_of_lt hn)
  simp [iteratedDeriv_mul_const_field, iteratedDeriv_fun_id, hn0, hn1]

noncomputable def rescaledObservable (M : ℕ) (γ : ℝ)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) : ℝ := γ^2*(γ⁻¹-tauW M γ p)

private theorem vObservable_bounds (M : ℕ) {ε : ℝ} (hε : 0 ≤ ε)
    (x : Fin M → ℝ) (hx : ∀ i, 0 ≤ x i) :
    0 ≤ (Finset.univ.expect (fun i => x i^3/(1+ε*x i))) ∧ (Finset.univ.expect (fun i => x i^3/(1+ε*x i))) ≤ (M : ℝ)⁻¹*powerSum M 3 x := by
  simp only [Finset.expect, NNRat.smul_def, Finset.card_univ, Fintype.card_fin, NNRat.cast_inv, NNRat.cast_natCast]
  have hm : 0 ≤ (M : ℝ)⁻¹ := by positivity
  constructor
  · apply mul_nonneg hm
    apply Finset.sum_nonneg
    intro i _
    have := hx i
    positivity
  · apply mul_le_mul_of_nonneg_left _ hm
    apply Finset.sum_le_sum
    intro i _
    have hxi := hx i
    have hd : 0 < 1+ε*x i := by positivity
    apply (div_le_iff₀ hd).mpr
    have := hx i
    nlinarith [mul_nonneg (mul_nonneg hε (hx i)) (pow_nonneg (hx i) 3)]

theorem FirstOrder.tendsto {f : ℝ → ℝ} {a b : ℝ} (h : FirstOrder f a b) :
    Tendsto f atTop (𝓝 a) := by
  have hi : Tendsto (fun γ : ℝ => γ⁻¹) atTop (𝓝 0) := tendsto_inv_atTop_zero
  have hr := h.trans_tendsto (by simpa using hi.pow 2)
  have hh := hr.add ((tendsto_const_nhds (x := a)).add ((tendsto_const_nhds (x := b)).mul hi))
  convert hh using 1 <;> simp <;> ring

theorem FirstOrder.const (a : ℝ) : FirstOrder (Function.const ℝ a) a 0 := by
  simp only [FirstOrder, Function.const, sub_self, zero_mul, sub_zero]
  exact isBigO_zero _ _

theorem FirstOrder.add {f g : ℝ → ℝ} {a b c d : ℝ}
    (hf : FirstOrder f a b) (hg : FirstOrder g c d) :
    FirstOrder (fun γ => f γ+g γ) (a+c) (b+d) := by
  exact (Asymptotics.IsBigO.add hf hg).congr_left (fun γ => by ring)

theorem FirstOrder.const_mul {f : ℝ → ℝ} {a b : ℝ} (h : FirstOrder f a b) (c : ℝ) :
    FirstOrder (fun γ => c*f γ) (c*a) (c*b) := by
  exact (h.const_mul_left c).congr_left (fun γ => by ring)

theorem FirstOrder.sum {σ : Type*} (s : Finset σ) (f : σ → ℝ → ℝ) (a b : σ → ℝ)
    (h : ∀ i ∈ s, FirstOrder (f i) (a i) (b i)) :
    FirstOrder (fun γ => ∑ i ∈ s, f i γ) (∑ i ∈ s, a i) (∑ i ∈ s, b i) := by
  have hh := Asymptotics.IsBigO.sum h
  exact hh.congr_left (fun γ => by
    simp only [Finset.sum_sub_distrib, Finset.sum_mul, Finset.sum_apply])

theorem FirstOrder.eventual_bound {f : ℝ → ℝ} {a b : ℝ} (h : FirstOrder f a b) :
    ∃ C γ₀ : ℝ, 0 < γ₀ ∧ ∀ γ : ℝ, γ₀ ≤ γ → |f γ-a-b/γ| ≤ C/γ^2 := by
  obtain ⟨C, hC⟩ := h.isBigOWith
  obtain ⟨G, hG⟩ := Filter.eventually_atTop.mp hC.bound
  refine ⟨C, max G 1, lt_of_lt_of_le zero_lt_one (le_max_right _ _), ?_⟩
  intro γ hγ
  have hpos : 0 < γ := lt_of_lt_of_le zero_lt_one ((le_max_right G 1).trans hγ)
  have h := hG γ ((le_max_left G 1).trans hγ)
  simpa only [Real.norm_eq_abs, abs_pow, abs_inv, abs_of_pos hpos,
    div_eq_mul_inv, inv_pow] using h

private theorem inverseSlope_affine (d : ℝ) : inverseSlope d = fun t => ((-d⁻¹)*t+1)⁻¹ := by
  funext t
  unfold inverseSlope
  congr 1
  ring

theorem gammaCGF_deriv {d : ℝ} (hd : d ≠ 0) : deriv (gammaCGF d) = inverseSlope d := by
  funext t
  unfold gammaCGF
  rw [deriv_const_mul_field']
  have h := deriv_comp_mul_left (-d⁻¹) (fun u : ℝ => Real.log (u+1)) t
  rw [deriv_comp_add_const, Real.deriv_log] at h
  have he : (fun t : ℝ => Real.log (1-t/d)) = fun t => Real.log ((-d⁻¹)*t+1) := by
    funext t
    congr 1
    ring
  rw [he]
  dsimp only
  rw [h]
  simp only [smul_eq_mul]
  unfold inverseSlope
  have hs : (-d⁻¹)*t+1 = 1-t/d := by ring
  rw [hs]
  field_simp

noncomputable def kappa (M n : ℕ) (γ : ℝ) : ℝ :=
  iteratedDeriv n (cgf (tauW M γ) (law M γ)) 0

private theorem weight_indicator (M : ℕ) (γ : ℝ) :
    weight M γ = (supportSet M γ).indicator (rawWeight M γ) := by
  funext p
  simp only [weight, Set.indicator, supportSet_membership]
  rfl

private theorem law_isProbability_of_mass {M : ℕ} {γ : ℝ}
    (h0 : (volume.withDensity (fun p => ENNReal.ofReal (weight M γ p))) Set.univ ≠ 0)
    (hfin : (volume.withDensity (fun p => ENNReal.ofReal (weight M γ p))) Set.univ ≠ ⊤) :
    IsProbabilityMeasure (law M γ) := by
  let μ := volume.withDensity (fun p => ENNReal.ofReal (weight M γ p))
  have hm0 : μ Set.univ ≠ 0 := h0
  have hmfin : μ Set.univ ≠ ⊤ := hfin
  letI : IsFiniteMeasure μ := ⟨lt_top_iff_ne_top.mpr hmfin⟩
  letI : NeZero μ := ⟨Measure.measure_univ_ne_zero.mp hm0⟩
  change IsProbabilityMeasure ((μ Set.univ)⁻¹ • μ)
  exact MeasureTheory.isProbabilityMeasureSMul

theorem center_properties (M : ℕ) {γ : ℝ} (hγ : 0 < γ) :
    center M γ ∈ strictSupportSet M γ ∧ Function.Injective (center M γ).1 ∧
      Function.Injective (center M γ).2 := by
  have hden : 0 < (M : ℝ)+1 := Nat.cast_add_one_pos M
  have hcoord (i : Fin M) : 0 < (i.val : ℝ)+1 ∧ (i.val : ℝ)+1 < (M : ℝ)+1 := by
    have hi : (i.val : ℝ) < M := by exact_mod_cast i.isLt
    constructor
    · positivity
    · linarith
  constructor
  · rw [strictSupportSet_membership]
    constructor
    · exact fun i => (hcoord i).1
    · intro i
      change 0 < γ*((i.val : ℝ)+1)/((M : ℝ)+1) ∧ γ*((i.val : ℝ)+1)/((M : ℝ)+1) < γ
      constructor
      · exact div_pos (mul_pos hγ (hcoord i).1) hden
      · apply (div_lt_iff₀ hden).mpr
        exact mul_lt_mul_of_pos_left (hcoord i).2 hγ
  · constructor
    · intro i j h
      apply Fin.ext
      change (i.val : ℝ)+1 = (j.val : ℝ)+1 at h
      exact_mod_cast (add_right_cancel h)
    · intro i j h
      apply Fin.ext
      change γ*((i.val : ℝ)+1)/((M : ℝ)+1) = γ*((j.val : ℝ)+1)/((M : ℝ)+1) at h
      have hmul := (div_left_inj' hden.ne').mp h
      have hcast := mul_left_cancel₀ hγ.ne' hmul
      exact_mod_cast (add_right_cancel hcast)

private theorem rescaledObservable_mem_Icc {M : ℕ} (hM : 1 ≤ M) {γ : ℝ} (hγ : 0 < γ)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) (hx : ∀ i, 0 ≤ p.1 i) :
    rescaledObservable M γ p ∈ Set.Icc 0 γ := by
  have h := tauW_mem_Icc hM hγ p hx
  have he : γ^2*γ⁻¹ = γ := by simpa only [pow_two] using mul_self_mul_inv γ
  unfold rescaledObservable
  constructor
  · exact mul_nonneg (sq_nonneg γ) (sub_nonneg.mpr h.2)
  · nlinarith [mul_nonneg (sq_nonneg γ) h.1]

private theorem uObservable_expansion (M : ℕ) {ε : ℝ} (hε : 0 ≤ ε)
    (x : Fin M → ℝ) (hx : ∀ i, 0 ≤ x i) :
    (Finset.univ.expect (fun i => x i/(1+ε*x i))) = (Finset.univ.expect x)-ε*(Finset.univ.expect (fun i => x i^2))+ε^2*(Finset.univ.expect (fun i => x i^3/(1+ε*x i))) := by
  have he (i : Fin M) : x i/(1+ε*x i) = x i-ε*x i^2+ε^2*(x i^3/(1+ε*x i)) := by
    have hxi := hx i
    have hd : 1+ε*x i ≠ 0 := ne_of_gt (by positivity)
    field_simp [hd]
    ring
  simp only [Finset.expect, NNRat.smul_def, Finset.card_univ, Fintype.card_fin, NNRat.cast_inv, NNRat.cast_natCast, powerSum]
  simp_rw [he, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
  ring

private theorem uObservable_bounds (M : ℕ) {ε : ℝ} (hε : 0 ≤ ε)
    (x : Fin M → ℝ) (hx : ∀ i, 0 ≤ x i) :
    0 ≤ (Finset.univ.expect (fun i => x i/(1+ε*x i))) ∧ (Finset.univ.expect (fun i => x i/(1+ε*x i))) ≤ (Finset.univ.expect x) := by
  simp only [Finset.expect, NNRat.smul_def, Finset.card_univ, Fintype.card_fin, NNRat.cast_inv, NNRat.cast_natCast]
  have hm : 0 ≤ (M : ℝ)⁻¹ := by positivity
  constructor
  · exact mul_nonneg hm (Finset.sum_nonneg (fun i _ => div_nonneg (hx i) (by nlinarith [mul_nonneg hε (hx i)])))
  · apply mul_le_mul_of_nonneg_left _ hm
    apply Finset.sum_le_sum
    intro i _
    have hxi := hx i
    have hd : 0 < 1+ε*x i := by positivity
    apply (div_le_iff₀ hd).mpr
    nlinarith [mul_nonneg hε (sq_nonneg (x i))]

theorem rescaledObservable_eq_u {M : ℕ} (hM : 1 ≤ M) {γ : ℝ} (hγ : 0 < γ)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) (hx : ∀ i, 0 ≤ p.1 i) :
    rescaledObservable M γ p = (Finset.univ.expect (fun i => p.1 i/(1+γ⁻¹*p.1 i))) := by
  have hm : (M : ℝ) ≠ 0 := by exact_mod_cast (show M ≠ 0 by omega)
  have hΓ (i : Fin M) : γ+p.1 i ≠ 0 := ne_of_gt (by linarith [hx i])
  have hi (i : Fin M) : γ^2*(γ⁻¹-1/(γ+p.1 i)) = p.1 i/(1+γ⁻¹*p.1 i) := by
    field_simp [hγ.ne', hΓ i]
    ring
  have hs : γ⁻¹ = (M : ℝ)⁻¹*∑ _i : Fin M, γ⁻¹ := by simp [hm]
  simp only [rescaledObservable, tauW, Finset.expect, NNRat.smul_def, Finset.card_univ, Fintype.card_fin, NNRat.cast_inv, NNRat.cast_natCast]
  calc
    _ = γ^2*((M : ℝ)⁻¹*(∑ _i : Fin M, γ⁻¹)-(M : ℝ)⁻¹*∑ i, 1/(γ+p.1 i)) := by rw [← hs]
    _ = (M : ℝ)⁻¹*∑ i : Fin M, γ^2*(γ⁻¹-1/(γ+p.1 i)) := by
      rw [← mul_sub, ← Finset.sum_sub_distrib, mul_left_comm, Finset.mul_sum]
    _ = _ := by simp_rw [hi]

private theorem FirstOrder.neg {f : ℝ → ℝ} {a b : ℝ} (h : FirstOrder f a b) :
    FirstOrder (fun γ => -f γ) (-a) (-b) := by
  simpa only [neg_one_mul] using h.const_mul (-1)

theorem FirstOrder.mul {f g : ℝ → ℝ} {a b c d : ℝ}
    (hf : FirstOrder f a b) (hg : FirstOrder g c d) :
    FirstOrder (fun γ => f γ*g γ) (a*c) (a*d+b*c) := by
  have hi : Tendsto (fun γ : ℝ => γ⁻¹) atTop (𝓝 0) := tendsto_inv_atTop_zero
  have hga : g =O[atTop] (fun _ => (1 : ℝ)) := isBigO_const_of_tendsto hg.tendsto one_ne_zero
  have haa : (fun γ : ℝ => a+b*γ⁻¹) =O[atTop] (fun _ => (1 : ℝ)) :=
    isBigO_const_of_tendsto (tendsto_const_nhds.add (tendsto_const_nhds.mul hi)) one_ne_zero
  have h1 := Asymptotics.IsBigO.mul hf hga
  have h2 := Asymptotics.IsBigO.mul haa hg
  have h3 : (fun γ : ℝ => b*d*γ⁻¹^2) =O[atTop] (fun γ : ℝ => γ⁻¹^2) :=
    isBigO_const_mul_self (b*d) (fun γ : ℝ => γ⁻¹^2) atTop
  simp only [mul_one, one_mul] at h1 h2
  have h := Asymptotics.IsBigO.add (Asymptotics.IsBigO.add h1 h2) h3
  exact h.congr_left (fun γ => by ring)

theorem inverseSlope_deriv (d : ℝ) : deriv (inverseSlope d) = fun t => d⁻¹*(inverseSlope d t)^2 := by
  funext t
  rw [inverseSlope_affine]
  have h := congrFun (iter_deriv_inv_linear (𝕜 := ℝ) 1 (-d⁻¹) 1) t
  simp only [Function.iterate_one, pow_one, Nat.factorial_one, Nat.cast_one, mul_one] at h
  rw [h]
  norm_num

private theorem inverseSlope_iterated (d : ℝ) (n : ℕ) :
    iteratedDeriv n (inverseSlope d) 0 = (n.factorial : ℝ)*d⁻¹^n := by
  rw [inverseSlope_affine, iteratedDeriv_eq_iterate, iter_deriv_inv_linear]
  simp only [mul_zero, zero_add, one_zpow, mul_one]
  have hs : (-1 : ℝ)^n*(-d⁻¹)^n = d⁻¹^n := by
    rw [← mul_pow]
    congr 1
    ring
  calc
    _ = (n.factorial : ℝ)*((-1 : ℝ)^n*(-d⁻¹)^n) := by ring
    _ = _ := congrArg (fun v => (n.factorial : ℝ)*v) hs

theorem measurable_weight (M : ℕ) (γ : ℝ) : Measurable (weight M γ) := by
  rw [weight_indicator]
  exact (continuous_rawWeight M γ).measurable.indicator (isClosed_supportSet M γ).measurableSet

private theorem weight_integrable {M : ℕ} (hM : 1 ≤ M) (γ : ℝ) : Integrable (weight M γ) := by
  have hMpos : 0 < (M : ℝ) := Nat.cast_pos'.mpr hM
  have hi := polynomial_exp_integrable hMpos (densityPolynomial M γ)
  have hraw : IntegrableOn (rawWeight M γ) ((Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))) := by
    rw [IntegrableOn, orthant_restrict]
    have he : rawWeight M γ = (fun p : (Fin M → ℝ) × (Fin M → ℝ) =>
        Real.exp (-(M : ℝ)*((∑ i, p.1 i)+∑ j, p.2 j)) *
          MvPolynomial.eval (Sum.elim p.1 p.2) (densityPolynomial M γ)) := by
      funext p
      rw [densityPolynomial_eval]
      unfold rawWeight
      ring
    rw [he]
    exact hi
  have hs : supportSet M γ ⊆ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ))) := by
    intro p hp
    have h := (supportSet_membership M γ p).mp hp
    simpa only [Prod.le_def, Pi.le_def, Prod.fst_zero, Prod.snd_zero, Pi.zero_apply, forall_true_left,
      Set.mem_Ici, Function.const] using And.intro h.1 (fun j => (h.2 j).1)
  have hsmall := hraw.mono_set hs
  rw [weight_indicator]
  exact (integrable_indicator_iff (isClosed_supportSet M γ).measurableSet).mpr hsmall

theorem observable_power_remainder {M : ℕ} {ε : ℝ} (hε : 0 ≤ ε)
    (x : Fin M → ℝ) (hx : ∀ i, 0 ≤ x i) (k : ℕ) :
    |(Finset.univ.expect (fun i => x i/(1+ε*x i)))^(k+2)-(Finset.univ.expect x)^(k+2)+
      ε*(k+2 : ℝ)*(Finset.univ.expect (fun i => x i^2))*(Finset.univ.expect x)^(k+1)| ≤
    ε^2*(((k+2 : ℝ)*(k+1)/2)*((Finset.univ.expect (fun i => x i^2)))^2*(Finset.univ.expect x)^k+
      (k+2 : ℝ)*((M : ℝ)⁻¹*powerSum M 3 x)*(Finset.univ.expect x)^(k+1)) := by
  let u := (Finset.univ.expect (fun i => x i/(1+ε*x i)))
  let z := (Finset.univ.expect x)
  let w := (Finset.univ.expect (fun i => x i^2))
  let v := (Finset.univ.expect (fun i => x i^3/(1+ε*x i)))
  let q := (M : ℝ)⁻¹*powerSum M 3 x
  have hb := uObservable_bounds M hε x hx
  have hv := vObservable_bounds M hε x hx
  have he := uObservable_expansion M hε x hx
  have hu : 0 ≤ u := hb.1
  have huz : u ≤ z := hb.2
  have hz : 0 ≤ z := hu.trans huz
  have hw : 0 ≤ w := by
    dsimp [w, Finset.expect, NNRat.smul_def, Finset.card_univ, Fintype.card_fin, NNRat.cast_inv, NNRat.cast_natCast, powerSum]
    positivity
  have hv0 : 0 ≤ v := hv.1
  have hvq : v ≤ q := hv.2
  have hq : 0 ≤ q := hv0.trans hvq
  have he' : u = z-ε*w+ε^2*v := he
  have hd : 0 ≤ z-u := sub_nonneg.mpr huz
  have hdw : z-u ≤ ε*w := by nlinarith [mul_nonneg (sq_nonneg ε) hv0]
  have hsq : (z-u)^2 ≤ ε^2*w^2 := by nlinarith [mul_self_le_mul_self hd hdw]
  have hp := pow_linear_remainder k hu huz
  let e := u^(k+2)-z^(k+2)+(k+2 : ℝ)*z^(k+1)*(z-u)
  have he0 : 0 ≤ e := hp.1
  have heb : e ≤ ε^2*(((k+2 : ℝ)*(k+1)/2)*w^2*z^k) := by
    calc
      e ≤ ((k+2 : ℝ)*(k+1)/2)*(z-u)^2*z^k := hp.2
      _ ≤ ((k+2 : ℝ)*(k+1)/2)*(ε^2*w^2)*z^k := by
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hsq (by positivity)) (pow_nonneg hz _)
      _ = _ := by ring
  have heq : u^(k+2)-z^(k+2)+ε*(k+2 : ℝ)*w*z^(k+1) =
      e+ε^2*(k+2 : ℝ)*v*z^(k+1) := by dsimp [e]; rw [he']; ring
  change |u^(k+2)-z^(k+2)+ε*(k+2 : ℝ)*w*z^(k+1)| ≤ _
  rw [heq, abs_of_nonneg (add_nonneg he0 (by positivity))]
  calc
    _ ≤ ε^2*(((k+2 : ℝ)*(k+1)/2)*w^2*z^k)+ε^2*(k+2 : ℝ)*q*z^(k+1) := by
      exact add_le_add heb (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hvq (by positivity)) (pow_nonneg hz _))
    _ = _ := by dsimp [w,z,q]; ring

theorem observable_power_one {M : ℕ} {ε : ℝ} (hε : 0 ≤ ε)
    (x : Fin M → ℝ) (hx : ∀ i, 0 ≤ x i) :
    |(Finset.univ.expect (fun i => x i/(1+ε*x i)))-(Finset.univ.expect x)+ε*(Finset.univ.expect (fun i => x i^2))| ≤
      ε^2*((M : ℝ)⁻¹*powerSum M 3 x) := by
  rw [uObservable_expansion M hε x hx]
  have he : (Finset.univ.expect x)-ε*(Finset.univ.expect (fun i => x i^2))+ε^2*(Finset.univ.expect (fun i => x i^3/(1+ε*x i)))-
      (Finset.univ.expect x)+ε*(Finset.univ.expect (fun i => x i^2)) = ε^2*(Finset.univ.expect (fun i => x i^3/(1+ε*x i))) := by ring
  rw [he, abs_of_nonneg (mul_nonneg (sq_nonneg ε) (vObservable_bounds M hε x hx).1)]
  exact mul_le_mul_of_nonneg_left (vObservable_bounds M hε x hx).2 (sq_nonneg ε)

theorem FirstOrder.sub {f g : ℝ → ℝ} {a b c d : ℝ}
    (hf : FirstOrder f a b) (hg : FirstOrder g c d) :
    FirstOrder (fun γ => f γ-g γ) (a-c) (b-d) := by
  simpa only [sub_eq_add_neg] using hf.add hg.neg

theorem gammaCGF_iterated {d : ℝ} (hd : d ≠ 0) (n : ℕ) :
    iteratedDeriv (n+1) (gammaCGF d) 0 = (n.factorial : ℝ)/d^n := by
  rw [iteratedDeriv_succ', gammaCGF_deriv hd, inverseSlope_iterated]
  simp [div_eq_mul_inv]

private theorem correctionCGF_eq_near {d : ℝ} (hd : d ≠ 0) :
    correctionCGF d =ᶠ[𝓝 (0 : ℝ)]
      (fun t => d*(3*inverseSlope d t-2*d*deriv (inverseSlope d) t-1)) := by
  have hc : Continuous (fun t : ℝ => 1-t/d) := by fun_prop
  have hn : ∀ᶠ t : ℝ in 𝓝 0, (1-t/d) ≠ 0 := by
    exact ((isClosed_singleton : IsClosed ({0} : Set ℝ)).isOpen_compl.preimage hc).mem_nhds (by simp)
  filter_upwards [hn] with t ht
  rw [inverseSlope_deriv]
  dsimp [correctionCGF, inverseSlope]
  have hdt : d-t ≠ 0 := by
    intro hh
    have he : t = d := (sub_eq_zero.mp hh).symm
    subst t
    simp [hd] at ht
  have he : 1-t/d = (d-t)/d := one_sub_div hd
  rw [he]
  field_simp [hd, hdt]
  ring

theorem mass_pos (M : ℕ) {γ : ℝ} (hγ : 0 < γ) :
    0 < (volume.withDensity (fun p => ENNReal.ofReal (weight M γ p))) Set.univ := by
  let U : Set ((Fin M → ℝ) × (Fin M → ℝ)) :=
    strictSupportSet M γ ∩ {p | 0 < rawWeight M γ p}
  have hUopen : IsOpen U := (isOpen_strictSupportSet M γ).inter
    (isOpen_lt continuous_const (continuous_rawWeight M γ))
  have hUne : U.Nonempty := by
    refine ⟨center M γ, (center_properties M hγ).1, ?_⟩
    have hs := (strictSupportSet_membership M γ (center M γ)).mp (center_properties M hγ).1
    exact rawWeight_pos _ hs.1 (fun i => (hs.2 i).2) (center_properties M hγ).2.1
      (center_properties M hγ).2.2
  have hsub : U ⊆ Function.support (fun p => ENNReal.ofReal (weight M γ p)) := by
    intro p hp
    have hs := (strictSupportSet_membership M γ p).mp hp.1
    have hm : p ∈ supportSet M γ := (supportSet_membership M γ p).mpr
      ⟨fun i => (hs.1 i).le, fun j => ⟨(hs.2 j).1.le, (hs.2 j).2.le⟩⟩
    change ENNReal.ofReal (weight M γ p) ≠ 0
    rw [weight_indicator, Set.indicator_of_mem hm]
    exact ne_of_gt (ENNReal.ofReal_pos.mpr hp.2)
  rw [MeasureTheory.withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  apply (lintegral_pos_iff_support (measurable_weight M γ).ennreal_ofReal).mpr
  exact lt_of_lt_of_le (hUopen.measure_pos volume hUne) (measure_mono hsub)

private theorem mass_finite {M : ℕ} (hM : 1 ≤ M) (γ : ℝ) :
    (volume.withDensity (fun p => ENNReal.ofReal (weight M γ p))) Set.univ < ⊤ := by
  rw [MeasureTheory.withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
  exact (weight_integrable hM γ).lintegral_lt_top

theorem law_ae_support (M : ℕ) (γ : ℝ) : ∀ᵐ p ∂law M γ, p ∈ supportSet M γ := by
  rw [ae_iff]
  change law M γ (supportSet M γ)ᶜ = 0
  unfold law
  rw [Measure.smul_apply, MeasureTheory.withDensity_apply _ (isClosed_supportSet M γ).measurableSet.compl]
  have he : ∫⁻ p in (supportSet M γ)ᶜ, ENNReal.ofReal (weight M γ p) = 0 := by
    rw [lintegral_eq_zero_iff]
    · apply (ae_restrict_iff' (isClosed_supportSet M γ).measurableSet.compl).mpr
      filter_upwards [] with p hp
      rw [weight_indicator, Set.indicator_of_notMem hp, ENNReal.ofReal_zero]
      rfl
    · exact (measurable_weight M γ).ennreal_ofReal
  rw [he, smul_zero]

theorem law_integral {M : ℕ} (hM : 1 ≤ M) (γ : ℝ)
    (f : (Fin M → ℝ) × (Fin M → ℝ) → ℝ) :
    (∫ p, f p ∂law M γ) = (∫ p, weight M γ p*f p)/(∫ p, weight M γ p) := by
  have hn : ∀ᵐ p ∂(volume : Measure ((Fin M → ℝ) × (Fin M → ℝ))), 0 ≤ weight M γ p :=
    Filter.Eventually.of_forall (weight_nonneg M γ)
  have hm : (volume.withDensity (fun p => ENNReal.ofReal (weight M γ p))) Set.univ =
      ENNReal.ofReal (∫ p, weight M γ p) := by
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    exact (ofReal_integral_eq_lintegral_ofReal (weight_integrable hM γ) hn).symm
  unfold law
  rw [integral_smul_measure, hm, ENNReal.toReal_inv,
    integral_withDensity_eq_integral_toReal_smul (measurable_weight M γ).ennreal_ofReal
      (Filter.Eventually.of_forall (fun _ => ENNReal.ofReal_lt_top))]
  simp only [smul_eq_mul, ENNReal.toReal_ofReal (weight_nonneg M γ _),
    ENNReal.toReal_ofReal (integral_nonneg (weight_nonneg M γ))]
  ring

theorem correctionCGF_iterated {d : ℝ} (hd : d ≠ 0) {n : ℕ} (hn : 1 ≤ n) :
    iteratedDeriv n (correctionCGF d) 0 = -(2*n-1)*(n.factorial : ℝ)/d^(n-1) := by
  have hF : ContDiffAt ℝ n (inverseSlope d) 0 := by unfold inverseSlope; fun_prop (disch := simp)
  have hD : ContDiffAt ℝ n (deriv (inverseSlope d)) 0 := by
    rw [inverseSlope_deriv]
    unfold inverseSlope
    fun_prop (disch := simp)
  rw [(correctionCGF_eq_near hd).iteratedDeriv_eq]
  rw [iteratedDeriv_const_mul_field]
  have hg : ContDiffAt ℝ n (fun t => 3*inverseSlope d t-2*d*deriv (inverseSlope d) t) 0 := by fun_prop
  rw [iteratedDeriv_fun_sub hg (by fun_prop), iteratedDeriv_fun_sub (by fun_prop) (by fun_prop)]
  rw [iteratedDeriv_const_mul_field, iteratedDeriv_const_mul_field, ← iteratedDeriv_succ']
  rw [inverseSlope_iterated, inverseSlope_iterated]
  have hn0 : n ≠ 0 := Nat.ne_zero_of_lt hn
  simp only [iteratedDeriv_const, hn0, if_false, sub_zero]
  rw [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
  have he : n = (n-1)+1 := (Nat.sub_eq_iff_eq_add hn).mp rfl
  rw [he]
  simp only [pow_succ, div_eq_mul_inv, inv_pow]
  field_simp [hd]
  <;> ring_nf
  <;> simp only [Nat.add_sub_cancel_left]

theorem law_isProbability {M : ℕ} (hM : 1 ≤ M) {γ : ℝ} (hγ : 0 < γ) :
    IsProbabilityMeasure (law M γ) :=
  law_isProbability_of_mass (ne_of_gt (mass_pos M hγ)) (ne_of_lt (mass_finite hM γ))

theorem rescaledObservable_integrable_exp {M : ℕ} (hM : 1 ≤ M) {γ : ℝ} (hγ : 0 < γ)
    (t : ℝ) : Integrable (fun p => Real.exp (t*rescaledObservable M γ p)) (law M γ) := by
  letI := law_isProbability hM hγ
  apply integrable_exp_mul_of_mem_Icc (by unfold rescaledObservable tauW; fun_prop)
  filter_upwards [law_ae_support M γ] with p hp
  exact rescaledObservable_mem_Icc hM hγ p ((supportSet_membership M γ p).mp hp).1

theorem kappa_rescaled {M : ℕ} (hM : 1 ≤ M) {n : ℕ} (hn : 2 ≤ n) {γ : ℝ} (hγ : 0 < γ) :
    kappa M n γ = (-γ⁻¹^2)^n * iteratedDeriv n (cgf (rescaledObservable M γ) (law M γ)) 0 := by
  letI := law_isProbability hM hγ
  have he : tauW M γ = fun p => γ⁻¹+(-γ⁻¹^2)*rescaledObservable M γ p := by
    funext p
    unfold rescaledObservable
    field_simp
    ring
  unfold kappa
  rw [he]
  exact cumulant_affine (rescaledObservable M γ) (rescaledObservable_integrable_exp hM hγ) hn _ _

theorem rescaled_moment_cumulant {M : ℕ} (hM : 1 ≤ M) {γ : ℝ} (hγ : 0 < γ) (n : ℕ) :
    iteratedDeriv (n+1) (cgf (rescaledObservable M γ) (law M γ)) 0 =
      (∫ p, rescaledObservable M γ p^(n+1) ∂law M γ)-
        ∑ i ∈ range n, (n.choose i : ℝ)*
          iteratedDeriv (i+1) (cgf (rescaledObservable M γ) (law M γ)) 0*
          (∫ p, rescaledObservable M γ p^(n-i) ∂law M γ) := by
  letI := law_isProbability hM hγ
  exact moment_cumulant_recurrence _ (rescaledObservable_integrable_exp hM hγ) n

