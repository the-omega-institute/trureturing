private theorem product_budget {σ : Type*} (s : Finset σ) (a : σ → ℝ) :
    1+∑ i ∈ s, |a i| ≤ ∏ i ∈ s, (1+|a i|) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [Finset.sum_insert hi, Finset.prod_insert hi]
    have hs := Finset.sum_nonneg (fun j (_ : j ∈ s) => abs_nonneg (a j))
    have hm := mul_le_mul_of_nonneg_left ih (abs_nonneg (a i))
    nlinarith [mul_nonneg (abs_nonneg (a i)) hs]

noncomputable def crossProduct (M : ℕ) (ε : ℝ) (x y : Fin M → ℝ) : ℝ :=
  ∏ i, ∏ j, (1+ε*(x i-y j))

theorem crossProduct_firstOrder (M : ℕ) (x y : Fin M → ℝ) :
    (∑ p : Fin M × Fin M, (x p.1-y p.2)) =
      (M : ℝ)*((∑ i, x i)-(∑ j, y j)) := by
  rw [Fintype.sum_prod_type]
  simp [Finset.sum_sub_distrib, ← Finset.mul_sum]
  ring

noncomputable def jointSum (M : ℕ) (p : (Fin M → ℝ) × (Fin M → ℝ)) : ℝ :=
  (∑ i, p.1 i)+(∑ j, p.2 j)

def tailSet (M : ℕ) (γ : ℝ) : Set ((Fin M → ℝ) × (Fin M → ℝ)) :=
  {p | ∃ j, γ < p.2 j}

noncomputable def linearDensityPoly (M : ℕ) : MvPolynomial (Fin M ⊕ Fin M) ℝ :=
  C (M : ℝ)*((∑ i : Fin M, X (Sum.inl i))-(∑ j : Fin M, X (Sum.inr j)))

private noncomputable def crossPoly (M : ℕ) (ε : ℝ) : MvPolynomial (Fin M ⊕ Fin M) ℝ :=
  ∏ i : Fin M, ∏ j : Fin M, (1+C ε*(X (Sum.inl i)-X (Sum.inr j)))

private theorem exponential_tail_quadratic {c γ : ℝ} (hc : 0 < c) (hγ : 0 < γ) :
    Real.exp (-c*γ) ≤ 2/(c^2*γ^2) := by
  have h := Real.pow_div_factorial_le_exp (c*γ) (mul_nonneg hc.le hγ.le) 2
  norm_num only [Nat.factorial_succ, Nat.factorial_zero, Nat.cast_ofNat, Nat.cast_one, mul_one] at h
  have hmul := mul_le_mul_of_nonneg_right h (Real.exp_pos (-(c*γ))).le
  have he : Real.exp (c*γ)*Real.exp (-(c*γ)) = 1 := by
    rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
  rw [he] at hmul
  apply (le_div_iff₀ (by positivity : 0 < c^2*γ^2)).mpr
  rw [show -c*γ = -(c*γ) by ring]
  nlinarith

private theorem integral_quadratic_bigO {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : ℝ → Ω → ℝ) (g : Ω → ℝ) (hg : Integrable g μ)
    (h : ∀ᶠ γ : ℝ in atTop, ∀ᵐ p ∂μ, |f γ p| ≤ γ⁻¹^2*g p) :
    (fun γ => ∫ p, f γ p ∂μ) =O[atTop] (fun γ : ℝ => γ⁻¹^2) := by
  apply IsBigO.of_bound (∫ p, g p ∂μ)
  filter_upwards [h] with γ hγ
  have hi := norm_integral_le_of_norm_le (f := f γ) (hg.const_mul (γ⁻¹^2))
    (by simpa only [Real.norm_eq_abs] using hγ)
  rw [integral_const_mul] at hi
  simpa only [Real.norm_eq_abs, abs_pow, sq_abs, mul_comm] using hi

private theorem finiteProduct_remainder {σ : Type*} (s : Finset σ) (a : σ → ℝ)
    {ε : ℝ} (hε : 0 ≤ ε) (hε1 : ε ≤ 1) :
    |(∏ i ∈ s, (1+ε*a i))-1-ε*(∑ i ∈ s, a i)| ≤
      ε^2*((∏ i ∈ s, (1+|a i|))-1-∑ i ∈ s, |a i|) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.sum_insert hi, Finset.prod_insert hi, Finset.sum_insert hi]
    let P := ∏ j ∈ s, (1+|a j|)
    let A := ∑ j ∈ s, |a j|
    let E := (∏ j ∈ s, (1+ε*a j))-1-ε*(∑ j ∈ s, a j)
    have hbudget : 0 ≤ P-1-A := by have := product_budget s a; dsimp [P,A]; linarith
    have hsum : |∑ j ∈ s, a j| ≤ A := Finset.abs_sum_le_sum_abs _ _
    have hfactor : |1+ε*a i| ≤ 1+|a i| := by
      calc
        _ ≤ |(1 : ℝ)|+|ε*a i| := abs_add_le _ _
        _ = 1+ε * |a i| := by rw [abs_one, abs_mul, abs_of_nonneg hε]
        _ ≤ _ := by nlinarith [abs_nonneg (a i)]
    have heq : (1+ε*a i)*(∏ j ∈ s, (1+ε*a j))-1-ε*(a i+∑ j ∈ s, a j) =
      E*(1+ε*a i)+ε^2*a i*(∑ j ∈ s, a j) := by dsimp [E]; ring
    rw [heq]
    calc
      _ ≤ |E*(1+ε*a i)|+|ε^2*a i*(∑ j ∈ s, a j)| := abs_add_le _ _
      _ = |E| * |1+ε*a i|+ε^2 * |a i| * |∑ j ∈ s, a j| := by
        simp only [abs_mul, abs_of_nonneg (sq_nonneg ε)]
      _ ≤ (ε^2*(P-1-A))*(1+|a i|)+ε^2 * |a i| * A := by
        apply add_le_add
        · exact mul_le_mul ih hfactor (abs_nonneg _) (mul_nonneg (sq_nonneg _) hbudget)
        · exact mul_le_mul_of_nonneg_left hsum (mul_nonneg (sq_nonneg _) (abs_nonneg _))
      _ = _ := by dsimp [P,A]; ring

theorem crossProduct_abs_bound {M : ℕ} {ε : ℝ} (hε : 0 ≤ ε) (hε1 : ε ≤ 1)
    (x y : Fin M → ℝ) (hx : ∀ i, 0 ≤ x i) (hy : ∀ j, 0 ≤ y j) :
    |crossProduct M ε x y| ≤ (1+(∑ i, x i)+(∑ j, y j))^(M^2) := by
  have hi (i j : Fin M) : |1+ε*(x i-y j)| ≤ 1+(∑ i, x i)+(∑ j, y j) := by
    have hxi := hx i
    have hyj := hy j
    have hsi := Finset.single_le_sum (fun k (_ : k ∈ (univ : Finset (Fin M))) => hx k) (mem_univ i)
    have hsj := Finset.single_le_sum (fun k (_ : k ∈ (univ : Finset (Fin M))) => hy k) (mem_univ j)
    have habs : |x i-y j| ≤ x i+y j := abs_le.mpr ⟨by linarith, by linarith⟩
    calc
      _ ≤ |(1 : ℝ)|+|ε*(x i-y j)| := abs_add_le _ _
      _ = 1+ε*|x i-y j| := by rw [abs_one, abs_mul, abs_of_nonneg hε]
      _ ≤ 1+x i+y j := by nlinarith [abs_nonneg (x i-y j)]
      _ ≤ _ := by linarith
  unfold crossProduct
  rw [Finset.abs_prod]
  simp_rw [Finset.abs_prod]
  calc
    _ ≤ ∏ _i : Fin M, ∏ _j : Fin M, (1+(∑ i, x i)+(∑ j, y j)) := by
      apply Finset.prod_le_prod₀
      · intro i _; exact Finset.prod_nonneg (fun j _ => abs_nonneg _)
      · intro i _
        exact Finset.prod_le_prod₀ (fun j _ => abs_nonneg _) (fun j _ => hi i j)
    _ = _ := by simp [← pow_mul, pow_two]

private theorem joint_delta_factor (M : ℕ) (x y : Fin M → ℝ) :
    (∏ i, ∏ j, if i < j then (x i-x j)^2*(y i-y j)^2 else 1) = deltaSq M x*deltaSq M y := by
  have he (i j : Fin M) :
      (if i < j then (x i-x j)^2*(y i-y j)^2 else (1 : ℝ)) =
        (if i < j then (x i-x j)^2 else 1)*(if i < j then (y i-y j)^2 else 1) := ite_mul_one
  simp_rw [he, Finset.prod_mul_distrib]
  rfl

theorem measurableSet_tailSet (M : ℕ) (γ : ℝ) : MeasurableSet (tailSet M γ) := by
  unfold tailSet
  simpa only [Set.iUnion_setOf, Function.comp_apply] using MeasurableSet.iUnion
    (fun j : Fin M => measurableSet_lt (measurable_const : Measurable (fun _ : (Fin M → ℝ) × (Fin M → ℝ) => γ))
      ((measurable_pi_apply j).comp measurable_snd))

private theorem measurableSet_orthantProduct (M : ℕ) : MeasurableSet ((Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))) := by
  exact measurableSet_Ici

private theorem tail_sum {M : ℕ} {γ : ℝ} {p : (Fin M → ℝ) × (Fin M → ℝ)}
    (hp : p ∈ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ))) ∩ tailSet M γ) : γ ≤ jointSum M p := by
  have hs : (∀ i, 0 ≤ p.1 i) ∧ ∀ j, 0 ≤ p.2 j := by
    simpa only [Function.const, Prod.le_def, Pi.le_def, Prod.fst_zero, Prod.snd_zero, Pi.zero_apply,
      Set.mem_Ici, forall_true_left] using hp.1
  obtain ⟨j, hj⟩ := hp.2
  have hy := Finset.single_le_sum (fun k (_ : k ∈ (Finset.univ : Finset (Fin M))) => hs.2 k) (Finset.mem_univ j)
  have hx := Finset.sum_nonneg (fun i (_ : i ∈ (Finset.univ : Finset (Fin M))) => hs.1 i)
  unfold jointSum
  linarith

private noncomputable def jointDeltaPoly (M : ℕ) : MvPolynomial (Fin M ⊕ Fin M) ℝ :=
  rename Sum.inl (deltaPoly M)*rename Sum.inr (deltaPoly M)

noncomputable def budgetPoly (M : ℕ) : MvPolynomial (Fin M ⊕ Fin M) ℝ :=
  (1+(MvPolynomial.psum (Fin M ⊕ Fin M) ℝ 1))^(M^2)

private theorem jointSumPoly_eval (M : ℕ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    eval (Sum.elim p.1 p.2) ((MvPolynomial.psum (Fin M ⊕ Fin M) ℝ 1)) = jointSum M p := by
  simp [MvPolynomial.psum, Fintype.sum_sum_type,jointSum,map_sum]

theorem linearDensityPoly_eval (M : ℕ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    eval (Sum.elim p.1 p.2) (linearDensityPoly M) =
      (M : ℝ)*((∑ i, p.1 i)-(∑ j, p.2 j)) := by
  simp [linearDensityPoly,map_sum]

private theorem crossPoly_eval (M : ℕ) (ε : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    eval (Sum.elim p.1 p.2) (crossPoly M ε) = crossProduct M ε p.1 p.2 := by
  simp [crossPoly,crossProduct,map_prod]

private theorem exponential_tail_isBigO {c : ℝ} (hc : 0 < c) :
    (fun γ : ℝ => Real.exp (-c*γ)) =O[atTop] (fun γ : ℝ => γ⁻¹^2) := by
  apply IsBigO.of_bound (2/c^2)
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with γ hγ
  have hpos := lt_of_lt_of_le zero_lt_one hγ
  have h := exponential_tail_quadratic hc hpos
  simpa [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), abs_pow, abs_inv,
    abs_of_pos hpos, div_eq_mul_inv, mul_inv_rev, inv_pow, mul_assoc, mul_comm, mul_left_comm] using h

theorem FirstOrder.affine (a b : ℝ) : FirstOrder (fun γ => a+b*γ⁻¹) a b := by
  unfold FirstOrder
  simp only [add_sub_cancel_left, sub_self]
  exact isBigO_zero _ _

private theorem integral_firstOrder {Ω : Type*} [MeasurableSpace Ω] {μ : Measure Ω}
    (f : ℝ → Ω → ℝ) (f₀ f₁ g : Ω → ℝ)
    (hf : ∀ᶠ γ : ℝ in atTop, Integrable (f γ) μ)
    (h0 : Integrable f₀ μ) (h1 : Integrable f₁ μ) (hg : Integrable g μ)
    (hbound : ∀ᶠ γ : ℝ in atTop, ∀ᵐ p ∂μ,
      |f γ p-f₀ p-γ⁻¹*f₁ p| ≤ γ⁻¹^2*g p) :
    FirstOrder (fun γ => ∫ p, f γ p ∂μ) (∫ p, f₀ p ∂μ) (∫ p, f₁ p ∂μ) := by
  have h := integral_quadratic_bigO (fun γ p => f γ p-f₀ p-γ⁻¹*f₁ p) g hg hbound
  apply h.congr' _ EventuallyEq.rfl
  filter_upwards [hf] with γ hγ
  change (∫ p, (f γ-f₀) p-γ⁻¹*f₁ p ∂μ) = _
  rw [integral_sub (hγ.sub h0) (h1.const_mul γ⁻¹)]
  simp only [Pi.sub_apply]
  rw [integral_sub hγ h0, integral_const_mul]
  ring

private theorem finiteProduct_remainder_simple {σ : Type*} (s : Finset σ) (a : σ → ℝ)
    {ε : ℝ} (hε : 0 ≤ ε) (hε1 : ε ≤ 1) :
    |(∏ i ∈ s, (1+ε*a i))-1-ε*(∑ i ∈ s, a i)| ≤
      ε^2*(∏ i ∈ s, (1+|a i|)) := by
  apply (finiteProduct_remainder s a hε hε1).trans
  apply mul_le_mul_of_nonneg_left _ (sq_nonneg ε)
  have := Finset.sum_nonneg (fun j (_ : j ∈ s) => abs_nonneg (a j))
  linarith

private theorem rawWeight_factor (M : ℕ) {γ : ℝ} (hγ : γ ≠ 0)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    rawWeight M γ p = γ^(M^2)*(Real.exp (-(M : ℝ)*∑ i, p.1 i)*deltaSq M p.1)*
      (Real.exp (-(M : ℝ)*∑ j, p.2 j)*deltaSq M p.2)*crossProduct M γ⁻¹ p.1 p.2 := by
  have hc (i j : Fin M) : γ+p.1 i-p.2 j = γ*(1+γ⁻¹*(p.1 i-p.2 j)) := by
    field_simp
    ring
  have he : Real.exp (-(M : ℝ)*((∑ i, p.1 i)+(∑ j, p.2 j))) =
      Real.exp (-(M : ℝ)*∑ i, p.1 i)*Real.exp (-(M : ℝ)*∑ j, p.2 j) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have hp : (∏ i, ∏ j, (γ+p.1 i-p.2 j)) = γ^(M^2)*crossProduct M γ⁻¹ p.1 p.2 := by
    simp_rw [hc, Finset.prod_mul_distrib]
    simp [crossProduct, ← pow_mul, pow_two]
  unfold rawWeight
  rw [he, joint_delta_factor, hp]
  ring

private theorem jointDeltaPoly_eval (M : ℕ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    eval (Sum.elim p.1 p.2) (jointDeltaPoly M) = deltaSq M p.1*deltaSq M p.2 := by
  simp [jointDeltaPoly, eval_rename, Function.comp_def, deltaPoly_eval]

noncomputable def baseWeight (M : ℕ) (a : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) : ℝ :=
  laguerreWeight M a p.1*laguerreWeight M a p.2

theorem budgetPoly_eval (M : ℕ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    eval (Sum.elim p.1 p.2) (budgetPoly M) = (1+jointSum M p)^(M^2) := by
  simp only [budgetPoly, map_pow, map_add, map_one, jointSumPoly_eval]

private theorem crossProduct_bound {M : ℕ} {ε : ℝ} (hε : 0 ≤ ε) (hε1 : ε ≤ 1)
    (x y : Fin M → ℝ) (hx : ∀ i, 0 ≤ x i) (hy : ∀ j, 0 ≤ y j) :
    |crossProduct M ε x y - 1 - ε*(M : ℝ)*((∑ i, x i)-(∑ j, y j))| ≤
      ε^2*(1+(∑ i, x i)+(∑ j, y j))^(M^2) := by
  have h := finiteProduct_remainder_simple (Finset.univ : Finset (Fin M × Fin M))
    (fun p => x p.1-y p.2) hε hε1
  rw [crossProduct_firstOrder] at h
  have hp : (∏ p : Fin M × Fin M, (1+ε*(x p.1-y p.2))) = crossProduct M ε x y := by
    rw [Fintype.prod_prod_type]
    rfl
  rw [hp] at h
  have hh : (∏ p : Fin M × Fin M, (1+|x p.1-y p.2|)) ≤
      (1+(∑ i, x i)+(∑ j, y j))^(M^2) := by
    calc
      _ ≤ ∏ _p : Fin M × Fin M, (1+(∑ i, x i)+(∑ j, y j)) := by
        apply Finset.prod_le_prod₀
        · intro p _; positivity
        · intro p _
          have hi := Finset.single_le_sum (fun i (_ : i ∈ (Finset.univ : Finset (Fin M))) => hx i) (Finset.mem_univ p.1)
          have hj := Finset.single_le_sum (fun j (_ : j ∈ (Finset.univ : Finset (Fin M))) => hy j) (Finset.mem_univ p.2)
          have habs : |x p.1-y p.2| ≤ x p.1+y p.2 := by
            exact abs_le.mpr ⟨by linarith [hx p.1], by linarith [hy p.2]⟩
          linarith
      _ = _ := by simp [pow_two]
  simpa only [mul_assoc] using h.trans (mul_le_mul_of_nonneg_left hh (sq_nonneg ε))

private theorem weight_cutoff_factor (M : ℕ) {γ : ℝ} (hγ : γ ≠ 0)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    weight M γ p =
      if ∀ j, p.2 j ≤ γ then γ^(M^2)*laguerreWeight M M p.1*laguerreWeight M M p.2*
        crossProduct M γ⁻¹ p.1 p.2 else 0 := by
  have hraw := rawWeight_factor M hγ p
  unfold rawWeight at hraw
  by_cases hx : ∀ i, 0 ≤ p.1 i
  · by_cases hy : ∀ j, 0 ≤ p.2 j
    · by_cases hc : ∀ j, p.2 j ≤ γ
      · simpa [weight, forall_and, hx, hy, hc, laguerreWeight] using hraw
      · simp [weight, forall_and, hx, hy, hc]
    · simp [weight, forall_and, hx, hy, laguerreWeight]
  · simp [weight, forall_and, hx, laguerreWeight]

theorem baseWeight_nonneg (M : ℕ) (a : ℝ) (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    0 ≤ baseWeight M a p := mul_nonneg (laguerreWeight_nonneg M a p.1) (laguerreWeight_nonneg M a p.2)

private theorem baseWeight_indicator (M : ℕ) (a : ℝ) :
    baseWeight M a = ((Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))).indicator
      (fun p => Real.exp (-a*jointSum M p)*eval (Sum.elim p.1 p.2) (jointDeltaPoly M)) := by
  funext p
  have hp : p ∈ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ))) ↔ (∀ i, 0 ≤ p.1 i) ∧ (∀ j, 0 ≤ p.2 j) := Iff.rfl
  by_cases hx : ∀ i, 0 ≤ p.1 i
  · by_cases hy : ∀ j, 0 ≤ p.2 j
    · simp only [Set.indicator_of_mem (hp.mpr ⟨hx,hy⟩), jointDeltaPoly_eval,
        baseWeight, laguerreWeight, hx, hy, forall_true_iff, if_true]
      have he : Real.exp (-a*jointSum M p) =
          Real.exp (-a*∑ i, p.1 i)*Real.exp (-a*∑ j, p.2 j) := by
        rw [← Real.exp_add]
        congr 1
        unfold jointSum
        ring
      rw [he]
      ring
    · simp [baseWeight, laguerreWeight, hy, hp, Set.indicator_of_notMem]
  · simp [baseWeight, laguerreWeight, hx, hp, Set.indicator_of_notMem]

theorem baseWeight_mass (M : ℕ) (a : ℝ) : (∫ p, baseWeight M a p) = (partition M a)^2 := by
  unfold baseWeight partition
  rw [Measure.volume_eq_prod, integral_prod_mul, pow_two]

theorem budgetPoly_nonneg {M : ℕ} (p : (Fin M → ℝ) × (Fin M → ℝ)) (hp : p ∈ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))) :
    0 ≤ eval (Sum.elim p.1 p.2) (budgetPoly M) := by
  rw [budgetPoly_eval]
  have hs : (∀ i, 0 ≤ p.1 i) ∧ ∀ j, 0 ≤ p.2 j := by
    simpa only [Function.const, Prod.le_def, Pi.le_def, Prod.fst_zero, Prod.snd_zero, Pi.zero_apply,
      Set.mem_Ici, forall_true_left] using hp
  have hx := Finset.sum_nonneg (fun i (_ : i ∈ (Finset.univ : Finset (Fin M))) => hs.1 i)
  have hy := Finset.sum_nonneg (fun j (_ : j ∈ (Finset.univ : Finset (Fin M))) => hs.2 j)
  unfold jointSum
  exact pow_nonneg (by linarith) _

private theorem FirstOrder.inv {f : ℝ → ℝ} {a b : ℝ} (hf : FirstOrder f a b) (ha : a ≠ 0) :
    FirstOrder (fun γ => (f γ)⁻¹) a⁻¹ (-b/a^2) := by
  have hfInv : Tendsto (fun γ => (f γ)⁻¹) atTop (𝓝 a⁻¹) := hf.tendsto.inv₀ ha
  have hbounded : (fun γ => (f γ)⁻¹) =O[atTop] (fun _ => (1 : ℝ)) :=
    isBigO_const_of_tendsto hfInv one_ne_zero
  have hprod := hf.mul (FirstOrder.affine a⁻¹ (-b/a^2))
  have he1 : a*a⁻¹ = 1 := mul_inv_cancel₀ ha
  have he0 : a*(-b/a^2)+b*a⁻¹ = 0 := by field_simp; ring
  rw [he1,he0] at hprod
  unfold FirstOrder at hprod
  simp only [zero_mul, sub_zero] at hprod
  have h := Asymptotics.IsBigO.mul hbounded (hprod.const_mul_left (-1))
  simp only [one_mul] at h
  apply h.congr' _ EventuallyEq.rfl
  have hne : ∀ᶠ γ in atTop, f γ ≠ 0 := hf.tendsto.eventually_ne ha
  filter_upwards [hne] with γ hγ
  field_simp
  <;> ring

noncomputable def crossIntegral (M : ℕ) (a ε : ℝ) (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) : ℝ :=
  ∫ p, baseWeight M a p*eval (Sum.elim p.1 p.2) P*crossProduct M ε p.1 p.2

noncomputable def cutoffIntegral (M : ℕ) (a γ : ℝ) (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) : ℝ :=
  ∫ p, (tailSet M γ)ᶜ.indicator
    (fun p => baseWeight M a p*eval (Sum.elim p.1 p.2) P*crossProduct M γ⁻¹ p.1 p.2) p

theorem linearDensityIntegral_zero (M : ℕ) (a : ℝ) :
    (∫ p, baseWeight M a p*eval (Sum.elim p.1 p.2) (linearDensityPoly M)) = 0 := by
  let f := fun p : (Fin M → ℝ) × (Fin M → ℝ) =>
    baseWeight M a p*eval (Sum.elim p.1 p.2) (linearDensityPoly M)
  have he : (fun p => f p.swap) = fun p => -f p := by
    funext p
    dsimp [f,baseWeight]
    simp only [linearDensityPoly,map_mul,eval_C,map_sub,map_sum,eval_X,Sum.elim_inl,Sum.elim_inr]
    ring
  have h := integral_prod_swap (μ := (volume : Measure (Fin M → ℝ))) (ν := volume) f
  rw [he,integral_neg] at h
  rw [← Measure.volume_eq_prod] at h
  change -(∫ p, f p) = ∫ p, f p at h
  change (∫ p, f p) = 0
  linarith

theorem basePolynomial_integrable {M : ℕ} {a : ℝ} (ha : 0 < a)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    Integrable (fun p => baseWeight M a p*eval (Sum.elim p.1 p.2) P) := by
  have h := polynomial_exp_integrable ha (jointDeltaPoly M*P)
  rw [← orthant_restrict] at h
  rw [baseWeight_indicator]
  have he : (fun p : (Fin M → ℝ) × (Fin M → ℝ) =>
      ((Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))).indicator
        (fun q => Real.exp (-a*jointSum M q)*eval (Sum.elim q.1 q.2) (jointDeltaPoly M)) p*
        eval (Sum.elim p.1 p.2) P) =
    ((Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))).indicator (fun p => Real.exp (-a*jointSum M p)*
      eval (Sum.elim p.1 p.2) (jointDeltaPoly M*P)) := by
    funext p
    by_cases hp : p ∈ Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)) <;> simp [hp, map_mul, mul_assoc]
  rw [he]
  exact (integrable_indicator_iff (measurableSet_orthantProduct M)).mpr h

theorem baseWeight_eq_zero_off_orthant {M : ℕ} {a : ℝ}
    {p : (Fin M → ℝ) × (Fin M → ℝ)} (hp : p ∉ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))) :
    baseWeight M a p = 0 := by
  rw [baseWeight_indicator, Set.indicator_of_notMem hp]

private theorem baseWeight_tail_bound {M : ℕ} {a γ : ℝ} (ha : 0 < a)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) (hp : p ∈ tailSet M γ) :
    baseWeight M a p ≤ Real.exp (-(a*γ)/2)*baseWeight M (a/2) p := by
  by_cases ho : p ∈ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))
  · have hsum := tail_sum (show p ∈ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ))) ∩ tailSet M γ from ⟨ho,hp⟩)
    have he : -a*jointSum M p ≤ -(a*γ)/2-(a/2)*jointSum M p := by nlinarith
    have hb := Real.exp_le_exp.mpr he
    rw [Real.exp_sub] at hb
    rw [div_eq_mul_inv, ← Real.exp_neg] at hb
    rw [baseWeight_indicator, baseWeight_indicator,
      Set.indicator_of_mem ho, Set.indicator_of_mem ho, jointDeltaPoly_eval]
    have hn := mul_nonneg (deltaSq_nonneg M p.1) (deltaSq_nonneg M p.2)
    simpa only [mul_assoc, neg_mul] using mul_le_mul_of_nonneg_right hb hn
  · rw [baseWeight_indicator, baseWeight_indicator,
      Set.indicator_of_notMem ho, Set.indicator_of_notMem ho]
    simp

private theorem FirstOrder.div {f g : ℝ → ℝ} {a b c d : ℝ}
    (hf : FirstOrder f a b) (hg : FirstOrder g c d) (hc : c ≠ 0) :
    FirstOrder (fun γ => f γ/g γ) (a/c) (b/c-a*d/c^2) := by
  have h := hf.mul (FirstOrder.inv hg hc)
  have he : a*(-d/c^2)+b*c⁻¹ = b/c-a*d/c^2 := by ring
  rw [he] at h
  simpa only [div_eq_mul_inv] using h

theorem weight_scaled_cutoff {M : ℕ} {γ : ℝ} (hγ : 0 < γ)
    (p : (Fin M → ℝ) × (Fin M → ℝ)) :
    weight M γ p = γ^(M^2)*(tailSet M γ)ᶜ.indicator
      (fun p => baseWeight M M p*crossProduct M γ⁻¹ p.1 p.2) p := by
  rw [weight_cutoff_factor M hγ.ne']
  have hc : p ∈ (tailSet M γ)ᶜ ↔ ∀ j, p.2 j ≤ γ := by
    simp only [Set.mem_compl_iff,tailSet,Set.mem_setOf_eq,not_exists,not_lt]
  by_cases hp : ∀ j, p.2 j ≤ γ <;> simp [hp,Set.indicator,hc,baseWeight,mul_assoc]

theorem tail_family_exponential_bound {M : ℕ} {a : ℝ} (ha : 0 < a) (γ : ℝ)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ)
    (f : (Fin M → ℝ) × (Fin M → ℝ) → ℝ)
    (hf : ∀ p, |f p| ≤ baseWeight M a p*|eval (Sum.elim p.1 p.2) P|) :
    |∫ p in tailSet M γ, f p| ≤
      Real.exp (-(a*γ)/2)*∫ p, baseWeight M (a/2) p*|eval (Sum.elim p.1 p.2) P| := by
  let g := fun p : (Fin M → ℝ) × (Fin M → ℝ) =>
      baseWeight M (a/2) p*|eval (Sum.elim p.1 p.2) P|
  have hg : Integrable g := by
    have h := (basePolynomial_integrable (show 0 < a/2 by positivity) P).abs
    simpa only [g, abs_mul, abs_of_nonneg (baseWeight_nonneg M (a/2) _)] using h
  have hbound : ∀ p, ‖(tailSet M γ).indicator f p‖ ≤ Real.exp (-(a*γ)/2)*g p := by
    intro p
    by_cases hp : p ∈ tailSet M γ
    · rw [Set.indicator_of_mem hp, Real.norm_eq_abs]
      exact (hf p).trans (by
        simpa only [g, mul_assoc] using mul_le_mul_of_nonneg_right (baseWeight_tail_bound ha p hp) (abs_nonneg _))
    · rw [Set.indicator_of_notMem hp, norm_zero]
      dsimp [g]
      exact mul_nonneg (Real.exp_pos _).le (mul_nonneg (baseWeight_nonneg M (a/2) p) (abs_nonneg _))
  have h := norm_integral_le_of_norm_le (hg.const_mul (Real.exp (-(a*γ)/2))) (Eventually.of_forall hbound)
  rw [integral_indicator (measurableSet_tailSet M γ), integral_const_mul, Real.norm_eq_abs] at h
  exact h

theorem crossIntegrand_integrable {M : ℕ} {a : ℝ} (ha : 0 < a) (ε : ℝ)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    Integrable (fun p => baseWeight M a p*eval (Sum.elim p.1 p.2) P*crossProduct M ε p.1 p.2) := by
  simpa only [map_mul, crossPoly_eval, mul_assoc] using basePolynomial_integrable ha (P*crossPoly M ε)

theorem law_polynomial_ratio {M : ℕ} (hM : 1 ≤ M) {γ : ℝ} (hγ : 0 < γ)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    (∫ p, eval (Sum.elim p.1 p.2) P ∂law M γ) =
      cutoffIntegral M M γ P/cutoffIntegral M M γ 1 := by
  rw [law_integral hM γ]
  have he (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
      (fun p => weight M γ p*eval (Sum.elim p.1 p.2) P) =
      (fun p => γ^(M^2)*(tailSet M γ)ᶜ.indicator
        (fun p => baseWeight M M p*eval (Sum.elim p.1 p.2) P*crossProduct M γ⁻¹ p.1 p.2) p) := by
    funext p
    rw [weight_scaled_cutoff hγ]
    by_cases hp : p ∈ (tailSet M γ)ᶜ <;> simp [hp,Set.indicator] <;> ring
  rw [he P,integral_const_mul]
  have hw : (∫ p, weight M γ p) = γ^(M^2)*cutoffIntegral M M γ 1 := by
    have h := congrArg (fun f : (Fin M → ℝ) × (Fin M → ℝ) → ℝ => ∫ p, f p) (he 1)
    simpa only [map_one,mul_one,integral_const_mul,cutoffIntegral] using h
  rw [hw]
  unfold cutoffIntegral
  have hs : γ^(M^2) ≠ 0 := pow_ne_zero _ hγ.ne'
  exact mul_div_mul_left _ _ hs

private theorem tail_family_isBigO {M : ℕ} {a : ℝ} (ha : 0 < a)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ)
    (f : ℝ → (Fin M → ℝ) × (Fin M → ℝ) → ℝ)
    (hf : ∀ᶠ γ in atTop, ∀ p, |f γ p| ≤ baseWeight M a p*|eval (Sum.elim p.1 p.2) P|) :
    (fun γ => ∫ p in tailSet M γ, f γ p) =O[atTop] (fun γ : ℝ => γ⁻¹^2) := by
  let C := ∫ p, baseWeight M (a/2) p*|eval (Sum.elim p.1 p.2) P|
  have h : (fun γ => ∫ p in tailSet M γ, f γ p) =O[atTop] (fun γ : ℝ => Real.exp (-(a/2)*γ)) := by
    apply IsBigO.of_bound C
    filter_upwards [hf] with γ hγ
    have hh := tail_family_exponential_bound ha γ P (f γ) hγ
    simpa [Real.norm_eq_abs, abs_of_pos (Real.exp_pos _), C, mul_comm, mul_left_comm,
      div_eq_mul_inv, mul_assoc] using hh
  exact h.trans (exponential_tail_isBigO (show 0 < a/2 by positivity))

private theorem crossIntegral_firstOrder {M : ℕ} {a : ℝ} (ha : 0 < a)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    FirstOrder (fun γ => crossIntegral M a γ⁻¹ P)
      (∫ p, baseWeight M a p*eval (Sum.elim p.1 p.2) P)
      (∫ p, baseWeight M a p*eval (Sum.elim p.1 p.2) (P*linearDensityPoly M)) := by
  let g := fun p : (Fin M → ℝ) × (Fin M → ℝ) =>
      baseWeight M a p*|eval (Sum.elim p.1 p.2) (P*budgetPoly M)|
  have hg : Integrable g := by
    have h := (basePolynomial_integrable ha (P*budgetPoly M)).abs
    simpa only [g, abs_mul, abs_of_nonneg (baseWeight_nonneg M a _)] using h
  apply integral_firstOrder _ _ _ g
    (Eventually.of_forall fun γ => crossIntegrand_integrable ha γ⁻¹ P)
    (basePolynomial_integrable ha P) (basePolynomial_integrable ha (P*linearDensityPoly M)) hg
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with γ hγ
  have hpos : 0 < γ := lt_of_lt_of_le zero_lt_one hγ
  have hi0 : 0 ≤ γ⁻¹ := inv_nonneg.mpr hpos.le
  have hi1 : γ⁻¹ ≤ 1 := (inv_le_one₀ hpos).mpr hγ
  apply Eventually.of_forall
  intro p
  by_cases hp : p ∈ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))
  · have hs : (∀ i, 0 ≤ p.1 i) ∧ ∀ j, 0 ≤ p.2 j := by
      simpa only [Function.const, Prod.le_def, Pi.le_def, Prod.fst_zero, Prod.snd_zero, Pi.zero_apply, Set.mem_Ici, forall_true_left] using hp
    have hb := crossProduct_bound hi0 hi1 p.1 p.2 hs.1 hs.2
    have hbase := baseWeight_nonneg M a p
    have hq := budgetPoly_nonneg p hp
    have he : baseWeight M a p*eval (Sum.elim p.1 p.2) P*crossProduct M γ⁻¹ p.1 p.2-
        baseWeight M a p*eval (Sum.elim p.1 p.2) P-
        γ⁻¹*(baseWeight M a p*eval (Sum.elim p.1 p.2) (P*linearDensityPoly M)) =
      (baseWeight M a p*eval (Sum.elim p.1 p.2) P)*
        (crossProduct M γ⁻¹ p.1 p.2-1-γ⁻¹*(M : ℝ)*((∑ i, p.1 i)-(∑ j, p.2 j))) := by
      rw [map_mul,linearDensityPoly_eval]
      ring
    rw [he,abs_mul,abs_mul,abs_of_nonneg hbase]
    dsimp [g]
    rw [map_mul,abs_mul,abs_of_nonneg hq,budgetPoly_eval]
    have hh := mul_le_mul_of_nonneg_left hb (mul_nonneg hbase (abs_nonneg (eval (Sum.elim p.1 p.2) P)))
    simpa only [jointSum, mul_assoc, mul_left_comm, add_assoc] using hh
  · simp [baseWeight_eq_zero_off_orthant hp,g]

theorem cutoffIntegral_eq_sub {M : ℕ} {a : ℝ} (ha : 0 < a) (γ : ℝ)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    cutoffIntegral M a γ P = crossIntegral M a γ⁻¹ P-
      ∫ p in tailSet M γ, baseWeight M a p*eval (Sum.elim p.1 p.2) P*crossProduct M γ⁻¹ p.1 p.2 := by
  unfold cutoffIntegral crossIntegral
  rw [integral_indicator (measurableSet_tailSet M γ).compl]
  have h := integral_add_compl (measurableSet_tailSet M γ) (crossIntegrand_integrable ha γ⁻¹ P)
  linarith

private theorem crossIntegral_tail_bigO {M : ℕ} {a : ℝ} (ha : 0 < a)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    (fun γ => ∫ p in tailSet M γ,
      baseWeight M a p*eval (Sum.elim p.1 p.2) P*crossProduct M γ⁻¹ p.1 p.2) =O[atTop]
        (fun γ : ℝ => γ⁻¹^2) := by
  apply tail_family_isBigO ha (P*budgetPoly M)
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with γ hγ
  have hpos : 0 < γ := lt_of_lt_of_le zero_lt_one hγ
  intro p
  by_cases hp : p ∈ (Set.Ici (0 : (Fin M → ℝ) × (Fin M → ℝ)))
  · have hs : (∀ i, 0 ≤ p.1 i) ∧ ∀ j, 0 ≤ p.2 j := by
      simpa only [Function.const, Prod.le_def, Pi.le_def, Prod.fst_zero, Prod.snd_zero, Pi.zero_apply, Set.mem_Ici, forall_true_left] using hp
    have hq := budgetPoly_nonneg p hp
    rw [abs_mul,abs_mul,abs_of_nonneg (baseWeight_nonneg M a p),map_mul,abs_mul,
      abs_of_nonneg hq,budgetPoly_eval]
    have hh := mul_le_mul_of_nonneg_left
      (crossProduct_abs_bound (inv_nonneg.mpr hpos.le) ((inv_le_one₀ hpos).mpr hγ) p.1 p.2 hs.1 hs.2)
      (mul_nonneg (baseWeight_nonneg M a p) (abs_nonneg (eval (Sum.elim p.1 p.2) P)))
    simpa only [jointSum,mul_assoc,add_assoc] using hh
  · simp [baseWeight_eq_zero_off_orthant hp]

theorem cutoffIntegral_firstOrder {M : ℕ} {a : ℝ} (ha : 0 < a)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    FirstOrder (cutoffIntegral M a · P)
      (∫ p, baseWeight M a p*eval (Sum.elim p.1 p.2) P)
      (∫ p, baseWeight M a p*eval (Sum.elim p.1 p.2) (P*linearDensityPoly M)) := by
  have ht : FirstOrder (fun γ => ∫ p in tailSet M γ,
      baseWeight M a p*eval (Sum.elim p.1 p.2) P*crossProduct M γ⁻¹ p.1 p.2) 0 0 := by
    simpa only [FirstOrder,sub_zero,zero_mul] using crossIntegral_tail_bigO ha P
  have h := (crossIntegral_firstOrder ha P).sub ht
  simp only [sub_zero] at h
  exact D5.S3.Quantum.Transport.StrongAbsorption.LaguerreMoments.FirstOrder.congr_eventually h (Eventually.of_forall fun γ => (cutoffIntegral_eq_sub ha γ P).symm)

theorem law_polynomial_firstOrder {M : ℕ} (hM : 1 ≤ M)
    (P : MvPolynomial (Fin M ⊕ Fin M) ℝ) :
    FirstOrder (fun γ => ∫ p, eval (Sum.elim p.1 p.2) P ∂law M γ)
      ((∫ p, baseWeight M M p*eval (Sum.elim p.1 p.2) P)/(partition M M)^2)
      ((∫ p, baseWeight M M p*eval (Sum.elim p.1 p.2) (P*linearDensityPoly M))/(partition M M)^2) := by
  have hm : 0 < (M : ℝ) := Nat.cast_pos'.mpr hM
  have hden := cutoffIntegral_firstOrder hm (1 : MvPolynomial (Fin M ⊕ Fin M) ℝ)
  simp only [map_one,mul_one,one_mul,baseWeight_mass,linearDensityIntegral_zero] at hden
  have h := FirstOrder.div (cutoffIntegral_firstOrder hm P) hden (pow_ne_zero _ (partition_pos M hm).ne')
  simp only [mul_zero,zero_div,sub_zero] at h
  apply D5.S3.Quantum.Transport.StrongAbsorption.LaguerreMoments.FirstOrder.congr_eventually h
  filter_upwards [eventually_ge_atTop (1 : ℝ)] with γ hγ
  exact (law_polynomial_ratio hM (lt_of_lt_of_le zero_lt_one hγ) P).symm

end D5.S3.Quantum.Transport.StrongAbsorption.Density
