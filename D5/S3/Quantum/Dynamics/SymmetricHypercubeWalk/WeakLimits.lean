/-!
# Shifted moments and weak convergence

Stone–Weierstrass is applied to the real subalgebra generated by one continuous,
injective function. The probability normalization bounds each integral by the uniform norm.
-/

section

open Filter MeasureTheory Set
open scoped Topology

namespace HypercubeWeakLimit

private noncomputable def expectation {X : Type*} [TopologicalSpace X] [CompactSpace X]
    [MeasurableSpace X] [OpensMeasurableSpace X] (μ : ProbabilityMeasure X) :
    C(X, ℝ) →ₗ[ℝ] ℝ where
  toFun f := ∫ x, f x ∂(μ : Measure X)
  map_add' f g := by
    change (∫ x, f x + g x ∂(μ : Measure X)) = _
    exact integral_add
      ((BoundedContinuousFunction.mkOfCompact f).integrable (μ := (μ : Measure X)))
      ((BoundedContinuousFunction.mkOfCompact g).integrable (μ := (μ : Measure X)))
  map_smul' c f := by
    change (∫ x, c • f x ∂(μ : Measure X)) = c • _
    exact integral_smul c f

section CompactSpace

variable {X ι : Type*} [TopologicalSpace X] [CompactSpace X]
  [MeasurableSpace X] [OpensMeasurableSpace X]

private theorem norm_expectation_le (μ : ProbabilityMeasure X) (f : C(X, ℝ)) :
    ‖expectation μ f‖ ≤ ‖f‖ := by
  change ‖∫ x, f x ∂(μ : Measure X)‖ ≤ ‖f‖
  simpa using norm_integral_le_of_norm_le_const
    (μ := (μ : Measure X)) (Eventually.of_forall f.norm_coe_le_norm)

/-- For probability measures on a compact space, an injective continuous real
coordinate suffices to test asymptotic agreement by its powers. -/
private theorem tendsto_integral_sub_iff_powers (L : Filter ι) (μ ν : ι → ProbabilityMeasure X)
    (u : C(X, ℝ)) (hu : Function.Injective u) :
    (∀ f : C(X, ℝ), Tendsto
      (fun i ↦ (∫ x, f x ∂(μ i : Measure X)) - ∫ x, f x ∂(ν i : Measure X)) L (𝓝 0)) ↔
    (∀ k : ℕ, Tendsto
      (fun i ↦ (∫ x, u x ^ k ∂(μ i : Measure X)) - ∫ x, u x ^ k ∂(ν i : Measure X))
      L (𝓝 0)) := by
  let gap (i : ι) : C(X, ℝ) →ₗ[ℝ] ℝ := expectation (μ i) - expectation (ν i)
  change (∀ f : C(X, ℝ), Tendsto (fun i ↦ gap i f) L (𝓝 0)) ↔ _
  have hpow (k : ℕ) (i : ι) : gap i (u ^ k) =
      (∫ x, u x ^ k ∂(μ i : Measure X)) - ∫ x, u x ^ k ∂(ν i : Measure X) := by
    simp only [gap, LinearMap.sub_apply, expectation, LinearMap.coe_mk,
      AddHom.coe_mk, ContinuousMap.pow_apply]
  simp only [← hpow]
  refine ⟨fun h k ↦ h (u ^ k), fun hpowers f ↦ ?_⟩
  let A := Algebra.adjoin ℝ ({u} : Set C(X, ℝ))
  have huA : u ∈ A := Algebra.subset_adjoin (Set.mem_singleton u)
  have hsep : A.SeparatesPoints := by
    intro x y hxy
    exact ⟨u, ⟨u, huA, rfl⟩, fun h ↦ hxy (hu h)⟩
  have hpoly (g : C(X, ℝ)) (hg : g ∈ A) :
      Tendsto (fun i ↦ gap i g) L (𝓝 0) := by
    change g ∈ Algebra.adjoin ℝ ({u} : Set C(X, ℝ)) at hg
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hg
    obtain ⟨p, rfl⟩ := hg
    change Tendsto (fun i ↦ gap i (Polynomial.aeval u p)) L (𝓝 0)
    simp only [Polynomial.aeval_eq_sum_range]
    simp only [map_sum, map_smul, smul_eq_mul]
    have hterm (k : ℕ) :
        Tendsto (fun i ↦ p.coeff k * gap i (u ^ k)) L (𝓝 0) := by
      simpa using (hpowers k).const_mul (p.coeff k)
    simpa using tendsto_finsetSum (Finset.range (p.natDegree + 1))
      (fun k _ ↦ hterm k)
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨g, hfg⟩ := ContinuousMap.exists_mem_subalgebra_near_continuousMap_of_separatesPoints
    A hsep f (ε / 3) (by linarith)
  have hfg' : ‖f - (g : C(X, ℝ))‖ < ε / 3 := by simpa only [norm_sub_rev] using hfg
  filter_upwards [Metric.tendsto_nhds.mp (hpoly g g.property) (ε / 3) (by linarith)] with i hi
  rw [dist_zero_right] at hi ⊢
  have hgap : ‖gap i (f - g)‖ ≤ 2 * ‖f - (g : C(X, ℝ))‖ := by
    change ‖expectation (μ i) (f - g) - expectation (ν i) (f - g)‖ ≤ _
    calc
      _ ≤ ‖expectation (μ i) (f - g)‖ + ‖expectation (ν i) (f - g)‖ := norm_sub_le _ _
      _ ≤ _ := by
        simpa only [two_mul] using add_le_add
          (norm_expectation_le (μ i) (f - g)) (norm_expectation_le (ν i) (f - g))
  calc
    ‖gap i f‖ = ‖gap i (f - g) + gap i g‖ := by rw [map_sub, sub_add_cancel]
    _ ≤ ‖gap i (f - g)‖ + ‖gap i g‖ := norm_add_le _ _
    _ < ε := by linarith

end CompactSpace

/-- The closed real unit interval with the induced topology and measurable space. -/
abbrev UnitInterval := Set.Icc (0 : ℝ) 1

/-- The coordinate used by the rescaled Hamming-weight moments. -/
def shiftedCoordinate : C(UnitInterval, ℝ) :=
  ⟨fun x ↦ 1 - 2 * (x : ℝ), continuous_const.sub (continuous_const.mul continuous_subtype_val)⟩

/-- The moment of order `k` in the shifted coordinate `1 - 2x`. -/
noncomputable def shiftedMoment (μ : ProbabilityMeasure UnitInterval) (k : ℕ) : ℝ :=
  ∫ x, (1 - 2 * (x : ℝ)) ^ k ∂(μ : Measure UnitInterval)

/-- Differences of integrals against all continuous tests tend to zero exactly
when the differences of all positive-order shifted moments tend to zero. -/
theorem tendsto_integral_sub_iff_shiftedMoments {ι : Type*} (L : Filter ι)
    (μ ν : ι → ProbabilityMeasure UnitInterval) :
    (∀ f : C(UnitInterval, ℝ), Tendsto
      (fun i ↦ (∫ x, f x ∂(μ i : Measure UnitInterval)) -
        ∫ x, f x ∂(ν i : Measure UnitInterval)) L (𝓝 0)) ↔
    (∀ k : ℕ, 0 < k →
      Tendsto (fun i ↦ shiftedMoment (μ i) k - shiftedMoment (ν i) k) L (𝓝 0)) := by
  have hinj : Function.Injective shiftedCoordinate := by
    intro x y h
    apply Subtype.ext
    change 1 - 2 * (x : ℝ) = 1 - 2 * (y : ℝ) at h
    linarith
  rw [tendsto_integral_sub_iff_powers L μ ν shiftedCoordinate hinj]
  change (∀ k : ℕ, Tendsto
    (fun i ↦ shiftedMoment (μ i) k - shiftedMoment (ν i) k) L (𝓝 0)) ↔ _
  refine ⟨fun h k _ ↦ h k, fun h k ↦ ?_⟩
  cases k with
  | zero => simpa [shiftedMoment] using (tendsto_const_nhds : Tendsto (fun _ : ι ↦ (0 : ℝ)) L (𝓝 0))
  | succ k => exact h _ (Nat.zero_lt_succ k)

/-- Given weak convergence of either sequence to `π`, the shifted-moment
criterion is equivalent to weak convergence of both sequences to `π`. -/
theorem common_weakLimit_iff_shiftedMoments {ι : Type*} (L : Filter ι)
    (μ ν : ι → ProbabilityMeasure UnitInterval) (π : ProbabilityMeasure UnitInterval)
    (h : Tendsto μ L (𝓝 π) ∨ Tendsto ν L (𝓝 π)) :
    (Tendsto μ L (𝓝 π) ∧ Tendsto ν L (𝓝 π)) ↔
    (∀ k : ℕ, 0 < k →
      Tendsto (fun i ↦ shiftedMoment (μ i) k - shiftedMoment (ν i) k) L (𝓝 0)) := by
  rw [← tendsto_integral_sub_iff_shiftedMoments]
  constructor
  · rintro ⟨hμ, hν⟩ f
    have hμf := (ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hμ)
      (BoundedContinuousFunction.mkOfCompact f)
    have hνf := (ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hν)
      (BoundedContinuousFunction.mkOfCompact f)
    simpa using hμf.sub hνf
  · intro hgap
    rcases h with hμ | hν
    · refine ⟨hμ, ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mpr ?_⟩
      intro f
      have hμf := ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hμ f
      simpa using hμf.sub (hgap f.toContinuousMap)
    · refine ⟨ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mpr ?_, hν⟩
      intro f
      have hνf := ProbabilityMeasure.tendsto_iff_forall_integral_tendsto.mp hν f
      simpa using (hgap f.toContinuousMap).add hνf

theorem continuous_shiftedMoment (k : ℕ) :
    Continuous (fun μ : ProbabilityMeasure UnitInterval ↦ shiftedMoment μ k) := by
  simpa only [shiftedMoment, ContinuousMap.pow_apply, shiftedCoordinate, ContinuousMap.coe_mk] using
    ProbabilityMeasure.continuous_integral_continuousMap (shiftedCoordinate ^ k)

private noncomputable def shiftedMomentProfile (μ : ProbabilityMeasure UnitInterval) : ℕ → ℝ :=
  fun k ↦ shiftedMoment μ (k + 1)

private theorem isClosedEmbedding_shiftedMomentProfile :
    Topology.IsClosedEmbedding shiftedMomentProfile := by
  apply Continuous.isClosedEmbedding (continuous_pi fun k ↦ continuous_shiftedMoment (k + 1))
  intro μ ν h
  have hν : Tendsto (fun _ : ℕ ↦ ν) atTop (𝓝 ν) := tendsto_const_nhds
  have hμ : Tendsto (fun _ : ℕ ↦ μ) atTop (𝓝 ν) := by
    apply ((common_weakLimit_iff_shiftedMoments atTop (fun _ ↦ μ) (fun _ ↦ ν) ν
      (Or.inr hν)).mpr ?_).1
    intro k hk
    cases k with
    | zero => exact (Nat.lt_irrefl 0 hk).elim
    | succ k =>
      have heq : shiftedMoment μ (k + 1) = shiftedMoment ν (k + 1) := congrFun h k
      simpa only [heq, sub_self] using
        (tendsto_const_nhds : Tendsto (fun _ : ℕ ↦ (0 : ℝ)) atTop (𝓝 0))
  exact tendsto_nhds_unique tendsto_const_nhds hμ

/-- Compactness gives a weak limit for a family of probability measures on
`[0,1]` exactly when every positive shifted moment has a real limit. -/
theorem exists_weakLimit_iff_shiftedMoments_converge {ι : Type*} (L : Filter ι)
    (μ : ι → ProbabilityMeasure UnitInterval) :
    (∃ π : ProbabilityMeasure UnitInterval, Tendsto μ L (𝓝 π)) ↔
    (∀ k : ℕ, 0 < k →
      ∃ m : ℝ, Tendsto (fun i ↦ shiftedMoment (μ i) k) L (𝓝 m)) := by
  constructor
  · rintro ⟨π, hπ⟩ k _
    exact ⟨shiftedMoment π k, (continuous_shiftedMoment k).continuousAt.tendsto.comp hπ⟩
  · intro h
    by_cases hL : L = ⊥
    · let x : UnitInterval := ⟨0, by simp⟩
      exact ⟨⟨Measure.dirac x, Measure.dirac.isProbabilityMeasure⟩, hL ▸ tendsto_bot⟩
    have : NeBot L := neBot_iff.mpr hL
    choose m hm using fun k : ℕ ↦ h (k + 1) (Nat.succ_pos k)
    have hlimit : Tendsto (shiftedMomentProfile ∘ μ) L (𝓝 m) := tendsto_pi_nhds.mpr hm
    have hrange : m ∈ Set.range shiftedMomentProfile :=
      isClosedEmbedding_shiftedMomentProfile.isClosed_range.mem_of_tendsto hlimit
        (.of_forall fun i ↦ ⟨μ i, rfl⟩)
    obtain ⟨π, rfl⟩ := hrange
    exact ⟨π, isClosedEmbedding_shiftedMomentProfile.isEmbedding.tendsto_nhds_iff.mpr hlimit⟩

end HypercubeWeakLimit

