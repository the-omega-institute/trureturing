/-- Pull complex-valued functions back along a readout. -/
def readoutPullback {X Z : Type*} (readout : X -> Z) :
    (Z -> ℂ) →⋆ₐ[ℂ] (X -> ℂ) where
  toFun := fun f => f ∘ readout
  map_one' := rfl
  map_mul' := fun _ _ => rfl
  map_zero' := rfl
  map_add' := fun _ _ => rfl
  commutes' := fun _ => rfl
  map_star' := fun _ => rfl

/-- The current-readout algebra, constructed as the range of pullback. -/
def initialObservableAlgebra {Y O : Type*} (readout : Y -> O) :
    StarSubalgebra ℂ (Y -> ℂ) :=
  (readoutPullback readout).range

/-- Pullbacks through update times at most `depth`. -/
def finiteKoopmanGenerators {Y O : Type*} (update : Y -> Y)
    (readout : Y -> O) (depth : Nat) : Set (Y -> ℂ) :=
  {f | exists n, n <= depth /\ exists g,
    g ∈ initialObservableAlgebra readout /\ f = g ∘ (update^[n])}

/-- The unital star algebra generated by bounded-time readout pullbacks. -/
def finiteKoopmanClosure {Y O : Type*} (update : Y -> Y)
    (readout : Y -> O) (depth : Nat) : StarSubalgebra ℂ (Y -> ℂ) :=
  StarAlgebra.adjoin ℂ (finiteKoopmanGenerators update readout depth)

/-- Closure of a function algebra under one Koopman pullback. -/
def PullbackInvariant {Y : Type*} (update : Y -> Y)
    (algebra : StarSubalgebra ℂ (Y -> ℂ)) : Prop :=
  ∀ f ∈ algebra, f ∘ update ∈ algebra

/-- All unital star subalgebras containing the current readout and invariant
under update pullback. -/
def invariantObservableExtensions {Y O : Type*} (update : Y -> Y)
    (readout : Y -> O) : Set (StarSubalgebra ℂ (Y -> ℂ)) :=
  {algebra | initialObservableAlgebra readout <= algebra /\
    PullbackInvariant update algebra}

private theorem initial_observable_algebra_eq_fiber
    {Y O : Type*} (readout : Y -> O)
    (hreadout : Function.Surjective readout) :
    initialObservableAlgebra readout =
      fiberStarAlgebra (Setoid.ker readout) := by
  apply le_antisymm
  · rintro f ⟨g, rfl⟩ y z hyz
    exact congrArg g hyz
  · intro f hf
    let descend : O -> ℂ := fun value =>
      f (Classical.choose (hreadout value))
    refine ⟨descend, ?_⟩
    funext y
    exact hf (Classical.choose_spec (hreadout (readout y)))

private theorem finite_closure_le_word_fiber
    {Y O : Type*} (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) (depth : Nat) :
    finiteKoopmanClosure update readout depth <=
      fiberStarAlgebra
        (Setoid.ker (futureReadoutWord update readout depth)) := by
  apply StarAlgebra.adjoin_le
  rintro f ⟨n, hn, g, hg, rfl⟩ y z hyz
  have hgFiber : g ∈ fiberStarAlgebra (Setoid.ker readout) := by
    rw [← initial_observable_algebra_eq_fiber readout hreadout]
    exact hg
  apply hgFiber
  have hcoordinate := congrFun hyz
    (show Fin (depth + 1) from ⟨n, Nat.lt_succ_of_le hn⟩)
  change readout ((update^[n]) y) = readout ((update^[n]) z)
  simpa only [futureReadoutWord] using hcoordinate

private noncomputable def wordClassIndicator
    {Y O : Type*} (update : Y -> Y) (readout : Y -> O)
    (depth : Nat) (center : Y) : Y -> ℂ := fun state =>
  @ite ℂ
    (futureReadoutWord update readout depth state =
      futureReadoutWord update readout depth center)
    (Classical.propDecidable _) 1 0

private theorem word_class_indicator_mem
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) (depth : Nat) (center : Y) :
    wordClassIndicator update readout depth center ∈
      finiteKoopmanClosure update readout depth := by
  classical
  let word := futureReadoutWord update readout depth
  let outside : Finset Y :=
    Finset.univ.filter fun state => word state ≠ word center
  have witnesses : forall state : Y, exists coordinate : Fin (depth + 1),
      word state = word center \/
        word state coordinate ≠ word center coordinate := by
    intro state
    by_cases hword : word state = word center
    · exact ⟨0, Or.inl hword⟩
    · have hcoordinate : exists coordinate, word state coordinate ≠
          word center coordinate := by
        by_contra hall
        push Not at hall
        exact hword (funext hall)
      exact ⟨Classical.choose hcoordinate,
        Or.inr (Classical.choose_spec hcoordinate)⟩
  choose coordinate hcoordinate using witnesses
  let sourceFiber (state : Y) : Y -> ℂ := fun point =>
    if readout point = readout ((update^[coordinate state]) center) then 1 else 0
  have hsourceFiber : forall state,
      sourceFiber state ∈ initialObservableAlgebra readout := by
    intro state
    rw [initial_observable_algebra_eq_fiber readout hreadout]
    intro first second hsame
    simp only [sourceFiber]
    rw [hsame]
  let factor (state : Y) : Y -> ℂ :=
    sourceFiber state ∘ (update^[coordinate state])
  have hfactor : ∀ state ∈ outside,
      factor state ∈ finiteKoopmanClosure update readout depth := by
    intro state hstate
    apply StarAlgebra.subset_adjoin
    refine ⟨coordinate state, Nat.le_of_lt_succ (coordinate state).isLt,
      sourceFiber state, hsourceFiber state, rfl⟩
  let indicator : Y -> ℂ := ∏ state ∈ outside, factor state
  have hindicator : indicator ∈ finiteKoopmanClosure update readout depth := by
    exact (finiteKoopmanClosure update readout depth).prod_mem hfactor
  have hindicator_value : forall state,
      indicator state = if word state = word center then 1 else 0 := by
    intro state
    by_cases hword : word state = word center
    · rw [if_pos hword]
      simp only [indicator, Finset.prod_apply]
      apply Finset.prod_eq_one
      intro point hpoint
      have hsame := congrFun hword (coordinate point)
      have hreadoutSame :
          readout ((update^[coordinate point]) state) =
            readout ((update^[coordinate point]) center) := by
        simpa only [word, futureReadoutWord] using hsame
      simp [factor, sourceFiber, hreadoutSame]
    · rw [if_neg hword]
      have hmem : state ∈ outside :=
        Finset.mem_filter.mpr ⟨Finset.mem_univ _, hword⟩
      simp only [indicator, Finset.prod_apply]
      apply Finset.prod_eq_zero hmem
      have hdifferent := (hcoordinate state).resolve_left hword
      simp [factor, sourceFiber, word] at hdifferent ⊢
      exact hdifferent
  have heq : wordClassIndicator update readout depth center = indicator := by
    funext state
    by_cases hword : word state = word center
    · simp [wordClassIndicator, word, hword, hindicator_value state]
    · simp [wordClassIndicator, word, hword, hindicator_value state]
  rw [heq]
  exact hindicator

private theorem word_fiber_le_finite_closure
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) (depth : Nat) :
    fiberStarAlgebra
        (Setoid.ker (futureReadoutWord update readout depth)) <=
      finiteKoopmanClosure update readout depth := by
  classical
  intro f hf
  let relation := Setoid.ker (futureReadoutWord update readout depth)
  let quotient := Quotient relation
  let descend : quotient -> ℂ := Quotient.lift f (by
    intro first second hsame
    exact hf hsame)
  let indicator (state : quotient) : Y -> ℂ := fun point =>
    if state = Quotient.mk relation point then 1 else 0
  have hindicator : forall state, indicator state ∈
      finiteKoopmanClosure update readout depth := by
    intro state
    induction state using Quotient.inductionOn with
    | _ center =>
      have heq : indicator (Quotient.mk relation center) =
          wordClassIndicator update readout depth center := by
        funext point
        by_cases hword : futureReadoutWord update readout depth point =
            futureReadoutWord update readout depth center
        · have hquotient : Quotient.mk relation center =
              Quotient.mk relation point := Quotient.sound hword.symm
          simp [indicator, wordClassIndicator, hword, hquotient]
        · have hquotient : Quotient.mk relation center ≠
              Quotient.mk relation point := by
            intro heq
            exact hword (Quotient.exact heq).symm
          simp [indicator, wordClassIndicator, hword, hquotient]
      rw [heq]
      exact word_class_indicator_mem update readout hreadout depth center
  let expansion : Y -> ℂ := ∑ state : quotient, descend state • indicator state
  have hexpansion : expansion ∈ finiteKoopmanClosure update readout depth := by
    exact (finiteKoopmanClosure update readout depth).sum_mem fun state _ =>
      (finiteKoopmanClosure update readout depth).smul_mem
        (hindicator state) (descend state)
  have hexpansion_eq : expansion = f := by
    funext point
    have hsum : (∑ state : quotient, descend state • indicator state point) =
        descend (Quotient.mk relation point) •
          indicator (Quotient.mk relation point) point := by
      apply Finset.sum_eq_single
      · intro state _ hstate
        have hzero : indicator state point = 0 := by
          simp [indicator, hstate]
        simp [hzero]
      · intro hnot
        exact (hnot (Finset.mem_univ _)).elim
    change (∑ state : quotient, descend state • indicator state) point = f point
    rw [Finset.sum_apply]
    simp only [Pi.smul_apply]
    rw [hsum]
    simp [indicator, descend]
  rw [← hexpansion_eq]
  exact hexpansion

private theorem finite_koopman_closure_eq_word_fiber
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) (depth : Nat) :
    finiteKoopmanClosure update readout depth =
      fiberStarAlgebra
        (Setoid.ker (futureReadoutWord update readout depth)) := by
  exact le_antisymm
    (finite_closure_le_word_fiber update readout hreadout depth)
    (word_fiber_le_finite_closure update readout hreadout depth)

private theorem prediction_stable_depth_exists
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O) :
    exists depth, predictionStableAt update readout depth := by
  refine ⟨completionDepth update readout, ?_⟩
  intro first second hword
  have hcomplete := completion_depth_determines_itinerary
    update readout first second hword
  exact congrFun hcomplete (completionDepth update readout + 1)

private theorem least_depth_stable
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O) :
    predictionStableAt update readout
      (predictionStabilityDepth update readout) :=
  prediction_stability_depth_is_stable update readout
    (prediction_stable_depth_exists update readout)

private theorem least_depth_relation_stable
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O) :
    Setoid.ker (futureReadoutWord update readout
      (predictionStabilityDepth update readout)) =
    Setoid.ker (futureReadoutWord update readout
      (predictionStabilityDepth update readout + 1)) := by
  let depth := predictionStabilityDepth update readout
  apply Setoid.ext
  intro first second
  constructor
  · intro hword
    funext coordinate
    by_cases hlast : coordinate.val = depth + 1
    · have hnext := least_depth_stable update readout first second hword
      simpa only [futureReadoutWord, hlast] using hnext
    · have hle : coordinate.val <= depth := by omega
      have hcoordinate := congrFun hword
        (show Fin (depth + 1) from ⟨coordinate, Nat.lt_succ_of_le hle⟩)
      simpa only [futureReadoutWord] using hcoordinate
  · intro hword
    funext coordinate
    have hcoordinate := congrFun hword
      (show Fin (depth + 1 + 1) from ⟨coordinate, by omega⟩)
    simpa only [futureReadoutWord] using hcoordinate

private theorem least_depth_word_relation_eq_stable_relation
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O) :
    Setoid.ker (futureReadoutWord update readout
      (predictionStabilityDepth update readout)) =
    stableRelation (Setoid.ker readout) update := by
  let depth := predictionStabilityDepth update readout
  have hrelation := least_depth_relation_stable update readout
  have hstep : forall first second,
      futureReadoutWord update readout depth first =
          futureReadoutWord update readout depth second <->
        futureReadoutWord update readout (depth + 1) first =
          futureReadoutWord update readout (depth + 1) second := by
    intro first second
    exact Setoid.ext_iff.mp hrelation first second
  have hforever := prediction_partition_stable_forever
    update readout depth hstep
  funext first second
  apply propext
  constructor
  · intro hword n
    have hlong := (hforever.2 n first second).mpr hword
    have hcoordinate := congrFun hlong
      (show Fin (depth + n + 1) from ⟨n, by omega⟩)
    change readout ((update^[n]) first) = readout ((update^[n]) second)
    simpa only [futureReadoutWord] using hcoordinate
  · intro hstable
    funext coordinate
    exact hstable coordinate

private theorem finite_closure_eq_full_at_least_depth
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) :
    finiteKoopmanClosure update readout
        (predictionStabilityDepth update readout) =
      koopmanClosure (Setoid.ker readout) update := by
  calc
    finiteKoopmanClosure update readout
        (predictionStabilityDepth update readout) =
        fiberStarAlgebra
          (Setoid.ker (futureReadoutWord update readout
            (predictionStabilityDepth update readout))) :=
      finite_koopman_closure_eq_word_fiber update readout hreadout _
    _ = fiberStarAlgebra (stableRelation (Setoid.ker readout) update) := by
      rw [least_depth_word_relation_eq_stable_relation update readout]
    _ = koopmanClosure (Setoid.ker readout) update :=
      (koopman_closure_eq_stable_fiber_algebra update
        (Setoid.ker readout).iseqv).symm

private theorem finite_closure_mono
    {Y O : Type*} (update : Y -> Y) (readout : Y -> O)
    {first second : Nat} (hdepth : first <= second) :
    finiteKoopmanClosure update readout first <=
      finiteKoopmanClosure update readout second := by
  apply StarAlgebra.adjoin_le
  intro f hf
  apply StarAlgebra.subset_adjoin
  rcases hf with ⟨n, hn, g, hg, rfl⟩
  exact ⟨n, hn.trans hdepth, g, hg, rfl⟩

private theorem finite_closure_le_full
    {Y O : Type*} (update : Y -> Y) (readout : Y -> O) (depth : Nat) :
    finiteKoopmanClosure update readout depth <=
      koopmanClosure (Setoid.ker readout) update := by
  apply StarAlgebra.adjoin_le
  rintro f ⟨n, _, g, hg, rfl⟩
  apply StarAlgebra.subset_adjoin
  have hgFiber : g ∈ fiberStarAlgebra (Setoid.ker readout) := by
    rintro first second hsame
    rcases hg with ⟨source, rfl⟩
    exact congrArg source hsame
  exact ⟨n, g, hgFiber, rfl⟩

private theorem finite_closure_invariant_at_least_depth
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) :
    PullbackInvariant update
      (finiteKoopmanClosure update readout
        (predictionStabilityDepth update readout)) := by
  let depth := predictionStabilityDepth update readout
  have hrelation := least_depth_relation_stable update readout
  have hstep : forall first second,
      futureReadoutWord update readout depth first =
          futureReadoutWord update readout depth second <->
        futureReadoutWord update readout (depth + 1) first =
          futureReadoutWord update readout (depth + 1) second := by
    intro first second
    exact Setoid.ext_iff.mp hrelation first second
  have hpreserves :=
    (prediction_partition_stable_forever update readout depth hstep).1
  intro f hf
  rw [finite_koopman_closure_eq_word_fiber
    update readout hreadout depth] at hf ⊢
  intro first second hsame
  exact hf (hpreserves first second hsame)

private theorem finite_closure_is_least
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) :
    finiteKoopmanClosure update readout
        (predictionStabilityDepth update readout) =
      sInf (invariantObservableExtensions update readout) := by
  let depth := predictionStabilityDepth update readout
  apply le_antisymm
  · intro f hf
    rw [StarSubalgebra.mem_sInf]
    intro algebra halgebra
    have hle : finiteKoopmanClosure update readout depth <= algebra := by
      apply StarAlgebra.adjoin_le
      rintro generator ⟨n, hn, g, hg, rfl⟩
      have hiterate : forall k, g ∘ (update^[k]) ∈ algebra := by
        intro k
        induction k with
        | zero =>
          simpa using halgebra.1 hg
        | succ k ih =>
          simpa only [Function.comp_def, Function.iterate_succ_apply] using
            halgebra.2 _ ih
      exact hiterate n
    exact hle hf
  · apply sInf_le
    refine ⟨?_, finite_closure_invariant_at_least_depth
      update readout hreadout⟩
    intro g hg
    apply StarAlgebra.subset_adjoin
    exact ⟨0, Nat.zero_le _, g, hg, by simp⟩

/-- Functions on equivalent index types form canonically equivalent pointwise
star algebras. -/
def functionAlgebraEquiv {X Z : Type*} (equiv : X ≃ Z) :
    (X -> ℂ) ≃⋆ₐ[ℂ] (Z -> ℂ) :=
  StarAlgEquiv.ofBijective (readoutPullback equiv.symm) ⟨
    (by
      intro first second hsame
      funext state
      have hpoint := congrFun hsame (equiv state)
      change first (equiv.symm (equiv state)) =
        second (equiv.symm (equiv state)) at hpoint
      rw [equiv.symm_apply_apply] at hpoint
      exact hpoint),
    (by
      intro target
      refine ⟨readoutPullback equiv target, ?_⟩
      funext state
      change target (equiv (equiv.symm state)) = target state
      rw [equiv.apply_symm_apply])⟩

private def finite_closure_to_word_functions
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) (depth : Nat) :
    finiteKoopmanClosure update readout depth →⋆ₐ[ℂ]
      (PredictionState update readout depth -> ℂ) where
  toFun := fun f => Quotient.lift f.1 (by
    intro first second hsame
    exact (finite_closure_le_word_fiber update readout hreadout depth
      f.property) hsame)
  map_one' := by
    funext state
    induction state using Quotient.inductionOn
    rfl
  map_mul' := by
    intro f g
    funext state
    induction state using Quotient.inductionOn
    rfl
  map_zero' := by
    funext state
    induction state using Quotient.inductionOn
    rfl
  map_add' := by
    intro f g
    funext state
    induction state using Quotient.inductionOn
    rfl
  commutes' := by
    intro scalar
    funext state
    induction state using Quotient.inductionOn
    rfl
  map_star' := by
    intro f
    funext state
    induction state using Quotient.inductionOn
    rfl

private theorem finite_closure_to_word_functions_bijective
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) (depth : Nat) :
    Function.Bijective
      (finite_closure_to_word_functions update readout hreadout depth) := by
  constructor
  · intro first second heq
    apply Subtype.ext
    funext state
    exact congrFun heq (Quotient.mk _ state)
  · intro target
    let lifted : Y -> ℂ := fun state => target (Quotient.mk _ state)
    have hlifted : lifted ∈ fiberStarAlgebra
        (Setoid.ker (futureReadoutWord update readout depth)) := by
      intro first second hsame
      exact congrArg target (Quotient.sound hsame)
    have hmem : lifted ∈ finiteKoopmanClosure update readout depth := by
      rw [finite_koopman_closure_eq_word_fiber
        update readout hreadout depth]
      exact hlifted
    refine ⟨⟨lifted, hmem⟩, ?_⟩
    funext state
    induction state using Quotient.inductionOn
    rfl

/-- The bounded generated algebra is canonically the function algebra on its
realized finite-word quotient. -/
noncomputable def finiteObservableAlgebraEquiv
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) (depth : Nat) :
    finiteKoopmanClosure update readout depth ≃⋆ₐ[ℂ]
      (PredictionState update readout depth -> ℂ) :=
  StarAlgEquiv.ofBijective
    (finite_closure_to_word_functions update readout hreadout depth)
    (finite_closure_to_word_functions_bijective
      update readout hreadout depth)

/-- At the least stable depth, the observable algebra is canonically the
function algebra on complete prediction states. -/
noncomputable def stableObservableAlgebraEquiv
    {Y O : Type*} [Fintype Y] (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) :
    finiteKoopmanClosure update readout
        (predictionStabilityDepth update readout) ≃⋆ₐ[ℂ]
      (CompletedState update readout -> ℂ) :=
  (finiteObservableAlgebraEquiv update readout hreadout _).trans
    (functionAlgebraEquiv
      (stableCompletionEquiv update readout _
        (least_depth_relation_stable update readout)))

/-- The source-generated finite pullback chain stabilizes at its least
prediction-stable depth, is invariant there, equals the intersection of all
invariant unital star-algebra extensions, and is canonically the function
algebra of complete prediction states. -/
theorem least_invariant_observable_algebra
    {Y O : Type*} [Fintype Y] [Nonempty Y]
    (update : Y -> Y) (readout : Y -> O)
    (hreadout : Function.Surjective readout) :
    let depth := predictionStabilityDepth update readout
    (forall first second, first <= second ->
      finiteKoopmanClosure update readout first <=
        finiteKoopmanClosure update readout second) /\
      finiteKoopmanClosure update readout depth =
        finiteKoopmanClosure update readout (depth + 1) /\
      PullbackInvariant update (finiteKoopmanClosure update readout depth) /\
      finiteKoopmanClosure update readout depth =
        sInf (invariantObservableExtensions update readout) /\
      forall (f : finiteKoopmanClosure update readout depth) (state : Y),
        stableObservableAlgebraEquiv update readout hreadout f
            (completionProjection update readout state) = f.1 state := by
  dsimp only
  let depth := predictionStabilityDepth update readout
  have hfull := finite_closure_eq_full_at_least_depth
    update readout hreadout
  have hforward : finiteKoopmanClosure update readout depth <=
      finiteKoopmanClosure update readout (depth + 1) :=
    finite_closure_mono update readout (Nat.le_succ depth)
  have hbackward : finiteKoopmanClosure update readout (depth + 1) <=
      finiteKoopmanClosure update readout depth := by
    rw [hfull]
    exact finite_closure_le_full update readout (depth + 1)
  refine ⟨fun _ _ hdepth => finite_closure_mono update readout hdepth,
    le_antisymm hforward hbackward,
    finite_closure_invariant_at_least_depth update readout hreadout,
    finite_closure_is_least update readout hreadout, ?_⟩
  intro f state
  unfold stableObservableAlgebraEquiv
  change
    (finiteObservableAlgebraEquiv update readout hreadout depth f)
        ((stableCompletionEquiv update readout depth
          (least_depth_relation_stable update readout)).symm
            (completionProjection update readout state)) = f.1 state
  have hcompletion :
      (stableCompletionEquiv update readout depth
          (least_depth_relation_stable update readout)).symm
          (completionProjection update readout state) =
        (Quotient.mk _ state : PredictionState update readout depth) := by
    apply (stableCompletionEquiv update readout depth
      (least_depth_relation_stable update readout)).injective
    rw [(stableCompletionEquiv update readout depth
      (least_depth_relation_stable update readout)).apply_symm_apply]
    rfl
  rw [hcompletion]
  rfl

