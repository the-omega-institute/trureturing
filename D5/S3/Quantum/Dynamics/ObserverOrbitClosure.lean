import Mathlib.Algebra.Module.Submodule.Invariant
import Mathlib.Analysis.InnerProductSpace.Basic
import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# Observer orbit closure

For a linear evolution `K`, the observer closure of a visible subspace `W` is generated by all
forward images `K ^ n` of `W`.  In finite dimension this algebraic submodule is the source's
power-orbit span without any additional topological closure.
-/

noncomputable section

namespace D5.S3.Quantum.Dynamics.ObserverOrbitClosure

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- The subspace generated by all forward power images of the visible subspace. -/
def observerClosure (K : Module.End ℝ V) (W : Submodule ℝ V) : Submodule ℝ V :=
  ⨆ n : ℕ, W.map (K ^ n)

private theorem le_observer_closure (K : Module.End ℝ V) (W : Submodule ℝ V) :
    W ≤ observerClosure K W := by
  simpa [observerClosure, Module.End.one_eq_id] using
    (le_iSup (fun n : ℕ => W.map (K ^ n)) 0 :
      W.map (K ^ 0) ≤ ⨆ n : ℕ, W.map (K ^ n))

private theorem observer_closure_invariant
    (K : Module.End ℝ V) (W : Submodule ℝ V) :
    observerClosure K W ∈ K.invtSubmodule := by
  rw [Module.End.mem_invtSubmodule_iff_map_le]
  rw [observerClosure, Submodule.map_iSup]
  refine iSup_le fun n => ?_
  calc
    (W.map (K ^ n)).map K = W.map (K ^ (n + 1)) := by
      rw [← Submodule.map_comp]
      congr 1
      ext x
      simp [pow_succ']
    _ ≤ ⨆ m : ℕ, W.map (K ^ m) :=
      le_iSup (fun m : ℕ => W.map (K ^ m)) (n + 1)

private theorem observer_closure_le
    (K : Module.End ℝ V) {W U : Submodule ℝ V}
    (hWU : W ≤ U) (hInvariant : U ∈ K.invtSubmodule) :
    observerClosure K W ≤ U := by
  rw [observerClosure]
  refine iSup_le fun n => ?_
  induction n with
  | zero => simpa [Module.End.one_eq_id] using hWU
  | succ n ih =>
      have hMap : U.map K ≤ U :=
        (Module.End.mem_invtSubmodule_iff_map_le K).mp hInvariant
      calc
        W.map (K ^ (n + 1)) = (W.map (K ^ n)).map K := by
          rw [← Submodule.map_comp]
          congr 1
          ext x
          simp [pow_succ']
        _ ≤ U.map K := Submodule.map_mono ih
        _ ≤ U := hMap

/-- The power-orbit construction is extensive, monotone, and idempotent.  It is invariant under
`K`, and it lies in every `K`-invariant subspace that contains the original visible subspace. -/
theorem observer_closure_is_least_invariant
    [FiniteDimensional ℝ V]
    (K : Module.End ℝ V) (W : Submodule ℝ V) :
    W ≤ observerClosure K W ∧
    (∀ W₁ W₂ : Submodule ℝ V, W₁ ≤ W₂ →
      observerClosure K W₁ ≤ observerClosure K W₂) ∧
    observerClosure K (observerClosure K W) = observerClosure K W ∧
    observerClosure K W ∈ K.invtSubmodule ∧
    (∀ U : Submodule ℝ V, W ≤ U → U ∈ K.invtSubmodule →
      observerClosure K W ≤ U) := by
  refine ⟨le_observer_closure K W, ?_, ?_, observer_closure_invariant K W, ?_⟩
  · intro W₁ W₂ hW
    apply observer_closure_le K
    · exact hW.trans (le_observer_closure K W₂)
    · exact observer_closure_invariant K W₂
  · apply le_antisymm
    · exact observer_closure_le K le_rfl (observer_closure_invariant K W)
    · exact le_observer_closure K (observerClosure K W)
  · intro U hWU hU
    exact observer_closure_le K hWU hU

#print axioms observer_closure_is_least_invariant

end D5.S3.Quantum.Dynamics.ObserverOrbitClosure
