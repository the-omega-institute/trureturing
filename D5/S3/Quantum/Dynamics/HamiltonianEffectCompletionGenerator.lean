namespace D5.S3.Quantum.Dynamics.HamiltonianEffectCompletionGenerator

open D5.S3.Quantum.Dynamics.AnalyticFlowGeneration
open D5.S3.Quantum.Dynamics.ProjectionProbabilityFlow

variable {n : Type*} [Fintype n]

local instance : DecidableEq n := Classical.decEq n

local instance (priority := 2000) : NormedAddCommGroup (Matrix n n ℂ) :=
  Matrix.instL2OpNormedAddCommGroup

local instance (priority := 2000) : NormedSpace ℂ (Matrix n n ℂ) :=
  Matrix.instL2OpNormedSpace

local instance (priority := 2000) : NormedRing (Matrix n n ℂ) :=
  Matrix.instL2OpNormedRing

local instance (priority := 2000) : NormedAlgebra ℂ (Matrix n n ℂ) :=
  Matrix.instL2OpNormedAlgebra

/-- The Heisenberg effect orbit `E(t) = U_{-t} E U_t`. -/
def hamiltonianEffectOrbit (H E : Matrix n n ℂ) (t : ℝ) : Matrix n n ℂ :=
  hamiltonianPropagator H (-t) * E * hamiltonianPropagator H t

private theorem hasDerivAt_hamiltonianEffectOrbit
    (H E : Matrix n n ℂ) (t : ℝ) :
    HasDerivAt (hamiltonianEffectOrbit H E)
      (Complex.I •
        (H * hamiltonianEffectOrbit H E t - hamiltonianEffectOrbit H E t * H)) t := by
  let G := hamiltonianGenerator H
  have hPositive : HasDerivAt (hamiltonianPropagator H)
      (hamiltonianPropagator H t * G) t := by
    exact hasDerivAt_exp_smul_const G t
  have hNegative : HasDerivAt (fun s : ℝ => hamiltonianPropagator H (-s))
      (-(hamiltonianPropagator H (-t) * G)) t := by
    have hExp : HasDerivAt (fun s : ℝ => exp (s • G))
        (exp ((-t) • G) * G) (-t) := hasDerivAt_exp_smul_const G (-t)
    have hNeg : HasDerivAt (fun s : ℝ => -s) (-1) t := hasDerivAt_neg t
    have hComp := hExp.scomp t hNeg
    change HasDerivAt
      (fun s : ℝ => exp ((-s) • G))
      ((-1 : ℝ) • (exp ((-t) • G) * G)) t at hComp
    simpa [hamiltonianPropagator, G] using hComp
  have hRaw := (hNegative.mul_const E).mul hPositive
  apply hRaw.congr_deriv
  have hCommute : H * hamiltonianPropagator H (-t) =
      hamiltonianPropagator H (-t) * H := by
    apply (Commute.exp_right _).eq
    exact ((Commute.refl H).smul_right (-Complex.I)).smul_right (-t)
  calc
    -(hamiltonianPropagator H (-t) * G) * E * hamiltonianPropagator H t +
        hamiltonianPropagator H (-t) * E * (hamiltonianPropagator H t * G) =
      Complex.I •
        ((hamiltonianPropagator H (-t) * H) * E * hamiltonianPropagator H t -
          (hamiltonianPropagator H (-t) * E * hamiltonianPropagator H t) * H) := by
      dsimp [G, hamiltonianGenerator]
      simp only [neg_mul, mul_smul_comm, smul_mul_assoc,
        smul_add, Matrix.mul_assoc, sub_eq_add_neg]
      simp only [neg_smul, smul_neg, neg_neg]
    _ = Complex.I •
        ((H * hamiltonianPropagator H (-t)) * E * hamiltonianPropagator H t -
          (hamiltonianPropagator H (-t) * E * hamiltonianPropagator H t) * H) := by
      rw [hCommute]
    _ = Complex.I •
        (H * hamiltonianEffectOrbit H E t - hamiltonianEffectOrbit H E t * H) := by
      simp only [hamiltonianEffectOrbit, Matrix.mul_assoc]

/-- At time zero, a Hamiltonian effect orbit differentiates to `i` times its commutator. -/
theorem hamiltonian_effect_orbit_hasDerivAt_zero (H E : Matrix n n ℂ) :
    HasDerivAt (hamiltonianEffectOrbit H E) (Complex.I • (H * E - E * H)) 0 := by
  simpa [hamiltonianEffectOrbit, hamiltonianPropagator] using
    hasDerivAt_hamiltonianEffectOrbit H E 0

#print axioms hamiltonian_effect_orbit_hasDerivAt_zero

/-- The effect-orbit derivative and the full commutator reflector are generated by the same
Hamiltonian commutator endomorphism. -/
theorem hamiltonian_effect_completion_generator
    (H : Matrix n n ℂ) (initial : Submodule ℂ (Matrix n n ℂ)) :
    (∀ E : Matrix n n ℂ,
      HasDerivAt (hamiltonianEffectOrbit H E) (Complex.I • (H * E - E * H)) 0) ∧
      Submodule.span ℂ
          {A | ∃ (t : ℝ) (E : Matrix n n ℂ), E ∈ initial ∧
            A = hamiltonianEffectOrbit H E t} =
        ⨆ k : ℕ,
          initial.map
            ((LinearMap.mulLeft ℂ H - LinearMap.mulRight ℂ H) ^ k) := by
  constructor
  · exact hamiltonian_effect_orbit_hasDerivAt_zero H
  · simpa [hamiltonianEffectOrbit] using
      analytic_flow_generates_commutator_closure H initial

#print axioms hamiltonian_effect_completion_generator

/-- A zero Hamiltonian makes every effect orbit the constant identity action. -/
theorem zero_hamiltonian_effect_orbit (E : Matrix n n ℂ) :
    hamiltonianEffectOrbit 0 E = fun _ => E := by
  funext t
  simp [hamiltonianEffectOrbit, hamiltonianPropagator, hamiltonianGenerator]

#print axioms zero_hamiltonian_effect_orbit

/-- On the empty index type, every Hamiltonian effect orbit is constant. -/
theorem empty_hamiltonian_effect_orbit (H E : Matrix Empty Empty ℂ) :
    hamiltonianEffectOrbit H E = fun _ => E := by
  funext t
  ext i
  exact Empty.elim i

#print axioms empty_hamiltonian_effect_orbit

/-- The natural zero-dimensional matrix case is the empty-index degeneracy. -/
theorem fin_zero_hamiltonian_effect_orbit (H E : Matrix (Fin 0) (Fin 0) ℂ) :
    hamiltonianEffectOrbit H E = fun _ => E := by
  funext t
  ext i
  exact Fin.elim0 i

#print axioms fin_zero_hamiltonian_effect_orbit

/-- Every one-dimensional effect orbit has zero derivative at time zero. -/
theorem fin_one_hamiltonian_effect_orbit_hasDerivAt_zero
    (H E : Matrix (Fin 1) (Fin 1) ℂ) :
    HasDerivAt (hamiltonianEffectOrbit H E) 0 0 := by
  have hComm : H * E - E * H = 0 := by
    ext i j
    have hi : i = 0 := Subsingleton.elim _ _
    have hj : j = 0 := Subsingleton.elim _ _
    subst i
    subst j
    simp [Matrix.mul_apply, mul_comm]
  simpa [hComm] using hamiltonian_effect_orbit_hasDerivAt_zero H E

#print axioms fin_one_hamiltonian_effect_orbit_hasDerivAt_zero

end D5.S3.Quantum.Dynamics.HamiltonianEffectCompletionGenerator
