  rw [phase21, integer_coordinate_0]; (try simp only [mul_add, mul_neg, mul_one, mul_neg_one, Complex.exp_add, Complex.exp_neg]); (try norm_num [basisPhase, Complex.exp_neg]); (try simpa [mul_comm] using Complex.exp_nat_mul c 2); (try ring)
