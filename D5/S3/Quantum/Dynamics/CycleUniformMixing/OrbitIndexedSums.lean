inductive Poly where
 | tip : (Exp × Int) → Poly
 | node : Nat → Poly → Poly → Poly
def size : Poly → Nat
 | .tip _ => 1
 | .node n _ r => n + size r
def valid : Poly → Bool
 | .tip _ => true
 | .node n l r => decide (n = size l) && valid l && valid r
def lookup : Poly → Nat → (Exp × Int)
 | .tip t, _ => t
 | .node n l r, i => if i < n then lookup l i else lookup r (i-n)
def sumValues {K : Type*} [AddCommMonoid K] (F : (Exp × Int) → K) : Poly → K
 | .tip t => F t
 | .node _ l r => sumValues F l + sumValues F r
theorem indexed_sum {K : Type*} [AddCommMonoid K] (F : (Exp × Int) → K) (p : Poly)
 (hv : valid p = true) : (∑ i ∈ Finset.range (size p), F (lookup p i)) = sumValues F p := by
 induction p with
 | tip t => simp [size, lookup, sumValues]
 | node n l r il ir =>
   simp only [valid, Bool.and_eq_true, decide_eq_true_eq] at hv
   rcases hv with ⟨⟨hn, hl⟩, hr⟩
   rw [size, Finset.sum_range_add]
   have left : (∑ i ∈ Finset.range n, F (lookup (.node n l r) i)) = sumValues F l := by
     rw [hn]
     have he : (∑ i ∈ Finset.range (size l), F (lookup (.node (size l) l r) i)) = ∑ i ∈ Finset.range (size l), F (lookup l i) := by
       apply Finset.sum_congr rfl
       intro i hi
       simp only [Finset.mem_range] at hi
       simp only [lookup, if_pos hi]
     rw [he, il hl]
   have right : (∑ i ∈ Finset.range (size r), F (lookup (.node n l r) (n+i))) = sumValues F r := by
     have he : (∑ i ∈ Finset.range (size r), F (lookup (.node n l r) (n+i))) = ∑ i ∈ Finset.range (size r), F (lookup r i) := by
       apply Finset.sum_congr rfl
       intro i hi
       simp only [lookup, if_neg (by omega : ¬ n+i<n), Nat.add_sub_cancel_left]
     rw [he, ir hr]
   rw [left, right]
   rfl
def mulTerm (t u : (Exp × Int)) : (Exp × Int) := (plus t.1 u.1,t.2*u.2)
variable {K : Type*} [CommRing K]
def evalPoly (F : Exp → K) (p : Poly) : K := sumValues (fun t => (t.2 : K)*F t.1) p
