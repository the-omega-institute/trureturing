def groupOfNat (n : Nat) : (ZMod 6 × ZMod 2) := ((n%6 : Nat),(n/6 : Nat))
def zeroExp : Exp := ⟨0,0,0,0,0,0⟩
def checkInc (src : Nat → (Exp × Int)) (rep : Exp) : (D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Index.Tree Nat) → Bool
 | .tip i g => decide (act (groupOfNat g) (src i).1 = rep)
 | .node _ l r => checkInc src rep l && checkInc src rep r
def coefficientSum (src : Nat → (Exp × Int)) : (D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Index.Tree Nat) → Int
 | .tip i _ => (src i).2
 | .node _ l r => coefficientSum src l + coefficientSum src r
variable {K : Type*} [CommRing K]
def evalInc (F : Exp → K) (src : Nat → (Exp × Int)) : (D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Index.Tree Nat) → K
 | .tip i _ => ((src i).2 : K) * norm F (src i).1
 | .node _ l r => evalInc F src l + evalInc F src r
inductive Rows where
 | row : Exp → Int → (D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Index.Tree Nat) → Rows
 | node : Nat → Rows → Rows → Rows
def ids : Rows → (D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Index.Tree Nat)
 | .row _ _ t => t
 | .node lo l r => .node lo (ids l) (ids r)
def rowCheck (src : Nat → (Exp × Int)) : Rows → Bool
 | .row rep expected t => checkInc src rep t && decide (coefficientSum src t = expected)
 | .node _ l r => rowCheck src l && rowCheck src r
theorem combine_checked (src : Nat → (Exp × Int)) (lo : Nat) (l r : Rows)
 (hl : rowCheck src l = true) (hr : rowCheck src r = true) :
 rowCheck src (.node lo l r) = true := by
 rw [rowCheck,hl,hr]
 rfl
def targetCheck : Rows → Bool
 | .row rep expected _ => decide (expected = 0 ∨ rep = zeroExp)
 | .node _ l r => targetCheck l && targetCheck r
def targetSum : Rows → Int
 | .row _ expected _ => expected
 | .node _ l r => targetSum l + targetSum r
def targetValue (F : Exp → K) : Rows → K
 | .row rep expected _ => (expected : K)*norm F rep
 | .node _ l r => targetValue F l + targetValue F r
