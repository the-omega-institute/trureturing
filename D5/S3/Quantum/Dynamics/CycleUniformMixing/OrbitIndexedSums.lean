open scoped BigOperators
open scoped BigOperators
namespace D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier
noncomputable section
variable {N : ℕ} [NeZero N]
private def corr (z : ZMod N → ℂ) (l : ZMod N) : ℂ :=
  ∑ j, z (j+l) * (starRingEnd ℂ) (z j)
private theorem char_star (x : ZMod N) : (starRingEnd ℂ) (ZMod.stdAddChar x) = ZMod.stdAddChar (-x) := by
  simpa only [ZMod.stdAddChar_apply, AddChar.map_neg_eq_inv, Circle.coe_inv] using
    (Circle.coe_inv_eq_conj (ZMod.toCircle x)).symm
private theorem corr_transform (z : ZMod N → ℂ) (k : ZMod N) :
    ZMod.dft (corr z) k = (Complex.normSq (ZMod.dft z k) : ℂ) := by
  rw [ZMod.dft_apply, Complex.normSq_eq_conj_mul_self]
  simp only [corr, smul_eq_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  simp only [ZMod.dft_apply, smul_eq_mul, map_sum, map_mul, char_star, neg_neg]
  rw [Finset.sum_mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  apply Fintype.sum_equiv (Equiv.addLeft j)
  intro l
  simp only [Equiv.coe_addLeft]
  have hc : ZMod.stdAddChar (-(l*k)) =
      ZMod.stdAddChar (j*k) * ZMod.stdAddChar (-((j+l)*k)) := by
    rw [← AddChar.map_add_eq_mul]
    congr 1
    ring
  rw [hc]
  ring
private theorem corr_zero (z : ZMod N → ℂ) (hz : ∀ j, Complex.normSq (z j) = 1) :
    corr z 0 = (N : ℂ) := by
  have h (j : ZMod N) : z j * (starRingEnd ℂ) (z j) = 1 := by
    have h' := congrArg (fun r : ℝ => (r : ℂ)) (hz j)
    simpa only [Complex.normSq_eq_conj_mul_self, Complex.ofReal_one, mul_comm] using h'
  simp [corr, h]
private theorem dft_delta : ZMod.dft (fun l : ZMod N => if l = 0 then (N : ℂ) else 0) =
    (fun _ => (N : ℂ)) := by
  ext k
  simp [ZMod.dft_apply]
private theorem flat_iff_corr (z : ZMod N → ℂ) (hz : ∀ j, Complex.normSq (z j) = 1) :
    (∀ k, Complex.normSq (ZMod.dft z k) = N) ↔
    (∀ l, l ≠ 0 → corr z l = 0) := by
  constructor
  · intro h
    have hd : ZMod.dft (corr z) = ZMod.dft (fun l => if l = 0 then (N : ℂ) else 0) := by
      rw [dft_delta]
      ext k
      rw [corr_transform, h]
      simp
    have he := ZMod.dft.injective hd
    intro l hl
    simpa [hl] using congrFun he l
  · intro h k
    have he : corr z = (fun l => if l = 0 then (N : ℂ) else 0) := by
      ext l
      by_cases hl : l = 0
      · simpa [hl] using corr_zero z hz
      · simp [hl, h l hl]
    have hd := congrFun (congrArg ZMod.dft he) k
    rw [dft_delta, corr_transform] at hd
    dsimp at hd
    exact_mod_cast hd
def amplitude (z : ZMod N → ℂ) (a b : ZMod N) : ℂ :=
  (N : ℂ)⁻¹ * ZMod.dft z (b-a)
private theorem conj_eq_inv_of_normSq_one (w : ℂ) (hw : Complex.normSq w = 1) :
    (starRingEnd ℂ) w = w⁻¹ := by
  simp [Complex.inv_def, hw]
private theorem scaled_normSq (w : ℂ) :
    Complex.normSq ((N : ℂ)⁻¹*w) = Complex.normSq w / (N : ℝ)^2 := by
  simp [map_mul, Complex.normSq_inv, Complex.normSq_natCast, div_eq_mul_inv, sq, mul_comm]
private theorem scaled_flat (w : ℂ) :
    Complex.normSq ((N : ℂ)⁻¹*w) = 1 / (N : ℝ) ↔ Complex.normSq w = N := by
  rw [scaled_normSq]
  have hn : (N : ℝ) ≠ 0 := by exact_mod_cast NeZero.ne N
  field_simp
theorem uniform_amplitude_iff_ratio (z : ZMod N → ℂ)
    (hz : ∀ j, Complex.normSq (z j) = 1) :
    (∀ a b, Complex.normSq (amplitude z a b) = 1 / (N : ℝ)) ↔
    (∀ l, l ≠ 0 → ∑ j, z (j+l) / z j = 0) := by
  have hratio (l : ZMod N) : corr z l = ∑ j, z (j+l) / z j := by
    simp only [corr, conj_eq_inv_of_normSq_one _ (hz _), div_eq_mul_inv]
  simp_rw [← hratio]
  rw [← flat_iff_corr z hz]
  simp only [amplitude, scaled_flat]
  constructor
  · intro h k
    simpa using h 0 k
  · intro h a b
    exact h (b-a)
end
end D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier
open scoped BigOperators
namespace D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier
noncomputable section
variable {N : ℕ} [NeZero N]
def cycleA : Matrix (ZMod N) (ZMod N) ℂ :=
  (D5.S3.Combinatorics.NarayanaStrip.CiglerCycleWalkFolding.cycleAdj N).map (Int.castRingHom ℂ)
private theorem cycleA_apply (a b : ZMod N) : cycleA a b =
    (if b = a+1 then 1 else 0) + (if b = a-1 then 1 else 0) := by
  simp [cycleA, D5.S3.Combinatorics.NarayanaStrip.CiglerCycleWalkFolding.cycleAdj, eq_comm]
private def fourierM : Matrix (ZMod N) (ZMod N) ℂ := Matrix.reindex (ZMod.finEquiv N).toEquiv (ZMod.finEquiv N).toEquiv
  (D5.S3.Quantum.QuantumChannels.TomiyamaDiagonalKPositivity.fourierRows N N (Nat.le_refl N))
private theorem fourierM_apply (a j : ZMod N) : fourierM a j = ZMod.stdAddChar (a*j) := by
  simp [fourierM, Matrix.reindex_apply, Matrix.submatrix_apply, D5.S3.Quantum.QuantumChannels.TomiyamaDiagonalKPositivity.fourierRows, Fin.castLE_refl, RingEquiv.apply_symm_apply, mul_comm]
private def invFourierM : Matrix (ZMod N) (ZMod N) ℂ := fun j b =>
  (N : ℂ)⁻¹ * ZMod.stdAddChar (-(b*j))
def eigenvalue (j : ZMod N) : ℂ := ZMod.stdAddChar j + ZMod.stdAddChar (-j)
private theorem fourier_inverse : (fourierM (N:=N)) * invFourierM = 1 := by
  classical
  let e := (ZMod.finEquiv N).toEquiv
  let F := D5.S3.Quantum.QuantumChannels.TomiyamaDiagonalKPositivity.fourierRows N N (Nat.le_refl N)
  let Q : Matrix (ZMod N) (ZMod N) ℂ := Matrix.reindex e e F
  have hG : Q * Qᴴ = (N : ℂ) • (1 : Matrix (ZMod N) (ZMod N) ℂ) := by
    change (Matrix.reindex e e F) * (Matrix.reindex e e F)ᴴ = _
    rw [Matrix.conjTranspose_reindex]
    change F.submatrix e.symm e.symm * Fᴴ.submatrix e.symm e.symm = _
    rw [Matrix.submatrix_mul_equiv F Fᴴ e.symm e.symm e.symm]
    rw [D5.S3.Quantum.QuantumChannels.TomiyamaDiagonalKPositivity.fourierRows_gram]
    ext a b
    simp [Matrix.reindex_apply, Matrix.submatrix_apply, Matrix.smul_apply, Matrix.one_apply, e]
  have hI : ((fun j b : ZMod N => (N : ℂ)⁻¹ * ZMod.stdAddChar (-(b*j))) : Matrix (ZMod N) (ZMod N) ℂ) = (N : ℂ)⁻¹ • Qᴴ := by
    ext j b
    simp only [Matrix.smul_apply, Matrix.conjTranspose_apply, smul_eq_mul]
    congr 1
    dsimp [Q, F]
    simp only [Matrix.reindex_apply, Matrix.submatrix_apply,
      D5.S3.Quantum.QuantumChannels.TomiyamaDiagonalKPositivity.fourierRows,
      Fin.castLE_refl, RingEquiv.apply_symm_apply]
    have hj : (ZMod.finEquiv N) (e.symm j) = j := e.apply_symm_apply j
    have hb : (ZMod.finEquiv N) (e.symm b) = b := e.apply_symm_apply b
    rw [hj, hb, mul_comm j b]
    simpa only [RCLike.star_def] using
      (AddChar.map_neg_eq_conj (ZMod.stdAddChar (N:=N)) (b*j))
  change invFourierM (N:=N) = (N : ℂ)⁻¹ • Qᴴ at hI
  change Q * _ = _
  rw [hI, Matrix.mul_smul, hG, smul_smul, inv_mul_cancel₀ (NeZero.ne (N : ℂ)), one_smul]
private theorem cycle_eigenvectors : (cycleA (N:=N)) * fourierM = fourierM * Matrix.diagonal eigenvalue := by
  ext a j
  rw [Matrix.mul_diagonal]
  simp only [Matrix.mul_apply, cycleA_apply, fourierM_apply, add_mul, Finset.sum_add_distrib]
  simp only [ite_mul, one_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  simp only [fourierM_apply, eigenvalue, add_mul, sub_mul, AddChar.map_add_eq_mul, AddChar.map_sub_eq_div,
    AddChar.map_neg_eq_inv, div_eq_mul_inv]
  ring
private theorem inverse_fourier : (fourierM (N:=N))⁻¹ = invFourierM :=
  Matrix.inv_eq_right_inv fourier_inverse
private theorem fourier_unit : IsUnit (fourierM (N:=N)) :=
  (Matrix.isUnit_iff_isUnit_det _).mpr (Matrix.isUnit_det_of_right_inverse fourier_inverse)
private theorem cycle_diagonalization : (cycleA (N:=N)) =
    fourierM * Matrix.diagonal eigenvalue * fourierM⁻¹ := by
  rw [inverse_fourier]
  calc
    cycleA = cycleA * (fourierM * invFourierM) := by rw [fourier_inverse, Matrix.mul_one]
    _ = (cycleA * fourierM) * invFourierM := by rw [Matrix.mul_assoc]
    _ = fourierM * Matrix.diagonal eigenvalue * invFourierM := by rw [cycle_eigenvectors]
private theorem exp_cycle (c : ℂ) : NormedSpace.exp (c • (cycleA (N:=N))) =
    fourierM * Matrix.diagonal (fun j => Complex.exp (c*eigenvalue j)) * fourierM⁻¹ := by
  have hc : c • (cycleA (N:=N)) =
      fourierM * Matrix.diagonal (fun j => c*eigenvalue j) * fourierM⁻¹ := by
    rw [cycle_diagonalization]
    rw [← Matrix.smul_mul, ← Matrix.mul_smul, ← Matrix.diagonal_smul]
    rfl
  rw [hc, Matrix.exp_conj _ _ fourier_unit, Matrix.exp_diagonal]
  simp only [Pi.exp_def, ← Complex.exp_eq_exp_ℂ]
theorem exp_cycle_entry (c : ℂ) (a b : ZMod N) :
    NormedSpace.exp (c • cycleA) a b = (N : ℂ)⁻¹ *
      ZMod.dft (fun j => Complex.exp (c*eigenvalue j)) (b-a) := by
  rw [exp_cycle, inverse_fourier, Matrix.mul_apply]
  simp only [Matrix.mul_diagonal, fourierM_apply, invFourierM, ZMod.dft_apply, smul_eq_mul,
    Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j hj
  have hc : ZMod.stdAddChar (a*j) * ZMod.stdAddChar (-(b*j)) =
      ZMod.stdAddChar (-(j*(b-a))) := by
    rw [← AddChar.map_add_eq_mul]
    congr 1
    ring
  calc
    ZMod.stdAddChar (a*j) * Complex.exp (c*eigenvalue j) *
        ((N : ℂ)⁻¹ * ZMod.stdAddChar (-(b*j))) =
        (N : ℂ)⁻¹ * ((ZMod.stdAddChar (a*j) * ZMod.stdAddChar (-(b*j))) *
        Complex.exp (c*eigenvalue j)) := by ring
    _ = _ := by rw [hc]
end
end D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier
