inductive Tree (α : Type*) where
 | tip : Nat → α → Tree α
 | node : Nat → Tree α → Tree α → Tree α
variable {α : Type*}
def low : Tree α → Nat
 | .tip i _ => i
 | .node lo _ _ => lo
def indexValid : Tree α → Bool
 | .tip _ _ => true
 | .node lo l r => decide (lo ≤ low l ∧ lo ≤ low r) && indexValid l && indexValid r
def mask : Tree α → Nat
 | .tip _ _ => 1
 | .node lo l r => (mask l <<< (low l - lo)) ||| (mask r <<< (low r - lo))
def leaves : Tree α → List Nat
 | .tip i _ => [i]
 | .node _ l r => leaves l ++ leaves r
def count : Tree α → Nat
 | .tip _ _ => 1
 | .node _ l r => count l + count r
