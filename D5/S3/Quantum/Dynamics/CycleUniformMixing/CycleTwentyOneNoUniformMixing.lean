noncomputable section
/-- Every real time has a nonuniform transition probability on the 21-cycle. -/
def claim : Prop := ∀ t : ℝ, ∃ u v : ZMod 21,
  Complex.normSq (NormedSpace.exp (t • ((-Complex.I) • Matrix.reindex
    (ZMod.finEquiv 21).toEquiv (ZMod.finEquiv 21).toEquiv
    ((SimpleGraph.cycleGraph 21).adjMatrix ℂ))) u v) ≠ 1/21
theorem result : claim := by
  classical
  intro t
  have hA : Matrix.reindex (ZMod.finEquiv 21).toEquiv (ZMod.finEquiv 21).toEquiv ((SimpleGraph.cycleGraph 21).adjMatrix ℂ) = D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier.cycleA (N:=21) := by
    have hrel : ∀ a b : ZMod 21, (SimpleGraph.cycleGraph 21).Adj ((ZMod.finEquiv 21).symm a) ((ZMod.finEquiv 21).symm b) ↔ a+1=b ∨ a-1=b := by decide +kernel
    have hne : ∀ a : ZMod 21, a+1 ≠ a-1 := by decide +kernel
    ext a b
    change (if (SimpleGraph.cycleGraph 21).Adj ((ZMod.finEquiv 21).symm a) ((ZMod.finEquiv 21).symm b) then (1:ℂ) else 0) = _
    simp only [hrel]
    by_cases hp : a+1=b <;> by_cases hm : a-1=b
    · exact False.elim (hne a (hp.trans hm.symm))
    all_goals simp [D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier.cycleA, Matrix.map_apply, D5.S3.Combinatorics.NarayanaStrip.CiglerCycleWalkFolding.cycleAdj, Matrix.of_apply, hp, hm, eq_comm] <;> first | exact Ne.symm hp | exact Ne.symm hm | simp [Ne.symm hp, Ne.symm hm]
  have hn := c21_not_uniform (-t)
  rw [hA]
  have he : NormedSpace.exp (t • ((-Complex.I) •
      (D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier.cycleA (N:=21)))) =
      NormedSpace.exp ((((-t : ℝ) : ℂ)*Complex.I) •
        D5.S3.Quantum.Dynamics.CycleUniformMixing.OrbitIndexedSums.Fourier.cycleA) := by
    congr 1; ext a b
    simp only [Matrix.smul_apply, smul_eq_mul, Complex.real_smul, Complex.ofReal_neg]
    ring
  rw [he]
  push_neg at hn
  exact hn
end
end D5.S3.Quantum.Dynamics.CycleUniformMixing.CycleTwentyOneNoUniformMixing
