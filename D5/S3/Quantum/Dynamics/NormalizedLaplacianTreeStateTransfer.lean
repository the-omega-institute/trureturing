/- GID: D5/S3/Quantum/Dynamics/NormalizedLaplacianTreeStateTransfer
   generality: G
   mirror-B: D5/B/S3/Quantum/Dynamics/NormalizedLaplacianTreeStateTransfer
   mirror-E: none(waiver:external-open-problem-resolution)
   anchors: []
   utility: kind=certified-instance; basis=refutes=gid:D5/S3/Quantum/Dynamics/NormalizedLaplacianTreeStateTransfer.claim; result=D5/S3/Quantum/Dynamics/NormalizedLaplacianTreeStateTransfer.result; claim=D5/S3/Quantum/Dynamics/NormalizedLaplacianTreeStateTransfer.claim
   digest: A seventeen-vertex tree has normalized-Laplacian perfect state transfer at three pi. -/

import D5.S3.Quantum.Dynamics.EnergyEigenstateStationarity
import Mathlib.Combinatorics.SimpleGraph.LapMatrix
import Mathlib.Combinatorics.SimpleGraph.Acyclic

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxRecDepth 3000
set_option maxHeartbeats 800000

noncomputable section
namespace D5.S3.Quantum.Dynamics.NormalizedLaplacianTreeStateTransfer
open Matrix
open scoped Matrix.Norms.L2Operator
open D5.S3.Quantum.Dynamics.EnergyEigenstateStationarity

/-- The normalized Laplacian, with inverse square roots of the vertex degrees. -/
def normalizedLaplacian {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] :
    Matrix (Fin n) (Fin n) ℂ :=
  diagonal (fun i => ((Real.sqrt (G.degree i))⁻¹ : ℂ)) * G.lapMatrix ℂ *
    diagonal (fun i => ((Real.sqrt (G.degree i))⁻¹ : ℂ))

/-- The positive-sign continuous quantum walk generated by the normalized Laplacian. -/
def walk {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (t : ℝ) :
    Matrix (Fin n) (Fin n) ℂ :=
  NormedSpace.exp ((Complex.I * (t : ℂ)) • normalizedLaplacian G)

/-- Perfect state transfer from one coordinate state to another, up to a unit phase. -/
def PST {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (a b : Fin n) : Prop :=
  ∃ τ : ℝ, ∃ c : ℂ, ‖c‖ = 1 ∧
    walk G τ *ᵥ Pi.single a 1 = c • Pi.single b 1

/-- Coutinho–Baptista's conjecture excluding the paths on two and three vertices. -/
def claim : Prop :=
  ∀ n : ℕ, 4 ≤ n → ∀ (G : SimpleGraph (Fin n)) [DecidableRel G.Adj],
    G.IsTree → ∀ a b : Fin n, a ≠ b → ¬ PST G a b

private def tree : SimpleGraph (Fin 17) :=
  SimpleGraph.fromRel fun a b =>
    (a = 2 ∧ (b = 0 ∨ b = 1 ∨ (3 ≤ b.val ∧ b.val % 2 = 1))) ∨
    (3 ≤ a.val ∧ a.val % 2 = 1 ∧ b.val = a.val + 1)

private instance tree_decidable : DecidableRel tree.Adj :=
  fun a b => by unfold tree; infer_instance

private def symMode (u c x y : ℂ) : Fin 17 → ℂ :=
  fun i => if i.val < 2 then u else if i = 2 then c else if i.val % 2 = 1 then x else y

private lemma tree_degree (i : Fin 17) :
    tree.degree i = if i = 2 then 9 else if 3 ≤ i.val ∧ i.val % 2 = 1 then 2 else 1 := by
  revert i
  decide

private lemma tree_isTree : tree.IsTree := by
  have reach (i : Fin 17) : tree.Reachable 2 i := by
    fin_cases i
    · exact (show tree.Adj 2 0 by decide).reachable
    · exact (show tree.Adj 2 1 by decide).reachable
    · exact .refl 2
    · exact (show tree.Adj 2 3 by decide).reachable
    · exact (show tree.Adj 2 3 by decide).reachable.trans
        (show tree.Adj 3 4 by decide).reachable
    · exact (show tree.Adj 2 5 by decide).reachable
    · exact (show tree.Adj 2 5 by decide).reachable.trans
        (show tree.Adj 5 6 by decide).reachable
    · exact (show tree.Adj 2 7 by decide).reachable
    · exact (show tree.Adj 2 7 by decide).reachable.trans
        (show tree.Adj 7 8 by decide).reachable
    · exact (show tree.Adj 2 9 by decide).reachable
    · exact (show tree.Adj 2 9 by decide).reachable.trans
        (show tree.Adj 9 10 by decide).reachable
    · exact (show tree.Adj 2 11 by decide).reachable
    · exact (show tree.Adj 2 11 by decide).reachable.trans
        (show tree.Adj 11 12 by decide).reachable
    · exact (show tree.Adj 2 13 by decide).reachable
    · exact (show tree.Adj 2 13 by decide).reachable.trans
        (show tree.Adj 13 14 by decide).reachable
    · exact (show tree.Adj 2 15 by decide).reachable
    · exact (show tree.Adj 2 15 by decide).reachable.trans
        (show tree.Adj 15 16 by decide).reachable
  apply SimpleGraph.isTree_iff_connected_and_card.mpr
  refine ⟨⟨fun i j => (reach i).symm.trans (reach j)⟩, ?_⟩
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
  decide

private lemma sym_action (u c x y : ℂ) :
    normalizedLaplacian tree *ᵥ symMode u c x y =
      symMode (u - c / 3) (c - 2 * u / 3 - 7 * x / (3 * (Real.sqrt 2 : ℂ)))
        (x - c / (3 * (Real.sqrt 2 : ℂ)) - y / (Real.sqrt 2 : ℂ))
        (y - x / (Real.sqrt 2 : ℂ)) := by
  sorry

private lemma symmetric_eigenvectors :
    normalizedLaplacian tree *ᵥ symMode 1 3 (Real.sqrt 2) 1 =
        (0 : ℂ) • symMode 1 3 (Real.sqrt 2) 1 ∧
    normalizedLaplacian tree *ᵥ symMode 1 (-3) (Real.sqrt 2) (-1) =
        (2 : ℂ) • symMode 1 (-3) (Real.sqrt 2) (-1) ∧
    normalizedLaplacian tree *ᵥ symMode 1 1 (-(Real.sqrt 2 : ℂ) / 7) (-3 / 7) =
        (2 / 3 : ℂ) • symMode 1 1 (-(Real.sqrt 2 : ℂ) / 7) (-3 / 7) ∧
    normalizedLaplacian tree *ᵥ symMode 1 (-1) (-(Real.sqrt 2 : ℂ) / 7) (3 / 7) =
        (4 / 3 : ℂ) • symMode 1 (-1) (-(Real.sqrt 2 : ℂ) / 7) (3 / 7) := by
  sorry

private lemma antisymmetric_eigenvector :
    normalizedLaplacian tree *ᵥ (Pi.single 0 1 - Pi.single 1 1 : Fin 17 → ℂ) =
      Pi.single 0 1 - Pi.single 1 1 := by
  sorry

private lemma symmetric_decomposition :
    (Pi.single 0 1 + Pi.single 1 1 : Fin 17 → ℂ) =
      (1 / 16 : ℂ) • symMode 1 3 (Real.sqrt 2) 1 +
      (1 / 16 : ℂ) • symMode 1 (-3) (Real.sqrt 2) (-1) +
      (7 / 16 : ℂ) • symMode 1 1 (-(Real.sqrt 2 : ℂ) / 7) (-3 / 7) +
      (7 / 16 : ℂ) • symMode 1 (-1) (-(Real.sqrt 2 : ℂ) / 7) (3 / 7) := by
  sorry

private lemma phases :
    Complex.exp (Complex.I * ((3 * Real.pi : ℝ) : ℂ) * 0) = 1 ∧
    Complex.exp (Complex.I * ((3 * Real.pi : ℝ) : ℂ) * 2) = 1 ∧
    Complex.exp (Complex.I * ((3 * Real.pi : ℝ) : ℂ) * (2 / 3)) = 1 ∧
    Complex.exp (Complex.I * ((3 * Real.pi : ℝ) : ℂ) * (4 / 3)) = 1 ∧
    Complex.exp (Complex.I * ((3 * Real.pi : ℝ) : ℂ)) = -1 := by
  sorry

private lemma transfer :
    walk tree (3 * Real.pi) *ᵥ (Pi.single 0 1 : Fin 17 → ℂ) = Pi.single 1 1 := by
  sorry

/-- The seventeen-vertex tree refutes the conjecture. -/
theorem result : ¬ claim := by
  intro h
  exact h 17 (by norm_num) tree tree_isTree 0 1 (by decide)
    ⟨3 * Real.pi, 1, by simp, by simpa using transfer⟩

#print axioms result
end D5.S3.Quantum.Dynamics.NormalizedLaplacianTreeStateTransfer
