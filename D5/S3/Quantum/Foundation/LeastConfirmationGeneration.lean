import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.Algebra.Order.BigOperators.Group.List
import Mathlib.Basic.Real.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Abel

/-!
All carriers and probe sets are arbitrary; no finite catalog or inner product is assumed.
The maximum-attainment field is an explicit interface, not a compactness theorem.
The positive-dual generation argument uses strictly growing spans of zero probes.
proof_shape: peel, generate_aux, frame_bound, positive_dual_generation: content.
proof_shape: zeros_le_ker: bind-only; consumer: peel.
proof_shape: weighted_zero: bind-only; consumer: generate_aux.
proof_shape: zero_symm: bind-only; consumers: weighted_diagonal, positive_dual_generation.
proof_shape: weighted_diagonal: bind-only; consumer: positive_dual_generation.
admission_basis: escape-witness; generate_aux uses the strict growth of zero-probe spans
to construct a terminating expansion, including its dimension bound. frame_bound uses
least confirmation on complements of tail sums to construct the measurement bound.
utility: none; these are general structural results, not finite computations or instances.
Literature priority is not asserted. The compact normalized-base application and the
state-side spectral bridge are separate mathematical obligations.
-/

noncomputable section
open scoped BigOperators
open Module

namespace D5.S3.Quantum.Foundation.LeastConfirmationGeneration

variable {A : Type*} [AddCommGroup A] [Module ℝ A]

/-- Positivity and the functional order are tested on all probes. -/
def Positive (P : Set A) (f : A →ₗ[ℝ] ℝ) : Prop := ∀ p : P, 0 ≤ f p

/-- Full proper-effect confirmation, with maximum attainment stated separately. -/
structure ConfirmationSystem (P : Set A) where
  unit : A →ₗ[ℝ] ℝ
  normalized : ∀ p : P, unit p = 1
  effect : P → A →ₗ[ℝ] ℝ
  proper : ∀ p q : P, 0 ≤ effect p q ∧ effect p q ≤ 1
  confirms : ∀ p : P, effect p p = 1
  least : ∀ (p : P) (f : A →ₗ[ℝ] ℝ), Positive P f →
    (∀ q : P, f q ≤ 1) → f p = 1 → ∀ q : P, effect p q ≤ f q
  maximum : ∀ f : A →ₗ[ℝ] ℝ, Positive P f → f ≠ 0 →
    ∃ p : P, 0 < f p ∧ ∀ q : P, f q ≤ f p

/-- The subspace generated by all probes annihilated by a functional. -/
def zeroSpan (P : Set A) (f : A →ₗ[ℝ] ℝ) : Submodule ℝ A :=
  Submodule.span ℝ {x | x ∈ P ∧ f x = 0}

private theorem zeros_le_ker (P : Set A) (f : A →ₗ[ℝ] ℝ) :
    zeroSpan P f ≤ LinearMap.ker f := by
  exact Submodule.span_le.mpr (fun _ hx => hx.2)

private theorem peel {P : Set A} (C : ConfirmationSystem P)
    (f : A →ₗ[ℝ] ℝ) (hf : Positive P f) (hne : f ≠ 0) :
    ∃ p : P, ∃ m : ℝ, 0 < m ∧
      Positive P (f - m • C.effect p) ∧ (f - m • C.effect p) p = 0 ∧
      zeroSpan P f < zeroSpan P (f - m • C.effect p) := by
  obtain ⟨p, hm, hmax⟩ := C.maximum f hf hne
  let m := f p
  have hnorm : (m⁻¹ • f) p = 1 := by simp [m, hm.ne']
  have hpos : Positive P (m⁻¹ • f) := by
    intro q
    exact mul_nonneg (inv_nonneg.mpr hm.le) (hf q)
  have hbound : ∀ q : P, (m⁻¹ • f) q ≤ 1 := by
    intro q
    change m⁻¹ * f q ≤ 1
    rw [← div_eq_inv_mul, div_le_one hm]
    exact hmax q
  have he := C.least p _ hpos hbound hnorm
  let r := f - m • C.effect p
  have hr : Positive P r := by
    intro q
    have h := he q
    change C.effect p q ≤ m⁻¹ * f q at h
    rw [← div_eq_inv_mul] at h
    have h' := (le_div_iff₀ hm).mp h
    change 0 ≤ f q - m * C.effect p q
    nlinarith
  have hrp : r p = 0 := by simp [r, m, C.confirms]
  have hle : zeroSpan P f ≤ zeroSpan P r := by
    apply Submodule.span_le.mpr
    intro x hx
    apply Submodule.subset_span
    refine ⟨hx.1, ?_⟩
    have hrx := hr ⟨x, hx.1⟩
    have hnon := mul_nonneg hm.le (C.proper p ⟨x, hx.1⟩).1
    change 0 ≤ f x - m * C.effect p x at hrx
    change f x - m * C.effect p x = 0
    rw [hx.2] at hrx ⊢
    linarith
  refine ⟨p, m, hm, hr, hrp, lt_of_le_of_ne hle ?_⟩
  intro heq
  have hp : (p : A) ∈ zeroSpan P r := Submodule.subset_span ⟨p.property, hrp⟩
  rw [← heq] at hp
  have hz := zeros_le_ker P f hp
  exact hm.ne' hz

private theorem weighted_zero {P : Set A} (C : ConfirmationSystem P)
    (l : List (ℝ × P)) (hl : ∀ a ∈ l, 0 < a.1) (p : P)
    (hz : ((l.map (fun a => a.1 • C.effect a.2)).sum) p = 0) :
    ∀ a ∈ l, C.effect a.2 p = 0 := by
  have hnon : ∀ b ∈ l.map (fun a => a.1 * C.effect a.2 p), 0 ≤ b := by
    intro b hb
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hb
    exact mul_nonneg (hl a ha).le (C.proper a.2 p).1
  have hs : (l.map (fun a => a.1 * C.effect a.2 p)).sum = 0 := by
    have eval : ((l.map (fun a => a.1 • C.effect a.2)).sum) p =
        (l.map (fun a => a.1 * C.effect a.2 p)).sum := by
      clear hl hz hnon
      induction l with
      | nil => simp
      | cons a l ih => simpa using congrArg (a.1 * C.effect a.2 p + ·) ih
    exact eval.symm.trans hz
  intro a ha
  have hz' := List.all_zero_of_le_zero_le_of_sum_eq_zero hnon hs
    (List.mem_map_of_mem (f := fun a => a.1 * C.effect a.2 p) ha)
  exact (mul_eq_zero.mp hz').resolve_left (hl a ha).ne'

private theorem generate_aux [FiniteDimensional ℝ A] {P : Set A}
    (C : ConfirmationSystem P) (n : ℕ) :
    ∀ f : A →ₗ[ℝ] ℝ, Positive P f → finrank ℝ A - finrank ℝ (zeroSpan P f) = n →
    ∃ l : List (ℝ × P), (∀ a ∈ l, 0 < a.1) ∧
      f = (l.map (fun a => a.1 • C.effect a.2)).sum ∧
      l.Pairwise (fun a b => C.effect b.2 a.2 = 0) ∧
      l.length + finrank ℝ (zeroSpan P f) ≤ finrank ℝ A := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro f hf hn
    by_cases hz : f = 0
    · refine ⟨[], by simp, by simp [hz], by simp, ?_⟩
      simpa using (zeroSpan P f).finrank_le
    obtain ⟨p, m, hm, hr, hrp, hstrict⟩ := peel C f hf hz
    let r := f - m • C.effect p
    have hdim := Submodule.finrank_lt_finrank_of_lt hstrict
    have hsmall : finrank ℝ A - finrank ℝ (zeroSpan P r) < n := by
      have hb := (zeroSpan P r).finrank_le
      change finrank ℝ (zeroSpan P f) < finrank ℝ (zeroSpan P r) at hdim
      omega
    obtain ⟨l, hl, heq, hpw, hlen⟩ := ih _ hsmall r hr rfl
    refine ⟨(m, p) :: l, ?_, ?_, ?_, ?_⟩
    · simpa using And.intro hm hl
    · simp only [List.map_cons, List.sum_cons]
      rw [← heq]
      dsimp [r]
      abel
    · apply List.Pairwise.cons _ hpw
      intro a ha
      exact weighted_zero C l hl p (by rw [← heq]; exact hrp) a ha
    · simp only [List.length_cons]
      dsimp [r] at hlen
      omega

private theorem zero_symm {P : Set A} (C : ConfirmationSystem P) (p q : P)
    (h : C.effect q p = 0) : C.effect p q = 0 := by
  have hg : Positive P (C.unit - C.effect q) := by
    intro x
    change 0 ≤ C.unit x - C.effect q x
    rw [C.normalized]
    exact sub_nonneg.mpr (C.proper q x).2
  have hb : ∀ x : P, (C.unit - C.effect q) x ≤ 1 := by
    intro x
    change C.unit x - C.effect q x ≤ 1
    rw [C.normalized]
    linarith [(C.proper q x).1]
  have hc : (C.unit - C.effect q) p = 1 := by
    change C.unit p - C.effect q p = 1
    rw [C.normalized, h, sub_zero]
  have hh := C.least p _ hg hb hc q
  change C.effect p q ≤ C.unit q - C.effect q q at hh
  rw [C.normalized, C.confirms] at hh
  linarith [(C.proper p q).1]

private theorem frame_bound {P : Set A} (C : ConfirmationSystem P)
    (l : List (ℝ × P)) (hpw : l.Pairwise (fun a b => C.effect b.2 a.2 = 0)) :
    ∀ q : P, ((l.map (fun a => C.effect a.2)).sum) q ≤ 1 := by
  induction l with
  | nil => intro q; simp
  | cons a l ih =>
    obtain ⟨hhead, htail⟩ := List.pairwise_cons.mp hpw
    have hbound := ih htail
    let t := (l.map (fun b => C.effect b.2)).sum
    have hnon : ∀ q : P, 0 ≤ t q := by
      intro q
      dsimp [t]
      clear hpw hhead htail hbound ih
      induction l with
      | nil => simp
      | cons b l ih => simpa using add_nonneg (C.proper b.2 q).1 ih
    have hzero : t a.2 = 0 := by
      dsimp [t]
      clear hpw htail hbound ih hnon
      induction l with
      | nil => simp
      | cons b l ih =>
        have hb := hhead b List.mem_cons_self
        have ht := ih (fun c hc => hhead c (List.mem_cons_of_mem b hc))
        simpa [hb] using ht
    have hg : Positive P (C.unit - t) := by
      intro q
      change 0 ≤ C.unit q - t q
      rw [C.normalized]
      exact sub_nonneg.mpr (hbound q)
    have hub : ∀ q : P, (C.unit - t) q ≤ 1 := by
      intro q
      change C.unit q - t q ≤ 1
      rw [C.normalized]
      linarith [hnon q]
    have hconf : (C.unit - t) a.2 = 1 := by
      change C.unit a.2 - t a.2 = 1
      rw [C.normalized, hzero, sub_zero]
    intro q
    have h := C.least a.2 _ hg hub hconf q
    change C.effect a.2 q ≤ C.unit q - t q at h
    rw [C.normalized] at h
    change C.effect a.2 q + t q ≤ 1
    linarith

private theorem weighted_diagonal {P : Set A} (C : ConfirmationSystem P)
    (l : List (ℝ × P)) (hpw : l.Pairwise (fun a b => C.effect b.2 a.2 = 0)) :
    ∀ a ∈ l, ((l.map (fun b => b.1 • C.effect b.2)).sum) a.2 = a.1 := by
  induction l with
  | nil => simp
  | cons b l ih =>
    obtain ⟨hhead, htail⟩ := List.pairwise_cons.mp hpw
    intro a ha
    rcases List.mem_cons.mp ha with hab | ha
    · subst a
      have hz : ((l.map (fun c => c.1 • C.effect c.2)).sum) b.2 = 0 := by
        clear hpw htail ih ha
        induction l with
        | nil => simp
        | cons c l ih =>
          have hc := hhead c List.mem_cons_self
          have ht := ih (fun d hd => hhead d (List.mem_cons_of_mem c hd))
          simpa [hc] using ht
      simpa [C.confirms, hz]
    · have hz := zero_symm C b.2 a.2 (hhead a ha)
      have hh := ih htail a ha
      simpa [hz] using hh

/-- A positive dual vector has a positive expansion in a biorthogonal proper frame of
length at most dim A. If the vector is the unit, all coefficients equal one. -/
theorem positive_dual_generation [FiniteDimensional ℝ A] {P : Set A}
    (C : ConfirmationSystem P) (f : A →ₗ[ℝ] ℝ) (hf : Positive P f) :
    ∃ l : List (ℝ × P), (∀ a ∈ l, 0 < a.1) ∧
      f = (l.map (fun a => a.1 • C.effect a.2)).sum ∧
      l.Pairwise (fun a b => C.effect b.2 a.2 = 0 ∧ C.effect a.2 b.2 = 0) ∧
      (∀ q : P, ((l.map (fun a => C.effect a.2)).sum) q ≤ C.unit q) ∧
      l.length ≤ finrank ℝ A ∧ (f = C.unit → ∀ a ∈ l, a.1 = 1) := by
  obtain ⟨l, hl, heq, hpw, hlen⟩ := generate_aux C _ f hf rfl
  refine ⟨l, hl, heq, hpw.imp (fun h => ⟨h, zero_symm C _ _ h⟩), ?_, by omega, ?_⟩
  · intro q
    rw [C.normalized]
    exact frame_bound C l hpw q
  · intro hu a ha
    have hh := weighted_diagonal C l hpw a ha
    rw [← heq, hu, C.normalized] at hh
    exact hh.symm

#print axioms positive_dual_generation

end D5.S3.Quantum.Foundation.LeastConfirmationGeneration
