import D5.S3.Quantum.Foundation.WholePairBallConfirmation
import D5.S3.Quantum.Foundation.FacetZeroGluing
import Mathlib.Analysis.Convex.Intrinsic

/-! Original closed cones, their actual faces and zero-inclusive finite conic hulls. -/

noncomputable section
open Set

namespace D5.S3.Quantum.Foundation.HitSectionGeneration

open CircuitBalancedConfirmation FacetZeroGluing WholePairBallConfirmation

variable {V : Type*} [NormedAddCommGroup V] [NormedSpace ℝ V]
  {C : PointedCone ℝ V} {u : V →ₗ[ℝ] ℝ}

/-- The original face generated by one vector, expressed by positive domination. -/
def principalFace (C : PointedCone ℝ V) (x : V) : C.Face where
  toSubmodule := {
    carrier := {y | y ∈ C ∧ ∃ t : ℝ, 0 ≤ t ∧ t • x - y ∈ C}
    zero_mem' := ⟨C.zero_mem, 0, le_rfl, by simp⟩
    add_mem' := by
      rintro y z ⟨hy, t, ht, hty⟩ ⟨hz, s, hs, hsz⟩
      refine ⟨C.add_mem hy hz, t + s, add_nonneg ht hs, ?_⟩
      convert C.add_mem hty hsz using 1 <;> module
    smul_mem' := by
      rintro a y ⟨hy, t, ht, hty⟩
      refine ⟨C.smul_mem a.property hy, (a : ℝ) * t, mul_nonneg a.property ht, ?_⟩
      change ((a : ℝ) * t) • x - (a : ℝ) • y ∈ C
      convert C.smul_mem a.property hty using 1 <;> module }
  isFaceOf := by
    apply PointedCone.IsFaceOf.of_mem_of_add_mem_left
    · exact fun _ hy => hy.1
    · rintro y z hy hz ⟨_, t, ht, htyz⟩
      refine ⟨hy, t, ht, ?_⟩
      convert C.add_mem htyz hz using 1 <;> module

theorem mem_principalFace (x : V) (hx : x ∈ C) : x ∈ principalFace C x :=
  ⟨hx, 1, zero_le_one, by simp⟩

variable [FiniteDimensional ℝ V]

theorem face_closed (hc : IsClosed (C : Set V)) (F : C.Face) :
    IsClosed (F : Set V) := by
  have he : (F : Set V) = (C : Set V) ∩ Submodule.span ℝ (F : Set V) := by
    ext x
    exact ⟨fun hx => ⟨F.isFaceOf.le hx, Submodule.subset_span hx⟩,
      fun hx => face_span_inter F hx.1 hx.2⟩
  rw [he]
  exact hc.inter (Submodule.closed_of_finiteDimensional _)

omit [FiniteDimensional ℝ V] in
theorem face_base_extreme (F : C.Face) :
    IsExtreme ℝ (base C u) (base F.toPointedCone u) := by
  refine ⟨fun _ hx => ⟨F.isFaceOf.le hx.1, hx.2⟩, ?_⟩
  intro y hy z hz w hw hseg
  exact ⟨F.isFaceOf.isExtreme.left_mem_of_mem_openSegment hy.1 hz.1 hw.1 hseg, hy.2⟩

omit [FiniteDimensional ℝ V] in
/-- Extension through the designated point takes place in its actual smallest face. -/
theorem principal_extension {x : V} (hx : x ∈ base C u) {y : V}
    (hy : y ∈ base (principalFace C x).toPointedCone u) :
    ∃ z ∈ base (principalFace C x).toPointedCone u,
      x ∈ openSegment ℝ y z := by
  obtain ⟨hyC, t, ht, hty⟩ := hy.1
  let r := t + 2
  have hr : 1 < r := by dsimp [r]; linarith
  have hr0 : 0 < r := lt_trans zero_lt_one hr
  have hrem : r • x - y ∈ C := by
    convert C.add_mem hty (C.smul_mem (by norm_num : (0 : ℝ) ≤ 2) hx.1) using 1 <;>
      dsimp [r] <;> module
  have hremF : r • x - y ∈ principalFace C x := by
    refine ⟨hrem, r, hr0.le, ?_⟩
    simpa using hyC
  let z := (r - 1)⁻¹ • (r • x - y)
  have hz : z ∈ base (principalFace C x).toPointedCone u := by
    refine ⟨(principalFace C x).toPointedCone.smul_mem
      (inv_nonneg.mpr (by linarith)) hremF, ?_⟩
    simp [z, map_smul, map_sub, hx.2, hy.2, (sub_pos.mpr hr).ne']
  refine ⟨z, hz, 1 / r, (r - 1) / r, div_pos zero_lt_one hr0,
    div_pos (sub_pos.mpr hr) hr0, ?_, ?_⟩
  · field_simp
    ring
  · dsimp [z]
    simp only [smul_sub, smul_smul]
    have h1 : (r - 1) / r * ((r - 1)⁻¹ * r) = 1 := by field_simp
    have h2 : (r - 1) / r * (r - 1)⁻¹ = 1 / r := by field_simp
    rw [h1, h2, one_smul]
    module

/-- Finite pure generation of the whole normalized base, without a closed-pure-set premise. -/
theorem base_eq_convexHull_pure (hc : IsClosed (C : Set V))
    (hu : ∀ x ∈ C, x ≠ 0 → 0 < u x) :
    base C u = convexHull ℝ (pure C u) := by
  apply Set.Subset.antisymm
  · intro x hx
    let F := principalFace C x
    have hxF : x ∈ base F.toPointedCone u := ⟨mem_principalFace x hx.1, hx.2⟩
    have hcompact : IsCompact (base F.toPointedCone u) :=
      base_compact (face_closed hc F) (fun y hy => hu y (F.isFaceOf.le hy))
    let T := convexHull ℝ (pure F.toPointedCone u)
    have hcl : closure T = base F.toPointedCone u :=
      closure_convexHull_extremePoints hcompact (base_convex _ _)
    obtain ⟨p, hp⟩ := hcompact.extremePoints_nonempty ⟨x, hxF⟩
    have hTne : T.Nonempty := ⟨p, subset_convexHull ℝ _ hp⟩
    obtain ⟨y, hy⟩ := hTne.intrinsicInterior (convex_convexHull ℝ _)
    have hyF : y ∈ base F.toPointedCone u :=
      (convexHull_min extremePoints_subset (base_convex _ _)) (intrinsicInterior_subset hy)
    obtain ⟨z, hz, hseg⟩ := principal_extension hx hyF
    have hzcl : z ∈ intrinsicClosure ℝ T := by
      rw [intrinsicClosure_eq_closure, hcl]
      exact hz
    have hxT : x ∈ T := intrinsicInterior_subset
      ((convex_convexHull ℝ _).openSegment_intrinsicInterior_intrinsicClosure_subset_intrinsicInterior
        hy hzcl hseg)
    exact convexHull_mono (face_base_extreme F).extremePoints_subset_extremePoints hxT
  · exact convexHull_min extremePoints_subset (base_convex C u)

/-- Original pure neighbours confirmed apart from the fixed original pure point. -/
def neighbors (C : PointedCone ℝ V) (u : V →ₗ[ℝ] ℝ) (a : V) : Set V :=
  pure C u ∩ exclusion C u a

/-- Every actual face generated by a distinct original pure pair meets the neighbour set. -/
def Hit (C : PointedCone ℝ V) (u : V →ₗ[ℝ] ℝ) (a : V) : Prop :=
  ∀ p q : pure C u, p ≠ q →
    (neighbors C u a ∩ pairBase C u p q).Nonempty

/-- Hit excludes new extreme points in every linear section containing all original neighbours. -/
private theorem section_extremePoints (hc : IsClosed (C : Set V))
    (hu : ∀ x ∈ C, x ≠ 0 → 0 < u x) (a : pure C u) (hhit : Hit C u a)
    (S : Submodule ℝ V) (hNS : neighbors C u a ⊆ S) :
    (base C u ∩ (S : Set V)).extremePoints ℝ = pure C u ∩ S := by
  apply Set.Subset.antisymm
  · intro x hx
    refine ⟨?_, hx.1.2⟩
    by_contra hxp
    let F := principalFace C x
    have hxF : x ∈ base F.toPointedCone u :=
      ⟨mem_principalFace x hx.1.1.1, hx.1.1.2⟩
    have hcompact := base_compact (face_closed hc F)
      (fun y hy => hu y (F.isFaceOf.le hy))
    have hpair : ((base F.toPointedCone u).extremePoints ℝ).Nontrivial := by
      by_contra hn
      have hsub := Set.not_nontrivial_iff.mp hn
      obtain ⟨p, hp⟩ := hcompact.extremePoints_nonempty ⟨x, hxF⟩
      have hHsub : base F.toPointedCone u ⊆ {p} := by
        rw [base_eq_convexHull_pure (face_closed hc F)
          (fun y hy => hu y (F.isFaceOf.le hy))]
        exact convexHull_min (fun q hq => hsub hq hp) (convex_singleton p)
      have hxp' : x = p := hHsub hxF
      exact hxp (hxp' ▸ (face_base_extreme F).extremePoints_subset_extremePoints hp)
    obtain ⟨p, hp, q, hq, hpq⟩ := hpair
    let p' : pure C u := ⟨p, (face_base_extreme F).extremePoints_subset_extremePoints hp⟩
    let q' : pure C u := ⟨q, (face_base_extreme F).extremePoints_subset_extremePoints hq⟩
    have hpq' : p' ≠ q' := fun h => hpq (congrArg Subtype.val h)
    obtain ⟨b, hbN, hbpair⟩ := hhit p' q' hpq'
    have hbF : b ∈ base F.toPointedCone u :=
      ⟨hbpair.2 F hp.1.1 hq.1.1, hbpair.1.2⟩
    obtain ⟨z, hz, hseg⟩ := principal_extension hx.1.1 hbF
    have hbS : b ∈ S := hNS hbN
    have hzS : z ∈ S := by
      obtain ⟨r, s, hr, hs, hrs, he⟩ := hseg
      have hsz : s • z ∈ S := by
        have hh : r • b + s • z ∈ S := he ▸ hx.1.2
        exact (S.add_mem_iff_right (S.smul_mem r hbS)).mp hh
      have hh := S.smul_mem s⁻¹ hsz
      simpa [smul_smul, hs.ne'] using hh
    have hbx : b = x := hx.2 ⟨hbpair.1, hbS⟩
      ⟨⟨F.isFaceOf.le hz.1, hz.2⟩, hzS⟩ hseg
    exact hxp (hbx ▸ hbN.1)
  · rintro x ⟨hx, hxS⟩
    exact ⟨⟨hx.1, hxS⟩, fun _ hy _ hz hseg => hx.2 hy.1 hz.1 hseg⟩

/-- All three original section conclusions, with the finite conic hull including zero. -/
theorem hit_section_generation (hc : IsClosed (C : Set V))
    (hu : ∀ x ∈ C, x ≠ 0 → 0 < u x) (a : pure C u) (hhit : Hit C u a)
    (S : Submodule ℝ V) (hNS : neighbors C u a ⊆ S) :
    (base C u ∩ (S : Set V)).extremePoints ℝ = pure C u ∩ S ∧
    base C u ∩ (S : Set V) = convexHull ℝ (pure C u ∩ S) ∧
    (C : Set V) ∩ S = (PointedCone.hull ℝ (pure C u ∩ S) : Set V) := by
  have hext := section_extremePoints hc hu a hhit S hNS
  let D : PointedCone ℝ V := C ⊓ S.restrictScalars (Nonneg ℝ)
  have hDclosed : IsClosed (D : Set V) := hc.inter S.closed_of_finiteDimensional
  have hbaseD : base D u = base C u ∩ (S : Set V) := by
    ext x
    simp only [base, D, Set.mem_ofPred_eq, Set.mem_inter_iff,
      Submodule.mem_inf, Submodule.restrictScalars_mem]
    tauto
  have hpureD : pure D u = pure C u ∩ S := by
    rw [CircuitBalancedConfirmation.pure, hbaseD, hext]
  have hgen : base C u ∩ (S : Set V) = convexHull ℝ (pure C u ∩ S) := by
    rw [← hpureD, ← hbaseD]
    exact base_eq_convexHull_pure hDclosed (fun y hy => hu y hy.1)
  refine ⟨hext, hgen, Set.Subset.antisymm ?_ ?_⟩
  · intro x hx
    by_cases hx0 : x = 0
    · simpa [hx0] using (PointedCone.hull ℝ (pure C u ∩ S)).zero_mem
    have hux := hu x hx.1 hx0
    have hk : (u x)⁻¹ • x ∈ base C u ∩ (S : Set V) :=
      ⟨normalized_mem hu hx.1 hx0, S.smul_mem _ hx.2⟩
    rw [hgen] at hk
    have hkh : (u x)⁻¹ • x ∈ PointedCone.hull ℝ (pure C u ∩ S) :=
      convexHull_min PointedCone.subset_hull (PointedCone.hull ℝ _).convex hk
    have hh := (PointedCone.hull ℝ (pure C u ∩ S)).smul_mem hux.le hkh
    simpa [smul_smul, hux.ne'] using hh
  · have hh : PointedCone.hull ℝ (pure C u ∩ S) ≤ D := by
      apply Submodule.span_le.mpr
      intro x hx
      exact ⟨hx.1.1.1, hx.2⟩
    exact hh

end D5.S3.Quantum.Foundation.HitSectionGeneration
