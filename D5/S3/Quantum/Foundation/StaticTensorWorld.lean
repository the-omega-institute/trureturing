import D5.S3.Quantum.Information.StrongSubadditivity.Physlib.ForMathlib.HermitianMat.Inner
import Mathlib.Analysis.InnerProductSpace.TensorProduct
import Mathlib.LinearAlgebra.BilinearForm.TensorProduct
import Mathlib.Tactic

/-! Positive Frobenius comparisons, their actual static tensor edges, and a
closed family generated by the real symmetric two by two matrices. -/

noncomputable section
open scoped TensorProduct InnerProductSpace RealInnerProductSpace

namespace D5.S3.Quantum.Foundation.StaticTensorWorld

/-- A finite positive comparison object. No associativity or activity is imposed. -/
structure Comparison where
  Carrier : Type
  [group : NormedAddCommGroup Carrier]
  [innerSpace : InnerProductSpace ℝ Carrier]
  [finite : FiniteDimensional ℝ Carrier]
  [nontrivial : Nontrivial Carrier]
  unit : Carrier
  mul : Carrier →ₗ[ℝ] Carrier →ₗ[ℝ] Carrier
  comm : ∀ x y, mul x y = mul y x
  unit_mul : ∀ x, mul unit x = x
  frobenius : ∀ x y z, ⟪mul x y, z⟫_ℝ = ⟪y, mul x z⟫_ℝ
  action : Carrier →ₗ[ℝ] Module.End ℝ Carrier
  derivation : ∀ h x y, action h (mul x y) =
    mul (action h x) y + mul x (action h y)

attribute [instance] Comparison.group Comparison.innerSpace Comparison.finite Comparison.nontrivial

/-- All label generators vanish, rather than one selected generator. -/
def IsStatic (A : Comparison) : Prop := A.action = 0

/-- An actual binary edge preserves its output object and its full data.
The equivalence identifies its carrier with the full real algebraic tensor product. -/
structure ActualEdge (A B C : Comparison) where
  carrier : C.Carrier ≃ₗ[ℝ] A.Carrier ⊗[ℝ] B.Carrier
  unit : carrier C.unit = A.unit ⊗ₜ[ℝ] B.unit
  pairing : ∀ a b c d,
    ⟪carrier.symm (a ⊗ₜ[ℝ] b), carrier.symm (c ⊗ₜ[ℝ] d)⟫_ℝ =
      ⟪a,c⟫_ℝ * ⟪b,d⟫_ℝ
  left_module : ∀ a c d,
    carrier (C.mul (carrier.symm (a ⊗ₜ[ℝ] B.unit))
      (carrier.symm (c ⊗ₜ[ℝ] d))) = A.mul a c ⊗ₜ[ℝ] d
  right_module : ∀ b c d,
    carrier (C.mul (carrier.symm (A.unit ⊗ₜ[ℝ] b))
      (carrier.symm (c ⊗ₜ[ℝ] d))) = c ⊗ₜ[ℝ] B.mul b d
  left_conditional : ∀ a b c,
    carrier (C.action (carrier.symm (a ⊗ₜ[ℝ] b))
      (carrier.symm (c ⊗ₜ[ℝ] B.unit))) = A.action a c ⊗ₜ[ℝ] b
  right_conditional : ∀ a b d,
    carrier (C.action (carrier.symm (a ⊗ₜ[ℝ] b))
      (carrier.symm (A.unit ⊗ₜ[ℝ] d))) = a ⊗ₜ[ℝ] B.action b d

private theorem tensor_frobenius (A B : Comparison)
    (x y z : A.Carrier ⊗[ℝ] B.Carrier) :
    ⟪(LinearMap.BilinMap.tmul A.mul B.mul) x y,z⟫_ℝ = ⟪y,(LinearMap.BilinMap.tmul A.mul B.mul) x z⟫_ℝ := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    induction y using TensorProduct.induction_on with
    | zero => simp
    | tmul c d =>
      induction z using TensorProduct.induction_on with
      | zero => simp
      | tmul e f =>
        simp only [LinearMap.BilinMap.tensorDistrib_tmul, TensorProduct.inner_tmul]
        rw [A.frobenius, B.frobenius]
      | add z z' hz hz' =>
        simp only [map_add, inner_add_right]
        rw [hz, hz']
    | add y y' hy hy' => simp [inner_add_left, hy, hy']
  | add x x' hx hx' => simp [inner_add_left, inner_add_right, hx, hx']

/-- The actual pure tensor comparison, with zero action on every label. -/
def tensor (A B : Comparison) : Comparison where
  Carrier := A.Carrier ⊗[ℝ] B.Carrier
  nontrivial := by
    obtain ⟨a, ha⟩ := exists_ne (0 : A.Carrier)
    obtain ⟨b, hb⟩ := exists_ne (0 : B.Carrier)
    refine ⟨⟨a ⊗ₜ[ℝ] b, 0, ?_⟩⟩
    intro h
    have hn : ‖a‖ * ‖b‖ = 0 := by
      rw [← TensorProduct.norm_tmul (𝕜 := ℝ) a b, h, norm_zero]
    exact (mul_ne_zero (norm_ne_zero_iff.mpr ha) (norm_ne_zero_iff.mpr hb)) hn
  unit := A.unit ⊗ₜ[ℝ] B.unit
  mul := LinearMap.BilinMap.tmul A.mul B.mul
  comm := LinearMap.BilinMap.tmul_isSymm A.comm B.comm
  unit_mul := by
    intro x
    induction x using TensorProduct.induction_on with
    | zero => simp
    | tmul a b => simp [A.unit_mul, B.unit_mul]
    | add x y hx hy => simp [hx, hy]
  frobenius := tensor_frobenius A B
  action := 0
  derivation := by intros; simp

private def tensor_edge (A B : Comparison) (hA : IsStatic A) (hB : IsStatic B) :
    ActualEdge A B (tensor A B) where
  carrier := LinearEquiv.refl ℝ _
  unit := rfl
  pairing := by intros; exact TensorProduct.inner_tmul ℝ _ _ _ _
  left_module := by
    intro a c d
    change A.mul a c ⊗ₜ[ℝ] B.mul B.unit d = _
    rw [B.unit_mul]
  right_module := by
    intro b c d
    change A.mul A.unit c ⊗ₜ[ℝ] B.mul b d = _
    rw [A.unit_mul]
  left_conditional := by
    intro a b c
    change (0 : A.Carrier ⊗[ℝ] B.Carrier) = A.action a c ⊗ₜ[ℝ] b
    rw [show A.action = 0 from hA]
    simp
  right_conditional := by
    intro a b d
    change (0 : A.Carrier ⊗[ℝ] B.Carrier) = a ⊗ₜ[ℝ] B.action b d
    rw [show B.action = 0 from hB]
    simp

/-- The original local domain is exactly the real symmetric matrix subspace. -/
abbrev SymTwo := HermitianMat (Fin 2) ℝ

private instance : Nontrivial SymTwo := by
  refine ⟨⟨0, 1, ?_⟩⟩
  intro h
  have h00 := congrArg (fun a : SymTwo => a.mat 0 0) h
  norm_num at h00

/-- Symmetrized actual matrix multiplication. -/
def symMul : SymTwo →ₗ[ℝ] SymTwo →ₗ[ℝ] SymTwo :=
  ((LinearMap.mul ℝ (Matrix (Fin 2) (Fin 2) ℝ)).compl₁₂
    (selfAdjoint.submodule ℝ _).subtype (selfAdjoint.submodule ℝ _).subtype).compr₂
    (selfAdjointPart ℝ)

private theorem symMul_matrix (a b : SymTwo) :
    (symMul a b).mat = (1/2 : ℝ) • (a.mat * b.mat + b.mat * a.mat) := by
  change (⅟ (2 : ℝ)) • (a.mat * b.mat + (a.mat * b.mat).conjTranspose) = _
  rw [Matrix.conjTranspose_mul, a.H, b.H]
  norm_num [invOf_eq_inv]

private theorem symMul_comm (a b : SymTwo) : symMul a b = symMul b a := by
  apply HermitianMat.ext
  simp only [symMul_matrix, add_comm]

private theorem symMul_unit (a : SymTwo) : symMul 1 a = a := by
  apply HermitianMat.ext
  simp [symMul_matrix, ← two_smul ℝ, smul_smul]

private theorem symMul_frobenius (a b c : SymTwo) :
    ⟪symMul a b,c⟫_ℝ = ⟪b,symMul a c⟫_ℝ := by
  simp only [HermitianMat.inner_eq_trace_trivial, symMul_matrix,
    Matrix.smul_mul, Matrix.mul_smul, Matrix.add_mul, Matrix.mul_add,
    Matrix.trace_smul, Matrix.trace_add]
  rw [Matrix.trace_mul_cycle a.mat b.mat c.mat]
  simp only [Matrix.mul_assoc]
  rw [Matrix.trace_mul_cycle' c.mat a.mat b.mat]
  ring

/-- The real symmetric local field with trace pairing and the zero assignment. -/
def localObject : Comparison where
  Carrier := SymTwo
  unit := 1
  mul := symMul
  comm := symMul_comm
  unit_mul := symMul_unit
  frobenius := symMul_frobenius
  action := 0
  derivation := by intros; simp

/-- The empty tensor word is the scalar object. -/
def scalarObject : Comparison where
  Carrier := ℝ
  unit := 1
  mul := LinearMap.mul ℝ ℝ
  comm := mul_comm
  unit_mul := one_mul
  frobenius := by intros; simp [mul_assoc, mul_left_comm]
  action := 0
  derivation := by intros; simp

/-- Every finite parenthesized real tensor word, including the empty word. -/
inductive Word where
  | empty
  | local
  | pair (left right : Word)

/-- No word length or parenthesization is excluded. -/
def object : Word → Comparison
  | .empty => scalarObject
  | .local => localObject
  | .pair u v => tensor (object u) (object v)

/-- A closed static world supplies the same actual output on every binary edge. -/
structure StaticWorld where
  field : Word → Comparison
  static : ∀ w, IsStatic (field w)
  edge : ∀ u v, ActualEdge (field u) (field v) (field (.pair u v))

private theorem object_static (w : Word) : IsStatic (object w) := by
  cases w <;> rfl

/-- The actual family on all finite tensor words. -/
def counterworld : StaticWorld where
  field := object
  static := object_static
  edge u v := tensor_edge (object u) (object v) (object_static u) (object_static v)

/-- The false consequence obtained by deleting the activity requirement:
all objects in every closed all-static actual-comparison world are associative. -/
def claim : Prop := ∀ W : StaticWorld, ∀ w : Word,
  ∀ a b c : (W.field w).Carrier,
    (W.field w).mul ((W.field w).mul a b) c =
      (W.field w).mul a ((W.field w).mul b c)

/-- The two actual real Pauli matrices. -/
def pauliZ : SymTwo := ⟨!![1,0;0,-1], by
  change Matrix.conjTranspose _ = _
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [Matrix.conjTranspose_apply]⟩
def pauliX : SymTwo := ⟨!![0,1;1,0], by
  change Matrix.conjTranspose _ = _
  ext i j
  fin_cases i <;> fin_cases j <;> norm_num [Matrix.conjTranspose_apply]⟩

private theorem local_nonassociative :
    symMul (symMul pauliZ pauliX) pauliX ≠
      symMul pauliZ (symMul pauliX pauliX) := by
  intro h
  have hmat := congrArg HermitianMat.mat h
  simp only [symMul_matrix] at hmat
  have h00 := congrArg (fun a : Matrix (Fin 2) (Fin 2) ℝ => a 0 0) hmat
  norm_num [pauliZ, pauliX, HermitianMat.mat, Matrix.mul_apply,
    Fin.sum_univ_two] at h00

/-- Full all-finite static closure does not force associative local comparison. -/
theorem result : ¬ claim := by
  intro h
  exact local_nonassociative (h counterworld .local pauliZ pauliX pauliX)

#print axioms result

end D5.S3.Quantum.Foundation.StaticTensorWorld
