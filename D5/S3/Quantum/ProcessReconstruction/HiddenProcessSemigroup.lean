universe u

variable {a : Type u} [Fintype a] [DecidableEq a]

/-- Convex combination of actual CPTP maps on the full matrix algebra. -/
def mix (p : ℝ) (hp : 0 ≤ p) (hq : p ≤ 1) (C D : QuantumChannel a a) :
    QuantumChannel a a where
  toCompletelyPositiveMap :=
    { toLinearMap := (p : ℂ) • C.toCompletelyPositiveMap.toLinearMap +
        ((1 - p : ℝ) : ℂ) • D.toCompletelyPositiveMap.toLinearMap
      map_cstarMatrix_nonneg' := by
        intro k M hM
        have hC := C.toCompletelyPositiveMap.map_cstarMatrix_nonneg M hM
        have hD := D.toCompletelyPositiveMap.map_cstarMatrix_nonneg M hM
        have hmap :
            M.map (fun X => p • C.toCompletelyPositiveMap X +
              (1 - p) • D.toCompletelyPositiveMap X) =
            p • M.map C.toCompletelyPositiveMap + (1 - p) • M.map D.toCompletelyPositiveMap := by
          apply CStarMatrix.ext
          intro i j
          rfl
        change 0 ≤ M.map (fun X => p • C.toCompletelyPositiveMap X +
          (1 - p) • D.toCompletelyPositiveMap X)
        rw [hmap]
        exact add_nonneg (smul_nonneg hp hC) (smul_nonneg (sub_nonneg.mpr hq) hD) }
  trace_preserving X := by
    let Y := CStarMatrix.ofMatrix.symm X
    have hC : trace (CStarMatrix.ofMatrix.symm (C.toCompletelyPositiveMap X)) = trace Y :=
      C.trace_preserving X
    have hD : trace (CStarMatrix.ofMatrix.symm (D.toCompletelyPositiveMap X)) = trace Y :=
      D.trace_preserving X
    change trace ((p : ℂ) • CStarMatrix.ofMatrix.symm (C.toCompletelyPositiveMap X) +
      ((1 - p : ℝ) : ℂ) • CStarMatrix.ofMatrix.symm (D.toCompletelyPositiveMap X)) = trace Y
    rw [trace_add, trace_smul, trace_smul, hC, hD]
    simp only [Complex.ofReal_sub, Complex.ofReal_one, smul_eq_mul]
    ring

theorem mix_entry (p : ℝ) (hp : 0 ≤ p) (hq : p ≤ 1) (C D : QuantumChannel a a)
    (X : Matrix a a ℂ) (x y : a) :
    act (mix p hp hq C D) X x y =
      (p : ℂ) * act C X x y + ((1 - p : ℝ) : ℂ) * act D X x y := rfl

def identity : QuantumChannel a a where
  toCompletelyPositiveMap :=
    { toLinearMap := LinearMap.id
      map_cstarMatrix_nonneg' := by
        intro k M hM
        exact hM }
  trace_preserving _ := rfl

def reset (τ : DensityState a) : QuantumChannel a a :=
  (finite_preparation_quantum_channel (fun _ : a => τ)).choose

theorem reset_act (τ : DensityState a) (X : Matrix a a ℂ) :
    act (reset τ) X = trace X • CStarMatrix.ofMatrix.symm τ.1 := by
  change CStarMatrix.ofMatrix.symm ((reset τ).toCompletelyPositiveMap
    (CStarMatrix.ofMatrix X)) = _
  unfold reset
  rw [(finite_preparation_quantum_channel (fun _ : a => τ)).choose_spec X,
    ← Finset.sum_smul]
  rfl

private def sign (u v : a) (flip reflect : Bool) (x : a) : ℂ :=
  phase v flip x * if reflect then reflection u v x else 1

omit [Fintype a] in
private theorem sign_cases (u v : a) (flip reflect : Bool) (x : a) :
    sign u v flip reflect x = 1 ∨ sign u v flip reflect x = -1 := by
  have hp : phase v flip x = 1 ∨ phase v flip x = -1 := by
    by_cases h : flip = true ∧ x = v <;> simp [phase, h]
  rcases hp with hp | hp <;> cases reflect <;> cases hb : inBlock u v x <;>
    simp [sign, hp, reflection, hb]

omit [Fintype a] in
private theorem sign_star (u v : a) (flip reflect : Bool) (x : a) :
    star (sign u v flip reflect x) = sign u v flip reflect x := by
  rcases sign_cases u v flip reflect x with h | h <;> simp [h]

private theorem conjugation_entry (u v : a) (flip reflect : Bool) (X : Matrix a a ℂ)
    (x y : a) :
    act (conjugation (mixingUnitary u v flip reflect)) X x y =
      (sign u v flip reflect x * sign u v flip reflect y) * X x y := by
  change CStarMatrix.ofMatrix.symm
    ((conjugation (mixingUnitary u v flip reflect)).toCompletelyPositiveMap
      (CStarMatrix.ofMatrix X)) x y = _
  rw [conjugation_apply]
  change (diagonal (sign u v flip reflect) * X * (diagonal (sign u v flip reflect))ᴴ) x y = _
  rw [diagonal_conjTranspose, mul_diagonal, diagonal_mul]
  simp only [Pi.star_apply, sign_star]
  ring

private def weight (t : ℝ) : ℝ := (1 + Real.exp (-t)) / 2

private theorem weight_nonneg (t : ℝ) : 0 ≤ weight t := by
  unfold weight
  positivity

private theorem weight_le_one (t : ℝ≥0) : weight t ≤ 1 := by
  have h : Real.exp (-(t : ℝ)) ≤ 1 := Real.exp_le_one_iff.mpr (neg_nonpos.mpr t.2)
  unfold weight
  linarith

/-- The two mixtures use the diagonal involutions of the checked rank-two channel. -/
def dephasing (u v : a) (flip : Bool) (t : ℝ≥0) : QuantumChannel a a :=
  (mix (weight t) (weight_nonneg t) (weight_le_one t) identity
    (conjugation (mixingUnitary u v flip false))).comp
  (mix (weight t) (weight_nonneg t) (weight_le_one t) identity
    (conjugation (mixingUnitary u v flip true)))

private theorem weight_coeff (t : ℝ) {z : ℂ} (hz : z = 1 ∨ z = -1) :
    (weight t : ℂ) + ((1 - weight t : ℝ) : ℂ) * z =
      (Real.exp (t * ((z.re - 1) / 2)) : ℂ) := by
  rcases hz with rfl | rfl
  · simp
  · have h : t * (((-1 : ℂ).re - 1) / 2) = -t := by simp; ring
    rw [h]
    push_cast
    unfold weight
    push_cast
    ring

/-- Each off-diagonal rate is obtained from the static channel's Schur multiplier. -/
def coefficient (u v : a) (flip : Bool) (x y : a) : ℂ :=
  act (hiddenChannel u v flip) (of (fun _ _ => 1)) x y

theorem hidden_entry (u v : a) (flip : Bool) (X : Matrix a a ℂ) (x y : a) :
    act (hiddenChannel u v flip) X x y = coefficient u v flip x y * X x y := by
  change (hiddenChannel u v flip).toCompletelyPositiveMap (CStarMatrix.ofMatrix X) x y =
    (hiddenChannel u v flip).toCompletelyPositiveMap
      (CStarMatrix.ofMatrix (of fun _ _ => 1)) x y * X x y
  rw [hiddenChannel_entry, hiddenChannel_entry]
  split
  · simp
    ring
  · simp

private theorem coefficient_eq (u v : a) (flip : Bool) (x y : a) :
    coefficient u v flip x y =
      (sign u v flip false x * sign u v flip false y +
        sign u v flip true x * sign u v flip true y) / 2 := by
  have h := congrArg (fun M : CStarMatrix a a ℂ => M x y)
    (hiddenChannel_randomUnitary u v flip (CStarMatrix.ofMatrix (of (fun _ _ => 1))))
  change coefficient u v flip x y =
    (1 / 2 : ℂ) * (act (conjugation (mixingUnitary u v flip false)) (of (fun _ _ => 1)) x y +
      act (conjugation (mixingUnitary u v flip true)) (of (fun _ _ => 1)) x y) at h
  rw [conjugation_entry, conjugation_entry] at h
  simpa [div_eq_mul_inv, mul_comm] using h

private theorem coefficient_diag (u v : a) (flip : Bool) (x : a) :
    coefficient u v flip x x = 1 := by
  rw [coefficient_eq]
  rcases sign_cases u v flip false x with h | h <;>
    rcases sign_cases u v flip true x with k | k <;> norm_num [h, k]

def rate (u v : a) (flip : Bool) (x y : a) : ℝ := (coefficient u v flip x y).re - 1

private theorem dephasing_entry (u v : a) (flip : Bool) (t : ℝ≥0)
    (X : Matrix a a ℂ) (x y : a) :
    act (dephasing u v flip t) X x y =
      (Real.exp ((t : ℝ) * rate u v flip x y) : ℂ) * X x y := by
  let step (b : Bool) := mix (weight t) (weight_nonneg t) (weight_le_one t) identity
    (conjugation (mixingUnitary u v flip b))
  let z (b : Bool) := sign u v flip b x * sign u v flip b y
  have hz (b : Bool) : z b = 1 ∨ z b = -1 := by
    rcases sign_cases u v flip b x with h | h <;>
      rcases sign_cases u v flip b y with k | k <;> simp [z, h, k]
  have hs (b : Bool) (Y : Matrix a a ℂ) :
      act (step b) Y x y = (Real.exp ((t : ℝ) * (((z b).re - 1) / 2)) : ℂ) * Y x y := by
    dsimp only [step]
    rw [mix_entry, conjugation_entry, ← weight_coeff t (hz b)]
    change (weight t : ℂ) * Y x y + ((1 - weight t : ℝ) : ℂ) * (z b * Y x y) = _
    ring
  change act (step false) (act (step true) X) x y = _
  rw [hs, hs, ← mul_assoc, ← Complex.ofReal_mul, ← Real.exp_add]
  have he : (t : ℝ) * (((z false).re - 1) / 2) + (t : ℝ) * (((z true).re - 1) / 2) =
      (t : ℝ) * rate u v flip x y := by
    rw [rate, coefficient_eq]
    change (t : ℝ) * (((z false).re - 1) / 2) + (t : ℝ) * (((z true).re - 1) / 2) =
      (t : ℝ) * (((z false + z true) / 2).re - 1)
    rw [show (2 : ℂ) = (2 : ℝ) by norm_num, Complex.div_ofReal_re, Complex.add_re]
    ring
  rw [he]

private theorem rate_diag (u v : a) (flip : Bool) (x : a) : rate u v flip x x = 0 := by
  simp [rate, coefficient_diag]

def decay (γ t : ℝ) : ℝ := Real.exp (-γ * t)

private theorem decay_nonneg (γ t : ℝ) : 0 ≤ decay γ t := (Real.exp_pos _).le

private theorem decay_le_one (γ t : ℝ≥0) : decay γ t ≤ 1 :=
  Real.exp_le_one_iff.mpr (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr γ.2) t.2)

/-- Finite-time Schrödinger evolution, as a CPTP channel at every nonnegative time. -/
def flow (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool) (t : ℝ≥0) :
    QuantumChannel a a :=
  mix (decay γ t) (decay_nonneg γ t) (decay_le_one γ t) (dephasing u v flip t) (reset τ)

theorem flow_entry (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool) (t : ℝ≥0)
    (X : Matrix a a ℂ) (x y : a) :
    act (flow τ γ u v flip t) X x y =
      (decay γ t : ℂ) * ((Real.exp ((t : ℝ) * rate u v flip x y) : ℂ) * X x y) +
        ((1 - decay γ t : ℝ) : ℂ) * (trace X * τ.1 x y) := by
  rw [flow, mix_entry, dephasing_entry, reset_act]
  rfl

/-- A density diagonal in the computational basis, without a spectral nondegeneracy assumption. -/
def IsDiagonal (τ : DensityState a) : Prop := ∀ x y, x ≠ y → τ.1 x y = 0

theorem flow_zero (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool) :
    flow τ γ u v flip 0 = identity := by
  apply channel_ext
  intro X
  apply CStarMatrix.ext
  intro x y
  change act (flow τ γ u v flip 0) (CStarMatrix.ofMatrix.symm X) x y = X x y
  simp [flow_entry, decay]

theorem flow_add (τ : DensityState a) (hτ : IsDiagonal τ) (γ : ℝ≥0)
    (u v : a) (flip : Bool) (s t : ℝ≥0) :
    flow τ γ u v flip (s + t) = (flow τ γ u v flip s).comp (flow τ γ u v flip t) := by
  apply channel_ext
  intro X
  apply CStarMatrix.ext
  intro x y
  let Y := CStarMatrix.ofMatrix.symm X
  change act (flow τ γ u v flip (s + t)) Y x y =
    act (flow τ γ u v flip s) (act (flow τ γ u v flip t) Y) x y
  have ht : trace (act (flow τ γ u v flip t) Y) = trace Y :=
    (flow τ γ u v flip t).trace_preserving X
  have hdecay : decay γ ((s + t : ℝ≥0) : ℝ) = decay γ s * decay γ t := by
    unfold decay
    rw [NNReal.coe_add, mul_add, Real.exp_add]
  have hexp : Real.exp (((s + t : ℝ≥0) : ℝ) * rate u v flip x y) =
      Real.exp ((s : ℝ) * rate u v flip x y) * Real.exp ((t : ℝ) * rate u v flip x y) := by
    rw [NNReal.coe_add, add_mul, Real.exp_add]
  rw [flow_entry, flow_entry, ht, flow_entry, hdecay, hexp]
  simp only [Complex.ofReal_sub, Complex.ofReal_one, Complex.ofReal_mul]
  by_cases hxy : x = y
  · subst y
    simp only [rate_diag, mul_zero, Real.exp_zero, Complex.ofReal_one]
    ring
  · rw [hτ x y hxy]
    ring

theorem flow_stationary (τ : DensityState a) (hτ : IsDiagonal τ) (γ : ℝ≥0)
    (u v : a) (flip : Bool) (t : ℝ≥0) :
    (flow τ γ u v flip t).mapState τ = τ := by
  apply Subtype.ext
  apply CStarMatrix.ext
  intro x y
  change act (flow τ γ u v flip t) (CStarMatrix.ofMatrix.symm τ.1) x y = τ.1 x y
  have ht : trace (CStarMatrix.ofMatrix.symm τ.1) = 1 := τ.2.2
  rw [flow_entry, ht]
  simp only [Complex.ofReal_sub, Complex.ofReal_one]
  by_cases hxy : x = y
  · subst y
    simp only [rate_diag, mul_zero, Real.exp_zero, Complex.ofReal_one]
    change (decay γ t : ℂ) * (1 * τ.1 x x) + (1 - (decay γ t : ℂ)) * (1 * τ.1 x x) = _
    ring
  · change (decay γ t : ℂ) * (_ * τ.1 x y) + (1 - (decay γ t : ℂ)) * (1 * τ.1 x y) = _
    simp [hτ x y hxy]

/-- Every nonzero positive input becomes strictly positive at every positive time. -/
theorem flow_positivity_improving (τ : DensityState a)
    (hτ : (CStarMatrix.ofMatrix.symm τ.1).PosDef) (γ : ℝ≥0) (hγ : 0 < γ)
    (u v : a) (flip : Bool) (t : ℝ≥0) (ht : 0 < t)
    (X : Matrix a a ℂ) (hX : X.PosSemidef) (hne : X ≠ 0) :
    (act (flow τ γ u v flip t) X).PosDef := by
  have htrace : 0 < (trace X).re := by
    have hn : 0 ≤ trace X := hX.trace_nonneg
    have hp : 0 < trace X := lt_of_le_of_ne hn (Ne.symm (hX.trace_eq_zero_iff.not.mpr hne))
    exact (Complex.pos_iff.mp hp).1
  have htr : ((trace X).re : ℂ) = trace X := by
    apply Complex.ext
    · simp
    · simpa using (Complex.nonneg_iff.mp hX.trace_nonneg).2
  have hw : 0 < 1 - decay γ t := by
    apply sub_pos.mpr
    apply Real.exp_lt_one_iff.mpr
    rw [neg_mul]
    exact neg_lt_zero.mpr (mul_pos hγ ht)
  have hdeph : (act (dephasing u v flip t) X).PosSemidef := by
    apply Matrix.nonneg_iff_posSemidef.mp
    exact map_nonneg CStarMatrix.ofMatrixStarAlgEquiv.symm
      (map_nonneg (dephasing u v flip t).toCompletelyPositiveMap
        (map_nonneg CStarMatrix.ofMatrixStarAlgEquiv hX.nonneg))
  have hformula : act (flow τ γ u v flip t) X =
      decay γ t • act (dephasing u v flip t) X +
        (1 - decay γ t) • ((trace X).re • CStarMatrix.ofMatrix.symm τ.1) := by
    ext x y
    rw [flow, mix_entry, reset_act]
    simp only [Matrix.add_apply, Matrix.smul_apply, Complex.real_smul, smul_eq_mul, htr]
  rw [hformula]
  exact Matrix.PosDef.posSemidef_add (hdeph.smul (decay_nonneg γ t))
    ((hτ.smul htrace).smul hw)

private theorem coefficient_symm (u v : a) (flip : Bool) (i j : a) :
    coefficient u v flip i j = coefficient u v flip j i := by
  simp only [coefficient_eq, mul_comm]

private theorem coefficient_real (u v : a) (flip : Bool) (i j : a) :
    ((coefficient u v flip i j).re : ℂ) = coefficient u v flip i j := by
  rw [coefficient_eq]
  rcases sign_cases u v flip false i with h | h <;>
    rcases sign_cases u v flip false j with k | k <;>
      rcases sign_cases u v flip true i with l | l <;>
        rcases sign_cases u v flip true j with m | m <;> norm_num [h, k, l, m]

private theorem rate_nonpos (u v : a) (flip : Bool) (i j : a) : rate u v flip i j ≤ 0 := by
  rw [rate, coefficient_eq]
  rcases sign_cases u v flip false i with h | h <;>
    rcases sign_cases u v flip false j with k | k <;>
      rcases sign_cases u v flip true i with l | l <;>
        rcases sign_cases u v flip true j with m | m <;> norm_num [h, k, l, m]

private def multiplier (γ : ℝ) (u v : a) (flip : Bool) (t : ℝ) (i j : a) : ℝ :=
  Real.exp ((rate u v flip i j - γ) * t)

theorem flow_schur_reset (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool)
    (t : ℝ≥0) (X : Matrix a a ℂ) (i j : a) :
    act (flow τ γ u v flip t) X i j =
      (multiplier γ u v flip t i j : ℂ) * X i j +
        ((1 - decay γ t : ℝ) : ℂ) * (trace X * τ.1 i j) := by
  rw [flow_entry, ← mul_assoc, ← Complex.ofReal_mul]
  have he : decay γ t * Real.exp ((t : ℝ) * rate u v flip i j) =
      multiplier γ u v flip t i j := by
    rw [decay, multiplier, ← Real.exp_add]
    congr 1
    ring
  rw [he]

open Filter Topology

/-- Mixing converges on all inputs to the trace-preserving replacement channel. -/
theorem flow_tendsto_reset (τ : DensityState a) (γ : ℝ≥0) (hγ : 0 < γ)
    (u v : a) (flip : Bool) (X : Matrix a a ℂ) :
    Tendsto (fun t : ℝ≥0 => act (flow τ γ u v flip t) X) atTop
      (𝓝 (trace X • CStarMatrix.ofMatrix.symm τ.1)) := by
  have hc : Tendsto (fun t : ℝ≥0 => (t : ℝ)) atTop atTop :=
    NNReal.tendsto_coe_atTop.mpr tendsto_id
  have he (c : ℝ) (hn : c < 0) :
      Tendsto (fun t : ℝ≥0 => Real.exp (c * t)) atTop (𝓝 0) :=
    Real.tendsto_exp_atBot.comp ((tendsto_const_mul_atBot_of_neg hn).mpr hc)
  apply tendsto_pi_nhds.mpr
  intro i
  apply tendsto_pi_nhds.mpr
  intro j
  simp only [flow_schur_reset, Matrix.smul_apply, smul_eq_mul]
  have hfirst := he (rate u v flip i j - γ) (sub_neg.mpr ((rate_nonpos u v flip i j).trans_lt hγ))
  have hsecond := he (-(γ : ℝ)) (neg_lt_zero.mpr hγ)
  have h₁ := (Complex.continuous_ofReal.continuousAt.tendsto.comp hfirst).mul_const (X i j)
  have hreset : Tendsto (fun t : ℝ≥0 => 1 - Real.exp (-(γ : ℝ) * t)) atTop (𝓝 (1 : ℝ)) := by
    simpa only [sub_zero] using tendsto_const_nhds.sub hsecond
  have h₂ := (Complex.continuous_ofReal.continuousAt.tendsto.comp hreset).mul_const
    (trace X * τ.1 i j)
  simpa [multiplier, decay, Function.comp_def] using h₁.add h₂

omit [Fintype a] [DecidableEq a] in
private theorem cstar_finite_dimensional [Finite a] : FiniteDimensional ℂ (CStarMatrix a a ℂ) := by
  classical
  let := Fintype.ofFinite a
  let e := CStarMatrix.ofMatrixStarAlgEquiv (n := a) (A := ℂ)
  exact FiniteDimensional.of_injective e.toAlgEquiv.toLinearEquiv.symm.toLinearMap e.symm.injective

attribute [local instance] cstar_finite_dimensional

/-- The semigroup is continuous in the norm of finite-dimensional continuous linear maps. -/
theorem flow_norm_continuous (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool) :
    Continuous (fun t : ℝ≥0 =>
      (flow τ γ u v flip t).toCompletelyPositiveMap.toLinearMap.toContinuousLinearMap) := by
  rw [continuous_clm_apply]
  intro X
  let e := (CStarMatrix.ofMatrixStarAlgEquiv (n := a) (A := ℂ)).toAlgEquiv.toLinearEquiv
  have hc : Continuous (fun t : ℝ≥0 => act (flow τ γ u v flip t) (e.symm X)) := by
    apply continuous_matrix
    intro i j
    simp only [flow_schur_reset, multiplier, decay]
    fun_prop
  exact e.toLinearMap.continuous_of_finiteDimensional.comp hc

/-- The GNS pairing with the stationary density. -/
def gns (τ : DensityState a) (A B : Matrix a a ℂ) : ℂ :=
  trace (CStarMatrix.ofMatrix.symm τ.1 * (Aᴴ * B))

theorem gns_weighted_trace (τ : DensityState a) (hτ : IsDiagonal τ) (A B : Matrix a a ℂ) :
    gns τ A B = ∑ j, τ.1 j j * ∑ i, star (A i j) * B i j := by
  have hdiag : CStarMatrix.ofMatrix.symm τ.1 = diagonal (fun i => τ.1 i i) := by
    ext i j
    by_cases hij : i = j
    · subst j; simp
    · exact (hτ i j hij).trans (diagonal_apply_ne _ hij).symm
  simp only [gns, hdiag, trace, diag_apply, diagonal_mul]
  rfl

private def observable (τ : DensityState a) (m : a → a → ℝ) (r : ℝ)
    (A : Matrix a a ℂ) : Matrix a a ℂ :=
  of fun i j => (m i j : ℂ) * A i j + (r : ℂ) * (gns τ 1 A * (1 : Matrix a a ℂ) i j)

/-- The Heisenberg evolution, with the trace-dual replacement map. -/
def heisenberg (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool)
    (t : ℝ≥0) (A : Matrix a a ℂ) : Matrix a a ℂ :=
  observable τ (multiplier γ u v flip t) (1 - decay γ t) A

private theorem density_diag_star (τ : DensityState a) (j : a) :
    star (τ.1 j j) = τ.1 j j :=
  (Matrix.nonneg_iff_posSemidef.mp
    (map_nonneg CStarMatrix.ofMatrixStarAlgEquiv.symm τ.2.1)).isHermitian.apply j j

theorem heisenberg_trace_dual (τ : DensityState a) (hτ : IsDiagonal τ) (γ : ℝ≥0)
    (u v : a) (flip : Bool) (t : ℝ≥0) (A X : Matrix a a ℂ) :
    trace (heisenberg τ γ u v flip t A * X) =
      trace (A * act (flow τ γ u v flip t) X) := by
  have hexpect : gns τ 1 A = ∑ i, τ.1 i i * A i i := by
    rw [gns_weighted_trace τ hτ]
    simp [one_apply, apply_ite, ite_mul]
  simp only [trace, diag_apply, mul_apply, heisenberg, observable, of_apply, flow_schur_reset,
    add_mul, mul_add, Finset.sum_add_distrib]
  congr 1
  · apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    rw [show multiplier γ u v flip t j i = multiplier γ u v flip t i j by
      simp only [multiplier, rate, coefficient_symm u v flip j i]]
    ring
  · let r : ℂ := ((1 - decay γ t : ℝ) : ℂ)
    let e := gns τ 1 A
    let q := ∑ i, X i i
    change (∑ i, ∑ j, r * (e * (1 : Matrix a a ℂ) i j) * X j i) =
      ∑ i, ∑ j, A i j * (r * (q * τ.1 j i))
    have hleft (i : a) :
        (∑ j, r * (e * (1 : Matrix a a ℂ) i j) * X j i) = (r * e) * X i i := by
      rw [Finset.sum_eq_single i]
      · simp
      · intro j _ hji
        simp [one_apply_ne (Ne.symm hji)]
      · simp
    have hright (i : a) :
        (∑ j, A i j * (r * (q * τ.1 j i))) = (r * q) * (τ.1 i i * A i i) := by
      rw [Finset.sum_eq_single i]
      · ring
      · intro j _ hji
        simp [hτ j i hji]
      · simp
    simp_rw [hleft, hright, ← Finset.mul_sum]
    change (r * e) * q = (r * q) * ∑ i, τ.1 i i * A i i
    rw [← hexpect]
    ring

private theorem gns_left_one (τ : DensityState a) (hτ : IsDiagonal τ) (A : Matrix a a ℂ) :
    gns τ 1 A = ∑ j, τ.1 j j * A j j := by
  rw [gns_weighted_trace τ hτ]
  simp [one_apply, apply_ite, ite_mul]

private theorem observable_gns (τ : DensityState a) (hτ : IsDiagonal τ)
    (m : a → a → ℝ) (r : ℝ) (A B : Matrix a a ℂ) :
    gns τ A (observable τ m r B) = gns τ (observable τ m r A) B := by
  rw [gns_weighted_trace τ hτ, gns_weighted_trace τ hτ]
  simp only [observable, of_apply, star_add, star_mul, Complex.star_def, Complex.conj_ofReal,
    mul_add, add_mul, Finset.sum_add_distrib]
  congr 1
  · apply Finset.sum_congr rfl
    intro j _
    congr 1
    apply Finset.sum_congr rfl
    intro i _
    ring
  · have hleft (j : a) :
        (∑ i, star (A i j) * ((r : ℂ) * (gns τ 1 B * (1 : Matrix a a ℂ) i j))) =
          star (A j j) * ((r : ℂ) * gns τ 1 B) := by
      rw [Finset.sum_eq_single j]
      · simp
      · intro i _ hij
        simp [one_apply_ne hij]
      · simp
    have hright (j : a) :
        (∑ i, star ((1 : Matrix a a ℂ) i j) * star (gns τ 1 A) * (r : ℂ) * B i j) =
          (r : ℂ) * star (gns τ 1 A) * B j j := by
      rw [Finset.sum_eq_single j]
      · simp only [one_apply_eq, star_one, one_mul]
        ring
      · intro i _ hij
        simp [one_apply_ne hij]
      · simp
    simp only [← Complex.star_def]
    simp_rw [hleft, hright]
    simp_rw [show ∀ j, τ.1 j j * (star (A j j) * ((r : ℂ) * gns τ 1 B)) =
        ((r : ℂ) * gns τ 1 B) * (τ.1 j j * star (A j j)) by intro; ring,
      show ∀ j, τ.1 j j * ((r : ℂ) * star (gns τ 1 A) * B j j) =
        ((r : ℂ) * star (gns τ 1 A)) * (τ.1 j j * B j j) by intro; ring,
      ← Finset.mul_sum]
    have hexpectStar : star (gns τ 1 A) = ∑ j, τ.1 j j * star (A j j) := by
      rw [gns_left_one τ hτ]
      change (starRingEnd ℂ) (∑ j, τ.1 j j * A j j) = _
      simp only [map_sum, map_mul]
      exact Finset.sum_congr rfl fun j _ => by
        rw [show (starRingEnd ℂ) (τ.1 j j) = τ.1 j j from density_diag_star τ j]
        rfl
    rw [← gns_left_one τ hτ B, ← hexpectStar]
    ring

theorem heisenberg_gns_symmetric (τ : DensityState a) (hτ : IsDiagonal τ) (γ : ℝ≥0)
    (u v : a) (flip : Bool) (t : ℝ≥0) (A B : Matrix a a ℂ) :
    gns τ A (heisenberg τ γ u v flip t B) =
      gns τ (heisenberg τ γ u v flip t A) B :=
  observable_gns τ hτ _ _ A B

/-- Schrödinger generator Φ − id + γ(Rτ − id). -/
def generator (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool)
    (X : Matrix a a ℂ) : Matrix a a ℂ :=
  act (hiddenChannel u v flip) X - X + (γ : ℝ) • (act (reset τ) X - X)

/-- Heisenberg generator with reset A ↦ tr(τ A) I. -/
def heisenbergGenerator (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool)
    (A : Matrix a a ℂ) : Matrix a a ℂ :=
  observable τ (fun i j => rate u v flip i j - γ) γ A

theorem heisenberg_generator_gns_symmetric (τ : DensityState a) (hτ : IsDiagonal τ)
    (γ : ℝ≥0) (u v : a) (flip : Bool) (A B : Matrix a a ℂ) :
    gns τ A (heisenbergGenerator τ γ u v flip B) =
      gns τ (heisenbergGenerator τ γ u v flip A) B :=
  observable_gns τ hτ _ _ A B

private theorem exp_entry_hasDerivAt (c : ℝ) :
    HasDerivAt (fun t : ℝ => Real.exp (c * t)) c 0 := by
  have h : HasDerivAt (fun t : ℝ => c * t) c 0 := by
    simpa using (hasDerivAt_id (0 : ℝ)).const_mul c
  simpa using h.exp

theorem generator_entry (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool)
    (X : Matrix a a ℂ) (i j : a) :
    generator τ γ u v flip X i j = ((rate u v flip i j - γ : ℝ) : ℂ) * X i j +
      (γ : ℂ) * (trace X * τ.1 i j) := by
  simp only [generator, Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply,
    Complex.real_smul, smul_eq_mul, reset_act, hidden_entry, rate, Complex.ofReal_sub,
    Complex.ofReal_one, coefficient_real, CStarMatrix.ofMatrix_symm_apply]
  ring

/-- Right derivatives of the complete finite-time channel recover the stated generator. -/
theorem flow_generator (τ : DensityState a) (γ : ℝ≥0) (u v : a) (flip : Bool)
    (X : Matrix a a ℂ) (i j : a) :
    HasDerivWithinAt
      (fun t : ℝ => act (flow τ γ u v flip t.toNNReal) X i j)
      (generator τ γ u v flip X i j) (Set.Ici 0) 0 := by
  have hfirst := (exp_entry_hasDerivAt (rate u v flip i j - γ)).ofReal_comp.mul_const (X i j)
  have hsecond : HasDerivAt (fun t : ℝ => 1 - Real.exp (-(γ : ℝ) * t)) γ 0 := by
    simpa only [neg_neg] using (exp_entry_hasDerivAt (-(γ : ℝ))).const_sub 1
  have h := (hfirst.add (hsecond.ofReal_comp.mul_const (trace X * τ.1 i j))).hasDerivWithinAt
    (s := Set.Ici 0)
  rw [generator_entry]
  refine h.congr ?_ ?_
  · intro t ht
    simp only [flow_schur_reset, multiplier, decay, Real.coe_toNNReal _ ht, Pi.add_apply]
  · simp [flow_schur_reset, multiplier, decay]

/-- The displayed Heisenberg generator is the right derivative of the trace-dual flow. -/
theorem heisenberg_generator_derivative (τ : DensityState a) (γ : ℝ≥0)
    (u v : a) (flip : Bool) (A : Matrix a a ℂ) (i j : a) :
    HasDerivWithinAt
      (fun t : ℝ => heisenberg τ γ u v flip t.toNNReal A i j)
      (heisenbergGenerator τ γ u v flip A i j) (Set.Ici 0) 0 := by
  let z := gns τ 1 A * (1 : Matrix a a ℂ) i j
  have hfirst := (exp_entry_hasDerivAt (rate u v flip i j - γ)).ofReal_comp.mul_const (A i j)
  have hsecond : HasDerivAt (fun t : ℝ => 1 - Real.exp (-(γ : ℝ) * t)) γ 0 := by
    simpa only [neg_neg] using (exp_entry_hasDerivAt (-(γ : ℝ))).const_sub 1
  have h := (hfirst.add (hsecond.ofReal_comp.mul_const z)).hasDerivWithinAt (s := Set.Ici 0)
  refine h.congr ?_ ?_
  · intro t ht
    simp only [heisenberg, observable, of_apply, multiplier, decay, Real.coe_toNNReal _ ht,
      Pi.add_apply, z]
  · simp [heisenberg, observable, multiplier, decay]

/-- A diagonal unitary conjugation leaves the same energy populations invariant. -/
theorem flow_commutes_diagonal_conjugation (τ : DensityState a) (hτ : IsDiagonal τ)
    (γ : ℝ≥0) (u v : a) (flip : Bool) (t : ℝ≥0)
    (z : a → ℂ) (hz : ∀ i, z i * star (z i) = 1) (X : Matrix a a ℂ) :
    act (flow τ γ u v flip t) (diagonal z * X * (diagonal z)ᴴ) =
      diagonal z * act (flow τ γ u v flip t) X * (diagonal z)ᴴ := by
  have htr : trace (diagonal z * X * (diagonal z)ᴴ) = trace X := by
    simp only [trace, diag_apply, diagonal_conjTranspose, mul_diagonal, diagonal_mul]
    apply Finset.sum_congr rfl
    intro i _
    change z i * X i i * star (z i) = X i i
    calc
      _ = (z i * star (z i)) * X i i := by ring
      _ = _ := by rw [hz, one_mul]
  ext i j
  rw [flow_schur_reset, htr]
  simp only [diagonal_conjTranspose, mul_diagonal, diagonal_mul, Pi.star_apply,
    flow_schur_reset]
  by_cases hij : i = j
  · subst j
    have hd : z i * X i i * star (z i) = X i i := by
      calc
        _ = (z i * star (z i)) * X i i := by ring
        _ = _ := by rw [hz, one_mul]
    rw [hd]
    calc
      _ = (z i * star (z i)) *
        ((multiplier γ u v flip t i i : ℂ) * X i i +
          ((1 - decay γ t : ℝ) : ℂ) * (trace X * τ.1 i i)) := by rw [hz, one_mul]
      _ = _ := by ring
  · rw [hτ i j hij]
    ring

/-- Covariance under the real-time diagonal Hamiltonian phases. -/
theorem flow_hamiltonian_covariant (τ : DensityState a) (hτ : IsDiagonal τ)
    (γ : ℝ≥0) (u v : a) (flip : Bool) (t : ℝ≥0)
    (E : a → ℝ) (s : ℝ) (X : Matrix a a ℂ) :
    let U := diagonal (fun i => Complex.exp (-Complex.I * (s : ℂ) * (E i : ℂ)))
    act (flow τ γ u v flip t) (U * X * Uᴴ) = U * act (flow τ γ u v flip t) X * Uᴴ := by
  dsimp only
  apply flow_commutes_diagonal_conjugation τ hτ
  intro i
  rw [Complex.star_def, ← Complex.exp_conj, ← Complex.exp_add]
  have h : -Complex.I * (s : ℂ) * (E i : ℂ) +
      (starRingEnd ℂ) (-Complex.I * (s : ℂ) * (E i : ℂ)) = 0 := by
    simp only [map_mul, map_neg, Complex.conj_I, Complex.conj_ofReal]
    ring
  rw [h, Complex.exp_zero]

/-- The diagonal unitary is the matrix propagator `exp(-i s H)` for `H = diag(E)`. -/
theorem flow_commutes_hamiltonian_propagator (τ : DensityState a) (hτ : IsDiagonal τ)
    (γ : ℝ≥0) (u v : a) (flip : Bool) (t : ℝ≥0) (E : a → ℝ) (s : ℝ)
    (X : Matrix a a ℂ) :
    let H := diagonal (fun i => (E i : ℂ))
    let U := NormedSpace.exp ((-Complex.I * (s : ℂ)) • H)
    act (flow τ γ u v flip t) (U * X * Uᴴ) = U * act (flow τ γ u v flip t) X * Uᴴ := by
  dsimp only
  rw [← diagonal_smul, Matrix.exp_diagonal]
  have hp : NormedSpace.exp ((-Complex.I * (s : ℂ)) • (fun i => (E i : ℂ))) =
      fun i => Complex.exp (-Complex.I * (s : ℂ) * (E i : ℂ)) := by
    funext i
    rw [Pi.coe_exp, ← Complex.exp_eq_exp_ℂ]
    rfl
  rw [hp]
  exact flow_hamiltonian_covariant τ hτ γ u v flip t E s X

/-- The faithful Gibbs density is the unique density fixed by the whole flow. -/
theorem flow_unique_stationary (τ : DensityState a) (γ : ℝ≥0) (hγ : 0 < γ)
    (u v : a) (flip : Bool) (σ : DensityState a)
    (hσ : ∀ t, (flow τ γ u v flip t).mapState σ = σ) : σ = τ := by
  let X := CStarMatrix.ofMatrix.symm σ.1
  have hX : trace X = 1 := σ.2.2
  have h := flow_tendsto_reset τ γ hγ u v flip X
  have heq (t : ℝ≥0) : act (flow τ γ u v flip t) X = X :=
    congrArg (fun ρ : DensityState a => CStarMatrix.ofMatrix.symm ρ.1) (hσ t)
  simp only [hX, one_smul, heq] at h
  exact Subtype.ext (CStarMatrix.ofMatrix.symm.injective
    (tendsto_nhds_unique h tendsto_const_nhds).symm)

