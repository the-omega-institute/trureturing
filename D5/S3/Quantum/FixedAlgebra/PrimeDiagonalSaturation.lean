/- Library-search audit trail (2026-08-25):
   * Repository search hit `primeOccupancy` as the existing prime-exponent coordinate and
     `projectiveReadout` as `Matrix.diagonal (Matrix.diag rho)`; both are reused here.
   * `basis_measurement_is_orthogonal_projection` identifies finite-basis dephasing as an
     orthogonal projection, but only on nonzero-dimensional Hermitian matrices and without a
     prime-generated algebra or the arbitrary-matrix trace pairing proved below.
   * Pinned Mathlib searches hit `Matrix.trace`, `Matrix.diagonal`, `Matrix.diagonalAlgHom`,
     `Matrix.trace_mul_comm`, and the `Submodule.starProjection` projection API. The diagonal
     algebra map and trace simplifiers are used; no projection hypothesis is needed.
   * Repository and pinned-Mathlib searches found no finite prime-generated diagonal algebra or
     theorem stating its saturation under complete diagonal pinching. -/

import D5.S3.Analytic.ZetaObservation.MultiplicativeComplexityActivation
import D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Quantum.FixedAlgebra.PrimeDiagonalSaturation

open D5.S3.Analytic.ZetaObservation.MultiplicativeComplexityActivation
open D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics

noncomputable section

/-- The occupation-number operator for `p` on the integer basis `1, ..., d`. -/
def primeOccupationOperator (d : Nat) (p : Nat.Primes) :
    Matrix (Fin d) (Fin d) ℂ :=
  Matrix.diagonal fun i => (primeOccupancy p (i.1 + 1) : ℂ)

/-- The finite-dimensional algebra generated by the selected prime occupation operators. -/
def primeDiagonalAlgebra (d : Nat) (P : Finset Nat.Primes) :
    Subalgebra ℂ (Matrix (Fin d) (Fin d) ℂ) :=
  Algebra.adjoin ℂ
    ((fun p : Nat.Primes => primeOccupationOperator d p) '' (P : Set Nat.Primes))

/-- A prime occupation operator has its occupation number on the diagonal and zero elsewhere. -/
@[simp]
theorem prime_occupation_operator_apply (d : Nat) (p : Nat.Primes) (i j : Fin d) :
    primeOccupationOperator d p i j =
      if i = j then (primeOccupancy p (i.1 + 1) : ℂ) else 0 := by
  simp [primeOccupationOperator, Matrix.diagonal_apply]

#print axioms prime_occupation_operator_apply

/-- The algebra generated by any finite set of prime occupation operators is diagonal. -/
theorem prime_diagonal_algebra_le_full_diagonal (d : Nat) (P : Finset Nat.Primes) :
    primeDiagonalAlgebra d P ≤
      (Matrix.diagonalAlgHom ℂ :
        (Fin d → ℂ) →ₐ[ℂ] Matrix (Fin d) (Fin d) ℂ).range := by
  apply Algebra.adjoin_le
  rintro A ⟨p, hp, rfl⟩
  refine ⟨fun i => (primeOccupancy p (i.1 + 1) : ℂ), ?_⟩
  simp [primeOccupationOperator, Matrix.diagonalAlgHom_apply]

#print axioms prime_diagonal_algebra_le_full_diagonal

/-- Every observable in the finite prime-generated algebra has the same expectation before and
after complete diagonal pinching. The input matrix need not be positive, Hermitian, or trace one. -/
theorem prime_diagonal_saturation {d : Nat} {P : Finset Nat.Primes}
    (rho A : Matrix (Fin d) (Fin d) ℂ) (hA : A ∈ primeDiagonalAlgebra d P) :
    Matrix.trace (rho * A) = Matrix.trace (projectiveReadout rho * A) := by
  rcases prime_diagonal_algebra_le_full_diagonal d P hA with ⟨a, ha⟩
  rw [← ha]
  simp [Matrix.diagonalAlgHom_apply, projectiveReadout, Matrix.trace,
    Matrix.mul_diagonal]

#print axioms prime_diagonal_saturation

/-- The saturation law includes empty and singleton dimensions, the scalar generated algebra,
the identity observable, and inputs already fixed by pinching. -/
theorem prime_diagonal_degenerate_audit :
    (∀ (rho A : Matrix (Fin 0) (Fin 0) ℂ),
      A ∈ primeDiagonalAlgebra 0 ∅ →
      Matrix.trace (rho * A) = Matrix.trace (projectiveReadout rho * A)) ∧
    (∀ (rho A : Matrix (Fin 1) (Fin 1) ℂ),
      A ∈ primeDiagonalAlgebra 1 ∅ →
      Matrix.trace (rho * A) = Matrix.trace (projectiveReadout rho * A)) ∧
    (∀ (d : Nat) (P : Finset Nat.Primes) (rho : Matrix (Fin d) (Fin d) ℂ),
      (1 : Matrix (Fin d) (Fin d) ℂ) ∈ primeDiagonalAlgebra d P ∧
      Matrix.trace (rho * 1) = Matrix.trace (projectiveReadout rho * 1)) ∧
    (∀ (d : Nat) (P : Finset Nat.Primes) (rho A : Matrix (Fin d) (Fin d) ℂ),
      A ∈ primeDiagonalAlgebra d P → projectiveReadout rho = rho →
      Matrix.trace (rho * A) = Matrix.trace (projectiveReadout rho * A)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro rho A hA
    exact prime_diagonal_saturation rho A hA
  · intro rho A hA
    exact prime_diagonal_saturation rho A hA
  · intro d P rho
    have hOne : (1 : Matrix (Fin d) (Fin d) ℂ) ∈ primeDiagonalAlgebra d P :=
      Subalgebra.one_mem _
    exact ⟨hOne, prime_diagonal_saturation (P := P) rho 1 hOne⟩
  · intro d P rho A hA hFixed
    rw [hFixed]

#print axioms prime_diagonal_degenerate_audit

/-- Membership in the diagonal observable algebra is necessary: a concrete off-diagonal
observable detects coherence discarded by pinching. -/
theorem observable_membership_is_necessary :
    let rho : Matrix (Fin 2) (Fin 2) ℂ := Matrix.single 0 1 1
    let A : Matrix (Fin 2) (Fin 2) ℂ := Matrix.single 1 0 1
    A ∉ primeDiagonalAlgebra 2 ∅ ∧
      Matrix.trace (rho * A) ≠ Matrix.trace (projectiveReadout rho * A) := by
  dsimp only
  constructor
  · intro hA
    rcases prime_diagonal_algebra_le_full_diagonal 2 ∅ hA with ⟨a, ha⟩
    have hEntry := congrArg
      (fun M : Matrix (Fin 2) (Fin 2) ℂ => M (1 : Fin 2) (0 : Fin 2)) ha
    simp [Matrix.diagonalAlgHom_apply] at hEntry
  · norm_num [Matrix.trace, Matrix.mul_apply, projectiveReadout, Fin.sum_univ_two]

#print axioms observable_membership_is_necessary

end

end D5.S3.Quantum.FixedAlgebra.PrimeDiagonalSaturation
