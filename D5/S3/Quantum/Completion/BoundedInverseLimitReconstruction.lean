namespace D5.S3.Quantum.Completion.BoundedInverseLimitReconstruction

variable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H]
  [InnerProductSpace 𝕜 H] [CompleteSpace H]

/-- The closed cumulative space generated by an increasing sequence of stages. -/
def cumulativeSpace (S : ℕ → Submodule 𝕜 H) : Submodule 𝕜 H :=
  (⨆ n, S n).topologicalClosure

/-- The residual space left invisible by every cumulative stage. -/
def residualSpace (S : ℕ → Submodule 𝕜 H) : Submodule 𝕜 H :=
  (cumulativeSpace S)ᗮ

/-- Bounded stage-valued families compatible with every backward orthogonal projection. -/
def boundedInverseLimit (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] : Submodule 𝕜 (ℕ →ᵇ H) where
  carrier := {x | ∀ n, x n ∈ S n ∧
    ∀ m, n ≤ m → (S n).starProjection (x m) = x n}
  zero_mem' := by simp
  add_mem' := by
    intro x y hx hy n
    refine ⟨(S n).add_mem (hx n).1 (hy n).1, ?_⟩
    intro m hnm
    simp only [BoundedContinuousFunction.add_apply, map_add, hx n |>.2 m hnm,
      hy n |>.2 m hnm]
  smul_mem' := by
    intro c x hx n
    refine ⟨(S n).smul_mem c (hx n).1, ?_⟩
    intro m hnm
    simp only [BoundedContinuousFunction.smul_apply, map_smul, hx n |>.2 m hnm]

/-- The bounded family of all stage projections of a vector. -/
def projectionFamily (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] (x : H) : ℕ →ᵇ H :=
  BoundedContinuousFunction.ofNormedAddCommGroupDiscrete
    (fun n => (S n).starProjection x) ‖x‖
    (fun n => (S n).norm_starProjection_apply_le x)

omit [CompleteSpace H] in
@[simp]
private theorem projection_family_apply (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] (x : H) (n : ℕ) :
    projectionFamily S x n = (S n).starProjection x := rfl

omit [CompleteSpace H] in
private theorem projection_family_mem
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (hS : Monotone S) (x : H) : projectionFamily S x ∈ boundedInverseLimit S := by
  intro n
  refine ⟨(S n).starProjection_apply_mem x, ?_⟩
  intro m hnm
  change (S n).starProjection ((S m).starProjection x) = (S n).starProjection x
  have hMaps := (S n).starProjection_comp_starProjection_of_le (V := S m) (hS hnm)
  exact congrArg (fun f : H →L[𝕜] H => f x) hMaps

/-- The canonical linear map sending a cumulative vector to all of its stage projections. -/
def canonicalMap (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] (hS : Monotone S) :
    cumulativeSpace S →ₗ[𝕜] boundedInverseLimit S where
  toFun x := ⟨projectionFamily S x, projection_family_mem S hS x⟩
  map_add' x y := by
    apply Subtype.ext
    apply BoundedContinuousFunction.ext
    intro n
    simp [projectionFamily]
  map_smul' c x := by
    apply Subtype.ext
    apply BoundedContinuousFunction.ext
    intro n
    simp [projectionFamily]

omit [CompleteSpace H] in
@[simp]
theorem canonical_map_apply (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] (hS : Monotone S)
    (x : cumulativeSpace S) (n : ℕ) :
    ((canonicalMap S hS x : boundedInverseLimit S) : ℕ →ᵇ H) n =
      (S n).starProjection x := rfl

private theorem canonical_map_norm
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (hS : Monotone S) (x : cumulativeSpace S) :
    ‖canonicalMap S hS x‖ = ‖x‖ := by
  letI : CompleteSpace (cumulativeSpace S) := by
    exact (Submodule.isClosed_topologicalClosure (⨆ n, S n)).completeSpace_coe
  letI : (cumulativeSpace S).HasOrthogonalProjection := inferInstance
  change ‖projectionFamily S (x : H)‖ = ‖(x : H)‖
  apply le_antisymm
  · apply (BoundedContinuousFunction.norm_le (norm_nonneg x)).2
    intro n
    exact (S n).norm_starProjection_apply_le x
  · have hProjection : Tendsto (fun n => (S n).starProjection (x : H)) atTop (𝓝 (x : H)) := by
      have h := Submodule.starProjection_tendsto_closure_iSup S hS (x : H)
      have hx : (x : H) ∈ (⨆ n, S n).topologicalClosure := x.2
      rw [Submodule.starProjection_eq_self_iff.mpr hx] at h
      exact h
    have hNorm : Tendsto (fun n => ‖(S n).starProjection (x : H)‖) atTop (𝓝 ‖(x : H)‖) :=
      (continuous_norm.tendsto _).comp hProjection
    apply le_of_tendsto' hNorm
    intro n
    exact BoundedContinuousFunction.norm_coe_le_norm
      (projectionFamily S (x : H)) n

/-- The canonical projection map as a linear isometry. -/
def canonicalIsometry (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] (hS : Monotone S) :
    cumulativeSpace S →ₗᵢ[𝕜] boundedInverseLimit S where
  toLinearMap := canonicalMap S hS
  norm_map' := canonical_map_norm S hS

omit [CompleteSpace H] in
private theorem compatible_norm_mono
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (x : boundedInverseLimit S) : Monotone (fun n => ‖(x : ℕ →ᵇ H) n‖) := by
  intro n m hnm
  change ‖(x : ℕ →ᵇ H) n‖ ≤ ‖(x : ℕ →ᵇ H) m‖
  rw [← (x.2 n).2 m hnm]
  exact (S n).norm_starProjection_apply_le ((x : ℕ →ᵇ H) m)

omit [CompleteSpace H] in
private theorem compatible_norm_sq_mono
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (x : boundedInverseLimit S) : Monotone (fun n => ‖(x : ℕ →ᵇ H) n‖ ^ 2) := by
  intro n m hnm
  exact pow_le_pow_left₀ (norm_nonneg _) (compatible_norm_mono S x hnm) 2

omit [CompleteSpace H] in
private theorem compatible_pythagoras
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (x : boundedInverseLimit S) {n m : ℕ} (hnm : n ≤ m) :
    ‖(x : ℕ →ᵇ H) m‖ ^ 2 = ‖(x : ℕ →ᵇ H) n‖ ^ 2 +
      ‖(x : ℕ →ᵇ H) m - (x : ℕ →ᵇ H) n‖ ^ 2 := by
  have hxN : (x : ℕ →ᵇ H) n ∈ S n := (x.2 n).1
  have hDifference :
      (x : ℕ →ᵇ H) m - (x : ℕ →ᵇ H) n ∈ (S n)ᗮ := by
    rw [← (x.2 n).2 m hnm]
    exact Submodule.sub_starProjection_mem_orthogonal ((x : ℕ →ᵇ H) m)
  have hInner :
      ⟪(x : ℕ →ᵇ H) n,
        (x : ℕ →ᵇ H) m - (x : ℕ →ᵇ H) n⟫_𝕜 = 0 :=
    Submodule.inner_right_of_mem_orthogonal hxN hDifference
  have h := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero
    ((x : ℕ →ᵇ H) n)
    ((x : ℕ →ᵇ H) m - (x : ℕ →ᵇ H) n) hInner
  calc
    ‖(x : ℕ →ᵇ H) m‖ ^ 2 =
        ‖(x : ℕ →ᵇ H) n + ((x : ℕ →ᵇ H) m - (x : ℕ →ᵇ H) n)‖ ^ 2 := by
      congr 2
      abel
    _ = ‖(x : ℕ →ᵇ H) n‖ ^ 2 +
        ‖(x : ℕ →ᵇ H) m - (x : ℕ →ᵇ H) n‖ ^ 2 := by
      simpa only [pow_two] using h

omit [CompleteSpace H] in
private theorem compatible_family_cauchy
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (x : boundedInverseLimit S) : CauchySeq (fun n => (x : ℕ →ᵇ H) n) := by
  let a : ℕ → ℝ := fun n => ‖(x : ℕ →ᵇ H) n‖ ^ 2
  have haMonotone : Monotone a := compatible_norm_sq_mono S x
  have haBounded : BddAbove (Set.range a) := by
    refine ⟨‖(x : ℕ →ᵇ H)‖ ^ 2, ?_⟩
    rintro _ ⟨n, rfl⟩
    exact pow_le_pow_left₀ (norm_nonneg _)
      (BoundedContinuousFunction.norm_coe_le_norm (x : ℕ →ᵇ H) n) 2
  have haCauchy : CauchySeq a := (tendsto_atTop_ciSup haMonotone haBounded).cauchySeq
  rw [Metric.cauchySeq_iff]
  intro ε hε
  obtain ⟨N, hN⟩ := (Metric.cauchySeq_iff.mp haCauchy) (ε ^ 2) (sq_pos_of_pos hε)
  refine ⟨N, ?_⟩
  intro m hm n hn
  rcases le_total n m with hnm | hmn
  · have hScalar := hN m hm n hn
    have hOrder : a n ≤ a m := haMonotone hnm
    have hSquare : ‖(x : ℕ →ᵇ H) m - (x : ℕ →ᵇ H) n‖ ^ 2 < ε ^ 2 := by
      rw [Real.dist_eq, abs_of_nonneg (sub_nonneg.mpr hOrder)] at hScalar
      dsimp [a] at hScalar
      nlinarith [compatible_pythagoras S x hnm]
    rw [dist_eq_norm]
    exact (sq_lt_sq₀ (norm_nonneg _) hε.le).mp hSquare
  · have hScalar := hN n hn m hm
    have hOrder : a m ≤ a n := haMonotone hmn
    have hSquare : ‖(x : ℕ →ᵇ H) n - (x : ℕ →ᵇ H) m‖ ^ 2 < ε ^ 2 := by
      rw [Real.dist_eq, abs_of_nonneg (sub_nonneg.mpr hOrder)] at hScalar
      dsimp [a] at hScalar
      nlinarith [compatible_pythagoras S x hmn]
    rw [dist_eq_norm, norm_sub_rev]
    exact (sq_lt_sq₀ (norm_nonneg _) hε.le).mp hSquare

private theorem canonical_isometry_surjective
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (hS : Monotone S) : Function.Surjective (canonicalIsometry S hS) := by
  intro x
  obtain ⟨y, hy⟩ := cauchySeq_tendsto_of_complete (compatible_family_cauchy S x)
  have hyCumulative : y ∈ cumulativeSpace S := by
    apply (Submodule.isClosed_topologicalClosure (⨆ n, S n)).mem_of_tendsto hy
    filter_upwards with n
    change (x : ℕ →ᵇ H) n ∈ (⨆ k, S k).topologicalClosure
    exact (⨆ k, S k).le_topologicalClosure
      (Submodule.mem_iSup_of_mem n (x.2 n).1)
  refine ⟨⟨y, hyCumulative⟩, ?_⟩
  apply Subtype.ext
  apply BoundedContinuousFunction.ext
  intro n
  have hProjected : Tendsto (fun m => (S n).starProjection ((x : ℕ →ᵇ H) m))
      atTop (𝓝 ((S n).starProjection y)) :=
    (S n).starProjection.continuous.continuousAt.tendsto.comp hy
  have hEventually :
      (fun m => (S n).starProjection ((x : ℕ →ᵇ H) m)) =ᶠ[atTop]
        fun _ => (x : ℕ →ᵇ H) n := by
    filter_upwards [eventually_ge_atTop n] with m hm
    exact (x.2 n).2 m hm
  have hConstant : Tendsto (fun m => (S n).starProjection ((x : ℕ →ᵇ H) m))
      atTop (𝓝 ((x : ℕ →ᵇ H) n)) :=
    Tendsto.congr' hEventually.symm tendsto_const_nhds
  exact tendsto_nhds_unique hProjected hConstant

/-- The canonical linear isometric equivalence from the cumulative space to the bounded limit. -/
def canonicalReconstructionEquiv (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] (hS : Monotone S) :
    cumulativeSpace S ≃ₗᵢ[𝕜] boundedInverseLimit S :=
  LinearIsometryEquiv.ofSurjective (canonicalIsometry S hS)
    (canonical_isometry_surjective S hS)

/-- The quotient by the final residual is canonically isometric to the bounded limit. -/
def quotientReconstructionEquiv (S : ℕ → Submodule 𝕜 H)
    [∀ n, (S n).HasOrthogonalProjection] (hS : Monotone S) :
    (H ⧸ residualSpace S) ≃ₗᵢ[𝕜] boundedInverseLimit S := by
  letI : CompleteSpace (cumulativeSpace S) := by
    exact (Submodule.isClosed_topologicalClosure (⨆ n, S n)).completeSpace_coe
  letI : (cumulativeSpace S).HasOrthogonalProjection := inferInstance
  letI : (residualSpace S).HasOrthogonalProjection := by
    dsimp only [residualSpace]
    infer_instance
  exact (residualSpace S).quotientEquivOrthogonal |>.trans
    ((LinearIsometryEquiv.ofEq _ _ (by
      change (cumulativeSpace S)ᗮᗮ = cumulativeSpace S
      exact Submodule.orthogonal_orthogonal (K := cumulativeSpace S))).trans
        (canonicalReconstructionEquiv S hS))

/-- Bounded compatible stage data and the cumulative Hilbert completion determine each other
canonically and isometrically.  Quotienting the ambient space by the final residual gives the same
bounded inverse limit. -/
theorem bounded_inverse_limit_reconstruction
    (S : ℕ → Submodule 𝕜 H) [∀ n, (S n).HasOrthogonalProjection]
    (hS : Monotone S) :
    Isometry (canonicalReconstructionEquiv S hS :
      cumulativeSpace S → boundedInverseLimit S) ∧
    Function.Bijective (canonicalReconstructionEquiv S hS :
      cumulativeSpace S → boundedInverseLimit S) ∧
    (∀ x : cumulativeSpace S, ∀ n : ℕ,
      (((canonicalReconstructionEquiv S hS x : boundedInverseLimit S) : ℕ →ᵇ H) n) =
        (S n).starProjection (x : H)) ∧
    Isometry (quotientReconstructionEquiv S hS :
      (H ⧸ residualSpace S) → boundedInverseLimit S) ∧
    Function.Bijective (quotientReconstructionEquiv S hS :
      (H ⧸ residualSpace S) → boundedInverseLimit S) := by
  refine ⟨(canonicalReconstructionEquiv S hS).isometry,
    (canonicalReconstructionEquiv S hS).bijective, ?_,
    (quotientReconstructionEquiv S hS).isometry,
    (quotientReconstructionEquiv S hS).bijective⟩
  intro x n
  rfl

#print axioms bounded_inverse_limit_reconstruction

