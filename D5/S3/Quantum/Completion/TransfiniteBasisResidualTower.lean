import Mathlib.Analysis.InnerProductSpace.l2Space
import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional
import Mathlib.Order.SuccPred.Limit
import Mathlib.SetTheory.Cardinal.Arithmetic
import Mathlib.SetTheory.Ordinal.Basic

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open Set Submodule Cardinal Ordinal
open scoped InnerProductSpace

namespace D5.S3.Quantum.Completion.TransfiniteBasisResidualTower

universe u

variable {I K H : Type u} [RCLike K] [NormedAddCommGroup H]
  [InnerProductSpace K H]

/-- The source stage generated by a set of basis indices: its closed linear span. -/
def basisPrefix (b : HilbertBasis I K H) (s : Set I) : ClosedSubmodule K H :=
  (span K (b '' s)).closure

/-- The source residual at a stage, constructed as the prefix's orthogonal complement. -/
def basisResidual (b : HilbertBasis I K H) (s : Set I) : ClosedSubmodule K H :=
  (basisPrefix b s)ᗮ

private lemma basis_mem_residual (b : HilbertBasis I K H) (s : Set I)
    (i : ↥(sᶜ)) : b i.1 ∈ basisResidual b s := by
  change b i.1 ∈ ((span K (b '' s)).topologicalClosure)ᗮ
  rw [Submodule.orthogonal_closure, Submodule.mem_orthogonal]
  intro x hx
  refine Submodule.span_induction
    (p := fun y _ => inner K y (b i.1) = 0) ?_ ?_ ?_ ?_ hx
  · rintro _ ⟨j, hj, rfl⟩
    exact b.orthonormal.2 fun hji => i.2 (hji ▸ hj)
  · exact inner_zero_left _
  · intro x y _ _ hx hy
    simp only [inner_add_left, hx, hy, add_zero]
  · intro c x _ hx
    simp only [inner_smul_left, hx, mul_zero]

/-- A remaining basis vector, regarded as a vector in the named residual subspace. -/
def tailVector (b : HilbertBasis I K H) (s : Set I) (i : ↥(sᶜ)) :
    (basisResidual b s).toSubmodule :=
  ⟨b i.1, basis_mem_residual b s i⟩

private lemma tailVector_orthonormal (b : HilbertBasis I K H) (s : Set I) :
    Orthonormal K (tailVector b s) := by
  apply (basisResidual b s).toSubmodule.subtypeₗᵢ.orthonormal_comp_iff.mp
  exact b.orthonormal.comp (fun i : ↥(sᶜ) => i.1) Subtype.val_injective

private lemma tailVector_orthogonal_eq_bot (b : HilbertBasis I K H) (s : Set I) :
    (span K (Set.range (tailVector b s)))ᗮ = ⊥ := by
  rw [Submodule.eq_bot_iff]
  intro x hx
  apply Subtype.ext
  apply b.repr.injective
  ext i
  simp only [b.repr_apply_apply]
  by_cases hi : i ∈ s
  · have hbiPrefix : b i ∈ basisPrefix b s := by
      exact Submodule.le_topologicalClosure _
        (Submodule.subset_span ⟨i, hi, rfl⟩)
    simpa using Submodule.inner_right_of_mem_orthogonal hbiPrefix x.2
  · let hiTail : ↥(sᶜ) := ⟨i, hi⟩
    have hTailMem : tailVector b s hiTail ∈ span K (Set.range (tailVector b s)) :=
      Submodule.subset_span ⟨hiTail, rfl⟩
    have hzero := (Submodule.mem_orthogonal _ x).mp hx _ hTailMem
    simpa [tailVector] using hzero

/-- The original basis restricted to the complement of a stage is a Hilbert basis of its
source-defined residual. -/
def tailBasis [CompleteSpace H] (b : HilbertBasis I K H) (s : Set I) :
    HilbertBasis ↥(sᶜ) K (basisResidual b s).toSubmodule := by
  letI : CompleteSpace (basisResidual b s).toSubmodule := by
    rw [basisResidual, ClosedSubmodule.toSubmodule_orthogonal_eq]
    infer_instance
  exact HilbertBasis.mkOfOrthogonalEqBot (tailVector_orthonormal b s)
    (tailVector_orthogonal_eq_bot b s)

@[simp] theorem tailBasis_apply [CompleteSpace H] (b : HilbertBasis I K H) (s : Set I)
    (i : ↥(sᶜ)) : tailBasis b s i = tailVector b s i := by
  simp [tailBasis]

private lemma basisPrefix_mono (b : HilbertBasis I K H) {s t : Set I} (hst : s ⊆ t) :
    basisPrefix b s ≤ basisPrefix b t := by
  rw [basisPrefix, Submodule.closure_le]
  exact (Submodule.span_mono (Set.image_mono hst)).trans
    (show span K (b '' t) ≤ (span K (b '' t)).closure from
      Submodule.le_topologicalClosure _)

private lemma basisPrefix_iUnion {J : Type u} (b : HilbertBasis I K H) (s : J → Set I) :
    basisPrefix b (⋃ j, s j) = ⨆ j, basisPrefix b (s j) := by
  apply le_antisymm
  · rw [basisPrefix, Submodule.closure_le, Submodule.span_le]
    rintro _ ⟨i, hi, rfl⟩
    rcases Set.mem_iUnion.mp hi with ⟨j, hj⟩
    have hbi : b i ∈ span K (b '' s j) :=
      Submodule.subset_span (show b i ∈ b '' s j from ⟨i, hj, rfl⟩)
    have hbiClosed : b i ∈ basisPrefix b (s j) :=
      Submodule.le_topologicalClosure _ hbi
    exact (le_iSup (fun k => basisPrefix b (s k)) j) hbiClosed
  · apply iSup_le
    intro j
    exact basisPrefix_mono b (Set.subset_iUnion s j)

private lemma basisResidual_iUnion {J : Type u} (b : HilbertBasis I K H) (s : J → Set I) :
    basisResidual b (⋃ j, s j) = ⨅ j, basisResidual b (s j) := by
  simp_rw [basisResidual]
  rw [basisPrefix_iUnion]
  exact (ClosedSubmodule.iInf_orthogonal _).symm

private lemma basisPrefix_union (b : HilbertBasis I K H) (s t : Set I) :
    basisPrefix b (s ∪ t) = basisPrefix b s ⊔ basisPrefix b t := by
  apply le_antisymm
  · rw [basisPrefix, Submodule.closure_le, Submodule.span_le]
    rintro _ ⟨i, hi, rfl⟩
    rcases hi with hi | hi
    · exact (show basisPrefix b s ≤ basisPrefix b s ⊔ basisPrefix b t from
        le_sup_left) (Submodule.le_topologicalClosure _
          (Submodule.subset_span ⟨i, hi, rfl⟩))
    · exact (show basisPrefix b t ≤ basisPrefix b s ⊔ basisPrefix b t from
        le_sup_right) (Submodule.le_topologicalClosure _
          (Submodule.subset_span ⟨i, hi, rfl⟩))
  · apply sup_le
    · exact basisPrefix_mono b Set.subset_union_left
    · exact basisPrefix_mono b Set.subset_union_right

private lemma basisPrefix_singleton_toSubmodule (b : HilbertBasis I K H) (i : I) :
    (basisPrefix b {i}).toSubmodule = K ∙ b i := by
  rw [basisPrefix]
  change (span K (b '' {i})).topologicalClosure = K ∙ b i
  simpa only [Set.image_singleton] using Submodule.topologicalClosure_eq_self (K ∙ b i)

private lemma basisResidual_Iic (b : HilbertBasis I K H) [LinearOrder I] (i : I) :
    (basisResidual b (Set.Iic i)).toSubmodule =
      (K ∙ b i)ᗮ ⊓ (basisResidual b (Set.Iio i)).toSubmodule := by
  have hPrefix : basisPrefix b (Set.Iic i) =
      basisPrefix b (Set.Iio i) ⊔ basisPrefix b {i} := by
    rw [← Set.Iio_union_right]
    exact basisPrefix_union b _ _
  rw [basisResidual, hPrefix]
  change ((basisPrefix b (Set.Iio i) ⊔ basisPrefix b {i})ᗮ).toSubmodule = _
  rw [← ClosedSubmodule.inf_orthogonal]
  simp only [ClosedSubmodule.toSubmodule_inf,
    ClosedSubmodule.toSubmodule_orthogonal_eq, basisResidual]
  rw [basisPrefix_singleton_toSubmodule]
  exact @inf_comm (Submodule K H) _ _ _

private lemma successor_split (b : HilbertBasis I K H) [LinearOrder I] (i : I) :
    (basisResidual b (Set.Iio i)).toSubmodule =
        K ∙ b i ⊔ (basisResidual b (Set.Iic i)).toSubmodule ∧
      K ∙ b i ⟂ (basisResidual b (Set.Iic i)).toSubmodule := by
  have hle : K ∙ b i ≤ (basisResidual b (Set.Iio i)).toSubmodule := by
    rw [Submodule.span_singleton_le_iff_mem]
    exact basis_mem_residual b (Set.Iio i) ⟨i, lt_irrefl i⟩
  have hsplit := Submodule.sup_orthogonal_inf_of_hasOrthogonalProjection hle
  have hnext := basisResidual_Iic b i
  constructor
  · rw [hnext]
    exact hsplit.symm
  · apply (Submodule.isOrtho_orthogonal_right (K ∙ b i)).mono_right
    rw [hnext]
    exact inf_le_left

private lemma limit_stage (b : HilbertBasis I K H) [LinearOrder I] (i : I)
    (hi : Order.IsSuccLimit i) :
    basisPrefix b (Set.Iio i) =
        ⨆ j : ↥(Set.Iio i), basisPrefix b (Set.Iio j.1) ∧
      basisResidual b (Set.Iio i) =
        ⨅ j : ↥(Set.Iio i), basisResidual b (Set.Iio j.1) := by
  have hUnion : (⋃ j : ↥(Set.Iio i), Set.Iio j.1) = Set.Iio i := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_Iio]
    constructor
    · rintro ⟨j, hxj⟩
      exact hxj.trans j.2
    · intro hxi
      rcases (hi.lt_iff_exists_lt).mp hxi with ⟨j, hji, hxj⟩
      exact ⟨⟨j, hji⟩, hxj⟩
  constructor
  · calc
      basisPrefix b (Set.Iio i) =
          basisPrefix b (⋃ j : ↥(Set.Iio i), Set.Iio j.1) :=
        congrArg (basisPrefix b) hUnion.symm
      _ = ⨆ j : ↥(Set.Iio i), basisPrefix b (Set.Iio j.1) :=
        basisPrefix_iUnion b _
  · calc
      basisResidual b (Set.Iio i) =
          basisResidual b (⋃ j : ↥(Set.Iio i), Set.Iio j.1) :=
        congrArg (basisResidual b) hUnion.symm
      _ = ⨅ j : ↥(Set.Iio i), basisResidual b (Set.Iio j.1) :=
        basisResidual_iUnion b _

private lemma terminal_limit_stage (b : HilbertBasis I K H) [LinearOrder I]
    [WellFoundedLT I] [Infinite I] (hInitial : Cardinal.ord (#I) = typeLT I) :
    basisPrefix b Set.univ = ⨆ i : I, basisPrefix b (Set.Iio i) ∧
      basisResidual b Set.univ = ⨅ i : I, basisResidual b (Set.Iio i) := by
  have hPrelimit : Order.IsSuccPrelimit (typeLT I) := by
    rw [← hInitial]
    exact (Cardinal.isSuccLimit_ord (Cardinal.aleph0_le_mk I)).isSuccPrelimit
  letI : NoMaxOrder I :=
    Ordinal.isSuccPrelimit_type_lt_iff.mp hPrelimit
  have hUnion : (⋃ i : I, Set.Iio i) = Set.univ := by
    ext x
    simp only [Set.mem_iUnion, Set.mem_Iio, Set.mem_univ, iff_true]
    exact exists_gt x
  constructor
  · calc
      basisPrefix b Set.univ = basisPrefix b (⋃ i : I, Set.Iio i) :=
        congrArg (basisPrefix b) hUnion.symm
      _ = ⨆ i : I, basisPrefix b (Set.Iio i) := basisPrefix_iUnion b _
  · calc
      basisResidual b Set.univ = basisResidual b (⋃ i : I, Set.Iio i) :=
        congrArg (basisResidual b) hUnion.symm
      _ = ⨅ i : I, basisResidual b (Set.Iio i) := basisResidual_iUnion b _

private lemma basisResidual_univ (b : HilbertBasis I K H) :
    basisResidual b Set.univ = ⊥ := by
  have hPrefix : basisPrefix b Set.univ = ⊤ := by
    rw [eq_top_iff]
    change (⊤ : Submodule K H) ≤ (span K (b '' Set.univ)).topologicalClosure
    simpa only [Set.image_univ] using b.dense_span.ge
  rw [basisResidual, hPrefix, ClosedSubmodule.top_orthogonal_eq_bot]

private lemma reindexed_dense {J : Type u} (b : HilbertBasis I K H) (e : J ≃ I) :
    ⊤ ≤ (span K (Set.range (b ∘ e))).topologicalClosure := by
  have hrange : Set.range (b ∘ e) = Set.range b := by
    ext x
    constructor
    · rintro ⟨j, rfl⟩
      exact ⟨e j, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨e.symm i, by simp⟩
  rw [hrange, b.dense_span]

private def reindexedBasis [CompleteSpace H] {J : Type u}
    (b : HilbertBasis I K H) (e : J ≃ I) : HilbertBasis J K H :=
  HilbertBasis.mk (b.orthonormal.comp e e.injective) (reindexed_dense b e)

@[simp] private lemma reindexedBasis_apply [CompleteSpace H] {J : Type u}
    (b : HilbertBasis I K H) (e : J ≃ I) (j : J) :
    reindexedBasis b e j = b (e j) := by
  simp [reindexedBasis]

/-- The cardinal equality identifies a proper-stage tail with the original initial index type. -/
def properTailEquiv [LinearOrder I] [WellFoundedLT I] [Infinite I]
    (hInitial : Cardinal.ord (#I) = typeLT I) (i : I) : ↥((Set.Iio i)ᶜ) ≃ I :=
  Classical.choice (Cardinal.eq.mp
    (Cardinal.mk_compl_of_infinite (Set.Iio i) (Cardinal.mk_Iio_lt i hInitial)))

/-- The explicit residual-to-ambient Hilbert-space isometry induced by the two indexed bases. -/
def residualEquiv [CompleteSpace H] [LinearOrder I] [WellFoundedLT I] [Infinite I]
    (b : HilbertBasis I K H) (hInitial : Cardinal.ord (#I) = typeLT I) (i : I) :
    (basisResidual b (Set.Iio i)).toSubmodule ≃ₗᵢ[K] H :=
  (tailBasis b (Set.Iio i)).repr.trans
    (reindexedBasis b (properTailEquiv hInitial i)).repr.symm

private lemma residualEquiv_tailVector [CompleteSpace H] [LinearOrder I]
    [WellFoundedLT I] [Infinite I] (b : HilbertBasis I K H)
    (hInitial : Cardinal.ord (#I) = typeLT I) (i : I) (j : ↥((Set.Iio i)ᶜ)) :
    residualEquiv b hInitial i (tailVector b (Set.Iio i) j) =
      b (properTailEquiv hInitial i j) := by
  have htail : tailVector b (Set.Iio i) j = tailBasis b (Set.Iio i) j :=
    (tailBasis_apply b (Set.Iio i) j).symm
  calc
    residualEquiv b hInitial i (tailVector b (Set.Iio i) j) =
        residualEquiv b hInitial i (tailBasis b (Set.Iio i) j) :=
      congrArg (residualEquiv b hInitial i) htail
    _ = b (properTailEquiv hInitial i j) := by
      rw [residualEquiv, LinearIsometryEquiv.trans_apply,
        HilbertBasis.repr_self, HilbertBasis.repr_symm_single,
        reindexedBasis_apply]

/-- An infinite Hilbert basis indexed by an initial well-order constructs a residual tower whose
successors split off one basis line, whose limit stages are closed unions and intersections,
whose every proper residual has the original Hilbert dimension and an explicit isometry to the
ambient space, and whose terminal residual is zero. -/
theorem transfinite_basis_residual_tower [CompleteSpace H] [LinearOrder I]
    [WellFoundedLT I] [Infinite I] (b : HilbertBasis I K H)
    (hInitial : Cardinal.ord (#I) = typeLT I) :
    (∀ i,
      (basisResidual b (Set.Iio i)).toSubmodule =
          K ∙ b i ⊔ (basisResidual b (Set.Iic i)).toSubmodule ∧
        K ∙ b i ⟂ (basisResidual b (Set.Iic i)).toSubmodule) ∧
      ((∀ i, Order.IsSuccLimit i →
        basisPrefix b (Set.Iio i) =
            ⨆ j : ↥(Set.Iio i), basisPrefix b (Set.Iio j.1) ∧
          basisResidual b (Set.Iio i) =
            ⨅ j : ↥(Set.Iio i), basisResidual b (Set.Iio j.1)) ∧
        basisPrefix b Set.univ = ⨆ i : I, basisPrefix b (Set.Iio i) ∧
        basisResidual b Set.univ = ⨅ i : I, basisResidual b (Set.Iio i)) ∧
      (∀ i,
        #(↥((Set.Iio i)ᶜ)) = (#I) ∧
          ∀ j : ↥((Set.Iio i)ᶜ),
            residualEquiv b hInitial i (tailVector b (Set.Iio i) j) =
              b (properTailEquiv hInitial i j)) ∧
      basisResidual b Set.univ = ⊥ := by
  refine ⟨successor_split b, ⟨limit_stage b, terminal_limit_stage b hInitial⟩, ?_,
    basisResidual_univ b⟩
  intro i
  exact ⟨Cardinal.mk_compl_of_infinite (Set.Iio i) (Cardinal.mk_Iio_lt i hInitial),
    residualEquiv_tailVector b hInitial i⟩

/- The hypotheses and all four public clauses are jointly inhabited by the standard
countably indexed real Hilbert space. -/
example :
    let H := lp (fun _ : Nat => Real) 2
    let b : HilbertBasis Nat Real H := default
    Cardinal.ord (#Nat) = typeLT Nat ∧ basisResidual b Set.univ = ⊥ := by
  dsimp
  exact ⟨by simp, basisResidual_univ _⟩

#print axioms transfinite_basis_residual_tower

end D5.S3.Quantum.Completion.TransfiniteBasisResidualTower
