set_option maxRecDepth 12000 in
-- Exact rational replay of the 21-by-21 weighted Gram matrix.
set_option maxHeartbeats 18000000 in
private theorem ldl1 : ldlChecks G1 d1 F1 = true := by decide +kernel

private def orderedTerms : Terms := (balancedWords 12 4).map fun w => (1, w)

private def certificateTerms : Terms := gramTerms G0 [] words0 ++ gramTerms G1 [true] words1

private def gapTerms : Terms :=
  scaleTerms 4 orderedTerms ++ scaleTerms (-455) shiftedTerms

set_option maxRecDepth 30000 in
-- Group all ordered words and Gram terms by their cyclic representatives.
set_option maxHeartbeats 24000000 in
private theorem coefficients124 :
    coefficientsVanish (gapTerms ++ scaleTerms (-1) certificateTerms) = true := by
  simp only [gapTerms, orderedTerms, balancedWords, List.map_cons, List.map_nil,
    List.cons_append, List.nil_append]
  decide +kernel

noncomputable section

variable {n : ℕ}
local notation "Mat" => Matrix (Fin n) (Fin n) ℂ

private def phase (A B : Mat) (i : Bool) : Mat :=
  A ^ (1 + shift i) * B * A ^ (2 - shift i)

private theorem phase_eval (A B : Mat) (i j k l : Bool) :
    realTrace (phase A B i * (phase A B j * (phase A B k * phase A B l))) =
      traceWord A B (shiftedWord i j k l) := by
  simp only [phase, mul_assoc]
  rw [Algebra44.realTrace_mul_comm (A ^ (1 + shift i))]
  unfold traceWord
  apply congrArg realTrace
  simp only [shiftedWord, aGap, evalWord_append43, eval_aRun, evalWord, mul_one, mul_assoc]
  cases i <;> cases j <;> cases k <;> cases l <;>
    norm_num [shift, pow_succ, mul_assoc]

private theorem phase_sum (A B : Mat) :
    weightedSum ℝ (traceWord A B) shiftedTerms =
      16 * realTrace (((1 / 2 : ℝ) • (A ^ 2 * B * A + A * B * A ^ 2)) ^ 4) := by
  have h0 : phase A B false = A * B * A ^ 2 := by simp [phase, shift]
  have h1 : phase A B true = A ^ 2 * B * A := by simp [phase, shift]
  rw [← h1, ← h0, smul_pow, realTrace_smul, Algebra44.realTrace_add_four]
  simp only [shiftedTerms, weightedSum, smul_eq_mul, ← phase_eval]
  simp only [pow_succ, pow_zero, one_mul, mul_assoc]
  norm_num
  ring

/-- The word mean dominates the trace of the fourth power of the shifted Hermitian average. -/
theorem shifted_bound124 (A B : Mat) (hA : A.PosSemidef) (hB : B.IsHermitian) :
    1820 * realTrace (((1 / 2 : ℝ) • (A ^ 2 * B * A + A * B * A ^ 2)) ^ 4) ≤
      ((balancedWords 12 4).map fun w => realTrace (evalWord A B w)).sum := by
  have h := coefficients_sound (traceWord A B) (traceWord_representative A B hA.isHermitian hB)
    _ coefficients124
  simp only [gapTerms, certificateTerms, weightedSum_append, weightedSum_scale, phase_sum,
    eval_gramTerms A B hA.isHermitian hB] at h
  have hwords : weightedSum ℝ (traceWord A B) orderedTerms =
      ((balancedWords 12 4).map fun w => realTrace (evalWord A B w)).sum := by
    simp only [orderedTerms, weightedSum_eq_map, List.map_map, Function.comp_def, Rat.cast_one,
      one_smul, traceWord]
  rw [hwords] at h
  simp only [evalWord, mul_one] at h
  have h0 := weightedGram_nonneg G0 (fun i => evalWord A B (words0 i)) 1 Matrix.PosSemidef.one ldl0
  have h1 := weightedGram_nonneg G1 (fun i => evalWord A B (words1 i)) A hA ldl1
  simp only [smul_add] at h ⊢
  norm_num at h
  linarith only [h, h0, h1]

end
end Algebra124

open private trace_cycle_power from D5.S3.Quantum.Analysis.RefinedBMVTracePower
open private fourthWordTraceSum exponentialLowerOfRoot
  from D5.S3.Quantum.Analysis.RefinedBMV67

noncomputable section

variable {n : ℕ}
local notation "Mat" => Matrix (Fin n) (Fin n) ℂ

/-- The refined BMV product lower bound at bidegree (12,4). -/
theorem product_bound124 (A B : Mat) (hA : A.PosSemidef) (hB : B.IsHermitian) :
    1820 * (trace ((A ^ 3 * B) ^ 4)).re ≤
      ((balancedWords 12 4).map fun w => (trace (evalWord A B w)).re).sum := by
  let C := A * B * A
  have hC : C.IsHermitian := by
    change Cᴴ = C
    simp only [C, conjTranspose_mul, hA.isHermitian.eq, hB.eq, mul_assoc]
  have htrace : trace ((A ^ 3 * B) ^ 4) = trace ((C * A) ^ 4) := by
    calc
      _ = trace ((A ^ 2 * (A * B)) ^ 4) := congrArg trace (by noncomm_ring)
      _ = trace (((A * B) * A ^ 2) ^ 4) := trace_cycle_power _ _ _
      _ = _ := congrArg trace (by dsimp only [C]; noncomm_ring)
  have hpart : C * A + (C * A)ᴴ = A ^ 2 * B * A + A * B * A ^ 2 := by
    rw [conjTranspose_mul, hA.isHermitian.eq, hC.eq]
    dsimp only [C]
    noncomm_ring
  have hcmp := trace_four_le_hermitian_part C A hC hA
  rw [← htrace, hpart] at hcmp
  exact (mul_le_mul_of_nonneg_left hcmp (by norm_num)).trans
    (Algebra124.shifted_bound124 A B hA hB)

/-- The refined exponential lower bound at bidegree (12,4). -/
theorem exponential_bound124 (H K : Mat) (hH : H.IsHermitian) (hK : K.IsHermitian) :
    1820 * (trace (exp ((12 : ℝ) • H + (4 : ℝ) • K))).re ≤
      ((balancedWords 12 4).map fun w => (trace (evalWord (exp H) (exp K) w)).re).sum := by
  simpa only [Nat.cast_ofNat, fourthWordTraceSum] using
    exponentialLowerOfRoot 12 1820 H K hH hK (fun X B hX hB => by
      simpa only [Nat.cast_ofNat, fourthWordTraceSum, ← pow_mul X 4 3] using
        product_bound124 (X ^ 4) B (hX.pow 4) hB.isHermitian)

end
end RefinedBMV
