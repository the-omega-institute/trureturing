    linarith
  have hc : 0 < c := by linarith
  by_cases h₂ : c ≤ 2
  · exact positive_deriv2_of_cover oneTwo ⟨1,2,0,3/32⟩ oneTwo_valid hp₀ hc
      (by simpa [ZeroCenterRectangle.Holds] using And.intro hc₁ (And.intro h₂ (And.intro hh₀ hh₁)))
  exact positive_deriv2_of_cover twoFour ⟨2,4,0,3/32⟩ twoFour_valid hp₀ hc
    (by simpa [ZeroCenterRectangle.Holds] using
      And.intro (le_of_not_ge h₂) (And.intro hc₄ (And.intro hh₀ hh₁)))

