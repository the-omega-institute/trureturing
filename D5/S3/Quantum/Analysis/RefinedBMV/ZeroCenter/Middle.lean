/-- Positive curvature on [1,4], with the same natural-degree bound as the direct compact cover. -/
theorem zeroProfile_deriv2_pos_middle {p : ℕ} (hp : 11 ≤ p) {c : ℝ}
    (hc₁ : 1 ≤ c) (hc₄ : c ≤ 4) : 0 < deriv^[2] (zeroProfile p) c := by
  have hp₀ : 0 < p := by omega
  have hp' : (11 : ℝ) ≤ p := by exact_mod_cast hp
  have hpos : 0 < (p : ℝ) := by linarith
