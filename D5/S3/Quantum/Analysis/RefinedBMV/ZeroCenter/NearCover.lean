/-- Strictly positive curvature on the small-gap interval for every degree at least eleven. -/
theorem zeroProfile_deriv2_pos_small {p : ℕ} (hp : 11 ≤ p) {c : ℝ}
    (hc : 0 < c) (hc₁ : c ≤ 1) : 0 < deriv^[2] (zeroProfile p) c := by
  have hp₀ : 0 < p := by omega
  have hp' : (11 : ℝ) ≤ p := by exact_mod_cast hp
  have hpos : 0 < (p : ℝ) := by linarith
  have hh₀ : 0 ≤ (1 : ℝ)/p := (one_div_pos.mpr hpos).le
  have hh₁ : (1 : ℝ)/p ≤ 3/32 := by
    apply (div_le_iff₀ hpos).2
    linarith
  exact positive_deriv2_of_cover smallCover ⟨0,1,0,3/32⟩ smallCover_valid hp₀ hc
    (by simpa [ZeroCenterRectangle.Holds] using And.intro hc.le (And.intro hc₁ (And.intro hh₀ hh₁)))

#print axioms zeroProfile_deriv2_pos_small

