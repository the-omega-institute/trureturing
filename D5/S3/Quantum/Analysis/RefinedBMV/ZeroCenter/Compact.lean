private def sixteenThirtyTwo : RectangleCover :=
  .splitH (.leaf box16_0) (.leaf box16_1)

set_option maxRecDepth 8000 in
set_option maxHeartbeats 800000 in
private theorem accepted16_0 : leafValid ⟨16, 32, 0, (3/64)⟩ box16_0 := by
  refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_⟩ <;> decide +kernel

set_option maxRecDepth 8000 in
set_option maxHeartbeats 800000 in
private theorem accepted16_1 : leafValid ⟨16, 32, (3/64), (3/32)⟩ box16_1 := by
  refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_⟩ <;> decide +kernel
private theorem sixteenThirtyTwo_valid : sixteenThirtyTwo.Valid ⟨16, 32, 0, 3/32⟩ := by
  simp only [sixteenThirtyTwo, RectangleCover.Valid]
  exact And.intro ((leafValid_transport accepted16_0 (by decide +kernel))) ((leafValid_transport accepted16_1 (by decide +kernel)))

/-- The zero-centered profile has positive curvature on the whole interval `[4, 32]`
for every degree at least eleven. -/
theorem zeroProfile_deriv2_pos_of_four_le {p : ℕ} (hp : 11 ≤ p) {c : ℝ}
    (hc₁ : 4 ≤ c) (hc₂ : c ≤ 32) : 0 < deriv^[2] (zeroProfile p) c := by
  have hp₀ : 0 < p := by omega
  have hp' : (11 : ℝ) ≤ p := by exact_mod_cast hp
  have hpos : 0 < (p : ℝ) := by linarith
  have hh₀ : 0 ≤ (1 : ℝ) / p := (one_div_pos.mpr hpos).le
  have hh₁ : (1 : ℝ) / p ≤ 3/32 := by
    apply (div_le_iff₀ hpos).2
    linarith
  have hc : 0 < c := by linarith
  by_cases h₈ : c ≤ 8
  · exact positive_deriv2_of_cover fourEight ⟨4, 8, 0, 3/32⟩ fourEight_valid hp₀ hc
      (by simpa [ZeroCenterRectangle.Holds] using And.intro hc₁ (And.intro h₈ (And.intro hh₀ hh₁)))
  by_cases h₁₆ : c ≤ 16
  · exact positive_deriv2_of_cover eightSixteen ⟨8, 16, 0, 3/32⟩ eightSixteen_valid hp₀ hc
      (by simpa [ZeroCenterRectangle.Holds] using And.intro (le_of_not_ge h₈) (And.intro h₁₆ (And.intro hh₀ hh₁)))
  exact positive_deriv2_of_cover sixteenThirtyTwo ⟨16, 32, 0, 3/32⟩ sixteenThirtyTwo_valid hp₀ hc
    (by simpa [ZeroCenterRectangle.Holds] using And.intro (le_of_not_ge h₁₆) (And.intro hc₂ (And.intro hh₀ hh₁)))

#print axioms zeroProfile_deriv2_pos_of_four_le

