private def shiftedWord (i j k l : Bool) : Word :=
  [false] ++ aGap (4 + shift j - shift i) ++ aGap (4 + shift k - shift j) ++
    aGap (4 + shift l - shift k) ++ aRun (4 + shift i - shift l)

private def shiftedTerms : Terms :=
  [(1, shiftedWord false false false false), (1, shiftedWord true true true true),
    (4, shiftedWord false false false true), (4, shiftedWord true true true false),
    (4, shiftedWord true true false false), (2, shiftedWord true false true false)]

private def rowCheck {k r : ℕ} (G : Matrix (Fin k) (Fin k) ℚ)
    (d : Fin r → ℚ) (F : Matrix (Fin k) (Fin r) ℚ) (i : Fin k) : Bool :=
  (List.finRange k).all fun j =>
    decide (G i j = ((List.finRange r).map fun t => d t * (F i t * F j t)).sum)

private theorem ldlOfRows {k r : ℕ} (G : Matrix (Fin k) (Fin k) ℚ)
    (d : Fin r → ℚ) (F : Matrix (Fin k) (Fin r) ℚ)
    (hd : (List.finRange r).all (fun t => decide (0 ≤ d t)) = true)
    (hrows : ∀ i, rowCheck G d F i = true) : ldlChecks G d F = true := by
  rw [ldlChecks, Bool.and_eq_true]
  exact ⟨hd, List.all_eq_true.mpr fun i _ => hrows i⟩

