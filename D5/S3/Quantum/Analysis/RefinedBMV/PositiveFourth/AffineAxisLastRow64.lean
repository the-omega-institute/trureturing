private theorem exactRowWeights : shiftRow certificate 2158 64 = rowWeights := by
  decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 5000000 in
private theorem exactRowSweep : shiftSweep 2158 (masked (polynomialMask 2157 251))
    certificate.rootsV.length (rowWeights.map Prod.snd).sum rowWeights = true := by
  decide +kernel

set_option maxRecDepth 30000 in
theorem checkedPackedRow64 : certificate.checkShiftRow 2157 251 64 = true := by
  simpa only [Certificate.checkShiftRow, show 2157 + 1 = 2158 by decide,
    exactRowWeights] using exactRowSweep

