open private fourth_trace_le_gram_square fourthWordTraceSum fourthRoot_rpow fourthRoot_four
  exponentialLowerOfRoot from D5.S3.Quantum.Analysis.RefinedBMV67
open private re_trace_sq_le_gram44 from D5.S3.Quantum.Analysis.RefinedBMV44
open private trace_cycle_power from D5.S3.Quantum.Analysis.RefinedBMVTracePower

noncomputable section

variable {n : ℕ}
local notation "Mat" => Matrix (Fin n) (Fin n) ℂ

private theorem balanced114_of_root (X B : Mat) (hX : X.IsHermitian) (hB : B.IsHermitian) :
    (trace ((X ^ 11 * B) ^ 4)).re ≤
      (trace ((X ^ 12 * B) ^ 2 * (X ^ 8 * B) * (X ^ 12 * B))).re := by
  let M := X ^ 6 * B * X ^ 5
  let Q := X ^ 4 * B * X ^ 12 * B * X ^ 6
  have ht : trace ((X ^ 11 * B) ^ 4) = trace (M ^ 4) := by
    calc
      _ = trace ((X ^ 5 * (X ^ 6 * B)) ^ 4) := congrArg trace (by noncomm_ring)
      _ = _ := trace_cycle_power _ _ _
  have hg : trace ((Mᴴ * M) ^ 2) = trace (Q ^ 2) := by
    simp only [M, Q, conjTranspose_mul, conjTranspose_pow, hX.eq, hB.eq]
    calc
      _ = trace ((X * (X ^ 4 * B * X ^ 12 * B * X ^ 5)) ^ 2) :=
        congrArg trace (by noncomm_ring)
      _ = trace (((X ^ 4 * B * X ^ 12 * B * X ^ 5) * X) ^ 2) :=
        trace_cycle_power _ _ _
      _ = _ := congrArg trace (by noncomm_ring)
  have hq : trace (Qᴴ * Q) = trace ((X ^ 12 * B) ^ 2 * (X ^ 8 * B) * (X ^ 12 * B)) := by
    simp only [Q, conjTranspose_mul, conjTranspose_pow, hX.eq, hB.eq]
    calc
      _ = trace ((X ^ 6 * B * X ^ 12 * B * X ^ 8 * B * X ^ 12 * B) * X ^ 6) :=
        congrArg trace (by noncomm_ring)
      _ = trace (X ^ 6 * (X ^ 6 * B * X ^ 12 * B * X ^ 8 * B * X ^ 12 * B)) :=
        trace_mul_comm _ _
      _ = _ := congrArg trace (by noncomm_ring)
  have h := fourth_trace_le_gram_square M
  rw [trace_cycle_power M Mᴴ 2, hg] at h
  rw [ht, ← hq]
  exact h.trans (re_trace_sq_le_gram44 Q)

private theorem bound114_root (X B : Mat) (hX : X.PosSemidef) (hB : B.IsHermitian) :
    1365 * (trace ((X ^ 11 * B) ^ 4)).re ≤ fourthWordTraceSum 11 (X ^ 4) B := by
  have h := balanced114_of_root X B hX.isHermitian hB
  have hg := WeightedGram67.balanced_bound114 (X ^ 4) B (hX.pow 4) hB
  rw [← pow_mul X 4 3, ← pow_mul X 4 2] at hg
  exact (mul_le_mul_of_nonneg_left h (by norm_num)).trans hg

/-- The product lower bound at (11,4) in every finite complex dimension. -/
theorem product_bound114 (A B : Mat) (hA : A.PosSemidef) (hB : B.IsHermitian) :
    1365 * (trace (((A ^ (11 / 4 : ℝ)) * B) ^ 4)).re ≤
      ((balancedWords 11 4).map fun w => (trace (evalWord A B w)).re).sum := by
  have hX : 0 ≤ A ^ (1 / 4 : ℝ) := CFC.rpow_nonneg
  simpa only [fourthRoot_four A hA, fourthRoot_rpow A hA, Nat.cast_ofNat, fourthWordTraceSum]
    using bound114_root (A ^ (1 / 4 : ℝ)) B hX.posSemidef hB

/-- The exponential lower bound at (11,4) in every finite complex dimension. -/
theorem exponential_bound114 (H K : Mat) (hH : H.IsHermitian) (hK : K.IsHermitian) :
    1365 * (trace (exp ((11 : ℝ) • H + (4 : ℝ) • K))).re ≤
      ((balancedWords 11 4).map fun w => (trace (evalWord (exp H) (exp K) w)).re).sum := by
  simpa only [Nat.cast_ofNat, fourthWordTraceSum] using
    exponentialLowerOfRoot 11 1365 H K hH hK
      (fun X B hX hB => bound114_root X B hX hB.isHermitian)

end

