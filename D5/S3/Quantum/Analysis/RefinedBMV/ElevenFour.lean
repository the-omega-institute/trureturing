      (scaleTerms 900 (gapTerms 11 91 comparator114) ++
        scaleTerms (-1) (gramTerms G114 [𝔞] [] features114)) = true := by
  simp only [gapTerms, balancedWords, List.map_cons, List.map_nil, List.cons_append, List.nil_append]
  decide +kernel

