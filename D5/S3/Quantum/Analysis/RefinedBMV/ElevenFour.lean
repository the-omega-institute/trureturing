variable {n : ℕ}
local notation "Mat" => Matrix (Fin n) (Fin n) ℂ

private theorem comparator114_eval (A B : Mat) :
    traceWord A B comparator114 = trace ((A ^ 3 * B) ^ 2 * (A ^ 2 * B) * (A ^ 3 * B)) := by
  simp only [traceWord, comparator114, evalWord, pow_succ, pow_zero, one_mul, mul_one, mul_assoc]

private theorem trace_gap114 (A B : Mat) (hA : A.IsHermitian) (hB : B.IsHermitian) :
    ((900 : ℚ) : ℂ) * (((1 / 15 : ℚ) : ℂ) * orderedTraceSum A B 11 -
      ((91 : ℚ) : ℂ) * trace ((A ^ 3 * B) ^ 2 * (A ^ 2 * B) * (A ^ 3 * B))) =
      weightedGram G114 (fun i => weightedSum (evalWord A B) (features114 i)) A 1 := by
  have h := coefficients_sound (traceWord A B) (traceWord_cyclicRep A B) _ coefficients114
  apply eq_of_sub_eq_zero
  simp only [weightedSum_append, weightedSum_scale, eval_gapTerms,
    eval_gramTerms A B hA hB, comparator114_eval, Rat.cast_neg, Rat.cast_one, neg_one_mul,
    evalWord, mul_one, sub_eq_add_neg] at h ⊢
  norm_num at h ⊢
  exact h

private theorem balanced_bound114 (A B : Mat) (hA : A.PosSemidef) (hB : B.IsHermitian) :
    1365 * (trace ((A ^ 3 * B) ^ 2 * (A ^ 2 * B) * (A ^ 3 * B))).re ≤
      ((balancedWords 11 4).map fun w => (trace (evalWord A B w)).re).sum := by
  obtain ⟨hd, hG⟩ := Algebra84.ldlChecks_sound ldl114
  have hgram := weightedGram_nonneg_of_ldl G114
    (fun i => weightedSum (evalWord A B) (features114 i)) A 1
    hA Matrix.PosSemidef.one d114 F114 hd hG
  have h := congrArg Complex.re (trace_gap114 A B hA.isHermitian hB)
  simp only [Complex.sub_re, real_rat_mul, orderedTraceSum_re] at h
  norm_num at h
  linarith only [h, hgram]

end

