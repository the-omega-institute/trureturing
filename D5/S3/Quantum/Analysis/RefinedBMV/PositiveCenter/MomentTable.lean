def stagedNumerators (a b : ℕ) : List ℤ :=
  (numeratorTable.getD a #[]).getD b []

private def checkNumeratorRow (a : ℕ) : Bool :=
  (List.range (13-a)).all fun b ↦
    if 2 ≤ a+b ∧ (a = 0 ∨ 2 ≤ a) then
      decide (stagedNumerators a b = certifiedMomentNumerators a b)
    else true

set_option maxHeartbeats 0 in
set_option maxRecDepth 30000 in
set_option cbv.maxSteps 5000000 in
private theorem numeratorRows_checked (a : Fin 13) : checkNumeratorRow a.val = true := by
  fin_cases a <;> decide_cbv

theorem stagedNumerators_eq {a b : ℕ}
    (hcut : a+b ≤ 12) (hab : 2 ≤ a+b) (ha : a = 0 ∨ 2 ≤ a) :
    stagedNumerators a b = certifiedMomentNumerators a b := by
  have hb : b < 13-a := by omega
  have he := List.all_eq_true.mp (numeratorRows_checked ⟨a, by omega⟩) b
    (List.mem_range.mpr hb)
  simpa [hab, ha] using he

#print axioms stagedNumerators_eq

