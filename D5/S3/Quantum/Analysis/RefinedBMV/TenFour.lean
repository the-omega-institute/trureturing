private theorem trace_gap104 (A B : Mat) (hA : A.IsHermitian) (hB : B.IsHermitian) :
    ((10080 : ℚ) : ℂ) * (((1 / 14 : ℚ) : ℂ) * orderedTraceSum A B 10 -
