  norm_num at checked ⊢
  simpa only [add_assoc] using checked

/-- The balanced comparator bounds the ordered-word sum for positive semidefinite A and B.
The block with B on both sides uses positivity of B. -/
theorem balanced_bound104 (A B : Mat) (hA : A.PosSemidef) (hB : B.PosSemidef) :
    1001 * (trace ((A ^ 3 * B * A ^ 2 * B) ^ 2)).re ≤
      ((balancedWords 10 4).map fun w => (trace (evalWord A B w)).re).sum := by
  obtain ⟨hd₀, hG₀⟩ := Algebra84.ldlChecks_sound ldl104₀
  obtain ⟨hd₁, hG₁⟩ := Algebra84.ldlChecks_sound ldl104₁
  obtain ⟨hd₂, hG₂⟩ := Algebra84.ldlChecks_sound ldl104₂
  have h₀ := weightedGram_nonneg_of_ldl G104₀
    (fun i => weightedSum (evalWord A B) (singleton104 words104₀ i)) 1 1
    Matrix.PosSemidef.one Matrix.PosSemidef.one d104₀ F104₀ hd₀ hG₀
  have h₁ := weightedGram_nonneg_of_ldl G104₁
    (fun i => weightedSum (evalWord A B) (singleton104 words104₁ i)) A A
    hA hA d104₁ F104₁ hd₁ hG₁
  have h₂ := weightedGram_nonneg_of_ldl G104₂
    (fun i => weightedSum (evalWord A B) (singleton104 words104₂ i)) B B
    hB hB d104₂ F104₂ hd₂ hG₂
  have h := congrArg Complex.re (trace_gap104 A B hA.isHermitian hB.isHermitian)
  simp only [Complex.sub_re, Complex.add_re, real_rat_mul, orderedTraceSum_re] at h
  norm_num at h
  linarith only [h, h₀, h₁, h₂]

end

