variable {n : ℕ}
local notation "Mat" => Matrix (Fin n) (Fin n) ℂ

/-- The quartic trace comparison for Hermitian X and B. -/
theorem balanced104_of_root (X B : Mat) (hX : X.IsHermitian) (hB : B.IsHermitian) :
    (trace ((X ^ 10 * B) ^ 4)).re ≤
      (trace ((X ^ 12 * B * X ^ 8 * B) ^ 2)).re := by
  let M := X ^ 4 * B * X ^ 6
  have ht : trace ((X ^ 10 * B) ^ 4) = trace (M ^ 4) := by
    calc
      _ = trace ((X ^ 6 * (X ^ 4 * B)) ^ 4) := congrArg trace (by noncomm_ring)
      _ = _ := trace_cycle_power _ _ _
  have hg : trace ((Mᴴ * M) ^ 2) = trace ((X ^ 12 * B * X ^ 8 * B) ^ 2) := by
    simp only [M, conjTranspose_mul, conjTranspose_pow, hX.eq, hB.eq]
    calc
      _ = trace (((X ^ 6 * B * X ^ 8 * B) * X ^ 6) ^ 2) := congrArg trace (by noncomm_ring)
      _ = trace ((X ^ 6 * (X ^ 6 * B * X ^ 8 * B)) ^ 2) := trace_cycle_power _ _ _
      _ = _ := congrArg trace (by noncomm_ring)
  have h := fourth_trace_le_gram_square M
  rw [trace_cycle_power M Mᴴ 2, hg] at h
  rwa [ht]

private theorem bound104_root (X B : Mat) (hX : X.PosSemidef) (hB : B.PosSemidef) :
    1001 * (trace ((X ^ 10 * B) ^ 4)).re ≤ fourthWordTraceSum 10 (X ^ 4) B := by
  have h := balanced104_of_root X B hX.isHermitian hB.isHermitian
  have hg := WeightedGram67.balanced_bound104 (X ^ 4) B (hX.pow 4) hB
  rw [← pow_mul X 4 3, ← pow_mul X 4 2] at hg
  exact (mul_le_mul_of_nonneg_left h (by norm_num)).trans hg

/-- Hägele's refined product lower bound with ten copies of A and four copies of B. -/
theorem product_bound104 (A B : Mat) (hA : A.PosSemidef) (hB : B.PosSemidef) :
    1001 * (trace (((A ^ (10 / 4 : ℝ)) * B) ^ 4)).re ≤
      ((balancedWords 10 4).map fun w => (trace (evalWord A B w)).re).sum := by
  have hX : 0 ≤ A ^ (1 / 4 : ℝ) := CFC.rpow_nonneg
  simpa only [fourthRoot_four A hA, fourthRoot_rpow A hA, Nat.cast_ofNat, fourthWordTraceSum]
    using bound104_root (A ^ (1 / 4 : ℝ)) B hX.posSemidef hB

/-- The refined exponential lower bound at bidegree (10,4). -/
theorem exponential_bound104 (H K : Mat) (hH : H.IsHermitian) (hK : K.IsHermitian) :
    1001 * (trace (exp ((10 : ℝ) • H + (4 : ℝ) • K))).re ≤
      ((balancedWords 10 4).map fun w => (trace (evalWord (exp H) (exp K) w)).re).sum := by
  simpa only [Nat.cast_ofNat, fourthWordTraceSum] using
    exponentialLowerOfRoot 10 1001 H K hH hK bound104_root

end


