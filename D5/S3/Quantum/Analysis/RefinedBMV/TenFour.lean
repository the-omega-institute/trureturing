      weightedGram G104₂ (fun i => weightedSum (evalWord A B) (singleton104 words104₂ i)) B B := by
  have checked := coefficients_sound (traceWord A B) (traceWord_cyclicRep A B) _ coefficients104
  apply eq_of_sub_eq_zero
  simp only [certificate104, weightedSum_append, weightedSum_scale, eval_gapTerms,
    eval_gramTerms A B hA hB, comparator104_eval, smul_eq_mul, Rat.cast_neg, Rat.cast_one,
