    | left i => simpa only [d, Fin.addCases_left] using hd i
    | right i => simp only [d, Fin.addCases_right, le_refl]
  have hG' (i j : Fin 28) : G134 i j = ∑ t, d t * (F i t * F j t) := by
    rw [Fin.sum_univ_add]
    simpa only [d, F, Fin.addCases_left, Fin.addCases_right, zero_mul, Finset.sum_const_zero,
      add_zero] using hG i j
  have hgram := weightedGram_nonneg_of_ldl G134
    (fun i => weightedSum (evalWord A B) (features134 i)) A 1
    hA Matrix.PosSemidef.one d F hd' hG'
  have h := congrArg Complex.re (trace_gap134 A B hA.isHermitian hB)
  simp only [Complex.sub_re, real_rat_mul, orderedTraceSum_re] at h
  norm_num at h
  linarith only [h, hgram]

end

end WeightedGram67

open private fourth_trace_le_gram_square fourthWordTraceSum fourthRoot_rpow fourthRoot_four
  exponentialLowerOfRoot from D5.S3.Quantum.Analysis.RefinedBMV67
open private re_trace_sq_le_gram44 from D5.S3.Quantum.Analysis.RefinedBMV44
open private trace_cycle_power from D5.S3.Quantum.Analysis.RefinedBMVTracePower

noncomputable section

variable {n : ℕ}
local notation "Mat" => Matrix (Fin n) (Fin n) ℂ

set_option maxHeartbeats 1000000 in
private theorem balanced134_of_root (X B : Mat) (hX : X.IsHermitian) (hB : B.IsHermitian) :
    (trace ((X ^ 13 * B) ^ 4)).re ≤ (trace ((X ^ 16 * B) * (X ^ 12 * B) ^ 3)).re := by
  let M := X ^ 6 * B * X ^ 7
  let Q := X ^ 6 * B * X ^ 12 * B * X ^ 8
  have ht : trace ((X ^ 13 * B) ^ 4) = trace (M ^ 4) := by
    calc
      _ = trace ((X ^ 7 * (X ^ 6 * B)) ^ 4) := congrArg trace (by noncomm_ring)
      _ = _ := trace_cycle_power _ _ _
  have hg : trace ((Mᴴ * M) ^ 2) = trace (Q ^ 2) := by
    simp only [M, Q, conjTranspose_mul, conjTranspose_pow, hX.eq, hB.eq]
    calc
      _ = trace ((X * (X ^ 6 * B * X ^ 12 * B * X ^ 7)) ^ 2) :=
        congrArg trace (by noncomm_ring)
      _ = trace (((X ^ 6 * B * X ^ 12 * B * X ^ 7) * X) ^ 2) :=
        trace_cycle_power _ _ _
      _ = _ := congrArg trace (by noncomm_ring)
  have hq : trace (Qᴴ * Q) = trace ((X ^ 16 * B) * (X ^ 12 * B) ^ 3) := by
    simp only [Q, conjTranspose_mul, conjTranspose_pow, hX.eq, hB.eq]
    calc
      _ = trace ((X ^ 8 * B * X ^ 12 * B * X ^ 12 * B * X ^ 12 * B) * X ^ 8) :=
        congrArg trace (by noncomm_ring)
      _ = trace (X ^ 8 * (X ^ 8 * B * X ^ 12 * B * X ^ 12 * B * X ^ 12 * B)) :=
        trace_mul_comm _ _
      _ = _ := congrArg trace (by noncomm_ring)
  have h := fourth_trace_le_gram_square M
  rw [trace_cycle_power M Mᴴ 2, hg] at h
  rw [ht, ← hq]
  exact h.trans (re_trace_sq_le_gram44 Q)

private theorem bound134_root (X B : Mat) (hX : X.PosSemidef) (hB : B.IsHermitian) :
    2380 * (trace ((X ^ 13 * B) ^ 4)).re ≤ fourthWordTraceSum 13 (X ^ 4) B := by
  have h := balanced134_of_root X B hX.isHermitian hB
  have hg := WeightedGram67.balanced_bound134 (X ^ 4) B (hX.pow 4) hB
  rw [← pow_mul X 4 3, ← pow_mul X 4 4] at hg
  exact (mul_le_mul_of_nonneg_left h (by norm_num)).trans hg

/-- The product lower bound at (13,4) in every finite complex dimension. -/
theorem product_bound134 (A B : Mat) (hA : A.PosSemidef) (hB : B.IsHermitian) :
    2380 * (trace (((A ^ (13 / 4 : ℝ)) * B) ^ 4)).re ≤
      ((balancedWords 13 4).map fun w => (trace (evalWord A B w)).re).sum := by
  have hX : 0 ≤ A ^ (1 / 4 : ℝ) := CFC.rpow_nonneg
  simpa only [fourthRoot_four A hA, fourthRoot_rpow A hA, Nat.cast_ofNat, fourthWordTraceSum]
    using bound134_root (A ^ (1 / 4 : ℝ)) B hX.posSemidef hB

/-- The exponential lower bound at (13,4) in every finite complex dimension. -/
theorem exponential_bound134 (H K : Mat) (hH : H.IsHermitian) (hK : K.IsHermitian) :
    2380 * (trace (exp ((13 : ℝ) • H + (4 : ℝ) • K))).re ≤
      ((balancedWords 13 4).map fun w => (trace (evalWord (exp H) (exp K) w)).re).sum := by
  simpa only [Nat.cast_ofNat, fourthWordTraceSum] using
    exponentialLowerOfRoot 13 2380 H K hH hK
      (fun X B hX hB => bound134_root X B hX hB.isHermitian)

end

end RefinedBMV
