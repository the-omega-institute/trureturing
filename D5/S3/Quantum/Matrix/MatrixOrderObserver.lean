import D5.S3.Quantum.Fibers.FutureStatisticsEquivalence
import D5.S3.Quantum.FiniteDimensional

/- Library-search audit trail (2026-09-01):
   * Repository search found the exact family primitives `DensityState`,
     `MatrixOperatorSystem`, `MatrixAlgebra`, and `heisenbergOnHermitian`; they
     are imported and reused rather than redefined.
   * The adjacent `PhysicalFiber` formalizes the next finite-dimensional fiber
     proposition, while the source's observation-equivalence and physical-fiber
     definitions remain residual-open. No repository declaration packages all
     components of the present matrix-order observer.
   * Pinned Mathlib and all pinned Lean packages contain no packaged complex
     operator-system structure. The existing real Hermitian carrier is therefore
     complexified explicitly below.
   * The repository theorem `qubit_weyl_star` supplies the standard Pauli X and
     Z matrices and their self-adjointness; the two unequal product entries are
     also calculated directly below.
-/

noncomputable section

open scoped CStarAlgebra ComplexOrder MatrixOrder

namespace D5.S3.Quantum.Matrix.MatrixOrderObserver

open D5.S3.Quantum.Divergence.QuantumRelativeEntropyDefectComposition
open D5.S3.Quantum.Fibers.OperatorSystemTowerStability
open D5.S3.Quantum.FiniteDimensional

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-- The canonical positive cone after adjoining an `n`-dimensional auxiliary index. -/
def amplifiedPositiveCone
    (d : Type*) [Fintype d] [DecidableEq d] (n : Nat) :
    Set (MatrixAlgebra (Fin n × d)) :=
  Set.Ici 0

/-- A completely positive instrument branch that does not increase the trace of positive input. -/
structure InstrumentBranch (d : Type*) [Fintype d] [DecidableEq d] where
  operation : MatrixAlgebra d →CP MatrixAlgebra d
  trace_nonincreasing : ∀ rho : MatrixAlgebra d, 0 ≤ rho →
    (Matrix.trace (operation rho)).re ≤ (Matrix.trace rho).re

/-- The result, path, and environment-copy records named by the observer ledger. -/
structure ObserverLedger (Outcome Path Environment : Type*) where
  outcomes : List Outcome
  paths : List Path
  environmentCopies : List Environment

/-- The source's finite matrix-order observer data. The ambient matrix algebra supplies its
matrix positive cones and identity order unit. Undefined record and self-evaluation carriers are
kept as explicit type parameters rather than assigned extra laws. -/
structure ObserverData
    (d : Type*) [Fintype d] [DecidableEq d]
    (Outcome Path Environment Address Rule Evaluation : Type*) where
  state : DensityState d
  visibleSystem : MatrixOperatorSystem d
  coarseGraining : MatrixAlgebra d →CP MatrixAlgebra d
  coarseGraining_visible : ∀ effect : selfAdjoint (MatrixAlgebra d),
    heisenbergOnHermitian coarseGraining effect ∈ visibleSystem.carrier
  instrument : Outcome → InstrumentBranch d
  dynamics : MatrixAlgebra d → MatrixAlgebra d
  ledger : ObserverLedger Outcome Path Environment
  selfAddress : Address
  observationRule : Rule
  evaluate : Address → Rule → Evaluation
  sameAddressEvaluation : Evaluation
  sameAddressEvaluation_eq :
    sameAddressEvaluation = evaluate selfAddress observationRule

/-- The complex operator system generated by the real Hermitian carrier. Every complex
combination has a real and an imaginary Hermitian component in that carrier. -/
def VisibleOperator {d : Type*} [Fintype d] [DecidableEq d]
    (system : MatrixOperatorSystem d) (operator : MatrixAlgebra d) : Prop :=
  ∃ realPart imaginaryPart : selfAdjoint (MatrixAlgebra d),
    realPart ∈ system.carrier ∧ imaginaryPart ∈ system.carrier ∧
      operator = realPart.1 + Complex.I • imaginaryPart.1

/-- Multiplication closure is the visibility of every product of visible effects. -/
def MultiplicativelyClosed {d : Type*} [Fintype d] [DecidableEq d]
    (system : MatrixOperatorSystem d) : Prop :=
  ∀ left right : MatrixAlgebra d,
    VisibleOperator system left → VisibleOperator system right →
      VisibleOperator system (left * right)

private def identityCP (d : Type*) [Fintype d] [DecidableEq d] :
    MatrixAlgebra d →CP MatrixAlgebra d :=
  ((StarAlgHom.id ℂ (MatrixAlgebra d) :
    MatrixAlgebra d →⋆ₐ[ℂ] MatrixAlgebra d) :
    MatrixAlgebra d →CP MatrixAlgebra d)

/-- The zero branch is a completely positive coarse-graining whose range lies in every
operator system. It is used only to inhabit the source's coarse-graining field. -/
private def zeroCP (d : Type*) [Fintype d] [DecidableEq d] :
    MatrixAlgebra d →CP MatrixAlgebra d where
  toLinearMap := 0
  map_cstarMatrix_nonneg' := by
    intro k matrix _matrix_nonnegative
    change 0 ≤ (0 : CStarMatrix (Fin k) (Fin k) (MatrixAlgebra d))
    exact le_rfl

private def identityInstrument (d : Type*) [Fintype d] [DecidableEq d] :
    InstrumentBranch d where
  operation := identityCP d
  trace_nonincreasing := by
    intro rho _rho_nonnegative
    exact le_rfl

private def qubitState : DensityState (Fin 2) := by
  let rho : MatrixAlgebra (Fin 2) :=
    CStarMatrix.ofMatrix !![(1 : ℂ), 0; 0, 0]
  refine ⟨rho, ?_, ?_⟩
  · have rho_nonnegative : 0 ≤ star rho * rho := star_mul_self_nonneg rho
    have rho_projection : star rho * rho = rho := by
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [rho, Matrix.mul_apply, Fin.sum_univ_two]
    rwa [rho_projection] at rho_nonnegative
  · change Matrix.trace (!![(1 : ℂ), 0; 0, 0]) = 1
    simp [Matrix.trace, Fin.sum_univ_two]

private def pauliX : MatrixAlgebra (Fin 2) :=
  CStarMatrix.ofMatrix qubitX

private def pauliZ : MatrixAlgebra (Fin 2) :=
  CStarMatrix.ofMatrix qubitZ

private theorem pauliX_selfAdjoint : IsSelfAdjoint pauliX := by
  have mapped := congrArg
    (CStarMatrix.ofMatrixStarAlgEquiv :
      Matrix (Fin 2) (Fin 2) ℂ → CStarMatrix (Fin 2) (Fin 2) ℂ)
    qubit_weyl_star.2.1
  simpa [pauliX, CStarMatrix.ofMatrix_eq_ofMatrixStarAlgEquiv] using mapped

private theorem pauliZ_selfAdjoint : IsSelfAdjoint pauliZ := by
  have mapped := congrArg
    (CStarMatrix.ofMatrixStarAlgEquiv :
      Matrix (Fin 2) (Fin 2) ℂ → CStarMatrix (Fin 2) (Fin 2) ℂ)
    qubit_weyl_star.2.2.1
  simpa [pauliZ, CStarMatrix.ofMatrix_eq_ofMatrixStarAlgEquiv] using mapped

private theorem pauliX_pauliZ_entries :
    (pauliX * pauliZ) 0 1 = -1 ∧ (pauliX * pauliZ) 1 0 = 1 := by
  change
    ((CStarMatrix.ofMatrixStarAlgEquiv qubitX) *
        CStarMatrix.ofMatrixStarAlgEquiv qubitZ) 0 1 = -1 ∧
      ((CStarMatrix.ofMatrixStarAlgEquiv qubitX) *
        CStarMatrix.ofMatrixStarAlgEquiv qubitZ) 1 0 = 1
  rw [← map_mul, ← map_mul]
  norm_num [qubitX, qubitZ, Matrix.mul_apply, Fin.sum_univ_two]

private theorem pauliX_square : pauliX * pauliX = 1 := by
  have mapped := congrArg
    (CStarMatrix.ofMatrixStarAlgEquiv :
      Matrix (Fin 2) (Fin 2) ℂ → CStarMatrix (Fin 2) (Fin 2) ℂ)
    qubit_weyl_star.2.2.2.1
  simpa [pauliX, CStarMatrix.ofMatrix_eq_ofMatrixStarAlgEquiv, pow_two] using mapped

/-- The Hermitian part of `span_C {I, X, Z}` is characterized by equal off-diagonal entries. -/
private def qubitHermitianCarrier :
    Submodule ℝ (selfAdjoint (MatrixAlgebra (Fin 2))) where
  carrier := { matrix | matrix.1 0 1 = matrix.1 1 0 }
  zero_mem' := by simp
  add_mem' := by
    intro left right left_equal right_equal
    change left.1 0 1 + right.1 0 1 = left.1 1 0 + right.1 1 0
    rw [left_equal, right_equal]
  smul_mem' := by
    intro scalar matrix equal
    change (scalar : ℂ) * matrix.1 0 1 = (scalar : ℂ) * matrix.1 1 0
    rw [equal]

private def qubitQuestionSystem : MatrixOperatorSystem (Fin 2) where
  carrier := qubitHermitianCarrier
  one_mem := by
    change (1 : MatrixAlgebra (Fin 2)) 0 1 = (1 : MatrixAlgebra (Fin 2)) 1 0
    simp

private theorem pauliX_mem_qubitCarrier :
    (⟨pauliX, pauliX_selfAdjoint⟩ : selfAdjoint (MatrixAlgebra (Fin 2))) ∈
      qubitQuestionSystem.carrier := by
  change pauliX 0 1 = pauliX 1 0
  norm_num [pauliX, qubitX]

private theorem pauliZ_mem_qubitCarrier :
    (⟨pauliZ, pauliZ_selfAdjoint⟩ : selfAdjoint (MatrixAlgebra (Fin 2))) ∈
      qubitQuestionSystem.carrier := by
  change pauliZ 0 1 = pauliZ 1 0
  norm_num [pauliZ, qubitZ]

private theorem visibleOperator_offDiagonal_eq
    {operator : MatrixAlgebra (Fin 2)}
    (visible : VisibleOperator qubitQuestionSystem operator) :
    operator 0 1 = operator 1 0 := by
  obtain ⟨realPart, imaginaryPart, real_visible, imaginary_visible, operator_eq⟩ := visible
  rw [operator_eq]
  change
    realPart.1 0 1 + Complex.I * imaginaryPart.1 0 1 =
      realPart.1 1 0 + Complex.I * imaginaryPart.1 1 0
  change realPart.1 0 1 = realPart.1 1 0 at real_visible
  change imaginaryPart.1 0 1 = imaginaryPart.1 1 0 at imaginary_visible
  rw [real_visible, imaginary_visible]

private def qubitObserver :
    ObserverData (Fin 2) Unit Unit Unit Unit Unit Unit where
  state := qubitState
  visibleSystem := qubitQuestionSystem
  coarseGraining := zeroCP (Fin 2)
  coarseGraining_visible := by
    intro effect
    change (zeroCP (Fin 2) effect.1) 0 1 = (zeroCP (Fin 2) effect.1) 1 0
    rfl
  instrument := fun _ => identityInstrument (Fin 2)
  dynamics := id
  ledger := { outcomes := [], paths := [], environmentCopies := [] }
  selfAddress := ()
  observationRule := ()
  evaluate := fun _ _ => ()
  sameAddressEvaluation := ()
  sameAddressEvaluation_eq := rfl

/-- A fully inhabited two-dimensional matrix-order observer can expose a unital self-adjoint
operator system without exposing the algebra generated by its visible questions. -/
theorem exists_matrix_order_observer_not_multiplicatively_closed :
    ∃ observer : ObserverData (Fin 2) Unit Unit Unit Unit Unit Unit,
      ¬ MultiplicativelyClosed observer.visibleSystem := by
  refine ⟨qubitObserver, ?_⟩
  intro multiplication_closed
  have x_visible : VisibleOperator qubitObserver.visibleSystem pauliX := by
    refine ⟨⟨pauliX, pauliX_selfAdjoint⟩, 0, pauliX_mem_qubitCarrier, ?_, ?_⟩
    · exact qubitQuestionSystem.carrier.zero_mem
    · simp
  have z_visible : VisibleOperator qubitObserver.visibleSystem pauliZ := by
    refine ⟨⟨pauliZ, pauliZ_selfAdjoint⟩, 0, pauliZ_mem_qubitCarrier, ?_, ?_⟩
    · exact qubitQuestionSystem.carrier.zero_mem
    · simp
  have product_visible := multiplication_closed pauliX pauliZ x_visible z_visible
  have equal_entries := visibleOperator_offDiagonal_eq product_visible
  rw [pauliX_pauliZ_entries.1, pauliX_pauliZ_entries.2] at equal_entries
  norm_num at equal_entries

/- The positive witness has unequal numerical product entries: `XZ(0,1) = -1` and
`XZ(1,0) = 1`. -/
example :
    (pauliX * pauliZ) 0 1 = -1 ∧ (pauliX * pauliZ) 1 0 = 1 :=
  pauliX_pauliZ_entries

/- The opposite side breaks noncommutativity: `X` commutes with itself, `X^2 = I`, and its
product is visible. Hence the preceding nonvisibility conclusion is false for this pair. -/
example :
    Commute pauliX pauliX ∧
      VisibleOperator qubitQuestionSystem (pauliX * pauliX) ∧
      pauliX * pauliX = 1 := by
  refine ⟨Commute.refl pauliX, ?_, pauliX_square⟩
  rw [pauliX_square]
  refine ⟨⟨1, IsSelfAdjoint.one (MatrixAlgebra (Fin 2))⟩, 0,
    qubitQuestionSystem.one_mem, qubitQuestionSystem.carrier.zero_mem, ?_⟩
  simp

#print axioms exists_matrix_order_observer_not_multiplicatively_closed

end D5.S3.Quantum.Matrix.MatrixOrderObserver
