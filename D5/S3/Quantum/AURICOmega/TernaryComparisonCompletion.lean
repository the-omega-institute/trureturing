import D5.S3.Quantum.AURICOmega.TernaryComparisonIsomorphism
import Mathlib.Analysis.Real.Cardinality
import Mathlib.GroupTheory.FreeGroup.Basic
import Mathlib.SetTheory.Cardinal.Free
import Mathlib.Topology.Algebra.Star.Unitary

/-! Reading completion of rank-five ternary comparison structures.

Let `C` be a noncommutative, chain-connected ternary comparison structure of feature rank five
whose reading touches zero, without assuming that the reading is complete.

* Dense image: the normalized embedding into the unit quaternions has an image closed under
  `x * y⁻¹ * z` and containing one, so the closure `K` of the image is a closed subgroup. A
  point of `K` has points of the image at small distance, hence at reading close to one, so
  chains in the image extend to chains in `K`; two noncommuting points of the image lie in `K`.
  A closed, chain-connected, noncommutative subgroup of the unit quaternions is everything, so
  the image is dense.
* Subgroups: a subgroup `H` of the unit quaternions carries the induced transfer and reading.
  The reading between unit quaternions is `1 - ‖x - y‖ ^ 2 / 4`, so reading-Cauchy sequences are
  Cauchy sequences in the complete unit sphere; reading completeness of `H` is closedness of
  `H`.
* Dense subgroups: noncommuting pairs and pairs of small reading form nonempty open sets of
  pairs of unit quaternions, which a dense subgroup meets. Chains: on the connected unit sphere,
  the relation "any two points of `H` near `a` and near `b` are joined by a chain of small steps
  in `H`" holds locally and is transitive by density, hence holds everywhere. The feature map
  of the unit quaternions restricts to `H`.
* Independence: the subgroup generated by a countable dense set of unit quaternions is
  countable and dense, but the unit quaternions are uncountable since their real parts fill
  `[-1, 1]`. Hence it is not closed, and its structure satisfies every hypothesis except
  reading completeness. -/

open scoped InnerProductSpace Quaternion

noncomputable section

namespace D5.S3.Quantum.AURICOmega.TernaryComparisonCompletion

open D5.S3.Quantum.AURICOmega.TernaryComparisonGroup
open D5.S3.Quantum.AURICOmega.QuaternionComparisonModel
open D5.S3.Quantum.AURICOmega.TernaryComparisonIsomorphism
open D5.S3.Quantum.AURICOmega.UnitQuaternionClosedSubgroup

/-- A subgroup of the unit quaternions with the induced transfer `x * y⁻¹ * z` and reading
`(1 + ⟪x, y⟫) / 2`. -/
def subgroupModel (H : Subgroup (unitary ℍ[ℝ])) : TernaryComparison H where
  tri x y z := ⟨quaternionModel.tri x y z, H.mul_mem (H.mul_mem x.2 (H.inv_mem y.2)) z.2⟩
  kappa x y := quaternionModel.kappa x y
  tri_self_left x z := Subtype.ext (quaternionModel.tri_self_left x z)
  tri_self_right x z := Subtype.ext (quaternionModel.tri_self_right x z)
  tri_assoc x y z u v := Subtype.ext (quaternionModel.tri_assoc x y z u v)
  kappa_symm x y := quaternionModel.kappa_symm x y
  kappa_eq_one_iff x y := (quaternionModel.kappa_eq_one_iff x y).trans Subtype.ext_iff.symm
  kappa_nonneg x y := quaternionModel.kappa_nonneg x y
  kappa_tri_right x y u v := quaternionModel.kappa_tri_right x y u v
  kappa_tri_left u v x y := quaternionModel.kappa_tri_left u v x y
  kappa_gram_nonneg n x c := quaternionModel.kappa_gram_nonneg n (fun i => x i) c

/-- Unit quaternions at distance less than `min 1 ε` have reading above `1 - ε`. -/
private lemma lt_kappa_of_dist_lt {a b : unitary ℍ[ℝ]} {ε : ℝ} (h : dist a b < min 1 ε) :
    1 - ε < quaternionModel.kappa a b := by
  rw [kappa_eq_one_sub_dist_sq]
  have hd0 := dist_nonneg (x := a) (y := b)
  have h1 := h.trans_le (min_le_left 1 ε)
  have h2 := h.trans_le (min_le_right 1 ε)
  nlinarith

/-- The reading of the unit quaternions is continuous in both arguments. -/
private lemma continuous_kappa :
    Continuous fun p : unitary ℍ[ℝ] × unitary ℍ[ℝ] => quaternionModel.kappa p.1 p.2 := by
  change Continuous fun p : unitary ℍ[ℝ] × unitary ℍ[ℝ] =>
    (1 + ⟪((p.1 : unitary ℍ[ℝ]) : ℍ[ℝ]), ((p.2 : unitary ℍ[ℝ]) : ℍ[ℝ])⟫_ℝ) / 2
  fun_prop

/-- Chains with steps in a set `S` of unit quaternions extend to chains with steps in its
closure: a point of the closure has points of `S` at reading close to one. -/
private lemma chain_closure (S : Set (unitary ℍ[ℝ]))
    (hS : ∀ ε : ℝ, 0 < ε → ∀ x ∈ S, ∀ y ∈ S,
      Relation.ReflTransGen (fun a b : unitary ℍ[ℝ] => b ∈ S ∧ 1 - ε < quaternionModel.kappa a b)
        x y)
    (ε : ℝ) (hε : 0 < ε) (x : unitary ℍ[ℝ]) (hx : x ∈ closure S) (y : unitary ℍ[ℝ])
    (hy : y ∈ closure S) :
    Relation.ReflTransGen
      (fun a b : unitary ℍ[ℝ] => b ∈ closure S ∧ 1 - ε < quaternionModel.kappa a b) x y := by
  obtain ⟨x', hx'S, hxx'⟩ := Metric.mem_closure_iff.mp hx (min 1 ε) (lt_min one_pos hε)
  obtain ⟨y', hy'S, hyy'⟩ := Metric.mem_closure_iff.mp hy (min 1 ε) (lt_min one_pos hε)
  have hy' : 1 - ε < quaternionModel.kappa y' y := by
    rw [quaternionModel.kappa_symm]
    exact lt_kappa_of_dist_lt hyy'
  exact Relation.ReflTransGen.head ⟨subset_closure hx'S, lt_kappa_of_dist_lt hxx'⟩
    (Relation.ReflTransGen.tail
      (Relation.ReflTransGen.mono (fun a b h => ⟨subset_closure h.1, h.2⟩) _ _
        (hS ε hε x' hx'S y' hy'S)) ⟨hy, hy'⟩)

/-- Without reading completeness, the normalized embedding of a noncommutative,
chain-connected ternary comparison structure of feature rank five whose reading touches zero
into the unit quaternions has dense range. -/
theorem exists_unitQuaternion_embedding_denseRange {M : Type*} (C : TernaryComparison M)
    (hnc : C.Noncommutative) (hconn : C.ChainConnected) (hzero : C.TouchesZero)
    (hr : C.HasFeatureRank 5) (o : M) :
    ∃ u : M → unitary ℍ[ℝ], Function.Injective u ∧ u o = 1 ∧ DenseRange u ∧
      (∀ x y z, u (C.tri x y z) = quaternionModel.tri (u x) (u y) (u z)) ∧
      (∀ x y, C.kappa x y = quaternionModel.kappa (u x) (u y)) := by
  obtain ⟨v, hinj, hvo, htri, hk⟩ := exists_normalized_embedding C hnc hconn hzero hr o
  have hmul : ∀ a ∈ Set.range v, ∀ b ∈ Set.range v, a * b ∈ Set.range v := by
    rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
    exact ⟨C.tri x o y, by rw [htri, hvo, inv_one, mul_one]⟩
  have hinv : Set.MapsTo (fun a : unitary ℍ[ℝ] => a⁻¹) (Set.range v) (Set.range v) := by
    rintro _ ⟨x, rfl⟩
    exact ⟨C.tri o x o, by rw [htri, hvo, one_mul, mul_one]⟩
  let K : Subgroup (unitary ℍ[ℝ]) :=
    { carrier := closure (Set.range v)
      one_mem' := subset_closure ⟨o, hvo⟩
      mul_mem' := fun ha hb => map_mem_closure₂ continuous_mul ha hb hmul
      inv_mem' := fun ha => map_mem_closure continuous_inv ha hinv }
  have hK : K = ⊤ := by
    refine eq_top_of_isClosed_of_chainConnected K isClosed_closure
      (chain_closure (Set.range v) (fun ε hε => ?_)) ?_
    · rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩
      exact (hconn ε hε x y).lift v fun a b h => ⟨⟨b, rfl⟩, by rwa [← hk]⟩
    · obtain ⟨x, y, hxy⟩ := (C.noncommutative_iff o).mp hnc
      refine ⟨v x, subset_closure ⟨x, rfl⟩, v y, subset_closure ⟨y, rfl⟩, fun h => hxy (hinj ?_)⟩
      rw [htri, htri, hvo, inv_one, mul_one, mul_one, h]
  exact ⟨v, hinj, hvo, fun q => (Subgroup.eq_top_iff' K).mp hK q, htri, hk⟩

/-- For a subgroup `H` of the unit quaternions with the induced structure, the reading is
complete exactly when `H` is closed. -/
theorem subgroupModel_readingComplete_iff (H : Subgroup (unitary ℍ[ℝ])) :
    ReadingComplete (subgroupModel H) ↔ IsClosed (H : Set (unitary ℍ[ℝ])) := by
  constructor
  · intro hc
    have h := isClosed_range (subgroupModel H) Subtype.val (fun x y => rfl) hc
    rwa [Subtype.range_coe] at h
  · intro hH x hx
    have : CompleteSpace (unitary ℍ[ℝ]) := isClosed_unitary.completeSpace_coe
    have : CompleteSpace H := hH.completeSpace_coe
    have hcauchy : CauchySeq x := by
      refine Metric.cauchySeq_iff.mpr fun ε hε => ?_
      obtain ⟨N, hN⟩ := hx (ε ^ 2 / 4) (by positivity)
      refine ⟨N, fun m hm n hn => ?_⟩
      have h := hN m n hm hn
      change 1 - ε ^ 2 / 4 < quaternionModel.kappa (x m) (x n) at h
      rw [kappa_eq_one_sub_dist_sq] at h
      rw [Subtype.dist_eq]
      have h' : dist (x m : unitary ℍ[ℝ]) (x n) ^ 2 < ε ^ 2 := by linarith
      exact (pow_lt_pow_iff_left₀ dist_nonneg hε.le two_ne_zero).mp h'
    obtain ⟨a, ha⟩ := cauchySeq_tendsto_of_complete hcauchy
    refine ⟨a, fun ε hε => ?_⟩
    obtain ⟨N, hN⟩ := Metric.tendsto_atTop.mp ha (min 1 ε) (lt_min one_pos hε)
    refine ⟨N, fun n hn => ?_⟩
    have hd := hN n hn
    rw [Subtype.dist_eq] at hd
    exact lt_kappa_of_dist_lt hd

/-- The unit three-sphere is preconnected. -/
private lemma preconnectedSpace_unitary : PreconnectedSpace (unitary ℍ[ℝ]) :=
  Subtype.preconnectedSpace (by
    rw [coe_unitary_eq_sphere]
    exact isPreconnected_sphere (by rw [Quaternion.rank_eq_four]; norm_num) 0 1)

/-- In a dense subgroup, any two points are joined by chains of steps of distance less than
any `δ > 0`: on the connected unit sphere, the relation "points of `H` within `δ / 3` of `a` and
of `b` are so joined" holds for nearby `a, b` and is transitive by density. -/
private lemma chain_of_dense {H : Subgroup (unitary ℍ[ℝ])} (hH : Dense (H : Set (unitary ℍ[ℝ])))
    {δ : ℝ} (hδ : 0 < δ) (x y : H) :
    Relation.ReflTransGen (fun a b : H => dist (a : unitary ℍ[ℝ]) b < δ) x y := by
  have := preconnectedSpace_unitary
  let P : unitary ℍ[ℝ] → unitary ℍ[ℝ] → Prop := fun a b => ∀ a' b' : H,
    dist a a' < δ / 3 → dist b b' < δ / 3 →
      Relation.ReflTransGen (fun p q : H => dist (p : unitary ℍ[ℝ]) q < δ) a' b'
  have hloc : ∀ a b : unitary ℍ[ℝ], dist a b < δ / 3 → P a b := by
    intro a b hab a' b' ha' hb'
    refine Relation.ReflTransGen.single ?_
    calc dist (a' : unitary ℍ[ℝ]) b' ≤ dist (a' : unitary ℍ[ℝ]) a + dist a b + dist b b' :=
          dist_triangle4 _ _ _ _
      _ < δ / 3 + δ / 3 + δ / 3 := by
          rw [dist_comm] at ha'
          gcongr
      _ = δ := by ring
  have hP : ∀ a b, P a b := by
    refine PreconnectedSpace.induction₂' P (fun a => ?_) ⟨fun a b c hab hbc => ?_⟩
    · filter_upwards [Metric.ball_mem_nhds a (div_pos hδ three_pos)] with b hb
      rw [Metric.mem_ball] at hb
      exact ⟨hloc a b (by rwa [dist_comm]), hloc b a hb⟩
    · intro a' c' ha' hc'
      obtain ⟨b', hb'H, hbb'⟩ := hH.exists_dist_lt b (div_pos hδ three_pos)
      exact (hab a' ⟨b', hb'H⟩ ha' hbb').trans (hbc ⟨b', hb'H⟩ c' hbb' hc')
  exact hP x y x y (by rw [dist_self]; positivity) (by rw [dist_self]; positivity)

/-- A dense subgroup of the unit quaternions with the induced structure is noncommutative,
chain-connected, touches zero and has feature rank five. -/
theorem subgroupModel_of_dense (H : Subgroup (unitary ℍ[ℝ]))
    (hH : Dense (H : Set (unitary ℍ[ℝ]))) :
    (subgroupModel H).Noncommutative ∧ (subgroupModel H).ChainConnected ∧
      (subgroupModel H).TouchesZero ∧ (subgroupModel H).HasFeatureRank 5 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · obtain ⟨x, y, hxy⟩ :=
      (quaternionModel.noncommutative_iff 1).mp quaternionModel_noncommutative
    obtain ⟨p, ⟨hp1, hp2⟩, hp⟩ := (hH.prod hH).exists_mem_open
      (isOpen_ne_fun (f := fun p : unitary ℍ[ℝ] × unitary ℍ[ℝ] => p.1 * 1⁻¹ * p.2)
        (g := fun p => p.2 * 1⁻¹ * p.1) (by fun_prop) (by fun_prop)) ⟨(x, y), hxy⟩
    exact ⟨⟨p.1, hp1⟩, 1, ⟨p.2, hp2⟩, fun h => hp (congrArg Subtype.val h)⟩
  · intro ε hε x y
    exact Relation.ReflTransGen.mono (fun a b h => lt_kappa_of_dist_lt h) _ _
      (chain_of_dense hH (lt_min one_pos hε) x y)
  · intro ε hε
    obtain ⟨a, b, hab⟩ := quaternionModel_touchesZero ε hε
    obtain ⟨p, ⟨hp1, hp2⟩, hp⟩ := (hH.prod hH).exists_mem_open
      (isOpen_lt continuous_kappa continuous_const) ⟨(a, b), hab⟩
    exact ⟨⟨p.1, hp1⟩, ⟨p.2, hp2⟩, hp⟩
  · obtain ⟨φ, hφ⟩ := quaternionModel_hasFeatureRank_five
    exact ⟨fun x => φ x, fun x y => hφ x y⟩

/-- The unit quaternions are uncountable: their real parts fill `[-1, 1]`. -/
private lemma not_countable_univ_unitary : ¬ (Set.univ : Set (unitary ℍ[ℝ])).Countable := by
  intro hc
  have hsub : Set.Icc (-1 : ℝ) 1 ⊆ (fun u : unitary ℍ[ℝ] => (u : ℍ[ℝ]).re) '' Set.univ := by
    intro t ht
    have h0 : 0 ≤ 1 - t ^ 2 := by nlinarith [ht.1, ht.2]
    let q : ℍ[ℝ] := ⟨t, Real.sqrt (1 - t ^ 2), 0, 0⟩
    have hq : q ∈ (unitary ℍ[ℝ] : Set ℍ[ℝ]) := by
      rw [coe_unitary_eq_sphere, mem_sphere_zero_iff_norm]
      have hn : ‖q‖ * ‖q‖ = 1 := by
        rw [← Quaternion.normSq_eq_norm_mul_self, Quaternion.normSq_def']
        change t ^ 2 + Real.sqrt (1 - t ^ 2) ^ 2 + 0 ^ 2 + 0 ^ 2 = 1
        rw [Real.sq_sqrt h0]
        ring
      exact (mul_self_eq_one_iff.mp hn).resolve_right (by linarith [norm_nonneg q])
    exact ⟨⟨q, hq⟩, Set.mem_univ _, rfl⟩
  have hI := (hc.image fun u : unitary ℍ[ℝ] => (u : ℍ[ℝ]).re).mono hsub
  rw [Cardinal.Real.Icc_countable_iff] at hI
  norm_num at hI

/-- There is a dense subgroup of the unit quaternions that is not closed; its induced structure
is noncommutative, chain-connected, touches zero and has feature rank five, but its reading is
not complete. -/
theorem exists_subgroupModel_not_readingComplete :
    ∃ H : Subgroup (unitary ℍ[ℝ]),
      (subgroupModel H).Noncommutative ∧ (subgroupModel H).ChainConnected ∧
      (subgroupModel H).TouchesZero ∧ (subgroupModel H).HasFeatureRank 5 ∧
      ¬ ReadingComplete (subgroupModel H) := by
  obtain ⟨S, hSc, hSd⟩ := TopologicalSpace.exists_countable_dense (unitary ℍ[ℝ])
  have : Countable S := hSc.to_subtype
  let H : Subgroup (unitary ℍ[ℝ]) := (FreeGroup.lift ((↑) : S → unitary ℍ[ℝ])).range
  have hHd : Dense (H : Set (unitary ℍ[ℝ])) :=
    hSd.mono fun s hs => ⟨FreeGroup.of ⟨s, hs⟩, FreeGroup.lift_apply_of⟩
  have hHc : (H : Set (unitary ℍ[ℝ])).Countable := by
    rw [MonoidHom.coe_range]
    exact Set.countable_range _
  obtain ⟨h1, h2, h3, h4⟩ := subgroupModel_of_dense H hHd
  refine ⟨H, h1, h2, h3, h4, fun hc => not_countable_univ_unitary ?_⟩
  rw [← hHd.closure_eq, ((subgroupModel_readingComplete_iff H).mp hc).closure_eq]
  exact hHc

end D5.S3.Quantum.AURICOmega.TernaryComparisonCompletion
