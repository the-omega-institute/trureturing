/- GID: D5/S3/Quantum/AURICOmega/SmallInvariantSubspaceExclusion
   generality: G
   mirror-B: D5/B/S3/Quantum/AURICOmega/SmallInvariantSubspaceExclusion
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Irreducibility criterion for isometry groups in dimension at most four. -/

import Mathlib.Analysis.Complex.Isometry
import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional
import Mathlib.Analysis.Normed.Module.FiniteDimension

/-! Exclusion of small invariant subspaces.

Let `𝒰` be a group of linear isometries of a real inner-product space `E` with
`finrank E ≤ 4`. Assume that `𝒰` has no nonzero common fixed vector, that `𝒰` is generated by
elements sending no nonzero vector to its negative, and that `𝒰` is not commutative. Then every
`𝒰`-invariant subspace is `⊥` or `⊤`.

The argument: an invariant line is pointwise fixed, since each generator acts on it by `±1` and
cannot act by `-1`; on an invariant plane every generator is a rotation, since a reflection of
the plane sends a nonzero vector to its negative, so the whole group acts by commuting
rotations; orthogonal complements of invariant subspaces are invariant. -/

open scoped ComplexConjugate

namespace D5.S3.Quantum.AURICOmega.SmallInvariantSubspaceExclusion

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- The orthogonal complement of a subspace invariant under a group of linear isometries is
invariant. -/
private lemma orthogonal_invariant (𝒰 : Subgroup (E ≃ₗᵢ[ℝ] E)) (X : Submodule ℝ E)
    (hX : ∀ T ∈ 𝒰, ∀ x ∈ X, T x ∈ X) : ∀ T ∈ 𝒰, ∀ y ∈ Xᗮ, T y ∈ Xᗮ := by
  intro T hT y hy
  rw [Submodule.mem_orthogonal] at hy ⊢
  intro u hu
  have h := hy _ (hX T⁻¹ (inv_mem hT) u hu)
  rwa [← T.inner_map_map, LinearIsometryEquiv.coe_inv,
    LinearIsometryEquiv.apply_symm_apply] at h

/-- An invariant line of a group of linear isometries generated by elements sending no nonzero
vector to its negative is pointwise fixed. -/
private lemma line_fixed (𝒰 : Subgroup (E ≃ₗᵢ[ℝ] E))
    (hgen : Subgroup.closure
      {T : E ≃ₗᵢ[ℝ] E | T ∈ 𝒰 ∧ ∀ v : E, T v = -v → v = 0} = 𝒰)
    (X : Submodule ℝ E) (hX : ∀ T ∈ 𝒰, ∀ x ∈ X, T x ∈ X) (h1 : Module.finrank ℝ X = 1) :
    ∃ v : E, v ≠ 0 ∧ ∀ T ∈ 𝒰, T v = v := by
  obtain ⟨v, hv0, hspan⟩ := finrank_eq_one_iff'.mp h1
  have hvE : (v : E) ≠ 0 := fun h => hv0 (Subtype.ext h)
  have hpm : ∀ T ∈ 𝒰, T (v : E) = v ∨ T (v : E) = -(v : E) := by
    intro T hT
    obtain ⟨c, hc⟩ := hspan ⟨T v, hX T hT v v.2⟩
    have hTv : T (v : E) = c • (v : E) := (congrArg Subtype.val hc).symm
    have hnorm : ‖c‖ * ‖(v : E)‖ = 1 * ‖(v : E)‖ := by
      rw [one_mul, ← norm_smul, ← hTv, T.norm_map]
    have hc1 : |c| = 1 := by
      rw [← Real.norm_eq_abs]
      exact mul_right_cancel₀ (norm_ne_zero_iff.mpr hvE) hnorm
    rcases (abs_eq zero_le_one).mp hc1 with h | h
    · left; rw [hTv, h, one_smul]
    · right; rw [hTv, h, neg_one_smul]
  refine ⟨v, hvE, fun T hT => ?_⟩
  rw [← hgen] at hT
  refine Subgroup.closure_induction (p := fun T _ => T (v : E) = (v : E)) ?_ ?_ ?_ ?_ hT
  · rintro T ⟨hT, hneg⟩
    exact (hpm T hT).resolve_right fun h => hvE (hneg v h)
  · rfl
  · intro S T _ _ hS hT
    rw [LinearIsometryEquiv.coe_mul, Function.comp_apply, hT, hS]
  · intro T _ hT
    rw [LinearIsometryEquiv.coe_inv, LinearIsometryEquiv.symm_apply_eq, hT]

/-- A reflection `z ↦ a * conj z` of the complex plane sends a nonzero vector to its negative. -/
private lemma exists_neg_of_reflection (a : Circle) :
    ∃ z : ℂ, z ≠ 0 ∧ (a : ℂ) * conj z = -z := by
  by_cases ha : (a : ℂ) = -1
  · exact ⟨1, one_ne_zero, by rw [ha, map_one, mul_one]⟩
  · refine ⟨Complex.I * (1 + a), mul_ne_zero Complex.I_ne_zero fun h => ha ?_, ?_⟩
    · linear_combination h
    · have hac : (a : ℂ) * conj (a : ℂ) = 1 := by
        rw [Complex.mul_conj, Circle.normSq_coe, Complex.ofReal_one]
      rw [map_mul, map_add, map_one, Complex.conj_I]
      linear_combination (-Complex.I) * hac

/-- A linear isometry of `E` that preserves a plane `X` and sends no nonzero vector to its
negative acts on `X`, read through a linear isometry `φ : X ≃ ℂ`, as multiplication by a nonzero
complex number. -/
private lemma plane_rotation (X : Submodule ℝ E) (φ : X ≃ₗᵢ[ℝ] ℂ)
    (T : E ≃ₗᵢ[ℝ] E) (hTX : ∀ x ∈ X, T x ∈ X) (hneg : ∀ v : E, T v = -v → v = 0) :
    ∃ a : ℂ, a ≠ 0 ∧ ∀ x : X, T (x : E) = (φ.symm (a * φ x) : E) := by
  let r : X →ₗᵢ[ℝ] X :=
    { toLinearMap := T.toLinearEquiv.toLinearMap.restrict hTX
      norm_map' := fun x => by
        change ‖(T x : E)‖ = ‖(x : E)‖
        exact T.norm_map x }
  let f : ℂ ≃ₗᵢ[ℝ] ℂ :=
    (φ.toLinearIsometry.comp (r.comp φ.symm.toLinearIsometry)).toLinearIsometryEquiv rfl
  have hf : ∀ x : X, T (x : E) = (φ.symm (f (φ x)) : E) := by
    intro x
    change T (x : E) = (φ.symm (φ (r (φ.symm (φ x)))) : E)
    rw [LinearIsometryEquiv.symm_apply_apply, LinearIsometryEquiv.symm_apply_apply]
    rfl
  obtain ⟨a, ha | ha⟩ := linear_isometry_complex f
  · refine ⟨a, Circle.coe_ne_zero a, fun x => ?_⟩
    rw [hf, ha, rotation_apply]
  · exfalso
    obtain ⟨z, hz0, hz⟩ := exists_neg_of_reflection a
    have hx := hf (φ.symm z)
    rw [ha, LinearIsometryEquiv.trans_apply, rotation_apply, Complex.conjLIE_apply,
      LinearIsometryEquiv.apply_symm_apply, hz, map_neg, Submodule.coe_neg] at hx
    have hy0 : ((φ.symm z : X) : E) ≠ 0 := by
      intro h
      exact hz0 (by simpa using congrArg φ (Subtype.ext h : φ.symm z = 0))
    exact hy0 (hneg _ hx)

/-- On an invariant plane of a group of linear isometries generated by elements sending no
nonzero vector to its negative, any two elements of the group commute. -/
private lemma plane_commute (𝒰 : Subgroup (E ≃ₗᵢ[ℝ] E))
    (hgen : Subgroup.closure
      {T : E ≃ₗᵢ[ℝ] E | T ∈ 𝒰 ∧ ∀ v : E, T v = -v → v = 0} = 𝒰)
    (X : Submodule ℝ E) (hX : ∀ T ∈ 𝒰, ∀ x ∈ X, T x ∈ X) (h2 : Module.finrank ℝ X = 2) :
    ∀ S ∈ 𝒰, ∀ T ∈ 𝒰, ∀ x ∈ X, S (T x) = T (S x) := by
  have : FiniteDimensional ℝ X := Module.finite_of_finrank_eq_succ h2
  let φ : X ≃ₗᵢ[ℝ] ℂ :=
    (Complex.isometryOfOrthonormal ((stdOrthonormalBasis ℝ X).reindex (finCongr h2))).symm
  have key : ∀ T ∈ 𝒰, ∃ a : ℂ, a ≠ 0 ∧ ∀ x : X, T (x : E) = (φ.symm (a * φ x) : E) := by
    intro T hT
    rw [← hgen] at hT
    refine Subgroup.closure_induction
      (p := fun T _ => ∃ a : ℂ, a ≠ 0 ∧ ∀ x : X, T (x : E) = (φ.symm (a * φ x) : E))
      ?_ ?_ ?_ ?_ hT
    · rintro T ⟨hT, hneg⟩
      exact plane_rotation X φ T (hX T hT) hneg
    · refine ⟨1, one_ne_zero, fun x => ?_⟩
      rw [one_mul, LinearIsometryEquiv.symm_apply_apply]
      rfl
    · rintro S T - - ⟨a, ha, hS⟩ ⟨c, hc, hT⟩
      refine ⟨a * c, mul_ne_zero ha hc, fun x => ?_⟩
      rw [LinearIsometryEquiv.coe_mul, Function.comp_apply, hT, hS,
        LinearIsometryEquiv.apply_symm_apply, mul_assoc]
    · rintro T - ⟨a, ha, hT⟩
      refine ⟨a⁻¹, inv_ne_zero ha, fun x => ?_⟩
      rw [LinearIsometryEquiv.coe_inv, LinearIsometryEquiv.symm_apply_eq, hT,
        LinearIsometryEquiv.apply_symm_apply, mul_inv_cancel_left₀ ha,
        LinearIsometryEquiv.symm_apply_apply]
  intro S hS T hT x hx
  obtain ⟨a, -, hSa⟩ := key S hS
  obtain ⟨c, -, hTc⟩ := key T hT
  have hTx : T x = (φ.symm (c * φ ⟨x, hx⟩) : E) := hTc ⟨x, hx⟩
  have hSx : S x = (φ.symm (a * φ ⟨x, hx⟩) : E) := hSa ⟨x, hx⟩
  rw [hTx, hSx, hSa, hTc, LinearIsometryEquiv.apply_symm_apply,
    LinearIsometryEquiv.apply_symm_apply, mul_left_comm]

/-- A noncommutative group of linear isometries of a real inner-product space of dimension at
most four, with no nonzero common fixed vector and generated by elements sending no nonzero
vector to its negative, has no invariant subspace other than `⊥` and `⊤`. -/
theorem invariant_submodule_eq_bot_or_top
    {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E] [FiniteDimensional ℝ E]
    (𝒰 : Subgroup (E ≃ₗᵢ[ℝ] E))
    (hdim : Module.finrank ℝ E ≤ 4)
    (hfix : ∀ v : E, (∀ T ∈ 𝒰, T v = v) → v = 0)
    (hgen : Subgroup.closure {T : E ≃ₗᵢ[ℝ] E | T ∈ 𝒰 ∧ ∀ v : E, T v = -v → v = 0} = 𝒰)
    (hnc : ∃ S ∈ 𝒰, ∃ T ∈ 𝒰, S * T ≠ T * S)
    (X : Submodule ℝ E) (hX : ∀ T ∈ 𝒰, ∀ x ∈ X, T x ∈ X) :
    X = ⊥ ∨ X = ⊤ := by
  have hXo := orthogonal_invariant 𝒰 X hX
  have hsum := Submodule.finrank_add_finrank_orthogonal X
  by_contra hne
  rw [not_or] at hne
  obtain ⟨hbot, htop⟩ := hne
  have ha : Module.finrank ℝ X ≠ 0 := fun h => hbot (Submodule.finrank_eq_zero.mp h)
  have hb : Module.finrank ℝ Xᗮ ≠ 0 := fun h =>
    htop (Submodule.orthogonal_eq_bot_iff.mp (Submodule.finrank_eq_zero.mp h))
  have hline : ∀ Y : Submodule ℝ E, (∀ T ∈ 𝒰, ∀ y ∈ Y, T y ∈ Y) →
      Module.finrank ℝ Y ≠ 1 := by
    intro Y hY h1
    obtain ⟨v, hv0, hv⟩ := line_fixed 𝒰 hgen Y hY h1
    exact hv0 (hfix v hv)
  have hX1 := hline X hX
  have hXo1 := hline Xᗮ hXo
  have hX2 : Module.finrank ℝ X = 2 := by omega
  have hXo2 : Module.finrank ℝ Xᗮ = 2 := by omega
  obtain ⟨S, hS, T, hT, hST⟩ := hnc
  apply hST
  ext v
  obtain ⟨x, hx, y, hy, rfl⟩ := X.exists_add_mem_mem_orthogonal v
  rw [LinearIsometryEquiv.coe_mul, LinearIsometryEquiv.coe_mul, Function.comp_apply,
    Function.comp_apply, map_add, map_add, map_add, map_add,
    plane_commute 𝒰 hgen X hX hX2 S hS T hT x hx,
    plane_commute 𝒰 hgen Xᗮ hXo hXo2 S hS T hT y hy]

end D5.S3.Quantum.AURICOmega.SmallInvariantSubspaceExclusion
