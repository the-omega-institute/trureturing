open scoped BigOperators TensorProduct Classical

namespace D5.S3.Quantum.Algebra.AlgebraicHeisenbergFock

universe u v w

variable {K : Type u} [Field K] [CharZero K]
variable {σ : Type v} {M : Type w} [AddCommGroup M] [Module K M]

/-- Algebraic representation hypotheses. Local nilpotence and active-index
finiteness are pointwise; there is no common finite index set or exponent. -/
structure WeylData (K : Type u) (σ : Type v) (M : Type w)
    [Field K] [CharZero K] [AddCommGroup M] [Module K M] where
  X : σ → Module.End K M
  D : σ → Module.End K M
  xx : ∀ i j, Commute (X i) (X j)
  dd : ∀ i j, Commute (D i) (D j)
  dx : ∀ i j v, D i (X j v) = X j (D i v) + if i = j then v else 0
  nilpotent : ∀ i v, ∃ n : ℕ, (D i ^ n) v = 0
  active_finite : ∀ v, {i | D i v ≠ 0}.Finite

namespace WeylData

variable (W : WeylData K σ M)

/-- The intersection of all derivative kernels, including an empty family. -/
def vacuum : Submodule K M := ⨅ i, LinearMap.ker (W.D i)

@[simp] theorem mem_vacuum (v : M) : v ∈ W.vacuum ↔ ∀ i, W.D i v = 0 := by
  simp [vacuum, LinearMap.mem_ker]

def active (v : M) : Finset σ := (W.active_finite v).toFinset

@[simp] theorem mem_active (i : σ) (v : M) :
    i ∈ W.active v ↔ W.D i v ≠ 0 := by simp [active]

theorem active_add_subset (v z : M) :
    W.active (v + z) ⊆ W.active v ∪ W.active z := by
  intro i hi
  by_contra hout
  have hiv : i ∉ W.active v := fun h => hout (Finset.mem_union_left _ h)
  have hiz : i ∉ W.active z := fun h => hout (Finset.mem_union_right _ h)
  have hv : W.D i v = 0 := by simpa using hiv
  have hz : W.D i z = 0 := by simpa using hiz
  exact (W.mem_active i (v + z)).mp hi (by simp [hv, hz])

theorem active_smul_subset (c : K) (v : M) : W.active (c • v) ⊆ W.active v := by
  intro i hi
  by_contra hout
  have hv : W.D i v = 0 := by simpa using hout
  exact (W.mem_active i (c • v)).mp hi (by simp [hv])

/-- Transport a kernel along a commuting endomorphism. -/
theorem commute_apply (A B : Module.End K M) (h : Commute A B) (v : M) :
    A (B v) = B (A v) := congrArg (fun T : Module.End K M => T v) h.eq

theorem dx_of_ne {i j : σ} (h : i ≠ j) : Commute (W.D i) (W.X j) := by
  apply LinearMap.ext
  intro v
  simpa [h] using W.dx i j v

/-- An inclusive nilpotence cutoff. Its choice is eliminated before it is
used to define a linear operator. -/
def cutoff (i : σ) (v : M) : ℕ := Nat.find (W.nilpotent i v)

theorem cutoff_spec (i : σ) (v : M) : (W.D i ^ W.cutoff i v) v = 0 :=
  Nat.find_spec (W.nilpotent i v)

theorem cutoff_succ_spec (i : σ) (v : M) :
    (W.D i ^ (W.cutoff i v + 1)) v = 0 :=
  Module.End.pow_map_zero_of_le (Nat.le_succ _) (W.cutoff_spec i v)

/-- A finite simultaneous box, obtained from the hypotheses, rather than
assumed as a normal form or uniform truncation hypothesis. -/
def jointCutoff (v : M) : σ →₀ ℕ :=
  Finsupp.onFinset (W.active v)
    (fun i => if i ∈ W.active v then W.cutoff i v else 0)
    (by intro i hi; by_contra hn; exact hi (by simp [hn]))

theorem jointCutoff_spec (v : M) (i : σ) :
    (W.D i ^ (W.jointCutoff v i + 1)) v = 0 := by
  by_cases hi : i ∈ W.active v
  · simpa only [jointCutoff, Finsupp.onFinset_apply, if_pos hi] using W.cutoff_succ_spec i v
  · have hz : W.D i v = 0 := by simpa using hi
    simp [jointCutoff, hi, hz]

/-- A commuting monomial in endomorphisms. It uses only the finite support
of its exponent; neither the ambient index type nor M is made finite. -/
def monomialOperator (A : σ → Module.End K M)
    (hA : ∀ i j, Commute (A i) (A j)) (d : σ →₀ ℕ) : Module.End K M :=
  d.support.noncommProd (fun i => A i ^ d i)
    (fun i _ j _ _ => (hA i j).pow_pow _ _)

/-- The product may be taken over any finite set containing the exponent
support: every additional factor is 1. -/
theorem monomialOperator_on (A : σ → Module.End K M)
    (hA : ∀ i j, Commute (A i) (A j)) (d : σ →₀ ℕ)
    (s : Finset σ) (hd : d.support ⊆ s) :
    monomialOperator A hA d =
      s.noncommProd (fun i => A i ^ d i)
        (fun i _ j _ _ => (hA i j).pow_pow _ _) := by
  have hu : d.support ∪ (s \ d.support) = s := Finset.union_sdiff_of_subset hd
  have hone : (s \ d.support).noncommProd (fun i => A i ^ d i)
      (fun i _ j _ _ => (hA i j).pow_pow _ _) = 1 := by
    have h := Finset.noncommProd_eq_pow_card (s \ d.support)
      (fun i => A i ^ d i) (fun i _ j _ _ => (hA i j).pow_pow _ _) 1 (by
        intro i hi
        have hz : d i = 0 := Finsupp.notMem_support_iff.mp (Finset.mem_sdiff.mp hi).2
        simp [hz])
    simpa using h
  symm
  rw [← hu, Finset.noncommProd_union_of_disjoint Finset.disjoint_sdiff]
  change monomialOperator A hA d *
    (s \ d.support).noncommProd (fun i => A i ^ d i)
      (fun i _ j _ _ => (hA i j).pow_pow _ _) = _
  rw [hone, mul_one]

theorem monomialOperator_add_single (A : σ → Module.End K M)
    (hA : ∀ i j, Commute (A i) (A j)) (d : σ →₀ ℕ) (i : σ) :
    monomialOperator A hA (d + Finsupp.single i 1) = A i * monomialOperator A hA d := by
  let s := insert i d.support
  have hi : i ∈ s := Finset.mem_insert_self _ _
  have hd : d.support ⊆ s := Finset.subset_insert _ _
  have he : (d + Finsupp.single i 1).support ⊆ s := by
    intro j hj
    rcases Finset.mem_union.mp (Finsupp.support_add hj) with hj | hj
    · exact Finset.mem_insert_of_mem hj
    · have hji := Finset.mem_singleton.mp (Finsupp.support_single_subset hj)
      subst j
      exact hi
  have hrest : (s.erase i).noncommProd
        (fun j => A j ^ (d + Finsupp.single i 1 : σ →₀ ℕ) j)
        (fun j _ k _ _ => (hA j k).pow_pow _ _) =
      (s.erase i).noncommProd (fun j => A j ^ d j)
        (fun j _ k _ _ => (hA j k).pow_pow _ _) := by
    apply Finset.noncommProd_congr rfl
    intro j hj
    have hji : j ≠ i := (Finset.mem_erase.mp hj).1
    simp [Finsupp.single_apply, hji, Ne.symm hji]
  rw [monomialOperator_on A hA _ s he, monomialOperator_on A hA d s hd,
    ← Finset.mul_noncommProd_erase s hi
      (fun j => A j ^ (d + Finsupp.single i 1 : σ →₀ ℕ) j)
      (fun j _ k _ _ => (hA j k).pow_pow _ _),
    ← Finset.mul_noncommProd_erase s hi (fun j => A j ^ d j)
      (fun j _ k _ _ => (hA j k).pow_pow _ _)]
  rw [hrest]
  simp only [Finsupp.add_apply, Finsupp.single_eq_same]
  rw [pow_succ', mul_assoc]

abbrev derivative (d : σ →₀ ℕ) : Module.End K M :=
  monomialOperator W.D W.dd d

abbrev creation (d : σ →₀ ℕ) : Module.End K M :=
  monomialOperator W.X W.xx d

@[simp] theorem derivative_zero : W.derivative 0 = 1 := by
  simp [derivative, monomialOperator]

@[simp] theorem creation_zero : W.creation 0 = 1 := by
  simp [creation, monomialOperator]

theorem creation_add_single (d : σ →₀ ℕ) (i : σ) :
    W.creation (d + Finsupp.single i 1) = W.X i * W.creation d :=
  monomialOperator_add_single W.X W.xx d i

theorem derivative_commute (d : σ →₀ ℕ) (i : σ) :
    Commute (W.D i) (W.derivative d) := by
  apply Finset.noncommProd_commute
  intro j hj
  exact (W.dd i j).pow_right _

/-- A single excessive coordinate annihilates an arbitrary mixed
derivative. Commutation permits moving that coordinate to the input. -/
theorem derivative_eq_zero_of_excess (v : M) (b d : σ →₀ ℕ)
    (hb : ∀ i, (W.D i ^ (b i + 1)) v = 0)
    (i : σ) (hi : b i < d i) : W.derivative d v = 0 := by
  have his : i ∈ d.support := Finsupp.mem_support_iff.mpr (by omega)
  have hz : (W.D i ^ d i) v = 0 :=
    Module.End.pow_map_zero_of_le (by omega) (hb i)
  unfold derivative monomialOperator
  rw [← Finset.noncommProd_erase_mul d.support his
    (fun j => W.D j ^ d j) (fun j _ k _ _ => (W.dd j k).pow_pow _ _)]
  simp only [Module.End.mul_apply, hz, map_zero]

theorem derivative_eq_zero_of_not_le (v : M) (b d : σ →₀ ℕ)
    (hb : ∀ i, (W.D i ^ (b i + 1)) v = 0) (hd : ¬ d ≤ b) :
    W.derivative d v = 0 := by
  have hex : ∃ i, b i < d i := by
    by_contra hn
    apply hd
    intro i
    have : ¬ b i < d i := fun hi => hn ⟨i, hi⟩
    omega
  obtain ⟨i, hi⟩ := hex
  exact W.derivative_eq_zero_of_excess v b d hb i hi

/-- The *whole* mixed-derivative orbit has a finite box of possible
nonzero coefficients, even for an infinite or empty σ. -/
theorem derivative_support_subset (v : M) :
    Function.support (fun d : σ →₀ ℕ => W.derivative d v) ⊆
      (Finset.Iic (W.jointCutoff v) : Set (σ →₀ ℕ)) := by
  intro d hd
  apply Finset.mem_Iic.mpr
  by_contra hn
  exact hd (W.derivative_eq_zero_of_not_le v (W.jointCutoff v) d
    (W.jointCutoff_spec v) hn)

theorem derivative_support_finite (v : M) :
    Function.HasFiniteSupport (fun d : σ →₀ ℕ => W.derivative d v) :=
  (Finset.Iic (W.jointCutoff v)).finite_toSet.subset (W.derivative_support_subset v)

/-- The same box is valid after *any* mixed derivative. This is the
simultaneous, orbit-stable assertion that pointwise nilpotence alone does
not state. -/
theorem jointCutoff_orbit (v : M) (d : σ →₀ ℕ) (i : σ) :
    (W.D i ^ (W.jointCutoff v i + 1)) (W.derivative d v) = 0 := by
  rw [commute_apply _ _ ((W.derivative_commute d i).pow_left _) v,
    W.jointCutoff_spec, map_zero]

end WeylData

/-! One-coordinate Taylor calculation. All cutoffs are inclusive. -/

namespace Taylor

def coefficient (K : Type u) [Field K] (n : ℕ) : K :=
  (-1 : K) ^ n / (n.factorial : K)

@[simp] theorem coefficient_zero : coefficient K 0 = 1 := by simp [coefficient]

theorem factorial_ne_zero (n : ℕ) : (n.factorial : K) ≠ 0 := by
  exact_mod_cast Nat.factorial_ne_zero n

theorem coefficient_succ (n : ℕ) :
    coefficient K (n + 1) * (n + 1 : K) = -coefficient K n := by
  simp only [coefficient, pow_succ, Nat.factorial_succ, Nat.cast_mul, Nat.cast_add,
    Nat.cast_one]
  have h1 : (n.factorial : K) ≠ 0 := factorial_ne_zero n
  have h2 : (n + 1 : K) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
  field_simp
  <;> ring

def finite (X D : Module.End K M) (N : ℕ) : Module.End K M :=
  ∑ k ∈ Finset.range (N + 1), coefficient K k • (X ^ k * D ^ k)

@[simp] theorem finite_zero (X D : Module.End K M) : finite X D 0 = 1 := by
  simp [finite]

theorem finite_succ (X D : Module.End K M) (N : ℕ) :
    finite X D (N + 1) = finite X D N +
      coefficient K (N + 1) • (X ^ (N + 1) * D ^ (N + 1)) := by
  simp only [finite, Finset.sum_range_succ]

theorem D_X_pow (X D : Module.End K M)
    (h : ∀ v, D (X v) = X (D v) + v) (n : ℕ) (v : M) :
    D ((X ^ (n + 1)) v) =
      (X ^ (n + 1)) (D v) + (n + 1 : K) • (X ^ n) v := by
  induction n with
  | zero => simpa using h v
  | succ n ih =>
    calc
      D ((X ^ (n + 1 + 1)) v) = D (X ((X ^ (n + 1)) v)) := by
        rw [pow_succ', Module.End.mul_apply]
      _ = X (D ((X ^ (n + 1)) v)) + (X ^ (n + 1)) v := h _
      _ = _ := by
        rw [ih, map_add, map_smul]
        simp only [pow_succ', Module.End.mul_apply, Nat.cast_add, Nat.cast_one]
        module

theorem D_pow_X (X D : Module.End K M)
    (h : ∀ v, D (X v) = X (D v) + v) (n : ℕ) (v : M) :
    (D ^ (n + 1)) (X v) =
      X ((D ^ (n + 1)) v) + (n + 1 : K) • (D ^ n) v := by
  induction n with
  | zero => simpa using h v
  | succ n ih =>
    calc
      (D ^ (n + 1 + 1)) (X v) = D ((D ^ (n + 1)) (X v)) := by
        rw [pow_succ', Module.End.mul_apply]
      _ = D (X ((D ^ (n + 1)) v) + (n + 1 : K) • (D ^ n) v) := by rw [ih]
      _ = _ := by
        rw [map_add, map_smul, h]
        simp only [pow_succ', Module.End.mul_apply, Nat.cast_add, Nat.cast_one]
        module

/-- Exact boundary term of D times a truncated Taylor operator. -/
theorem D_finite (X D : Module.End K M)
    (h : ∀ v, D (X v) = X (D v) + v) (N : ℕ) (v : M) :
    D (finite X D N v) =
      coefficient K N • (X ^ N) ((D ^ (N + 1)) v) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [finite_succ, LinearMap.add_apply, LinearMap.smul_apply,
      Module.End.mul_apply, map_add, map_smul, ih, D_X_pow X D h,
      smul_add, smul_smul, coefficient_succ]
    have he : D ((D ^ (N + 1)) v) = (D ^ (N + 1 + 1)) v := by
      simp only [pow_succ', Module.End.mul_apply]
    rw [he]
    module

/-- Exact boundary term of a truncated Taylor operator times X. -/
theorem finite_X (X D : Module.End K M)
    (h : ∀ v, D (X v) = X (D v) + v) (N : ℕ) (v : M) :
    finite X D N (X v) =
      coefficient K N • (X ^ (N + 1)) ((D ^ N) v) := by
  induction N with
  | zero => simp
  | succ N ih =>
    rw [finite_succ, LinearMap.add_apply, LinearMap.smul_apply,
      Module.End.mul_apply, D_pow_X X D h, map_add, map_smul,
      smul_add, smul_smul, coefficient_succ, ih]
    rw [show (X ^ (N + 1)) (X ((D ^ (N + 1)) v)) =
      (X ^ (N + 1 + 1)) ((D ^ (N + 1)) v) by simp only [pow_succ, Module.End.mul_apply]]
    module

theorem finite_eq_self (X D : Module.End K M) (N : ℕ) (v : M)
    (hv : D v = 0) : finite X D N v = v := by
  induction N with
  | zero => simp
  | succ N ih =>
    have hz : (D ^ (N + 1)) v = 0 :=
      Module.End.pow_map_zero_of_le (k := 1) (by omega) (by simpa using hv)
    simp [finite_succ, ih, hz]

/-- Enlarge an arbitrary valid cutoff without changing the value. -/
theorem finite_stable (X D : Module.End K M) (v : M) (N L : ℕ)
    (hN : (D ^ (N + 1)) v = 0) (hNL : N ≤ L) :
    finite X D L v = finite X D N v := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hNL
  induction k with
  | zero => simp
  | succ k ih =>
    have hz : (D ^ (N + k + 1)) v = 0 :=
      Module.End.pow_map_zero_of_le (by omega) hN
    rw [show N + (k + 1) = (N + k) + 1 by omega, finite_succ]
    simp [ih, hz]

theorem finite_independent (X D : Module.End K M) (v : M) (N L : ℕ)
    (hN : (D ^ (N + 1)) v = 0) (hL : (D ^ (L + 1)) v = 0) :
    finite X D N v = finite X D L v := by
  exact (finite_stable X D v N (max N L) hN (le_max_left _ _)).symm.trans
    (finite_stable X D v L (max N L) hL (le_max_right _ _))

theorem commute_finite (X D T : Module.End K M)
    (hX : Commute T X) (hD : Commute T D) (N : ℕ) :
    Commute T (finite X D N) := by
  apply Commute.sum_right
  intro k hk
  have hc := (hX.pow_right k).mul_right (hD.pow_right k)
  change T * (coefficient K k • (X ^ k * D ^ k)) =
    (coefficient K k • (X ^ k * D ^ k)) * T
  rw [Algebra.mul_smul_comm, Algebra.smul_mul_assoc, hc.eq]

end Taylor

namespace WeylData

variable (W : WeylData K σ M)

/-- Pointwise Taylor evaluation, before linearity is established. -/
def projectionValue (i : σ) (v : M) : M :=
  Taylor.finite (W.X i) (W.D i) (W.cutoff i v) v

theorem projectionValue_eq (i : σ) (v : M) (N : ℕ)
    (hN : (W.D i ^ (N + 1)) v = 0) :
    W.projectionValue i v = Taylor.finite (W.X i) (W.D i) N v :=
  Taylor.finite_independent _ _ _ _ _ (W.cutoff_succ_spec i v) hN

theorem projectionValue_add (i : σ) (v z : M) :
    W.projectionValue i (v + z) = W.projectionValue i v + W.projectionValue i z := by
  let N := max (W.cutoff i v) (W.cutoff i z)
  have hv : (W.D i ^ (N + 1)) v = 0 :=
    Module.End.pow_map_zero_of_le (by dsimp [N]; omega) (W.cutoff_succ_spec i v)
  have hz : (W.D i ^ (N + 1)) z = 0 :=
    Module.End.pow_map_zero_of_le (by dsimp [N]; omega) (W.cutoff_succ_spec i z)
  have ha : (W.D i ^ (N + 1)) (v + z) = 0 := by simp [hv, hz]
  rw [W.projectionValue_eq i (v + z) N ha, W.projectionValue_eq i v N hv,
    W.projectionValue_eq i z N hz, map_add]

theorem projectionValue_smul (i : σ) (c : K) (v : M) :
    W.projectionValue i (c • v) = c • W.projectionValue i v := by
  let N := W.cutoff i v
  have hv := W.cutoff_succ_spec i v
  have hc : (W.D i ^ (N + 1)) (c • v) = 0 := by simp [N, hv]
  rw [W.projectionValue_eq i (c • v) N hc]
  simp [projectionValue, N]

/-- The one-coordinate projector is an actual linear map. -/
def projection (i : σ) : Module.End K M where
  toFun := W.projectionValue i
  map_add' := W.projectionValue_add i
  map_smul' := W.projectionValue_smul i

theorem projection_eq (i : σ) (v : M) (N : ℕ)
    (hN : (W.D i ^ (N + 1)) v = 0) :
    W.projection i v = Taylor.finite (W.X i) (W.D i) N v :=
  W.projectionValue_eq i v N hN

theorem D_projection (i : σ) (v : M) : W.D i (W.projection i v) = 0 := by
  rw [W.projection_eq i v (W.cutoff i v) (W.cutoff_succ_spec i v),
    Taylor.D_finite _ _ (by intro z; simpa using W.dx i i z),
    W.cutoff_succ_spec, map_zero, smul_zero]

theorem projection_eq_self (i : σ) (v : M) (hv : W.D i v = 0) :
    W.projection i v = v := by
  change Taylor.finite (W.X i) (W.D i) (W.cutoff i v) v = v
  exact Taylor.finite_eq_self _ _ _ _ hv

theorem projection_X (i : σ) (v : M) : W.projection i (W.X i v) = 0 := by
  let N := W.cutoff i v
  have hv : (W.D i ^ N) v = 0 := W.cutoff_spec i v
  have hv' : (W.D i ^ (N + 1)) v = 0 := W.cutoff_succ_spec i v
  have hx : (W.D i ^ (N + 1)) (W.X i v) = 0 := by
    rw [Taylor.D_pow_X _ _ (by intro z; simpa using W.dx i i z)]
    simp [hv, hv']
  rw [W.projection_eq i (W.X i v) N hx,
    Taylor.finite_X _ _ (by intro z; simpa using W.dx i i z), hv,
    map_zero, smul_zero]

theorem projection_idempotent (i : σ) :
    W.projection i * W.projection i = W.projection i := by
  apply LinearMap.ext
  intro v
  exact W.projection_eq_self i _ (W.D_projection i v)

/-- Any endomorphism commuting with X_i and D_i commutes with the
cutoff-independent projector. No uniform nilpotence of that endomorphism
is assumed. -/
theorem commute_projection (i : σ) (T : Module.End K M)
    (hX : Commute T (W.X i)) (hD : Commute T (W.D i)) :
    Commute T (W.projection i) := by
  apply LinearMap.ext
  intro v
  let N := W.cutoff i v
  have hv : (W.D i ^ (N + 1)) v = 0 := W.cutoff_succ_spec i v
  have ht : (W.D i ^ (N + 1)) (T v) = 0 := by
    rw [← Module.End.mul_apply, ← (hD.pow_right (N + 1)).eq,
      Module.End.mul_apply, hv, map_zero]
  change T (W.projection i v) = W.projection i (T v)
  rw [W.projection_eq i v N hv, W.projection_eq i (T v) N ht]
  exact commute_apply _ _ (Taylor.commute_finite _ _ T hX hD N) v

theorem D_commute_projection {i j : σ} (hij : i ≠ j) :
    Commute (W.D i) (W.projection j) :=
  W.commute_projection j (W.D i) (W.dx_of_ne hij) (W.dd i j)

theorem X_commute_projection {i j : σ} (hij : i ≠ j) :
    Commute (W.X i) (W.projection j) :=
  W.commute_projection j (W.X i) (W.xx i j) (W.dx_of_ne (Ne.symm hij)).symm

theorem projections_commute (i j : σ) : Commute (W.projection i) (W.projection j) := by
  by_cases hij : i = j
  · subst j; exact Commute.refl _
  · exact W.commute_projection j (W.projection i)
      (W.X_commute_projection (Ne.symm hij)).symm
      (W.D_commute_projection (Ne.symm hij)).symm

/-- Projecting in one coordinate preserves every other derivative kernel. -/
theorem projection_preserves_kernel (i j : σ) (v : M) (hv : W.D j v = 0) :
    W.D j (W.projection i v) = 0 := by
  by_cases hji : j = i
  · subst j; exact W.D_projection i v
  · rw [commute_apply _ _ (W.D_commute_projection hji) v, hv, map_zero]

/-- A finite product of the commuting coordinate projectors. -/
def finiteProjection (s : Finset σ) : Module.End K M :=
  s.noncommProd W.projection (fun i _ j _ _ => W.projections_commute i j)

@[simp] theorem finiteProjection_empty : W.finiteProjection ∅ = 1 := by
  simp [finiteProjection]

theorem finiteProjection_insert (i : σ) (s : Finset σ) (hi : i ∉ s) :
    W.finiteProjection (insert i s) = W.projection i * W.finiteProjection s := by
  exact Finset.noncommProd_insert_of_notMem _ _ _ _ hi

theorem finiteProjection_fixes (s : Finset σ) (v : M)
    (hv : ∀ i ∈ s, W.D i v = 0) : W.finiteProjection s v = v := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    rw [W.finiteProjection_insert i s hi, Module.End.mul_apply,
      ih (fun j hj => hv j (Finset.mem_insert_of_mem hj)),
      W.projection_eq_self i v (hv i (Finset.mem_insert_self _ _))]

theorem finiteProjection_preserves_kernel (s : Finset σ) (j : σ) (v : M)
    (hv : W.D j v = 0) : W.D j (W.finiteProjection s v) = 0 := by
  induction s using Finset.induction_on with
  | empty => simpa using hv
  | @insert i s hi ih =>
    rw [W.finiteProjection_insert i s hi, Module.End.mul_apply]
    exact W.projection_preserves_kernel i j _ ih

/-- Independence of a *finite index cutoff*, in addition to the preceding
independence of each nilpotence cutoff. -/
theorem finiteProjection_enlarge (s t : Finset σ) (hst : s ⊆ t) (v : M)
    (hv : ∀ i ∈ t \ s, W.D i v = 0) :
    W.finiteProjection t v = W.finiteProjection s v := by
  have hu : s ∪ (t \ s) = t := Finset.union_sdiff_of_subset hst
  unfold finiteProjection
  rw [← hu, Finset.noncommProd_union_of_disjoint Finset.disjoint_sdiff,
    Module.End.mul_apply]
  change W.finiteProjection s (W.finiteProjection (t \ s) v) = _
  rw [W.finiteProjection_fixes (t \ s) v hv]
  rfl

def vacuumValue (v : M) : M := W.finiteProjection (W.active v) v

theorem vacuumValue_eq (s : Finset σ) (v : M) (hv : W.active v ⊆ s) :
    W.vacuumValue v = W.finiteProjection s v := by
  apply Eq.symm
  apply W.finiteProjection_enlarge _ _ hv
  intro i hi
  have hn := (Finset.mem_sdiff.mp hi).2
  simpa using hn

theorem vacuumValue_add (v z : M) : W.vacuumValue (v + z) = W.vacuumValue v + W.vacuumValue z := by
  let s := W.active v ∪ W.active z
  rw [W.vacuumValue_eq s (v + z) (W.active_add_subset v z),
    W.vacuumValue_eq s v Finset.subset_union_left,
    W.vacuumValue_eq s z Finset.subset_union_right, map_add]

theorem vacuumValue_smul (c : K) (v : M) : W.vacuumValue (c • v) = c • W.vacuumValue v := by
  rw [W.vacuumValue_eq (W.active v) (c • v) (W.active_smul_subset c v)]
  exact map_smul (W.finiteProjection (W.active v)) c v

/-- The canonical, cutoff-independent, arbitrary-index Taylor projector. -/
def vacuumProjection : Module.End K M where
  toFun := W.vacuumValue
  map_add' := W.vacuumValue_add
  map_smul' := W.vacuumValue_smul

theorem vacuumProjection_eq (s : Finset σ) (v : M) (hv : W.active v ⊆ s) :
    W.vacuumProjection v = W.finiteProjection s v := W.vacuumValue_eq s v hv

theorem vacuumProjection_mem (v : M) : W.vacuumProjection v ∈ W.vacuum := by
  rw [W.mem_vacuum]
  intro i
  rw [W.vacuumProjection_eq (insert i (W.active v)) v (Finset.subset_insert _ _)]
  unfold finiteProjection
  rw [← Finset.mul_noncommProd_erase _ (Finset.mem_insert_self i (W.active v))
    W.projection (fun j _ k _ _ => W.projections_commute j k),
    Module.End.mul_apply]
  exact W.D_projection i _

theorem vacuumProjection_eq_self (v : M) (hv : v ∈ W.vacuum) :
    W.vacuumProjection v = v := by
  change W.finiteProjection (W.active v) v = v
  apply W.finiteProjection_fixes
  intro i hi
  exact (W.mem_vacuum v).mp hv i

theorem vacuumProjection_X (i : σ) (v : M) : W.vacuumProjection (W.X i v) = 0 := by
  rw [W.vacuumProjection_eq (insert i (W.active (W.X i v))) _ (Finset.subset_insert _ _)]
  unfold finiteProjection
  rw [← Finset.noncommProd_erase_mul _ (Finset.mem_insert_self i (W.active (W.X i v)))
    W.projection (fun j _ k _ _ => W.projections_commute j k),
    Module.End.mul_apply, W.projection_X, map_zero]

def vacuumProject : M →ₗ[K] W.vacuum :=
  W.vacuumProjection.codRestrict W.vacuum W.vacuumProjection_mem

@[simp] theorem vacuumProject_coe (v : M) : (W.vacuumProject v : M) = W.vacuumProjection v := rfl

@[simp] theorem vacuumProject_subtype (v : W.vacuum) : W.vacuumProject v = v := by
  apply Subtype.ext
  exact W.vacuumProjection_eq_self v v.property

theorem vacuumProjection_idempotent : W.vacuumProjection * W.vacuumProjection = W.vacuumProjection := by
  apply LinearMap.ext
  intro v
  exact W.vacuumProjection_eq_self _ (W.vacuumProjection_mem v)

/-- Multiindex factorial; its empty value is 1. -/
def factorial (d : σ →₀ ℕ) : ℕ := d.prod (fun _ n => n.factorial)

theorem factorial_pos (d : σ →₀ ℕ) : 0 < factorial d := by
  unfold factorial Finsupp.prod
  exact Finset.prod_pos (fun _ _ => Nat.factorial_pos _)

theorem factorial_cast_ne_zero (d : σ →₀ ℕ) : (factorial d : K) ≠ 0 := by
  exact_mod_cast (Nat.ne_of_gt (factorial_pos d))

@[simp] theorem factorial_zero : factorial (0 : σ →₀ ℕ) = 1 := by simp [factorial]

/-- Exact factorial coefficient extraction. Its values lie in the vacuum;
its support and the inverse identities are scripted below. -/
def coefficient (d : σ →₀ ℕ) : M →ₗ[K] W.vacuum :=
  (factorial d : K)⁻¹ • (W.vacuumProject.comp (W.derivative d))

theorem coefficient_eq_zero_of_derivative (d : σ →₀ ℕ) (v : M)
    (hv : W.derivative d v = 0) : W.coefficient d v = 0 := by
  simp [coefficient, hv]

theorem coefficient_support_subset (v : M) :
    Function.support (fun d : σ →₀ ℕ => W.coefficient d v) ⊆
      (Finset.Iic (W.jointCutoff v) : Set (σ →₀ ℕ)) := by
  intro d hd
  apply Finset.mem_Iic.mpr
  by_contra hn
  exact hd (W.coefficient_eq_zero_of_derivative d v
    (W.derivative_eq_zero_of_not_le v _ d (W.jointCutoff_spec v) hn))

theorem coefficient_support_finite (v : M) :
    Function.HasFiniteSupport (fun d : σ →₀ ℕ => W.coefficient d v) := by
  apply (W.derivative_support_finite v).subset
  intro d hd
  show W.derivative d v ≠ 0
  intro hz
  exact hd (W.coefficient_eq_zero_of_derivative d v hz)

/-- Finite coefficient data, constructed without assuming a normal form. -/
def coefficients : M →ₗ[K] ((σ →₀ ℕ) →₀ W.vacuum) where
  toFun v := Finsupp.ofSupportFinite (fun d => W.coefficient d v) (W.coefficient_support_finite v)
  map_add' v z := by
    apply Finsupp.ext
    intro d
    exact map_add (W.coefficient d) v z
  map_smul' c v := by
    apply Finsupp.ext
    intro d
    exact map_smul (W.coefficient d) c v

@[simp] theorem coefficients_apply (v : M) (d : σ →₀ ℕ) :
    W.coefficients v d = W.coefficient d v := rfl

def evaluate : ((σ →₀ ℕ) →₀ W.vacuum) →ₗ[K] M :=
  Finsupp.lsum K (fun d => (W.creation d).comp W.vacuum.subtype)

@[simp] theorem evaluate_single (d : σ →₀ ℕ) (v : W.vacuum) :
    W.evaluate (Finsupp.single d v) = W.creation d v := by simp [evaluate]

/-- The natural polynomial-tensor-to-representation map. A polynomial
monomial acts by the actual commuting creators on the included vacuum. -/
def fockMap : (MvPolynomial σ K ⊗[K] W.vacuum) →ₗ[K] M :=
  W.evaluate.comp
    (TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K)).toLinearMap

/-- Explicit inverse formula, using finite coefficient support. -/
def fockInverse : M →ₗ[K] (MvPolynomial σ K ⊗[K] W.vacuum) :=
  (TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K)).symm.toLinearMap.comp
    W.coefficients

theorem fockMap_monomial (d : σ →₀ ℕ) (v : W.vacuum) :
    W.fockMap (MvPolynomial.monomial d (1 : K) ⊗ₜ[K] v) = W.creation d v := by
  change W.evaluate
    ((TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K))
      ((MvPolynomial.basisMonomials σ K) d ⊗ₜ[K] v)) = _
  rw [TensorProduct.equivFinsuppOfBasisLeft_apply_tmul, Module.Basis.repr_self]
  simp

/-- Nilpotence and finite active support force generation from the joint
vacuum. The proof is a finite-support induction followed by a nilpotence
induction, using the actual Taylor projector; no generation assumption is
hidden in `WeylData`. This form avoids any choice of a basis of M. -/
theorem generated_by_vacuum (U : Submodule K M)
    (hΩ : W.vacuum ≤ U)
    (hX : ∀ i v, v ∈ U → W.X i v ∈ U) (v : M) : v ∈ U := by
  have hpowers : ∀ (i : σ) (k : ℕ) (z : M), z ∈ U → (W.X i ^ k) z ∈ U := by
    intro i k
    induction k with
    | zero => intro z hz; simpa using hz
    | succ k ih =>
      intro z hz
      rw [pow_succ', Module.End.mul_apply]
      exact hX i _ (ih z hz)
  have aux : ∀ s : Finset σ, ∀ z : M,
      (∀ j, j ∉ s → W.D j z = 0) → z ∈ U := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      intro z hz
      apply hΩ
      rw [W.mem_vacuum]
      intro j
      exact hz j (Finset.notMem_empty j)
    | @insert i s hi outer =>
      have inner : ∀ N : ℕ, ∀ z : M,
          (∀ j, j ∉ insert i s → W.D j z = 0) → (W.D i ^ N) z = 0 → z ∈ U := by
        intro N
        induction N with
        | zero =>
          intro z hz hnil
          have he : z = 0 := by simpa using hnil
          simpa [he] using U.zero_mem
        | succ N ih =>
          intro z hz hnil
          have hproj : W.projection i z ∈ U := by
            apply outer
            intro j hjs
            by_cases hji : j = i
            · subst j
              exact W.D_projection i z
            · exact W.projection_preserves_kernel i j z (hz j (by simp [hji, hjs]))
          let term : ℕ → M := fun k => Taylor.coefficient K k •
            (W.X i ^ k) ((W.D i ^ k) z)
          have htail : (∑ k ∈ (Finset.range (N + 1)).erase 0, term k) ∈ U := by
            apply Submodule.sum_mem
            intro k hk
            have hk0 : k ≠ 0 := (Finset.mem_erase.mp hk).1
            have hderiv : (W.D i ^ k) z ∈ U := by
              apply ih
              · intro j hj
                rw [commute_apply _ _ ((W.dd j i).pow_right k) z,
                  hz j hj, map_zero]
              · rw [← Module.End.mul_apply, ← pow_add]
                exact Module.End.pow_map_zero_of_le (by omega) hnil
            exact U.smul_mem _ (hpowers i k _ hderiv)
          have he : W.projection i z =
              (∑ k ∈ (Finset.range (N + 1)).erase 0, term k) + z := by
            rw [W.projection_eq i z N hnil]
            have hs := Finset.sum_erase_add (Finset.range (N + 1)) term
              (show 0 ∈ Finset.range (N + 1) by simp)
            simpa [Taylor.finite, term, LinearMap.sum_apply, LinearMap.smul_apply,
              Module.End.mul_apply] using hs.symm
          have hm := U.sub_mem hproj htail
          rw [he] at hm
          simpa only [add_sub_cancel_left] using hm
      intro z hz
      obtain ⟨N, hN⟩ := W.nilpotent i z
      exact inner N z hz hN
  apply aux (W.active v) v
  intro j hj
  simpa using hj

theorem range_evaluate_stable (i : σ) (v : M) (hv : v ∈ LinearMap.range W.evaluate) :
    W.X i v ∈ LinearMap.range W.evaluate := by
  obtain ⟨f, rfl⟩ := hv
  change W.X i (f.sum (fun d ω => W.creation d ω)) ∈ LinearMap.range W.evaluate
  rw [Finsupp.sum, map_sum]
  apply Submodule.sum_mem
  intro d hd
  refine ⟨Finsupp.single (d + Finsupp.single i 1) (f d), ?_⟩
  rw [W.evaluate_single, W.creation_add_single, Module.End.mul_apply]

/-- Finite reconstruction, with arbitrary σ and arbitrary M, as an actual
finite sum of creation monomials applied to joint vacua. It is proved by
generation, independently of the coefficient-extraction inverse identity. -/
theorem finite_reconstruction (v : M) :
    ∃ f : (σ →₀ ℕ) →₀ W.vacuum, W.evaluate f = v := by
  apply W.generated_by_vacuum (LinearMap.range W.evaluate)
  · intro z hz
    refine ⟨Finsupp.single 0 ⟨z, hz⟩, ?_⟩
    simp
  · exact W.range_evaluate_stable

theorem fockMap_surjective : Function.Surjective W.fockMap := by
  intro v
  obtain ⟨f, hf⟩ := W.finite_reconstruction v
  refine ⟨(TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K)).symm f, ?_⟩
  change W.evaluate ((TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K))
    ((TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K)).symm f)) = v
  rw [LinearEquiv.apply_symm_apply]
  exact hf

/-- Moving one creator through an arbitrary mixed derivative. The
coefficient is the actual occupation number, without a degree bound. -/
theorem derivative_X (d : σ →₀ ℕ) (i : σ) (v : M) :
    W.derivative d (W.X i v) = W.X i (W.derivative d v) +
      (d i : K) • W.derivative (d - Finsupp.single i 1) v := by
  by_cases hdi : d i = 0
  · have hc : Commute (W.X i) (W.derivative d) := by
      apply Finset.noncommProd_commute
      intro j hj
      have hji : j ≠ i := by
        intro he
        subst j
        exact (Finsupp.mem_support_iff.mp hj) hdi
      exact ((W.dx_of_ne hji).symm).pow_right _
    simpa [hdi] using (commute_apply _ _ hc v).symm
  · let e := d - Finsupp.single i 1
    let s := insert i d.support
    let R : Module.End K M := (s.erase i).noncommProd (fun j => W.D j ^ d j)
      (fun j _ k _ _ => (W.dd j k).pow_pow _ _)
    have hi : i ∈ s := Finset.mem_insert_self _ _
    have hd : d.support ⊆ s := Finset.subset_insert _ _
    have he : e.support ⊆ s := by
      intro j hj
      by_cases hjs : j ∈ d.support
      · exact Finset.mem_insert_of_mem hjs
      · have hdj : d j = 0 := Finsupp.notMem_support_iff.mp hjs
        exact False.elim ((Finsupp.mem_support_iff.mp hj) (by simp [e, Finsupp.tsub_apply, hdj]))
    have hrest : (s.erase i).noncommProd (fun j => W.D j ^ e j)
        (fun j _ k _ _ => (W.dd j k).pow_pow _ _) = R := by
      apply Finset.noncommProd_congr rfl
      intro j hj
      have hji := (Finset.mem_erase.mp hj).1
      simp [e, Finsupp.tsub_apply, Finsupp.single_apply, hji, Ne.symm hji]
    have hdop : W.derivative d = W.D i ^ d i * R := by
      rw [derivative, monomialOperator_on W.D W.dd d s hd]
      exact (Finset.mul_noncommProd_erase s hi (fun j => W.D j ^ d j)
        (fun j _ k _ _ => (W.dd j k).pow_pow _ _)).symm
    have heop : W.derivative e = W.D i ^ (d i - 1) * R := by
      rw [derivative, monomialOperator_on W.D W.dd e s he,
        ← Finset.mul_noncommProd_erase s hi (fun j => W.D j ^ e j)
          (fun j _ k _ _ => (W.dd j k).pow_pow _ _), hrest]
      simp [e, Finsupp.tsub_apply]
    have hc : Commute (W.X i) R := by
      apply Finset.noncommProd_commute
      intro j hj
      have hji : j ≠ i := (Finset.mem_erase.mp hj).1
      exact ((W.dx_of_ne hji).symm).pow_right _
    change W.derivative d (W.X i v) = W.X i (W.derivative d v) +
      (d i : K) • W.derivative e v
    rw [hdop, heop]
    simp only [Module.End.mul_apply]
    rw [← commute_apply _ _ hc v]
    have hnat : d i - 1 + 1 = d i := by omega
    have hcast : ((d i - 1 : ℕ) : K) + 1 = (d i : K) := by exact_mod_cast hnat
    have hrec := Taylor.D_pow_X (W.X i) (W.D i)
      (by intro z; simpa using W.dx i i z) (d i - 1) (R v)
    rw [hnat, hcast] at hrec
    exact hrec

/-- Adapted directly from the exact immutable FactorialFockMetric
`weight_eq_prod` proof; no Hilbert-space dependency is needed here. -/
theorem factorial_eq_prod (d : σ →₀ ℕ) (s : Finset σ) (hs : d.support ⊆ s) :
    factorial d = ∏ i ∈ s, (d i).factorial :=
  Finsupp.prod_of_support_subset d hs (fun _ n => n.factorial) (by simp)

/-- The following finite-product proof is reused from immutable
FactorialFockMetric.weight_add_single, with weight renamed factorial.
Supplier SHA256: a10fe2644c2b4e110479db69ef7bd66fd4497c115d25a816f12f0bf4214e91fb.
It is a consumed normalization helper, not a new novelty claim. -/
theorem factorial_add_single (d : σ →₀ ℕ) (i : σ) :
    factorial (d + Finsupp.single i 1) = (d i + 1) * factorial d := by
  let s := insert i d.support
  have hi : i ∈ s := Finset.mem_insert_self _ _
  have hd : d.support ⊆ s := Finset.subset_insert _ _
  have hds : (d + Finsupp.single i 1).support ⊆ s := by
    intro x hx
    rcases Finset.mem_union.mp (Finsupp.support_add hx) with hx | hx
    · exact Finset.mem_insert_of_mem hx
    · have hxi : x = i := Finset.mem_singleton.mp (Finsupp.support_single_subset hx)
      subst x
      exact hi
  have hrest : (∏ x ∈ s.erase i, ((d + Finsupp.single i 1 : σ →₀ ℕ) x).factorial) =
      ∏ x ∈ s.erase i, (d x).factorial := by
    apply Finset.prod_congr rfl
    intro x hx
    have hxi : x ≠ i := (Finset.mem_erase.mp hx).1
    simp [Finsupp.single_apply, hxi, Ne.symm hxi]
  rw [factorial_eq_prod _ s hds, factorial_eq_prod d s hd,
    ← Finset.mul_prod_erase s (fun x => ((d + Finsupp.single i 1 : σ →₀ ℕ) x).factorial) hi,
    ← Finset.mul_prod_erase s (fun x => (d x).factorial) hi, hrest]
  simp only [Finsupp.add_apply, Finsupp.single_eq_same]
  rw [Nat.factorial_succ]
  exact mul_assoc _ _ _

theorem restore_sub_single (d : σ →₀ ℕ) (i : σ) (hi : 0 < d i) :
    (d - Finsupp.single i 1) + Finsupp.single i 1 = d := by
  ext j
  by_cases hji : j = i
  · subst j
    simp only [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_eq_same]
    omega
  · simp [Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply, hji, Ne.symm hji]

theorem coefficient_X_of_zero (d : σ →₀ ℕ) (i : σ) (v : M) (hi : d i = 0) :
    W.coefficient d (W.X i v) = 0 := by
  apply Subtype.ext
  change (factorial d : K)⁻¹ • W.vacuumProjection (W.derivative d (W.X i v)) = 0
  rw [W.derivative_X, hi]
  simp [W.vacuumProjection_X]

theorem coefficient_X_of_pos (d : σ →₀ ℕ) (i : σ) (v : M) (hi : 0 < d i) :
    W.coefficient d (W.X i v) = W.coefficient (d - Finsupp.single i 1) v := by
  let e := d - Finsupp.single i 1
  have he : e + Finsupp.single i 1 = d := restore_sub_single d i hi
  have hfac : factorial d = d i * factorial e := by
    have h := factorial_add_single e i
    have hei : e i + 1 = d i := by simp only [e, Finsupp.tsub_apply, Finsupp.single_eq_same]; omega
    rw [he, hei] at h
    exact h
  have hdi : (d i : K) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hi
  have hfe : (factorial e : K) ≠ 0 := factorial_cast_ne_zero e
  have hscalar : (factorial d : K)⁻¹ * (d i : K) = (factorial e : K)⁻¹ := by
    rw [hfac, Nat.cast_mul]
    field_simp
    <;> ring
  apply Subtype.ext
  change (factorial d : K)⁻¹ • W.vacuumProjection (W.derivative d (W.X i v)) =
    (factorial e : K)⁻¹ • W.vacuumProjection (W.derivative e v)
  rw [W.derivative_X, map_add, map_smul, W.vacuumProjection_X, zero_add,
    smul_smul, hscalar]

theorem coefficient_vacuum (ω : W.vacuum) (d : σ →₀ ℕ) :
    W.coefficient d ω = if d = 0 then ω else 0 := by
  by_cases hd : d = 0
  · subst d
    simp [coefficient]
  · have hnot : ¬ d ≤ (0 : σ →₀ ℕ) := by
      intro h
      apply hd
      ext i
      have hi := h i
      simpa using hi
    have hz : W.derivative d ω = 0 :=
      W.derivative_eq_zero_of_not_le ω 0 d
        (by intro i; simpa using (W.mem_vacuum ω).mp ω.property i) hnot
    rw [W.coefficient_eq_zero_of_derivative d ω hz, if_neg hd]

/-- Factorial coefficient extraction on every creation monomial. This is
the separation statement needed for injectivity, proved without assuming
linear independence of those monomials in M. -/
theorem coefficient_creation (e : σ →₀ ℕ) (ω : W.vacuum) :
    ∀ d : σ →₀ ℕ, W.coefficient d (W.creation e ω) = if d = e then ω else 0 := by
  induction e using Finsupp.induction with
  | zero =>
    intro d
    simpa using W.coefficient_vacuum ω d
  | single_add i n e hi hn ih =>
    have hall : ∀ m : ℕ, ∀ d : σ →₀ ℕ,
        W.coefficient d (W.creation (e + Finsupp.single i m) ω) =
          if d = e + Finsupp.single i m then ω else 0 := by
      intro m
      induction m with
      | zero => simpa using ih
      | succ m ihm =>
        intro d
        have he : e + Finsupp.single i (m + 1) =
            (e + Finsupp.single i m) + Finsupp.single i 1 := by
          rw [Finsupp.single_add]
          abel
        rw [he, W.creation_add_single, Module.End.mul_apply]
        by_cases hdi : d i = 0
        · rw [W.coefficient_X_of_zero d i _ hdi]
          have hne : d ≠ (e + Finsupp.single i m) + Finsupp.single i 1 := by
            intro h
            have hcoord := congrArg (fun t : σ →₀ ℕ => t i) h
            simp only [Finsupp.add_apply, Finsupp.single_eq_same] at hcoord
            omega
          simp [hne]
        · have hpos : 0 < d i := by omega
          rw [W.coefficient_X_of_pos d i _ hpos, ihm]
          have hiff : d - Finsupp.single i 1 = e + Finsupp.single i m ↔
              d = (e + Finsupp.single i m) + Finsupp.single i 1 := by
            constructor
            · intro h
              rw [← restore_sub_single d i hpos, h]
            · intro h
              rw [h]
              ext j
              by_cases hji : j = i
              · subst j
                simp [Finsupp.tsub_apply]
              · simp [Finsupp.tsub_apply, Finsupp.single_apply, hji, Ne.symm hji]
          simp only [hiff]
    simpa only [add_comm (Finsupp.single i n) e] using hall n

/-- First inverse identity, on the finite coefficient module. -/
theorem coefficients_evaluate (f : (σ →₀ ℕ) →₀ W.vacuum) :
    W.coefficients (W.evaluate f) = f := by
  induction f using Finsupp.induction_linear with
  | zero => simp
  | add f g hf hg => simp [hf, hg]
  | single e ω =>
    ext d
    rw [W.evaluate_single, W.coefficients_apply, W.coefficient_creation]
    simp [Finsupp.single_apply, eq_comm]

/-- Second inverse identity: finite generation was proved independently,
so the separation identity now identifies the constructed coefficients of
every arbitrary representation vector. -/
theorem evaluate_coefficients (v : M) : W.evaluate (W.coefficients v) = v := by
  obtain ⟨f, hf⟩ := W.finite_reconstruction v
  rw [← hf, W.coefficients_evaluate]

theorem fockMap_fockInverse (v : M) : W.fockMap (W.fockInverse v) = v := by
  change W.evaluate ((TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K))
    ((TensorProduct.equivFinsuppOfBasisLeft (MvPolynomial.basisMonomials σ K)).symm (W.coefficients v))) = v
  rw [LinearEquiv.apply_symm_apply]
  exact W.evaluate_coefficients v

theorem fockInverse_fockMap (t : MvPolynomial σ K ⊗[K] W.vacuum) :
    W.fockInverse (W.fockMap t) = t := by
  simp [fockMap, fockInverse, W.coefficients_evaluate]

/-- Classical arbitrary-index algebraic Weyl/Fock reconstruction.
All representation hypotheses are exactly the fields of WeylData.
The separate native artifacts record compilation and the axiom closure. -/
def fockEquiv : (MvPolynomial σ K ⊗[K] W.vacuum) ≃ₗ[K] M where
  toLinearMap := W.fockMap
  invFun := W.fockInverse
  left_inv := W.fockInverse_fockMap
  right_inv := W.fockMap_fockInverse

/-- The explicit finite Taylor reconstruction on a derived simultaneous
box, with the factorial normalization visible in the conclusion. -/
theorem taylor_reconstruction (v : M) :
    (∑ d ∈ Finset.Iic (W.jointCutoff v), (factorial d : K)⁻¹ •
      W.creation d (W.vacuumProjection (W.derivative d v))) = v := by
  have hs : (W.coefficients v).support ⊆ Finset.Iic (W.jointCutoff v) := by
    intro d hd
    apply W.coefficient_support_subset v
    simpa only [Function.mem_support, ← W.coefficients_apply] using
      Finsupp.mem_support_iff.mp hd
  have hsum : (∑ d ∈ Finset.Iic (W.jointCutoff v), W.creation d (W.coefficient d v)) =
      ∑ d ∈ (W.coefficients v).support, W.creation d (W.coefficient d v) := by
    symm
    apply Finset.sum_subset hs
    intro d hd hnot
    have hz : W.coefficient d v = 0 := by
      simpa only [← W.coefficients_apply] using Finsupp.notMem_support_iff.mp hnot
    simp [hz]
  have he := W.evaluate_coefficients v
  change (∑ d ∈ (W.coefficients v).support, W.creation d (W.coefficient d v)) = v at he
  rw [← hsum] at he
  simpa only [coefficient, LinearMap.smul_apply, LinearMap.comp_apply,
    Submodule.coe_smul, vacuumProject_coe, map_smul] using he

end WeylData

/-! Positive-integer oscillator frequencies and an honest grading interface.

This consumer starts from *operators on an arbitrary module*, not a
polynomial carrier. In a standard VOA application the current commutator
has to be supplied from the module Jacobi identity, and the grade-lowering
law from the conformal/current law. Neither bridge is asserted here.
-/

namespace PositiveCurrents

variable {ι : Type v} [Fintype ι]

/-- The full integer-mode current relation on the actual arbitrary M.
No positivity of the finite Gram matrix is required. Its inverse is passed
to the normalization, including the empty matrix. -/
structure CurrentData (K : Type u) (ι : Type v) (M : Type w)
    [Field K] [CharZero K] [AddCommGroup M] [Module K M] where
  gram : Matrix ι ι K
  mode : ι → ℤ → Module.End K M
  heisenberg : ∀ a b m n,
    mode a m * mode b n - mode b n * mode a m =
      (if m + n = 0 then (m : K) * gram a b else 0) • 1

variable (A : CurrentData K ι M)

/-- Positive integer frequency is n+1; the natural slot n=0 is frequency 1. -/
def X (p : ι × ℕ) : Module.End K M := A.mode p.1 (-(p.2 : ℤ) - 1)

/-- Inverse-Gram normalization: (n+1)^(-1) sum_b H_ab a_b(n+1).
Scaling, including the reciprocal frequency, is entirely explicit. -/
def D (H : Matrix ι ι K) (p : ι × ℕ) : Module.End K M :=
  ∑ b : ι, (((p.2 + 1 : ℕ) : K)⁻¹ * H p.1 b) • A.mode b ((p.2 : ℤ) + 1)

theorem mode_commute_of_nonresonant (a b : ι) (m n : ℤ) (h : m + n ≠ 0) :
    Commute (A.mode a m) (A.mode b n) := by
  exact sub_eq_zero.mp (by simpa [h] using A.heisenberg a b m n)

theorem X_commute (p q : ι × ℕ) : Commute ((X A) p) ((X A) q) :=
  (mode_commute_of_nonresonant A) _ _ _ _ (by omega)

theorem smul_commute_smul (T U : Module.End K M) (h : Commute T U) (c d : K) :
    Commute (c • T) (d • U) := by
  change (c • T) * (d • U) = (d • U) * (c • T)
  simp only [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, smul_smul]
  rw [h.eq, mul_comm c d]

theorem D_commute (H : Matrix ι ι K) (p q : ι × ℕ) :
    Commute ((D A) H p) ((D A) H q) := by
  unfold D
  apply Commute.sum_left
  intro b hb
  apply Commute.sum_right
  intro c hc
  apply smul_commute_smul
  exact (mode_commute_of_nonresonant A) b c _ _ (by omega)

/-- The normalized commutator contracts the actual inverse-Gram row. -/
theorem D_X_commutator (H : Matrix ι ι K) (hHG : H * A.gram = 1)
    (p q : ι × ℕ) :
    (D A) H p * (X A) q - (X A) q * (D A) H p =
      (if p = q then (1 : K) else 0) • 1 := by
  rcases p with ⟨a, n⟩
  rcases q with ⟨c, m⟩
  change (∑ b : ι, (((n + 1 : ℕ) : K)⁻¹ * H a b) • A.mode b ((n : ℤ) + 1)) *
      A.mode c (-(m : ℤ) - 1) -
    A.mode c (-(m : ℤ) - 1) *
      (∑ b : ι, (((n + 1 : ℕ) : K)⁻¹ * H a b) • A.mode b ((n : ℤ) + 1)) = _
  rw [Finset.sum_mul, Finset.mul_sum, ← Finset.sum_sub_distrib]
  simp_rw [Algebra.smul_mul_assoc, Algebra.mul_smul_comm, ← smul_sub, A.heisenberg]
  by_cases hnm : n = m
  · subst m
    simp only [show (n : ℤ) + 1 + (-(n : ℤ) - 1) = 0 by omega,
      if_true, Int.cast_add, Int.cast_natCast, Int.cast_one, smul_smul]
    have hn : (n + 1 : K) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
    have hs : ∀ b : ι,
        (((n + 1 : ℕ) : K)⁻¹ * H a b) * ((n + 1 : K) * A.gram b c) =
          H a b * A.gram b c := by
      intro b
      push_cast
      field_simp
      <;> ring
    simp_rw [hs]
    rw [← Finset.sum_smul]
    have hrow : ∑ b : ι, H a b * A.gram b c = if a = c then 1 else 0 := by
      simpa [Matrix.mul_apply, Matrix.one_apply] using congrArg
        (fun T : Matrix ι ι K => T a c) hHG
    rw [hrow]
    simp
  · have hnon : (n : ℤ) + 1 + (-(m : ℤ) - 1) ≠ 0 := by omega
    simp only [if_neg hnon, zero_smul, smul_zero, Finset.sum_const_zero]
    simp [Prod.mk.injEq, hnm]

theorem D_X (H : Matrix ι ι K) (hHG : H * A.gram = 1)
    (p q : ι × ℕ) (v : M) :
    (D A) H p ((X A) q v) = (X A) q ((D A) H p v) + if p = q then v else 0 := by
  have h := congrArg (fun T : Module.End K M => T v) ((D_X_commutator A) H hHG p q)
  have he : (D A) H p ((X A) q v) - (X A) q ((D A) H p v) = if p = q then v else 0 := by
    by_cases hpq : p = q <;> simpa [hpq] using h
  simpa only [add_comm] using (sub_eq_iff_eq_add.mp he)

/-- Algebraic lower-bounded grading/truncation interface. The decomposition
is only the usual finite homogeneous decomposition of a graded vector
space. It is not an oscillator/vacuum decomposition and does not require
finite-dimensional grades or semisimplicity of any zero mode. -/
structure LowerBounded (A : CurrentData K ι M) where
  grade : ℤ → Submodule K M
  lower : ℤ
  below : ∀ e : ℤ, e < lower → grade e = ⊥
  homogeneous : ∀ v : M, ∃ s : Finset ℤ, ∃ f : ℤ → M,
    (∀ e ∈ s, f e ∈ grade e) ∧ (∑ e ∈ s, f e) = v
  positive_lowers : ∀ a : ι, ∀ n : ℕ, ∀ e : ℤ, ∀ v ∈ grade e,
    A.mode a ((n : ℤ) + 1) v ∈ grade (e - ((n : ℤ) + 1))

variable (L : LowerBounded A)

theorem D_mem_grade (H : Matrix ι ι K) (p : ι × ℕ) (e : ℤ) (v : M)
    (hv : v ∈ L.grade e) : (D A) H p v ∈ L.grade (e - ((p.2 : ℤ) + 1)) := by
  simp only [D, LinearMap.sum_apply, LinearMap.smul_apply]
  apply Submodule.sum_mem
  intro b hb
  exact Submodule.smul_mem _ _ (L.positive_lowers b p.2 e v hv)

theorem D_pow_mem_grade (H : Matrix ι ι K) (p : ι × ℕ) (e : ℤ) (v : M)
    (hv : v ∈ L.grade e) (k : ℕ) :
    ((D A) H p ^ k) v ∈ L.grade (e - (k : ℤ) * ((p.2 : ℤ) + 1)) := by
  induction k with
  | zero => simpa using hv
  | succ k ih =>
    have h := (D_mem_grade A) L H p _ _ ih
    rw [show e - (k : ℤ) * ((p.2 : ℤ) + 1) - ((p.2 : ℤ) + 1) =
      e - ((k + 1 : ℕ) : ℤ) * ((p.2 : ℤ) + 1) by push_cast; ring] at h
    simpa only [pow_succ', Module.End.mul_apply] using h

theorem D_pow_eq_zero_below (H : Matrix ι ι K) (p : ι × ℕ) (e : ℤ) (v : M)
    (hv : v ∈ L.grade e) (k : ℕ)
    (hk : e - (k : ℤ) * ((p.2 : ℤ) + 1) < L.lower) :
    ((D A) H p ^ k) v = 0 := by
  have h := (D_pow_mem_grade A) L H p e v hv k
  rw [L.below _ hk] at h
  exact h

/-- Both finiteness hypotheses are *derived* from the grading. In fact this
consumer gives a simultaneous exponent and frequency bound on each input,
but never a global bound on M. -/
theorem graded_bounds (L : LowerBounded A) (H : Matrix ι ι K) (v : M) :
    ∃ B : ℕ,
      (∀ p : ι × ℕ, ((D A) H p ^ (B + 1)) v = 0) ∧
      (∀ p : ι × ℕ, B ≤ p.2 → (D A) H p v = 0) := by
  obtain ⟨s, f, hf, hsum⟩ := L.homogeneous v
  let B : ℕ := s.sup (fun e => (e - L.lower).toNat)
  have hb : ∀ e ∈ s, e ≤ L.lower + (B : ℤ) := by
    intro e he
    have heB : (e - L.lower).toNat ≤ B := Finset.le_sup (f := fun e => (e - L.lower).toNat) he
    omega
  refine ⟨B, ?_, ?_⟩
  · intro p
    rw [← hsum, map_sum]
    apply Finset.sum_eq_zero
    intro e he
    apply (D_pow_eq_zero_below A) L H p e (f e) (hf e he) (B + 1)
    have heB := hb e he
    have hprod : (B : ℤ) + 1 ≤ ((B : ℤ) + 1) * ((p.2 : ℤ) + 1) := by
      nlinarith [Int.natCast_nonneg B, Int.natCast_nonneg p.2,
        mul_nonneg (Int.natCast_nonneg B) (Int.natCast_nonneg p.2)]
    push_cast
    omega
  · intro p hp
    rw [← hsum, map_sum]
    apply Finset.sum_eq_zero
    intro e he
    have hz := (D_pow_eq_zero_below A) L H p e (f e) (hf e he) 1 (by
      have heB := hb e he
      push_cast
      omega)
    simpa using hz

theorem D_locally_nilpotent (L : LowerBounded A) (H : Matrix ι ι K) (p : ι × ℕ) (v : M) :
    ∃ n : ℕ, ((D A) H p ^ n) v = 0 := by
  obtain ⟨B, hB, _⟩ := (graded_bounds A) L H v
  exact ⟨B + 1, hB p⟩

theorem D_active_finite (L : LowerBounded A) (H : Matrix ι ι K) (v : M) :
    {p : ι × ℕ | (D A) H p v ≠ 0}.Finite := by
  obtain ⟨B, _, hB⟩ := (graded_bounds A) L H v
  apply (Finset.univ.product (Finset.range B)).finite_toSet.subset
  intro p hp
  have hlt : p.2 < B := by
    by_contra hn
    exact hp (hB p (by omega))
  simp [hlt]

/-- Actual arbitrary-module consumer of all Weyl hypotheses, including
local nilpotence and index finiteness, from finite inverse Gram currents
and the explicit lower-bounded grading interface. Empty ι is allowed. -/
def weylData (L : LowerBounded A) (H : Matrix ι ι K) (hHG : H * A.gram = 1) :
    WeylData K (ι × ℕ) M where
  X := (X A)
  D := (D A) H
  xx := (X_commute A)
  dd := (D_commute A) H
  dx := by
    intro p q v
    by_cases h : p = q <;> simpa [h] using D_X A H hHG p q v
  nilpotent := (D_locally_nilpotent A) L H
  active_finite := (D_active_finite A) L H

/-- This consumer already constructs a vacuum projector on the arbitrary
current representation, not just on an explicit polynomial Fock model. -/
def vacuumProject (H : Matrix ι ι K) (hHG : H * A.gram = 1) :
    M →ₗ[K] ((weylData A) L H hHG).vacuum := ((weylData A) L H hHG).vacuumProject

/-- Natural reconstruction map for the oscillator consumer. -/
def reconstructionMap (H : Matrix ι ι K) (hHG : H * A.gram = 1) :
    (MvPolynomial (ι × ℕ) K ⊗[K] ((weylData A) L H hHG).vacuum) →ₗ[K] M :=
  ((weylData A) L H hHG).fockMap

/-- Reconstruction for normalized currents, with both inverse identities
inherited from the substantive arbitrary-module proof above. -/
def normalizedFockEquiv (H : Matrix ι ι K) (hHG : H * A.gram = 1) :
    (MvPolynomial (ι × ℕ) K ⊗[K] ((weylData A) L H hHG).vacuum) ≃ₗ[K] M :=
  ((weylData A) L H hHG).fockEquiv

/-- The vacuum defined by the original positive current operators. -/
def positiveVacuum : Submodule K M :=
  ⨅ p : ι × ℕ, LinearMap.ker (A.mode p.1 ((p.2 : ℤ) + 1))

@[simp] theorem mem_positiveVacuum (v : M) :
    v ∈ (positiveVacuum A) ↔ ∀ p : ι × ℕ, A.mode p.1 ((p.2 : ℤ) + 1) v = 0 := by
  simp [positiveVacuum, LinearMap.mem_ker]

/-- Undoing the normalization on the original current operators. This
uses the other inverse-Gram equation, rather than assuming equality of
the two vacuum spaces. -/
theorem unnormalize (H : Matrix ι ι K) (hGH : A.gram * H = 1) (a : ι) (n : ℕ) :
    (n + 1 : K) • (∑ b : ι, A.gram a b • (D A) H (b, n)) =
      A.mode a ((n : ℤ) + 1) := by
  have hn : (n + 1 : K) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
  simp only [D, Finset.smul_sum, smul_smul]
  have hc : ∀ b c : ι, (n + 1 : K) * (A.gram a b *
      (((n + 1 : ℕ) : K)⁻¹ * H b c)) = A.gram a b * H b c := by
    intro b c
    push_cast
    field_simp
    <;> ring
  simp_rw [hc]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_smul]
  have hrow : ∀ c : ι, ∑ b : ι, A.gram a b * H b c = if a = c then 1 else 0 := by
    intro c
    simpa [Matrix.mul_apply, Matrix.one_apply] using congrArg
      (fun T : Matrix ι ι K => T a c) hGH
  simp_rw [hrow]
  simp

theorem normalized_vacuum_eq (H : Matrix ι ι K)
    (hHG : H * A.gram = 1) (hGH : A.gram * H = 1) :
    ((weylData A) L H hHG).vacuum = (positiveVacuum A) := by
  ext v
  rw [WeylData.mem_vacuum, (mem_positiveVacuum A)]
  change (∀ p : ι × ℕ, (D A) H p v = 0) ↔ _
  constructor
  · intro hv p
    have h := congrArg (fun T : Module.End K M => T v) ((unnormalize A) H hGH p.1 p.2)
    simpa [hv] using h.symm
  · intro hv p
    have hmode : ∀ b : ι, ∀ n : ℕ, A.mode b ((n : ℤ) + 1) v = 0 :=
      fun b n => hv (b, n)
    simp [D, hmode]

/-- The positive-integer oscillator consumer, on the original positive
current vacuum. This is the promised arbitrary finite nonsingular Gram
application; it asserts no lattice-VOA module/category equivalence. -/
def gradedFockEquiv (H : Matrix ι ι K)
    (hHG : H * A.gram = 1) (hGH : A.gram * H = 1) :
    (MvPolynomial (ι × ℕ) K ⊗[K] (positiveVacuum A)) ≃ₗ[K] M :=
  (LinearEquiv.lTensor (MvPolynomial (ι × ℕ) K)
    (LinearEquiv.ofEq (positiveVacuum A) ((weylData A) L H hHG).vacuum
      ((normalized_vacuum_eq A) L H hHG hGH).symm)).trans
        ((normalizedFockEquiv A) L H hHG)

/-- Nonsingularity may be supplied as `IsUnit det(G)`; mathlib constructs
the inverse, and the preceding proof performs the current normalization.
For K=Complex this is the complex oscillator-frequency application.
The empty Gram matrix has determinant 1 and is included. -/
def nonsingularFockEquiv (hG : IsUnit A.gram.det) :
    (MvPolynomial (ι × ℕ) K ⊗[K] (positiveVacuum A)) ≃ₗ[K] M :=
  (gradedFockEquiv A) L A.gram⁻¹ (Matrix.nonsing_inv_mul A.gram hG)
    (Matrix.mul_nonsing_inv A.gram hG)

end PositiveCurrents

end D5.S3.Quantum.Algebra.AlgebraicHeisenbergFock
