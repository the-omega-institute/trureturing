namespace MvPolynomial

/-!

## A. Rescaling the variables

-/

open scoped Classical in
/-- Rescaling each variable `Xᵢ` by a constant `d i` multiplies the coefficient of the monomial `m`
  by `∏ᵢ (d i) ^ (m i)`. -/
lemma coeff_aeval_diag {σ R : Type*} [CommRing R] (d : σ → R) (f : MvPolynomial σ R)
    (m : σ →₀ ℕ) :
    (aeval (fun i => C (d i) * X i) f).coeff m = (m.prod fun i k => d i ^ k) * f.coeff m := by
  induction f using MvPolynomial.induction_on generalizing m with
  | C a =>
    rw [aeval_C, MvPolynomial.algebraMap_eq, coeff_C]
    by_cases hm : (0 : σ →₀ ℕ) = m
    · subst hm; simp
    · rw [ite_eq_right hm, mul_zero]
  | add p q hp hq =>
    simp only [map_add, AddMonoidAlgebra.coeff_add, Finsupp.add_apply, hp m, hq m, mul_add]
  | mul_X p i hp =>
    rw [map_mul, aeval_X]
    have hrw : (aeval (fun i => C (d i) * X i) p) * (C (d i) * X i)
        = C (d i) * ((aeval (fun i => C (d i) * X i) p) * X i) := by
      rw [mul_left_comm]
    rw [hrw, coeff_C_mul, coeff_mul_X', coeff_mul_X']
    by_cases hi : i ∈ m.support
    · rw [ite_eq_left hi, ite_eq_left hi, hp (m - Finsupp.single i 1)]
      have hmi : 1 ≤ m i := Nat.one_le_iff_ne_zero.mpr (Finsupp.mem_support_iff.mp hi)
      have hle : Finsupp.single i 1 ≤ m := Finsupp.single_le_iff.mpr hmi
      have hsplit : m = (m - Finsupp.single i 1) + Finsupp.single i 1 :=
        (tsub_add_cancel_of_le hle).symm
      have hprod : (m.prod fun i k => d i ^ k)
          = ((m - Finsupp.single i 1).prod fun i k => d i ^ k) * d i := by
        conv_lhs => rw [hsplit]
        rw [Finsupp.prod_add_index' (by intro a; simp) (by intro a b c; rw [pow_add]),
          Finsupp.prod_single_index (by simp)]
        simp
      rw [hprod]
      ring
    · rw [ite_eq_right hi, ite_eq_right hi, mul_zero, mul_zero]

/-!

## B. Charge balancing

-/

/-- **Charge balancing.** If each variable `Xᵢ` carries an integer charge `w i`, `c` is a phase of
  infinite order, and the polynomial `f` is invariant under the charge rotation
  `Xᵢ ↦ c^{wᵢ} Xᵢ`, then every monomial with nonzero net charge has vanishing coefficient. -/
lemma coeff_eq_zero_of_charge_ne_zero {σ K : Type*} [Field K] (w : σ → ℤ) (c : K) (hc : c ≠ 0)
    (hroot : ∀ n : ℤ, c ^ n = 1 → n = 0) {f : MvPolynomial σ K}
    (hf : aeval (fun i => C (c ^ (w i)) * X i) f = f) {m : σ →₀ ℕ}
    (hm : ∑ i ∈ m.support, (m i : ℤ) * w i ≠ 0) :
    f.coeff m = 0 := by
  classical
  have key := coeff_aeval_diag (fun i => c ^ (w i)) f m
  rw [hf] at key
  have hgen : ∀ s : Finset σ, ∏ i ∈ s, (c ^ (w i)) ^ (m i)
      = c ^ (∑ i ∈ s, (m i : ℤ) * w i) := by
    intro s
    induction s using Finset.induction with
    | empty => simp
    | @insert x t hx ih =>
      rw [Finset.prod_insert hx, Finset.sum_insert hx, ih, zpow_add₀ hc]
      congr 1
      rw [← zpow_natCast (c ^ w x) (m x), ← zpow_mul, mul_comm]
  rw [Finsupp.prod, hgen] at key
  have hne : c ^ (∑ i ∈ m.support, (m i : ℤ) * w i) ≠ 1 := fun h => hm (hroot _ h)
  have h2 : (1 - c ^ (∑ i ∈ m.support, (m i : ℤ) * w i)) * f.coeff m = 0 := by
    rw [sub_mul, one_mul, ← key, sub_self]
  rcases mul_eq_zero.mp h2 with h | h
  · exact absurd (sub_eq_zero.mp h).symm hne
  · exact h

end MvPolynomial

namespace TwoHiggsDoublet.EffectivePotential
/-- There is a gauge phase of infinite order (`exp i`), needed to run charge balancing. -/
lemma exists_infiniteOrder_unitary :
    ∃ ω : unitary ℂ, ∀ n : ℤ, (ω : ℂ) ^ n = 1 → n = 0 := by
  have key : star (Complex.exp Complex.I) * Complex.exp Complex.I = 1 := by
    rw [Complex.star_def, ← Complex.exp_conj, Complex.conj_I, ← Complex.exp_add]; simp
  have key2 : Complex.exp Complex.I * star (Complex.exp Complex.I) = 1 := by
    rw [Complex.star_def, ← Complex.exp_conj, Complex.conj_I, ← Complex.exp_add]; simp
  refine ⟨⟨Complex.exp Complex.I, key, key2⟩, fun n hn => ?_⟩
  simp only at hn
  rw [← Complex.exp_int_mul, Complex.exp_eq_one_iff] at hn
  obtain ⟨k, hk⟩ := hn
  have hc : (n : ℂ) = (k : ℂ) * (2 * Real.pi) := by
    have hI : (Complex.I) ≠ 0 := Complex.I_ne_zero
    apply mul_right_cancel₀ hI
    rw [hk]; ring
  have hr : (n : ℝ) = (k : ℝ) * (2 * Real.pi) := by exact_mod_cast hc
  rcases eq_or_ne k 0 with hk0 | hk0
  · simp [hk0] at hr; exact_mod_cast hr
  · exfalso
    have h2k : (2 * (k : ℝ)) ≠ 0 := by
      simp only [mul_ne_zero_iff]; exact ⟨two_ne_zero, by exact_mod_cast hk0⟩
    have hpi : Real.pi = (n : ℝ) / (2 * (k : ℝ)) := by rw [eq_div_iff h2k, hr]; ring
    exact irrational_pi.ne_rat ((n : ℚ) / (2 * (k : ℚ))) (by rw [hpi]; push_cast; ring)


end TwoHiggsDoublet.EffectivePotential

/-! Inverse linear polynomial substitutions and their actual evaluations. -/

noncomputable section
open MvPolynomial Complex

namespace D5.S3.Quantum.Algebra.PhasePolynomial

abbrev Poly (ι : Type*) := MvPolynomial (ι ⊕ ι) ℂ

variable {ι : Type*}

/-- Evaluation on the actual conjugate diagonal. -/
def actual (p : Poly ι) (z : ι → ℂ) : ℂ :=
  eval (Sum.elim z (fun i => star (z i))) p

/-- Cartesian coordinates of a complex vector. -/
def cartesian (z : ι → ℂ) : ι ⊕ ι → ℂ :=
  Sum.elim (fun i => (z i).re) (fun i => (z i).im)

/-- Substitute z=x+iy and its conjugate x-iy. -/
def toCartesian : Poly ι →ₐ[ℂ] Poly ι :=
  aeval (Sum.elim (fun i => X (Sum.inl i) + C I * X (Sum.inr i))
    (fun i => X (Sum.inl i) - C I * X (Sum.inr i)))

/-- Substitute x=(z+w)/2 and y=(z-w)/(2i). -/
def fromCartesian : Poly ι →ₐ[ℂ] Poly ι :=
  aeval (Sum.elim (fun i => C (1/2) * (X (Sum.inl i) + X (Sum.inr i)))
    (fun i => C (1/(2*I)) * (X (Sum.inl i) - X (Sum.inr i))))

private theorem cartesian_inverse_left (p : Poly ι) : fromCartesian (toCartesian p) = p := by
  have h : (fromCartesian : Poly ι →ₐ[ℂ] Poly ι).comp toCartesian = AlgHom.id ℂ _ := by
    apply MvPolynomial.algHom_ext
    intro v
    have hI : (C I : Poly ι)^2 = -1 := by rw [← map_pow]; norm_num
    have htwo : (2 : Poly ι) * C (1/2 : ℂ) = 1 := by
      have hh : (C (2 : ℂ) : Poly ι) * C (1/2 : ℂ) = 1 := by
        rw [← map_mul]
        norm_num
      simpa only [map_ofNat] using hh
    cases v with
    | inl i =>
      simp [toCartesian, fromCartesian, AlgHom.comp_apply]
      ring_nf
      rw [hI]
      linear_combination (X (Sum.inl i) : Poly ι) * htwo
    | inr i =>
      simp [toCartesian, fromCartesian, AlgHom.comp_apply]
      ring_nf
      rw [hI]
      linear_combination (X (Sum.inr i) : Poly ι) * htwo
  exact DFunLike.congr_fun h p

private theorem cartesian_inverse_right (p : Poly ι) : toCartesian (fromCartesian p) = p := by
  have h : (toCartesian : Poly ι →ₐ[ℂ] Poly ι).comp fromCartesian = AlgHom.id ℂ _ := by
    apply MvPolynomial.algHom_ext
    intro v
    have hI : (C I : Poly ι)^2 = -1 := by rw [← map_pow]; norm_num
    have htwo : (2 : Poly ι) * C (1/2 : ℂ) = 1 := by
      have hh : (C (2 : ℂ) : Poly ι) * C (1/2 : ℂ) = 1 := by
        rw [← map_mul]
        norm_num
      simpa only [map_ofNat] using hh
    cases v with
    | inl i =>
      simp [toCartesian, fromCartesian, AlgHom.comp_apply]
      ring_nf
      linear_combination (X (Sum.inl i) : Poly ι) * htwo
    | inr i =>
      simp [toCartesian, fromCartesian, AlgHom.comp_apply]
      ring_nf
      rw [hI]
      linear_combination (X (Sum.inr i) : Poly ι) * htwo
  exact DFunLike.congr_fun h p

/-- The unique change of polynomial coordinates; coefficients may be arbitrary complex numbers. -/
def cartesianEquiv : Poly ι ≃ₐ[ℂ] Poly ι :=
  AlgEquiv.ofAlgHom toCartesian fromCartesian
    (by apply DFunLike.ext; intro p; exact cartesian_inverse_right p)
    (by apply DFunLike.ext; intro p; exact cartesian_inverse_left p)

private theorem eval_toCartesian (p : Poly ι) (x : ι ⊕ ι → ℂ) :
    eval x (toCartesian p) =
      eval (Sum.elim (fun i => x (.inl i) + I*x (.inr i))
        (fun i => x (.inl i) - I*x (.inr i))) p := by
  have h : (aeval x).comp (toCartesian : Poly ι →ₐ[ℂ] Poly ι) =
      aeval (Sum.elim (fun i => x (.inl i) + I*x (.inr i))
        (fun i => x (.inl i) - I*x (.inr i))) := by
    apply MvPolynomial.algHom_ext
    intro v; cases v <;> simp [toCartesian]
  exact DFunLike.congr_fun h p

/-- The coordinate equivalence agrees with evaluation on every actual complex vector. -/
theorem actual_cartesian (p : Poly ι) (z : ι → ℂ) :
    eval (cartesian z) (toCartesian p) = actual p z := by
  rw [eval_toCartesian]
  apply congrArg (fun f : ι ⊕ ι → ℂ => eval f p)
  funext v
  cases v with
  | inl i => simpa [cartesian, mul_comm] using Complex.re_add_im (z i)
  | inr i => apply Complex.ext <;> simp [cartesian]

/-- No polynomial information is lost by restricting paired variables to actual conjugates. -/
theorem actual_injective : Function.Injective (actual : Poly ι → (ι → ℂ) → ℂ) := by
  intro p q hpq
  apply (cartesianEquiv : Poly ι ≃ₐ[ℂ] Poly ι).injective
  apply MvPolynomial.funext_set (fun _ => Set.range (Complex.ofReal : ℝ → ℂ))
    (fun _ => Set.infinite_range_of_injective Complex.ofReal_injective)
  intro x hx
  have hxreal (v) : (x v).im = 0 := by
    obtain ⟨r, hr⟩ := hx v (Set.mem_univ v)
    rw [← hr]; simp
  let z : ι → ℂ := fun i => x (.inl i) + I*x (.inr i)
  have hc : cartesian z = x := by
    funext v
    cases v <;> apply Complex.ext <;> simp [cartesian, z, hxreal]
  change eval x (toCartesian p) = eval x (toCartesian q)
  rw [← hc, actual_cartesian, actual_cartesian]
  exact congrFun hpq z

private theorem totalDegree_aeval_linear (f : (ι ⊕ ι) → Poly ι)
    (hf : ∀ v, (f v).totalDegree ≤ 1) (p : Poly ι) :
    (aeval f p).totalDegree ≤ p.totalDegree := by
  classical
  rw [p.as_sum, map_sum]
  apply totalDegree_finsetSum_le
  intro m hm
  have hd := le_totalDegree hm
  rw [aeval_monomial]
  apply le_trans (totalDegree_mul _ _) ?_
  have hprod : (m.prod fun v n => f v ^ n).totalDegree ≤ m.sum (fun _ n => n) := by
    apply le_trans (totalDegree_finsetProd _ _) ?_
    apply Finset.sum_le_sum
    intro v hv
    exact (totalDegree_pow _ _).trans (by simpa using Nat.mul_le_mul_left (m v) (hf v))
  simpa using hprod.trans hd

/-- Total degree is preserved, including the zero polynomial and constants. -/
theorem cartesian_totalDegree (p : Poly ι) : (toCartesian p).totalDegree = p.totalDegree := by
  have hm (i : ι) : (C I * X (Sum.inr i) : Poly ι).totalDegree ≤ 1 :=
    (totalDegree_mul _ _).trans (by simp)
  have hto (p : Poly ι) : (toCartesian p).totalDegree ≤ p.totalDegree := by
    apply totalDegree_aeval_linear
    intro v
    cases v with
    | inl i => exact (totalDegree_add _ _).trans (max_le (by simp) (hm i))
    | inr i => exact (totalDegree_sub _ _).trans (max_le (by simp) (hm i))
  have hfrom (p : Poly ι) : (fromCartesian p).totalDegree ≤ p.totalDegree := by
    apply totalDegree_aeval_linear
    intro v
    cases v with
    | inl i => exact (totalDegree_mul _ _).trans (by
        rw [totalDegree_C, zero_add]
        simpa using (totalDegree_add (X (Sum.inl i) : Poly ι) (X (Sum.inr i))))
    | inr i => exact (totalDegree_mul _ _).trans (by
        rw [totalDegree_C, zero_add]
        simpa using (totalDegree_sub (X (Sum.inl i) : Poly ι) (X (Sum.inr i))))
  exact le_antisymm (hto p) (by simpa [cartesian_inverse_left] using hfrom (toCartesian p))

/-- Every polynomial in real coordinates has one faithful expansion in z and its conjugate. -/
theorem real_coordinates_unique (q : Poly ι) :
    ∃! p : Poly ι, ∀ z, actual p z = eval (cartesian z) q := by
  have he (z) : actual (fromCartesian q) z = eval (cartesian z) q := by
    rw [← actual_cartesian, cartesian_inverse_right]
  refine ⟨fromCartesian q, he, ?_⟩
  intro p hp
  apply actual_injective
  funext z
  exact (hp z).trans (he z).symm

/-- Homogeneous degree is preserved by the two inverse linear substitutions. -/
theorem cartesian_homogeneous (p : Poly ι) (n : ℕ) :
    (toCartesian p).IsHomogeneous n ↔ p.IsHomogeneous n := by
  have hto (p : Poly ι) (hp : p.IsHomogeneous n) : (toCartesian p).IsHomogeneous n := by
    have hg (v : ι ⊕ ι) :
        (Sum.elim (fun i => X (Sum.inl i) + C I * X (Sum.inr i))
          (fun i => X (Sum.inl i) - C I * X (Sum.inr i)) v : Poly ι).IsHomogeneous 1 := by
      cases v
      · exact (isHomogeneous_X ℂ _).add ((isHomogeneous_X ℂ _).C_mul I)
      · exact (isHomogeneous_X ℂ _).sub ((isHomogeneous_X ℂ _).C_mul I)
    simpa [toCartesian] using hp.aeval _ hg
  have hfrom (p : Poly ι) (hp : p.IsHomogeneous n) : (fromCartesian p).IsHomogeneous n := by
    have hg (v : ι ⊕ ι) :
        (Sum.elim (fun i => C (1/2) * (X (Sum.inl i) + X (Sum.inr i)))
          (fun i => C (1/(2*I)) * (X (Sum.inl i) - X (Sum.inr i))) v : Poly ι).IsHomogeneous 1 := by
      cases v
      · exact ((isHomogeneous_X ℂ _).add (isHomogeneous_X ℂ _)).C_mul _
      · exact ((isHomogeneous_X ℂ _).sub (isHomogeneous_X ℂ _)).C_mul _
    simpa [fromCartesian] using hp.aeval _ hg
  exact ⟨fun hp => by simpa [cartesian_inverse_left] using hfrom _ hp, hto p⟩

end D5.S3.Quantum.Algebra.PhasePolynomial

/-! Balanced support and constructive quadratic generation for actual phase invariants. -/

noncomputable section
open MvPolynomial Complex
namespace D5.S3.Quantum.Algebra.PhasePolynomial
variable {ι : Type*} [Fintype ι]

/-- The two ordinary monomial degrees, with no restriction on coefficients or support. -/
def holo (m : (ι ⊕ ι) →₀ ℕ) : ℕ := ∑ i, m (.inl i)
def anti (m : (ι ⊕ ι) →₀ ℕ) : ℕ := ∑ i, m (.inr i)
def Balanced (p : Poly ι) : Prop := ∀ m, p.coeff m ≠ 0 → holo m = anti m

def Invariant (p : Poly ι) : Prop :=
  ∀ (z : ι → ℂ) (θ : ℝ), actual p (fun i => exp (θ * I) * z i) = actual p z

def quadraticGenerator (ij : ι × ι) : Poly ι := X (.inl ij.1) * X (.inr ij.2)
def quadraticAlgebra : Subalgebra ℂ (Poly ι) :=
  Algebra.adjoin ℂ (Set.range quadraticGenerator)

private theorem exponent_total (m : (ι ⊕ ι) →₀ ℕ) :
    m.sum (fun _ n => n) = holo m + anti m := by
  rw [Finsupp.sum_fintype _ _ (by simp), Fintype.sum_sum_type]
  rfl

/-- Every balanced monomial factors through the quadratic generators in any finite dimension. -/
theorem balanced_monomial_mem_quadratic_adjoin (m : (ι ⊕ ι) →₀ ℕ)
    (hm : holo m = anti m) : monomial m (1 : ℂ) ∈ quadraticAlgebra (ι := ι) := by
  classical
  generalize hn : holo m = n
  induction n using Nat.strong_induction_on generalizing m with
  | h n ih =>
    by_cases hz : n = 0
    · have hL : holo m = 0 := hn.trans hz
      have hR : anti m = 0 := hm.symm.trans hL
      have hm0 : m = 0 := by
        ext v
        cases v with
        | inl i => exact (Finset.sum_eq_zero_iff.mp hL i (Finset.mem_univ _))
        | inr i => exact (Finset.sum_eq_zero_iff.mp hR i (Finset.mem_univ _))
      simp [hm0]
    · have hL : ∃ i, m (.inl i) ≠ 0 := by
        by_contra h
        have hall : ∀ i, m (.inl i) = 0 := by simpa using h
        exact hz (by rw [← hn]; simp [holo, hall])
      have hR : ∃ j, m (.inr j) ≠ 0 := by
        by_contra h
        have hall : ∀ j, m (.inr j) = 0 := by simpa using h
        exact hz (by rw [← hn, hm]; simp [anti, hall])
      obtain ⟨i, hi⟩ := hL
      obtain ⟨j, hj⟩ := hR
      let a : (ι ⊕ ι) →₀ ℕ := Finsupp.single (.inl i) 1 + Finsupp.single (.inr j) 1
      have ham : a ≤ m := by
        intro v
        cases v with
        | inl k => by_cases h : k = i <;> simp [a, Finsupp.single_apply, h] <;> omega
        | inr k => by_cases h : k = j <;> simp [a, Finsupp.single_apply, h] <;> omega
      let r := m - a
      have hsplit : r + a = m := tsub_add_cancel_of_le ham
      have hdegL : holo r + 1 = holo m := by
        rw [← hsplit]
        simp [holo, a, Finsupp.add_apply, Finset.sum_add_distrib, Finsupp.single_apply]
      have hdegR : anti r + 1 = anti m := by
        rw [← hsplit]
        simp [anti, a, Finsupp.add_apply, Finset.sum_add_distrib, Finsupp.single_apply]
      have hr : monomial r (1 : ℂ) ∈ quadraticAlgebra (ι := ι) :=
        ih (holo r) (by omega) r (by omega) rfl
      have ha : monomial a (1 : ℂ) = quadraticGenerator (i,j) := by
        simp [a, quadraticGenerator, X, monomial_mul_monomial]
      rw [← hsplit, ← one_mul (1 : ℂ), ← monomial_mul_monomial, ha]
      exact (quadraticAlgebra (ι := ι)).mul_mem hr (Algebra.subset_adjoin ⟨(i,j), rfl⟩)

private theorem balanced_mem (p : Poly ι) (hp : Balanced p) : p ∈ quadraticAlgebra (ι := ι) := by
  classical
  rw [p.as_sum]
  apply Subalgebra.sum_mem
  intro m hm
  have hb := balanced_monomial_mem_quadratic_adjoin m (hp m (mem_support_iff.mp hm))
  have he : monomial m (p.coeff m) = C (p.coeff m) * monomial m (1 : ℂ) := by
    rw [C_mul_monomial, mul_one]
  rw [he]
  exact (quadraticAlgebra (ι := ι)).mul_mem (Subalgebra.algebraMap_mem _ _) hb

private def diagonal (c : ℂ) : Poly ι →ₐ[ℂ] Poly ι :=
  aeval (Sum.elim (fun i => C c * X (.inl i)) (fun i => C (star c) * X (.inr i)))

private theorem actual_diagonal (p : Poly ι) (c : ℂ) (z : ι → ℂ) :
    actual (diagonal c p) z = actual p (fun i => c*z i) := by
  have h : (aeval (Sum.elim z (fun i => star (z i)))).comp
      (diagonal c : Poly ι →ₐ[ℂ] Poly ι) =
      aeval (Sum.elim (fun i => c*z i) (fun i => star (c*z i))) := by
    apply MvPolynomial.algHom_ext
    intro v; cases v <;> simp [diagonal, star_mul, mul_comm]
  exact DFunLike.congr_fun h p

private theorem formal_invariant (p : Poly ι) (hp : Invariant p) (c : unitary ℂ) :
    diagonal (c : ℂ) p = p := by
  apply actual_injective
  funext z
  rw [actual_diagonal]
  have hc : exp ((c : ℂ).arg * I) = (c : ℂ) := by
    have hn : ‖(c : ℂ)‖ = 1 := by
      have h := congrArg norm (Unitary.coe_star_mul_self c)
      simp only [norm_mul, norm_star, norm_one] at h
      nlinarith [norm_nonneg (c : ℂ)]
    simpa [hn] using Complex.norm_mul_exp_arg_mul_I (c : ℂ)
  simpa [Invariant, hc] using hp z (c : ℂ).arg

private theorem invariant_balanced (p : Poly ι) (hp : Invariant p) : Balanced p := by
  classical
  obtain ⟨c, hc⟩ := TwoHiggsDoublet.EffectivePotential.exists_infiniteOrder_unitary
  have hc0 : (c : ℂ) ≠ 0 := (Unitary.isUnit_coe (U := c)).ne_zero
  have hstar : star (c : ℂ) = (c : ℂ)⁻¹ := by
    apply mul_right_cancel₀ hc0
    rw [c.property.1, inv_mul_cancel₀ hc0]
  let w : ι ⊕ ι → ℤ := Sum.elim (fun _ => 1) (fun _ => -1)
  have hsubst : (fun v => C ((c : ℂ) ^ w v) * X v) =
      Sum.elim (fun i => C (c : ℂ) * X (.inl i))
        (fun i => C (star (c : ℂ)) * X (.inr i)) := by
    funext v
    cases v <;> simp [w, hstar]
  intro m hm
  by_contra hb
  have hcharge : ∑ v ∈ m.support, (m v : ℤ) * w v ≠ 0 := by
    change m.sum (fun v n => (n : ℤ) * w v) ≠ 0
    rw [Finsupp.sum_fintype _ _ (by simp), Fintype.sum_sum_type]
    intro hz
    simp only [w, Sum.elim_inl, Sum.elim_inr, mul_one, mul_neg_one,
      Finset.sum_neg_distrib] at hz
    have he : (holo m : ℤ) = (anti m : ℤ) := by
      dsimp [holo, anti]
      push_cast
      linear_combination hz
    exact hb (by exact_mod_cast he)
  exact hm (MvPolynomial.coeff_eq_zero_of_charge_ne_zero w (c : ℂ) hc0 hc
    (by rw [hsubst]; exact formal_invariant p hp c) hcharge)

private theorem generator_invariant (ij : ι × ι) : Invariant (quadraticGenerator ij) := by
  intro z θ
  have hu : star (exp ((θ : ℂ)*I)) * exp (θ*I) = 1 := by
    rw [Complex.star_def, ← Complex.exp_conj, ← Complex.exp_add]
    simp
  simp only [actual, quadraticGenerator, map_mul, eval_X, Sum.elim_inl, Sum.elim_inr, star_mul]
  linear_combination (z ij.1 * star (z ij.2)) * hu

private theorem mem_invariant (p : Poly ι) (hp : p ∈ quadraticAlgebra (ι := ι)) : Invariant p := by
  induction hp using Algebra.adjoin_induction with
  | mem x hx => obtain ⟨ij, rfl⟩ := hx; exact generator_invariant ij
  | algebraMap r => intro z θ; simp [actual]
  | add p q hp hq ihp ihq => intro z θ; simpa [actual] using congrArg₂ (· + ·) (ihp z θ) (ihq z θ)
  | mul p q hp hq ihp ihq => intro z θ; simpa [actual] using congrArg₂ (· * ·) (ihp z θ) (ihq z θ)

/-- Actual invariance, coefficient balance, and quadratic generation are equivalent. -/
theorem common_phase_polynomial_theorem (p : Poly ι) :
    (Invariant p ↔ Balanced p) ∧
    (Invariant p ↔ p ∈ quadraticAlgebra (ι := ι)) := by
  have h1 := invariant_balanced p
  have h2 := balanced_mem p
  have h3 := mem_invariant p
  exact ⟨⟨h1, fun h => h3 (h2 h)⟩, ⟨fun h => h2 (h1 h), h3⟩⟩

/-- Every nonconstant actual invariant has degree at least two. -/
theorem invariant_minimum_degree (p : Poly ι) (hp : Invariant p)
    (hn : ¬ ∃ c : ℂ, p = C c) : 2 ≤ p.totalDegree := by
  classical
  have hb := (common_phase_polynomial_theorem p).1.mp hp
  by_contra h
  apply hn
  refine ⟨p.constantCoeff, ?_⟩
  apply totalDegree_eq_zero_iff_eq_C.mp
  apply le_antisymm _ (Nat.zero_le _)
  rw [totalDegree]
  apply Finset.sup_le
  intro m hm
  have hmB := hb m (mem_support_iff.mp hm)
  have hmD := le_totalDegree hm
  rw [exponent_total, hmB] at hmD
  have hm0 : anti m = 0 := by omega
  simp [exponent_total, hmB, hm0]

/-- Degree two is attained whenever there is a coordinate; no such existence is asserted in dimension zero. -/
theorem invariant_degree_two (i : ι) : Invariant (quadraticGenerator (i,i)) ∧
    (quadraticGenerator (i,i) : Poly ι).totalDegree = 2 := by
  refine ⟨generator_invariant _, ?_⟩
  rw [quadraticGenerator, X, X, monomial_mul_monomial]
  simp [totalDegree_monomial, Finsupp.sum_add_index']

/-- The algebra homomorphism into actual polynomial functions. -/
def actualHom : Poly ι →ₐ[ℂ] ((ι → ℂ) → ℂ) where
  toFun := actual
  map_one' := by funext z; simp [actual]
  map_zero' := by funext z; simp [actual]
  map_add' p q := by funext z; simp [actual]
  map_mul' p q := by funext z; simp [actual]
  commutes' c := by funext z; simp [actual]

/-- The quadratic generated algebra of actual functions, with ordinary pointwise operations. -/
def actualQuadraticAlgebra : Subalgebra ℂ ((ι → ℂ) → ℂ) :=
  Algebra.adjoin ℂ (Set.range (fun ij : ι × ι => fun z : ι → ℂ => z ij.1 * star (z ij.2)))

/-- The generation assertion also holds inside the algebra of actual functions. -/
theorem actual_quadratic_generation (p : Poly ι) (hp : Invariant p) :
    actual p ∈ actualQuadraticAlgebra (ι := ι) := by
  have hmap : (quadraticAlgebra (ι := ι)).map actualHom = actualQuadraticAlgebra := by
    rw [quadraticAlgebra, AlgHom.map_adjoin, ← Set.range_comp']
    congr 1
    congr 1
    funext ij z
    simp [actualHom, actual, quadraticGenerator]
  have hm : actualHom p ∈ (quadraticAlgebra (ι := ι)).map actualHom :=
    Subalgebra.mem_map.mpr ⟨p, (common_phase_polynomial_theorem p).2.mp hp, rfl⟩
  rwa [hmap] at hm

end D5.S3.Quantum.Algebra.PhasePolynomial

/-! Coefficient reconstruction, Hermitian symmetry and actual quadratic positivity. -/

noncomputable section
open MvPolynomial Complex
open scoped Matrix ComplexOrder InnerProductSpace
namespace D5.S3.Quantum.Algebra.PhasePolynomial
variable {ι : Type*} [Fintype ι]

def pairExponent (i j : ι) : (ι ⊕ ι) →₀ ℕ :=
  Finsupp.single (.inl i) 1 + Finsupp.single (.inr j) 1

/-- The coefficient c_ij is stored at matrix entry H_ji. -/
def coefficientMatrix (p : Poly ι) : Matrix ι ι ℂ := fun j i => p.coeff (pairExponent i j)

def matrixPolynomial (H : Matrix ι ι ℂ) : Poly ι :=
  ∑ i, ∑ j, monomial (pairExponent i j) (H j i)

private theorem pair_eq_iff (i j k l : ι) :
    pairExponent i j = pairExponent k l ↔ i = k ∧ j = l := by
  classical
  constructor
  · intro h
    have hL := congrArg (fun m : (ι ⊕ ι) →₀ ℕ => m (.inl i)) h
    have hR := congrArg (fun m : (ι ⊕ ι) →₀ ℕ => m (.inr j)) h
    constructor
    · by_contra hn; simp [pairExponent, Finsupp.single_apply, hn] at hL
    · by_contra hn; simp [pairExponent, Finsupp.single_apply, hn] at hR
  · rintro ⟨rfl, rfl⟩; rfl

private theorem matrixPolynomial_coeff (H : Matrix ι ι ℂ) (i j : ι) :
    (matrixPolynomial H).coeff (pairExponent i j) = H j i := by
  classical
  simp [matrixPolynomial, coeff_monomial, pair_eq_iff, ite_and]

private theorem quadratic_support_pair (p : Poly ι) (hp : Invariant p)
    (hq : p.IsHomogeneous 2) (m : (ι ⊕ ι) →₀ ℕ) (hm : m ∈ p.support) :
    ∃ i j, m = pairExponent i j := by
  classical
  have hb := (common_phase_polynomial_theorem p).1.mp hp m (mem_support_iff.mp hm)
  have hd := hq.degree_eq_sum_deg_support hm
  have ht : holo m + anti m = 2 := by
    have he : m.sum (fun _ n => n) = holo m + anti m := by
      rw [Finsupp.sum_fintype _ _ (by simp), Fintype.sum_sum_type]; rfl
    exact he.symm.trans hd.symm
  have hL : holo m = 1 := by omega
  have hR : anti m = 1 := by omega
  let L : ι →₀ ℕ := Finsupp.equivFunOnFinite.symm (fun i => m (.inl i))
  let R : ι →₀ ℕ := Finsupp.equivFunOnFinite.symm (fun i => m (.inr i))
  have hLs : L.sum (fun _ n => n) = 1 := by
    simpa [Finsupp.sum_fintype, L, holo] using hL
  have hRs : R.sum (fun _ n => n) = 1 := by
    simpa [Finsupp.sum_fintype, R, anti] using hR
  obtain ⟨i, hi⟩ := (Finsupp.sum_eq_one_iff L).mp hLs
  obtain ⟨j, hj⟩ := (Finsupp.sum_eq_one_iff R).mp hRs
  refine ⟨i, j, ?_⟩
  ext v
  cases v with
  | inl k => simpa [L, pairExponent, Finsupp.single_apply] using DFunLike.congr_fun hi k
  | inr k => simpa [R, pairExponent, Finsupp.single_apply] using DFunLike.congr_fun hj k

private theorem quadratic_expansion (p : Poly ι) (hp : Invariant p)
    (hq : p.IsHomogeneous 2) : p = matrixPolynomial (coefficientMatrix p) := by
  classical
  apply MvPolynomial.ext
  intro m
  by_cases hm : ∃ i j, m = pairExponent i j
  · obtain ⟨i,j,rfl⟩ := hm
    exact (matrixPolynomial_coeff (coefficientMatrix p) i j).symm
  · have hz : p.coeff m = 0 := by
      by_contra hn
      exact hm (quadratic_support_pair p hp hq m (mem_support_iff.mpr hn))
    rw [hz]
    simp only [matrixPolynomial, coeff_sum]
    symm
    apply Finset.sum_eq_zero
    intro i hi
    apply Finset.sum_eq_zero
    intro j hj
    rw [coeff_monomial, if_neg (fun h => hm ⟨i,j,h.symm⟩)]

private theorem actual_matrixPolynomial (H : Matrix ι ι ℂ) (z : ι → ℂ) :
    actual (matrixPolynomial H) z = star z ⬝ᵥ (H *ᵥ z) := by
  classical
  have hm (i j : ι) : monomial (pairExponent i j) (H j i) =
      C (H j i) * X (.inl i) * X (.inr j) := by
    simp only [X, C_mul_monomial, monomial_mul_monomial, mul_one]
    rfl
  unfold matrixPolynomial
  simp_rw [hm]
  simp only [actual, map_sum, map_mul, eval_C, eval_X, Sum.elim_inl, Sum.elim_inr]
  simp only [dotProduct, Matrix.mulVec, Pi.star_apply, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  ring

private theorem quadraticMatrix_hermitian (H : Matrix ι ι ℂ)
    (hr : ∀ z, (star z ⬝ᵥ (H *ᵥ z)).im = 0) : H.IsHermitian := by
  classical
  apply Matrix.isSymmetric_toEuclideanLin_iff.mp
  apply (LinearMap.isSymmetric_iff_inner_map_self_real _).mpr
  intro v
  have hv := hr (WithLp.ofLp v)
  have hv' : (H *ᵥ WithLp.ofLp v ⬝ᵥ star (WithLp.ofLp v)).im = 0 := by
    rw [dotProduct_comm]
    exact hv
  rw [← inner_conj_symm]
  apply Complex.ext <;>
    simp [EuclideanSpace.inner_eq_star_dotProduct, Matrix.ofLp_toLpLin,
      Matrix.toLin'_apply, hv']

/-- Equality of quadratic forms on all actual complex vectors determines the entire matrix. -/
theorem actual_quadratic_matrix_unique (H K : Matrix ι ι ℂ)
    (h : ∀ z, star z ⬝ᵥ (H *ᵥ z) = star z ⬝ᵥ (K *ᵥ z)) : H = K := by
  have he : matrixPolynomial H = matrixPolynomial K := actual_injective (by
    funext z; simpa only [actual_matrixPolynomial] using h z)
  funext j i
  simpa only [matrixPolynomial_coeff] using congrArg (fun p : Poly ι => p.coeff (pairExponent i j)) he

/-- Every real-valued homogeneous quadratic actual invariant has exactly one Hermitian matrix. -/
theorem invariant_quadratic_hermitian (p : Poly ι) (hp : Invariant p)
    (hq : p.IsHomogeneous 2) (hr : ∀ z, (actual p z).im = 0) :
    ∃! H : Matrix ι ι ℂ, H.IsHermitian ∧
      (∀ z, actual p z = star z ⬝ᵥ (H *ᵥ z)) ∧
      (∀ i j, H j i = p.coeff (pairExponent i j)) := by
  have he := quadratic_expansion p hp hq
  have hev (z) : actual p z = star z ⬝ᵥ ((coefficientMatrix p) *ᵥ z) := by
    calc
      _ = actual (matrixPolynomial (coefficientMatrix p)) z := congrArg (fun q => actual q z) he
      _ = _ := actual_matrixPolynomial _ _
  refine ⟨coefficientMatrix p, ⟨quadraticMatrix_hermitian _ (fun z => by
    rw [← hev]; exact hr z), hev, fun _ _ => rfl⟩, ?_⟩
  intro H hH
  apply actual_quadratic_matrix_unique
  intro z
  exact (hH.2.1 z).symm.trans (hev z)

/-- Real nonnegativity of actual values is equivalent to the existing complex PSD predicate. -/
theorem invariant_quadratic_nonnegative_iff (p : Poly ι) (hp : Invariant p)
    (hq : p.IsHomogeneous 2) (hr : ∀ z, (actual p z).im = 0) :
    (∀ z, 0 ≤ (actual p z).re) ↔ (coefficientMatrix p).PosSemidef := by
  have hev (z) : actual p z = star z ⬝ᵥ ((coefficientMatrix p) *ᵥ z) := by
    calc
      _ = actual (matrixPolynomial (coefficientMatrix p)) z :=
        congrArg (fun q => actual q z) (quadratic_expansion p hp hq)
      _ = _ := actual_matrixPolynomial _ _
  have hH : (coefficientMatrix p).IsHermitian :=
    quadraticMatrix_hermitian _ (fun z => by rw [← hev]; exact hr z)
  rw [Matrix.posSemidef_iff_dotProduct_mulVec]
  constructor
  · intro hn
    refine ⟨hH, fun z => Complex.nonneg_iff.mpr ?_⟩
    rw [← hev]
    exact ⟨hn z, (hr z).symm⟩
  · rintro ⟨_, hn⟩ z
    exact (Complex.nonneg_iff.mp (by simpa only [hev z] using hn z)).1

/-- Complete actual-polynomial common-phase theorem, including zero-dimensional degeneracies. -/
theorem complete_common_phase_polynomial_theorem (p : Poly ι) :
    (∃! q : Poly ι, ∀ z, actual q z = eval (cartesian z) p) ∧
    ((toCartesian p).totalDegree = p.totalDegree) ∧
    (∀ n, (toCartesian p).IsHomogeneous n ↔ p.IsHomogeneous n) ∧
    (Invariant p ↔ Balanced p) ∧
    (Invariant p ↔ p ∈ quadraticAlgebra (ι := ι)) ∧
    (Invariant p → actual p ∈ actualQuadraticAlgebra (ι := ι)) ∧
    (Invariant p → (¬ ∃ c : ℂ, p = C c) → 2 ≤ p.totalDegree) ∧
    (∀ i : ι, Invariant (quadraticGenerator (i,i)) ∧
      (quadraticGenerator (i,i) : Poly ι).totalDegree = 2) ∧
    (p.IsHomogeneous 2 → (∀ z, (actual p z).im = 0) → Invariant p →
      ∃! H : Matrix ι ι ℂ, H.IsHermitian ∧
        (∀ z, actual p z = star z ⬝ᵥ (H *ᵥ z)) ∧
        (∀ i j, H j i = p.coeff (pairExponent i j)) ∧
        ((∀ z, 0 ≤ (actual p z).re) ↔ H.PosSemidef)) := by
  refine ⟨real_coordinates_unique p, cartesian_totalDegree p, cartesian_homogeneous p,
    (common_phase_polynomial_theorem p).1, (common_phase_polynomial_theorem p).2, actual_quadratic_generation p,
    invariant_minimum_degree p, invariant_degree_two, ?_⟩
  intro hq hr hp
  obtain ⟨H, hH, huniq⟩ := invariant_quadratic_hermitian p hp hq hr
  have he : H = coefficientMatrix p := by
    funext j i
    exact hH.2.2 i j
  refine ⟨H, ⟨hH.1, hH.2.1, hH.2.2, ?_⟩, ?_⟩
  · rw [he]
    exact invariant_quadratic_nonnegative_iff p hp hq hr
  · intro K hK
    exact huniq K ⟨hK.1, hK.2.1, hK.2.2.1⟩

end D5.S3.Quantum.Algebra.PhasePolynomial
