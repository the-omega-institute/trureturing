/- GID: D5/S3/Quantum/Algebra/DegeneracyGraphDeterminantMultiplicity
   generality: G
   mirror-B: D5/B/S3/Quantum/Algebra/DegeneracyGraphDeterminantMultiplicity
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Source-bounded two-root tail witnesses and their pruning decomposition. -/

import D5.S3.Quantum.Algebra.DegeneracyGraphDeterminantRecurrence

set_option autoImplicit false

noncomputable section

namespace D5.S3.Quantum.Algebra.DegeneracyGraphDeterminant

/-- Threshold levels strictly below a selected sibling pair. -/
abbrev StrictTailLevel {L : ℕ} (i : Fin L) :=
  {j : Fin L // i.succ ≤ j.castSucc}

/-- A parent in the actual descendant truncation generated by two roots. -/
def PairDescendantParent {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) (j : StrictTailLevel i) :=
  {v : T.V j.1.castSucc //
    T.ancestor j.2 v = p ∨ T.ancestor j.2 v = q}

/-- The actual number of children of a parent retained in the two-root truncation. -/
def pairDescendantFiberCard {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) (j : StrictTailLevel i)
    (v : PairDescendantParent T i p q j) : ℕ :=
  Fintype.card {w : T.V j.1.succ // T.parent j.1 w = v.1}

/-- The source bound at a tail level: the largest actual descendant-parent fiber. -/
def pairDescendantFiberMax {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) (j : StrictTailLevel i) : ℕ :=
  (Finset.univ.filter fun v : T.V j.1.castSucc =>
    T.ancestor j.2 v = p ∨ T.ancestor j.2 v = q).sup fun v =>
      Fintype.card {w : T.V j.1.succ // T.parent j.1 w = v}

/-- Literal positive tail vectors, with every coordinate bounded by the actual
two-root descendant-parent fiber maximum at that level. -/
abbrev SourcePairTailVector {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) :=
  ∀ j : StrictTailLevel i, Fin (pairDescendantFiberMax T i p q j)

def sourcePairTailThreshold {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) (d : SourcePairTailVector T i p q) : Fin L → ℕ :=
  fun j => if h : i.succ ≤ j.castSucc then (d ⟨j, h⟩).val + 1 else 1

def pairRootSurvivalSet {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) (threshold : Fin L → ℕ) : Finset (T.V i.succ) := by
  classical
  exact ({p, q} : Finset (T.V i.succ)).filter (Survives T threshold i.succ)

/-- Equation (6.27): a source-bounded positive vector whose two-root
truncation has both roots in its survival set. -/
def SourcePairTailWitness {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) :=
  {d : SourcePairTailVector T i p q //
    (pairRootSurvivalSet T i p q (sourcePairTailThreshold T i p q d)).card = 2}

/-- Ambient exponent vectors with a zero prefix and joint survival of the two roots. -/
def AmbientPairTailWitness {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) :=
  {m : Exponents T //
    (∀ j, j.castSucc ≤ i.castSucc → (m j).val = 0) ∧
    Survives T (sourceThreshold T m) i.succ p ∧
    Survives T (sourceThreshold T m) i.succ q}

noncomputable def sourcePairTailExponents {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) (d : SourcePairTailVector T i p q) : Exponents T :=
  fun j => if h : i.succ ≤ j.castSucc then
    ⟨(d ⟨j, h⟩).val, (d ⟨j, h⟩).isLt.trans_le
      (by
        apply Finset.sup_le
        intro v hv
        exact (Fintype.card_subtype_le _).trans_eq rfl)⟩
  else ⟨0, by
    rw [Fintype.card_pos_iff]
    let root : T.V 0 := Classical.choice inferInstance
    obtain ⟨v, _⟩ := T.ancestor_surjective (Fin.zero_le j.succ) root
    exact ⟨v⟩⟩

private theorem ambient_tail_bound {L : ℕ} (T : SourceTree L) (i : Fin L)
    (p q : T.V i.succ) (m : AmbientPairTailWitness T i p q)
    (j : StrictTailLevel i) :
    (m.1 j.1).val < pairDescendantFiberMax T i p q j := by
  obtain ⟨v, hvanc, hvsurv⟩ := survives_descendant T (sourceThreshold T m.1)
    (fun k => by simp [sourceThreshold]) j.2 m.2.2.1
  let v' : PairDescendantParent T i p q j := ⟨v, Or.inl hvanc⟩
  have hcard := (survives_step_iff T (sourceThreshold T m.1) j.1 v).mp hvsurv
  have hchildren :
      (survivingChildren T (sourceThreshold T m.1) j.1 v).card ≤
        pairDescendantFiberCard T i p q j v' := by
    rw [pairDescendantFiberCard, Fintype.card_subtype]
    apply Finset.card_le_card
    intro w hw
    have hw' : T.parent j.1 w = v ∧
        Survives T (sourceThreshold T m.1) j.1.succ w := by
      simpa [survivingChildren] using hw
    simpa using hw'.1
  simp only [sourceThreshold] at hcard
  have hvmax : pairDescendantFiberCard T i p q j v' ≤
      pairDescendantFiberMax T i p q j := by
    rw [pairDescendantFiberMax]
    exact Finset.le_sup (f := fun v : T.V j.1.castSucc =>
      Fintype.card {w : T.V j.1.succ // T.parent j.1 w = v}) (by
        simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        exact v'.2)
  have hmax := hchildren.trans hvmax
  omega

noncomputable def sourcePairTailWitnessEquivAmbient {L : ℕ} (T : SourceTree L)
    (i : Fin L) (p q : T.V i.succ) (hpq : p ≠ q) :
    SourcePairTailWitness T i p q ≃ AmbientPairTailWitness T i p q where
  toFun d := ⟨sourcePairTailExponents T i p q d.1, by
    refine ⟨?_, ?_⟩
    · intro j hji
      have hnot : ¬i.succ ≤ j.castSucc := by
        intro h
        have h' : i.val + 1 ≤ j.val := h
        have hji' : j.val ≤ i.val := hji
        omega
      simp [sourcePairTailExponents, hnot]
    · classical
      have hthreshold : sourceThreshold T (sourcePairTailExponents T i p q d.1) =
          sourcePairTailThreshold T i p q d.1 := by
        funext j
        by_cases h : i.succ ≤ j.castSucc
        · simp [sourceThreshold, sourcePairTailExponents, sourcePairTailThreshold, h]
        · simp [sourceThreshold, sourcePairTailExponents, sourcePairTailThreshold, h]
      rw [hthreshold]
      have hpair : ({p, q} : Finset (T.V i.succ)).card = 2 := by simp [hpq]
      have heq : pairRootSurvivalSet T i p q (sourcePairTailThreshold T i p q d.1) =
          {p, q} := by
        apply Finset.eq_of_subset_of_card_le
        · exact Finset.filter_subset _ _
        · rw [d.2, hpair]
      constructor
      · have hp : p ∈ pairRootSurvivalSet T i p q
            (sourcePairTailThreshold T i p q d.1) := by
          rw [heq]
          simp
        exact (Finset.mem_filter.mp hp).2
      · have hq : q ∈ pairRootSurvivalSet T i p q
            (sourcePairTailThreshold T i p q d.1) := by
          rw [heq]
          simp
        exact (Finset.mem_filter.mp hq).2⟩
  invFun m := ⟨fun j => ⟨(m.1 j.1).val, ambient_tail_bound T i p q m j⟩, by
    classical
    have hthreshold : sourcePairTailThreshold T i p q
        (fun j => ⟨(m.1 j.1).val, ambient_tail_bound T i p q m j⟩) =
          sourceThreshold T m.1 := by
      funext j
      by_cases h : i.succ ≤ j.castSucc
      · simp [sourcePairTailThreshold, sourceThreshold, h]
      · have hji : j.castSucc ≤ i.castSucc := by
          change j.val ≤ i.val
          change ¬i.val + 1 ≤ j.val at h
          omega
        simp [sourcePairTailThreshold, sourceThreshold, h, m.2.1 j hji]
    rw [hthreshold]
    have heq : pairRootSurvivalSet T i p q (sourceThreshold T m.1) = {p, q} := by
      apply Finset.filter_eq_self.mpr
      intro x hx
      rcases Finset.mem_insert.mp hx with hxp | hxq
      · subst x
        exact m.2.2.1
      · have hxq' : x = q := Finset.mem_singleton.mp hxq
        subst x
        exact m.2.2.2
    rw [heq]
    simp [hpq]⟩
  left_inv := by
    intro d
    apply Subtype.ext
    funext j
    apply Fin.ext
    simp [sourcePairTailExponents, j.2]
  right_inv := by
    intro m
    apply Subtype.ext
    funext j
    apply Fin.ext
    by_cases h : i.succ ≤ j.castSucc
    · simp [sourcePairTailExponents, h]
    · have hji : j.castSucc ≤ i.castSucc := by
        change j.val ≤ i.val
        change ¬i.val + 1 ≤ j.val at h
        omega
      simp [sourcePairTailExponents, h, m.2.1 j hji]

/-- Occupied last degrees whose actual pruning retains both selected roots. -/
def PairRetainingDegree {n : ℕ} (T : SourceTree (n + 2)) (i : Fin (n + 1))
    (p q : T.V i.castSucc.succ) :=
  {r : OccupiedDegree T //
    (∃ a : occupiedPenultimate T r.1.val,
      T.ancestor (show i.castSucc.succ ≤ (Fin.last (n + 1)).castSucc by
        change i.val + 1 ≤ n + 1; omega) a.1 = p) ∧
    (∃ a : occupiedPenultimate T r.1.val,
      T.ancestor (show i.castSucc.succ ≤ (Fin.last (n + 1)).castSucc by
        change i.val + 1 ≤ n + 1; omega) a.1 = q)}

noncomputable def ambientPairDegree {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ)
    (m : AmbientPairTailWitness T i.castSucc p q) :
    PairRetainingDegree T i p q := by
  have retained : ∀ {v : T.V i.castSucc.succ},
      Survives T (sourceThreshold T m.1) i.castSucc.succ v →
        ∃ a : occupiedPenultimate T (m.1 (Fin.last (n + 1))).val,
          T.ancestor (show i.castSucc.succ ≤ (Fin.last (n + 1)).castSucc by
            change i.val + 1 ≤ n + 1; omega) a.1 = v := by
    intro v hv
    rcases survives_reachesOccupied T (sourceThreshold T m.1)
        (m.1 (Fin.last (n + 1))).val (fun k => by simp [sourceThreshold])
        (by simp [sourceThreshold]) hv with hbottom | ⟨h, a, ha⟩
    · have hval := congrArg Fin.val hbottom
      simp only [Fin.val_succ, Fin.val_last] at hval
      change i.val + 1 = n + 2 at hval
      have hi := i.isLt
      omega
    · exact ⟨a, ha⟩
  exact ⟨⟨m.1 (Fin.last (n + 1)), ⟨Classical.choose (retained m.2.2.1)⟩⟩,
    retained m.2.2.1, retained m.2.2.2⟩

private theorem ambient_retained_bound {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ)
    (m : AmbientPairTailWitness T i.castSucc p q)
    (r : PairRetainingDegree T i p q)
    (hlast : (m.1 (Fin.last (n + 1))).val = r.1.1.val) (j : Fin (n + 1)) :
    (m.1 j.castSucc).val < Fintype.card ((prune T r.1.1.val r.1.2).V j.succ) := by
  classical
  by_cases htail : i.castSucc.succ ≤ j.castSucc.castSucc
  · obtain ⟨v, _, hv⟩ := survives_descendant T (sourceThreshold T m.1)
      (fun k => by simp [sourceThreshold]) htail m.2.2.1
    have hcard := (survives_step_iff T (sourceThreshold T m.1) j.castSucc v).mp hv
    let children := survivingChildren T (sourceThreshold T m.1) j.castSucc v
    let toRetained : children → (prune T r.1.1.val r.1.2).V j.succ := fun w => by
      have hw : T.parent j.castSucc w.1 = v ∧
          Survives T (sourceThreshold T m.1) j.castSucc.succ w.1 := by
        simpa [children, survivingChildren] using w.2
      refine ⟨w.1, ?_⟩
      rcases survives_reachesOccupied T (sourceThreshold T m.1) r.1.1.val
          (fun k => by simp [sourceThreshold]) (by simp [sourceThreshold, hlast]) hw.2 with
        hbottom | ⟨_, a, ha⟩
      · have hval := congrArg Fin.val hbottom
        simp only [Fin.val_succ, Fin.val_castSucc, Fin.val_last] at hval
        omega
      · exact ⟨a, ha⟩
    have hinj : Function.Injective toRetained := by
      intro a b hab
      apply Subtype.ext
      exact congrArg (fun z : (prune T r.1.1.val r.1.2).V j.succ => z.1) hab
    have hle : children.card ≤ Fintype.card ((prune T r.1.1.val r.1.2).V j.succ) := by
      rw [← Fintype.card_coe]
      exact Fintype.card_le_of_injective toRetained hinj
    have hm : (m.1 j.castSucc).val < children.card := by
      dsimp only [children]
      simp only [sourceThreshold] at hcard
      omega
    exact hm.trans_le hle
  · have hprefix : j.castSucc.castSucc ≤ i.castSucc.castSucc := by
      change j.val ≤ i.val
      change ¬i.val + 1 ≤ j.val at htail
      omega
    rw [m.2.1 j.castSucc hprefix]
    rw [Fintype.card_pos_iff]
    let root : (prune T r.1.1.val r.1.2).V 0 := Classical.choice inferInstance
    obtain ⟨v, _⟩ := (prune T r.1.1.val r.1.2).ancestor_surjective
      (Fin.zero_le j.succ) root
    exact ⟨v⟩

noncomputable def restrictAmbientPairExponents {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ)
    (m : AmbientPairTailWitness T i.castSucc p q)
    (r : PairRetainingDegree T i p q)
    (hlast : (m.1 (Fin.last (n + 1))).val = r.1.1.val) :
    Exponents (prune T r.1.1.val r.1.2) :=
  fun j => ⟨(m.1 j.castSucc).val, ambient_retained_bound T i p q m r hlast j⟩

noncomputable def restrictAmbientPairWitness {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ)
    (m : AmbientPairTailWitness T i.castSucc p q)
    (r : PairRetainingDegree T i p q)
    (hlast : (m.1 (Fin.last (n + 1))).val = r.1.1.val) :
    AmbientPairTailWitness (prune T r.1.1.val r.1.2) i
      (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)
      (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ) := by
  have hthreshold : appendThreshold (sourceThreshold (prune T r.1.1.val r.1.2)
      (restrictAmbientPairExponents T i p q m r hlast)) r.1.1.val =
      sourceThreshold T m.1 := by
    funext j
    refine Fin.lastCases ?_ (fun k => ?_) j
    · simp [appendThreshold, sourceThreshold, hlast]
    · simp [appendThreshold, sourceThreshold, restrictAmbientPairExponents]
  refine ⟨restrictAmbientPairExponents T i p q m r hlast, ?_, ?_, ?_⟩
  · intro j hji
    exact m.2.1 j.castSucc hji
  · apply (prune_survives_iff T _ r.1.1.val r.1.2
      (fun k => by simp [sourceThreshold]) i.succ
      (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)).mpr
    rw [hthreshold]
    exact m.2.2.1
  · apply (prune_survives_iff T _ r.1.1.val r.1.2
      (fun k => by simp [sourceThreshold]) i.succ
      (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ)).mpr
    rw [hthreshold]
    exact m.2.2.2

noncomputable def liftAmbientPairWitness {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ)
    (r : PairRetainingDegree T i p q)
    (m : AmbientPairTailWitness (prune T r.1.1.val r.1.2) i
      (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)
      (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ)) :
    AmbientPairTailWitness T i.castSucc p q := by
  have hthreshold : sourceThreshold T (liftExponents T r.1.1.val r.1.2 m.1) =
      appendThreshold (sourceThreshold (prune T r.1.1.val r.1.2) m.1) r.1.1.val := by
    funext j
    refine Fin.lastCases ?_ (fun k => ?_) j
    · simp [sourceThreshold, liftExponents, appendThreshold]
    · simp [sourceThreshold, liftExponents, appendThreshold]
  refine ⟨liftExponents T r.1.1.val r.1.2 m.1, ?_, ?_, ?_⟩
  · intro j hji
    induction j using Fin.lastCases with
    | last =>
      have hval : n + 1 ≤ i.val := by
        exact hji
      have hi := i.isLt
      omega
    | cast k =>
      simp only [liftExponents, Fin.lastCases_castSucc]
      apply m.2.1 k
      change k.val ≤ i.val at hji ⊢
      exact hji
  · rw [hthreshold]
    exact (prune_survives_iff T _ r.1.1.val r.1.2
      (fun k => by simp [sourceThreshold]) i.succ
      (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)).mp m.2.2.1
  · rw [hthreshold]
    exact (prune_survives_iff T _ r.1.1.val r.1.2
      (fun k => by simp [sourceThreshold]) i.succ
      (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ)).mp m.2.2.2

noncomputable def ambientPairDegreeFiberEquiv {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ)
    (r : PairRetainingDegree T i p q) :
    {m : AmbientPairTailWitness T i.castSucc p q // ambientPairDegree T i p q m = r} ≃
      AmbientPairTailWitness (prune T r.1.1.val r.1.2) i
        (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)
        (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ) where
  toFun m := restrictAmbientPairWitness T i p q m.1 r (by
    have h := congrArg (fun s : PairRetainingDegree T i p q => s.1.1.val) m.2
    simpa [ambientPairDegree] using h)
  invFun m := ⟨liftAmbientPairWitness T i p q r m, by
    apply Subtype.ext
    apply Subtype.ext
    apply Fin.ext
    simp [ambientPairDegree, liftAmbientPairWitness, liftExponents]⟩
  left_inv := by
    intro m
    have hlast : (m.1.1 (Fin.last (n + 1))).val = r.1.1.val := by
      have h := congrArg (fun s : PairRetainingDegree T i p q => s.1.1.val) m.2
      simpa [ambientPairDegree] using h
    apply Subtype.ext
    apply Subtype.ext
    dsimp only
    change liftExponents T r.1.1.val r.1.2
      (restrictAmbientPairExponents T i p q m.1 r hlast) = m.1.1
    funext j
    refine Fin.lastCases ?_ (fun k => ?_) j
    · apply Fin.ext
      simpa [liftExponents] using hlast.symm
    · apply Fin.ext
      simp [liftExponents, restrictAmbientPairExponents]
  right_inv := by
    intro m
    have hlast : ((liftAmbientPairWitness T i p q r m).1
        (Fin.last (n + 1))).val = r.1.1.val := by
      simp [liftAmbientPairWitness, liftExponents]
    apply Subtype.ext
    dsimp only
    change restrictAmbientPairExponents T i p q
      (liftAmbientPairWitness T i p q r m) r hlast = m.1
    funext j
    apply Fin.ext
    simp [restrictAmbientPairExponents, liftAmbientPairWitness, liftExponents]

/-- Joint-survival witnesses split by the literal last threshold, retaining
exactly the pruning branches in which both roots remain present. -/
noncomputable def ambientPairTailPruningEquiv {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ) :
    AmbientPairTailWitness T i.castSucc p q ≃
      Σ r : PairRetainingDegree T i p q,
        AmbientPairTailWitness (prune T r.1.1.val r.1.2) i
          (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)
          (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ) :=
  (Equiv.sigmaFiberEquiv (ambientPairDegree T i p q)).symm.trans
    (Equiv.sigmaCongrRight (ambientPairDegreeFiberEquiv T i p q))

/-- The source-bounded two-root witness decomposition by the occupied last
degree. Every branch recomputes its actual descendant-fiber bounds on `T_r`. -/
noncomputable def sourcePairTailPruningEquiv {n : ℕ} (T : SourceTree (n + 2))
    (i : Fin (n + 1)) (p q : T.V i.castSucc.succ) (hpq : p < q)
    (_hsibling : T.parent i.castSucc p = T.parent i.castSucc q) :
    SourcePairTailWitness T i.castSucc p q ≃
      Σ r : PairRetainingDegree T i p q,
        SourcePairTailWitness (prune T r.1.1.val r.1.2) i
          (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)
          (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ) :=
  (sourcePairTailWitnessEquivAmbient T i.castSucc p q (ne_of_lt hpq)).trans
    ((ambientPairTailPruningEquiv T i p q).trans
      (Equiv.sigmaCongrRight fun r =>
        (sourcePairTailWitnessEquivAmbient (prune T r.1.1.val r.1.2) i
          (⟨p, r.2.1⟩ : (prune T r.1.1.val r.1.2).V i.succ)
          (⟨q, r.2.2⟩ : (prune T r.1.1.val r.1.2).V i.succ)
          (by intro h; exact (ne_of_lt hpq) (congrArg Subtype.val h))).symm))

#print axioms sourcePairTailWitnessEquivAmbient
#print axioms sourcePairTailPruningEquiv

end D5.S3.Quantum.Algebra.DegeneracyGraphDeterminant
