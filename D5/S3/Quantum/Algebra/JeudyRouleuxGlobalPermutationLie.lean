import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Basic.Complex.Basic

/-! Binding conventions for C. Jeudy and M. Rouleux, "Generalized exchange operators for a system of
spin-1 particles", arXiv:2411.03952v1, Section 3.1 (the `Q`-representation) for `(S, N) = (1, 3)`. -/

namespace D5.S3.Quantum.Algebra.JeudyRouleuxGlobalPermutationLie

-- Matrices form a Lie algebra under the commutator `⁅A, B⁆ = A * B - B * A`.
attribute [local instance] LieRing.ofAssociativeRing

/-- The Lie algebra generated by all global permutations of the three spin labels. -/
def L : LieSubalgebra ℂ (Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ) :=
  LieSubalgebra.lieSpan ℂ (Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ)
    (Set.range fun α : Equiv.Perm (Fin 3) =>
      (Matrix.of (fun x y => if x = α ∘ y then 1 else 0) :
        Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ))

/-- The Schrödinger Hamiltonian, summing the exchanges of the three unordered particle pairs. -/
def schrodingerHamiltonian : Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ :=
  Matrix.of (fun x y => if x = y ∘ Equiv.swap 0 1 then 1 else 0) +
  Matrix.of (fun x y => if x = y ∘ Equiv.swap 0 2 then 1 else 0) +
  Matrix.of (fun x y => if x = y ∘ Equiv.swap 1 2 then 1 else 0)

/-- The expectation of Section 3.1: "we expect that Schrödinger Hamiltonian `P_S`, as well as other
Hamiltonians, belongs to `L`." -/
def claim : Prop := schrodingerHamiltonian ∈ L


/-- Projector recording equality of the first two particle labels. -/
private def O : Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ :=
  Matrix.diagonal fun x => if x 0 = x 1 then 1 else 0

private theorem q_commutes (α : Equiv.Perm (Fin 3)) :
    (Matrix.of (fun x y => if x = α ∘ y then 1 else 0) : Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ) * O =
      O * (Matrix.of (fun x y => if x = α ∘ y then 1 else 0) :
        Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ) := by
  classical
  ext x y
  simp only [O, Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.of_apply]
  by_cases h : x = α ∘ y
  · subst x
    simp [Function.comp_apply]
  · simp [h]

private theorem lie_span_le_commutant :
    L ≤ lieSubalgebraOfSubalgebra ℂ _ (Subalgebra.centralizer ℂ {O}) := by
  apply LieSubalgebra.lieSpan_le.mpr
  rintro _ ⟨α, rfl⟩
  change ∀ g ∈ ({O} : Set (Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ)),
    g * (Matrix.of (fun x y => if x = α ∘ y then 1 else 0) : Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ) =
      (Matrix.of (fun x y => if x = α ∘ y then 1 else 0) :
        Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ) * g
  intro g hg
  rcases Set.mem_singleton_iff.mp hg with rfl
  exact (q_commutes α).symm

private theorem commutator_entry :
    (schrodingerHamiltonian * O - O * schrodingerHamiltonian)
      ![1,0,0] ![0,0,1] = 1 := by
  have h01 : (![1,0,0] : (Fin 3 → Fin 3)) ≠ (![0,0,1] : (Fin 3 → Fin 3)) ∘ Equiv.swap 0 1 :=
    not_eq_of_beq_eq_false rfl
  have h02 : (![1,0,0] : (Fin 3 → Fin 3)) = (![0,0,1] : (Fin 3 → Fin 3)) ∘ Equiv.swap 0 2 :=
    List.ofFn_inj.mp rfl
  have h12 : (![1,0,0] : (Fin 3 → Fin 3)) ≠ (![0,0,1] : (Fin 3 → Fin 3)) ∘ Equiv.swap 1 2 :=
    not_eq_of_beq_eq_false rfl
  have hH : schrodingerHamiltonian ![1,0,0] ![0,0,1] = 1 := by
    simp only [schrodingerHamiltonian, Matrix.add_apply, Matrix.of_apply]
    rw [ite_eq_right h01, ite_eq_left h02, ite_eq_right h12]
    norm_num
  norm_num [O, Matrix.mul_diagonal, Matrix.diagonal_mul, Matrix.sub_apply, hH]

theorem result : ¬ claim := by
  intro h
  have hc := lie_span_le_commutant h
  change ∀ g ∈ ({O} : Set (Matrix (Fin 3 → Fin 3) (Fin 3 → Fin 3) ℂ)),
    g * schrodingerHamiltonian = schrodingerHamiltonian * g at hc
  have he := hc O (Set.mem_singleton O)
  have hz : schrodingerHamiltonian * O - O * schrodingerHamiltonian = 0 :=
    sub_eq_zero.mpr he.symm
  have hentry := commutator_entry
  rw [hz] at hentry
  norm_num at hentry

end D5.S3.Quantum.Algebra.JeudyRouleuxGlobalPermutationLie
