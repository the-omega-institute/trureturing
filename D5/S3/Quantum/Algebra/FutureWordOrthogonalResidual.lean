import D5.S3.Quantum.Algebra.OrthogonalProjectionComplement
import Mathlib.Analysis.InnerProductSpace.Projection.FiniteDimensional

/- Library-search audit trail (2026-08-17):
   * Repository search found related projection and residual modules, but no declaration packaging
     finite expectation-word equality, orthogonal residual membership, and equal projections.
   * Loogle returned one exact hit each for `Submodule.sub_mem_orthogonal_of_inner_left`,
     `Submodule.span_induction`, `Submodule.inner_left_of_mem_orthogonal`,
     `Submodule.orthogonalProjectionOnto_eq_zero_iff`, and
     `Submodule.starProjection_apply_eq_zero_iff`; all five are applied directly below.
   * The attempted shaped LeanSearch API query returned HTTP 404. -/

noncomputable section

open scoped InnerProductSpace

namespace D5.S3.Quantum.Algebra.FutureWordOrthogonalResidual

variable {𝕜 E State : Type*} [RCLike 𝕜] [NormedAddCommGroup E]
  [InnerProductSpace 𝕜 E]

/-- The finite word of expectation coordinates determined by a family of visible effects. -/
def futureExpectationWord {m : ℕ} (effect : Fin (m + 1) → E) (X : State → E)
    (rho : State) : Fin (m + 1) → 𝕜 :=
  fun i => ⟪X rho, effect i⟫_𝕜

/-- The visible subspace generated by the finite family of effects. -/
def visibleEffectSubspace {m : ℕ} (effect : Fin (m + 1) → E) : Submodule 𝕜 E :=
  Submodule.span 𝕜 (Set.range effect)

/-- The residual subspace invisible to every effect in the finite family. -/
def futureResidual {m : ℕ} (effect : Fin (m + 1) → E) : Submodule 𝕜 E :=
  (visibleEffectSubspace effect)ᗮ

/-- Two represented states have the same finite expectation word exactly when their difference is
in the orthogonal residual; equivalently, their visible orthogonal projections are equal. -/
theorem future_word_orthogonal_residual [FiniteDimensional 𝕜 E] {m : ℕ}
    (effect : Fin (m + 1) → E) (X : State → E) (rho sigma : State) :
    (futureExpectationWord (𝕜 := 𝕜) effect X rho =
        futureExpectationWord (𝕜 := 𝕜) effect X sigma ↔
        X rho - X sigma ∈ futureResidual (𝕜 := 𝕜) effect) ∧
      (X rho - X sigma ∈ futureResidual (𝕜 := 𝕜) effect ↔
        (visibleEffectSubspace (𝕜 := 𝕜) effect).starProjection (X rho) =
          (visibleEffectSubspace (𝕜 := 𝕜) effect).starProjection (X sigma)) := by
  letI : (visibleEffectSubspace (𝕜 := 𝕜) effect).HasOrthogonalProjection := inferInstance
  constructor
  · constructor
    · intro hword
      apply Submodule.sub_mem_orthogonal_of_inner_left
      intro v
      have hv : v.1 ∈ Submodule.span 𝕜 (Set.range effect) := by
        simpa only [visibleEffectSubspace] using v.property
      refine Submodule.span_induction
        (p := fun y _ => ⟪X rho, y⟫_𝕜 = ⟪X sigma, y⟫_𝕜)
        ?_ ?_ ?_ ?_ hv
      · intro y hy
        rcases hy with ⟨i, rfl⟩
        exact congrFun hword i
      · simp
      · intro x y hx hy hx_equal hy_equal
        simp only [inner_add_right, hx_equal, hy_equal]
      · intro a x hx hx_equal
        simp only [inner_smul_right, hx_equal]
    · intro hresidual
      funext i
      have hinner := Submodule.inner_left_of_mem_orthogonal
        (Submodule.subset_span (Set.mem_range_self i)) hresidual
      simpa only [futureExpectationWord, inner_sub_left, sub_eq_zero] using hinner
  · constructor
    · intro hresidual
      have hzero :
          (visibleEffectSubspace (𝕜 := 𝕜) effect).orthogonalProjectionOnto
              (X rho - X sigma) = 0 :=
        Submodule.orthogonalProjectionOnto_eq_zero_iff.mpr hresidual
      have hstar :
          (visibleEffectSubspace (𝕜 := 𝕜) effect).starProjection
              (X rho - X sigma) = 0 := by
        simp only [Submodule.starProjection_apply, hzero, Submodule.coe_zero]
      simpa only [map_sub, sub_eq_zero] using hstar
    · intro hprojection
      apply (Submodule.starProjection_apply_eq_zero_iff
        (visibleEffectSubspace (𝕜 := 𝕜) effect)).mp
      simpa only [map_sub, sub_eq_zero] using hprojection

example :
    let effect : Fin (0 + 1) → ℝ := fun _ => 1
    let X : Bool → ℝ := fun state => if state then 1 else 0
    (futureExpectationWord (𝕜 := ℝ) effect X false =
        futureExpectationWord (𝕜 := ℝ) effect X true ↔
        X false - X true ∈ futureResidual (𝕜 := ℝ) effect) ∧
      (X false - X true ∈ futureResidual (𝕜 := ℝ) effect ↔
        (visibleEffectSubspace (𝕜 := ℝ) effect).starProjection (X false) =
          (visibleEffectSubspace (𝕜 := ℝ) effect).starProjection (X true)) := by
  dsimp only
  exact future_word_orthogonal_residual
    (𝕜 := ℝ) (E := ℝ) (State := Bool) (effect := fun _ => (1 : ℝ))
    (X := fun state => if state then (1 : ℝ) else 0) false true

example : Bool := false

#print axioms future_word_orthogonal_residual

end D5.S3.Quantum.Algebra.FutureWordOrthogonalResidual
