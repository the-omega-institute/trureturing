/- GID: D5/S3/Quantum/TensorNetworks/PeriodicMPS/Reconstruction/PeriodicMPSUniformGuardedCriticalDimension
   generality: I
   mirror-B: D5/B/S3/Quantum/TensorNetworks/PeriodicMPS/Reconstruction/PeriodicMPSUniformGuardedCriticalDimension
   mirror-E: none(waiver:static-algebraic-identifiability)
   anchors: []
   utility: none
   digest: The guarded native cofactor criterion gives the real Hausdorff dimension bound. -/
import D5.S3.Quantum.TensorNetworks.PeriodicMPS.Reconstruction.PeriodicMPSUniformPhysicalAlgebraicGuard
import D5.S3.Quantum.TensorNetworks.PeriodicMPS.Reconstruction.Geometry.PeriodicMPSGuardedRealPolynomialZeros
import D5.S3.Quantum.TensorNetworks.PeriodicMPS.Reconstruction.PeriodicMPSUniformPhysicalRankBridge

/-! The common-divisor condition for the native minors gives a
six-dimensional cover on the guarded ordinary chart. -/

set_option autoImplicit false

namespace D5.S3.Quantum.TensorNetworks.PeriodicMPSUniformGuardedCriticalDimension

open Set MvPolynomial PeriodicMPSRealPolynomialZeros
open PeriodicMPSUniformCompactGraph (Parameters chartDomain)
open PeriodicMPSUniformGraphRecovery (criticalCoordinates)
open PeriodicMPSUniformPhysicalRankBridge (mem_criticalCoordinates_iff_native_minors)
open SevenSitePhysicalRankBridge (Ordinary Rotation SlicePoint align physicalChart analyticAt_physicalChart)
open SevenSitePhysicalRankAssembly (alignedSlice asOrdinary)
open UniformNativeCriticalMatrix (criticalMatrix)

open PeriodicMPSUniformPhysicalAlgebraicGuard (dimH_zeroMixed_parameters_le)
open private exists_physicalChart_alignedSlice from
  D5.S3.Quantum.TensorNetworks.PeriodicMPS.Reconstruction.PeriodicMPSUniformPhysicalAlgebraicGuard
open private parametersOfOrdinary parametersOfOrdinary_asOrdinary differentiable_parametersOfOrdinary from
  D5.S3.Quantum.TensorNetworks.PeriodicMPS.Reconstruction.SevenSiteGraphCriticalDimension

noncomputable section

/-- The maximal minor obtained by deleting one row of the native matrix. -/
def nativeCofactor (m : ℕ) (deleted : Fin 10) : MvPolynomial (Fin 5) ℂ :=
  ((criticalMatrix m).submatrix deleted.succAbove id).det

/-- The polynomial ideal generated by the ten native maximal minors. -/
def nativeCofactorIdeal (m : ℕ) : Ideal (MvPolynomial (Fin 5) ℂ) :=
  Ideal.span (range (nativeCofactor m))

private theorem mem_guardedRealZeroSet_nativeCofactorIdeal_iff
    {m : ℕ} {g : MvPolynomial (Fin 5) ℂ} {x : SlicePoint} :
    x ∈ guardedRealZeroSet (nativeCofactorIdeal m) g ↔
      eval (fun j => (x j : ℂ)) g ≠ 0 ∧
        ∀ d : Fin 10, eval (fun j => (x j : ℂ)) (nativeCofactor m d) = 0 := by
  constructor
  · intro hx
    exact ⟨hx.1, fun d => hx.2 _ (Ideal.subset_span ⟨d, rfl⟩)⟩
  · rintro ⟨hg, hm⟩
    have hker : nativeCofactorIdeal m ≤ RingHom.ker (eval (fun j => (x j : ℂ))) := by
      apply Ideal.span_le.mpr
      rintro _ ⟨d, rfl⟩
      exact RingHom.mem_ker.mpr (hm d)
    exact ⟨hg, fun p hp => RingHom.mem_ker.mp (hker hp)⟩

-- The two stereographic phase inverses used in SevenSiteGraphCriticalDimension.
/-- Both phase-frame images of the guarded cofactor zero set are covered by
countably many differentiable maps with six real input coordinates. -/
theorem cover_guarded_nativeCofactors_phaseCharts (m : ℕ)
    (hI : nativeCofactorIdeal m ≠ ⊥) {g : MvPolynomial (Fin 5) ℂ}
    (hguard : ∀ r, Irreducible r → (∀ d, r ∣ nativeCofactor m d) → r ∣ g) :
    ∃ (ι : Type) (_ : Countable ι)
      (D : ι → Set (Rotation × (Fin 3 → ℝ)))
      (f : ι → Rotation × (Fin 3 → ℝ) → Ordinary),
      (∀ i, DifferentiableOn ℝ (f i) (D i)) ∧
        ((fun q : Bool × (Rotation × SlicePoint) =>
          physicalChart (if q.1 then 1 else -1) q.2) ''
          {q | q.2.2 ∈ guardedRealZeroSet (nativeCofactorIdeal m) g}) ⊆ ⋃ i, f i '' D i := by
  have hdiv : ∀ r, Irreducible r → (∀ a ∈ nativeCofactorIdeal m, r ∣ a) → r ∣ g :=
    fun r hr ha => hguard r hr fun d => ha _ (Ideal.subset_span ⟨d, rfl⟩)
  obtain ⟨ι, hι, D, f, hdf, hcov⟩ := cover_guarded_real_common_zeros (n := 3) hI hdiv
  let : Countable ι := hι
  let E := Rotation × (Fin 3 → ℝ)
  let W (j : Bool × ι) : Set E := {q | q.2 ∈ D j.2}
  let F (j : Bool × ι) (q : E) : Ordinary :=
    physicalChart (if j.1 then 1 else -1) (q.1, f j.2 q.2)
  refine ⟨Bool × ι, inferInstance, W, F, ?_, ?_⟩
  · intro j
    have hf' : DifferentiableOn ℝ (fun q : E => f j.2 q.2) (W j) :=
      (hdf j.2).comp differentiable_snd.differentiableOn (fun _ h => h)
    have hchart : Differentiable ℝ (physicalChart (if j.1 then 1 else -1)) :=
      fun v => (analyticAt_physicalChart _ v).differentiableAt
    exact hchart.comp_differentiableOn (differentiable_fst.differentiableOn.prodMk hf')
  · rintro _ ⟨⟨b, v, x⟩, hx, rfl⟩
    obtain ⟨i, u, hu, rfl⟩ := mem_iUnion.mp (hcov hx)
    exact mem_iUnion.mpr ⟨(b, i), (v, u), hu, rfl⟩

/-- The critical set of the actual normalized readout has Hausdorff dimension
at most six where the aligned mixed trace and the evaluated guard are nonzero. -/
theorem dimH_guarded_criticalCoordinates_le (m : ℕ)
    (hI : nativeCofactorIdeal m ≠ ⊥) {g : MvPolynomial (Fin 5) ℂ}
    (hguard : ∀ r, Irreducible r → (∀ d, r ∣ nativeCofactor m d) → r ∣ g) :
    dimH {u ∈ criticalCoordinates m | (align (asOrdinary u)).2.2.2 ≠ 0 ∧
      eval (fun i => (alignedSlice (asOrdinary u) i : ℂ)) g ≠ 0} ≤ 6 := by
  obtain ⟨ι, hι, D, f, hdf, hcov⟩ := cover_guarded_nativeCofactors_phaseCharts m hI hguard
  let : Countable ι := hι
  have hsub : {u ∈ criticalCoordinates m | (align (asOrdinary u)).2.2.2 ≠ 0 ∧
      eval (fun i => (alignedSlice (asOrdinary u) i : ℂ)) g ≠ 0} ⊆
      ⋃ i, (parametersOfOrdinary ∘ f i) '' D i := by
    rintro u ⟨hu, hK, hg⟩
    have hdomain : u ∈ chartDomain (2 + m) := hu.1
    have hx : alignedSlice (asOrdinary u) ∈ guardedRealZeroSet (nativeCofactorIdeal m) g :=
      mem_guardedRealZeroSet_nativeCofactorIdeal_iff.mpr
        ⟨hg, (mem_criticalCoordinates_iff_native_minors m u hdomain hK).mp hu⟩
    obtain ⟨b, v, hframe⟩ := exists_physicalChart_alignedSlice (asOrdinary u) hK
    obtain ⟨i, w, hw, hfw⟩ := mem_iUnion.mp
      (hcov ⟨(b, v, alignedSlice (asOrdinary u)), hx, hframe⟩)
    exact mem_iUnion.mpr ⟨i, w, hw,
      (congrArg parametersOfOrdinary hfw).trans (parametersOfOrdinary_asOrdinary u)⟩
  apply (dimH_mono hsub).trans
  rw [dimH_iUnion]
  apply iSup_le
  intro i
  calc
    _ ≤ dimH (D i) := (differentiable_parametersOfOrdinary.comp_differentiableOn (hdf i)).dimH_image_le
    _ ≤ dimH (univ : Set (Rotation × (Fin 3 → ℝ))) := dimH_mono (subset_univ _)
    _ = 6 := by
      rw [Real.dimH_univ_eq_finrank]
      norm_num [Rotation, Module.finrank_prod, Module.finrank_pi_fintype]

/-- The remaining geometric input for the full critical set concerns the
guard-zero locus inside the nonzero aligned mixed-trace sector. -/
theorem dimH_criticalCoordinates_le_of_guard (m : ℕ)
    (hI : nativeCofactorIdeal m ≠ ⊥) {g : MvPolynomial (Fin 5) ℂ}
    (hguard : ∀ r, Irreducible r → (∀ d, r ∣ nativeCofactor m d) → r ∣ g)
    (hguardZero : dimH {u ∈ criticalCoordinates m | (align (asOrdinary u)).2.2.2 ≠ 0 ∧
      eval (fun i => (alignedSlice (asOrdinary u) i : ℂ)) g = 0} ≤ 6) :
    dimH (criticalCoordinates m) ≤ 6 := by
  have hsub : criticalCoordinates m ⊆
      ({u : Parameters | (align (asOrdinary u)).2.2.2 = 0} ∪
        {u ∈ criticalCoordinates m | (align (asOrdinary u)).2.2.2 ≠ 0 ∧
          eval (fun i => (alignedSlice (asOrdinary u) i : ℂ)) g = 0}) ∪
        {u ∈ criticalCoordinates m | (align (asOrdinary u)).2.2.2 ≠ 0 ∧
          eval (fun i => (alignedSlice (asOrdinary u) i : ℂ)) g ≠ 0} := by
    intro u hu
    by_cases hK : (align (asOrdinary u)).2.2.2 = 0
    · exact Or.inl (Or.inl hK)
    by_cases hg : eval (fun i => (alignedSlice (asOrdinary u) i : ℂ)) g = 0
    · exact Or.inl (Or.inr ⟨hu, hK, hg⟩)
    · exact Or.inr ⟨hu, hK, hg⟩
  apply (dimH_mono hsub).trans
  rw [dimH_union, dimH_union]
  exact sup_le (sup_le dimH_zeroMixed_parameters_le hguardZero)
    (dimH_guarded_criticalCoordinates_le m hI hguard)

end

end D5.S3.Quantum.TensorNetworks.PeriodicMPSUniformGuardedCriticalDimension
