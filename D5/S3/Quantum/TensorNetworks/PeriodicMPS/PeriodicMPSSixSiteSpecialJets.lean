/-- The two lifts in chart coordinates and with raw gain one. -/
def source : Fin 2 → Fin 9 → ℚ := ![source0, source1]

/-- Source velocities for the common tangential direction `Re G₀₃`. -/
def firstDirection : Fin 2 → Fin 9 → ℚ := ![firstDirection0, firstDirection1]

/-- Source quadratic terms that cancel tangential curvature. -/
def secondDirection : Fin 2 → Fin 9 → ℚ := ![secondDirection0, secondDirection1]

def derivative : Fin 2 → Matrix (Fin 9) (Fin 9) ℚ := ![derivative0, derivative1]

def inverse : Fin 2 → Matrix (Fin 9) (Fin 9) ℚ := ![inverse0, inverse1]

private def pathAmplitudes : Fin 2 → Fin 14 → Gaussian D₃ := ![pathAmplitudes0, pathAmplitudes1]

def commonReadout : Fin 10 → ℚ := ![121, 19, -34, 0, 0, 15, 11, 0, 0, 0]

def normalQuadratic : ℚ := 143 / 356

def normalCubics : Fin 2 → ℚ := ![-377887081 / 461156881288, -205091262776282441 / 1061255258182380232]
