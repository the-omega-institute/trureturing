set_option maxRecDepth 32768 in
set_option maxHeartbeats 8000000 in
/-- The first nine rows of the dual-number Jacobian equal the supplied rational matrix. -/
theorem tangentJacobian_eq (i : Fin 2) : tangentJacobian (source i) = derivative i := by
  fin_cases i <;> ext j k <;> fin_cases j <;> fin_cases k <;> decide +kernel

set_option maxRecDepth 8192 in
set_option maxHeartbeats 4000000 in
/-- The supplied rational inverse works on both sides. -/
theorem tangent_inverse (i : Fin 2) :
    tangentJacobian (source i) * inverse i = 1 ∧ inverse i * tangentJacobian (source i) = 1 := by
  rw [tangentJacobian_eq]
  fin_cases i <;> constructor <;> ext j k <;> fin_cases j <;> fin_cases k <;> decide +kernel

theorem tangent_nonsingular (i : Fin 2) : (tangentJacobian (source i)).det ≠ 0 := by
  have hd := congrArg Matrix.det (tangent_inverse i).1
  rw [Matrix.det_mul, Matrix.det_one] at hd
  exact left_ne_zero_of_mul_eq_one hd

set_option maxRecDepth 32768 in
set_option maxHeartbeats 4000000 in
/-- Both lifts give the same ten selected raw entries at gain one. -/
theorem raw_source (i : Fin 2) : raw (source i) = commonReadout := by
  funext j
  fin_cases i <;> fin_cases j <;> decide +kernel

set_option maxRecDepth 32768 in
set_option maxHeartbeats 8000000 in
-- Reduce the necklace polynomials before forming any Gram entry of the jet.
private theorem evalPathAmplitudes (i : Fin 2) :
    amplitude (pathInput (source i) (firstDirection i) (secondDirection i)) = pathAmplitudes i := by
  funext k
  fin_cases i <;> fin_cases k <;> apply QuadraticAlgebra.ext <;>
    apply TrivSqZeroExt.ext <;> apply TrivSqZeroExt.ext <;> apply TrivSqZeroExt.ext <;>
    decide +kernel

private theorem jet_eq (i : Fin 2) (j : Fin 10) :
    jet (source i) (firstDirection i) (secondDirection i) j =
      readout (pathInput (source i) (firstDirection i) (secondDirection i) 8)
        (pathAmplitudes i) j := by
  unfold jet raw
  rw [evalPathAmplitudes i]

set_option maxRecDepth 32768 in
set_option maxHeartbeats 8000000 in
/-- The path follows the `Re G₀₃` direction to first order, its tangential
quadratic terms vanish, and its normal cubic is the supplied rational. -/
theorem exact_jet_coefficients (i : Fin 2) :
    (∀ j, rawJacobian (source i) 9 j = 0) ∧
    (∀ j : Fin 9, (tangentJacobian (source i) *ᵥ firstDirection i) j = if j = 3 then 1 else 0) ∧
    (∀ j : Fin 9, quadraticCoefficient (source i) (firstDirection i) (secondDirection i) j.castSucc = 0) ∧
    cubicCoefficient (source i) (firstDirection i) (secondDirection i) 9 = normalCubics i := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · intro j
    fin_cases i <;> fin_cases j <;> decide +kernel
  · intro j
    rw [tangentJacobian_eq]
    fin_cases i <;> fin_cases j <;> decide +kernel
  · intro j
    rw [quadraticCoefficient, jet_eq]
    fin_cases i <;> fin_cases j <;> decide +kernel
  · rw [cubicCoefficient, jet_eq]
    fin_cases i <;> decide +kernel

set_option maxRecDepth 32768 in
set_option maxHeartbeats 4000000 in
theorem normalQuadratic_eq (i : Fin 2) :
    quadraticCoefficient (source i) (firstDirection i) (secondDirection i) 9 = normalQuadratic := by
  rw [quadraticCoefficient, jet_eq]
  fin_cases i <;> decide +kernel

theorem normalCubics_ne : normalCubics 0 ≠ normalCubics 1 := by
  decide +kernel

end D5.S3.Quantum.TensorNetworks.PeriodicMPSSixSiteSpecialJets
