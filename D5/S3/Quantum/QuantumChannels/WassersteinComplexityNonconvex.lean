private theorem midpoint_cross : D2 pauli D5.S3.Quantum.Dynamics.PositivePauliClockOrder.rhoPlus (Psi D5.S3.Quantum.Dynamics.PositivePauliClockOrder.rhoPlus) = 5 := by
  have hr := diagState_isState (a:=1) (b:=0) (by norm_num) (by norm_num) (by norm_num)
