open D5.S3.Quantum.QuantumChannels.QubitWassersteinCouplings
noncomputable section

def claim : Prop :=
  ∀ (d k : ℕ) (A : Fin k → Matrix (Fin d) (Fin d) ℂ),
    (∀ j, (A j).IsHermitian) →
    ∀ Phi1 Phi2,
      D5.S3.QuantumChannels.CoPRelativeQuantumnessRefutation.IsCPTP Phi1 →
      D5.S3.QuantumChannels.CoPRelativeQuantumnessRefutation.IsCPTP Phi2 →
      ∀ s : ℝ, 0 ≤ s → s ≤ 1 →
        CW A (s • Phi1 + (1 - s) • Phi2) ≤
          s * CW A Phi1 + (1 - s) * CW A Phi2

def phaseU (e : ℝ) : Matrix (Fin 2) (Fin 2) ℂ :=
  diagonal ![((Real.sqrt 3 : ℂ) + e * Complex.I)/2, ((Real.sqrt 3 : ℂ) - e * Complex.I)/2]

def Phi (e : ℝ) : Matrix (Fin 2) (Fin 2) ℂ →ₗ[ℂ] Matrix (Fin 2) (Fin 2) ℂ :=
  LinearMap.mulLeftRight ℂ (phaseU e, (phaseU e).conjTranspose)

def AdZ : Matrix (Fin 2) (Fin 2) ℂ →ₗ[ℂ] Matrix (Fin 2) (Fin 2) ℂ :=
  LinearMap.mulLeftRight ℂ (D5.S3.Quantum.FiniteDimensional.qubitZ,
    D5.S3.Quantum.FiniteDimensional.qubitZ)
def Psi : Matrix (Fin 2) (Fin 2) ℂ →ₗ[ℂ] Matrix (Fin 2) (Fin 2) ℂ := (3/4 : ℝ) • LinearMap.id + (1/4 : ℝ) • AdZ

private theorem phaseU_unitary {e : ℝ} (he : e^2=1) :
    (phaseU e).conjTranspose * phaseU e = 1 ∧ phaseU e * (phaseU e).conjTranspose = 1 := by
  have hs : (Real.sqrt 3)^2 = 3 := Real.sq_sqrt (by norm_num)
  constructor <;> ext i j <;> fin_cases i <;> fin_cases j <;>
    apply Complex.ext <;>
    norm_num [phaseU, Matrix.mul_apply, Fin.sum_univ_two, Matrix.conjTranspose_apply,
      Complex.mul_re, Complex.mul_im, Complex.div_re, Complex.div_im] <;> nlinarith

private theorem Phi_isChannel {e : ℝ} (he : e^2=1) : D5.S3.QuantumChannels.CoPRelativeQuantumnessRefutation.IsCPTP (Phi e) := by
  have hU := phaseU_unitary he
  constructor
  · have hh := MatrixMap.of_kraus_isCompletelyPositive (fun _ : Fin 1 => phaseU e)
    have hf : MatrixMap.of_kraus (fun _ : Fin 1 => phaseU e) (fun _ : Fin 1 => phaseU e) = Phi e := by
      ext rho i j
      simp [MatrixMap.of_kraus,Phi,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.unitaryEvolution,Matrix.star_eq_conjTranspose,Fin.sum_univ_succ]
    rwa [hf] at hh
  · intro rho
    change trace (phaseU e * rho * (phaseU e).conjTranspose) = trace rho
    rw [Matrix.trace_mul_cycle,hU.1,Matrix.one_mul]

private theorem midpoint_identity : (1/2 : ℝ) • Phi 1 + (1-1/2 : ℝ) • Phi (-1) = Psi := by
  ext rho i j
  fin_cases i <;> fin_cases j <;> apply Complex.ext <;>
    norm_num [Phi,Psi,AdZ,D5.S3.Quantum.FiniteDimensional.qubitZ,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.unitaryEvolution,Matrix.star_eq_conjTranspose,phaseU,Matrix.mul_apply,Matrix.vecMul,Matrix.mulVec,dotProduct,Fin.sum_univ_two,
      Matrix.conjTranspose_apply,Complex.ext_iff,Complex.mul_re,Complex.mul_im,
      Complex.div_re,Complex.div_im]
  all_goals ring_nf
  all_goals norm_num [Real.sq_sqrt]
  all_goals ring

theorem trace_sqrt_sq_le_two {rho : Matrix (Fin 2) (Fin 2) ℂ} (hr : D5.S3.QuantumChannels.CoPRelativeQuantumnessRefutation.IsDensity rho) :
    (CFC.sqrt rho).trace.re^2 ≤ 2 := by
  obtain ⟨a,b,ha,hb,hab,_,ht⟩ := self_cost_spectral hr
  rw [ht]
  have hsa := Real.sq_sqrt ha
  have hsb := Real.sq_sqrt hb
  nlinarith [sq_nonneg (Real.sqrt a - Real.sqrt b)]

private theorem phase_trace_bound {e : ℝ} (S : Matrix (Fin 2) (Fin 2) ℂ) (hs : S.PosSemidef) :
    3/4 * S.trace.re^2 ≤ Complex.normSq (phaseU e * S).trace := by
  have hi := (hs.diag_nonneg (i := 0)).2.symm
  have hj := (hs.diag_nonneg (i := 1)).2.symm
  have hre : (phaseU e * S).trace.re = Real.sqrt 3 / 2 * S.trace.re := by
    simp [phaseU,Matrix.trace,Matrix.mul_apply,Matrix.vecMul,Matrix.mulVec,dotProduct,Fin.sum_univ_two,Complex.mul_re,
      Complex.mul_im,Complex.div_re,Complex.div_im,hi,hj]
    ring
  have h3 := Real.sq_sqrt (show (0 : ℝ) ≤ 3 by norm_num)
  rw [Complex.normSq_apply,hre]
  nlinarith [sq_nonneg (phaseU e * S).trace.im]

private theorem phase_pure_coupling {e : ℝ} (he : e^2=1) {rho : Matrix (Fin 2) (Fin 2) ℂ} (hr : D5.S3.QuantumChannels.CoPRelativeQuantumnessRefutation.IsDensity rho) :
    pureCoupling (phaseU e * CFC.sqrt rho) ∈ couplings rho (Phi e rho) := by
  let S := CFC.sqrt rho
  have hsp : S.PosSemidef := Matrix.nonneg_iff_posSemidef.mp (CFC.sqrt_nonneg rho)
  have hs := hsp.1.eq
  have hss : S*S = rho := CFC.sqrt_mul_sqrt_self rho hr.1.nonneg
  have hU := phaseU_unitary he
  have hp2 : D5.S3.Quantum.Information.PartialTraceMutualInformation.partialTraceRight (pureCoupling (phaseU e * S)) = Phi e rho := by
    rw [ptrace2_pure, Matrix.conjTranspose_mul,hs]
    change phaseU e * S * (S * (phaseU e).conjTranspose) = D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.unitaryEvolution (phaseU e) rho
    simp only [D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.unitaryEvolution,Matrix.star_eq_conjTranspose]
    rw [Matrix.mul_assoc,← Matrix.mul_assoc S S,hss]
    simp only [Matrix.mul_assoc]
  refine ⟨⟨pureCoupling_psd _, ?_⟩,hp2,?_⟩
  · have ht := congrArg Matrix.trace hp2
    change trace (D5.S3.Quantum.Information.PartialTraceMutualInformation.partialTraceRight _) = _ at ht
    rw [D5.S3.Quantum.Information.PartialTraceMutualInformation.trace_partialTraceRight] at ht
    exact ht.trans (rotate_isState hU.1 hr).2
  · rw [ptrace1_pure,Matrix.conjTranspose_mul,hs]
    have hm : S * (phaseU e).conjTranspose * (phaseU e * S) = rho := by
      rw [Matrix.mul_assoc,← Matrix.mul_assoc (phaseU e).conjTranspose,hU.1,
        Matrix.one_mul,hss]
    rw [hm]

private theorem endpoint_bound {e : ℝ} (he : e^2=1) {rho : Matrix (Fin 2) (Fin 2) ℂ} (hr : D5.S3.QuantumChannels.CoPRelativeQuantumnessRefutation.IsDensity rho) :
    dA pauli rho (Phi e rho) ≤ Real.sqrt 2 := by
  have hU := phaseU_unitary he
  have hp := phase_pure_coupling he hr
  have hc := D2_le_cost pauli_hermitian hp
  rw [pauli_cost,hp.1.2,overlap_pure] at hc
  have hself := self_cost hr
  have hout : D2 pauli (Phi e rho) (Phi e rho) = D2 pauli rho rho := D2_rotate hU.1 hU.2 hr hr
  have hb := phase_trace_bound (e:=e) (CFC.sqrt rho) (Matrix.nonneg_iff_posSemidef.mp (CFC.sqrt_nonneg rho))
  have ht := trace_sqrt_sq_le_two hr
  unfold dA
  apply Real.sqrt_le_sqrt
  rw [hout,hself]
  simp only [Complex.one_re] at hc
  nlinarith

private theorem CW_endpoint_bound {e : ℝ} (he : e^2=1) : CW pauli (Phi e) ≤ Real.sqrt 2 := by
  apply csSup_le
  · exact ⟨_,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState ![1,0],diagState_isState (by norm_num) (by norm_num) (by norm_num),rfl⟩
  · rintro x ⟨rho,hr,rfl⟩
    exact endpoint_bound he hr

end
