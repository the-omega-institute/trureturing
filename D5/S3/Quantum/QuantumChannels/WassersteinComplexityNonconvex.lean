theorem pure_diag_coupling {omega : Matrix (Fin 2) (Fin 2) ℂ} {P : Matrix (Fin 2 × Fin 2) (Fin 2 × Fin 2) ℂ}
    (hp : P ∈ couplings (D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState ![1,0]) omega) : P = omega ⊗ₖ (D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState ![1,0]).transpose := by
  have h1 := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℂ => (M 1 1).re) hp.2.2
  simp [D5.S3.Quantum.Information.PartialTraceMutualInformation.partialTraceLeft,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState,Fin.sum_univ_two] at h1
  have hn0 := (hp.1.1.diag_nonneg (i := (0,1))).1
  have hn1 := (hp.1.1.diag_nonneg (i := (1,1))).1
  simp only [Complex.zero_re] at hn0 hn1
  have hz (i : Fin 2) : (P (i,1) (i,1)).re = 0 := by fin_cases i <;> dsimp <;> linarith
  have hrow (i : Fin 2) (q : Fin 2 × Fin 2) : P (i,1) q = 0 := by
    have h := D5.S3.Quantum.Matrix.CartesianVariance.psd_entry_bound hp.1.1 (i,1) q
    rw [hz i,zero_mul] at h
    exact Complex.normSq_eq_zero.mp (le_antisymm h (Complex.normSq_nonneg _))
  have hcol (i : Fin 2) (q : Fin 2 × Fin 2) : P q (i,1) = 0 := by
    rw [← hp.1.1.1.apply q (i,1),hrow,star_zero]
  have hm (i j : Fin 2) : P (i,0) (j,0) = omega i j := by
    have hh := congrArg (fun M : Matrix (Fin 2) (Fin 2) ℂ => M i j) hp.2.1
    simpa [D5.S3.Quantum.Information.PartialTraceMutualInformation.partialTraceRight,Fin.sum_univ_two,hrow] using hh
  ext p q
  rcases p with ⟨i,b⟩
  rcases q with ⟨j,c⟩
  fin_cases b <;> fin_cases c <;> simp [Matrix.kroneckerMap_apply,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState,hrow,hcol,hm]

private theorem pure_diag_D2 {omega : Matrix (Fin 2) (Fin 2) ℂ} (ho : D5.S3.QuantumChannels.CoPRelativeQuantumnessRefutation.IsDensity omega) :
    D2 pauli (D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState ![1,0]) omega = cost pauli (omega ⊗ₖ (D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState ![1,0]).transpose) := by
  have hr := diagState_isState (a:=1) (b:=0) (by norm_num) (by norm_num) (by norm_num)
  apply le_antisymm (D2_le_cost pauli_hermitian (product_coupling hr ho))
  apply le_csInf ((couplings_nonempty hr ho).image _)
  rintro _ ⟨P,hp,rfl⟩
  rw [pure_diag_coupling hp]

private theorem H_unitary : D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.hadamard.conjTranspose * D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.hadamard = 1 ∧ D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.hadamard * D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.hadamard.conjTranspose = 1 := by
  have h := D5.S3.Quantum.Entanglement.NandiMutualPredictabilityLOCCRefutation.hadamard_unitary
  exact ⟨by simpa only [Matrix.star_eq_conjTranspose] using Matrix.mem_unitaryGroup_iff'.mp h,
    by simpa only [Matrix.star_eq_conjTranspose] using Matrix.mem_unitaryGroup_iff.mp h⟩

private theorem plus_eq_rotate : D5.S3.Quantum.Dynamics.PositivePauliClockOrder.rhoPlus = D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.unitaryEvolution D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.hadamard (D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState ![1,0]) := by
  have h2 := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  have hn : Real.sqrt 2 ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by norm_num))
  ext i j
  fin_cases i <;> fin_cases j <;> apply Complex.ext <;>
    norm_num [D5.S3.Quantum.Dynamics.PositivePauliClockOrder.rhoPlus,Matrix.vecMulVec,Matrix.vecHead,Matrix.vecTail,Pi.smul_apply,Matrix.smul_apply,Pi.star_apply,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.unitaryEvolution,Matrix.star_eq_conjTranspose,D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.hadamard, D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.s2, D5.S3.Quantum.Information.StabilizerPairLocalUnitaryInequivalence.pauliMatrix, D5.S3.Quantum.FiniteDimensional.qubitX, D5.S3.Quantum.FiniteDimensional.qubitZ,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState,Matrix.mul_apply,Matrix.vecMul,Matrix.mulVec,dotProduct,Fin.sum_univ_two,Matrix.conjTranspose_apply,
      Complex.ext_iff,Complex.mul_re,Complex.mul_im,Complex.div_re,Complex.div_im]
  all_goals field_simp
  all_goals nlinarith

