    norm_num [Psi,D5.S3.Quantum.Dynamics.PositivePauliClockOrder.rhoPlus,Matrix.vecMulVec,Matrix.vecHead,Matrix.vecTail,Pi.smul_apply,Matrix.smul_apply,Pi.star_apply,AdZ,D5.S3.Quantum.FiniteDimensional.qubitZ,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.unitaryEvolution,Matrix.star_eq_conjTranspose,D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.hadamard, D5.S3.Quantum.Information.BinaryStabilizerLocalInequivalence.s2, D5.S3.Quantum.Information.StabilizerPairLocalUnitaryInequivalence.pauliMatrix, D5.S3.Quantum.FiniteDimensional.qubitX, D5.S3.Quantum.FiniteDimensional.qubitZ,D5.S3.Quantum.Decoherence.ProjectedUnistochasticDynamics.diagonalState,Matrix.mul_apply,Matrix.vecMul,Matrix.mulVec,dotProduct,Fin.sum_univ_two,
      Matrix.conjTranspose_apply,Complex.ext_iff,Complex.mul_re,Complex.mul_im,
      Complex.div_re,Complex.div_im]
  all_goals field_simp
