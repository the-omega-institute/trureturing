private structure SimilarityCertificate {d : ℕ} (T : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (c : ℝ) where
  Uadj : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)
  Uadj_twoPositive : (KPositive 2 _ Uadj)
  Uadj_tracePreserving : (∀ X, Matrix.trace (Uadj X) = Matrix.trace X)
  trace_scale : c * ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) Uadj)).re = ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) T)).re
  min_scale : c * minReSpectrum Uadj = minReSpectrum T
private def UnitalSimilarityGoal : Prop :=
  ∀ (d : ℕ) (T : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (p : PerronCertificate T),
    (KPositive 2 _ T) → Nonempty (SimilarityCertificate T p.c)
private theorem epsilon_rescaling_is_algebraic {d : ℕ}
    (T : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (p : PerronCertificate T)
    (s : SimilarityCertificate T p.c)
    (hT1 : SourceTheorem1Bound s.Uadj) :
    spectralBound T := by
  dsimp [spectralBound, SourceTheorem1Bound] at hT1 ⊢
  have hc : 0 < p.c := p.c_pos
  nlinarith [hT1, s.trace_scale, s.min_scale, p.c_is_max]
private theorem epsilon_route_conditional (hT1 : SourceTheorem1Goal)
    (hP : RegularizedPerronGoal) (hS : UnitalSimilarityGoal)
    {d : ℕ} (hd : 0 < d) (T : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (ε : ℝ) (hε : 0 < ε)
    (h2 : (KPositive 2 _ T)) (h2ε : (KPositive 2 _ (Regularized T ε))) :
    spectralBound (Regularized T ε) := by
  obtain ⟨p⟩ := hP d hd T ε hε h2
  obtain ⟨s⟩ := hS d (Regularized T ε) p h2ε
  exact epsilon_rescaling_is_algebraic (Regularized T ε) p s
    (hT1 d hd s.Uadj s.Uadj_twoPositive s.Uadj_tracePreserving)
end
