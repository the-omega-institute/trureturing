variable {d : ℕ}
private lemma affine_real_extrema {s : Set ℂ} (hs : s.Finite) (hne : s.Nonempty)
    (a : ℂ) (t : ℝ) (ht : 0 ≤ t) :
    sInf (Complex.re '' ((fun z : ℂ => a + (t : ℂ)*z) '' s)) =
      a.re + t * sInf (Complex.re '' s) ∧
    sSup (Complex.re '' ((fun z : ℂ => a + (t : ℂ)*z) '' s)) =
      a.re + t * sSup (Complex.re '' s) := by
  have hmono : Monotone (fun x : ℝ => a.re + t*x) := by
    intro x y hxy
    dsimp
    linarith [mul_le_mul_of_nonneg_left hxy ht]
  have hset : Complex.re '' ((fun z : ℂ => a + (t : ℂ)*z) '' s) =
      (fun x : ℝ => a.re + t*x) '' (Complex.re '' s) := by
    simp only [← Set.image_comp, Function.comp_def, Complex.add_re, Complex.mul_re,
      Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
  rw [hset]
  exact ⟨((hs.image Complex.re).map_sInf_of_monotone hmono (hne.image Complex.re)).symm,
    ((hs.image Complex.re).map_sSup_of_monotone hmono (hne.image Complex.re)).symm⟩
end
