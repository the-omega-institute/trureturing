variable {d : ℕ}
private lemma unital_similarity_certificate : UnitalSimilarityGoal := by
  intro d T p h2
  have hd : 0 < d := by
    by_contra hn
    have hz : d = 0 := by omega
    subst d
    simpa [Matrix.trace] using p.rho_trace
  letI : NeZero d := ⟨ne_of_gt hd⟩
  obtain ⟨R,S,hR,hS,hRS,hSR,hSquare⟩ := faithful_fourth_roots p.rho p.rho_pos
  let A := S * S
  let B := R * R
  have hA : A.IsHermitian := by change (S * S).conjTranspose = S * S; rw [Matrix.conjTranspose_mul,hS.eq]
  have hB : B.IsHermitian := by change (R * R).conjTranspose = R * R; rw [Matrix.conjTranspose_mul,hR.eq]
  have hAB : A * B = 1 := by
    change (S * S) * (R * R) = 1
    calc
      (S * S) * (R * R) = S * (S * R) * R := by noncomm_ring
      _ = 1 := by rw [hSR,Matrix.mul_one,hSR]
  have hBA : B * A = 1 := by
    change (R * R) * (S * S) = 1
    calc
      (R * R) * (S * S) = R * (R * S) * S := by noncomm_ring
      _ = 1 := by rw [hRS,Matrix.mul_one,hRS]
  let e := congrEquiv B A hBA hAB
  let U : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ) := ((p.c⁻¹ : ℝ) : ℂ) • e.conj T
  have he2 : (KPositive 2 _ (e.conj T)) := by
    change (KPositive 2 _ (((LinearMap.mulLeftRight ℂ (B, B.conjTranspose))).comp (T.comp ((LinearMap.mulLeftRight ℂ (A, A.conjTranspose))))))
    exact twoPositive_comp _ _ (congrMap_twoPositive B)
      (twoPositive_comp _ _ h2 (congrMap_twoPositive A))
  have hu2 : (KPositive 2 _ U) := twoPositive_smul _ he2 _ (inv_nonneg.mpr p.c_pos.le)
  have hu : U 1 = 1 := by
    have halg : U = unitalized T A B (p.c : ℂ) := by
      apply LinearMap.ext
      intro X
      change ((p.c⁻¹ : ℝ) : ℂ) • (B * T (A * X * A.conjTranspose) * B.conjTranspose) =
        (p.c : ℂ)⁻¹ • (B * T (A * X * A) * B)
      rw [hA.eq,hB.eq,Complex.ofReal_inv]
    rw [halg]
    exact unitalized_one T A B p.rho p.c
      (by exact_mod_cast p.c_pos.ne') hSquare hBA hAB p.eigen
  have hutp : (∀ X, Matrix.trace (((@LinearMap.adjoint ℂ (Matrix (Fin d) (Fin d) ℂ) (Matrix (Fin d) (Fin d) ℂ) _ (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) hsInner hsInner (by exact FiniteDimensional.finiteDimensional_pi' ℂ _) (by exact FiniteDimensional.finiteDimensional_pi' ℂ _)) U) X) = Matrix.trace X) :=
    (unital_iff_adjoint_tracePreserving U).mp hu
  have htrace : p.c * ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) ((@LinearMap.adjoint ℂ (Matrix (Fin d) (Fin d) ℂ) (Matrix (Fin d) (Fin d) ℂ) _ (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) hsInner hsInner (by exact FiniteDimensional.finiteDimensional_pi' ℂ _) (by exact FiniteDimensional.finiteDimensional_pi' ℂ _)) U))).re = ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) T)).re := by
    have hadj : (LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) ((@LinearMap.adjoint ℂ (Matrix (Fin d) (Fin d) ℂ) (Matrix (Fin d) (Fin d) ℂ) _ (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) hsInner hsInner (by exact FiniteDimensional.finiteDimensional_pi' ℂ _) (by exact FiniteDimensional.finiteDimensional_pi' ℂ _)) U)) = star ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) U)) := hsAdjoint_trace U
    rw [hadj]
    have ht : (LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) U) = ((p.c⁻¹ : ℝ) : ℂ) * (LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) T) := by
      change LinearMap.trace ℂ ((Matrix (Fin d) (Fin d) ℂ)) (((p.c⁻¹ : ℝ) : ℂ) • e.conj T) = _
      rw [map_smul,LinearMap.trace_conj']
      rfl
    rw [Complex.star_def,Complex.conj_re,ht]
    simp only [Complex.mul_re,Complex.ofReal_re,
      Complex.ofReal_im,zero_mul,sub_zero]
    rw [← mul_assoc,mul_inv_cancel₀ p.c_pos.ne',one_mul]
  have hmin : p.c * minReSpectrum ((@LinearMap.adjoint ℂ (Matrix (Fin d) (Fin d) ℂ) (Matrix (Fin d) (Fin d) ℂ) _ (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) hsInner hsInner (by exact FiniteDimensional.finiteDimensional_pi' ℂ _) (by exact FiniteDimensional.finiteDimensional_pi' ℂ _)) U) = minReSpectrum T := by
    rw [(extrema_hsAdjoint U).1]
    change p.c * minReSpectrum (((p.c⁻¹ : ℝ) : ℂ) • e.conj T) = _
    rw [(extrema_smul (e.conj T) p.c⁻¹ (inv_pos.mpr p.c_pos)).1,
      (extrema_conj e T).1]
    rw [← mul_assoc,mul_inv_cancel₀ p.c_pos.ne',one_mul]
  exact ⟨{
    Uadj := (@LinearMap.adjoint ℂ (Matrix (Fin d) (Fin d) ℂ) (Matrix (Fin d) (Fin d) ℂ) _ (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) (Matrix.frobeniusNormedAddCommGroup (m := Fin d) (n := Fin d) (α := ℂ)) hsInner hsInner (by exact FiniteDimensional.finiteDimensional_pi' ℂ _) (by exact FiniteDimensional.finiteDimensional_pi' ℂ _)) U
    Uadj_twoPositive := adjoint_twoPositive U hu2
    Uadj_tracePreserving := hutp
    trace_scale := htrace
    min_scale := hmin
  }⟩
end
section
variable {d : ℕ}
private lemma regularized_tendsto {α : Type*} {l : Filter α} (T : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ))
    {ε : α → ℝ} (hε : Tendsto ε l (nhds 0)) :
    Tendsto (fun x => (Regularized T (ε x)).toContinuousLinearMap) l
      (nhds T.toContinuousLinearMap) := by
  have heps : Tendsto (fun x => (ε x : ℂ)) l (nhds (0:ℂ)) :=
    by simpa only [Complex.ofReal_zero] using hε.ofReal
  have h := (tendsto_const_nhds (x := T.toContinuousLinearMap)).add
    (heps.smul_const (((Matrix.traceLinearMap (Fin d) ℂ ℂ).smulRight (1 : Matrix (Fin d) (Fin d) ℂ))).toContinuousLinearMap)
  have heq : (fun x => (Regularized T (ε x)).toContinuousLinearMap) =
      (fun x => T.toContinuousLinearMap +
        (ε x : ℂ) • (((Matrix.traceLinearMap (Fin d) ℂ ℂ).smulRight (1 : Matrix (Fin d) (Fin d) ℂ))).toContinuousLinearMap) := by
    funext x
    apply ContinuousLinearMap.ext
    intro X
    rfl
  rw [heq]
  have hz : (0:ℂ) • (((Matrix.traceLinearMap (Fin d) ℂ ℂ).smulRight (1 : Matrix (Fin d) (Fin d) ℂ))).toContinuousLinearMap = 0 := by
    apply ContinuousLinearMap.ext
    intro X
    change (0:ℂ) • ((Matrix.traceLinearMap (Fin d) ℂ ℂ).smulRight (1 : Matrix (Fin d) (Fin d) ℂ)) X = 0
    exact zero_smul ℂ _
  simpa only [hz,add_zero] using h
private lemma twoPositive_spectralBound : ∀ d : ℕ, 0 < d → ∀ T : Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ, (KPositive 2 _ T) → spectralBound T := by
  intro d hd T h2
  letI : NeZero d := ⟨ne_of_gt hd⟩
  have hbound : ∀ t : ℝ, 0 < t →
      ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (Regularized T ((t+1)⁻¹)))).re ≤
        (d : ℝ) * minReSpectrum (Regularized T ((t+1)⁻¹)) +
          ((d : ℝ)^2-d) * maxReSpectrum (Regularized T ((t+1)⁻¹)) := by
    intro t ht
    have hp : 0 < (t+1)⁻¹ := inv_pos.mpr (by linarith)
    exact epsilon_route_conditional theorem1_general regularized_perron_certificate
      unital_similarity_certificate hd T _ hp h2
      (regularization_twoPositive T h2 _ hp.le)
  have heps : Tendsto (fun t : ℝ => (t+1)⁻¹) atTop (nhds 0) :=
    tendsto_inv_atTop_zero.comp (tendsto_atTop_add_const_right atTop 1 tendsto_id)
  have hconv := regularized_tendsto T heps
  have hs := extrema_tendsto hconv
  have ht := (superTrace_continuous.tendsto T.toContinuousLinearMap).comp hconv
  exact le_of_tendsto_of_tendsto ((Complex.continuous_re.tendsto _).comp ht)
    ((hs.1.const_mul (d : ℝ)).add (hs.2.const_mul ((d : ℝ)^2-d)))
    ((eventually_gt_atTop (0 : ℝ)).mono (fun t ht => hbound t ht))
end
section
variable {d : ℕ}
set_option maxHeartbeats 800000 in
private theorem semigroup_difference_quotient {d : ℕ} (L : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) :
    Filter.Tendsto (fun t : ℝ => t⁻¹ • ((expEnd L t).toContinuousLinearMap - 1))
      (nhdsWithin 0 ({0} : Set ℝ)ᶜ) (nhds L.toContinuousLinearMap) := by
  have h := @HasDerivAt.tendsto_slope_zero ℝ _
    (Matrix (Fin d) (Fin d) ℂ →L[ℂ] Matrix (Fin d) (Fin d) ℂ)
    (@NonUnitalNormedRing.toNormedAddCommGroup _
      (inferInstance : NormedRing (Matrix (Fin d) (Fin d) ℂ →L[ℂ] Matrix (Fin d) (Fin d) ℂ)).toNonUnitalNormedRing)
    (inferInstance : NormedAlgebra ℝ (Matrix (Fin d) (Fin d) ℂ →L[ℂ] Matrix (Fin d) (Fin d) ℂ)).toNormedSpace
    _ _ _ (hasDerivAt_exp_smul_const' L.toContinuousLinearMap (0 : ℝ))
  change Filter.Tendsto (fun t : ℝ => t⁻¹ • (NormedSpace.exp (t • L.toContinuousLinearMap) - 1))
    (nhdsWithin 0 ({0} : Set ℝ)ᶜ) (nhds L.toContinuousLinearMap)
  simpa only [zero_add, zero_smul, NormedSpace.exp_zero, mul_one] using h
end
section
variable {d : ℕ}
private def differenceQuotient (L : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (t : ℝ) : (Matrix (Fin d) (Fin d) ℂ →L[ℂ] Matrix (Fin d) (Fin d) ℂ) :=
  slope (fun s : ℝ => (expEnd L s).toContinuousLinearMap) 0 t
private lemma differenceQuotient_eq
    (L : Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ) (t : ℝ) :
    differenceQuotient L t = t⁻¹ • ((expEnd L t).toContinuousLinearMap - 1) := by
  change slope (fun s : ℝ => NormedSpace.exp (s • L.toContinuousLinearMap)) 0 t =
    t⁻¹ • (NormedSpace.exp (t • L.toContinuousLinearMap) - 1)
  simp only [slope, sub_zero, vsub_eq_sub]
  rw [zero_smul ℝ L.toContinuousLinearMap, NormedSpace.exp_zero]
private lemma differenceQuotient_tendsto (L : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) :
    Tendsto (differenceQuotient L) (nhdsWithin 0 (Ioi 0))
      (nhds L.toContinuousLinearMap) := by
  have hq : differenceQuotient L =
      fun t : ℝ => t⁻¹ • ((expEnd L t).toContinuousLinearMap - 1) :=
    funext (differenceQuotient_eq L)
  rw [hq]
  apply (semigroup_difference_quotient L).mono_left
  apply nhdsWithin_mono
  intro t ht
  change t ≠ 0
  exact ne_of_gt ht
private lemma exp_affine_differenceQuotient (L : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (t : ℝ) (ht : t ≠ 0) :
    expEnd L t = (1:ℂ) • LinearMap.id +
      (t:ℂ) • (differenceQuotient L t).toLinearMap := by
  rw [differenceQuotient_eq]
  apply LinearMap.ext
  intro X
  have hE : expEnd L t = ((expEnd L t).toContinuousLinearMap).toLinearMap := rfl
  rw [hE]
  simp only [LinearMap.add_apply,LinearMap.smul_apply,one_smul,LinearMap.id_apply]
  ext i j
  change ((expEnd L t).toContinuousLinearMap X) i j = X i j +
    (t:ℂ) * (((t⁻¹:ℝ):ℂ) * (((expEnd L t).toContinuousLinearMap X) i j - X i j))
  have htC : (t:ℂ) ≠ 0 := by exact_mod_cast ht
  rw [Complex.ofReal_inv,← mul_assoc,mul_inv_cancel₀ htC,one_mul]
  ring
private lemma superTrace_id : (LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (LinearMap.id (R := ℂ) (M := (Matrix (Fin d) (Fin d) ℂ)))) = (d:ℂ)^2 := by
  simp [LinearMap.trace_id,Module.finrank_matrix,pow_two]
private lemma exp_trace_differenceQuotient (L : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (t : ℝ) (ht : t ≠ 0) :
    (LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (expEnd L t)) = (d:ℂ)^2 + (t:ℂ) *
      (LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (differenceQuotient L t).toLinearMap) := by
  rw [exp_affine_differenceQuotient L t ht]
  simp only [map_add,map_smul,one_smul,smul_eq_mul]
  rw [show LinearMap.trace ℂ ((Matrix (Fin d) (Fin d) ℂ)) LinearMap.id = (d:ℂ)^2 from superTrace_id]
private lemma differenceQuotient_bound [NeZero d] (L : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (t : ℝ) (ht : 0 < t)
    (hb : spectralBound (expEnd L t)) :
    spectralBound (differenceQuotient L t).toLinearMap := by
  have hs := extrema_affine (differenceQuotient L t).toLinearMap 1 t ht
  rw [← exp_affine_differenceQuotient L t ht.ne'] at hs
  have htr := exp_trace_differenceQuotient L t ht.ne'
  dsimp [spectralBound] at hb ⊢
  rw [htr,hs.1,hs.2] at hb
  simp only [Complex.add_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,
    Complex.one_re,zero_mul,sub_zero] at hb
  have hdreal : ((d:ℂ)^2).re = (d:ℝ)^2 := by norm_cast
  rw [hdreal] at hb
  nlinarith
private lemma differenceQuotient_trace_real (L : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (t : ℝ) (ht : 0 < t)
    (h2 : (KPositive 2 _ (expEnd L t))) :
    ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (differenceQuotient L t).toLinearMap)).im = 0 := by
  have him : ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (expEnd L t))).im = 0 :=
    superoperator_trace_real_twoPositive _ h2
  rw [exp_trace_differenceQuotient L t ht.ne'] at him
  have hdreal : ((d:ℂ)^2).im = 0 := by simp [pow_two,Complex.mul_im]
  simp only [Complex.add_im,hdreal,Complex.mul_im,Complex.ofReal_re,
    Complex.ofReal_im,mul_zero,zero_mul,add_zero,zero_add] at him
  exact (mul_eq_zero.mp him).resolve_left ht.ne'
end
section
variable {d : ℕ}
lemma result : claim := by
  intro d hd L hL
  letI : NeZero d := ⟨ne_of_gt hd⟩
  have hq := differenceQuotient_tendsto L
  have hs := extrema_tendsto hq
  have ht := (superTrace_continuous.tendsto L.toContinuousLinearMap).comp hq
  have he : ∀ᶠ t : ℝ in nhdsWithin 0 (Ioi 0),
      spectralBound (differenceQuotient L t).toLinearMap := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact differenceQuotient_bound L t ht
      (twoPositive_spectralBound d hd (expEnd L t) (hL t ht.le))
  have hIm : ∀ᶠ t : ℝ in nhdsWithin 0 (Ioi 0),
      ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (differenceQuotient L t).toLinearMap)).im = 0 := by
    filter_upwards [self_mem_nhdsWithin] with t ht
    exact differenceQuotient_trace_real L t ht (hL t ht.le)
  constructor
  · have heq : (fun _ : ℝ => (0:ℝ)) =ᶠ[nhdsWithin 0 (Ioi 0)]
        (fun t => ((LinearMap.trace ℂ (Matrix (Fin d) (Fin d) ℂ) (differenceQuotient L t).toLinearMap)).im) := by
      filter_upwards [hIm] with t ht
      exact ht.symm
    exact tendsto_nhds_unique ((Complex.continuous_im.tendsto _).comp ht)
      (tendsto_const_nhds.congr' heq)
  · exact le_of_tendsto_of_tendsto ((Complex.continuous_re.tendsto _).comp ht)
      ((hs.1.const_mul (d : ℝ)).add (hs.2.const_mul ((d : ℝ)^2-d))) he
end
