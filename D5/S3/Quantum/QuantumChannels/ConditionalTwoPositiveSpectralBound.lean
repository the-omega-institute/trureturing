variable {E : Type*} [AddCommGroup E] [Module ℂ E]
private lemma affine_hasEigenvalue (f : Module.End ℂ E) (a t z : ℂ) (ht : t ≠ 0) :
    Module.End.HasEigenvalue (a • LinearMap.id + t • f) z ↔
      Module.End.HasEigenvalue f (t⁻¹ * (z-a)) := by
  constructor
  · intro hz
    obtain ⟨v,hv⟩ := hz.exists_hasEigenvector
    apply Module.End.hasEigenvalue_of_hasEigenvector (x := v)
    refine ⟨?_,hv.2⟩
    rw [Module.End.mem_eigenspace_iff]
    have heq : a • v + t • f v = z • v := hv.apply_eq_smul
    have htEq : t • f v = (z-a) • v := by
      rw [sub_smul]
      exact eq_sub_of_add_eq' heq
    calc
      f v = t⁻¹ • (t • f v) := by rw [smul_smul, inv_mul_cancel₀ ht, one_smul]
      _ = (t⁻¹ * (z-a)) • v := by rw [htEq, smul_smul]
  · intro hz
    obtain ⟨v,hv⟩ := hz.exists_hasEigenvector
    apply Module.End.hasEigenvalue_of_hasEigenvector (x := v)
    refine ⟨?_,hv.2⟩
    rw [Module.End.mem_eigenspace_iff]
    change a • v + t • f v = z • v
    rw [hv.apply_eq_smul, smul_smul, ← mul_assoc, mul_inv_cancel₀ ht, one_mul,
      sub_smul]
    abel
private lemma affine_roots_set [FiniteDimensional ℂ E] (f : Module.End ℂ E)
    (a t : ℂ) (ht : t ≠ 0) :
    {z : ℂ | z ∈ (a • LinearMap.id + t • f).charpoly.roots} =
      (fun z : ℂ => a + t*z) '' {z : ℂ | z ∈ f.charpoly.roots} := by
  ext z
  have hroot (g : Module.End ℂ E) (w : ℂ) :
      w ∈ g.charpoly.roots ↔ Module.End.HasEigenvalue g w := by
    rw [Polynomial.mem_roots g.charpoly_monic.ne_zero,
      Module.End.hasEigenvalue_iff_isRoot_charpoly]
  simp only [Set.mem_setOf_eq, Set.mem_image, hroot,
    affine_hasEigenvalue f a t z ht]
  constructor
  · intro hz
    refine ⟨t⁻¹*(z-a), hz, ?_⟩
    field_simp
    ring
  · rintro ⟨w,hw,rfl⟩
    have heq : t⁻¹ * (a + t*w-a) = w := by field_simp; ring
    rw [heq]
    exact hw
end
