variable {d : ℕ}
private lemma extrema_affine [NeZero d] (Phi : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (a : ℂ) (t : ℝ) (ht : 0 < t) :
    minReSpectrum (a • LinearMap.id + (t : ℂ) • Phi) = a.re + t * minReSpectrum Phi ∧
      maxReSpectrum (a • LinearMap.id + (t : ℂ) • Phi) = a.re + t * maxReSpectrum Phi := by
  have ht0 : (t : ℂ) ≠ 0 := by exact_mod_cast ht.ne'
  have hset := affine_roots_set Phi a (t : ℂ) ht0
  change sInf (Complex.re '' {z : ℂ | z ∈ (a • LinearMap.id + (t : ℂ) • Phi).charpoly.roots}) = _ ∧
    sSup (Complex.re '' {z : ℂ | z ∈ (a • LinearMap.id + (t : ℂ) • Phi).charpoly.roots}) = _
  rw [hset]
  exact affine_real_extrema (roots_finite Phi) (roots_nonempty Phi) a t ht.le
private lemma extrema_smul [NeZero d] (Phi : (Matrix (Fin d) (Fin d) ℂ →ₗ[ℂ] Matrix (Fin d) (Fin d) ℂ)) (t : ℝ) (ht : 0 < t) :
    minReSpectrum ((t : ℂ) • Phi) = t * minReSpectrum Phi ∧
      maxReSpectrum ((t : ℂ) • Phi) = t * maxReSpectrum Phi := by
  simpa using extrema_affine Phi 0 t ht
end
