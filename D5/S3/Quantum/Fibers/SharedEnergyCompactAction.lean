/-- The actual diagonal unitary representation of the circle in the fixed basis. -/
def energyRepresentation (m : ℕ) : Circle →* Matrix.unitaryGroup (Fin 3) ℂ where
  toFun z := ⟨Matrix.diagonal (fun i => (z : ℂ) ^ energy m i), by
    rw [Matrix.mem_unitaryGroup_iff]
    simp only [Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose,
      Matrix.diagonal_mul_diagonal, ← Matrix.diagonal_one]
    congr 1
    funext i
    change (z : ℂ) ^ energy m i * star ((z : ℂ) ^ energy m i) = 1
    rw [star_zpow₀]
    have hs : star (z : ℂ) = (z : ℂ)⁻¹ := by
      rw [← Circle.coe_inv, Circle.coe_inv_eq_conj]
      rfl
    rw [hs, ← mul_zpow, mul_inv_cancel₀ (Circle.coe_ne_zero z), _root_.one_zpow]⟩
  map_one' := by
    apply Subtype.ext
    simp
  map_mul' z w := by
    apply Subtype.ext
    simp [mul_zpow, Matrix.diagonal_mul_diagonal]

/-- The compact subgroup of actual matrices generated by the fixed Hamiltonian. -/
def energyGroup (m : ℕ) : Subgroup (Matrix.unitaryGroup (Fin 3) ℂ) :=
  (energyRepresentation m).range

private theorem energy_representation_continuous (m : ℕ) :
    Continuous (energyRepresentation m) := by
  apply Continuous.subtype_mk
  apply Continuous.matrix_diagonal
  apply continuous_pi
  intro i
  change Continuous (fun z : Circle => ((z ^ energy m i : Circle) : ℂ))
  exact continuous_subtype_val.comp
    ((continuous_id : Continuous (fun z : Circle => z)).zpow (energy m i))

private def energyLift (m : ℕ) (z : Circle) : energyGroup m :=
  ⟨energyRepresentation m z, ⟨z, rfl⟩⟩

private theorem energy_lift_surjective (m : ℕ) : Function.Surjective (energyLift m) := by
  intro U
  obtain ⟨z, hz⟩ := U.2
  exact ⟨z, Subtype.ext hz⟩

instance energyGroupCompact (m : ℕ) : CompactSpace (energyGroup m) :=
  Function.Surjective.compactSpace
    ((energy_representation_continuous m).subtype_mk _) (energy_lift_surjective m)

instance energyGroupMeasurable (m : ℕ) : MeasurableSpace (energyGroup m) := borel _
instance energyGroupBorel (m : ℕ) : BorelSpace (energyGroup m) := ⟨rfl⟩

/-- Normalized Haar probability on the actual compact matrix subgroup. -/
def energyHaar (m : ℕ) : MeasureTheory.Measure (energyGroup m) :=
  MeasureTheory.Measure.haarMeasure ⊤

instance energyHaarProbability (m : ℕ) : MeasureTheory.IsProbabilityMeasure (energyHaar m) :=
  ⟨MeasureTheory.Measure.haarMeasure_self⟩

instance energyHaarLeftInvariant (m : ℕ) : (energyHaar m).IsMulLeftInvariant := by
  unfold energyHaar
  infer_instance

/-- Matrix tensor powers in exactly the basis used by native density copies. -/
def matrixCopies (X : Matrix (Fin 3) (Fin 3) ℂ) : (n : ℕ) →
    Matrix (CopyIndex (Fin 3) n) (CopyIndex (Fin 3) n) ℂ
  | 0 => 1
  | 1 => X
  | n+2 => X ⊗ₖ matrixCopies X (n+1)

private theorem copies_matrix (r : DensityState (Fin 3)) : ∀ n,
    matrixCopies (stateMatrix r) n = stateMatrix (copies r n)
  | 0 => rfl
  | 1 => rfl
  | n+2 => by
    change stateMatrix r ⊗ₖ matrixCopies (stateMatrix r) (n+1) =
      stateMatrix r ⊗ₖ stateMatrix (copies r (n+1))
    rw [copies_matrix]

private theorem tensor_representation (m : ℕ) (z : Circle) : ∀ n,
    matrixCopies (energyRepresentation m z).val n =
      Matrix.diagonal (fun I => (z : ℂ) ^ totalEnergy m n I)
  | 0 => by ext I J; simp [matrixCopies, totalEnergy, Matrix.diagonal, Matrix.one_apply]
  | 1 => rfl
  | n+2 => by
    rw [matrixCopies, tensor_representation]
    ext ⟨a,I⟩ ⟨b,J⟩
    change (if a=b then (z : ℂ)^energy m a else 0) *
      (if I=J then (z : ℂ)^totalEnergy m (n+1) I else 0) =
        if (a,I)=(b,J) then (z : ℂ)^(energy m a + totalEnergy m (n+1) I) else 0
    by_cases h₁ : a=b <;> by_cases h₂ : I=J <;>
      simp [h₁, h₂, Prod.mk.injEq, zpow_add₀ (Circle.coe_ne_zero z)]

private theorem tensor_time_exponential (m n : ℕ) (t : ℝ) :
    NormedSpace.exp ((-Complex.I * (t : ℂ)) • totalHamiltonian m n) =
      matrixCopies (energyRepresentation m (Circle.exp (-t))).val n := by
  rw [tensor_representation, total_hamiltonian_diagonal, ← Matrix.diagonal_smul,
    Matrix.exp_diagonal]
  congr 1
  funext I
  rw [Pi.coe_exp]
  change NormedSpace.exp (-Complex.I * (t : ℂ) * (totalEnergy m n I : ℂ)) = _
  rw [← Circle.coe_zpow, ← Circle.exp_intCast_mul, Circle.coe_exp,
    Complex.exp_eq_exp_ℂ]
  congr 1
  simp only [Complex.ofReal_mul, Complex.ofReal_intCast, Complex.ofReal_neg]
  ring

/-- The matrix subgroup is precisely the compact closure of the time
exponentials. The native tensor power of each time exponential is the
exponential of the actual sum Hamiltonian. -/
theorem energy_group_realization (m : ℕ) :
    Set.range (fun U : energyGroup m => (U.val : Matrix (Fin 3) (Fin 3) ℂ)) =
      closure (Set.range (fun t : ℝ =>
        NormedSpace.exp ((-Complex.I * (t : ℂ)) • totalHamiltonian m 1))) ∧
    ∀ (n : ℕ) (t : ℝ),
      matrixCopies (NormedSpace.exp ((-Complex.I * (t : ℂ)) • totalHamiltonian m 1)) n =
        NormedSpace.exp ((-Complex.I * (t : ℂ)) • totalHamiltonian m n) := by
  have htime : Set.range (fun t : ℝ =>
        NormedSpace.exp ((-Complex.I * (t : ℂ)) • totalHamiltonian m 1)) =
      Set.range (fun U : energyGroup m => (U.val : Matrix (Fin 3) (Fin 3) ℂ)) := by
    ext X
    constructor
    · rintro ⟨t, rfl⟩
      exact ⟨energyLift m (Circle.exp (-t)), (tensor_time_exponential m 1 t).symm⟩
    · rintro ⟨U, rfl⟩
      obtain ⟨z, rfl⟩ := energy_lift_surjective m U
      refine ⟨-Complex.arg (z : ℂ), ?_⟩
      simpa only [neg_neg, matrixCopies, Circle.exp_arg, energyLift] using
        tensor_time_exponential m 1 (-Complex.arg (z : ℂ))
  refine ⟨?_, ?_⟩
  · rw [htime]
    exact (isCompact_range (continuous_subtype_val.comp continuous_subtype_val :
      Continuous (fun U : energyGroup m => (U.val : Matrix (Fin 3) (Fin 3) ℂ)))).isClosed.closure_eq.symm
  · intro n t
    rw [tensor_time_exponential m 1 t]
    exact (tensor_time_exponential m n t).symm


private theorem matrix_copies_conjugate (U X : Matrix (Fin 3) (Fin 3) ℂ) : ∀ n,
    matrixCopies (U * X * Uᴴ) n =
      matrixCopies U n * matrixCopies X n * (matrixCopies U n)ᴴ
  | 0 => by simp [matrixCopies]
  | 1 => rfl
  | n+2 => by
    change (U * X * Uᴴ) ⊗ₖ matrixCopies (U * X * Uᴴ) (n+1) =
      (U ⊗ₖ matrixCopies U (n+1)) * (X ⊗ₖ matrixCopies X (n+1)) *
        (U ⊗ₖ matrixCopies U (n+1))ᴴ
    rw [matrix_copies_conjugate U X (n+1), Matrix.conjTranspose_kronecker,
      Matrix.mul_kronecker_mul, Matrix.mul_kronecker_mul]

private theorem orbit_tensor_entry (m n : ℕ) (z : Circle)
    (X : Matrix (Fin 3) (Fin 3) ℂ) (I J : CopyIndex (Fin 3) n) :
    matrixCopies ((energyRepresentation m z).val * X * (energyRepresentation m z).valᴴ) n I J =
      (z : ℂ)^(totalEnergy m n I - totalEnergy m n J) * matrixCopies X n I J := by
  rw [matrix_copies_conjugate, tensor_representation,
    Matrix.diagonal_conjTranspose, Matrix.mul_diagonal, Matrix.diagonal_mul]
  have hs : star ((z : ℂ)^totalEnergy m n J) = ((z : ℂ)^totalEnergy m n J)⁻¹ := by
    rw [← Circle.coe_zpow, ← Circle.coe_inv, Circle.coe_inv_eq_conj]
    rfl
  change (z : ℂ)^totalEnergy m n I * matrixCopies X n I J *
    star ((z : ℂ)^totalEnergy m n J) = _
  rw [hs, zpow_sub₀ (Circle.coe_ne_zero z), div_eq_mul_inv]
  ring

private theorem energy_lift_mul (m : ℕ) (z w : Circle) :
    energyLift m (z*w) = energyLift m z * energyLift m w := by
  apply Subtype.ext
  exact (energyRepresentation m).map_mul z w

/-- The actual Haar average of tensor copies of a single conjugated input.
One and the same matrix-group element occurs in every tensor factor. The
finite-dimensional integral is written in its matrix coordinates. -/
def sharedMoment (m n : ℕ) (r : DensityState (Fin 3)) :
    Matrix (CopyIndex (Fin 3) n) (CopyIndex (Fin 3) n) ℂ := fun I J =>
  ∫ U : energyGroup m,
    matrixCopies ((U.val : Matrix (Fin 3) (Fin 3) ℂ) * stateMatrix r *
      (U.val : Matrix (Fin 3) (Fin 3) ℂ)ᴴ) n I J ∂energyHaar m

private theorem shared_moment_entry (m n : ℕ) (r : DensityState (Fin 3))
    (I J : CopyIndex (Fin 3) n) :
    sharedMoment m n r I J = if totalEnergy m n I = totalEnergy m n J then
      stateMatrix (copies r n) I J else 0 := by
  classical
  by_cases h : totalEnergy m n I = totalEnergy m n J
  · rw [if_pos h]
    have hf : (fun U : energyGroup m =>
        matrixCopies ((U.val : Matrix (Fin 3) (Fin 3) ℂ) * stateMatrix r *
          (U.val : Matrix (Fin 3) (Fin 3) ℂ)ᴴ) n I J) =
        fun _ => stateMatrix (copies r n) I J := by
      funext U
      obtain ⟨z, rfl⟩ := energy_lift_surjective m U
      change matrixCopies ((energyRepresentation m z).val * stateMatrix r *
        (energyRepresentation m z).valᴴ) n I J = _
      rw [orbit_tensor_entry, h, sub_self, zpow_zero, one_mul, copies_matrix]
    simp [sharedMoment, hf]
  · rw [if_neg h]
    let k := totalEnergy m n I - totalEnergy m n J
    have hk : k ≠ 0 := sub_ne_zero.mpr h
    let v : Circle := Circle.exp (Real.pi / (k : ℝ))
    have hv : (v : ℂ)^k = -1 := by
      rw [show v = Circle.exp (Real.pi / (k : ℝ)) from rfl,
        ← Circle.coe_zpow, ← Circle.exp_intCast_mul]
      have hk' : (k : ℝ) ≠ 0 := by exact_mod_cast hk
      rw [mul_div_cancel₀ _ hk', Circle.coe_exp, Complex.exp_pi_mul_I]
    change (∫ U : energyGroup m, _ ∂energyHaar m) = 0
    apply MeasureTheory.integral_eq_zero_of_mul_left_eq_neg
      (g := energyLift m v)
    intro U
    obtain ⟨z, rfl⟩ := energy_lift_surjective m U
    rw [← energy_lift_mul]
    change matrixCopies ((energyRepresentation m (v*z)).val * stateMatrix r *
      (energyRepresentation m (v*z)).valᴴ) n I J =
        -matrixCopies ((energyRepresentation m z).val * stateMatrix r *
          (energyRepresentation m z).valᴴ) n I J
    rw [orbit_tensor_entry, orbit_tensor_entry, Circle.coe_mul, mul_zpow]
    change ((v : ℂ)^k * (z : ℂ)^k) * _ = -((z : ℂ)^k * _)
    rw [hv]
    ring

private theorem native_pinch_entry (m n : ℕ) (r : DensityState (Fin 3))
    (I J : CopyIndex (Fin 3) n) : pinchedCopies m n r I J =
      if totalEnergy m n I = totalEnergy m n J then stateMatrix (copies r n) I J else 0 := by
  have he := tensor_monomial_bridge m n r I J
  simpa only [he.2.1, sub_eq_zero, ← he.2.2.1] using he.2.2.2.1

/-- Haar averaging over the actual compact matrix group is exactly complete
TOTAL-energy pinching, including all degenerate-block cross entries. -/
theorem shared_haar_pinching (m n : ℕ) (r : DensityState (Fin 3)) :
    sharedMoment m n r = pinchedCopies m n r := by
  ext I J
  rw [shared_moment_entry, native_pinch_entry]

/-- The actual compact matrix orbit of a native density state. -/
def SameEnergyOrbit (m : ℕ) (r s : DensityState (Fin 3)) : Prop :=
  ∃ U : energyGroup m, stateMatrix s =
    (U.val : Matrix (Fin 3) (Fin 3) ℂ) * stateMatrix r *
      (U.val : Matrix (Fin 3) (Fin 3) ℂ)ᴴ

private theorem orbit_pinching_equal (m n : ℕ) (r s : DensityState (Fin 3))
    (h : SameEnergyOrbit m r s) : pinchedCopies m n r = pinchedCopies m n s := by
  obtain ⟨U, hU⟩ := h
  obtain ⟨z, rfl⟩ := energy_lift_surjective m U
  ext I J
  simp only [native_pinch_entry]
  split_ifs with he
  · rw [← copies_matrix, ← copies_matrix, hU]
    change matrixCopies (stateMatrix r) n I J =
      matrixCopies ((energyRepresentation m z).val * stateMatrix r *
        (energyRepresentation m z).valᴴ) n I J
    rw [orbit_tensor_entry, he, sub_self, zpow_zero, one_mul]
  · rfl

/-- The sparse positive states lie on distinct actual compact orbits. Their
actual shared Haar moments agree below the claimed order and differ at it. -/
theorem sparse_compact_separation (m : ℕ) (hm : 2 ≤ m) :
    ¬ SameEnergyOrbit m rho (sigma m) ∧
    (∀ n : ℕ, n < 2*m-1 → sharedMoment m n rho = sharedMoment m n (sigma m)) ∧
    sharedMoment m (copyOrder m) rho ≠ sharedMoment m (copyOrder m) (sigma m) := by
  have hd := (sparse_joint_effect m hm).2.2.2.2.2.2.2.2.1
  refine ⟨fun h => hd (orbit_pinching_equal m (copyOrder m) rho (sigma m) h), ?_, ?_⟩
  · intro n hn
    rw [shared_haar_pinching, shared_haar_pinching]
    exact sparse_low_pinching m n hm hn
  · simpa only [shared_haar_pinching] using hd


private theorem pinched_marginal (m k : ℕ) (r : DensityState (Fin 3))
    (I J : CopyIndex (Fin 3) (k+1)) :
    (∑ i : Fin 3, pinchedCopies m (k+2) r (i,I) (i,J)) =
      pinchedCopies m (k+1) r I J := by
  simp only [native_pinch_entry, totalEnergy, add_right_inj]
  change (∑ i : Fin 3, if totalEnergy m (k+1) I = totalEnergy m (k+1) J then
      stateMatrix r i i * stateMatrix (copies r (k+1)) I J else 0) = _
  by_cases he : totalEnergy m (k+1) I = totalEnergy m (k+1) J
  · simp only [he, ite_true, ← Finset.sum_mul]
    have ht : ∑ i, stateMatrix r i i = 1 := r.2.2
    rw [ht, one_mul]
  · simp [he]

private theorem pinching_lower (m : ℕ) (r s : DensityState (Fin 3)) :
    ∀ (N n : ℕ), n ≤ N → pinchedCopies m N r = pinchedCopies m N s →
      pinchedCopies m n r = pinchedCopies m n s := by
  intro N
  induction N with
  | zero =>
    intro n hn he
    have hn0 : n = 0 := by omega
    subst n
    exact he
  | succ N ih =>
    intro n hn he
    by_cases hn0 : n = 0
    · subst n
      ext I J
      simp [native_pinch_entry, totalEnergy, copies, stateMatrix]
    · by_cases htop : n = N+1
      · subst n
        exact he
      · have hN : 1 ≤ N := by omega
        have hp : pinchedCopies m N r = pinchedCopies m N s := by
          obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : N ≠ 0)
          ext I J
          rw [← pinched_marginal, ← pinched_marginal]
          exact Finset.sum_congr rfl (fun i _ =>
            congrArg (fun X => X (i,I) (i,J)) he)
        exact ih n (by omega) hp

/-- One actual shared Haar moment determines every labelled zero-weight
monomial of no greater degree, for all native density states. -/
theorem moment_determines_monomials (m N : ℕ) (r s : DensityState (Fin 3))
    (he : sharedMoment m N r = sharedMoment m N s) (alpha : Exponent)
    (hd : degree alpha ≤ N) (hw : weight m alpha = 0) :
    monomial (stateMatrix r) alpha = monomial (stateMatrix s) alpha := by
  rw [shared_haar_pinching, shared_haar_pinching] at he
  have hl := pinching_lower m r s N (degree alpha) hd he
  obtain ⟨I,J,ht⟩ := exponent_tensor_bridge m alpha
  have hc := congrArg (fun X => X I J) hl
  rw [(ht.2.2 r).2, (ht.2.2 s).2] at hc
  simpa only [hw, ite_true] using hc

open private degree_zero degree_add weight_add monomial_add
  from D5.S3.Quantum.Fibers.SharedEnergyCopyThreshold

private theorem all_monomials (m : ℕ) (hm : 2 ≤ m) (r s : DensityState (Fin 3))
    (he : sharedMoment m (2*m-1) r = sharedMoment m (2*m-1) s) :
    ∀ alpha : Exponent, weight m alpha = 0 →
      monomial (stateMatrix r) alpha = monomial (stateMatrix s) alpha := by
  classical
  suffices hall : ∀ n (alpha : Exponent), degree alpha = n → weight m alpha = 0 →
      monomial (stateMatrix r) alpha = monomial (stateMatrix s) alpha by
    exact fun a ha => hall (degree a) a rfl ha
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro a ha hwa
    by_cases ha0 : a = 0
    · simp [ha0, monomial]
    by_cases hind : Indecomposable m a
    · exact moment_determines_monomials m (2*m-1) r s he a
        (SharedEnergyGapBound.indecomposable_degree_bound m hm a hind) hwa
    have hproper : ∃ b : Exponent, b ≤ a ∧ weight m b = 0 ∧ b ≠ 0 ∧ b ≠ a := by
      have hn : ¬ ∀ b : Exponent, b ≤ a → weight m b = 0 → b = 0 ∨ b = a :=
        fun h => hind ⟨ha0, hwa, h⟩
      push Not at hn
      exact hn
    obtain ⟨b, hba, hwb, hb0, hbn⟩ := hproper
    let c : Exponent := a-b
    have hsum : b+c = a := add_tsub_cancel_of_le hba
    have hc0 : c ≠ 0 := by
      intro hc
      apply hbn
      simpa [hc] using hsum
    have hdg : degree b + degree c = n := by rw [← degree_add, hsum, ha]
    have hbd : degree b < n := by
      have := (degree_zero c).not.mpr hc0
      omega
    have hcd : degree c < n := by
      have := (degree_zero b).not.mpr hb0
      omega
    have hwc : weight m c = 0 := by
      have heq := congrArg (weight m) hsum
      rw [weight_add, hwb, hwa] at heq
      simpa using heq
    rw [← hsum, monomial_add, monomial_add, ih (degree b) hbd b rfl hwb, ih (degree c) hcd c rfl hwc]

private theorem two_coordinate_relation (m : ℕ) (X Y : Matrix (Fin 3) (Fin 3) ℂ)
    (h : ∀ a : Exponent, weight m a = 0 → monomial X a = monomial Y a)
    (i j k l : Fin 3) (p q : ℕ)
    (hw : (p : ℤ)*(energy m i-energy m j) +
      (q : ℤ)*(energy m k-energy m l) = 0) :
    X i j ^ p * X k l ^ q = Y i j ^ p * Y k l ^ q := by
  let a : Exponent := fun u v =>
    (if u=i ∧ v=j then p else 0) + (if u=k ∧ v=l then q else 0)
  have ha : weight m a = 0 := by
    simpa [a, weight, Nat.cast_add, add_mul, Finset.sum_add_distrib,
      ite_and] using hw
  have value (Z : Matrix (Fin 3) (Fin 3) ℂ) :
      monomial Z a = Z i j ^ p * Z k l ^ q := by
    have single (i j : Fin 3) (p : ℕ) :
        (∏ u, ∏ v, Z u v ^ (if u=i ∧ v=j then p else 0)) = Z i j ^ p := by
      have entry (u v : Fin 3) : Z u v ^ (if u=i ∧ v=j then p else 0) =
          if u=i ∧ v=j then Z u v ^ p else 1 := by split_ifs <;> simp
      simp_rw [entry, ite_and]
      simp
    simp only [monomial, a, pow_add]
    simp_rw [Finset.prod_mul_distrib]
    rw [single, single]
  exact (value X).symm.trans ((h a ha).trans (value Y))

private theorem equal_phase (x y : ℂ) (hx : x ≠ 0)
    (he : x * star x = y * star y) : ∃ u : Circle, y = (u : ℂ)*x := by
  have hn : ‖x‖ = ‖y‖ := by
    have he' := congrArg Complex.re he
    simp only [Complex.star_def, Complex.mul_conj, Complex.ofReal_re,
      Complex.normSq_eq_norm_sq] at he'
    nlinarith [norm_nonneg x, norm_nonneg y]
  have hnorm : ‖y/x‖ = 1 := by rw [norm_div, ← hn, div_self (norm_ne_zero_iff.mpr hx)]
  refine ⟨⟨y/x, ?_⟩, ?_⟩
  · exact mem_sphere_zero_iff_norm.mpr hnorm
  · exact (div_mul_cancel₀ y hx).symm

private theorem circle_root (u : Circle) (n : ℕ) (hn : n ≠ 0) :
    ∃ z : Circle, z ^ n = u := by
  refine ⟨Circle.exp (Complex.arg (u : ℂ) / n), ?_⟩
  rw [← Circle.exp_natCast_mul]
  have he : (n : ℝ) * (Complex.arg (u : ℂ) / n) = Complex.arg (u : ℂ) := by
    field_simp
  rw [he, Circle.exp_arg]

private theorem phase_relation (m : ℕ) (X Y : Matrix (Fin 3) (Fin 3) ℂ)
    (hX : X.IsHermitian) (hY : Y.IsHermitian)
    (h : ∀ a : Exponent, weight m a = 0 → monomial X a = monomial Y a)
    (i j k l : Fin 3) (p q : ℕ) (hx : X i j ≠ 0) (hy : X k l ≠ 0)
    (u v : Circle) (hu : Y i j = (u : ℂ)*X i j) (hv : Y k l = (v : ℂ)*X k l)
    (hw : (p : ℤ)*(energy m i-energy m j) = (q : ℤ)*(energy m k-energy m l)) :
    u ^ p = v ^ q := by
  have hr : Y l k = star (v : ℂ)*X l k := by
    rw [← hY.apply l k, hv, star_mul, hX.apply l k]
    ring
  have hx' : X l k ≠ 0 := by
    intro he
    apply hy
    rw [← hX.apply k l, he, star_zero]
  have he := two_coordinate_relation m X Y h i j l k p q (by linear_combination hw)
  have hprod : X i j ^ p * X l k ^ q ≠ 0 := mul_ne_zero (pow_ne_zero _ hx) (pow_ne_zero _ hx')
  have hc : (u : ℂ)^p * star (v : ℂ)^q = 1 := by
    apply mul_right_cancel₀ hprod
    calc
      ((u : ℂ)^p * star (v : ℂ)^q) * (X i j ^ p * X l k ^ q) =
          Y i j ^ p * Y l k ^ q := by rw [hu, hr, mul_pow, mul_pow]; ring
      _ = 1 * (X i j ^ p * X l k ^ q) := by rw [← he, one_mul]
  have hvunit : star (v : ℂ)^q * (v : ℂ)^q = 1 := by
    rw [← mul_pow]
    have hv1 : star (v : ℂ)*(v : ℂ) = 1 := by
      rw [mul_comm, Complex.star_def, Complex.mul_conj, Circle.normSq_coe, Complex.ofReal_one]
    rw [hv1, one_pow]
  apply Circle.coe_injective
  simp only [Circle.coe_pow]
  calc
    (u : ℂ)^p = ((u : ℂ)^p * star (v : ℂ)^q) * (v : ℂ)^q := by
      rw [mul_assoc, hvunit, mul_one]
    _ = (v : ℂ)^q := by rw [hc, one_mul]

private theorem recover_phase (m : ℕ) (hm : 2 ≤ m)
    (X Y : Matrix (Fin 3) (Fin 3) ℂ) (hX : X.IsHermitian) (hY : Y.IsHermitian)
    (h : ∀ a : Exponent, weight m a = 0 → monomial X a = monomial Y a) :
    ∃ z : Circle, Y 1 0 = (z : ℂ)*X 1 0 ∧
      Y 2 1 = (z : ℂ)^(m-1)*X 2 1 ∧ Y 2 0 = (z : ℂ)^m*X 2 0 := by
  have phases (i j : Fin 3) : ∃ u : Circle, Y i j = (u : ℂ)*X i j := by
    have he : X i j * star (X i j) = Y i j * star (Y i j) := by
      simpa only [pow_one, hX.apply j i, hY.apply j i] using
        two_coordinate_relation m X Y h i j j i 1 1 (by simp)
    by_cases hx : X i j = 0
    · have hy : Y i j = 0 := by
        rw [hx, zero_mul] at he
        rcases mul_eq_zero.mp he.symm with he | he
        · exact he
        · exact star_eq_zero.mp he
      exact ⟨1, by simp [hx, hy]⟩
    · exact equal_phase _ _ hx he
  obtain ⟨a, ha⟩ := phases 1 0
  obtain ⟨b, hb⟩ := phases 2 1
  obtain ⟨c, hc⟩ := phases 2 0
  have hm1 : 1 ≤ m := by omega
  have hmcast : ((m-1 : ℕ) : ℤ) = (m : ℤ)-1 := by omega
  by_cases hx : X 1 0 = 0
  · by_cases hy : X 2 1 = 0
    · obtain ⟨z, hz⟩ := circle_root c m (by omega)
      refine ⟨z, ?_, ?_, ?_⟩
      · simp [ha, hx]
      · simp [hb, hy]
      · rw [hc, ← hz, Circle.coe_pow]
    · by_cases ht : X 2 0 = 0
      · obtain ⟨z, hz⟩ := circle_root b (m-1) (by omega)
        refine ⟨z, ?_, ?_, ?_⟩
        · simp [ha, hx]
        · rw [hb, ← hz, Circle.coe_pow]
        · simp [hc, ht]
      · have hbc : b^m = c^(m-1) :=
          phase_relation m X Y hX hY h 2 1 2 0 m (m-1) hy ht b c hb hc (by
            simp [energy, hmcast]; ring)
        have hbpow : b^m = b^(m-1)*b := by
          conv_lhs => rw [← Nat.sub_add_cancel hm1]
          rw [pow_succ]
        have hz : (c/b)^(m-1) = b := by
          rw [div_pow, ← hbc, hbpow, mul_div_cancel_left]
        have hz' : (c/b)^m = c := by
          conv_lhs => rw [← Nat.sub_add_cancel hm1]
          rw [pow_succ, hz]
          rw [div_eq_mul_inv, ← mul_assoc, mul_comm b c, mul_inv_cancel_right]
        refine ⟨c/b, ?_, ?_, ?_⟩
        · simp [ha, hx]
        · apply hb.trans
          simpa only [Circle.coe_pow] using
            (congrArg (fun w : Circle => (w : ℂ)*X 2 1) hz.symm)
        · apply hc.trans
          simpa only [Circle.coe_pow] using
            (congrArg (fun w : Circle => (w : ℂ)*X 2 0) hz'.symm)
  · refine ⟨a, ha, ?_, ?_⟩
    · by_cases hy : X 2 1 = 0
      · simp [hb, hy]
      · have hab : a^(m-1) = b := by
          simpa only [pow_one] using
            phase_relation m X Y hX hY h 1 0 2 1 (m-1) 1 hx hy a b ha hb (by
              simp [energy, hmcast])
        rw [hb, ← hab, Circle.coe_pow]
    · by_cases ht : X 2 0 = 0
      · simp [hc, ht]
      · have hac : a^m = c := by
          simpa only [pow_one] using
            phase_relation m X Y hX hY h 1 0 2 0 m 1 hx ht a c ha hc (by simp [energy])
        rw [hc, ← hac, Circle.coe_pow]

private theorem orbit_of_monomials (m : ℕ) (hm : 2 ≤ m) (r s : DensityState (Fin 3))
    (h : ∀ a : Exponent, weight m a = 0 →
      monomial (stateMatrix r) a = monomial (stateMatrix s) a) : SameEnergyOrbit m r s := by
  let X := stateMatrix r
  let Y := stateMatrix s
  have hX : X.IsHermitian :=
    (D5.S3.Quantum.Information.PartialTraceMutualInformation.density_posSemidef r).isHermitian
  have hY : Y.IsHermitian :=
    (D5.S3.Quantum.Information.PartialTraceMutualInformation.density_posSemidef s).isHermitian
  obtain ⟨z, h10, h21, h20⟩ := recover_phase m hm X Y hX hY h
  let U := (energyRepresentation m z).val
  let C := U * X * Uᴴ
  have hC : C.IsHermitian := Matrix.isHermitian_mul_mul_conjTranspose U hX
  have diag (i : Fin 3) : Y i i = C i i := by
    have hd := two_coordinate_relation m X Y h i i 0 0 1 0 (by simp)
    have hd' : Y i i = X i i := by simpa only [pow_one, pow_zero, mul_one] using hd.symm
    have hc := orbit_tensor_entry m 1 z X i i
    simp only [matrixCopies, totalEnergy, sub_self, zpow_zero, one_mul] at hc
    exact hd'.trans hc.symm
  have entry (i j : Fin 3) : C i j = (z : ℂ)^(energy m i-energy m j)*X i j :=
    orbit_tensor_entry m 1 z X i j
  have hc10 : Y 1 0 = C 1 0 := by simpa [entry, energy] using h10
  have hcast : ((m-1 : ℕ) : ℤ) = (m : ℤ)-1 := by omega
  have hc21 : Y 2 1 = C 2 1 := by simpa [entry, energy, ← hcast] using h21
  have hc20 : Y 2 0 = C 2 0 := by simpa [entry, energy] using h20
  refine ⟨⟨energyRepresentation m z, ⟨z, rfl⟩⟩, ?_⟩
  change Y = C
  ext i j
  fin_cases i <;> fin_cases j
  · exact diag 0
  · exact (hY.apply 0 1).symm.trans ((congrArg star hc10).trans (hC.apply 0 1))
  · exact (hY.apply 0 2).symm.trans ((congrArg star hc20).trans (hC.apply 0 2))
  · exact hc10
  · exact diag 1
  · exact (hY.apply 1 2).symm.trans ((congrArg star hc21).trans (hC.apply 1 2))
  · exact hc20
  · exact hc21
  · exact diag 2

/-- On the entire native density-state domain, the exact least positive order
that separates actual compact energy orbits is twice m minus one. -/
theorem least_uniform_order (m : ℕ) (hm : 2 ≤ m) :
    IsLeast {N : ℕ | 0 < N ∧ ∀ r s : DensityState (Fin 3),
      sharedMoment m N r = sharedMoment m N s ↔ SameEnergyOrbit m r s} (2*m-1) := by
  constructor
  · refine ⟨by omega, fun r s => ⟨?_, ?_⟩⟩
    · intro he
      exact orbit_of_monomials m hm r s (all_monomials m hm r s he)
    · intro ho
      rw [shared_haar_pinching, shared_haar_pinching]
      exact orbit_pinching_equal m (2*m-1) r s ho
  · intro N hN
    by_contra! hsmall
    have hs := sparse_compact_separation m hm
    exact hs.1 ((hN.2 rho (sigma m)).mp (hs.2.1 N hsmall))

#print axioms least_uniform_order
#print axioms moment_determines_monomials
#print axioms energy_group_realization
#print axioms shared_haar_pinching
#print axioms sparse_compact_separation
end D5.S3.Quantum.Fibers.SharedEnergyCompactAction
