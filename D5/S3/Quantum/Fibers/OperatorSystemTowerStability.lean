import D5.S3.Quantum.Fibers.CenteredEffectTowerStability
import Mathlib.Analysis.CStarAlgebra.CompletelyPositiveMap

/- Library-search audit trail (2026-08-22):
   * Repository search found the related frozen theorem
     `CenteredEffectTowerStability.heisenberg_tower_once_stable_permanently`, but its
     carrier is the centered trace-zero Hermitian subspace and its atom also concludes
     residual equality. It cannot replace the present full Hermitian operator-system object.
   * Cross-family searches found no existing definition of a full Hermitian operator-system
     tower generated by a unital completely positive matrix map.
   * Pinned Mathlib supplies `CStarMatrix`, `selfAdjoint`, and
     `CompletelyPositiveMap`; these are used directly for the source's finite matrix carrier,
     Hermitian part, and Heisenberg map. `Function.iterate_fixed` is the exact permanent
     fixed-point result and is applied directly.
   * Loogle found exactly `Function.iterate_fixed`. LeanSearch ranked
     `Function.IsFixedPt.iterate` and `Function.iterate_fixed` first for fixed-point
     permanence; it found no operator-system-specific wrapper. -/

noncomputable section

open scoped CStarAlgebra ComplexOrder

namespace D5.S3.Quantum.Fibers.OperatorSystemTowerStability

variable {d : Type*} [Fintype d] [DecidableEq d]

/-- The full finite matrix algebra representing operators on the source Hilbert space. -/
abbrev MatrixAlgebra (d : Type*) := CStarMatrix d d ℂ

/-- Restriction of the completely positive Heisenberg map to the full real Hermitian carrier. -/
def heisenbergOnHermitian
    (heisenberg : MatrixAlgebra d →CP MatrixAlgebra d) :
    selfAdjoint (MatrixAlgebra d) →ₗ[ℝ] selfAdjoint (MatrixAlgebra d) where
  toFun A := ⟨heisenberg A.1,
    letI : ContinuousFunctionalCalculus ℝ (MatrixAlgebra d) IsSelfAdjoint :=
      Matrix.IsHermitian.instContinuousFunctionalCalculus
    letI : SelfAdjointDecompose (MatrixAlgebra d) :=
      { exists_nonneg_sub_nonneg := by
          intro a ha
          refine ⟨a⁺, a⁻, ?_, ?_, ?_⟩
          · exact CFC.posPart_nonneg a
          · exact CFC.negPart_nonneg a
          · exact (CFC.posPart_sub_negPart a ha).symm }
    IsSelfAdjoint.map' (F := MatrixAlgebra d →CP MatrixAlgebra d)
      (E := MatrixAlgebra d) (R := MatrixAlgebra d) A.2 heisenberg⟩
  map_add' A B := by
    apply Subtype.ext
    exact map_add heisenberg A.1 B.1
  map_smul' r A := by
    apply Subtype.ext
    change heisenberg ((r : ℂ) • A.1) = (r : ℂ) • heisenberg A.1
    exact map_smul heisenberg (r : ℂ) A.1

/-- An operator system on the full Hermitian matrix carrier: a real subspace containing one. -/
structure MatrixOperatorSystem (d : Type*) [Fintype d] [DecidableEq d] where
  carrier : Submodule ℝ (selfAdjoint (MatrixAlgebra d))
  one_mem : (⟨1, IsSelfAdjoint.one (MatrixAlgebra d)⟩ :
    selfAdjoint (MatrixAlgebra d)) ∈ carrier

/-- Add the Heisenberg image of the current operator system to the visible system. -/
def predictionStep
    (heisenberg : MatrixAlgebra d →CP MatrixAlgebra d)
    (system : MatrixOperatorSystem d) : MatrixOperatorSystem d where
  carrier := system.carrier ⊔ system.carrier.map (heisenbergOnHermitian heisenberg)
  one_mem := (le_sup_left : system.carrier ≤
    system.carrier ⊔ system.carrier.map (heisenbergOnHermitian heisenberg)) system.one_mem

/-- The finite Heisenberg prediction tower constructed by iterating the source closure step. -/
def predictionTower
    (heisenberg : MatrixAlgebra d →CP MatrixAlgebra d)
    (initial : MatrixOperatorSystem d) (n : ℕ) : MatrixOperatorSystem d :=
  (predictionStep heisenberg)^[n] initial

/-- For a unital completely positive Heisenberg map, equality of one pair of consecutive
operator-system stages forces equality with every later stage. -/
theorem operator_system_tower_once_stable_permanently
    (heisenberg : MatrixAlgebra d →CP MatrixAlgebra d)
    (_heisenberg_unital : heisenberg 1 = 1)
    (initial : MatrixOperatorSystem d) (n : ℕ)
    (hstep : predictionTower heisenberg initial n =
      predictionTower heisenberg initial (n + 1)) :
    ∀ r : ℕ, predictionTower heisenberg initial (n + r) =
      predictionTower heisenberg initial n := by
  have hfixed : predictionStep heisenberg (predictionTower heisenberg initial n) =
      predictionTower heisenberg initial n := by
    calc
      predictionStep heisenberg (predictionTower heisenberg initial n) =
          predictionTower heisenberg initial (n + 1) := by
            change predictionStep heisenberg
                ((predictionStep heisenberg)^[n] initial) =
              (predictionStep heisenberg)^[n + 1] initial
            simpa only [Nat.succ_eq_add_one] using
              (Function.iterate_succ_apply' (predictionStep heisenberg) n initial).symm
      _ = predictionTower heisenberg initial n := hstep.symm
  intro r
  rw [predictionTower, Nat.add_comm n r, Function.iterate_add_apply]
  exact Function.iterate_fixed hfixed r

/- The identity Heisenberg channel on a full two-by-two matrix algebra and the top operator
system witness that the public premises are jointly satisfiable. -/
example :
    ∃ (heisenberg : MatrixAlgebra Bool →CP MatrixAlgebra Bool)
      (initial : MatrixOperatorSystem Bool),
      heisenberg 1 = 1 ∧
        predictionTower heisenberg initial 0 =
          predictionTower heisenberg initial 1 := by
  let heisenberg : MatrixAlgebra Bool →CP MatrixAlgebra Bool :=
    ((StarAlgHom.id ℂ (MatrixAlgebra Bool) :
      MatrixAlgebra Bool →⋆ₐ[ℂ] MatrixAlgebra Bool) :
      MatrixAlgebra Bool →CP MatrixAlgebra Bool)
  let initial : MatrixOperatorSystem Bool :=
    { carrier := ⊤
      one_mem := Submodule.mem_top }
  refine ⟨heisenberg, initial, ?_, ?_⟩
  · rfl
  · simp [predictionTower, predictionStep, initial]

#print axioms operator_system_tower_once_stable_permanently

end D5.S3.Quantum.Fibers.OperatorSystemTowerStability
