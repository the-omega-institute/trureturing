import D5.S3.Quantum.Divergence.QuantumRelativeEntropyDefectComposition
import D5.S3.Quantum.Fibers.OperatorSystemTowerStability

/- Library-search audit trail (2026-08-23):
   * Exact family primitives `DensityState`, `QuantumChannel`, and `mapState` construct the
     positive trace-one state carrier and trace-preserving completely positive evolution.
   * Exact family primitives `MatrixOperatorSystem` and `heisenbergOnHermitian` construct the
     source's full real Hermitian operator system and Heisenberg action; they are imported.
   * Repository searches found no theorem equating all future trace readouts with annihilation of
     the infinite Heisenberg-generated operator system, and no existing infinite-system primitive.
   * Pinned Mathlib's exact `Submodule.span_induction`, `Matrix.trace_add`, `Matrix.trace_smul`,
     and `Matrix.trace_sub` extend the generator identity to the full real linear closure. -/

noncomputable section

open scoped CStarAlgebra ComplexOrder MatrixOrder

namespace D5.S3.Quantum.Fibers.FutureStatisticsEquivalence

open D5.S3.Quantum.Divergence.QuantumRelativeEntropyDefectComposition
open D5.S3.Quantum.Fibers.OperatorSystemTowerStability

set_option autoImplicit false
set_option relaxedAutoImplicit false

variable {d : Type*} [Fintype d] [DecidableEq d]

/-- Trace expectations of a density state on every effect in an operator system. -/
def operatorSystemReadout (system : MatrixOperatorSystem d) (rho : DensityState d) :
    system.carrier -> ℂ :=
  fun effect => Matrix.trace (rho.1 * effect.1.1)

/-- Schrödinger evolution of a density state through exactly `k` channel uses. -/
def evolvedState (channel : QuantumChannel d d) (k : Nat) (rho : DensityState d) :
    DensityState d :=
  ((QuantumChannel.mapState channel)^[k]) rho

/-- The full operator system generated by every finite Heisenberg iterate of every initially
visible Hermitian effect. -/
def infinitePredictionSystem
    (heisenberg : MatrixAlgebra d →CP MatrixAlgebra d)
    (initial : MatrixOperatorSystem d) :
    Submodule ℝ (selfAdjoint (MatrixAlgebra d)) :=
  Submodule.span ℝ
    {effect | exists k, exists initialEffect : selfAdjoint (MatrixAlgebra d),
      initialEffect ∈ initial.carrier /\
        effect = ((heisenbergOnHermitian heisenberg)^[k]) initialEffect}

omit [DecidableEq d] in
private theorem cstar_trace_zero :
    Matrix.trace (0 : MatrixAlgebra d) = 0 := by
  simp [Matrix.trace, Matrix.diag]

omit [DecidableEq d] in
private theorem cstar_trace_add (first second : MatrixAlgebra d) :
    Matrix.trace (first + second) = Matrix.trace first + Matrix.trace second := by
  simp [Matrix.trace, Matrix.diag, Finset.sum_add_distrib]

omit [DecidableEq d] in
private theorem cstar_trace_sub (first second : MatrixAlgebra d) :
    Matrix.trace (first - second) = Matrix.trace first - Matrix.trace second := by
  simp [Matrix.trace, Matrix.diag, Finset.sum_sub_distrib]

omit [DecidableEq d] in
private theorem cstar_trace_smul (scalar : ℂ) (matrix : MatrixAlgebra d) :
    Matrix.trace (scalar • matrix) = scalar • Matrix.trace matrix := by
  simp [Matrix.trace, Matrix.diag, Finset.mul_sum]

omit [DecidableEq d] in
private theorem cstar_trace_real_smul (scalar : ℝ) (matrix : MatrixAlgebra d) :
    Matrix.trace (scalar • matrix) = scalar • Matrix.trace matrix := by
  simp [Matrix.trace, Matrix.diag, Finset.mul_sum]

private theorem evolvedState_succ (channel : QuantumChannel d d) (k : Nat)
    (rho : DensityState d) :
    evolvedState channel (k + 1) rho =
      QuantumChannel.mapState channel (evolvedState channel k rho) := by
  simp only [evolvedState, Function.iterate_succ_apply']

private theorem iterated_trace_duality
    (channel : QuantumChannel d d)
    (heisenberg : MatrixAlgebra d →CP MatrixAlgebra d)
    (hduality : forall state effect : MatrixAlgebra d,
      Matrix.trace (channel.toCompletelyPositiveMap state * effect) =
        Matrix.trace (state * heisenberg effect))
    (k : Nat) (rho : DensityState d)
    (effect : selfAdjoint (MatrixAlgebra d)) :
    Matrix.trace ((evolvedState channel k rho).1 * effect.1) =
      Matrix.trace
        (rho.1 * (((heisenbergOnHermitian heisenberg)^[k]) effect).1) := by
  induction k generalizing effect with
  | zero => rfl
  | succ k ih =>
      calc
        Matrix.trace ((evolvedState channel (k + 1) rho).1 * effect.1) =
            Matrix.trace
              ((QuantumChannel.mapState channel (evolvedState channel k rho)).1 * effect.1) := by
          rw [evolvedState_succ]
        _ = Matrix.trace
              (channel.toCompletelyPositiveMap (evolvedState channel k rho).1 * effect.1) := rfl
        _ = Matrix.trace ((evolvedState channel k rho).1 * heisenberg effect.1) :=
          hduality _ _
        _ = Matrix.trace
              (rho.1 * (((heisenbergOnHermitian heisenberg)^[k])
                (heisenbergOnHermitian heisenberg effect)).1) :=
          ih (heisenbergOnHermitian heisenberg effect)
        _ = Matrix.trace
              (rho.1 * (((heisenbergOnHermitian heisenberg)^[k + 1]) effect).1) := by
          rw [Function.iterate_succ_apply]

/-- Two density states have identical initial-operator-system readouts after every channel iterate
if and only if their difference has zero trace pairing with every element of the complete
Heisenberg-generated operator system. -/
theorem future_statistics_iff_annihilates_infinite_system
    (channel : QuantumChannel d d)
    (heisenberg : MatrixAlgebra d →CP MatrixAlgebra d)
    (_heisenbergUnital : heisenberg 1 = 1)
    (hduality : forall state effect : MatrixAlgebra d,
      Matrix.trace (channel.toCompletelyPositiveMap state * effect) =
        Matrix.trace (state * heisenberg effect))
    (initial : MatrixOperatorSystem d) (rho sigma : DensityState d) :
    (forall k,
      operatorSystemReadout initial (evolvedState channel k rho) =
        operatorSystemReadout initial (evolvedState channel k sigma)) <->
      forall effect, effect ∈ infinitePredictionSystem heisenberg initial ->
        Matrix.trace ((rho.1 - sigma.1) * effect.1) = 0 := by
  constructor
  · intro hfuture effect heffect
    unfold infinitePredictionSystem at heffect
    induction heffect using Submodule.span_induction with
    | mem effect hgenerator =>
        rcases hgenerator with ⟨k, initialEffect, hInitialEffect, rfl⟩
        have hreadout := congrFun (hfuture k) ⟨initialEffect, hInitialEffect⟩
        change Matrix.trace ((evolvedState channel k rho).1 * initialEffect.1) =
          Matrix.trace ((evolvedState channel k sigma).1 * initialEffect.1) at hreadout
        rw [iterated_trace_duality channel heisenberg hduality,
          iterated_trace_duality channel heisenberg hduality] at hreadout
        rw [sub_mul, cstar_trace_sub]
        exact sub_eq_zero.mpr hreadout
    | zero =>
        change Matrix.trace ((rho.1 - sigma.1) * (0 : MatrixAlgebra d)) = 0
        rw [mul_zero, cstar_trace_zero]
    | add first second _ _ hfirst hsecond =>
        change Matrix.trace
          ((rho.1 - sigma.1) * (first.1 + second.1)) = 0
        rw [mul_add, cstar_trace_add, hfirst, hsecond, add_zero]
    | smul scalar effect _ heffect =>
        rw [selfAdjoint.val_smul, CStarMatrix.mul_smul,
          cstar_trace_real_smul, heffect, smul_zero]
  · intro hannihilates k
    funext initialEffect
    have hmember :
        ((heisenbergOnHermitian heisenberg)^[k]) initialEffect.1 ∈
          infinitePredictionSystem heisenberg initial := by
      unfold infinitePredictionSystem
      apply Submodule.subset_span
      exact ⟨k, initialEffect.1, initialEffect.2, rfl⟩
    have hzero := hannihilates _ hmember
    have hequal :
        Matrix.trace
            (rho.1 * (((heisenbergOnHermitian heisenberg)^[k]) initialEffect.1).1) =
          Matrix.trace
            (sigma.1 * (((heisenbergOnHermitian heisenberg)^[k]) initialEffect.1).1) := by
      have hsub :
          Matrix.trace
              (rho.1 * (((heisenbergOnHermitian heisenberg)^[k]) initialEffect.1).1) -
            Matrix.trace
              (sigma.1 * (((heisenbergOnHermitian heisenberg)^[k]) initialEffect.1).1) = 0 := by
        rw [sub_mul, cstar_trace_sub] at hzero
        exact hzero
      exact sub_eq_zero.mp hsub
    change Matrix.trace ((evolvedState channel k rho).1 * initialEffect.1.1) =
      Matrix.trace ((evolvedState channel k sigma).1 * initialEffect.1.1)
    exact (iterated_trace_duality channel heisenberg hduality k rho initialEffect.1).trans
      (hequal.trans
        (iterated_trace_duality channel heisenberg hduality k sigma initialEffect.1).symm)

/- The identity channel, identity Heisenberg dual, top operator system, and scalar density state
witness that the public carrier and hypotheses are jointly inhabited. -/
example :
    exists (channel : QuantumChannel (Fin 1) (Fin 1))
      (heisenberg : MatrixAlgebra (Fin 1) →CP MatrixAlgebra (Fin 1))
      (initial : MatrixOperatorSystem (Fin 1))
      (rho sigma : DensityState (Fin 1)),
      heisenberg 1 = 1 /\
        (forall state effect : MatrixAlgebra (Fin 1),
          Matrix.trace (channel.toCompletelyPositiveMap state * effect) =
            Matrix.trace (state * heisenberg effect)) /\
        operatorSystemReadout initial rho = operatorSystemReadout initial sigma := by
  let heisenberg : MatrixAlgebra (Fin 1) →CP MatrixAlgebra (Fin 1) :=
    ((StarAlgHom.id ℂ (MatrixAlgebra (Fin 1)) :
      MatrixAlgebra (Fin 1) →⋆ₐ[ℂ] MatrixAlgebra (Fin 1)) :
      MatrixAlgebra (Fin 1) →CP MatrixAlgebra (Fin 1))
  let channel : QuantumChannel (Fin 1) (Fin 1) :=
    { toCompletelyPositiveMap := heisenberg
      trace_preserving := by
        intro state
        rfl }
  let initial : MatrixOperatorSystem (Fin 1) :=
    { carrier := ⊤
      one_mem := Submodule.mem_top }
  let rho : DensityState (Fin 1) :=
    ⟨CStarMatrix.ofMatrix (1 : Matrix (Fin 1) (Fin 1) ℂ),
      by
        change (0 : MatrixAlgebra (Fin 1)) ≤ 1
        simpa only [star_one, one_mul] using
          star_mul_self_nonneg (1 : MatrixAlgebra (Fin 1)),
      by
        change Matrix.trace (1 : Matrix (Fin 1) (Fin 1) ℂ) = 1
        simp⟩
  refine ⟨channel, heisenberg, initial, rho, rho, rfl, ?_, rfl⟩
  intro state effect
  rfl

#print axioms future_statistics_iff_annihilates_infinite_system

end D5.S3.Quantum.Fibers.FutureStatisticsEquivalence
