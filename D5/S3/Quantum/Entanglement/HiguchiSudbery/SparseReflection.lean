private noncomputable def prime_evalKey {R : Type*} [CommRing R] (x : ℕ → R) (k : ℕ) : R :=
  if k = 0 then 0 else k.factorization.prod (fun p n => x p ^ n)
private noncomputable def prime_evalTerm {R : Type*} [CommRing R] (x : ℕ → R) (t : (ℕ × ℤ)) : R := (t.2:R)*prime_evalKey x t.1
private noncomputable def prime_eval {R : Type*} [CommRing R] (x : ℕ → R) (p : (List (ℕ × ℤ))) : R := (p.map (prime_evalTerm x)).sum
private def prime_insertHead (t : (ℕ × ℤ)) : (List (ℕ × ℤ)) → (List (ℕ × ℤ))
  | [] => if t.2 == 0 then [] else [t]
