def ref_mergeFuel {α : Type*} (le : α → α → Bool) : ℕ → List α → List α → List α
  | 0, p, q => p++q
  | n+1, [], q => q
  | n+1, p, [] => p
  | n+1, x::xs, y::ys => if le x y then x::ref_mergeFuel le n xs (y::ys)
      else y::ref_mergeFuel le n (x::xs) ys
lemma ref_mergeFuel_perm /- proof_shape: content; escape_witness: SparseReflection.ref_mergeFuel_perm (public-conclusion form); consumer: SparseReflection.ref_sortFuel_perm -/ {α : Type*} (le : α → α → Bool) (n : ℕ) (p q : List α) :
    (ref_mergeFuel le n p q).Perm (p++q) := by
  induction n generalizing p q with
  | zero => exact List.Perm.refl _
  | succ n ih =>
    cases p with
    | nil => simp [ref_mergeFuel]
    | cons x xs =>
      cases q with
      | nil => simp [ref_mergeFuel]
      | cons y ys =>
        simp only [ref_mergeFuel]
        split
        · exact (ih xs (y::ys)).cons x
        · exact ((ih (x::xs) ys).cons y).trans
            ((List.Perm.swap x y _).trans (List.perm_middle.symm.cons x))
private def ref_sortFuel {α : Type*} (le : α → α → Bool) : ℕ → List α → List α
  | 0, p => p
  | n+1, p => if p.length ≤ 1 then p else
      ref_mergeFuel le p.length (ref_sortFuel le n (p.take (p.length/2)))
        (ref_sortFuel le n (p.drop (p.length/2)))
private lemma ref_sortFuel_perm /- proof_shape: content; escape_witness: SparseReflection.ref_mergeFuel_perm; consumer: SparseReflection.ref_eval_termMul -/ {α : Type*} (le : α → α → Bool) (n : ℕ) (p : List α) :
    (ref_sortFuel le n p).Perm p := by
  induction n generalizing p with
  | zero => exact List.Perm.refl p
  | succ n ih =>
    simp only [ref_sortFuel]
    split
    · exact List.Perm.refl p
    · exact (ref_mergeFuel_perm le p.length _ _).trans
        ((ih _).append (ih _) |>.trans (by rw [List.take_append_drop]))
open scoped BigOperators
private noncomputable def ref_evalTerm {R : Type*} [CommRing R] (x : ℕ → R) (t : (List ℕ × ℤ)) : R :=
  (t.2 : R) * (t.1.map x).prod
private noncomputable def ref_eval {R : Type*} [CommRing R] (x : ℕ → R) (p : (List (List ℕ × ℤ))) : R :=
  (p.map (ref_evalTerm x)).sum
private def ref_scale (c : ℤ) (p : (List (List ℕ × ℤ))) : (List (List ℕ × ℤ)) := p.map (fun t => (t.1,c*t.2))
private def ref_termMul (t u : (List ℕ × ℤ)) : (List ℕ × ℤ) := (ref_sortFuel (fun a b : ℕ => a ≤ b) 3 (t.1++u.1), t.2*u.2)
private def ref_mul (p q : (List (List ℕ × ℤ))) : (List (List ℕ × ℤ)) := p.flatMap (fun t => q.map (ref_termMul t))
private def ref_swap (p : (List (List ℕ × ℤ))) : (List (List ℕ × ℤ)) := p.map (fun t =>
  (ref_sortFuel (fun a b : ℕ => a ≤ b) 3 (t.1.map (fun i => if i < 16 then i+16 else i-16)), t.2))
private lemma ref_eval_cons /- proof_shape: bind-only; consumer: SparseReflection.ref_eval_scale -/ {R : Type*} [CommRing R] (x : ℕ → R) (t : (List ℕ × ℤ)) (p : (List (List ℕ × ℤ))) :
    ref_eval x (t::p) = ref_evalTerm x t + ref_eval x p := by simp [ref_eval]
private lemma ref_eval_add /- proof_shape: bind-only; consumer: SparseReflection.ref_eval_mul -/ {R : Type*} [CommRing R] (x : ℕ → R) (p q : (List (List ℕ × ℤ))) :
    ref_eval x (List.append p q) = ref_eval x p + ref_eval x q := by simp [List.append, ref_eval]
private lemma ref_eval_scale /- proof_shape: bind-only; consumer: PrimeHierarchyCertificate.prime_eval_lhs -/ {R : Type*} [CommRing R] (x : ℕ → R) (c : ℤ) (p : (List (List ℕ × ℤ))) :
    ref_eval x (ref_scale c p) = c * ref_eval x p := by
  induction p with
  | nil => simp [ref_scale, ref_eval]
  | cons t ts ih =>
    change ref_eval x ((t.1,c*t.2)::ref_scale c ts) = _
    rw [ref_eval_cons, ih, ref_eval_cons]
    simp [ref_evalTerm, Int.cast_mul]
    ring
private lemma ref_eval_termMul /- proof_shape: content; escape_witness: SparseReflection.ref_sortFuel_perm; consumer: SparseReflection.ref_eval_mul -/ {R : Type*} [CommRing R] (x : ℕ → R) (t u : (List ℕ × ℤ)) :
    ref_evalTerm x (ref_termMul t u) = ref_evalTerm x t * ref_evalTerm x u := by
  have hp : ((ref_sortFuel (fun a b : ℕ => a ≤ b) 3 (t.1++u.1)).map x).prod = ((t.1++u.1).map x).prod :=
    ((ref_sortFuel_perm _ 3 (t.1++u.1)).map x).prod_eq
  simp only [ref_evalTerm, ref_termMul, hp, Int.cast_mul, List.map_append, List.prod_append]
  ring
private lemma ref_eval_mul /- proof_shape: content; escape_witness: SparseReflection.ref_sortFuel_perm; consumer: PrimeHierarchyCertificate.prime_eval_lhs -/ {R : Type*} [CommRing R] (x : ℕ → R) (p q : (List (List ℕ × ℤ))) :
    ref_eval x (ref_mul p q) = ref_eval x p * ref_eval x q := by
  have row (t : (List ℕ × ℤ)) : ref_eval x (q.map (ref_termMul t)) = ref_evalTerm x t * ref_eval x q := by
    induction q with
    | nil => simp [ref_eval]
    | cons u us ih => simp [ref_eval_cons, ref_eval_termMul, ih, mul_add]
  induction p with
  | nil => simp [ref_mul, ref_eval]
  | cons t ts ih =>
    change ref_eval x (List.append (q.map (ref_termMul t)) (ref_mul ts q)) = _
    rw [ref_eval_add, row, ih, ref_eval_cons]
    ring
private def ref_swapIndex (i : ℕ) : ℕ := if i < 16 then i+16 else i-16
private def ref_vars (z : Fin 16 → ℂ) (i : ℕ) : ℂ :=
  if h : i%32 < 16 then z ⟨i%32,h⟩ else star (z ⟨i%32-16, by omega⟩)
private lemma ref_vars_swap /- proof_shape: bind-only; consumer: SparseReflection.ref_eval_swap_vars -/ (z : Fin 16 → ℂ) (i : ℕ) :
    ref_vars z (ref_swapIndex i) = star (ref_vars z i) := by
  by_cases hi : i < 16
  · have h0 : i%32 = i := Nat.mod_eq_of_lt (by omega)
    have h1 : (i+16)%32 = i+16 := Nat.mod_eq_of_lt (by omega)
    simp [ref_swapIndex, hi, ref_vars, h0, h1]
  · have h0 : (i-16)%32 < 16 ↔ ¬ i%32 < 16 := by omega
    have h1 : (i-16)%32 = i%32-16 ∨ (i-16)%32-16 = i%32 := by omega
    by_cases hm : i%32 < 16
    · have hm' : ¬ (i-16)%32 < 16 := by omega
      have he : (i-16)%32-16 = i%32 := by omega
      simp [ref_swapIndex, hi, ref_vars, hm, hm', he]
    · have hm' : (i-16)%32 < 16 := by omega
      have he : (i-16)%32 = i%32-16 := by omega
      have he' : i%32-16 < 16 := by omega
      simp [ref_swapIndex, hi, ref_vars, hm, hm', he, he']
private lemma ref_eval_swap /- proof_shape: content; escape_witness: SparseReflection.ref_sortFuel_perm; consumer: SparseReflection.ref_eval_swap_vars -/ (x : ℕ → ℂ) (hx : ∀ i, x (ref_swapIndex i) = star (x i)) (p : (List (List ℕ × ℤ))) :
    ref_eval x (ref_swap p) = star (ref_eval x p) := by
  have ht (t : (List ℕ × ℤ)) :
      ref_evalTerm x (ref_sortFuel (fun a b : ℕ => a ≤ b) 3 (t.1.map ref_swapIndex),t.2) =
        star (ref_evalTerm x t) := by
    have hp := ((ref_sortFuel_perm (fun a b : ℕ => a ≤ b) 3 (t.1.map ref_swapIndex)).map x).prod_eq
    dsimp [ref_evalTerm]
    rw [hp]
    simp only [List.map_map, Function.comp_def, hx]
    rw [map_mul, map_intCast, map_list_prod]
    simp only [List.map_map, Function.comp_def]
    rfl
  induction p with
  | nil => simp [ref_swap, ref_eval]
  | cons t ts ih =>
    change ref_evalTerm x (ref_sortFuel (fun a b : ℕ => a ≤ b) 3 (t.1.map ref_swapIndex),t.2) +
      ref_eval x (ref_swap ts) = star (ref_evalTerm x t + ref_eval x ts)
    rw [ht, ih, star_add]
private lemma ref_eval_swap_vars /- proof_shape: content; escape_witness: SparseReflection.ref_sortFuel_perm; consumer: ReflectionEvaluation.ref_eval_square_nonneg -/ (z : Fin 16 → ℂ) (p : (List (List ℕ × ℤ))) :
    ref_eval (ref_vars z) (ref_swap p) = star (ref_eval (ref_vars z) p) :=
  ref_eval_swap _ (ref_vars_swap z) p
