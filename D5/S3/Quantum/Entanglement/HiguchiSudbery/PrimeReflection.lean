private lemma prime_eval_encode_vars /- proof_shape: bind-only; consumer: PrimeHierarchyCertificate.prime_eval_lhs -/ (z : Fin 16 → ℂ) (p : (List (List ℕ × ℤ))) :
    prime_eval (prime_primeVars z) (prime_encode p) = ref_eval (ref_vars z) p := by
