private lemma prime_evalKey_one /- proof_shape: bind-only; consumer: PrimeReflection.prime_evalKey_prod -/ {R : Type*} [CommRing R] (x : ℕ → R) : prime_evalKey x 1 = 1 := by simp [prime_evalKey]
private lemma prime_evalKey_mul /- proof_shape: bind-only; consumer: PrimeReflection.prime_eval_mul -/ {R : Type*} [CommRing R] (x : ℕ → R) (k l : ℕ) :
    prime_evalKey x (k*l) = prime_evalKey x k * prime_evalKey x l := by
  by_cases hk : k = 0
  · simp [hk, prime_evalKey]
  by_cases hl : l = 0
  · simp [hl, prime_evalKey]
  simp only [prime_evalKey, hk, hl, mul_ne_zero hk hl, ↓reduceIte, Nat.factorization_mul hk hl]
  rw [Finsupp.prod_add_index] <;> simp [pow_add]
private lemma prime_evalKey_prime /- proof_shape: bind-only; consumer: PrimeReflection.prime_evalKey_primeTable -/ {R : Type*} [CommRing R] (x : ℕ → R) (p : ℕ) (hp : p.Prime) : prime_evalKey x p = x p := by
  simp [prime_evalKey, hp.ne_zero, hp.factorization]
private lemma prime_eval_cons /- proof_shape: bind-only; consumer: PrimeReflection.prime_eval_insertHead -/ {R : Type*} [CommRing R] (x : ℕ → R) (t : (ℕ × ℤ)) (p : (List (ℕ × ℤ))) : prime_eval x (t::p) = prime_evalTerm x t + prime_eval x p := by simp [prime_eval]
private lemma prime_eval_perm /- proof_shape: bind-only; consumer: PrimeHierarchyCertificate.prime_eval_normalize -/ {R : Type*} [CommRing R] (x : ℕ → R) {p q : (List (ℕ × ℤ))} (h : p.Perm q) : prime_eval x p = prime_eval x q := (h.map (prime_evalTerm x)).sum_eq
private lemma prime_eval_insertHead /- proof_shape: bind-only; consumer: PrimeReflection.prime_eval_squeeze -/ {R : Type*} [CommRing R] (x : ℕ → R) (t : (ℕ × ℤ)) (p : (List (ℕ × ℤ))) : prime_eval x (prime_insertHead t p) = prime_evalTerm x t + prime_eval x p := by
  rcases t with ⟨k,c⟩
  cases p with
  | nil => by_cases hc : c = 0 <;> simp [prime_insertHead, hc, prime_eval, prime_evalTerm]
  | cons u us =>
    rcases u with ⟨l,d⟩
    by_cases hc : c = 0
    · simp [prime_insertHead, hc, prime_eval_cons, prime_evalTerm]
    by_cases hk : k = l
    · subst l
      by_cases hd : c+d = 0
      · have he : (c:R)+(d:R)=0 := by rw [← Int.cast_add, hd, Int.cast_zero]
        simp [prime_insertHead, hc, hd, prime_eval_cons, prime_evalTerm]
        linear_combination -(prime_evalKey x k)*he
      · simp [prime_insertHead, hc, hd, prime_eval_cons, prime_evalTerm, Int.cast_add]
        ring
    · simp [prime_insertHead, hc, hk, prime_eval_cons]
private lemma prime_eval_squeeze /- proof_shape: bind-only; consumer: PrimeHierarchyCertificate.prime_eval_normalize -/ {R : Type*} [CommRing R] (x : ℕ → R) (p : (List (ℕ × ℤ))) : prime_eval x (prime_squeeze p) = prime_eval x p := by
  induction p with
  | nil => rfl
  | cons t ts ih =>
    change prime_eval x (prime_insertHead t (prime_squeeze ts)) = _
    rw [prime_eval_insertHead, ih, prime_eval_cons]
private lemma prime_eval_add /- proof_shape: bind-only; consumer: PrimeReflection.prime_eval_nadd -/ {R : Type*} [CommRing R] (x : ℕ → R) (p q : (List (ℕ × ℤ))) : prime_eval x (List.append p q) = prime_eval x p + prime_eval x q := by simp [List.append, prime_eval]
private lemma prime_eval_nadd /- proof_shape: content; escape_witness: SparseReflection.ref_mergeFuel_perm; consumer: PrimeHierarchyCertificate.prime_eval_lhs -/ {R : Type*} [CommRing R] (x : ℕ → R) (p q : (List (ℕ × ℤ))) : prime_eval x (prime_nadd p q) = prime_eval x p + prime_eval x q := by
  rw [prime_nadd, prime_eval_squeeze, prime_eval_perm x (ref_mergeFuel_perm _ _ p q)]
  exact prime_eval_add x p q
private lemma prime_eval_scale /- proof_shape: bind-only; consumer: PrimeHierarchyCertificate.prime_eval_lhs -/ {R : Type*} [CommRing R] (x : ℕ → R) (c : ℤ) (p : (List (ℕ × ℤ))) : prime_eval x (prime_scale c p) = c * prime_eval x p := by
  induction p with
  | nil => simp [prime_scale, prime_eval]
  | cons t ts ih =>
    change prime_eval x ((t.1,c*t.2)::prime_scale c ts) = _
    rw [prime_eval_cons, ih, prime_eval_cons]
    simp [prime_evalTerm, Int.cast_mul]; ring
private lemma prime_eval_mul /- proof_shape: bind-only; consumer: PrimeHierarchyCertificate.prime_eval_lhs -/ {R : Type*} [CommRing R] (x : ℕ → R) (p q : (List (ℕ × ℤ))) : prime_eval x (prime_mul p q) = prime_eval x p * prime_eval x q := by
  have row (t : (ℕ × ℤ)) : prime_eval x (q.map (fun u => (t.1*u.1,t.2*u.2))) = prime_evalTerm x t * prime_eval x q := by
    induction q with
    | nil => simp [prime_eval]
    | cons u us ih => simp [prime_eval_cons, prime_evalTerm, prime_evalKey_mul, Int.cast_mul, ih, mul_add]; ring
  induction p with
  | nil => simp [prime_mul, prime_eval]
  | cons t ts ih =>
    change prime_eval x (List.append (q.map (fun u => (t.1*u.1,t.2*u.2))) (prime_mul ts q)) = _
    rw [prime_eval_add, row, ih, prime_eval_cons]; ring
private lemma prime_evalKey_prod /- proof_shape: bind-only; consumer: PrimeReflection.prime_eval_encode -/ {R : Type*} [CommRing R] (x : ℕ → R) (k : List ℕ) :
    prime_evalKey x (k.map prime_primeTable).prod = (k.map (fun i => prime_evalKey x (prime_primeTable i))).prod := by
  induction k with
  | nil => exact prime_evalKey_one x
  | cons i is ih => simp only [List.map_cons, List.prod_cons, prime_evalKey_mul, ih]
private lemma prime_eval_encode /- proof_shape: bind-only; consumer: PrimeReflection.prime_eval_encode_vars -/ {R : Type*} [CommRing R] (x : ℕ → R) (p : (List (List ℕ × ℤ))) :
    prime_eval x (prime_encode p) = ref_eval (fun i => prime_evalKey x (prime_primeTable i)) p := by
  have ht (t : (List ℕ × ℤ)) :
      prime_evalTerm x ((t.1.map prime_primeTable).prod,t.2) =
      ref_evalTerm (fun i => prime_evalKey x (prime_primeTable i)) t := by
    simp [prime_evalTerm, ref_evalTerm, prime_evalKey_prod]
  induction p with
  | nil => rfl
  | cons t ts ih =>
    change prime_evalTerm x ((t.1.map prime_primeTable).prod,t.2) + prime_eval x (prime_encode ts) = _
    rw [ht, ih, ref_eval_cons]
