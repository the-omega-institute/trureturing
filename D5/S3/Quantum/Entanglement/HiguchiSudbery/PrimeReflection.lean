private lemma prime_evalKey_primeTable /- proof_shape: bind-only; consumer: PrimeReflection.prime_eval_encode_vars -/ (z : Fin 16 → ℂ) (i : ℕ) :
    prime_evalKey (prime_primeVars z) (prime_primeTable i) = ref_vars z i := by
