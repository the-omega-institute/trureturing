    (hrho : rho.PosSemidef) (htrace : rho.trace = 1)
    (happt : QutritPerturbationAttainment.APPT rho) :
    (rho*rho).trace.re ≤ (23 : ℝ)/(17)^2 := by
  obtain ⟨l, ho, hn, ht, h1, h2, hp⟩ :=
    QutritSpectralReduction.spectral_reduction 2 rho hrho htrace happt
  rw [hp]
  exact certificate_bound l ho (hn 14) ht h1 h2

