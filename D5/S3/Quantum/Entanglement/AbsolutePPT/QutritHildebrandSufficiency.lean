private noncomputable def orderIndex (x : Fin 3 → ℝ) : Fin 3 × Fin 3 → Fin 9 :=
  fun (i,j) =>
    if i=0 then (if j=0 then 8 else if j=1 then 7 else if x 0*x 2 ≤ x 1^2 then 5 else 6)
    else if i=1 then (if j=0 then 0 else if j=1 then if x 0*x 2 ≤ x 1^2 then 6 else 5 else 4)
    else (if j=0 then 1 else if j=1 then 2 else 3)

private def baseIndex : Fin 3 × Fin 3 → Fin 9 := fun (i,j) =>
    if i=0 then (if j=0 then 8 else if j=1 then 7 else 5)
    else if i=1 then (if j=0 then 0 else if j=1 then 6 else 4)
    else (if j=0 then 1 else if j=1 then 2 else 3)

private def otherIndex : Fin 3 × Fin 3 → Fin 9 := fun (i,j) =>
    if i=0 then (if j=0 then 8 else if j=1 then 7 else 6)
    else if i=1 then (if j=0 then 0 else if j=1 then 5 else 4)
    else (if j=0 then 1 else if j=1 then 2 else 3)

private noncomputable def orderEquiv (x : Fin 3 → ℝ) : (Fin 3 × Fin 3) ≃ Fin 9 :=
  Equiv.ofBijective (orderIndex x) (by
    by_cases h : x 0*x 2 ≤ x 1^2
    · have he : orderIndex x = baseIndex := by
        funext ⟨i,j⟩
        simp only [orderIndex, baseIndex, h, if_true]
      rw [he]
      exact (by decide +kernel : Function.Bijective baseIndex)
    · have he : orderIndex x = otherIndex := by
        funext ⟨i,j⟩
        simp only [orderIndex, otherIndex, h, if_false]
      rw [he]
      exact (by decide +kernel : Function.Bijective otherIndex))

private theorem product_weights_eq_ordered (x : Fin 3 → ℝ) :
    productWeights x = fun i => (schmidtWeights x (orderEquiv x i) : ℂ) := by
  funext ⟨i,j⟩
  by_cases h : x 0*x 2 ≤ x 1^2
  · fin_cases i <;> fin_cases j <;>
      norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, productWeights, schmidtWeights, orderEquiv, orderIndex, h,
        min_eq_right h, max_eq_left h, Complex.ofReal_pow, Complex.ofReal_mul, Fin.reduceEq, Fin.reduceFinMk, Fin.reduceLT] <;> (try dsimp) <;> (try simp) <;> ring
  · have h' : x 1^2 ≤ x 0*x 2 := le_of_not_ge h
    fin_cases i <;> fin_cases j <;>
      norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, productWeights, schmidtWeights, orderEquiv, orderIndex, h,
        min_eq_left h', max_eq_right h', Complex.ofReal_pow, Complex.ofReal_mul, Fin.reduceEq, Fin.reduceFinMk, Fin.reduceLT] <;> (try dsimp) <;> (try simp) <;> ring

private theorem outer_conjugate {I : Type} [Fintype I]
    (A : Matrix I I ℂ) (v : I → ℂ) :
    vecMulVec (A *ᵥ v) (star (A *ᵥ v)) = A * vecMulVec v (star v) * Aᴴ := by
  rw [Matrix.mul_vecMulVec, Matrix.vecMulVec_mul]
  simp [Matrix.vecMul_conjTranspose]

private theorem pure_pt_sorted_diagonalization (v : Fin 3 × Fin 3 → ℂ) :
    ∃ (x : Fin 3 → ℝ) (U : unitaryGroup (Fin 3 × Fin 3) ℂ),
      Antitone x ∧ (∀ i, 0 ≤ x i) ∧
      partialTranspose (vecMulVec v (star v)) =
        (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) *
          diagonal (fun i => (schmidtWeights x (orderEquiv x i) : ℂ)) *
            (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ := by
  obtain ⟨x,V,W,ho,hn,hv⟩ := vector_schmidt v
  let L : unitaryGroup (Fin 3 × Fin 3) ℂ :=
    ⟨Matrix.kronecker (V : Matrix (Fin 3) (Fin 3) ℂ) (W : Matrix (Fin 3) (Fin 3) ℂ),
      Matrix.kronecker_mem_unitary V.property W.property⟩
  let B : unitaryGroup (Fin 3 × Fin 3) ℂ := ⟨D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.bell, D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.bell_mem_unitaryGroup⟩
  refine ⟨x,L*B,ho,hn,?_⟩
  rw [hv, outer_conjugate, partial_transpose_local]
  have hs : ((W : Matrix (Fin 3) (Fin 3) ℂ).map star).map star =
      (W : Matrix (Fin 3) (Fin 3) ℂ) := by ext i j; simp
  rw [hs]
  rw [pure_partial_transpose_diagonalization, product_weights_eq_ordered]
  simp only [Submonoid.coe_mul, Matrix.conjTranspose_mul]
  change (L : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) *
    (D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.bell * _ * D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.bellᴴ) * (L : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ = _
  simp only [B, Matrix.mul_assoc]

end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.PureSpectrum
