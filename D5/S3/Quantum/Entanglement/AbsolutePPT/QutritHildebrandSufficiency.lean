namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.SchmidtBridge
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.HildebrandCore
open D5.S3.Quantum.Foundation.FiniteTraceDistance (exists_svd_sqrt_eigenvalues)
open D5.S3.Quantum.Dynamics.KickedIsingNegativityRefutation (partialTranspose)
private theorem sorted_svd (A : Matrix (Fin 3) (Fin 3) ℂ) :
    ∃ (x : Fin 3 → ℝ) (V W : unitaryGroup (Fin 3) ℂ),
      Antitone x ∧ (∀ i, 0 ≤ x i) ∧
      A = (V : Matrix (Fin 3) (Fin 3) ℂ) * diagonal (fun i => (x i : ℂ)) *
        (W : Matrix (Fin 3) (Fin 3) ℂ)ᴴ := by
  let H : (Aᴴ*A).IsHermitian := by
    simpa using Matrix.isHermitian_mul_conjTranspose_self A.conjTranspose
  obtain ⟨V,W,hA⟩ := exists_svd_sqrt_eigenvalues A
  have hc : Fintype.card (Fin 3) = 3 := by simp
  let f : Fin (Fintype.card (Fin 3)) ≃ Fin 3 := Fintype.equivOfCardEq (Fintype.card_fin _)
  let e : Equiv.Perm (Fin 3) := (finCongr hc.symm).trans f
  let P : unitaryGroup (Fin 3) ℂ := D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.permutationU e
  let x : Fin 3 → ℝ := fun i => Real.sqrt (H.eigenvalues₀ (Fin.cast hc.symm i))
  have he (i : Fin 3) : H.eigenvalues (e i) = H.eigenvalues₀ (Fin.cast hc.symm i) := by
    change H.eigenvalues₀ (f.symm (f (Fin.cast hc.symm i))) = H.eigenvalues₀ (Fin.cast hc.symm i)
    rw [Equiv.symm_apply_apply]
  have hd : diagonal (fun i => (x i : ℂ)) =
      (P : Matrix (Fin 3) (Fin 3) ℂ) *
        diagonal (fun i => (Real.sqrt (H.eigenvalues i) : ℂ)) *
          (P : Matrix (Fin 3) (Fin 3) ℂ)ᴴ := by
    change _ = e.permMatrix ℂ * _ * (e.permMatrix ℂ)ᴴ
    rw [Matrix.conjTranspose_permMatrix, PEquiv.toMatrix_toPEquiv_mul,
      PEquiv.mul_toMatrix_toPEquiv]
    change _ = (diagonal (fun i => (Real.sqrt (H.eigenvalues i) : ℂ))).submatrix e e
    rw [Matrix.submatrix_diagonal_equiv]
    congr 1
    funext i
    simp only [Function.comp_apply, he]
    rfl
  refine ⟨x,V * star P,W * star P,?_,fun i => Real.sqrt_nonneg _,?_⟩
  · intro i j hij
    exact Real.sqrt_le_sqrt (H.eigenvalues₀_antitone (show Fin.cast hc.symm i ≤ Fin.cast hc.symm j from hij))
  · have hp : (P : Matrix (Fin 3) (Fin 3) ℂ)ᴴ*(P : Matrix (Fin 3) (Fin 3) ℂ)=1 := by
      simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_star_mul_self P
    rw [hd]
    simp only [Submonoid.coe_mul, Unitary.coe_star, Matrix.star_eq_conjTranspose,
      Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose]
    calc
      A = (V : Matrix (Fin 3) (Fin 3) ℂ) * diagonal (fun i => (Real.sqrt (H.eigenvalues i) : ℂ)) *
        (W : Matrix (Fin 3) (Fin 3) ℂ)ᴴ := hA
      _ = _ := by
        simp only [Matrix.mul_assoc]
        simp only [← Matrix.mul_assoc, hp, one_mul, mul_one]
private theorem vector_schmidt (v : Fin 3 × Fin 3 → ℂ) :
    ∃ (x : Fin 3 → ℝ) (V W : unitaryGroup (Fin 3) ℂ),
      Antitone x ∧ (∀ i, 0 ≤ x i) ∧
      v = (Matrix.kronecker (V : Matrix (Fin 3) (Fin 3) ℂ)
        ((W : Matrix (Fin 3) (Fin 3) ℂ).map star)) *ᵥ schmidtVector x := by
  let A : Matrix (Fin 3) (Fin 3) ℂ := fun i j => v (i,j)
  obtain ⟨x,V,W,ho,hn,he⟩ := sorted_svd A
  refine ⟨x,V,W,ho,hn,?_⟩
  funext ⟨i,j⟩
  have h := congrFun (congrFun he i) j
  simpa [A, Matrix.mul_apply, Matrix.mulVec, dotProduct, Matrix.kronecker_apply,
    schmidtVector, Matrix.conjTranspose_apply, Matrix.diagonal,
    Fintype.sum_prod_type, Fin.sum_univ_three, Pi.star_apply, mul_comm, mul_left_comm,
    mul_assoc] using h
private theorem partial_transpose_local (M : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)
    (V W : Matrix (Fin 3) (Fin 3) ℂ) :
    partialTranspose ((Matrix.kronecker V W) * M * (Matrix.kronecker V W)ᴴ) =
      (Matrix.kronecker V (W.map star)) * partialTranspose M * (Matrix.kronecker V (W.map star))ᴴ := by
  ext ⟨i,j⟩ ⟨k,l⟩
  simp [partialTranspose, Matrix.mul_apply, Matrix.kronecker_apply,
    Matrix.conjTranspose_apply, Matrix.map_apply, Fintype.sum_prod_type,
    Fin.sum_univ_three, map_add, map_mul]
  ring
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.SchmidtBridge
