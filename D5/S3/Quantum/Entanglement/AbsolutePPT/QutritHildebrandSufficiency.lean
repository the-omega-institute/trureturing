set_option autoImplicit false
set_option Elab.async false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false
set_option maxHeartbeats 18000000
set_option maxRecDepth 16384
open Matrix
open scoped ComplexOrder
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.SpectralBridge
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritPerturbationAttainment (APPT)
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2 boundaryValues)
open D5.S3.Quantum.Dynamics.KickedIsingNegativityRefutation (partialTranspose)

theorem spectral_reduction_ordered (k : ℕ)
    (rho : Matrix (Fin 3 × Fin (3+k)) (Fin 3 × Fin (3+k)) ℂ)
    (hrho : rho.PosSemidef) (htrace : rho.trace = 1) (happt : APPT rho) :
    ∃ l : Fin (3*(3+k)) → ℝ, Antitone l ∧ (∀ i, 0 ≤ l i) ∧ (∑ i, l i = 1) ∧
      (K1 (boundaryValues k l)).PosSemidef ∧ (K2 (boundaryValues k l)).PosSemidef ∧
      (rho*rho).trace.re = ∑ i, (l i)^2 ∧
      l = (fun i : Fin (3*(3+k)) => hrho.isHermitian.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i)) := by
  run_tac
    let decl ← Lean.getConstInfo ``D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.spectral_reduction
    let args ← #[`k, `rho, `hrho, `htrace, `happt].mapM fun nm => Lean.Elab.Term.elabTerm (Lean.mkIdent nm) none
    let .thmInfo info := decl | throwError "not theorem"
    let orig := Lean.mkAppN info.value args
    let pf ← Lean.Meta.whnf orig
    let aa := pf.getAppArgs
    let witness := aa[aa.size-2]!
    let mut body := aa[aa.size-1]!
    let mut proofs : Array Lean.Expr := #[]
    for _ in [:5] do
      proofs := proofs.push (← Lean.Meta.mkAppM ``And.left #[body])
      body ← Lean.Meta.mkAppM ``And.right #[body]
    let eqpf ← Lean.Meta.mkEqRefl witness
    let mut combined ← Lean.Meta.mkAppM ``And.intro #[body, eqpf]
    for p in proofs.reverse do
      combined ← Lean.Meta.mkAppM ``And.intro #[p, combined]
    let goal ← Lean.Elab.Tactic.getMainGoal
    let target ← Lean.Meta.whnf (← goal.getType)
    let ta := target.getAppArgs
    let result := Lean.mkAppN (Lean.mkConst ``Exists.intro [.succ .zero]) #[ta[0]!, ta[1]!, witness, combined]
    goal.assign result
    Lean.Elab.Tactic.replaceMainGoal []


theorem spectrum_eq_ordered_range (k : ℕ)
    (rho : Matrix (Fin 3 × Fin (3+k)) (Fin 3 × Fin (3+k)) ℂ)
    (H : rho.IsHermitian) :
    spectrum ℂ rho = Complex.ofReal '' Set.range ((fun i : Fin (3*(3+k)) => H.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i))) := by
  rw [H.spectrum_eq_image_range]
  congr 1
  let e : Fin (3*(3+k)) ≃ (Fin 3 × Fin (3+k)) :=
    (finCongr (by simp [Fintype.card_prod])).trans
      (Fintype.equivOfCardEq (Fintype.card_fin _))
  have he (i : Fin (3*(3+k))) : H.eigenvalues (e i) = (fun i : Fin (3*(3+k)) => H.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i)) i := by
    simp [e, Matrix.IsHermitian.eigenvalues]
  ext x
  constructor
  · rintro ⟨i, rfl⟩
    exact ⟨e.symm i, (he (e.symm i)).symm.trans (by simp)⟩
  · rintro ⟨i, rfl⟩
    exact ⟨e i, he i⟩

end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.SpectralBridge
