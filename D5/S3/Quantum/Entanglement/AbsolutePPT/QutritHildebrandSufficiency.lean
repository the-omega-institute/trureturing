namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.OrderedDiagonalization
theorem sorted_diagonalization {I : Type} [Fintype I] [DecidableEq I] {n : ℕ}
    (hc : Fintype.card I = n) (A : Matrix I I ℂ) (H : A.IsHermitian) (e : I ≃ Fin n) :
    ∃ U : unitaryGroup I ℂ, A =
      (U : Matrix I I ℂ) * diagonal (fun i => ((fun i : Fin n => H.eigenvalues₀ (Fin.cast hc.symm i)) (e i) : ℂ)) *
        (U : Matrix I I ℂ)ᴴ := by
  let f : Fin (Fintype.card I) ≃ I := Fintype.equivOfCardEq (Fintype.card_fin _)
  let q : Equiv.Perm I := e.trans ((finCongr hc.symm).trans f)
  let P : unitaryGroup I ℂ := ⟨q.permMatrix ℂ, by
    rw [mem_unitaryGroup_iff, Matrix.star_eq_conjTranspose, Matrix.conjTranspose_permMatrix,
      ← Matrix.permMatrix_mul]
    simp⟩
  have hd : diagonal (fun i => ((fun i : Fin n => H.eigenvalues₀ (Fin.cast hc.symm i)) (e i) : ℂ)) =
      (P : Matrix I I ℂ) * diagonal (fun i => (H.eigenvalues i : ℂ)) *
        (P : Matrix I I ℂ)ᴴ := by
    change _ = q.permMatrix ℂ * _ * (q.permMatrix ℂ)ᴴ
    rw [Matrix.conjTranspose_permMatrix, PEquiv.toMatrix_toPEquiv_mul,
      PEquiv.mul_toMatrix_toPEquiv]
    change _ = (diagonal (fun i => (H.eigenvalues i : ℂ))).submatrix q q
    rw [Matrix.submatrix_diagonal_equiv]
    congr 1
    funext i
    simp [ q, f, Matrix.IsHermitian.eigenvalues]
  refine ⟨H.eigenvectorUnitary * star P, ?_⟩
  have hp : (P : Matrix I I ℂ)ᴴ*(P : Matrix I I ℂ)=1 := by
    simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_star_mul_self P
  rw [hd]
  simp only [Submonoid.coe_mul, Unitary.coe_star, Matrix.star_eq_conjTranspose,
    Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose]
  calc
    A = (H.eigenvectorUnitary : Matrix I I ℂ) * diagonal (fun i => (H.eigenvalues i : ℂ)) *
      (H.eigenvectorUnitary : Matrix I I ℂ)ᴴ := by
        simpa [Unitary.conjStarAlgAut_apply, Matrix.star_eq_conjTranspose, Function.comp_def]
          using H.spectral_theorem
    _ = _ := by
      simp only [Matrix.mul_assoc]
      simp only [← Matrix.mul_assoc, hp, one_mul]
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.OrderedDiagonalization
