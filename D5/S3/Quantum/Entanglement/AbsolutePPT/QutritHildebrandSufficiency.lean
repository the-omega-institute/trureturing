open D5.S3.Quantum.Dynamics.KickedIsingNegativityRefutation (partialTranspose)

private noncomputable def schmidtWeights (x : Fin 3 → ℝ) : Fin 9 → ℝ :=
  fun i => if i=0 then -x 0*x 1 else if i=1 then -x 0*x 2
    else if i=2 then -x 1*x 2 else if i=3 then x 2^2 else if i=4 then x 1*x 2
    else if i=5 then min (x 1^2) (x 0*x 2) else if i=6 then max (x 1^2) (x 0*x 2)
    else if i=7 then x 0*x 1 else x 0^2

private theorem schmidt_weights_monotone (x : Fin 3 → ℝ)
    (h01 : x 1 ≤ x 0) (h12 : x 2 ≤ x 1) (h2 : 0 ≤ x 2) :
    Monotone (schmidtWeights x) := by
  have h1 : 0 ≤ x 1 := h2.trans h12
  have h0 : 0 ≤ x 0 := h1.trans h01
  have h02 : x 2 ≤ x 0 := h12.trans h01
  apply Fin.monotone_iff_le_succ.mpr
  intro i
  fin_cases i
  · change -x 0*x 1 ≤ -x 0*x 2
    nlinarith
  · change -x 0*x 2 ≤ -x 1*x 2
    nlinarith
  · change -x 1*x 2 ≤ x 2^2
    nlinarith [mul_nonneg h1 h2]
  · change x 2^2 ≤ x 1*x 2
    nlinarith
  · change x 1*x 2 ≤ min (x 1^2) (x 0*x 2)
    exact le_min (by nlinarith) (by nlinarith)
  · change min (x 1^2) (x 0*x 2) ≤ max (x 1^2) (x 0*x 2)
    exact min_le_max
  · change max (x 1^2) (x 0*x 2) ≤ x 0*x 1
    exact max_le (by nlinarith) (by nlinarith)
  · change x 0*x 1 ≤ x 0^2
    nlinarith

private theorem weighted_schmidt_eq_K1 (l : Fin 9 → ℝ) (x : Fin 3 → ℝ)
    (h : x 0*x 2 ≤ x 1^2) :
    ∑ i, l i * schmidtWeights x i = (x ⬝ᵥ (K1 l *ᵥ x))/2 := by
  simp [schmidtWeights, min_eq_right h, max_eq_left h, K1, dotProduct, Matrix.mulVec,
    Fin.sum_univ_succ]
  ring

private theorem weighted_schmidt_eq_K2 (l : Fin 9 → ℝ) (x : Fin 3 → ℝ)
    (h : x 1^2 ≤ x 0*x 2) :
    ∑ i, l i * schmidtWeights x i = (x ⬝ᵥ (K2 l *ᵥ x))/2 := by
  simp [schmidtWeights, min_eq_left h, max_eq_right h, K2, dotProduct, Matrix.mulVec,
    Fin.sum_univ_succ]
  ring

private theorem weighted_schmidt_nonneg (l : Fin 9 → ℝ) (x : Fin 3 → ℝ)
    (h1 : (K1 l).PosSemidef) (h2 : (K2 l).PosSemidef) :
    0 ≤ ∑ i, l i * schmidtWeights x i := by
  rcases le_total (x 0*x 2) (x 1^2) with h|h
  · rw [weighted_schmidt_eq_K1 l x h]
    exact div_nonneg (by simpa using h1.dotProduct_mulVec_nonneg x) (by norm_num)
  · rw [weighted_schmidt_eq_K2 l x h]
    exact div_nonneg (by simpa using h2.dotProduct_mulVec_nonneg x) (by norm_num)

private theorem partial_transpose_trace_duality
    (M : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) (v : Fin 3 × Fin 3 → ℂ) :
    star v ⬝ᵥ (partialTranspose M *ᵥ v) =
      (M * partialTranspose (vecMulVec v (star v))).trace := by
  simp [partialTranspose, Matrix.trace, Matrix.mul_apply, Matrix.mulVec, dotProduct,
    Matrix.vecMulVec_apply, Fintype.sum_prod_type, Fin.sum_univ_three, Pi.star_apply]
  ring

private noncomputable def schmidtVector (x : Fin 3 → ℝ) : Fin 3 × Fin 3 → ℂ :=
  Function.uncurry (Matrix.diagonal (fun i => (x i : ℂ)))

private noncomputable def productWeights (x : Fin 3 → ℝ) : Fin 3 × Fin 3 → ℂ :=
  fun ij => if ij.1=ij.2 then (x ij.1 : ℂ)^2
    else if ij.1 < ij.2 then (x ij.1 : ℂ)*x ij.2 else -(x ij.1 : ℂ)*x ij.2

private theorem pure_partial_transpose_diagonalization (x : Fin 3 → ℝ) :
    partialTranspose (vecMulVec (schmidtVector x) (star (schmidtVector x))) =
      D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.bell * diagonal (productWeights x) * D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.bellᴴ := by
  have c_square : (Real.sqrt 2 : ℂ)⁻¹*(Real.sqrt 2 : ℂ)⁻¹ = 1/2 := by
    have h : (Real.sqrt 2 : ℂ) * (Real.sqrt 2 : ℂ)=2 := by
      norm_cast
      nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)]
    rw [← mul_inv, h]
    norm_num
  ext ⟨i,j⟩ ⟨k,l⟩
  fin_cases i <;> fin_cases j <;> fin_cases k <;> fin_cases l <;>
    simp [partialTranspose, Matrix.vecMulVec_apply, schmidtVector, D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction.bell, productWeights,
      Matrix.mul_apply, Matrix.conjTranspose_apply, Matrix.diagonal, Fintype.sum_prod_type,
      Fin.sum_univ_three, Complex.ofReal_pow]
  all_goals ring_nf
  all_goals try simp [pow_two, c_square]
  all_goals ring

end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.HildebrandCore
