theorem trace_diagonal_conjugate {I : Type} [Fintype I] [DecidableEq I] (w l : I → ℝ)
    (U : unitaryGroup I ℂ) :
    ((diagonal (fun i => (w i : ℂ))) *
      ((U : Matrix I I ℂ) * diagonal (fun i => (l i : ℂ)) *
       (U : Matrix I I ℂ)ᴴ)).trace.re =
      ∑ i, ∑ j, w i * RHLinalg.normSqMatrix (U : Matrix I I ℂ) i j * l j := by
  rw [Matrix.trace, Complex.re_sum]
  apply Finset.sum_congr rfl
  intro i hi
  simp only [Matrix.diag_apply, Matrix.diagonal_mul]
  rw [Matrix.mul_apply]
  simp only [Matrix.mul_diagonal, Matrix.conjTranspose_apply, mul_sum, Complex.re_sum]
  apply Finset.sum_congr rfl
  intro j hj
  change ((w i : ℂ) * ((U : Matrix I I ℂ) i j * (l j : ℂ) *
    star ((U : Matrix I I ℂ) i j))).re = _
  rw [show (w i : ℂ) * ((U : Matrix I I ℂ) i j * (l j : ℂ) *
      star ((U : Matrix I I ℂ) i j)) =
    (w i : ℂ) * (((U : Matrix I I ℂ) i j) *
      star ((U : Matrix I I ℂ) i j)) * (l j : ℂ) by ring]
  simp [RHLinalg.normSqMatrix, RCLike.mul_conj, mul_assoc, ← Complex.ofReal_pow]
theorem trace_lower_of_monovary_diagonalization {I : Type} [Fintype I] [DecidableEq I]
    (w l : I → ℝ) (h : Monovary (fun i => -w i) l) (U : unitaryGroup I ℂ) :
    ∑ i, w i * l i ≤
    ((diagonal (fun i => (w i : ℂ))) *
      ((U : Matrix I I ℂ) * diagonal (fun i => (l i : ℂ)) *
       (U : Matrix I I ℂ)ᴴ)).trace.re := by
  rw [trace_diagonal_conjugate]
  have hb := RHLinalg.bilinear_doublyStochastic_le_of_monovary h
    (RHLinalg.normSqMatrix_mem_doublyStochastic_of_unitary U.property)
  simp only [neg_mul, Finset.sum_neg_distrib] at hb
  exact neg_le_neg_iff.mp hb
private theorem trace_pair_lower_of_diagonalizations {I : Type} [Fintype I] [DecidableEq I]
    (w l : I → ℝ) (h : Monovary (fun i => -w i) l) (U V : unitaryGroup I ℂ) :
    ∑ i, w i * l i ≤
    (((U : Matrix I I ℂ) * diagonal (fun i => (l i : ℂ)) * (U : Matrix I I ℂ)ᴴ) *
      ((V : Matrix I I ℂ) * diagonal (fun i => (w i : ℂ)) * (V : Matrix I I ℂ)ᴴ)).trace.re := by
  have ht := trace_lower_of_monovary_diagonalization w l h (star V * U)
  have he :
    (((U : Matrix I I ℂ) * diagonal (fun i => (l i : ℂ)) * (U : Matrix I I ℂ)ᴴ) *
      ((V : Matrix I I ℂ) * diagonal (fun i => (w i : ℂ)) * (V : Matrix I I ℂ)ᴴ)).trace =
    ((diagonal (fun i => (w i : ℂ))) *
      ((star V * U : unitaryGroup I ℂ) : Matrix I I ℂ) *
        diagonal (fun i => (l i : ℂ)) *
          (((star V * U : unitaryGroup I ℂ) : Matrix I I ℂ))ᴴ).trace := by
    simp only [Submonoid.coe_mul, Unitary.coe_star, Matrix.star_eq_conjTranspose,
      Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose]
    rw [show ((U : Matrix I I ℂ) * diagonal (fun i => (l i : ℂ)) * (U : Matrix I I ℂ)ᴴ) *
      ((V : Matrix I I ℂ) * diagonal (fun i => (w i : ℂ)) * (V : Matrix I I ℂ)ᴴ) =
      (U : Matrix I I ℂ) * diagonal (fun i => (l i : ℂ)) * (U : Matrix I I ℂ)ᴴ *
        (V : Matrix I I ℂ) * diagonal (fun i => (w i : ℂ)) * (V : Matrix I I ℂ)ᴴ by
      simp only [Matrix.mul_assoc]]
    rw [Matrix.trace_mul_cycle]
    rw [Matrix.trace_mul_comm]
    simp only [Matrix.mul_assoc]
  rw [he]
  simpa only [Matrix.mul_assoc] using ht
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.TraceBridge
