private theorem quadratic_im_zero {J : Type} [Fintype J] (A : Matrix J J ℂ)
    (H : A.IsHermitian) (v : J → ℂ) : (star v ⬝ᵥ (A *ᵥ v)).im = 0 := by
  apply Complex.conj_eq_iff_im.mp
  change star (star v ⬝ᵥ (A *ᵥ v)) = _
  rw [← star_dotProduct, star_mulVec, ← dotProduct_mulVec, H.eq]
private theorem psd_of_re_quadratic_nonneg {J : Type} [Fintype J] (A : Matrix J J ℂ)
    (H : A.IsHermitian) (h : ∀ v : J → ℂ, 0 ≤ (star v ⬝ᵥ (A *ᵥ v)).re) :
    A.PosSemidef := by
  apply Matrix.PosSemidef.of_dotProduct_mulVec_nonneg H
  intro v
  exact Complex.nonneg_iff.mpr ⟨h v, (quadratic_im_zero A H v).symm⟩
theorem sorted_eigenvalues_antitone {J : Type} [Fintype J] [DecidableEq J] {n : ℕ}
    (hc : Fintype.card J = n) (A : Matrix J J ℂ) (H : A.IsHermitian) :
    Antitone ((fun i : Fin n => H.eigenvalues₀ (Fin.cast hc.symm i))) := by
  intro i j hij
  apply H.eigenvalues₀_antitone
  exact hij
theorem hildebrand_sufficiency (rho : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) (H : rho.IsHermitian)
    (h1 : (K1 ((fun i : Fin 9 => H.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i)))).PosSemidef)
    (h2 : (K2 ((fun i : Fin 9 => H.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i)))).PosSemidef) :
    APPT rho := by
  let hc : Fintype.card (Fin 3 × Fin 3) = 9 := by simp [Fintype.card_prod]
  let l := (fun i : Fin 9 => H.eigenvalues₀ (Fin.cast hc.symm i))
  have hl : Antitone l := sorted_eigenvalues_antitone hc rho H
  intro U
  have hpt : (partialTranspose
      ((U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) * rho *
        (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ)).IsHermitian := by
    apply Matrix.IsHermitian.ext
    intro ⟨i,j⟩ ⟨k,l⟩
    exact (Matrix.isHermitian_mul_mul_conjTranspose _ H).apply (i,l) (k,j)
  apply psd_of_re_quadratic_nonneg _ hpt
  intro v
  obtain ⟨x,V,ho,hn,hd⟩ := pure_pt_sorted_diagonalization v
  let e := orderEquiv x
  obtain ⟨T,ht⟩ := sorted_diagonalization hc rho H e
  have hw : Monotone (schmidtWeights x) :=
    schmidt_weights_monotone x (ho (by decide : (0 : Fin 3) ≤ 1))
      (ho (by decide : (1 : Fin 3) ≤ 2)) (hn 2)
  have ha : Antitone (fun i => -schmidtWeights x i) := fun i j hij => neg_le_neg (hw hij)
  have hm : Monovary (fun i => -schmidtWeights x (e i)) (fun i => l (e i)) :=
    (ha.monovary_antitone hl).comp_right e
  have htrace := trace_pair_lower_of_diagonalizations
    (fun i => schmidtWeights x (e i)) (fun i => l (e i)) hm (U*T) V
  have hs : ∑ i : (Fin 3 × Fin 3), schmidtWeights x (e i) * l (e i) =
      ∑ i : Fin 9, l i * schmidtWeights x i := by
    rw [← e.sum_comp (fun i => l i * schmidtWeights x i)]
    apply Finset.sum_congr rfl
    intro i hi
    ring
  have hz := weighted_schmidt_nonneg l x h1 h2
  rw [partial_transpose_trace_duality, hd]
  rw [ht]
  have hcj : (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) *
      ((T : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) * diagonal (fun i => (l (e i) : ℂ)) * (T : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ) *
        (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ =
      ((U*T : unitaryGroup (Fin 3 × Fin 3) ℂ) : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) *
        diagonal (fun i => (l (e i) : ℂ)) * ((U*T : unitaryGroup (Fin 3 × Fin 3) ℂ) : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ := by
    simp only [Submonoid.coe_mul, Matrix.conjTranspose_mul, Matrix.mul_assoc]
  rw [hcj]
  exact (hs ▸ hz).trans htrace
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.Sufficiency
open Matrix Finset
open scoped ComplexOrder
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.Criterion
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.Sufficiency
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.SpectralBridge
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.OrderedDiagonalization
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2 boundaryValues)
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritPerturbationAttainment (APPT)
theorem boundary_values_zero (l : Fin 9 → ℝ) : boundaryValues 0 l = l := by
  funext i
  unfold boundaryValues
  split
  · rfl
  · congr 1
    apply Fin.ext
    simp
theorem hildebrand_criterion (rho : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) (hp : rho.PosSemidef)
    (ht : rho.trace = 1) :
    APPT rho ↔
      (K1 ((fun i : Fin 9 => hp.isHermitian.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i)))).PosSemidef ∧
      (K2 ((fun i : Fin 9 => hp.isHermitian.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i)))).PosSemidef := by
  constructor
  · intro h
    obtain ⟨l,ho,hn,hs,h1,h2,hpur,hl⟩ := spectral_reduction_ordered 0 rho hp ht h
    subst l
    rw [boundary_values_zero] at h1 h2
    exact ⟨h1,h2⟩
  · rintro ⟨h1,h2⟩
    exact hildebrand_sufficiency rho hp.isHermitian h1 h2
theorem sorted_eigenvalues_of_diagonalization {J : Type} [Fintype J] [DecidableEq J] {n : ℕ}
    (hc : Fintype.card J = n) (A : Matrix J J ℂ) (H : A.IsHermitian)
    (l : Fin n → ℝ) (hl : Antitone l) (e : J ≃ Fin n) (U : unitaryGroup J ℂ)
    (hd : A = (U : Matrix J J ℂ) * diagonal (fun i => (l (e i) : ℂ)) *
      (U : Matrix J J ℂ)ᴴ) : (fun i : Fin n => H.eigenvalues₀ (Fin.cast hc.symm i)) = l := by
  have hu : (U : Matrix J J ℂ)ᴴ * (U : Matrix J J ℂ) = 1 := by
    simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_star_mul_self U
  have hchar : A.charpoly = (diagonal (fun i => (l i : ℂ))).charpoly := by
    rw [hd,charpoly_mul_comm,←Matrix.mul_assoc,hu,one_mul]
    have hd' : diagonal (fun i : J => (l (e i) : ℂ)) =
        Matrix.reindex e.symm e.symm (diagonal (fun i => (l i : ℂ))) := by
      simp [Matrix.reindex_apply,Matrix.submatrix_diagonal_equiv]
    rw [hd',charpoly_reindex]
  have hroots : (A.charpoly.roots.map Complex.re) = (List.ofFn l : Multiset ℝ) := by
    rw [hchar,charpoly_diagonal,Polynomial.roots_prod]
    · simp [← Multiset.map_map,Function.comp_def,Fin.univ_val_map]
    · simp [Finset.prod_ne_zero_iff,Polynomial.X_sub_C_ne_zero]
  have hs : ((List.ofFn l : Multiset ℝ).sort (· ≥ ·)) = List.ofFn l := by
    rw [Multiset.coe_sort]
    apply List.mergeSort_of_pairwise
    simpa only [decide_eq_true_eq,←List.sortedGE_iff_pairwise] using hl.sortedGE_ofFn
  apply List.ofFn_injective
  change List.ofFn (fun i : Fin n => H.eigenvalues₀ (Fin.cast hc.symm i)) = _
  rw [← List.ofFn_congr hc H.eigenvalues₀,← H.sort_roots_charpoly_eq_eigenvalues₀]
  change ((A.charpoly.roots.map Complex.re).sort (· ≥ ·)) = _
  rw [hroots,hs]
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.Criterion
