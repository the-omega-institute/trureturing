open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels.StateDecomposition
private theorem universal_bound : ∀ rho ∈ Set.extremePoints ℝ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels.apStates,
    (spectrum ℂ rho).ncard≤6 := by
  intro rho hr
  by_contra h
  have hk : 7≤(spectrum ℂ rho).ncard := by omega
  obtain ⟨sigma,tau,hs,ht,hne,hop⟩ := nontrivial_decomposition rho hr.1 hk
  exact hne (hr.2 hs ht hop)
theorem result : claim :=
  ⟨universal_bound,D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSixLevelExtremality.Extremality.six_level_attainment⟩
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels
