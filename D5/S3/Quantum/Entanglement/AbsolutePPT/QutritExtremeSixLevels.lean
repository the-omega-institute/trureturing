open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.Sufficiency D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.Criterion D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.OrderedDiagonalization
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.SpectralBridge
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2)
private noncomputable def state (U : unitaryGroup (Fin 3 × Fin 3) ℂ) (l : Fin 9 → ℝ) : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ :=
  Unitary.conjStarAlgAut ℂ (Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) U
    (diagonal (fun i => (l ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)))
private theorem state_psd (U : unitaryGroup (Fin 3 × Fin 3) ℂ) (l : Fin 9 → ℝ) (hn : ∀ i,0≤l i) :
    (state U l).PosSemidef := by
  have h : (diagonal (fun i : (Fin 3 × Fin 3)=> (l ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ))).PosSemidef := by
    apply PosSemidef.diagonal
    intro i
    exact Complex.nonneg_iff.mpr ⟨hn _,by simp⟩
  exact h.mul_mul_conjTranspose_same (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)
private theorem state_trace (U : unitaryGroup (Fin 3 × Fin 3) ℂ) (l : Fin 9 → ℝ) (hs : ∑ i,l i=1) :
    (state U l).trace=1 := by
  have hu : (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ*(U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)=1 := by
    simpa only [Matrix.star_eq_conjTranspose] using Unitary.coe_star_mul_self U
  rw [state,Unitary.conjStarAlgAut_apply,Matrix.star_eq_conjTranspose,
    Matrix.trace_mul_cycle,hu,Matrix.one_mul,Matrix.trace_diagonal]
  rw [(finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9).sum_comp (fun i=>(l i : ℂ))]
  norm_cast
private theorem state_mem (U : unitaryGroup (Fin 3 × Fin 3) ℂ) (l : Fin 9 → ℝ) (ho : Antitone l)
    (hn : ∀ i,0≤l i) (hs : ∑ i,l i=1) (h1 : (K1 l).PosSemidef) (h2 : (K2 l).PosSemidef) :
    state U l ∈ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels.apStates := by
  have hp := state_psd U l hn
  refine ⟨hp,state_trace U l hs,?_⟩
  have he : (fun i : Fin 9 => hp.isHermitian.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i))=l :=
    sorted_eigenvalues_of_diagonalization (by simp [Fintype.card_prod]) _ _ l ho (finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) U rfl
  apply hildebrand_sufficiency (state U l) hp.isHermitian
  · rw [he]
    exact h1
  · rw [he]
    exact h2
private theorem state_injective (U : unitaryGroup (Fin 3 × Fin 3) ℂ) : Function.Injective (state U) := by
  intro l m h
  have hu : (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ*(U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)=1 := by
    simpa only [Matrix.star_eq_conjTranspose] using Unitary.coe_star_mul_self U
  have hh := congrArg (fun A=> (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ*A*(U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)) h
  simp only [state,Unitary.conjStarAlgAut_apply,Matrix.star_eq_conjTranspose,
    ←Matrix.mul_assoc,hu,Matrix.one_mul] at hh
  simp only [Matrix.mul_assoc,hu,Matrix.mul_one] at hh
  funext i
  have hd := congrArg (fun A=>A ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9).symm i) ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9).symm i)) hh
  simpa using hd
private theorem state_midpoint (U : unitaryGroup (Fin 3 × Fin 3) ℂ) (l v : Fin 9 → ℝ) (t : ℝ) :
    (1/2 : ℝ) • state U (l+t • v) + (1/2 : ℝ) • state U (l+(-t) • v)=state U l := by
  have hd : diagonal (fun i : (Fin 3 × Fin 3)=>((l+t • v) ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) =
      diagonal (fun i=>(l ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ))+(t : ℂ) • diagonal (fun i=>(v ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) := by
    ext i j
    by_cases hij : i=j
    · subst j
      simp [Matrix.diagonal_apply]
    · simp [Matrix.diagonal_apply,hij]
  have hd' : diagonal (fun i : (Fin 3 × Fin 3)=>((l+(-t) • v) ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) =
      diagonal (fun i=>(l ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ))+(-t : ℂ) • diagonal (fun i=>(v ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) := by
    ext i j
    by_cases hij : i=j
    · subst j
      simp [Matrix.diagonal_apply]
    · simp [Matrix.diagonal_apply,hij]
  simp only [state,Unitary.conjStarAlgAut_apply,Matrix.star_eq_conjTranspose,
    hd,hd',Matrix.mul_add,Matrix.add_mul,Matrix.mul_smul,Matrix.smul_mul]
  ext i j
  simp [Matrix.add_apply,Matrix.smul_apply]
  ring
private theorem nontrivial_decomposition (rho : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) (hr : rho ∈ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels.apStates)
    (hk : 7≤(spectrum ℂ rho).ncard) :
    ∃ sigma tau : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ, sigma ∈ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels.apStates ∧ tau ∈ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels.apStates ∧
      sigma≠rho ∧ rho∈openSegment ℝ sigma tau := by
  obtain ⟨hp,ht,hap⟩ := hr
  obtain ⟨l,ho,hn,hs,h1,h2,_,hl⟩ := spectral_reduction_ordered 0 rho hp ht hap
  rw [boundary_values_zero] at h1 h2
  have hspec : spectrum ℂ rho=Complex.ofReal '' Set.range l := by
    rw [spectrum_eq_ordered_range 0 rho hp.isHermitian,←hl]
  have hk' : 7≤(Set.range l).ncard := by
    simpa [hspec,Set.ncard_image_of_injective _ Complex.ofReal_injective] using hk
  obtain ⟨v,hv,r,hrpos,hR⟩ := D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.FeasiblePerturbation.spectral_radius l ho hn hs h1 h2 hk'
  obtain ⟨U,hU⟩ := sorted_diagonalization (by simp [Fintype.card_prod]) rho hp.isHermitian (finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9)
  have hl' : l=(fun i : Fin 9 => hp.isHermitian.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i)) := hl
  have hstate : rho=state U l := by
    change rho = (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) *
      diagonal (fun i => (l (finProdFinEquiv i) : ℂ)) *
      (U : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)ᴴ
    rw [hl']
    exact hU
  let t : ℝ := r/2
  have htpos : 0<t := by dsimp [t]; positivity
  have htr : |t|<r := by rw [abs_of_pos htpos]; dsimp [t]; linarith
  have htm : |-t|<r := by simpa using htr
  obtain ⟨hpo,hpn,hps,hp1,hp2⟩ := hR t htr
  obtain ⟨hmo,hmn,hms,hm1,hm2⟩ := hR (-t) htm
  refine ⟨state U (l+t • v),state U (l+(-t) • v),
    state_mem U _ hpo hpn hps hp1 hp2,state_mem U _ hmo hmn hms hm1 hm2,?_,?_⟩
  · intro heq
    rw [hstate] at heq
    have hv0 : t • v=0 := by
      have he := state_injective U heq
      exact add_eq_left.mp he
    exact hv ((smul_eq_zero.mp hv0).resolve_left (ne_of_gt htpos))
  · refine ⟨1/2,1/2,by norm_num,by norm_num,by norm_num,?_⟩
    rw [state_midpoint,←hstate]
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritExtremeSixLevels.StateDecomposition
