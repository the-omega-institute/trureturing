def apStates : Set (Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) :=
  {rho | rho.PosSemidef ∧ rho.trace = 1 ∧ APPT rho}
noncomputable def claim : Prop :=
  (∀ rho ∈ Set.extremePoints ℝ apStates, (spectrum ℂ rho).ncard ≤ 6) ∧
  ∃ rho ∈ Set.extremePoints ℝ apStates, (spectrum ℂ rho).ncard = 6
