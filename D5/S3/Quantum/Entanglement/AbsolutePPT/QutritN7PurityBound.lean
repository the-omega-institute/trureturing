  have ht_A2_14 : 0 ≤ gap l 13 * (A2_14 * K2 l).trace :=
    mul_nonneg (hy 13) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_14_psd h2)
  have ht_A2_15 : 0 ≤ gap l 14 * (A2_15 * K2 l).trace :=
    mul_nonneg (hy 14) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_15_psd h2)
  have ht_A2_16 : 0 ≤ gap l 15 * (A2_16 * K2 l).trace :=
    mul_nonneg (hy 15) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_16_psd h2)
  have ht_A2_17 : 0 ≤ gap l 16 * (A2_17 * K2 l).trace :=
    mul_nonneg (hy 16) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_17_psd h2)
  have ht_A2_18 : 0 ≤ gap l 17 * (A2_18 * K2 l).trace :=
    mul_nonneg (hy 17) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_18_psd h2)
  have ht_A2_19 : 0 ≤ gap l 18 * (A2_19 * K2 l).trace :=
    mul_nonneg (hy 18) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_19_psd h2)
  have ht_A2_20 : 0 ≤ gap l 19 * (A2_20 * K2 l).trace :=
    mul_nonneg (hy 19) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_20_psd h2)
  have he := certificate_identity l
  rw [htrace] at he
  norm_num only [one_pow, mul_one] at he
  linarith only [he, hQ, hN, ht_A1_2, ht_A1_3, ht_A1_4, ht_A1_5, ht_A1_6, ht_A1_7, ht_A1_8, ht_A1_9, ht_A1_10, ht_A1_11, ht_A1_12, ht_A1_13, ht_A1_14, ht_A1_15, ht_A1_16, ht_A1_17, ht_A1_18, ht_A1_19, ht_A1_20, ht_A2_1, ht_A2_2, ht_A2_3, ht_A2_4, ht_A2_5, ht_A2_6, ht_A2_7, ht_A2_8, ht_A2_9, ht_A2_10, ht_A2_11, ht_A2_12, ht_A2_13, ht_A2_14, ht_A2_15, ht_A2_16, ht_A2_17, ht_A2_18, ht_A2_19, ht_A2_20]

theorem purity_bound
    (rho : Matrix (Fin 3 × Fin 7) (Fin 3 × Fin 7) ℂ)
    (hrho : rho.PosSemidef) (htrace : rho.trace = 1)
    (happt : QutritPerturbationAttainment.APPT rho) :
    (rho*rho).trace.re ≤ (29 : ℝ)/(23)^2 := by
  obtain ⟨l, ho, hn, ht, h1, h2, hp⟩ :=
    QutritSpectralReduction.spectral_reduction 4 rho hrho htrace happt
  rw [hp]
  exact certificate_bound l ho (hn 20) ht h1 h2

