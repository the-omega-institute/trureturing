theorem purity_bound
    (rho : Matrix (Fin 3 × Fin 10) (Fin 3 × Fin 10) ℂ)
    (hrho : rho.PosSemidef) (htrace : rho.trace = 1)
    (happt : QutritPerturbationAttainment.APPT rho) :
    (rho*rho).trace.re ≤ (3 : ℝ)/(80) := by
  obtain ⟨l, ho, hn, ht, h1, h2, hp⟩ :=
    QutritSpectralReduction.spectral_reduction 7 rho hrho htrace happt
  rw [hp]
  exact certificate_bound l ho (hn 29) ht h1 h2

