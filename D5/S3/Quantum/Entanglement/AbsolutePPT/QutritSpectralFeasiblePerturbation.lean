open Matrix Finset
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.PencilDependency
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2)
private def J : Matrix (Fin 3) (Fin 3) ℝ := !![0,0,-1;0,2,0;-1,0,0]
private theorem pencil_difference (l : Fin 9 → ℝ) : K2 l - K1 l = (l 5-l 6) • J := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [K1,K2,J,Matrix.sub_apply,Matrix.smul_apply] <;> ring
private theorem symmetric_K1 (l : Fin 9 → ℝ) : (K1 l).IsSymm := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [K1,Matrix.transpose_apply]
private theorem kernel_difference_identity (l : Fin 9 → ℝ) (p q : Fin 3 → ℝ)
    (hp : K1 l *ᵥ p = 0) (hq : K2 l *ᵥ q = 0) :
    (l 5-l 6) * (p ⬝ᵥ (J *ᵥ q)) = 0 := by
  have h1 : p ⬝ᵥ (K1 l *ᵥ q) = 0 := by
    rw [dotProduct_mulVec,←Matrix.mulVec_transpose, symmetric_K1 l, hp,zero_dotProduct]
  have h2 : p ⬝ᵥ (K2 l *ᵥ q) = 0 := by rw [hq,dotProduct_zero]
  have h : p ⬝ᵥ ((K2 l-K1 l) *ᵥ q) = 0 := by
    simp only [Matrix.sub_mulVec,dotProduct_sub,h1,h2,sub_self]
  rw [pencil_difference,Matrix.smul_mulVec,dotProduct_smul,smul_eq_mul] at h
  exact h
private theorem kernel_dependency_gap (l v : Fin 9 → ℝ) (p q : Fin 3 → ℝ)
    (hp : K1 l *ᵥ p = 0) (hq : K2 l *ᵥ q = 0) (hgap : l 6 < l 5) :
    p ⬝ᵥ (K2 v *ᵥ q) - q ⬝ᵥ (K1 v *ᵥ p) = 0 := by
  have hj : p ⬝ᵥ (J *ᵥ q) = 0 :=
    (mul_eq_zero.mp (kernel_difference_identity l p q hp hq)).resolve_left (sub_ne_zero.mpr (ne_of_gt hgap))
  have hsym : q ⬝ᵥ (K1 v *ᵥ p) = p ⬝ᵥ (K1 v *ᵥ q) := by
    rw [dotProduct_mulVec,←Matrix.mulVec_transpose,symmetric_K1 v,dotProduct_comm]
  rw [hsym,←dotProduct_sub,←Matrix.sub_mulVec,pencil_difference,
    Matrix.smul_mulVec,dotProduct_smul,smul_eq_mul,hj,mul_zero]
private theorem kernel_dependency_repeated (v : Fin 9 → ℝ) (p q : Fin 3 → ℝ)
    (hv : v 5=v 6) : p ⬝ᵥ (K2 v *ᵥ q) - q ⬝ᵥ (K1 v *ᵥ p) = 0 := by
  have hsym : q ⬝ᵥ (K1 v *ᵥ p) = p ⬝ᵥ (K1 v *ᵥ q) := by
    rw [dotProduct_mulVec,←Matrix.mulVec_transpose,symmetric_K1 v,dotProduct_comm]
  rw [hsym,←dotProduct_sub,←Matrix.sub_mulVec,pencil_difference,hv,sub_self,zero_smul,
    Matrix.zero_mulVec,dotProduct_zero]
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.PencilDependency

open Matrix Finset Module
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Dimension
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2)
private theorem blockLift_injective (l : Fin 9 → ℝ) : Function.Injective ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l)))) := by
  apply LinearMap.funLeft_injective_of_surjective
  intro x
  obtain ⟨i,hi⟩ := x.property
  exact ⟨i,Subtype.ext hi⟩
private noncomputable def constraints (l : Fin 9 → ℝ) (p q : Fin 3 → ℝ) :
    (Set.range l → ℝ) →ₗ[ℝ] (Fin 7 → ℝ) where
  toFun b := ![∑ i, (LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b i,
    (K1 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ p) 0,(K1 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ p) 1,(K1 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ p) 2,
    (K2 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ q) 0,(K2 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ q) 1,(K2 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ q) 2]
  map_add' b c := by
    ext i
    fin_cases i <;> simp [K1,K2,Matrix.mulVec,dotProduct,Fin.sum_univ_three,
      Fin.sum_univ_succ,add_mul] <;> ring
  map_smul' t b := by
    ext i
    fin_cases i <;> simp [K1,K2,Matrix.mulVec,dotProduct,Fin.sum_univ_three,
      Fin.sum_univ_succ,mul_add,mul_sub] <;> ring
private def relation (p q : Fin 3 → ℝ) : Fin 7 → ℝ := ![0,-q 0,-q 1,-q 2,p 0,p 1,p 2]
private theorem relation_ne_zero (p q : Fin 3 → ℝ) (hpq : p≠0 ∨ q≠0) : relation p q≠0 := by
  intro hz
  have hp : p=0 := by
    funext i
    fin_cases i
    · simpa [relation] using congrFun hz 4
    · simpa [relation] using congrFun hz 5
    · simpa [relation] using congrFun hz 6
  have hq : q=0 := by
    funext i
    fin_cases i
    · have := congrFun hz 1; simpa [relation] using this
    · have := congrFun hz 2; simpa [relation] using this
    · have := congrFun hz 3; simpa [relation] using this
  exact hpq.elim (fun h=>h hp) (fun h=>h hq)
private theorem relation_constraints (l : Fin 9 → ℝ) (p q : Fin 3 → ℝ)
    (hdep : ∀ b, p ⬝ᵥ (K2 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ q) - q ⬝ᵥ (K1 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ p)=0) :
    ∀ b, relation p q ⬝ᵥ constraints l p q b=0 := by
  intro b
  have hh := hdep b
  simp [dotProduct,Fin.sum_univ_three,Fin.sum_univ_succ,relation,constraints] at hh ⊢
  linarith
private theorem exists_nonzero_kernel {V : Type} [AddCommGroup V] [Module ℝ V] [FiniteDimensional ℝ V]
    (F : V →ₗ[ℝ] (Fin 7 → ℝ)) (r : Fin 7 → ℝ) (hr : r≠0)
    (hrel : ∀ b, r ⬝ᵥ F b=0) (hk : 7 ≤ finrank ℝ V) : ∃ b, b≠0 ∧ F b=0 := by
  have hntop : LinearMap.range F≠⊤ := by
    intro ht
    have hs := LinearMap.range_eq_top.mp ht
    obtain ⟨b,hb⟩ := hs r
    have hh := hrel b
    rw [hb,dotProduct_self_eq_zero] at hh
    exact hr hh
  have hlt : finrank ℝ (LinearMap.range F)<7 := by
    have hh := Submodule.finrank_lt_finrank_of_lt (lt_top_iff_ne_top.mpr hntop)
    simpa using hh
  have hrank := F.finrank_range_add_finrank_ker
  have hn : LinearMap.ker F≠⊥ := by
    apply Submodule.one_le_finrank_iff.mp
    omega
  obtain ⟨b,hb,hbz⟩ := (LinearMap.ker F).ne_bot_iff.mp hn
  exact ⟨b,hbz,LinearMap.mem_ker.mp hb⟩
private theorem block_perturbation (l : Fin 9 → ℝ) (p q : Fin 3 → ℝ)
    (hk : 7≤(Set.range l).ncard) (hpq : p≠0 ∨ q≠0)
    (hdep : ∀ b, p ⬝ᵥ (K2 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ q)-q ⬝ᵥ (K1 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ p)=0) :
    ∃ v : Fin 9 → ℝ, v≠0 ∧ (∑ i,v i=0) ∧ (K1 v *ᵥ p=0) ∧ (K2 v *ᵥ q=0) ∧
      (∀ i j, l i=l j → v i=v j) := by
  classical
  letI : Fintype (Set.range l) := (Set.finite_range l).fintype
  have hk' : 7≤finrank ℝ (Set.range l → ℝ) := by
    simpa [finrank_pi,←Nat.card_eq_fintype_card, Nat.card_coe_set_eq] using hk
  obtain ⟨b,hb,hF⟩ := exists_nonzero_kernel (constraints l p q) (relation p q)
    (relation_ne_zero p q hpq) (relation_constraints l p q hdep) hk'
  refine ⟨(LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b,?_,?_,?_,?_,?_⟩
  · exact fun h=> hb ((blockLift_injective l) (by simpa using h))
  · simpa [constraints] using congrFun hF 0
  · funext i
    fin_cases i
    · simpa [constraints] using congrFun hF 1
    · simpa [constraints] using congrFun hF 2
    · simpa [constraints] using congrFun hF 3
  · funext i
    fin_cases i
    · simpa [constraints] using congrFun hF 4
    · simpa [constraints] using congrFun hF 5
    · simpa [constraints] using congrFun hF 6
  · intro i j hij
    simp [hij]
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Dimension
open Matrix Finset
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ActiveKernels
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2)
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.PencilDependency D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Dimension
private theorem canonical_mul (a b c d e f : ℝ) :
    (!![a,b,c;b,d,e;c,e,f] : Matrix (Fin 3) (Fin 3) ℝ) *ᵥ (crossProduct ![a,b,c] ![b,d,e]) = ![0,0,((!![a,b,c;b,d,e;c,e,f] : Matrix (Fin 3) (Fin 3) ℝ)).det] := by
  simp only [Matrix.det_fin_three]
  ext i
  fin_cases i <;> simp [crossProduct,Matrix.mulVec,dotProduct,Fin.sum_univ_three] <;> ring
private noncomputable def active1 (l : Fin 9 → ℝ) : Fin 3 → ℝ :=
  if (K1 l).det=0 then crossProduct ((K1 l) 0) ((K1 l) 1) else 0
private noncomputable def active2 (l : Fin 9 → ℝ) : Fin 3 → ℝ :=
  if (K2 l).det=0 then crossProduct ((K2 l) 0) ((K2 l) 1) else 0
private theorem active1_kernel (l : Fin 9 → ℝ) : K1 l *ᵥ active1 l=0 := by
  by_cases hd : (K1 l).det=0
  · simp only [active1,if_pos hd]
    change K1 l *ᵥ crossProduct ![2*l 8,l 7-l 0,l 5-l 1] ![l 7-l 0,2*l 6,l 4-l 2] = 0
    have hh := canonical_mul (2*l 8) (l 7-l 0) (l 5-l 1) (2*l 6) (l 4-l 2) (2*l 3)
    change K1 l *ᵥ _ = ![0,0,(K1 l).det] at hh
    rw [hh,hd]
    ext i
    fin_cases i <;> simp
  · simp [active1,hd]
private theorem active2_kernel (l : Fin 9 → ℝ) : K2 l *ᵥ active2 l=0 := by
  by_cases hd : (K2 l).det=0
  · simp only [active2,if_pos hd]
    change K2 l *ᵥ crossProduct ![2*l 8,l 7-l 0,l 6-l 1] ![l 7-l 0,2*l 5,l 4-l 2] = 0
    have hh := canonical_mul (2*l 8) (l 7-l 0) (l 6-l 1) (2*l 5) (l 4-l 2) (2*l 3)
    change K2 l *ᵥ _ = ![0,0,(K2 l).det] at hh
    rw [hh,hd]
    ext i
    fin_cases i <;> simp
  · simp [active2,hd]
private theorem active1_nonzero (l : Fin 9 → ℝ) (hd : (K1 l).det=0)
    (hm : 0<(2*l 8)*(2*l 6)-(l 7-l 0)^2) : active1 l≠0 := by
  intro hz
  have hh := congrFun hz 2
  simp only [active1,if_pos hd] at hh
  change (2*l 8)*(2*l 6)-(l 7-l 0)*(l 7-l 0)=0 at hh
  rw [pow_two] at hm
  linarith
private theorem active2_nonzero (l : Fin 9 → ℝ) (hd : (K2 l).det=0)
    (hm : 0<(2*l 8)*(2*l 5)-(l 7-l 0)^2) : active2 l≠0 := by
  intro hz
  have hh := congrFun hz 2
  simp only [active2,if_pos hd] at hh
  change (2*l 8)*(2*l 5)-(l 7-l 0)*(l 7-l 0)=0 at hh
  rw [pow_two] at hm
  linarith
private theorem active_dependency (l : Fin 9 → ℝ) (ho : Antitone l) :
    ∀ b, active1 l ⬝ᵥ (K2 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ active2 l) -
      active2 l ⬝ᵥ (K1 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ active1 l)=0 := by
  intro b
  by_cases he : l 5=l 6
  · apply kernel_dependency_repeated
    simp [he]
  · exact kernel_dependency_gap l ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) (active1 l) (active2 l)
      (active1_kernel l) (active2_kernel l)
      (lt_of_le_of_ne (ho (show (5 : Fin 9)≤6 by decide)) (Ne.symm he))
private theorem block_perturbation_general (l : Fin 9 → ℝ) (p q : Fin 3 → ℝ)
    (hk : 7≤(Set.range l).ncard)
    (hdep : ∀ b, p ⬝ᵥ (K2 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ q)-q ⬝ᵥ (K1 ((LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b) *ᵥ p)=0) :
    ∃ v : Fin 9 → ℝ, v≠0 ∧ (∑ i,v i=0) ∧ (K1 v *ᵥ p=0) ∧ (K2 v *ᵥ q=0) ∧
      (∀ i j, l i=l j → v i=v j) := by
  by_cases hpq : p≠0 ∨ q≠0
  · exact block_perturbation l p q hk hpq hdep
  · push_neg at hpq
    rcases hpq with ⟨rfl,rfl⟩
    classical
    letI : Fintype (Set.range l) := (Set.finite_range l).fintype
    have hk' : 7≤Module.finrank ℝ (Set.range l → ℝ) := by
      simpa [Module.finrank_pi] using hk
    let r : Fin 7 → ℝ := Pi.single 1 1
    have hr : r≠0 := by intro hz; have := congrFun hz 1; simpa [r] using this
    have hrel : ∀ b, r ⬝ᵥ constraints l 0 0 b=0 := by
      intro b
      simp [r,constraints]
    obtain ⟨b,hb,hF⟩ := exists_nonzero_kernel (constraints l 0 0) r hr hrel hk'
    refine ⟨(LinearMap.funLeft ℝ ℝ (fun i : Fin 9 => (⟨l i, Set.mem_range_self i⟩ : Set.range l))) b,?_,?_,by simp,by simp,?_⟩
    · exact fun h=>hb ((blockLift_injective l) (by simpa using h))
    · simpa [constraints] using congrFun hF 0
    · intro i j hij
      simp [hij]
private theorem active_perturbation (l : Fin 9 → ℝ) (ho : Antitone l) (hk : 7≤(Set.range l).ncard) :
    ∃ v : Fin 9 → ℝ, v≠0 ∧ (∑ i,v i=0) ∧ (K1 v *ᵥ active1 l=0) ∧
      (K2 v *ᵥ active2 l=0) ∧ (∀ i j, l i=l j → v i=v j) :=
  block_perturbation_general l (active1 l) (active2 l) hk (active_dependency l ho)
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ActiveKernels

open Matrix Finset
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ThreeByThree
private def symm (a b c d e f : ℝ) : Matrix (Fin 3) (Fin 3) ℝ := !![a,b,c;b,d,e;c,e,f]
private noncomputable def lower (a b c d e : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![1,0,0;b/a,1,0;c/a,(a*e-b*c)/(a*d-b^2),1]
private theorem det_symm (a b c d e f : ℝ) :
    (symm a b c d e f).det = a*d*f+2*b*c*e-a*e^2-d*c^2-f*b^2 := by
  simp [symm,Matrix.det_fin_three]
  ring
private theorem ldl (a b c d e f : ℝ) (ha : a ≠ 0) (hdel : a*d-b^2 ≠ 0) :
    symm a b c d e f = lower a b c d e *
      diagonal ![a,(a*d-b^2)/a,(symm a b c d e f).det/(a*d-b^2)] *
        (lower a b c d e).transpose := by
  rw [det_symm]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [symm,lower,Matrix.mul_apply,Matrix.vecMul,dotProduct,Matrix.diagonal_apply,Matrix.transpose_apply,Fin.sum_univ_three]
  all_goals field_simp [ha,hdel]
  all_goals ring
private theorem psd_of_minors (a b c d e f : ℝ) (ha : 0<a) (hdel : 0<a*d-b^2)
    (hd : 0 ≤ (symm a b c d e f).det) : (symm a b c d e f).PosSemidef := by
  rw [ldl a b c d e f (ne_of_gt ha) (ne_of_gt hdel)]
  have hD : (diagonal ![a,(a*d-b^2)/a,(symm a b c d e f).det/(a*d-b^2)]).PosSemidef := by
    apply PosSemidef.diagonal
    intro i
    fin_cases i
    · exact ha.le
    · exact div_nonneg hdel.le ha.le
    · exact div_nonneg hd hdel.le
  simpa only [Matrix.conjTranspose_eq_transpose_of_trivial] using hD.mul_mul_conjTranspose_same (lower a b c d e)
private theorem leading_minor_nonneg (a b c d e f : ℝ) (h : (symm a b c d e f).PosSemidef)
    (ha : 0<a) : 0≤a*d-b^2 := by
  have hh := (h.submatrix (Fin.castLE (by decide) : Fin 2 → Fin 3)).det_nonneg
  simpa [symm, Matrix.det_fin_two, Matrix.submatrix, Fin.castLE, sq] using hh
private theorem zero_leading_minor (a b c d e f : ℝ) (h : (symm a b c d e f).PosSemidef)
    (hz : a*d-b^2=0) : b*c-a*e=0 := by
  have hv : star ![b,-a,0] ⬝ᵥ (symm a b c d e f *ᵥ ![b,-a,0])=0 := by
    simp [symm,Matrix.mulVec,dotProduct,Fin.sum_univ_three]
    calc
      b * (a*b + -(b*a)) + -(a*(b*b + -(d*a))) = a*(a*d-b^2) := by ring
      _ = 0 := by rw [hz,mul_zero]
  have hk := (h.dotProduct_mulVec_zero_iff).mp hv
  have ht := congrFun hk 2
  simp [symm,Matrix.mulVec,dotProduct,Fin.sum_univ_three] at ht
  nlinarith [ht]
private theorem leading_minor_pos_of_signs (a b c d e f : ℝ)
    (h : (symm a b c d e f).PosSemidef) (ha : 0<a) (hd : 0<d)
    (hb : b≤0) (hc : c<0) (he : e≤0) : 0<a*d-b^2 := by
  have hn := leading_minor_nonneg a b c d e f h ha
  by_contra hnot
  have hz : a*d-b^2=0 := le_antisymm (le_of_not_gt hnot) hn
  have ht := zero_leading_minor a b c d e f h hz
  have hbn : b<0 := lt_of_le_of_ne hb (by intro hzero; rw [hzero] at hz; nlinarith [mul_pos ha hd])
  have hbc : 0<b*c := mul_pos_of_neg_of_neg hbn hc
  have hae : a*e≤0 := mul_nonpos_of_nonneg_of_nonpos ha.le he
  linarith
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ThreeByThree
open Matrix Finset
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Boundary
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2)
private theorem psd_zero_diagonal_row {n : Type} [Fintype n] [DecidableEq n]
    (A : Matrix n n ℝ) (h : A.PosSemidef) (i : n) (hi : A i i = 0) :
    ∀ j, A j i = 0 := by
  let v : n → ℝ := Pi.single i 1
  have hv : v ⬝ᵥ (A *ᵥ v) = 0 := by simpa [v,Matrix.mulVec_single] using hi
  have hz := (h.dotProduct_mulVec_zero_iff).mp (by simpa using hv)
  intro j
  simpa [v,Matrix.mulVec_single] using congrFun hz j
private theorem zero_minimum_levels (l : Fin 9 → ℝ) (ho : Antitone l)
    (h1 : (K1 l).PosSemidef) (hz : l 8 = 0) :
    ∀ i : Fin 9, i ≠ 8 → l i = l 0 := by
  have row := psd_zero_diagonal_row (K1 l) h1 0 (by simp [K1,hz])
  have eq : l 7 = l 0 := by
    have h := row 1
    have h' : l 7-l 0=0 := by simpa [K1] using h
    exact sub_eq_zero.mp h'
  intro i hi
  have hle : i ≤ (7 : Fin 9) := by omega
  exact le_antisymm (ho (show (0 : Fin 9) ≤ i by omega)) (by rw [←eq]; exact ho hle)
private theorem zero_minimum_ncard (l : Fin 9 → ℝ) (ho : Antitone l)
    (h1 : (K1 l).PosSemidef) (hz : l 8 = 0) : (Set.range l).ncard ≤ 2 := by
  have hs : Set.range l ⊆ {l 0,l 8} := by
    rintro x ⟨i,rfl⟩
    by_cases hi : i=8
    · simp [hi]
    · simp [zero_minimum_levels l ho h1 hz i hi]
  exact (Set.ncard_le_ncard hs (Set.toFinite _)).trans (by have hh := Set.ncard_insert_le (l 0) ({l 8} : Set ℝ); simpa using hh)
private theorem positive_minimum_of_seven_levels (l : Fin 9 → ℝ) (ho : Antitone l)
    (hn : ∀ i, 0 ≤ l i) (h1 : (K1 l).PosSemidef) (hk : 7 ≤ (Set.range l).ncard) :
    0 < l 8 := by
  by_contra h
  have hz : l 8=0 := le_antisymm (le_of_not_gt h) (hn 8)
  have := zero_minimum_ncard l ho h1 hz
  omega
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Boundary
open Matrix Finset
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.PencilMinors
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2)
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ThreeByThree
private theorem range_ncard_le {n : ℕ} (l : Fin n → ℝ) : (Set.range l).ncard≤n := by
  have h := Set.ncard_image_le (f := l) (s := Set.univ)
  simpa using h
private theorem few_levels_of_eq (l : Fin 9 → ℝ) (ho : Antitone l) (he : l 1=l 5) :
    (Set.range l).ncard≤5 := by
  let m : Fin 5 → ℝ := ![l 0,l 1,l 6,l 7,l 8]
  have hs : Set.range l ⊆ Set.range m := by
    rintro x ⟨i,rfl⟩
    have hi : ∀ j : Fin 9, 1≤j → j≤5 → l j=l 1 := by
      intro j hj hj'
      apply le_antisymm (ho hj)
      rw [he]
      exact ho hj'
    fin_cases i
    · exact ⟨0,rfl⟩
    · exact ⟨1,rfl⟩
    · exact ⟨1,by simpa [m] using (hi 2 (by decide) (by decide)).symm⟩
    · exact ⟨1,by simpa [m] using (hi 3 (by decide) (by decide)).symm⟩
    · exact ⟨1,by simpa [m] using (hi 4 (by decide) (by decide)).symm⟩
    · exact ⟨1,by simpa [m] using he⟩
    · exact ⟨2,rfl⟩
    · exact ⟨3,rfl⟩
    · exact ⟨4,rfl⟩
  exact (Set.ncard_le_ncard hs (Set.finite_range m)).trans (range_ncard_le m)
private theorem strict_upper_gap (l : Fin 9 → ℝ) (ho : Antitone l) (hk : 7≤(Set.range l).ncard) :
    l 5<l 1 := by
  apply lt_of_le_of_ne (ho (show (1 : Fin 9)≤5 by decide))
  intro he
  have := few_levels_of_eq l ho he.symm
  omega
private theorem K1_leading_minor_pos (l : Fin 9 → ℝ) (ho : Antitone l)
    (h1 : (K1 l).PosSemidef) (hm : 0<l 8) (hc : l 5<l 1) :
    0<(2*l 8)*(2*l 6)-(l 7-l 0)^2 := by
  apply leading_minor_pos_of_signs (2*l 8) (l 7-l 0) (l 5-l 1) (2*l 6) (l 4-l 2) (2*l 3) h1
  · positivity
  · have hh := ho (show (6 : Fin 9)≤8 by decide); linarith
  · exact sub_nonpos.mpr (ho (show (0 : Fin 9)≤7 by decide))
  · exact sub_neg.mpr hc
  · exact sub_nonpos.mpr (ho (show (2 : Fin 9)≤4 by decide))
private theorem K2_leading_minor_pos (l : Fin 9 → ℝ) (ho : Antitone l)
    (h2 : (K2 l).PosSemidef) (hm : 0<l 8) (hc : l 5<l 1) :
    0<(2*l 8)*(2*l 5)-(l 7-l 0)^2 := by
  apply leading_minor_pos_of_signs (2*l 8) (l 7-l 0) (l 6-l 1) (2*l 5) (l 4-l 2) (2*l 3) h2
  · positivity
  · have hh := ho (show (5 : Fin 9)≤8 by decide); linarith
  · exact sub_nonpos.mpr (ho (show (0 : Fin 9)≤7 by decide))
  · apply sub_neg.mpr
    exact lt_of_le_of_lt (ho (show (5 : Fin 9)≤6 by decide)) hc
  · exact sub_nonpos.mpr (ho (show (2 : Fin 9)≤4 by decide))
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.PencilMinors
open Matrix Finset Filter
open scoped Topology
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Radius
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ThreeByThree
private theorem det_zero_of_kernel (A : Matrix (Fin 3) (Fin 3) ℝ) (p : Fin 3 → ℝ)
    (hp : p≠0) (hk : A *ᵥ p=0) : A.det=0 := by
  exact Matrix.exists_mulVec_eq_zero_iff.mp ⟨p, hp, hk⟩
private theorem eventually_psd (a b c d e f : ℝ → ℝ)
    (haC : Continuous a) (hbC : Continuous b) (hcC : Continuous c)
    (hdC : Continuous d) (heC : Continuous e) (hfC : Continuous f)
    (ha : 0<a 0) (hdel : 0<a 0*d 0-(b 0)^2)
    (hdet : 0≤(symm (a 0) (b 0) (c 0) (d 0) (e 0) (f 0)).det)
    (hk : (symm (a 0) (b 0) (c 0) (d 0) (e 0) (f 0)).det=0 →
      ∃ p : Fin 3 → ℝ, p≠0 ∧ ∀ t, symm (a t) (b t) (c t) (d t) (e t) (f t) *ᵥ p=0) :
    ∀ᶠ t in 𝓝 (0 : ℝ), (symm (a t) (b t) (c t) (d t) (e t) (f t)).PosSemidef := by
  have hA : ∀ᶠ t in 𝓝 (0 : ℝ), 0<a t :=
    continuousAt_const.eventually_lt haC.continuousAt ha
  have hD : ∀ᶠ t in 𝓝 (0 : ℝ), 0<a t*d t-(b t)^2 :=
    continuousAt_const.eventually_lt ((haC.mul hdC).sub (hbC.pow 2)).continuousAt hdel
  have hdetC : Continuous (fun t=> (symm (a t) (b t) (c t) (d t) (e t) (f t)).det) := by
    simp only [det_symm]
    fun_prop
  by_cases hz : (symm (a 0) (b 0) (c 0) (d 0) (e 0) (f 0)).det=0
  · obtain ⟨p,hp,hker⟩ := hk hz
    filter_upwards [hA,hD] with t htA htD
    apply psd_of_minors _ _ _ _ _ _ htA htD
    exact (det_zero_of_kernel _ p hp (hker t)).ge
  · have hpos := lt_of_le_of_ne hdet (Ne.symm hz)
    have hdetE : ∀ᶠ t in 𝓝 (0 : ℝ), 0<(symm (a t) (b t) (c t) (d t) (e t) (f t)).det :=
      continuousAt_const.eventually_lt hdetC.continuousAt hpos
    filter_upwards [hA,hD,hdetE] with t htA htD htDet
    exact psd_of_minors _ _ _ _ _ _ htA htD htDet.le
private theorem radius_of_eventually {P : ℝ → Prop} (h : ∀ᶠ t in 𝓝 (0 : ℝ), P t) :
    ∃ r : ℝ, 0<r ∧ ∀ t, |t|<r → P t := by
  obtain ⟨r,hr,hs⟩ := Metric.mem_nhds_iff.mp h
  refine ⟨r,hr,fun t ht=>hs ?_⟩
  simpa [Metric.mem_ball,Real.dist_eq,sub_zero] using ht
private theorem eventually_order (l v : Fin 9 → ℝ) (ho : Antitone l)
    (hv : ∀ i j, l i=l j → v i=v j) :
    ∀ᶠ t in 𝓝 (0 : ℝ), Antitone (l+t • v) := by
  have hp : ∀ i j : Fin 9, i≤j → ∀ᶠ t in 𝓝 (0 : ℝ), (l+t • v) j≤(l+t • v) i := by
    intro i j hij
    by_cases he : l i=l j
    · have he' := hv i j he
      exact Filter.Eventually.of_forall (by intro t; simp [he,he'])
    · have hl : l j<l i := lt_of_le_of_ne (ho hij) (Ne.symm he)
      have hlt : ∀ᶠ t in 𝓝 (0 : ℝ), l j+t*v j<l i+t*v i :=
        (by fun_prop : ContinuousAt (fun t : ℝ=>l j+t*v j) 0).eventually_lt
          (by fun_prop : ContinuousAt (fun t : ℝ=>l i+t*v i) 0) (by simpa using hl)
      filter_upwards [hlt] with t ht
      exact ht.le
  have hh : ∀ᶠ t in 𝓝 (0 : ℝ), ∀ i j : Fin 9, i≤j → (l+t • v) j≤(l+t • v) i := by
    simp only [Filter.eventually_all]
    intro i j hij
    exact hp i j hij
  exact hh
private theorem eventually_positive (l v : Fin 9 → ℝ) (ho : Antitone l) (hm : 0<l 8) :
    ∀ᶠ t in 𝓝 (0 : ℝ), ∀ i, 0<(l+t • v) i := by
  simp only [Filter.eventually_all]
  intro i
  have hp : 0<l i := lt_of_lt_of_le hm (ho (show i≤(8 : Fin 9) by omega))
  simpa using continuousAt_const.eventually_lt
    (by fun_prop : ContinuousAt (fun t : ℝ=>l i+t*v i) 0) (by simpa using hp)
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Radius
open Matrix Finset Filter
open scoped Topology
namespace D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.FeasiblePerturbation
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction (K1 K2)
open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ActiveKernels D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.ThreeByThree D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.PencilMinors D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Radius
private theorem K1_affine (l v : Fin 9 → ℝ) (t : ℝ) : K1 (l+t • v)=K1 l+t • K1 v := by
  ext i j
  fin_cases i <;> fin_cases j <;> simp [K1,Matrix.smul_apply,Matrix.add_apply] <;> ring
private theorem K2_affine (l v : Fin 9 → ℝ) (t : ℝ) : K2 (l+t • v)=K2 l+t • K2 v := by
  simpa using D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSixLevelExtremality.ConvexKernel.K2_linear 1 t l v
private theorem K1_eventually_psd (l v : Fin 9 → ℝ) (ho : Antitone l) (h1 : (K1 l).PosSemidef)
    (hm : 0<l 8) (hc : l 5<l 1) (hv : K1 v *ᵥ active1 l=0) :
    ∀ᶠ t in 𝓝 (0 : ℝ), (K1 (l+t • v)).PosSemidef := by
  apply eventually_psd (fun t=>2*(l+t • v) 8) (fun t=>(l+t • v) 7-(l+t • v) 0)
    (fun t=>(l+t • v) 5-(l+t • v) 1) (fun t=>2*(l+t • v) 6)
    (fun t=>(l+t • v) 4-(l+t • v) 2) (fun t=>2*(l+t • v) 3)
  · fun_prop
  · fun_prop
  · fun_prop
  · fun_prop
  · fun_prop
  · fun_prop
  · simpa using (show 0<2*l 8 by positivity)
  · simpa using K1_leading_minor_pos l ho h1 hm hc
  · simpa [K1,ThreeByThree.symm] using h1.det_nonneg
  · intro hd
    have hd' : (K1 l).det=0 := by simpa [K1,ThreeByThree.symm] using hd
    refine ⟨active1 l,active1_nonzero l hd' (K1_leading_minor_pos l ho h1 hm hc),?_⟩
    intro t
    change K1 (l+t • v) *ᵥ active1 l=0
    rw [K1_affine,Matrix.add_mulVec,Matrix.smul_mulVec,active1_kernel,hv,smul_zero,add_zero]
private theorem K2_eventually_psd (l v : Fin 9 → ℝ) (ho : Antitone l) (h2 : (K2 l).PosSemidef)
    (hm : 0<l 8) (hc : l 5<l 1) (hv : K2 v *ᵥ active2 l=0) :
    ∀ᶠ t in 𝓝 (0 : ℝ), (K2 (l+t • v)).PosSemidef := by
  apply eventually_psd (fun t=>2*(l+t • v) 8) (fun t=>(l+t • v) 7-(l+t • v) 0)
    (fun t=>(l+t • v) 6-(l+t • v) 1) (fun t=>2*(l+t • v) 5)
    (fun t=>(l+t • v) 4-(l+t • v) 2) (fun t=>2*(l+t • v) 3)
  · fun_prop
  · fun_prop
  · fun_prop
  · fun_prop
  · fun_prop
  · fun_prop
  · simpa using (show 0<2*l 8 by positivity)
  · simpa using K2_leading_minor_pos l ho h2 hm hc
  · simpa [K2,ThreeByThree.symm] using h2.det_nonneg
  · intro hd
    have hd' : (K2 l).det=0 := by simpa [K2,ThreeByThree.symm] using hd
    refine ⟨active2 l,active2_nonzero l hd' (K2_leading_minor_pos l ho h2 hm hc),?_⟩
    intro t
    change K2 (l+t • v) *ᵥ active2 l=0
    rw [K2_affine,Matrix.add_mulVec,Matrix.smul_mulVec,active2_kernel,hv,smul_zero,add_zero]
theorem spectral_radius (l : Fin 9 → ℝ) (ho : Antitone l) (hn : ∀ i,0≤l i)
    (hs : ∑ i,l i=1) (h1 : (K1 l).PosSemidef) (h2 : (K2 l).PosSemidef)
    (hk : 7≤(Set.range l).ncard) :
    ∃ v : Fin 9 → ℝ, v≠0 ∧ ∃ r : ℝ, 0<r ∧ ∀ t, |t|<r →
      Antitone (l+t • v) ∧ (∀ i,0≤(l+t • v) i) ∧ (∑ i,(l+t • v) i=1) ∧
        (K1 (l+t • v)).PosSemidef ∧ (K2 (l+t • v)).PosSemidef := by
  have hm := D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.Boundary.positive_minimum_of_seven_levels l ho hn h1 hk
  have hc := strict_upper_gap l ho hk
  obtain ⟨v,hvz,hvs,hv1,hv2,hvb⟩ := active_perturbation l ho hk
  have he : ∀ᶠ t in 𝓝 (0 : ℝ), Antitone (l+t • v) ∧ (∀ i,0≤(l+t • v) i) ∧
      (K1 (l+t • v)).PosSemidef ∧ (K2 (l+t • v)).PosSemidef := by
    filter_upwards [eventually_order l v ho hvb,eventually_positive l v ho hm,
      K1_eventually_psd l v ho h1 hm hc hv1,K2_eventually_psd l v ho h2 hm hc hv2] with t htO htN ht1 ht2
    exact ⟨htO,fun i=>(htN i).le,ht1,ht2⟩
  obtain ⟨r,hr,hR⟩ := radius_of_eventually he
  refine ⟨v,hvz,r,hr,?_⟩
  intro t ht
  obtain ⟨htO,htN,ht1,ht2⟩ := hR t ht
  refine ⟨htO,htN,?_,ht1,ht2⟩
  simp only [Pi.add_apply,Pi.smul_apply,smul_eq_mul,Finset.sum_add_distrib,
    ←Finset.mul_sum,hs,hvs,mul_zero,add_zero]
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralFeasiblePerturbation.FeasiblePerturbation
