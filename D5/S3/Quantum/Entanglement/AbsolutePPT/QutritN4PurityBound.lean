  have ht_A2_9 : 0 ≤ gap l 8 * (A2_9 * K2 l).trace :=
    mul_nonneg (hy 8) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_9_psd h2)
  have ht_A2_10 : 0 ≤ gap l 9 * (A2_10 * K2 l).trace :=
    mul_nonneg (hy 9) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_10_psd h2)
  have ht_A2_11 : 0 ≤ gap l 10 * (A2_11 * K2 l).trace :=
    mul_nonneg (hy 10) (RHLinalg.trace_mul_nonneg_of_posSemidef A2_11_psd h2)
  have he := certificate_identity l
  rw [htrace] at he
  norm_num only [one_pow, mul_one] at he
  linarith only [he, hQ, hN, ht_A1_2, ht_A1_3, ht_A1_4, ht_A1_5, ht_A1_6, ht_A1_7, ht_A1_8, ht_A1_9, ht_A1_10, ht_A1_11, ht_A2_1, ht_A2_2, ht_A2_3, ht_A2_4, ht_A2_5, ht_A2_6, ht_A2_7, ht_A2_8, ht_A2_9, ht_A2_10, ht_A2_11]

theorem purity_bound
    (rho : Matrix (Fin 3 × Fin 4) (Fin 3 × Fin 4) ℂ)
    (hrho : rho.PosSemidef) (htrace : rho.trace = 1)
    (happt : QutritPerturbationAttainment.APPT rho) :
    (rho*rho).trace.re ≤ (20 : ℝ)/(14)^2 := by
  obtain ⟨l, ho, hn, ht, h1, h2, hp⟩ :=
    QutritSpectralReduction.spectral_reduction 1 rho hrho htrace happt
  rw [hp]
  exact certificate_bound l ho (hn 11) ht h1 h2

#print axioms purity_bound
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritN4PurityBound
