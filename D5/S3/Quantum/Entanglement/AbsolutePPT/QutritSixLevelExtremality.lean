private theorem bistochastic_equality_blocks {n : ℕ} (a b : Fin n → ℝ)
    (ha : StrictAnti a) (hb : Antitone b) (S : Matrix (Fin n) (Fin n) ℝ)
    (hS : S ∈ doublyStochastic ℝ (Fin n))
    (he : ∑ i, ∑ j, a i * S i j * b j = ∑ i, a i * b i) :
    ∀ i j, b i ≠ b j → S i j = 0 := by
  classical
  have hm : Monovary a b := ha.antitone.monovary_antitone hb
  obtain ⟨w,hw,hw1,hwS⟩ := exists_eq_sum_perm_of_mem_doublyStochastic hS
  have hlhs : ∑ i, ∑ j, a i * S i j * b j = ∑ i, a i * (S *ᵥ b) i := by
    simp only [Matrix.mulVec,dotProduct,mul_sum,mul_assoc]
  have hs : ∑ σ : Equiv.Perm (Fin n), w σ * ∑ i, a i * b (σ i) = ∑ i, a i * b i := by
    rw [hlhs,←hwS] at he
    simp only [sum_mulVec,smul_mulVec,permMatrix_mulVec,Finset.sum_apply,
      Pi.smul_apply,smul_eq_mul,Function.comp_apply,mul_sum] at he
    rw [sum_comm] at he
    convert he using 1
    apply sum_congr rfl
    intro σ hσ
    rw [mul_sum]
    apply sum_congr rfl
    intro i hi
    ring
  have hg : ∑ σ : Equiv.Perm (Fin n), w σ *
      ((∑ i, a i*b i) - ∑ i, a i*b (σ i)) = 0 := by
    simp only [mul_sub,sum_sub_distrib]
    rw [←sum_mul,hw1,one_mul,hs,sub_self]
  have hgn : ∀ σ : Equiv.Perm (Fin n), 0 ≤ w σ *
      ((∑ i, a i*b i) - ∑ i, a i*b (σ i)) := fun σ =>
    mul_nonneg (hw σ) (sub_nonneg.mpr (hm.sum_mul_comp_perm_le_sum_mul))
  have hp : ∀ σ : Equiv.Perm (Fin n), w σ ≠ 0 → b ∘ σ = b := by
    intro σ hn
