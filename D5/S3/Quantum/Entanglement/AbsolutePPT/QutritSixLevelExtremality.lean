      have hu : (U : Matrix J J ℂ)*(U : Matrix J J ℂ)ᴴ=1 := by
        simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_mul_star_self U
      rw [hu,Matrix.submatrix_one_equiv]⟩
