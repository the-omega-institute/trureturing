private theorem bistochastic_equality_blocks {n : ℕ} (a b : Fin n → ℝ)
    (ha : StrictAnti a) (hb : Antitone b) (S : Matrix (Fin n) (Fin n) ℝ)
    (hS : S ∈ doublyStochastic ℝ (Fin n))
    (he : ∑ i, ∑ j, a i * S i j * b j = ∑ i, a i * b i) :
    ∀ i j, b i ≠ b j → S i j = 0 := by
  classical
  have hm : Monovary a b := ha.antitone.monovary_antitone hb
  obtain ⟨w,hw,hw1,hwS⟩ := exists_eq_sum_perm_of_mem_doublyStochastic hS
  have hlhs : ∑ i, ∑ j, a i * S i j * b j = ∑ i, a i * (S *ᵥ b) i := by
    simp only [Matrix.mulVec,dotProduct,mul_sum,mul_assoc]
  have hs : ∑ σ : Equiv.Perm (Fin n), w σ * ∑ i, a i * b (σ i) = ∑ i, a i * b i := by
    rw [hlhs,←hwS] at he
    simp only [sum_mulVec,smul_mulVec,permMatrix_mulVec,Finset.sum_apply,
      Pi.smul_apply,smul_eq_mul,Function.comp_apply,mul_sum] at he
    rw [sum_comm] at he
    convert he using 1
    apply sum_congr rfl
    intro σ hσ
    rw [mul_sum]
    apply sum_congr rfl
    intro i hi
    ring
  have hg : ∑ σ : Equiv.Perm (Fin n), w σ *
      ((∑ i, a i*b i) - ∑ i, a i*b (σ i)) = 0 := by
    simp only [mul_sub,sum_sub_distrib]
    rw [←sum_mul,hw1,one_mul,hs,sub_self]
  have hgn : ∀ σ : Equiv.Perm (Fin n), 0 ≤ w σ *
      ((∑ i, a i*b i) - ∑ i, a i*b (σ i)) := fun σ =>
    mul_nonneg (hw σ) (sub_nonneg.mpr (hm.sum_mul_comp_perm_le_sum_mul))
  have hp : ∀ σ : Equiv.Perm (Fin n), w σ ≠ 0 → b ∘ σ = b := by
    intro σ hn
    have hzero := (Finset.sum_eq_zero_iff_of_nonneg (fun τ _ => hgn τ)).mp hg σ (mem_univ σ)
    have hval : ∑ i, a i*b (σ i) = ∑ i, a i*b i := by
      exact (sub_eq_zero.mp ((mul_eq_zero.mp hzero).resolve_left hn)).symm
    have hmσ := (hm.sum_mul_comp_perm_eq_sum_mul_iff (σ := σ)).mp hval
    have hanti : Antitone (b ∘ σ) := by
      intro i j hij
      rcases hij.eq_or_lt with heq | hlt
      · exact heq ▸ le_rfl
      · exact hmσ.symm (ha hlt)
    simpa using (Tuple.unique_antitone (σ := σ) (τ := Equiv.refl _) hanti hb)
  intro i j hij
  rw [←hwS]
  simp only [Matrix.sum_apply,Matrix.smul_apply,smul_eq_mul]
  apply sum_eq_zero
  intro σ hσ
  by_cases hz : w σ = 0
  · simp [hz]
  · have hne : σ i ≠ j := by
      intro heij
      have hbi := congrFun (hp σ hz) i
      exact hij (hbi.symm.trans (congrArg b heij))
    simp [Equiv.Perm.permMatrix, Equiv.toPEquiv_apply, hne]
private theorem aligned_of_trace_equality {n : ℕ} (w l : Fin n → ℝ)
    (hw : StrictMono w) (hl : Antitone l) (U : unitaryGroup (Fin n) ℂ)
    (he : ((diagonal (fun i => (w i : ℂ))) *
      ((U : Matrix (Fin n) (Fin n) ℂ) * diagonal (fun i => (l i : ℂ)) *
        (U : Matrix (Fin n) (Fin n) ℂ)ᴴ)).trace.re = ∑ i, w i*l i) :
    (U : Matrix (Fin n) (Fin n) ℂ) * diagonal (fun i => (l i : ℂ)) *
      (U : Matrix (Fin n) (Fin n) ℂ)ᴴ = diagonal (fun i => (l i : ℂ)) := by
  rw [D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.TraceBridge.trace_diagonal_conjugate] at he
  have ha : StrictAnti (fun i => -w i) := fun i j hij => neg_lt_neg (hw hij)
  have he' : ∑ i, ∑ j, (-w i) * RHLinalg.normSqMatrix (U : Matrix (Fin n) (Fin n) ℂ) i j * l j =
      ∑ i, (-w i)*l i := by
    simpa only [neg_mul,Finset.sum_neg_distrib] using congrArg Neg.neg he
  have hb := bistochastic_equality_blocks (fun i => -w i) l ha hl
    (RHLinalg.normSqMatrix (U : Matrix (Fin n) (Fin n) ℂ))
    (RHLinalg.normSqMatrix_mem_doublyStochastic_of_unitary U.property) he'
  have hc : (U : Matrix (Fin n) (Fin n) ℂ) * diagonal (fun i => (l i : ℂ)) =
      diagonal (fun i => (l i : ℂ)) * (U : Matrix (Fin n) (Fin n) ℂ) := by
    ext i j
    rw [mul_diagonal,diagonal_mul]
    by_cases hij : l i = l j
    · rw [hij,mul_comm]
    · have hz : (U : Matrix (Fin n) (Fin n) ℂ) i j = 0 := by
        apply norm_eq_zero.mp
        apply sq_eq_zero_iff.mp
        exact hb i j hij
      simp [hz]
  rw [hc,Matrix.mul_assoc]
  have hu : (U : Matrix (Fin n) (Fin n) ℂ)*(U : Matrix (Fin n) (Fin n) ℂ)ᴴ = 1 := by
    simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_mul_star_self U
  rw [hu,Matrix.mul_one]
private theorem aligned_of_trace_equality_reindex {J : Type} [Fintype J] [DecidableEq J] {n : ℕ}
    (e : J ≃ Fin n) (w l : Fin n → ℝ) (hw : StrictMono w) (hl : Antitone l)
    (U : unitaryGroup J ℂ)
    (he : ((diagonal (fun i => (w (e i) : ℂ))) *
      ((U : Matrix J J ℂ) * diagonal (fun i => (l (e i) : ℂ)) *
        (U : Matrix J J ℂ)ᴴ)).trace.re = ∑ i, w i*l i) :
    (U : Matrix J J ℂ) * diagonal (fun i => (l (e i) : ℂ)) *
      (U : Matrix J J ℂ)ᴴ = diagonal (fun i => (l (e i) : ℂ)) := by
  let U' : unitaryGroup (Fin n) ℂ :=
    ⟨(U : Matrix J J ℂ).submatrix e.symm e.symm, by
      rw [mem_unitaryGroup_iff]
