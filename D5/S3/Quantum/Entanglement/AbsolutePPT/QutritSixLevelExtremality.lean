open D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSpectralReduction
private def levels0Rat : Fin 9 → ℚ := fun i => if i=0 then 318 else if i=1 then 312 else if i=2 then 200
  else if i=3 then 169 else if i=4 then 148 else if i=5 then 148 else 130
private noncomputable def levels0 : Fin 9 → ℝ := fun i => (levels0Rat i : ℝ) / 1685
private noncomputable def kernel1 : Fin 3 → ℝ := fun i => if i=0 then 13 else if i=1 then 11 else 8
private noncomputable def kernel2 : Fin 3 → ℝ := fun i => if i=0 then 52 else if i=1 then 39 else 34
private def A1 : Matrix (Fin 3) (Fin 3) ℚ := !![260,-188,-164;-188,260,-52;-164,-52,338]
private def A2 : Matrix (Fin 3) (Fin 3) ℚ := !![260,-188,-182;-188,296,-52;-182,-52,338]
private def L1 : Matrix (Fin 3) (Fin 3) ℚ := !![1,0,0;-47/65,1,0;-41/65,-11/8,1]
private def L2 : Matrix (Fin 3) (Fin 3) ℚ := !![1,0,0;-47/65,1,0;-7/10,-39/34,1]
private def pivots1 : Fin 3 → ℚ := ![260,8064/65,0]
private def pivots2 : Fin 3 → ℚ := ![260,10404/65,0]
private theorem A1_ldl : A1 = L1 * diagonal pivots1 * L1.transpose := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, A1,L1,pivots1, Matrix.mul_apply, Matrix.diagonal, Fin.sum_univ_three]
private theorem A2_ldl : A2 = L2 * diagonal pivots2 * L2.transpose := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, A2,L2,pivots2, Matrix.mul_apply, Matrix.diagonal, Fin.sum_univ_three]
private theorem K1_levels0 : K1 levels0 = (1/1685 : ℝ) • castMat A1 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, K1,levels0,levels0Rat,castMat,A1]
private theorem K2_levels0 : K2 levels0 = (1/1685 : ℝ) • castMat A2 := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, K2,levels0,levels0Rat,castMat,A2]
private theorem K1_levels0_psd : (K1 levels0).PosSemidef := by
  rw [K1_levels0]
  exact (psd_of_rat_ldl A1 L1 pivots1 A1_ldl (by
    intro i; fin_cases i <;> norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, pivots1])).smul (by norm_num)
private theorem K2_levels0_psd : (K2 levels0).PosSemidef := by
  rw [K2_levels0]
  exact (psd_of_rat_ldl A2 L2 pivots2 A2_ldl (by
    intro i; fin_cases i <;> norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, pivots2])).smul (by norm_num)
private theorem K1_levels0_kernel : K1 levels0 *ᵥ kernel1 = 0 := by
  ext i
  fin_cases i <;> norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, K1,levels0,levels0Rat,kernel1,Matrix.mulVec,dotProduct,
    Fin.sum_univ_succ]
private theorem K2_levels0_kernel : K2 levels0 *ᵥ kernel2 = 0 := by
  ext i
  fin_cases i <;> norm_num (config := { decide := true }) [-Fin.val_eq_zero_iff, Fin.reduceEq, Fin.reduceFinMk, Matrix.vecHead, Matrix.vecTail,  Matrix.of_apply, Matrix.transpose_apply, K2,levels0,levels0Rat,kernel2,Matrix.mulVec,dotProduct,
    Fin.sum_univ_succ]
private noncomputable def weights : Fin 9 → ℝ := ![-286,-208,-176,128,176,208,242,286,338]
private theorem supporting_pencil_identity (l : Fin 9 → ℝ) :
    ∑ i, weights i * l i = kernel1 ⬝ᵥ (K1 l *ᵥ kernel1) := by
  simp [weights, kernel1, K1, dotProduct, Matrix.mulVec, Fin.sum_univ_succ]
  ring
private theorem supporting_spectral_nonneg (l : Fin 9 → ℝ) (h : (K1 l).PosSemidef) :
    0 ≤ ∑ i, weights i * l i := by
  rw [supporting_pencil_identity]
  simpa using h.dotProduct_mulVec_nonneg kernel1
