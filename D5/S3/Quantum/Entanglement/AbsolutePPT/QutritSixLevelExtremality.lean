    simpa [Matrix.star_eq_conjTranspose] using Unitary.coe_mul_star_self U
  rw [hu,Matrix.mul_one]
private theorem aligned_of_trace_equality_reindex {J : Type} [Fintype J] [DecidableEq J] {n : ℕ}
    (e : J ≃ Fin n) (w l : Fin n → ℝ) (hw : StrictMono w) (hl : Antitone l)
    (U : unitaryGroup J ℂ)
    (he : ((diagonal (fun i => (w (e i) : ℂ))) *
      ((U : Matrix J J ℂ) * diagonal (fun i => (l (e i) : ℂ)) *
        (U : Matrix J J ℂ)ᴴ)).trace.re = ∑ i, w i*l i) :
    (U : Matrix J J ℂ) * diagonal (fun i => (l (e i) : ℂ)) *
      (U : Matrix J J ℂ)ᴴ = diagonal (fun i => (l (e i) : ℂ)) := by
