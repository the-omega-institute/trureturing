      (U : Matrix J J ℂ)ᴴ).submatrix e.symm e.symm) =
      (U' : Matrix (Fin n) (Fin n) ℂ) * diagonal (fun i => (l i : ℂ)) *
        (U' : Matrix (Fin n) (Fin n) ℂ)ᴴ := by
    change _ = ((U : Matrix J J ℂ).submatrix e.symm e.symm *
      diagonal (fun i => (l i : ℂ))) * ((U : Matrix J J ℂ).submatrix e.symm e.symm)ᴴ
    rw [←hd l,Matrix.conjTranspose_submatrix,submatrix_mul_equiv,submatrix_mul_equiv]
  have ht : ((diagonal (fun i => (w i : ℂ))) *
      ((U' : Matrix (Fin n) (Fin n) ℂ) * diagonal (fun i => (l i : ℂ)) *
        (U' : Matrix (Fin n) (Fin n) ℂ)ᴴ)).trace =
      ((diagonal (fun i => (w (e i) : ℂ))) *
      ((U : Matrix J J ℂ) * diagonal (fun i => (l (e i) : ℂ)) *
        (U : Matrix J J ℂ)ᴴ)).trace := by
    rw [←hA,←hd w,submatrix_mul_equiv]
    simpa only [Matrix.trace,Matrix.diag_apply,Matrix.submatrix_apply] using
      e.symm.sum_comp (fun i => ((diagonal (fun i => (w (e i) : ℂ))) *
        ((U : Matrix J J ℂ) * diagonal (fun i => (l (e i) : ℂ)) *
          (U : Matrix J J ℂ)ᴴ)) i i)
  have he' := aligned_of_trace_equality w l hw hl U' (by rw [ht]; exact he)
  rw [←hA,←hd l] at he'
  ext i j
  have hh := congrFun (congrFun he' (e i)) (e j)
  simpa using hh
end D5.S3.Quantum.Entanglement.AbsolutePPT.QutritSixLevelExtremality.RearrangementEquality
