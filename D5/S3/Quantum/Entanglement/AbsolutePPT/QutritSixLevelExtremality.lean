      ((U : Matrix (Fin n) (Fin n) ℂ) * diagonal (fun i => (l i : ℂ)) *
        (U : Matrix (Fin n) (Fin n) ℂ)ᴴ)).trace.re = ∑ i, w i*l i) :
    (U : Matrix (Fin n) (Fin n) ℂ) * diagonal (fun i => (l i : ℂ)) *
      (U : Matrix (Fin n) (Fin n) ℂ)ᴴ = diagonal (fun i => (l i : ℂ)) := by
  rw [D5.S3.Quantum.Entanglement.AbsolutePPT.QutritHildebrandSufficiency.TraceBridge.trace_diagonal_conjugate] at he
