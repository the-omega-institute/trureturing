private theorem support_linear (a b : ℝ) (rho sigma : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ) :
    (W*(a • rho+b • sigma)).trace.re = a*(W*rho).trace.re+b*(W*sigma).trace.re := by
  simp [Matrix.mul_add,Matrix.mul_smul,Matrix.trace_add,Matrix.trace_smul]
private theorem rho0_decomposition_trivial (rho sigma : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ)
    (hr : rho ∈ ({rho | rho.PosSemidef ∧ rho.trace = 1 ∧ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritPerturbationAttainment.APPT rho})) (hs : sigma ∈ ({rho | rho.PosSemidef ∧ rho.trace = 1 ∧ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritPerturbationAttainment.APPT rho}))
    (a b : ℝ) (ha : 0 < a) (hb : 0 < b) (hab : a+b=1)
    (he : a • rho+b • sigma=rho0) : rho=rho0 := by
  have hrn := trace_support_nonneg rho hr
  have hsn := trace_support_nonneg sigma hs
  have he0 := congrArg (fun A : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ => (W*A).trace.re) he
  rw [support_linear,rho0_support_zero] at he0
  have harn := mul_nonneg ha.le hrn
  have hbsn := mul_nonneg hb.le hsn
  have hrz : (W*rho).trace.re=0 := by
    have hz : a*(W*rho).trace.re=0 := by linarith
    exact (mul_eq_zero.mp hz).resolve_left (ne_of_gt ha)
  have hsz : (W*sigma).trace.re=0 := by
    have hz : b*(W*sigma).trace.re=0 := by linarith
    exact (mul_eq_zero.mp hz).resolve_left (ne_of_gt hb)
  let l := (fun i : Fin 9 => hr.1.isHermitian.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i))
  let m := (fun i : Fin 9 => hs.1.isHermitian.eigenvalues₀ (Fin.cast (by simp [Fintype.card_prod]) i))
  have hrl : rho=diagonal (fun i => (l ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) := trace_support_zero_diagonal rho hr hrz
  have hsl : sigma=diagonal (fun i => (m ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) := trace_support_zero_diagonal sigma hs hsz
  have he' : a • diagonal (fun i : (Fin 3 × Fin 3) => (l ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) +
      b • diagonal (fun i : (Fin 3 × Fin 3) => (m ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9) i) : ℂ)) =rho0 :=
    (congrArg₂ (fun A B : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ => a • A+b • B) hrl.symm hsl.symm).trans he
  have hlevels : levels0=a • l+b • m := by
    funext i
    have hh := congrArg Complex.re (congrFun (congrFun he' ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9).symm i)) ((finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9).symm i))
    simpa [rho0,Matrix.smul_apply,Matrix.add_apply] using hh.symm
  have hl : Antitone l := sorted_eigenvalues_antitone (by simp [Fintype.card_prod]) _ _
  have hm : Antitone m := sorted_eigenvalues_antitone (by simp [Fintype.card_prod]) _ _
  have h45 : l 4=l 5 := repeated_level_inherited a b l m levels0 ha hb.le hl hm hlevels
    4 5 (by decide) (by norm_num (config := {decide := true}) [-Fin.val_eq_zero_iff,levels0,levels0Rat,Fin.reduceFinMk,Fin.reduceEq])
  have h67 : l 6=l 7 := repeated_level_inherited a b l m levels0 ha hb.le hl hm hlevels
    6 7 (by decide) (by norm_num (config := {decide := true}) [-Fin.val_eq_zero_iff,levels0,levels0Rat,Fin.reduceFinMk,Fin.reduceEq])
  have h78 : l 7=l 8 := repeated_level_inherited a b l m levels0 ha hb.le hl hm hlevels
    7 8 (by decide) (by norm_num (config := {decide := true}) [-Fin.val_eq_zero_iff,levels0,levels0Rat,Fin.reduceFinMk,Fin.reduceEq])
  have hp := trace_support_zero_kernel rho hr hrz
  have hk := (hildebrand_criterion rho hr.1 hr.2.1).mp hr.2.2
  have hk' := (hildebrand_criterion sigma hs.1 hs.2.1).mp hs.2.2
  have hK2 : K2 levels0=a • K2 l+b • K2 m := by rw [hlevels,K2_linear]
  have hq : K2 l *ᵥ kernel2=0 := kernel_inherited _ _ _ hk.2 hk'.2 a b ha hb.le hK2
    kernel2 K2_levels0_kernel
  have hsum : ∑ i, l i=1 := by
    have htr := congrArg Complex.re hr.2.1
    have hdtr : rho.trace.re = ∑ i, l i := by
      conv_lhs => rw [hrl]
      rw [Matrix.trace_diagonal,Complex.re_sum]
      simp only [Complex.ofReal_re]
      exact (finProdFinEquiv : (Fin 3 × Fin 3) ≃ Fin 9).sum_comp l
    rw [hdtr] at htr
    simpa using htr
  have huniq := levels_unique l hp hq h45 h67 h78 hsum
  calc
    rho = _ := hrl
    _ = rho0 := by rw [huniq]; rfl
private theorem rho0_extreme : rho0 ∈ Set.extremePoints ℝ ({rho | rho.PosSemidef ∧ rho.trace = 1 ∧ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritPerturbationAttainment.APPT rho}) := by
  refine ⟨rho0_mem,?_⟩
  intro rho hr sigma hs hopen
  obtain ⟨a,b,ha,hb,hab,he⟩ := hopen
  exact rho0_decomposition_trivial rho sigma hr hs a b ha hb hab he
theorem six_level_attainment :
    ∃ rho : Matrix (Fin 3 × Fin 3) (Fin 3 × Fin 3) ℂ, rho ∈ Set.extremePoints ℝ ({rho | rho.PosSemidef ∧ rho.trace = 1 ∧ D5.S3.Quantum.Entanglement.AbsolutePPT.QutritPerturbationAttainment.APPT rho}) ∧ (spectrum ℂ rho).ncard=6 :=
  ⟨rho0,rho0_extreme,rho0_spectrum_six⟩
