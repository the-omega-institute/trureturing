open scoped ComplexOrder ComplexStarModule InnerProductSpace Matrix TensorProduct

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Quantum.Entanglement.BipartiteSectorDecomposition

open D5.S3.Quantum.Measurement.BasisMeasurementProjection

variable {m n : Nat}

local instance matrixNormedAddCommGroup (d : Nat) :
    NormedAddCommGroup (Matrix (Fin d) (Fin d) ℂ) :=
  Matrix.toMatrixNormedAddCommGroup 1 Matrix.PosDef.one

local instance matrixComplexInnerProductSpace (d : Nat) :
    InnerProductSpace ℂ (Matrix (Fin d) (Fin d) ℂ) :=
  Matrix.toMatrixInnerProductSpace 1 Matrix.PosSemidef.one

local instance matrixRealInnerProductSpace (d : Nat) :
    InnerProductSpace ℝ (Matrix (Fin d) (Fin d) ℂ) :=
  InnerProductSpace.rclikeToReal ℂ (Matrix (Fin d) (Fin d) ℂ)

/-- The identity operator, as a vector in the real Hermitian Hilbert space. -/
def identityHermitian (d : Nat) : HermitianSpace d :=
  ⟨1, by
    change (1 : Matrix (Fin d) (Fin d) ℂ).IsHermitian
    exact Matrix.isHermitian_one⟩

/-- The one-dimensional real scalar-identity sector of a Hermitian factor. -/
def scalarHermitian (d : Nat) : Submodule ℝ (HermitianSpace d) :=
  ℝ ∙ identityHermitian d

/-- The real Hilbert tensor model of Hermitian operators on a bipartite system. -/
abbrev BipartiteHermitian (m n : Nat) :=
  HermitianSpace m ⊗[ℝ] HermitianSpace n

/-- The image of the tensor product of two Hermitian subspaces in the full tensor space. -/
def tensorSector (P : Submodule ℝ (HermitianSpace m))
    (Q : Submodule ℝ (HermitianSpace n)) :
    Submodule ℝ (BipartiteHermitian m n) :=
  LinearMap.range (TensorProduct.mapIncl P Q)

/-- Traceless operators on `A`, tensored with the scalar identity on `B`. -/
def localASector (m n : Nat) : Submodule ℝ (BipartiteHermitian m n) :=
  tensorSector (traceZeroHermitian m) (scalarHermitian n)

/-- The scalar identity on `A`, tensored with traceless operators on `B`. -/
def localBSector (m n : Nat) : Submodule ℝ (BipartiteHermitian m n) :=
  tensorSector (scalarHermitian m) (traceZeroHermitian n)

/-- The genuine correlation sector, traceless in both tensor factors. -/
def correlationSector (m n : Nat) : Submodule ℝ (BipartiteHermitian m n) :=
  tensorSector (traceZeroHermitian m) (traceZeroHermitian n)

/-- The scalar-scalar line generated by `I_A ⊗ I_B`. -/
def scalarSector (m n : Nat) : Submodule ℝ (BipartiteHermitian m n) :=
  tensorSector (scalarHermitian m) (scalarHermitian n)

/-- The traceless bipartite Hermitian space is the HS-orthogonal complement of `I_A ⊗ I_B`. -/
def bipartiteTraceZero (m n : Nat) : Submodule ℝ (BipartiteHermitian m n) :=
  (scalarSector m n : Submodule ℝ (BipartiteHermitian m n))ᗮ

/-- A complex matrix is uniquely its Hermitian real part plus `i` times its Hermitian
imaginary part. -/
private noncomputable def matrixHermitianPairEquiv (d : Nat) :
    Matrix (Fin d) (Fin d) ℂ ≃ₗ[ℝ] HermitianSpace d × HermitianSpace d where
  toFun A := (ℜ A, ℑ A)
  invFun A := (A.1.1 : Matrix (Fin d) (Fin d) ℂ) + Complex.I • A.2.1
  left_inv A := realPart_add_I_smul_imaginaryPart A
  right_inv A := by
    apply Prod.ext
    · apply Subtype.ext
      ext i j
      change
        (ℜ ((A.1 : Matrix (Fin d) (Fin d) ℂ) +
          Complex.I • (A.2 : Matrix (Fin d) (Fin d) ℂ)) :
          Matrix (Fin d) (Fin d) ℂ) i j = (A.1 : Matrix (Fin d) (Fin d) ℂ) i j
      rw [(realPart (A := Matrix (Fin d) (Fin d) ℂ)).map_add,
        realPart_smul]
      simp [A.1.2.coe_realPart, congrArg Subtype.val A.2.2.imaginaryPart]
    · apply Subtype.ext
      ext i j
      change
        (ℑ ((A.1 : Matrix (Fin d) (Fin d) ℂ) +
          Complex.I • (A.2 : Matrix (Fin d) (Fin d) ℂ)) :
          Matrix (Fin d) (Fin d) ℂ) i j = (A.2 : Matrix (Fin d) (Fin d) ℂ) i j
      rw [(imaginaryPart (A := Matrix (Fin d) (Fin d) ℂ)).map_add,
        imaginaryPart_smul]
      simp [A.1.2.imaginaryPart, A.2.2.coe_realPart]
  map_add' A B := by
    apply Prod.ext
    · exact (realPart (A := Matrix (Fin d) (Fin d) ℂ)).map_add A B
    · exact (imaginaryPart (A := Matrix (Fin d) (Fin d) ℂ)).map_add A B
  map_smul' r A := by
    apply Prod.ext
    · exact (realPart (A := Matrix (Fin d) (Fin d) ℂ)).map_smul r A
    · exact (imaginaryPart (A := Matrix (Fin d) (Fin d) ℂ)).map_smul r A

/-- Hermitian `d × d` matrices have real dimension `d²`. -/
theorem hermitian_space_finrank (d : Nat) :
    Module.finrank ℝ (HermitianSpace d) = d ^ 2 := by
  have hdim := (matrixHermitianPairEquiv d).finrank_eq
  simp only [Module.finrank_matrix, Fintype.card_fin, Complex.finrank_real_complex,
    Module.finrank_prod] at hdim
  have hcancel : Module.finrank ℝ (HermitianSpace d) * 2 = d ^ 2 * 2 := by
    calc
      Module.finrank ℝ (HermitianSpace d) * 2 =
          Module.finrank ℝ (HermitianSpace d) +
            Module.finrank ℝ (HermitianSpace d) := by omega
      _ = d * d * 2 := hdim.symm
      _ = d ^ 2 * 2 := by ring
  exact Nat.eq_of_mul_eq_mul_right (by norm_num) hcancel

private theorem identityHermitian_ne_zero (d : Nat) [NeZero d] :
    identityHermitian d ≠ 0 := by
  intro h
  have hval : (1 : Matrix (Fin d) (Fin d) ℂ) = 0 := congrArg Subtype.val h
  exact one_ne_zero hval

private theorem hermitian_trace_eq_re {d : Nat} (A : HermitianSpace d) :
    Matrix.trace A.1 = ((Matrix.trace A.1).re : ℂ) := by
  have hAstar := A.2
  change star A.1 = A.1 at hAstar
  have hA : A.1ᴴ = A.1 := by
    simpa only [Matrix.star_eq_conjTranspose] using hAstar
  have hstar : star (Matrix.trace A.1) = Matrix.trace A.1 := by
    calc
      star (Matrix.trace A.1) = Matrix.trace A.1ᴴ :=
        (Matrix.trace_conjTranspose A.1).symm
      _ = Matrix.trace A.1 := by rw [hA]
  exact (Complex.conj_eq_iff_re.mp hstar).symm

private theorem hermitian_inner_identity {d : Nat} (A : HermitianSpace d) :
    inner ℝ A (identityHermitian d) = (Matrix.trace A.1).re := by
  have hAstar := A.2
  change star A.1 = A.1 at hAstar
  have hA : A.1ᴴ = A.1 := by
    simpa only [Matrix.star_eq_conjTranspose] using hAstar
  change (Matrix.trace ((1 : Matrix (Fin d) (Fin d) ℂ) * 1 * A.1ᴴ)).re = _
  rw [one_mul, one_mul, hA]

private theorem traceZeroHermitian_eq_orthogonal (d : Nat) :
    traceZeroHermitian d = (scalarHermitian d)ᗮ := by
  ext A
  change Matrix.trace A.1 = 0 ↔ A ∈ (scalarHermitian d)ᗮ
  rw [scalarHermitian, Submodule.mem_orthogonal_singleton_iff_inner_left,
    hermitian_inner_identity]
  constructor
  · intro h
    rw [h]
    rfl
  · intro h
    rw [hermitian_trace_eq_re A, h]
    rfl

/-- Traceless Hermitian `d × d` matrices have real dimension `d² - 1`. -/
theorem trace_zero_hermitian_finrank (d : Nat) [NeZero d] :
    Module.finrank ℝ (traceZeroHermitian d) = d ^ 2 - 1 := by
  rw [traceZeroHermitian_eq_orthogonal]
  have hdim := (scalarHermitian d).finrank_add_finrank_orthogonal
  have hline : Module.finrank ℝ (scalarHermitian d) = 1 := by
    exact finrank_span_singleton (identityHermitian_ne_zero d)
  rw [hline, hermitian_space_finrank] at hdim
  omega

/-- The three sector dimensions add to the dimension of all traceless bipartite operators. -/
theorem sector_dimension_sum (m n : Nat) [NeZero m] [NeZero n] :
    (m ^ 2 - 1) + (n ^ 2 - 1) + (m ^ 2 - 1) * (n ^ 2 - 1) =
      (m * n) ^ 2 - 1 := by
  have hm : (m ^ 2 - 1) + 1 = m ^ 2 :=
    Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (pow_ne_zero 2 (NeZero.ne m)))
  have hn : (n ^ 2 - 1) + 1 = n ^ 2 :=
    Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr (pow_ne_zero 2 (NeZero.ne n)))
  have hproduct :
      ((m ^ 2 - 1) + 1) * ((n ^ 2 - 1) + 1) =
        (m ^ 2 - 1) + (n ^ 2 - 1) + (m ^ 2 - 1) * (n ^ 2 - 1) + 1 := by
    ring
  rw [hm, hn] at hproduct
  have hpow : (m * n) ^ 2 = m ^ 2 * n ^ 2 := by ring
  omega

private theorem scalarHermitian_finrank (d : Nat) [NeZero d] :
    Module.finrank ℝ (scalarHermitian d) = 1 :=
  finrank_span_singleton (identityHermitian_ne_zero d)

private theorem tensorSector_finrank
    (P : Submodule ℝ (HermitianSpace m)) (Q : Submodule ℝ (HermitianSpace n)) :
    Module.finrank ℝ (tensorSector P Q) =
      Module.finrank ℝ P * Module.finrank ℝ Q := by
  rw [tensorSector, LinearMap.finrank_range_of_inj]
  · exact Module.finrank_tensorProduct
  · exact (TensorProduct.mapInclIsometry P Q).injective

private theorem tensorSector_isOrtho_of_left
    {P P' : Submodule ℝ (HermitianSpace m)}
    {Q Q' : Submodule ℝ (HermitianSpace n)} (h : P ⟂ P') :
    tensorSector P Q ⟂ tensorSector P' Q' := by
  rintro _ ⟨x, rfl⟩
  rw [Submodule.mem_orthogonal]
  rintro _ ⟨y, rfl⟩
  refine x.induction_on (by simp) (fun p q ↦ ?_) (fun u v hu hv ↦ ?_)
  · refine y.induction_on (by simp) (fun p' q' ↦ ?_) (fun u v hu hv ↦ ?_)
    · simp only [TensorProduct.map_tmul, TensorProduct.inner_tmul, Submodule.coe_subtype]
      rw [Submodule.inner_right_of_mem_orthogonal p'.2 (h p.2), zero_mul]
    · simp only [map_add, inner_add_left, hu, hv, add_zero]
  · simp only [map_add, inner_add_right, hu, hv, add_zero]

private theorem tensorSector_isOrtho_of_right
    {P P' : Submodule ℝ (HermitianSpace m)}
    {Q Q' : Submodule ℝ (HermitianSpace n)} (h : Q ⟂ Q') :
    tensorSector P Q ⟂ tensorSector P' Q' := by
  rintro _ ⟨x, rfl⟩
  rw [Submodule.mem_orthogonal]
  rintro _ ⟨y, rfl⟩
  refine x.induction_on (by simp) (fun p q ↦ ?_) (fun u v hu hv ↦ ?_)
  · refine y.induction_on (by simp) (fun p' q' ↦ ?_) (fun u v hu hv ↦ ?_)
    · simp only [TensorProduct.map_tmul, TensorProduct.inner_tmul, Submodule.coe_subtype]
      rw [Submodule.inner_right_of_mem_orthogonal q'.2 (h q.2), mul_zero]
    · simp only [map_add, inner_add_left, hu, hv, add_zero]
  · simp only [map_add, inner_add_right, hu, hv, add_zero]

private theorem scalarHermitian_isOrtho_traceZeroHermitian (d : Nat) :
    scalarHermitian d ⟂ traceZeroHermitian d := by
  rw [traceZeroHermitian_eq_orthogonal]
  exact Submodule.isOrtho_orthogonal_right _

/-- The bipartite traceless Hermitian space is exactly the orthogonal direct sum of the two
local sectors and the correlation sector, with the three expected dimensions. -/
theorem bipartite_sector_decomposition (m n : Nat) [NeZero m] [NeZero n] :
    localASector m n ⊔ localBSector m n ⊔ correlationSector m n =
        bipartiteTraceZero m n ∧
      (localASector m n ⟂ localBSector m n) ∧
      (localASector m n ⟂ correlationSector m n) ∧
      (localBSector m n ⟂ correlationSector m n) ∧
      Module.finrank ℝ (localASector m n) = m ^ 2 - 1 ∧
      Module.finrank ℝ (localBSector m n) = n ^ 2 - 1 ∧
      Module.finrank ℝ (correlationSector m n) =
        (m ^ 2 - 1) * (n ^ 2 - 1) := by
  have hAB : localASector m n ⟂ localBSector m n := by
    simpa [localASector, localBSector] using
      (tensorSector_isOrtho_of_left
        (P := traceZeroHermitian m) (P' := scalarHermitian m)
        (Q := scalarHermitian n) (Q' := traceZeroHermitian n)
        (scalarHermitian_isOrtho_traceZeroHermitian m).symm)
  have hAC : localASector m n ⟂ correlationSector m n := by
    simpa [localASector, correlationSector] using
      (tensorSector_isOrtho_of_right
        (P := traceZeroHermitian m) (P' := traceZeroHermitian m)
        (Q := scalarHermitian n) (Q' := traceZeroHermitian n)
        (scalarHermitian_isOrtho_traceZeroHermitian n))
  have hBC : localBSector m n ⟂ correlationSector m n := by
    simpa [localBSector, correlationSector] using
      (tensorSector_isOrtho_of_left
        (P := scalarHermitian m) (P' := traceZeroHermitian m)
        (Q := traceZeroHermitian n) (Q' := traceZeroHermitian n)
        (scalarHermitian_isOrtho_traceZeroHermitian m))
  have hAScalar : localASector m n ⟂ scalarSector m n := by
    simpa [localASector, scalarSector] using
      (tensorSector_isOrtho_of_left
        (P := traceZeroHermitian m) (P' := scalarHermitian m)
        (Q := scalarHermitian n) (Q' := scalarHermitian n)
        (scalarHermitian_isOrtho_traceZeroHermitian m).symm)
  have hBScalar : localBSector m n ⟂ scalarSector m n := by
    simpa [localBSector, scalarSector] using
      (tensorSector_isOrtho_of_right
        (P := scalarHermitian m) (P' := scalarHermitian m)
        (Q := traceZeroHermitian n) (Q' := scalarHermitian n)
        (scalarHermitian_isOrtho_traceZeroHermitian n).symm)
  have hCScalar : correlationSector m n ⟂ scalarSector m n := by
    simpa [correlationSector, scalarSector] using
      (tensorSector_isOrtho_of_left
        (P := traceZeroHermitian m) (P' := scalarHermitian m)
        (Q := traceZeroHermitian n) (Q' := scalarHermitian n)
        (scalarHermitian_isOrtho_traceZeroHermitian m).symm)
  have hle :
      localASector m n ⊔ localBSector m n ⊔ correlationSector m n ≤
        bipartiteTraceZero m n := by
    change localASector m n ⊔ localBSector m n ⊔ correlationSector m n ≤
      (scalarSector m n)ᗮ
    rw [← Submodule.isOrtho_iff_le, Submodule.isOrtho_sup_left,
      Submodule.isOrtho_sup_left]
    exact ⟨⟨hAScalar, hBScalar⟩, hCScalar⟩
  have hA : Module.finrank ℝ (localASector m n) = m ^ 2 - 1 := by
    change Module.finrank ℝ (tensorSector (traceZeroHermitian m) (scalarHermitian n)) = _
    rw [tensorSector_finrank, trace_zero_hermitian_finrank,
      scalarHermitian_finrank, mul_one]
  have hB : Module.finrank ℝ (localBSector m n) = n ^ 2 - 1 := by
    change Module.finrank ℝ (tensorSector (scalarHermitian m) (traceZeroHermitian n)) = _
    rw [tensorSector_finrank, trace_zero_hermitian_finrank,
      scalarHermitian_finrank, one_mul]
  have hC :
      Module.finrank ℝ (correlationSector m n) =
        (m ^ 2 - 1) * (n ^ 2 - 1) := by
    change Module.finrank ℝ
      (tensorSector (traceZeroHermitian m) (traceZeroHermitian n)) = _
    rw [tensorSector_finrank, trace_zero_hermitian_finrank,
      trace_zero_hermitian_finrank]
  have hScalar : Module.finrank ℝ (scalarSector m n) = 1 := by
    change Module.finrank ℝ (tensorSector (scalarHermitian m) (scalarHermitian n)) = _
    rw [tensorSector_finrank, scalarHermitian_finrank,
      scalarHermitian_finrank, one_mul]
  have hAmbient :
      Module.finrank ℝ (BipartiteHermitian m n) = (m * n) ^ 2 := by
    change Module.finrank ℝ (HermitianSpace m ⊗[ℝ] HermitianSpace n) = _
    rw [Module.finrank_tensorProduct, hermitian_space_finrank,
      hermitian_space_finrank]
    ring
  have hTrace :
      Module.finrank ℝ (bipartiteTraceZero m n) = (m * n) ^ 2 - 1 := by
    have hdim := (scalarSector m n).finrank_add_finrank_orthogonal
    rw [hScalar, hAmbient] at hdim
    change Module.finrank ℝ (scalarSector m n)ᗮ = (m * n) ^ 2 - 1
    omega
  have hABdim :
      Module.finrank ℝ ↥(localASector m n ⊔ localBSector m n) =
        Module.finrank ℝ (localASector m n) +
          Module.finrank ℝ (localBSector m n) := by
    have hdim := Submodule.finrank_sup_add_finrank_inf_eq
      (localASector m n) (localBSector m n)
    rw [hAB.disjoint.eq_bot, finrank_bot, add_zero] at hdim
    exact hdim
  have hSumC : localASector m n ⊔ localBSector m n ⟂ correlationSector m n := by
    rw [Submodule.isOrtho_sup_left]
    exact ⟨hAC, hBC⟩
  have hSumDim :
      Module.finrank ℝ
        ↥(localASector m n ⊔ localBSector m n ⊔ correlationSector m n) =
        (m * n) ^ 2 - 1 := by
    have hdim := Submodule.finrank_sup_add_finrank_inf_eq
      (localASector m n ⊔ localBSector m n) (correlationSector m n)
    rw [hSumC.disjoint.eq_bot, finrank_bot, add_zero, hABdim, hA, hB, hC] at hdim
    rw [hdim, sector_dimension_sum]
  have hdecomp := Submodule.eq_of_le_of_finrank_eq hle (hSumDim.trans hTrace.symm)
  exact ⟨hdecomp, hAB, hAC, hBC, hA, hB, hC⟩

example :
    Module.finrank ℝ (localASector 2 2) = 3 ∧
      Module.finrank ℝ (localBSector 2 2) = 3 ∧
      Module.finrank ℝ (correlationSector 2 2) = 9 := by
  rcases bipartite_sector_decomposition 2 2 with ⟨_, _, _, _, hA, hB, hC⟩
  norm_num at hA hB hC
  exact ⟨hA, hB, hC⟩

#print axioms bipartite_sector_decomposition

end D5.S3.Quantum.Entanglement.BipartiteSectorDecomposition
