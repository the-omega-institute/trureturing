/- GID: D5/S3/Quantum/Entanglement/MaskedCycles/StabilizerMaskedCycleRank
   generality: G
   mirror-B: D5/B/S3/Quantum/Entanglement/MaskedCycles/StabilizerMaskedCycleRank
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: [mathlib/module/Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots]
   utility: none
   digest: Character fibres give the exact support of stabilizer masked cycle matrices over the generated root field. -/
import Mathlib.FieldTheory.AlgebraicClosure
import Mathlib.FieldTheory.IntermediateField.Adjoin.Defs
import Mathlib.RingTheory.RootsOfUnity.PrimitiveRoots
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Mathlib.Combinatorics.SimpleGraph.AdjMatrix
import Mathlib.Order.Setoid.Partition
import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.Algebra.CharP.Two
import Mathlib.Tactic
import D5.S3.Combinatorics.Graph.Walks.WeightedPathCycleRank
import D5.S3.Combinatorics.Graph.Walks.WeightedVertexProducts
import D5.S3.Combinatorics.Graph.Walks.WeightedCycleWalk

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency.types false
namespace D5.S3.Quantum.Entanglement.MaskedCycles.StabilizerMaskedCycleRank
open scoped BigOperators Classical
open Matrix SimpleGraph
open D5.S3.Combinatorics.Graph.Walks
open D5.S3.Combinatorics.Graph.Walks.WeightedPathCycleRank
noncomputable section

abbrev F2 := ZMod 2
abbrev Closure := AlgebraicClosure F2

/-- The coefficient field is literally the intermediate field generated by zeta. -/
abbrev RootField (ζ : Closure) := IntermediateField.adjoin F2 ({ζ} : Set Closure)

def root (ζ : Closure) : RootField ζ :=
  ⟨ζ, IntermediateField.subset_adjoin F2 {ζ} (by simp)⟩

/-- The translation attached to the last party is zero. -/
def delta {n q : ℕ} (c : Fin q) : Fin (q - 1) → ZMod n :=
  fun i => if i.val = c.val then 1 else 0

/-- The original character-dot-translation readout. -/
def characterValue {n q : ℕ} (t : Fin (q - 1) → ZMod n) (c : Fin q) : ZMod n :=
  ∑ i, t i * delta c i

/-- The equivalence classes are exactly the nonempty character fibres. -/
def partyPartition {n q : ℕ} (t : Fin (q - 1) → ZMod n) : Setoid (Fin q) :=
  Setoid.ker (characterValue t)

/-- The actual partition into nonempty fibres, together with its partition law. -/
def fibrePartition {n q : ℕ} (t : Fin (q - 1) → ZMod n) :
    {B : Set (Set (Fin q)) // Setoid.IsPartition B} :=
  ⟨(partyPartition t).classes, (partyPartition t).isPartition_classes⟩

def lambda {n q : ℕ} (ζ : Closure) (t : Fin (q - 1) → ZMod n)
    {V : Type*} (col : V → Fin q) (u : V) : RootField ζ :=
  root ζ ^ (characterValue t (col u)).val

def Lambda {n q : ℕ} (ζ : Closure) (t : Fin (q - 1) → ZMod n)
    {V : Type*} [DecidableEq V] (col : V → Fin q) : Matrix V V (RootField ζ) :=
  Matrix.diagonal (lambda ζ t col)

def mask {n q : ℕ} {V : Type*} (Γ : Matrix V V F2) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) : Matrix V V F2 :=
  fun u v => if ∃ B ∈ (fibrePartition t).val, col u ∈ B ∧ col v ∈ B
    then 0 else Γ u v

def weightedMatrix {n q : ℕ} (ζ : Closure) {V : Type*} [Fintype V] [DecidableEq V]
    (Γ : Matrix V V F2) (col : V → Fin q) (t : Fin (q - 1) → ZMod n) :
    Matrix V V (RootField ζ) :=
  Lambda ζ t col * Γ.map (algebraMap F2 (RootField ζ)) +
    Γ.map (algebraMap F2 (RootField ζ)) * Lambda ζ t col

def maskedGraph {n q : ℕ} {V : Type*} (Γ : Matrix V V F2)
    (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) : SimpleGraph V where
  Adj u v := Γ u v ≠ 0 ∧ characterValue t (col u) ≠ characterValue t (col v)
  symm := ⟨fun u v h => ⟨by simpa [hs.apply u v] using h.1, Ne.symm h.2⟩⟩
  loopless := ⟨fun u h => h.1 (hd u)⟩

private theorem root_primitive {n : ℕ} (ζ : Closure) (hζ : IsPrimitiveRoot ζ n) :
    IsPrimitiveRoot (root ζ) n := by
  apply hζ.of_map_of_injective
    (f := (RootField ζ).subtype) (ζ := root ζ) (fun _ _ h => Subtype.ext h)

private theorem lambda_eq_iff {n q : ℕ} [NeZero n] (ζ : Closure)
    (hζ : IsPrimitiveRoot ζ n) {V : Type*} (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) (u v : V) :
    lambda ζ t col u = lambda ζ t col v ↔
      characterValue t (col u) = characterValue t (col v) := by
  constructor
  · intro h
    apply ZMod.val_injective
    exact (root_primitive ζ hζ).pow_inj (ZMod.val_lt _) (ZMod.val_lt _) h
  · intro h
    simp [lambda, h]

private theorem weighted_entry {n q : ℕ} (ζ : Closure) {V : Type*}
    [Fintype V] [DecidableEq V] (Γ : Matrix V V F2) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) (u v : V) :
    weightedMatrix ζ Γ col t u v = algebraMap F2 (RootField ζ) (Γ u v) *
      (lambda ζ t col u + lambda ζ t col v) := by
  simp [weightedMatrix, Lambda, Matrix.diagonal_mul, Matrix.mul_diagonal]
  ring

private theorem weighted_support {n q : ℕ} [NeZero n] (ζ : Closure)
    (hζ : IsPrimitiveRoot ζ n) {V : Type*} [Fintype V] [DecidableEq V]
    (Γ : Matrix V V F2) (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0)
    (col : V → Fin q) (t : Fin (q - 1) → ZMod n) (u v : V) :
    (maskedGraph Γ hs hd col t).Adj u v ↔ weightedMatrix ζ Γ col t u v ≠ 0 := by
  rw [weighted_entry, mul_ne_zero_iff]
  have hz : algebraMap F2 (RootField ζ) (Γ u v) ≠ 0 ↔ Γ u v ≠ 0 := by
    rw [map_ne_zero]
  rw [hz]
  simp only [ne_eq, CharTwo.add_eq_zero, lambda_eq_iff ζ hζ]
  rfl

private theorem weighted_symm {n q : ℕ} (ζ : Closure) {V : Type*}
    [Fintype V] [DecidableEq V] (Γ : Matrix V V F2) (hs : Γ.IsSymm)
    (col : V → Fin q) (t : Fin (q - 1) → ZMod n) :
    (weightedMatrix ζ Γ col t).IsSymm := by
  apply Matrix.IsSymm.ext
  intro u v
  simp only [weighted_entry]
  rw [hs.apply, add_comm]

private theorem mask_entry {n q : ℕ} {V : Type*} (Γ : Matrix V V F2)
    (col : V → Fin q) (t : Fin (q - 1) → ZMod n) (u v : V) :
    mask Γ col t u v = if characterValue t (col u) = characterValue t (col v)
      then 0 else Γ u v := by
  have h : (∃ B ∈ (fibrePartition t).val, col u ∈ B ∧ col v ∈ B) ↔
      characterValue t (col u) = characterValue t (col v) := by
    change (∃ B ∈ (partyPartition t).classes, col u ∈ B ∧ col v ∈ B) ↔ _
    rw [← Setoid.rel_iff_exists_classes]
    rfl
  exact if_congr h rfl rfl

private theorem mask_support {n q : ℕ} {V : Type*} (Γ : Matrix V V F2)
    (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) (u v : V) :
    (maskedGraph Γ hs hd col t).Adj u v ↔ mask Γ col t u v ≠ 0 := by
  simp only [mask_entry, maskedGraph]
  split_ifs <;> simp_all

private theorem weighted_on_edge {n q : ℕ} (ζ : Closure) {V : Type*}
    [Fintype V] [DecidableEq V] (Γ : Matrix V V F2)
    (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) {u v : V}
    (h : (maskedGraph Γ hs hd col t).Adj u v) :
    weightedMatrix ζ Γ col t u v = lambda ζ t col u + lambda ζ t col v := by
  have hb : ∀ x : F2, x = 0 ∨ x = 1 := by decide
  have hΓ : Γ u v = 1 := (hb (Γ u v)).resolve_left h.1
  simp [weighted_entry, hΓ]

private theorem mask_on_edge {n q : ℕ} {V : Type*} (Γ : Matrix V V F2)
    (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) {u v : V}
    (h : (maskedGraph Γ hs hd col t).Adj u v) : mask Γ col t u v = 1 := by
  have hb : ∀ x : F2, x = 0 ∨ x = 1 := by decide
  exact (hb _).resolve_left ((mask_support Γ hs hd col t u v).mp h)

private theorem component_rank_difference_products
    {n q : ℕ} [NeZero n] (ζ : Closure) (hζ : IsPrimitiveRoot ζ n)
    {V : Type*} [Fintype V] [DecidableEq V]
    (Γ : Matrix V V F2) (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0)
    (col : V → Fin q) (t : Fin (q - 1) → ZMod n)
    (C : (maskedGraph Γ hs hd col t).ConnectedComponent) {k : ℕ}
    (e : evenCycleGraph k ≃g C.toSimpleGraph) :
    (((weightedMatrix ζ Γ col t).submatrix
        (fun u : C => u.val) (fun u : C => u.val)).rank : ℤ) -
      (((mask Γ col t).submatrix (fun u : C => u.val) (fun u : C => u.val)).rank : ℤ) =
      if (∏ i, (lambda ζ t col (e (Sum.inl i)).val + lambda ζ t col (e (Sum.inr i)).val)) =
        ∏ i, (lambda ζ t col (e (Sum.inl i)).val +
          lambda ζ t col (e (Sum.inr (finRotate (k + 2) i))).val)
      then 0 else 2 := by
  classical
  let A := (weightedMatrix ζ Γ col t).submatrix (fun u : C => u.val) (fun u : C => u.val)
  let B := (mask Γ col t).submatrix (fun u : C => u.val) (fun u : C => u.val)
  have hA : A.IsSymm := (weighted_symm ζ Γ hs col t).submatrix _
  have heA : ∀ u v : C, C.toSimpleGraph.Adj u v ↔ A u v ≠ 0 := by
    intro u v
    exact weighted_support ζ hζ Γ hs hd col t u.val v.val
  have heB : ∀ u v : C, C.toSimpleGraph.Adj u v ↔ B u v ≠ 0 := by
    intro u v
    exact mask_support Γ hs hd col t u.val v.val
  have ha := rank_even_cycle A hA C.toSimpleGraph heA e
  have hBAdj : B = C.toSimpleGraph.adjMatrix F2 := by
    ext u v
    by_cases h : C.toSimpleGraph.Adj u v
    · have hm : mask Γ col t u.val v.val = 1 :=
        mask_on_edge Γ hs hd col t (u := u.val) (v := v.val) h
      change mask Γ col t u.val v.val = _
      simpa only [adjMatrix_apply, h, ite_true] using hm
    · have hz : B u v = 0 := by
        apply not_ne_iff.mp
        exact fun hn => h ((heB u v).mpr hn)
      simp only [adjMatrix_apply, h, ite_false, hz]
  have hb : B.rank = 2 * k + 2 := by
    rw [hBAdj]
    exact rank_even_adjacency C.toSimpleGraph e
  have hedge₁ (i : Fin (k + 2)) : C.toSimpleGraph.Adj (e (Sum.inl i)) (e (Sum.inr i)) :=
    e.map_adj_iff.mpr (Or.inl rfl)
  have hedge₂ (i : Fin (k + 2)) :
      C.toSimpleGraph.Adj (e (Sum.inl i)) (e (Sum.inr (finRotate (k + 2) i))) :=
    e.map_adj_iff.mpr (Or.inr rfl)
  have ha₁ (i : Fin (k + 2)) : A (e (Sum.inl i)) (e (Sum.inr i)) =
      lambda ζ t col (e (Sum.inl i)).val + lambda ζ t col (e (Sum.inr i)).val :=
    weighted_on_edge ζ Γ hs hd col t (hedge₁ i)
  have ha₂ (i : Fin (k + 2)) : A (e (Sum.inl i)) (e (Sum.inr (finRotate (k + 2) i))) =
      lambda ζ t col (e (Sum.inl i)).val +
        lambda ζ t col (e (Sum.inr (finRotate (k + 2) i))).val :=
    weighted_on_edge ζ Γ hs hd col t (hedge₂ i)
  simp only [ha₁, ha₂] at ha
  change (A.rank : ℤ) - (B.rank : ℤ) = _
  rw [ha, hb]
  split_ifs <;> omega

/-- The actual nonzero stabilizer edge weight, with an unused unit value off the support. -/
def edgeWeight {n q : ℕ} (ζ : Closure) {V : Type*} (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) : Sym2 V → (RootField ζ)ˣ :=
  Sym2.lift ⟨fun u v => if h : lambda ζ t col u + lambda ζ t col v = 0 then 1
    else Units.mk0 (lambda ζ t col u + lambda ζ t col v) h, by
      intro u v
      simp only [add_comm]⟩

private theorem edgeWeight_on_edge {n q : ℕ} [NeZero n] (ζ : Closure)
    (hζ : IsPrimitiveRoot ζ n) {V : Type*} (Γ : Matrix V V F2)
    (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n) {u v : V}
    (h : (maskedGraph Γ hs hd col t).Adj u v) :
    (edgeWeight ζ col t s(u,v) : RootField ζ) = lambda ζ t col u + lambda ζ t col v := by
  have hn : lambda ζ t col u + lambda ζ t col v ≠ 0 := by
    rw [ne_eq, CharTwo.add_eq_zero, lambda_eq_iff ζ hζ]
    exact h.2
  simp [edgeWeight, hn]

/-- Inclusion of an actual connected component into its actual masked graph. -/
def componentHom {n q : ℕ} {V : Type*} (Γ : Matrix V V F2)
    (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n)
    (C : (maskedGraph Γ hs hd col t).ConnectedComponent) :
    C.toSimpleGraph →g maskedGraph Γ hs hd col t where
  toFun u := u.val
  map_rel' := fun h => h

/-- The actual cycle in the original graph, using the component's cyclic ordering. -/
def componentCircuit {n q : ℕ} {V : Type*} (Γ : Matrix V V F2)
    (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0) (col : V → Fin q)
    (t : Fin (q - 1) → ZMod n)
    (C : (maskedGraph Γ hs hd col t).ConnectedComponent) {k : ℕ}
    (e : evenCycleGraph k ≃g C.toSimpleGraph) :
    (maskedGraph Γ hs hd col t).Walk (e (Sum.inl 0)).val (e (Sum.inl 0)).val :=
  ((WeightedCycleWalk.circuit k).map e.toHom).map (componentHom Γ hs hd col t C)

/-- On every actual even-cycle component, the integer rank correction is exactly
zero for unit alternating product, and exactly two otherwise. -/
theorem component_rank_difference_alpha
    {n q : ℕ} [NeZero n] (ζ : Closure) (hζ : IsPrimitiveRoot ζ n)
    {V : Type*} [Fintype V] [DecidableEq V]
    (Γ : Matrix V V F2) (hs : Γ.IsSymm) (hd : ∀ u, Γ u u = 0)
    (col : V → Fin q) (t : Fin (q - 1) → ZMod n)
    (C : (maskedGraph Γ hs hd col t).ConnectedComponent) {k : ℕ}
    (z : cycleGraph (2 * (k + 2)) ≃g C.toSimpleGraph) :
    (componentCircuit Γ hs hd col t C ((WeightedCycleWalk.parityIso k).trans z)).IsCycle ∧
    (componentCircuit Γ hs hd col t C ((WeightedCycleWalk.parityIso k).trans z)).length =
      2 * (k + 2) ∧
    (((weightedMatrix ζ Γ col t).submatrix
        (fun u : C => u.val) (fun u : C => u.val)).rank : ℤ) -
      (((mask Γ col t).submatrix (fun u : C => u.val) (fun u : C => u.val)).rank : ℤ) =
      if WeightedVertexProducts.alpha (edgeWeight ζ col t)
        (componentCircuit Γ hs hd col t C ((WeightedCycleWalk.parityIso k).trans z)) = 1 then 0 else 2 := by
  classical
  let e : evenCycleGraph k ≃g C.toSimpleGraph := (WeightedCycleWalk.parityIso k).trans z
  refine ⟨?_, ?_, ?_⟩
  · exact ((WeightedCycleWalk.circuit_isCycle k).map e.injective).map Subtype.val_injective
  · exact (Walk.length_map (componentHom Γ hs hd col t C)
      ((WeightedCycleWalk.circuit k).map e.toHom)).trans
      ((Walk.length_map e.toHom (WeightedCycleWalk.circuit k)).trans
        (WeightedCycleWalk.circuit_length k))
  let f : Fin (k + 2) ⊕ Fin (k + 2) → V := fun u => (e u).val
  let w := fun s => edgeWeight ζ col t (Sym2.map f s)
  have halpha : WeightedVertexProducts.alpha (edgeWeight ζ col t)
      (componentCircuit Γ hs hd col t C e) =
        (∏ i, w s(Sum.inl i, Sum.inr (finRotate (k + 2) i))) /
          ∏ i : Fin (k + 2), w s(Sum.inl i, Sum.inr i) := by
    have heEdges : (componentCircuit Γ hs hd col t C e).edges =
        (WeightedCycleWalk.circuit k).edges.map (Sym2.map f) := by
      change (((WeightedCycleWalk.circuit k).map e.toHom).map
        (componentHom Γ hs hd col t C)).edges = _
      rw [Walk.edges_map (componentHom Γ hs hd col t C)
        ((WeightedCycleWalk.circuit k).map e.toHom),
        Walk.edges_map e.toHom (WeightedCycleWalk.circuit k), List.map_map]
      congr 1
      funext s
      exact Sym2.map_map s
    change (List.map (edgeWeight ζ col t) (componentCircuit Γ hs hd col t C e).edges).alternatingProd = _
    rw [heEdges, List.map_map]
    exact WeightedCycleWalk.circuit_alpha k w
  have hfirst (i : Fin (k + 2)) :
      (w s(Sum.inl i, Sum.inr i) : RootField ζ) =
        lambda ζ t col (f (Sum.inl i)) + lambda ζ t col (f (Sum.inr i)) := by
    apply edgeWeight_on_edge ζ hζ Γ hs hd col t
    exact e.map_rel_iff.mpr (Or.inl rfl)
  have hsecond (i : Fin (k + 2)) :
      (w s(Sum.inl i, Sum.inr (finRotate (k + 2) i)) : RootField ζ) =
        lambda ζ t col (f (Sum.inl i)) +
          lambda ζ t col (f (Sum.inr (finRotate (k + 2) i))) := by
    apply edgeWeight_on_edge ζ hζ Γ hs hd col t
    exact e.map_rel_iff.mpr (Or.inr rfl)
  have heq : WeightedVertexProducts.alpha (edgeWeight ζ col t)
      (componentCircuit Γ hs hd col t C e) = 1 ↔
      (∏ i, (lambda ζ t col (f (Sum.inl i)) + lambda ζ t col (f (Sum.inr i)))) =
        ∏ i, (lambda ζ t col (f (Sum.inl i)) +
          lambda ζ t col (f (Sum.inr (finRotate (k + 2) i)))) := by
    rw [halpha, div_eq_one, Units.ext_iff]
    simp only [Units.coe_prod, hfirst, hsecond]
    exact eq_comm
  simp only [e] at heq
  rw [if_congr heq rfl rfl]
  exact component_rank_difference_products ζ hζ Γ hs hd col t C e

end
end D5.S3.Quantum.Entanglement.MaskedCycles.StabilizerMaskedCycleRank
