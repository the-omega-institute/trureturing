def nodes (fuel : ℕ) (index : Fin Size) : Node Size (Fin 20) (Fin 4) Cut :=
  if index.val = 0 then .bound
  else if index.val < 92161 then
    let code := index.val - 1
    .symmetry (cutOfTag ⟨code / 20 % 4608, Nat.mod_lt _ (by decide)⟩
      ⟨code % 20, Nat.mod_lt _ (by decide)⟩)
  else
    let word := shapeWord (index.val - 92161)
    .split ⟨(21 - fuel) % 20, Nat.mod_lt _ (by decide)⟩
      (fun a => ⟨(word / 2 ^ (21 * a.val) % 2 ^ 21) % Size,
        Nat.mod_lt _ (by decide)⟩)

