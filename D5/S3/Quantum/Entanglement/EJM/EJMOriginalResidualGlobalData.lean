def shapeWord (index : ℕ) : ℕ :=
  shapes.get (index / 128) / 2 ^ (82 * (index % 128)) % 2 ^ 82

def nodes (_fuel : ℕ) (index : Fin Size) : Node Size (Fin 20) (Fin 4) (Fin 24) :=
  let word := shapeWord index.val
  if word % 4 = 0 then .bound
  else if word % 4 = 1 then
    .symmetry ⟨word / 4 % 256 % 24, Nat.mod_lt _ (by decide)⟩
  else
    .split ⟨word / 4 % 256 % 20, Nat.mod_lt _ (by decide)⟩
      (fun a => ⟨(word / 2 ^ (10 + 18 * a.val) % 2 ^ 18) % Size,
        Nat.mod_lt _ (by decide)⟩)

def root : Fin Size := ⟨158889, by decide⟩

