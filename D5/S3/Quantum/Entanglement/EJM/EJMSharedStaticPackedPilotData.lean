private def localCode {n : ℕ} (p : Partial (Fin 20) (Fin 4))
    (projection : Fin n → Fin 20) : ℕ :=
  ∑ j, (match p (projection j) with | none => 4 | some a => a.val) * 5 ^ j.val

def triangleSelection (p : Partial (Fin 20) (Fin 4)) (k : Fin 16) : Fin 647 :=
  ⟨triangleLookup.get (localCode p (lhsTriangle k)) % 647,
    Nat.mod_lt _ (by decide)⟩

def singletonSelection (p : Partial (Fin 20) (Fin 4)) (k : Fin 16) : Fin 425 :=
  ⟨singletonLookup.get (localCode p (lhsSingleton k)) % 425,
    Nat.mod_lt _ (by decide)⟩

def rows (index : Fin 2497) : Row 2497 (Fin 20) (Fin 4) EJMGlobalScoreSymmetry.Cut :=
  ⟨contexts index, levels index, nodes index⟩

def bound (_index : Fin 2497) (p : Partial (Fin 20) (Fin 4)) : Bool :=
  checkBound triangles singletons (triangleSelection p) (singletonSelection p) p

