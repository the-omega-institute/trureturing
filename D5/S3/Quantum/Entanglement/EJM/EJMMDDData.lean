private def decode {n N : ℕ} (hN : 0 < N) (record : MirrorRow) :
    Node N (Fin n) (Fin 4) :=
  if h : record.hash < n then
    .branch ⟨record.hash, h⟩ (fun a =>
      ⟨((record.edges >>> (17 * a.val)) % 131072) % N, Nat.mod_lt _ hN⟩)
  else .leaf record.lower

private def depth (n : ℕ) (record : MirrorRow) : ℕ :=
  if record.hash < n then n - 1 - record.hash else n

