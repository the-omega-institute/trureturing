/-- The lower field is an integer literal, independent of the original 164-bit decoder. -/
def mirror (j : Fin 41294) : MirrorRow := mirrorTree.get j.val
def assignment (j : Fin 41294) := partialEvent (n := 10) (mirror j).hash
def lower (j : Fin 41294) : ℤ := (mirror j).lower
def transition (j : Fin 41294) (i : Fin 10) (a : Fin 4) : State 41294 LocalSym :=
  readTransition (by decide) (mirror j) i.val a

/-- The original hash and scaled lower are checked once per row. The
kernel-proved bridge in `checked_raw_mirror_eq` recovers the full assignment. -/
def checkMirrorFields (j : Fin 41294) : Bool :=
  checkRawMirror (mirror j) (triangleTree.read 10 j.val)

/-- The whole original partial assignment and the exact original scaled lower are compared. -/
def checkMirror (j : Fin 41294) : Bool :=
  decide (assignment j = (triangleRows j).assignment ∧ lower j = (triangleRows j).lower)

/-- Every unknown coordinate retains every value and a full assignment equality. -/
def checkTransitions (j : Fin 41294) : Bool :=
  decide (∀ i : Fin 10, assignment j i = none → ∀ a : Fin 4,
    assignment (transition j i a).1 = trianglePartialAct (transition j i a).2
      (Function.update (assignment j) i (some a)))

