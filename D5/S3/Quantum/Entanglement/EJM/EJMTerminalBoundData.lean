def singletonTerminalEvent (j : Fin 1192) : Fin 9 → Fin 4 :=
  event (rawHash (singletonTree.read 9 j.val))

def singletonWitness (j : Fin 1192) : LocalSym × Fin 332 :=
  let word := (singletonWitnesses.get j.val).toNat
  (action (word % 288), ⟨word / 288 % 332, Nat.mod_lt _ (by decide)⟩)

def singletonTerminalCheck (j : Fin 1192) : Bool :=
  let e := singletonTerminalEvent j
  let w := singletonWitness j
  match (singletonRows ⟨j.val, lt_trans j.isLt (by decide : 1192 < 8689)⟩).rule with
  | .complete actual => decide (actual = e ∧
      EJMContractionData.singletonTail w.2 =
        outcome w.1.2 ∘ (fun i : Fin 8 => e (Fin.natAdd 1 i)) ∘ singletonTailPerm w.1.1 ∧
      (singletonRows ⟨j.val, lt_trans j.isLt (by decide : 1192 < 8689)⟩).lower ≤
        256 * EJMCertificateData.F2 e - 64 * EJMContractionData.singletonValue w.2)
  | .split _ _ _ => false

def singletonTerminalTagCheck (j : Fin 8689) : Bool :=
  match (singletonRows j).rule with
  | .complete actual =>
    if h : j.val < 1192 then decide (actual = singletonTerminalEvent ⟨j.val, h⟩)
    else false
  | .split _ _ _ => true

