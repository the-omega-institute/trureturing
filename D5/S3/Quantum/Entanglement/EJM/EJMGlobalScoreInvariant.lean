/- GID: D5/S3/Quantum/Entanglement/EJM/EJMGlobalScoreInvariant
   generality: I
   mirror-B: D5/B/S3/Quantum/Entanglement/EJM/EJMGlobalScoreInvariant
   mirror-E: none(waiver:exact-global-score-orbit)
   anchors: []
   utility: none
   digest: The actual source and outcome actions form a global orbit on events with constant centered score. -/

import D5.S3.Quantum.Entanglement.EJM.EJMPartialBoundTransport
import D5.S3.Quantum.Entanglement.EJM.EJMSourceActionClosure

/-! The actual global source/outcome action has constant centered score on each orbit. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false
set_option maxRecDepth 4096
noncomputable section
set_option linter.style.longLine false

namespace D5.S3.Quantum.Entanglement.EJM.EJMGlobalScoreInvariant

open D5.S3.Quantum.Entanglement.EJMInflationScore
open D5.S3.Quantum.Entanglement.ElegantJointMeasurementInflation
open D5.S3.Quantum.Entanglement.EJM.EJMCertificateData (F1 F2)
open D5.S3.Quantum.Entanglement.EJM.EJMPartialBoundTransport (outcomeEquiv)
open D5.S3.Quantum.Entanglement.EJM.EJMSourceActionClosure

/- The raw index `Fin 192` enumerates the actual source generators, but is
not itself a group. Taking the subgroup generated by their permutation
equivalences gives the genuine source symmetry group. -/
abbrev SourceSym :=
  Subgroup.closure (Set.range sourceSymmetryEquiv)

/- The outcome component is the full permutation group on the four outcomes;
the product is therefore a genuine group of global source/outcome actions. -/
abbrev GlobalSym := SourceSym × Equiv.Perm (Fin 4)

def act (s : GlobalSym) (e : Node → Fin 4) : Node → Fin 4 :=
  (s.2 : Fin 4 ≃ Fin 4) ∘ e ∘ (s.1 : Node ≃ Node).symm

instance : MulAction GlobalSym (Node → Fin 4) where
  smul := act
  one_smul e := by
    change act (1 : GlobalSym) e = e
    funext i
    change (1 : Fin 4 ≃ Fin 4) (e ((1 : Node ≃ Node)⁻¹ i)) = e i
    simp
  mul_smul s t e := by
    funext i
    change (s.2 : Fin 4 ≃ Fin 4)
        ((t.2 : Fin 4 ≃ Fin 4) (e ((t.1 : Node ≃ Node)⁻¹ ((s.1 : Node ≃ Node)⁻¹ i)))) =
      (s.2 * t.2 : Fin 4 ≃ Fin 4)
        (e (((s.1 * t.1 : Node ≃ Node)⁻¹) i))
    rfl

set_option maxHeartbeats 4000000 in
private theorem closure_invariant (f : (Node → Fin 4) → ℤ)
    (hgen : ∀ s : Fin 192, ∀ e : Node → Fin 4,
      f (e ∘ sourceSymmetry s) = f e)
    (q : Node ≃ Node)
    (hq : q ∈ SourceSym) :
    ∀ e : Node → Fin 4, f (e ∘ q) = f e := by
  induction hq using Subgroup.closure_induction with
  | mem q hq =>
      rcases hq with ⟨s, rfl⟩
      intro e
      exact hgen s e
  | one =>
      intro e
      simp
  | mul q r hq hr ihq ihr =>
      intro e
      have hcomp : e ∘ (q * r) = (e ∘ q) ∘ r := by
        funext i
        rfl
      rw [hcomp]
      exact (ihr (e ∘ q)).trans (ihq e)
  | inv q hq ihq =>
      intro e
      have h := ihq (e ∘ q.symm)
      have hcomp : (e ∘ q.symm) ∘ q = e := by
        funext i
        simp
      rw [hcomp] at h
      exact h.symm

private theorem source_score_closure (q : Node ≃ Node)
    (hq : q ∈ SourceSym) :
    ∀ e : Node → Fin 4, score F1 F2 (e ∘ q) = score F1 F2 e := by
  exact closure_invariant (score F1 F2) actual_score_sourceSymmetry q hq

def orbit (e : Node → Fin 4) : Set (Node → Fin 4) :=
  MulAction.orbit GlobalSym e

theorem actual_score_invariant (s : GlobalSym) (e : Node → Fin 4) :
    score F1 F2 (act s e) = score F1 F2 e := by
  change score F1 F2 ((s.2 : Fin 4 ≃ Fin 4) ∘
      (e ∘ (s.1 : Node ≃ Node).symm)) = _
  rw [actual_score_relabel]
  exact source_score_closure (s.1 : Node ≃ Node).symm
    (SourceSym.inv_mem s.1.property) e

theorem orbit_score_constant {e e' : Node → Fin 4} (h : e' ∈ orbit e) :
    score F1 F2 e' = score F1 F2 e := by
  rcases h with ⟨s, rfl⟩
  exact actual_score_invariant s e

theorem orbit_score_pairwise {e e₁ e₂ : Node → Fin 4}
    (h₁ : e₁ ∈ orbit e) (h₂ : e₂ ∈ orbit e) :
    score F1 F2 e₁ = score F1 F2 e₂ := by
  calc
    score F1 F2 e₁ = score F1 F2 e := orbit_score_constant h₁
    _ = score F1 F2 e₂ := (orbit_score_constant h₂).symm

#print axioms actual_score_invariant
#print axioms orbit_score_constant
#print axioms orbit_score_pairwise

end D5.S3.Quantum.Entanglement.EJM.EJMGlobalScoreInvariant
