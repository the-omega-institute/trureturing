set_option maxHeartbeats 4000000 in
-- The kernel checks all 192 exact finite table actions; the default limit is insufficient.
private theorem source_bijective (s : Fin 192) : Function.Bijective (sourceSymmetry s) := by
  have h : ∀ s : Fin 192, ∀ i : Fin 20,
      sourceSymmetry (sourceInverse s) (sourceSymmetry s i) = i := by decide
  have hi : Function.LeftInverse (sourceSymmetry (sourceInverse s)) (sourceSymmetry s) := h s
  exact hi.injective.bijective_of_finite

noncomputable def sourceSymmetryEquiv (s : Fin 192) : Node ≃ Node :=
  Equiv.ofBijective (sourceSymmetry s) (source_bijective s)

set_option maxHeartbeats 4000000 in
-- The kernel checks all 192 exact finite table actions; the default limit is insufficient.
private theorem triangle_index_bijective (s : Fin 192) :
    Function.Bijective (triangleIndex s) := by
  have h : ∀ s : Fin 192, ∀ i : Fin 16,
      triangleIndex (sourceInverse s) (triangleIndex s i) = i := by decide
  have hi : Function.LeftInverse (triangleIndex (sourceInverse s)) (triangleIndex s) := h s
  exact hi.injective.bijective_of_finite

set_option maxHeartbeats 4000000 in
-- The kernel checks all 192 exact finite table actions; the default limit is insufficient.
private theorem singleton_index_bijective (s : Fin 192) :
    Function.Bijective (singletonIndex s) := by
  have h : ∀ s : Fin 192, ∀ i : Fin 16,
      singletonIndex (sourceInverse s) (singletonIndex s i) = i := by decide
  have hi : Function.LeftInverse (singletonIndex (sourceInverse s)) (singletonIndex s) := h s
  exact hi.injective.bijective_of_finite

set_option maxHeartbeats 4000000 in
-- The kernel checks all 192 exact finite table actions; the default limit is insufficient.
theorem triangle_map_closure (s : Fin 192) (i : Fin 16) :
    sourceSymmetry s ∘ lhsTriangle i =
      lhsTriangle (triangleIndex s i) ∘ trianglePerm (triangleLocal s i) := by
  have h : ∀ s : Fin 192, ∀ i : Fin 16, ∀ j : Fin 10,
      sourceSymmetry s (lhsTriangle i j) =
        lhsTriangle (triangleIndex s i) (trianglePerm (triangleLocal s i) j) := by decide
  funext j
  exact h s i j

set_option maxHeartbeats 4000000 in
-- The kernel checks all 192 exact finite table actions; the default limit is insufficient.
theorem singleton_map_closure (s : Fin 192) (i : Fin 16) :
    sourceSymmetry s ∘ lhsSingleton i =
      lhsSingleton (singletonIndex s i) ∘ singletonPerm (singletonLocal s i) := by
  have h : ∀ s : Fin 192, ∀ i : Fin 16, ∀ j : Fin 9,
      sourceSymmetry s (lhsSingleton i j) =
        lhsSingleton (singletonIndex s i) (singletonPerm (singletonLocal s i) j) := by decide
  funext j
  exact h s i j
private theorem triangleBlock_source (F : (Fin 10 → Fin 4) → ℤ)
    (hF : ∀ (k : Fin 12) e, F (e ∘ trianglePerm k) = F e)
    (s : Fin 192) (i : Fin 16) (o : Node → Fin 4) :
    triangleBlock F i (o ∘ sourceSymmetry s) = triangleBlock F (triangleIndex s i) o := by
  change triangleCentered F ((o ∘ sourceSymmetry s) ∘ lhsTriangle i) =
    triangleCentered F (o ∘ lhsTriangle (triangleIndex s i))
  rw [Function.comp_assoc, triangle_map_closure, ← Function.comp_assoc]
  exact triangleCentered_coordinate F hF _ _

private theorem singletonBlock_source (F : (Fin 9 → Fin 4) → ℤ)
    (hF : ∀ (k : Fin 12) e, F (e ∘ singletonPerm k) = F e)
    (s : Fin 192) (i : Fin 16) (o : Node → Fin 4) :
    singletonBlock F i (o ∘ sourceSymmetry s) =
      singletonBlock F (singletonIndex s i) o := by
  change singletonCentered F ((o ∘ sourceSymmetry s) ∘ lhsSingleton i) =
    singletonCentered F (o ∘ lhsSingleton (singletonIndex s i))
  rw [Function.comp_assoc, singleton_map_closure, ← Function.comp_assoc]
  exact singletonCentered_coordinate F hF _ _

/-- All 192 actual node actions permute the centered blocks and preserve their sum. -/
theorem score_sourceSymmetry (F1 : (Fin 10 → Fin 4) → ℤ)
    (F2 : (Fin 9 → Fin 4) → ℤ)
    (hF1 : ∀ (k : Fin 12) e, F1 (e ∘ trianglePerm k) = F1 e)
    (hF2 : ∀ (k : Fin 12) e, F2 (e ∘ singletonPerm k) = F2 e)
    (s : Fin 192) (o : Node → Fin 4) :
    score F1 F2 (o ∘ sourceSymmetry s) = score F1 F2 o := by
  unfold score
  simp only [triangleBlock_source F1 hF1, singletonBlock_source F2 hF2]
  exact congrArg₂ (· + ·)
    ((triangle_index_bijective s).sum_comp (fun i => triangleBlock F1 i o))
    ((singleton_index_bijective s).sum_comp (fun i => singletonBlock F2 i o))

/-- A common bijective relabeling of all four outcomes preserves the centered score. -/
theorem score_relabel (F1 : (Fin 10 → Fin 4) → ℤ) (F2 : (Fin 9 → Fin 4) → ℤ)
    (ν : Fin 4 ≃ Fin 4)
    (hF1 : ∀ e, F1 (ν ∘ e) = F1 e) (hF2 : ∀ e, F2 (ν ∘ e) = F2 e)
    (o : Node → Fin 4) : score F1 F2 (ν ∘ o) = score F1 F2 o := by
  unfold score
  congr 1 <;> apply Finset.sum_congr rfl
  · intro i _
    change triangleCentered F1 (ν ∘ (o ∘ lhsTriangle i)) =
      triangleCentered F1 (o ∘ lhsTriangle i)
    exact triangleCentered_relabel F1 ν hF1 _
  · intro i _
    change singletonCentered F2 (ν ∘ (o ∘ lhsSingleton i)) =
      singletonCentered F2 (o ∘ lhsSingleton i)
    exact singletonCentered_relabel F2 ν hF2 _

theorem actual_score_sourceSymmetry (s : Fin 192) (o : Node → Fin 4) :
    score F1 F2 (o ∘ sourceSymmetry s) = score F1 F2 o :=
  score_sourceSymmetry F1 F2
    (fun k e => EJMCertificateData.F1_coordinate e k)
    (fun k e => EJMCertificateData.F2_coordinate e k) s o

theorem actual_score_relabel (ν : Fin 4 ≃ Fin 4) (o : Node → Fin 4) :
    score F1 F2 (ν ∘ o) = score F1 F2 o :=
  score_relabel F1 F2 ν
    (fun e => EJMCertificateData.F1_relabel e ν ν.injective)
    (fun e => EJMCertificateData.F2_relabel e ν ν.injective) o

