def singletonSelect (p : Partial (Fin 9) (Fin 4)) : Option (Fin 8689 × LocalSym) :=
  let proposal := canonicalCandidate singletonPerm p
  match singletonDictionary.find proposal.hash with
  | none => none
  | some index =>
    if h : index < 8689 then some (⟨index, h⟩, proposal.symmetry) else none

def singletonLower (p : Partial (Fin 9) (Fin 4)) : ℤ :=
  checkedLookupLower singletonPartialAct singletonRows (8688 : Fin 8689) singletonSelect p

theorem singleton_root_assignment :
    (singletonRows (8688 : Fin 8689)).assignment = (fun _ => none) := by decide

theorem singleton_lower_bound
    (accepted : ∀ j, checkRow (singletonCentered F2)
      singletonPartialAct singletonRows j = true)
    (p : Partial (Fin 9) (Fin 4)) (e : Event (Fin 9) (Fin 4))
    (hp : Compatible p e) :
    singletonLower p ≤ singletonCentered F2 e := by
  exact checked_lookup_lower_bound _ singletonAct singletonPartialAct
    singleton_compatible singleton_score_invariant singletonRows accepted
    (8688 : Fin 8689) singleton_root_assignment singletonSelect p e hp

