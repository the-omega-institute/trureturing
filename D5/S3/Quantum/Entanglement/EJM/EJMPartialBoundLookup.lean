/-!
The literal dictionaries map base-five representative hashes to local row
indices. Every private definition has at most 64 literal nodes. Both the
dictionaries and the twelve-permutation normalization are untrusted proposals:
the public lower bound checks the entire actual partial assignment, and falls
back to the accepted all-unknown root if any proposal is missing or wrong.
No completeness or optimality theorem for this normalization is assumed.
-/

private inductive Dictionary where
  | empty
  | node (key index : ℕ) (left right : Dictionary)

private def Dictionary.find : Dictionary → ℕ → Option ℕ
  | .empty, _ => none
  | .node key index left right, target =>
    if target = key then some index
    else if target < key then left.find target else right.find target

private def outcomeIndex (code : ℕ) : Fin 24 :=
  (if code = 135 then 20 else if code < 135 then (if code = 75 then 22 else if code < 75 then (if code = 45 then 11 else if code < 45 then (if code = 30 then 17 else if code < 30 then (if code = 27 then 23 else if code < 27 then 0 else 0) else (if code = 39 then 21 else if code < 39 then 0 else 0)) else (if code = 57 then 9 else if code < 57 then (if code = 54 then 15 else if code < 54 then 0 else 0) else 0)) else (if code = 108 then 5 else if code < 108 then (if code = 99 then 19 else if code < 99 then (if code = 78 then 16 else if code < 78 then 0 else 0) else 0) else (if code = 120 then 3 else if code < 120 then (if code = 114 then 13 else if code < 114 then 0 else 0) else 0))) else (if code = 198 then 14 else if code < 198 then (if code = 156 then 4 else if code < 156 then (if code = 147 then 18 else if code < 147 then (if code = 141 then 10 else if code < 141 then 0 else 0) else 0) else (if code = 180 then 1 else if code < 180 then (if code = 177 then 7 else if code < 177 then 0 else 0) else 0)) else (if code = 216 then 2 else if code < 216 then (if code = 210 then 12 else if code < 210 then (if code = 201 then 8 else if code < 201 then 0 else 0) else 0) else (if code = 228 then 0 else if code < 228 then (if code = 225 then 6 else if code < 225 then 0 else 0) else 0))))

private def normalizeStep (state : List ℕ × List ℕ) (digit : ℕ) : List ℕ × List ℕ :=
  if digit = 4 then (state.1, state.2 ++ [4])
  else if digit ∈ state.1 then (state.1, state.2 ++ [state.1.idxOf digit])
  else (state.1 ++ [digit], state.2 ++ [state.1.length])

private structure Candidate where
  lexKey : ℕ
  hash : ℕ
  symmetry : LocalSym

private def candidate {n : ℕ} (permutation : Fin 12 → Fin n → Fin n)
    (p : Partial (Fin n) (Fin 4)) (k : Fin 12) : Candidate :=
  let digits := (List.finRange n).map (fun i =>
    match p (permutation k i) with | none => 4 | some a => a.val)
  let normalized := digits.foldl normalizeStep ([], [])
  let labels := normalized.1 ++ (List.range 4).filter (fun a => a ∉ normalized.1)
  let code := (List.range 4).foldl (fun acc a => acc + labels.idxOf a * 4 ^ a) 0
  let hash := normalized.2.foldr (fun a acc => a + 5 * acc) 0
  let lexKey := normalized.2.foldl (fun acc a => 5 * acc + a) 0
  ⟨lexKey, hash, (k, outcomeIndex code)⟩

private def canonicalCandidate {n : ℕ} (permutation : Fin 12 → Fin n → Fin n)
    (p : Partial (Fin n) (Fin 4)) : Candidate :=
  (List.finRange 12).tail.foldl (fun best k =>
    let next := candidate permutation p k
    if next.lexKey < best.lexKey then next else best) (candidate permutation p 0)

