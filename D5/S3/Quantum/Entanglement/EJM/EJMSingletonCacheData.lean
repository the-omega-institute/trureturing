def mirrorTree : MirrorTree := mirrorTreePart62

/-- The lower field is an integer literal, independent of the original 164-bit decoder. -/
def mirror (j : Fin 8689) : MirrorRow := mirrorTree.get j.val
def assignment (j : Fin 8689) := partialEvent (n := 9) (mirror j).hash
def lower (j : Fin 8689) : ℤ := (mirror j).lower
def transition (j : Fin 8689) (i : Fin 9) (a : Fin 4) : State 8689 LocalSym :=
  readTransition (by decide) (mirror j) i.val a

/-- The original hash and scaled lower are checked once per row. The
kernel-proved bridge in `checked_raw_mirror_eq` recovers the full assignment. -/
def checkMirrorFields (j : Fin 8689) : Bool :=
  checkRawMirror (mirror j) (singletonTree.read 9 j.val)

/-- The whole original partial assignment and the exact original scaled lower are compared. -/
def checkMirror (j : Fin 8689) : Bool :=
  decide (assignment j = (singletonRows j).assignment ∧ lower j = (singletonRows j).lower)

/-- Every unknown coordinate retains every value and a full assignment equality. -/
def checkTransitions (j : Fin 8689) : Bool :=
  decide (∀ i : Fin 9, assignment j i = none → ∀ a : Fin 4,
    assignment (transition j i a).1 = singletonPartialAct (transition j i a).2
      (Function.update (assignment j) i (some a)))

