set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped InnerProductSpace
open Finset Module Polynomial

namespace D5.S3.Constants.Moments.GramSchmidtCoefficientField

open D5.S3.Constants.Moments.CoefficientDrivenJacobiCharacteristicPolynomial

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace Real E]

private theorem trace_moment_mem (q : Real[X]) (n : Nat) :
    Matrix.trace (coefficientMultiplicationMatrix q ^ n) / (q.natDegree : Real) ∈
      Subfield.closure (Set.range q.coeff) := by
  let F := Subfield.closure (Set.range q.coeff)
  have hentry (i j : Fin q.natDegree) : coefficientMultiplicationMatrix q i j ∈ F := by
    unfold coefficientMultiplicationMatrix
    split_ifs
    · exact F.neg_mem (Subfield.subset_closure ⟨i.val, rfl⟩)
    · exact F.one_mem
    · exact F.zero_mem
  have hpowers : ∀ k : Nat, ∀ i j : Fin q.natDegree,
      (coefficientMultiplicationMatrix q ^ k) i j ∈ F := by
    intro k
    induction k with
    | zero =>
      intro i j
      simp only [pow_zero, Matrix.one_apply]
      split_ifs
      · exact F.one_mem
      · exact F.zero_mem
    | succ k ih =>
      intro i j
      rw [pow_succ, Matrix.mul_apply]
      exact F.sum_mem fun l _ => F.mul_mem (ih i l) (hentry l j)
  exact F.div_mem (F.sum_mem fun i _ => hpowers n i i) (natCast_mem F q.natDegree)

private theorem hankel_value_mem {q : Real[X]} (power : Basis (Fin q.natDegree) Real E)
    (F : Subfield Real) (moment : Nat -> Real) (hmoment : ∀ n, moment n ∈ F)
    {x y : E} (hx : ∀ i, power.repr x i ∈ F) (hy : ∀ i, power.repr y i ∈ F) :
    coefficientHankelValue power moment x y ∈ F := by
  exact F.sum_mem fun i _ => F.sum_mem fun j _ =>
    F.mul_mem (F.mul_mem (hx i) (hy j)) (hmoment (i.val + j.val))

/-- With the normalized companion-trace Hankel inner product, every coordinate of the
unnormalized Gram--Schmidt basis lies in the subfield generated by the polynomial coefficients.
The Hankel identity is explicit; monicity and positive degree are unnecessary for this invariant.
This does not construct an inner product or identify trace moments with a root enumeration. -/
theorem gram_schmidt_coordinates_mem_coefficient_field
    (q : Real[X]) (power : Basis (Fin q.natDegree) Real E)
    (hinner : ∀ x y, inner Real x y = coefficientHankelValue power
      (fun n => Matrix.trace (coefficientMultiplicationMatrix q ^ n) / (q.natDegree : Real))
      x y) :
    ∀ i j, power.repr (InnerProductSpace.gramSchmidtBasis power i) j ∈
      Subfield.closure (Set.range q.coeff) := by
  let F := Subfield.closure (Set.range q.coeff)
  have hpower (i j : Fin q.natDegree) : power.repr (power i) j ∈ F := by
    rw [Basis.repr_self_apply]
    split_ifs
    · exact F.one_mem
    · exact F.zero_mem
  have hpair {x y : E} (hx : ∀ i, power.repr x i ∈ F)
      (hy : ∀ i, power.repr y i ∈ F) : inner Real x y ∈ F := by
    rw [hinner]
    exact hankel_value_mem power F _ (trace_moment_mem q) hx hy
  have hgs : ∀ i : Fin q.natDegree, ∀ j,
      power.repr (InnerProductSpace.gramSchmidt Real power i) j ∈ F := by
    intro i
    induction i using WellFoundedLT.induction with
    | ind i ih =>
      intro j
      rw [InnerProductSpace.gramSchmidt_def]
      simp only [map_sub, map_sum, Submodule.starProjection_singleton, map_smul,
        Finsupp.coe_sub, Pi.sub_apply, Finsupp.coe_finsetSum, Finset.sum_apply,
        Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul, ← real_inner_self_eq_norm_sq]
      apply F.sub_mem (hpower i j)
      apply F.sum_mem
      intro k hk
      have hkcoords := ih k (Finset.mem_Iio.mp hk)
      exact F.mul_mem (F.div_mem (hpair hkcoords (hpower i))
        (hpair hkcoords hkcoords)) (hkcoords j)
  intro i j
  change power.repr ((InnerProductSpace.gramSchmidtBasis power : Fin q.natDegree -> E) i) j ∈ F
  rw [InnerProductSpace.coe_gramSchmidtBasis]
  exact hgs i j

#print axioms gram_schmidt_coordinates_mem_coefficient_field

end D5.S3.Constants.Moments.GramSchmidtCoefficientField
