import D5.S3.Constants.Values

namespace D5.S3.Constants.ElementaryExactValues

open D5.S3.Constants.Values

/-- The elementary constants reduce to explicit expressions in `ℚ(√5)`.
The slope constant is also recorded in its defining golden-ratio form. -/
theorem elementary_exact_values :
    kappa = 1 / (2 * goldenRatio) ∧
      kappa = (Real.sqrt 5 - 1) / 4 ∧
      hBar = -1 / 2 ∧
      s1 = (1 + Real.sqrt 5) / 12 ∧
      ah = (5 * Real.sqrt 5 - 3) / 24 ∧
      e = (137 - 61 * Real.sqrt 5) / 24 := by
  refine ⟨rfl, ?_, rfl, rfl, rfl, rfl⟩
  rw [kappa, goldenRatio]
  have hsqrt : (Real.sqrt 5) ^ 2 = 5 := by norm_num
  have hden : (1 + Real.sqrt 5 : ℝ) ≠ 0 := by positivity
  field_simp [hden]
  nlinarith

end D5.S3.Constants.ElementaryExactValues
