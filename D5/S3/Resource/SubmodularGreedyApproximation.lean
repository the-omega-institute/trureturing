namespace D5.S3.Resource.SubmodularGreedyApproximation

open scoped BigOperators

/-- A real-valued set function is monotone under inclusion. -/
def IsMonotone {Ground : Type*} [DecidableEq Ground]
    (value : Finset Ground -> Real) : Prop :=
  forall {smaller larger}, smaller ⊆ larger -> value smaller <= value larger

/-- Diminishing returns is the insertion form of finite-set submodularity. -/
def IsSubmodular {Ground : Type*} [DecidableEq Ground]
    (value : Finset Ground -> Real) : Prop :=
  forall {smaller larger}, smaller ⊆ larger -> forall element, element ∉ larger ->
    value (insert element larger) - value larger <=
      value (insert element smaller) - value smaller

/-- The sets generated by a sequence of greedy choices. -/
def greedySelection {Ground : Type*} [DecidableEq Ground]
    (pick : Nat -> Ground) : Nat -> Finset Ground
  | 0 => ∅
  | step + 1 => insert (pick step) (greedySelection pick step)

/-- Up to `steps`, every chosen element is fresh and has maximum current
marginal value among all unchosen elements. -/
def IsGreedySelection {Ground : Type*} [DecidableEq Ground]
    (value : Finset Ground -> Real) (pick : Nat -> Ground) (steps : Nat) : Prop :=
  forall step, step < steps ->
    pick step ∉ greedySelection pick step /\
      forall alternative, alternative ∉ greedySelection pick step ->
        value (insert alternative (greedySelection pick step)) -
            value (greedySelection pick step) <=
          value (insert (pick step) (greedySelection pick step)) -
            value (greedySelection pick step)

@[simp]
theorem greedySelection_zero {Ground : Type*} [DecidableEq Ground]
    (pick : Nat -> Ground) :
    greedySelection pick 0 = ∅ :=
  rfl

@[simp]
theorem greedySelection_succ {Ground : Type*} [DecidableEq Ground]
    (pick : Nat -> Ground) (step : Nat) :
    greedySelection pick (step + 1) =
      insert (pick step) (greedySelection pick step) :=
  rfl

/-- Submodularity bounds the gain from adjoining a finite set by the sum of
its elements' marginal gains at the original base set. -/
theorem submodular_union_gap_le_sum
    {Ground : Type*} [DecidableEq Ground]
    (value : Finset Ground -> Real) (submodular : IsSubmodular value)
    (base extra : Finset Ground) :
    value (base ∪ extra) - value base <=
      ∑ element ∈ extra,
        (value (insert element base) - value base) := by
  induction extra using Finset.induction_on with
  | empty => simp
  | @insert element extra notInExtra inductionHypothesis =>
      rw [Finset.sum_insert notInExtra]
      by_cases inBase : element ∈ base
      · rw [Finset.union_insert]
        have inUnion : element ∈ base ∪ extra :=
          Finset.mem_union_left extra inBase
        rw [Finset.insert_eq_of_mem inUnion, Finset.insert_eq_of_mem inBase,
          sub_self, zero_add]
        exact inductionHypothesis
      · have notInUnion : element ∉ base ∪ extra := by
          simp [inBase, notInExtra]
        have marginalBound :=
          submodular (Finset.subset_union_left) element notInUnion
        rw [Finset.union_insert]
        linarith

#print axioms submodular_union_gap_le_sum

/-- At every greedy step, the remaining value of any set of size at most the
budget is at most the budget times the gain made at that step. -/
theorem greedy_step_gap_le_budget_mul_gain
    {Ground : Type*} [DecidableEq Ground]
    (value : Finset Ground -> Real) (monotone : IsMonotone value)
    (submodular : IsSubmodular value) (pick : Nat -> Ground) (budget : Nat)
    (greedy : IsGreedySelection value pick budget)
    (optimal : Finset Ground) (optimal_card : optimal.card <= budget)
    {step : Nat} (step_lt : step < budget) :
    value optimal - value (greedySelection pick step) <=
      (budget : Real) *
        (value (greedySelection pick (step + 1)) -
          value (greedySelection pick step)) := by
  let current := greedySelection pick step
  have optimal_le_union : value optimal <= value (current ∪ optimal) :=
    monotone Finset.subset_union_right
  obtain ⟨fresh, greedyMax⟩ := greedy step step_lt
  have gain_nonneg :
      0 <= value (insert (pick step) current) - value current :=
    sub_nonneg.mpr (monotone (Finset.subset_insert (pick step) current))
  calc
    value optimal - value current <=
        value (current ∪ optimal) - value current :=
      sub_le_sub_right optimal_le_union _
    _ <= ∑ element ∈ optimal,
        (value (insert element current) - value current) :=
      submodular_union_gap_le_sum value submodular current optimal
    _ <= ∑ _element ∈ optimal,
        (value (insert (pick step) current) - value current) := by
      apply Finset.sum_le_sum
      intro element element_mem
      by_cases element_current : element ∈ current
      · rw [Finset.insert_eq_of_mem element_current, sub_self]
        exact gain_nonneg
      · exact greedyMax element element_current
    _ = (optimal.card : Real) *
        (value (insert (pick step) current) - value current) := by
      simp [mul_sub]
    _ <= (budget : Real) *
        (value (insert (pick step) current) - value current) := by
      apply mul_le_mul_of_nonneg_right _ gain_nonneg
      exact_mod_cast optimal_card
    _ = (budget : Real) *
        (value (greedySelection pick (step + 1)) -
          value (greedySelection pick step)) := by
      rfl

#print axioms greedy_step_gap_le_budget_mul_gain

/-- After any number of steps up to a positive budget, the remaining gap is
bounded by the corresponding power of the greedy contraction factor. -/
theorem greedy_gap_le_geometric
    {Ground : Type*} [DecidableEq Ground]
    (value : Finset Ground -> Real) (normalized : value ∅ = 0)
    (monotone : IsMonotone value) (submodular : IsSubmodular value)
    (pick : Nat -> Ground) (budget : Nat) (budget_pos : 0 < budget)
    (greedy : IsGreedySelection value pick budget)
    (optimal : Finset Ground) (optimal_card : optimal.card <= budget)
    (step : Nat) (step_le : step <= budget) :
    value optimal - value (greedySelection pick step) <=
      (1 - 1 / (budget : Real)) ^ step * value optimal := by
  have budget_real_pos : (0 : Real) < budget := by
    exact_mod_cast budget_pos
  have one_le_budget_real : (1 : Real) <= budget := by
    exact_mod_cast budget_pos
  have contraction_nonneg : (0 : Real) <= 1 - 1 / budget :=
    sub_nonneg.mpr
      (div_le_one_of_le₀ one_le_budget_real budget_real_pos.le)
  induction step with
  | zero => simp [normalized]
  | succ step inductionHypothesis =>
      have step_lt : step < budget := Nat.lt_of_succ_le step_le
      have previous_step_le : step <= budget := Nat.le_of_lt step_lt
      have previous_bound := inductionHypothesis previous_step_le
      have gap_bound :=
        greedy_step_gap_le_budget_mul_gain value monotone submodular pick
          budget greedy optimal optimal_card step_lt
      have gain_lower :
          (value optimal - value (greedySelection pick step)) / budget <=
            value (greedySelection pick (step + 1)) -
              value (greedySelection pick step) := by
        rw [div_le_iff₀ budget_real_pos]
        simpa only [mul_comm] using gap_bound
      calc
        value optimal - value (greedySelection pick (step + 1)) =
            (value optimal - value (greedySelection pick step)) -
              (value (greedySelection pick (step + 1)) -
                value (greedySelection pick step)) := by
          ring
        _ <= (value optimal - value (greedySelection pick step)) -
            (value optimal - value (greedySelection pick step)) / budget :=
          sub_le_sub_left gain_lower _
        _ = (1 - 1 / (budget : Real)) *
            (value optimal - value (greedySelection pick step)) := by
          ring
        _ <= (1 - 1 / (budget : Real)) *
            ((1 - 1 / (budget : Real)) ^ step * value optimal) :=
          mul_le_mul_of_nonneg_left previous_bound contraction_nonneg
        _ = (1 - 1 / (budget : Real)) ^ (step + 1) * value optimal := by
          rw [pow_succ]
          ring

#print axioms greedy_gap_le_geometric

/-- The classical cardinality-greedy guarantee: after `budget` choices, greedy
attains at least a `1 - 1/e` fraction of every feasible set's value. -/
theorem cardinality_greedy_one_sub_inv_exp_guarantee
    {Ground : Type*} [DecidableEq Ground]
    (value : Finset Ground -> Real) (normalized : value ∅ = 0)
    (monotone : IsMonotone value) (submodular : IsSubmodular value)
    (pick : Nat -> Ground) (budget : Nat)
    (greedy : IsGreedySelection value pick budget)
    (optimal : Finset Ground) (optimal_card : optimal.card <= budget) :
    (1 - 1 / Real.exp 1) * value optimal <=
      value (greedySelection pick budget) := by
  by_cases budget_zero : budget = 0
  · subst budget
    have optimal_empty : optimal = ∅ :=
      Finset.card_eq_zero.mp (Nat.eq_zero_of_le_zero optimal_card)
    simp [optimal_empty, normalized]
  · have budget_pos : 0 < budget := Nat.pos_of_ne_zero budget_zero
    have optimal_nonneg : 0 <= value optimal := by
      rw [← normalized]
      exact monotone (Finset.empty_subset optimal)
    have gap_bound :=
      greedy_gap_le_geometric value normalized monotone submodular pick budget
        budget_pos greedy optimal optimal_card budget (le_refl budget)
    have one_le_budget_real : (1 : Real) <= budget := by
      exact_mod_cast budget_pos
    have power_bound :
        (1 - 1 / (budget : Real)) ^ budget <= Real.exp (-1) :=
      Real.one_sub_div_pow_le_exp_neg one_le_budget_real
    have gap_le_exp :
        value optimal - value (greedySelection pick budget) <=
          Real.exp (-1) * value optimal :=
      gap_bound.trans
        (mul_le_mul_of_nonneg_right power_bound optimal_nonneg)
    have exp_neg_one : Real.exp (-1) = 1 / Real.exp 1 := by
      simp only [Real.exp_neg, one_div]
    rw [← exp_neg_one]
    linarith

#print axioms cardinality_greedy_one_sub_inv_exp_guarantee

end D5.S3.Resource.SubmodularGreedyApproximation

namespace D5.S3.Resource.SubmodularGreedyApproximation

open Finset
open scoped BigOperators
noncomputable section

variable {α : Type*} [DecidableEq α]

/-- The gain from adding one element to a finite set. -/
def marginal (f : Finset α → ℝ) (S : Finset α) (x : α) : ℝ :=
  f (insert x S) - f S

/-- Diminishing returns written in the union/intersection form. -/
def Submodular (f : Finset α → ℝ) : Prop :=
  ∀ A B, f A + f B ≥ f (A ∪ B) + f (A ∩ B)

/-- A finite-set objective is monotone under inclusion. -/
def Monotone (f : Finset α → ℝ) : Prop :=
  ∀ ⦃A B⦄, A ⊆ B → f A ≤ f B

/-- Diminishing returns for nested base sets. -/
theorem marginal_antitone (f : Finset α → ℝ) (hf : Submodular f)
    {A B : Finset α} (hAB : A ⊆ B) {x : α} (hx : x ∉ B) :
    marginal f B x ≤ marginal f A x := by
  have h := hf (insert x A) B
  have hxi : x ∉ A := fun hxa => hx (hAB hxa)
  have hunion : insert x A ∪ B = insert x B := by
    ext z
    simp only [mem_union, mem_insert]
    aesop
  have hinter : insert x A ∩ B = A := by
    ext z
    simp only [mem_inter, mem_insert]
    aesop
  rw [hunion, hinter] at h
  dsimp [marginal]
  linarith

/-- The gain over a union is bounded by the sum of gains at the original base. -/
theorem marginal_sum_bound (f : Finset α → ℝ) (hf : Submodular f)
    (A B : Finset α) :
    f (A ∪ B) - f A ≤ ∑ x ∈ B, marginal f A x := by
  induction B using Finset.induction_on generalizing A with
  | empty => simp
  | @insert x B hx ih =>
      by_cases hxa : x ∈ A
      · have hunion : A ∪ insert x B = A ∪ B := by
          ext z
          simp [hxa]
        rw [hunion, Finset.sum_insert hx]
        simpa [marginal, hxa] using ih A
      · have hxunion : x ∉ A ∪ B := by simp [hxa, hx]
        have hstep := marginal_antitone f hf (A := A) (B := A ∪ B)
          (Finset.subset_union_left) hxunion
        have hmain := ih A
        rw [Finset.sum_insert hx]
        have hset : A ∪ insert x B = (A ∪ B) ∪ {x} := by
          ext z
          simp [Finset.union_left_comm, Finset.union_comm]
        rw [hset]
        have hset' : A ∪ B ∪ {x} = insert x (A ∪ B) := by
          ext z
          simp
        rw [hset']
        dsimp [marginal] at hstep hmain ⊢
        linarith

end
end D5.S3.Resource.SubmodularGreedyApproximation

namespace D5.S3.Resource.SubmodularGreedyApproximation

variable {α : Type*} [DecidableEq α]

/-- One greedy step captures at least the average remaining gain of any comparison set. -/
theorem greedy_step_gap (f : Finset α → ℝ) (hfmono : Monotone f)
    (hfsub : Submodular f) {k : ℕ}
    {O S : Finset α} {e : α} (hO : O.card ≤ k)
    (hgreedy : ∀ x, x ∉ S → marginal f S x ≤ marginal f S e) :
    f O - f S ≤ (k : ℝ) * marginal f S e := by
  have hunion : f O - f S ≤ f (S ∪ O) - f S := by
    gcongr
    exact hfmono Finset.subset_union_right
  have hsum := marginal_sum_bound f hfsub S O
  have hterm : ∀ x ∈ O, marginal f S x ≤ marginal f S e := by
    intro x hxO
    by_cases hxs : x ∈ S
    · have hz : marginal f S x = 0 := by simp [marginal, hxs]
      rw [hz]
      have hnonneg : 0 ≤ marginal f S e := by
        dsimp [marginal]
        exact sub_nonneg.mpr (hfmono (Finset.subset_insert e S))
      exact hnonneg
    · exact hgreedy x hxs
  have hsum' : (∑ x ∈ O, marginal f S x) ≤ ∑ x ∈ O, marginal f S e := by
    exact Finset.sum_le_sum fun x hx => hterm x hx
  have hcard : (O.card : ℝ) ≤ k := by exact_mod_cast hO
  have hnonneg : 0 ≤ marginal f S e := by
    dsimp [marginal]
    exact sub_nonneg.mpr (hfmono (Finset.subset_insert e S))
  have hsumconst : (∑ x ∈ O, marginal f S e) = (O.card : ℝ) * marginal f S e := by
    simp
  rw [hsumconst] at hsum'
  calc
    f O - f S ≤ f (S ∪ O) - f S := hunion
    _ ≤ ∑ x ∈ O, marginal f S x := hsum
    _ ≤ (O.card : ℝ) * marginal f S e := hsum'
    _ ≤ (k : ℝ) * marginal f S e := by gcongr

end D5.S3.Resource.SubmodularGreedyApproximation

namespace D5.S3.Resource.SubmodularGreedyApproximation

variable {α : Type*} [DecidableEq α]

/-- The classical cardinality-greedy approximation guarantee for normalized monotone submodular objectives. -/
theorem cardinality_greedy_one_sub_exp
    (f : Finset α → ℝ) (hfzero : f ∅ = 0) (hfmono : Monotone f)
    (hfsub : Submodular f) (k : ℕ) (hk : 0 < k)
    (O : Finset α) (hO : O.card ≤ k)
    (S : ℕ → Finset α) (e : ℕ → α)
    (hS0 : S 0 = ∅)
    (hstep : ∀ i, i < k → S (i + 1) = insert (e i) (S i))
    (hgreedy : ∀ i, i < k → ∀ x, x ∉ S i →
      marginal f (S i) x ≤ marginal f (S i) (e i)) :
    f (S k) ≥ (1 - Real.exp (-1)) * f O := by
  let g : ℕ → ℝ := fun i => f O - f (S i)
  let q : ℝ := 1 - (1 : ℝ) / k
  have hkRpos : (0 : ℝ) < k := by exact_mod_cast hk
  have hkRone : (1 : ℝ) ≤ k := by
    exact_mod_cast (Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hk))
  have hq : 0 ≤ q := by
    dsimp [q]
    apply sub_nonneg.mpr
    apply (div_le_iff₀ hkRpos).2
    nlinarith
  have hrec : ∀ i, i < k → g (i + 1) ≤ q * g i := by
    intro i hi
    have hgap := greedy_step_gap f hfmono hfsub hO (hgreedy i hi)
    have hquot : g i / (k : ℝ) ≤ marginal f (S i) (e i) := by
      apply (div_le_iff₀ hkRpos).2
      dsimp [g]
      simpa [mul_comm] using hgap
    have hident : g (i + 1) = g i - marginal f (S i) (e i) := by
      dsimp [g, marginal]
      rw [hstep i hi]
      ring
    have hquot' :
        (1 : ℝ) / (k : ℝ) * g i ≤ marginal f (S i) (e i) := by
      simpa [div_eq_mul_inv, mul_comm, mul_left_comm, mul_assoc] using hquot
    rw [hident]
    dsimp [q]
    linarith
  have hiter : ∀ i, i ≤ k → g i ≤ q ^ i * g 0 := by
    intro i hi
    induction i with
    | zero => simp
    | succ i ih =>
        have hil : i < k := by omega
        have hri := hrec i hil
        have hmul : q * g i ≤ q * (q ^ i * g 0) := by
          exact mul_le_mul_of_nonneg_left (ih (by omega)) hq
        calc
          g (i + 1) ≤ q * g i := hri
          _ ≤ q * (q ^ i * g 0) := hmul
          _ = q ^ (i + 1) * g 0 := by ring
  have hpow : q ^ k ≤ Real.exp (-1) := by
    dsimp [q]
    apply Real.one_sub_div_pow_le_exp_neg
    exact hkRone
  have hfinal := hiter k (le_rfl)
  have hg0 : g 0 = f O := by
    dsimp [g]
    rw [hS0, hfzero]
    ring
  rw [hg0] at hfinal
  have hmul : q ^ k * f O ≤ Real.exp (-1) * f O := by
    exact mul_le_mul_of_nonneg_right hpow (by
      have hnonnegO : 0 ≤ f O := by
        have h := hfmono (Finset.empty_subset O)
        rw [hfzero] at h
        linarith
      exact hnonnegO)
  dsimp [g] at hfinal
  linarith

end D5.S3.Resource.SubmodularGreedyApproximation
