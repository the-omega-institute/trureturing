import Mathlib.Algebra.Group.End
import Mathlib.Algebra.Group.Submonoid.Basic
import Mathlib.Algebra.Group.TypeTags.Finite
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Fintype.Prod
import Mathlib.Data.ZMod.Defs

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.StatisticalMechanics.CellularAutomata.LazyInvertibleGeneration

/-!
E. Alcalá-Arroyo and A. Castillo-Ramirez, *On the order of lazy cellular automata*,
arXiv:2510.14841 (Theoret. Comput. Sci. 1076 (2026) 115965), Problem 2: for a group `G` and an
alphabet `A` with at least two symbols, prove or disprove that every cellular automaton over
`A^G` is a composition of invertible and lazy cellular automata,
`CA(G, A) = ⟨ICA(G, A) ∪ L(G, A)⟩`. A cellular automaton has a finite neighborhood `S` and a
local map `μ : A^S → A` with `τ(x)(g) = μ((g · x)|_S)`, where `(g · x)(h) = x(h g)`; it is lazy
when `1 ∈ S` and `μ z = z(1)` holds for every pattern `z` except one. The statement fails for
the Klein four-group and the binary alphabet.
-/

/-- A cellular automaton over `A^G`: there are a finite neighborhood `S` and a local map `μ`
with `T x g = μ ((g · x)|_S)`, where `(g · x) h = x (h * g)`. -/
def IsCA {G A : Type} [Group G] (T : Function.End (G → A)) : Prop :=
  ∃ (S : Finset G) (μ : (S → A) → A), ∀ (x : G → A) (g : G), T x g = μ fun s => x (s.1 * g)

/-- A lazy cellular automaton: its neighborhood contains `1`, and its local map returns the
value at `1` on every pattern except one, the unique active transition `p`. -/
def IsLazy {G A : Type} [Group G] (T : Function.End (G → A)) : Prop :=
  ∃ (S : Finset G) (he : (1 : G) ∈ S) (μ : (S → A) → A) (p : S → A),
    (∀ z, μ z = z ⟨1, he⟩ ↔ z ≠ p) ∧ ∀ (x : G → A) (g : G), T x g = μ fun s => x (s.1 * g)

/-- An invertible cellular automaton: a unit of the monoid of cellular automata. -/
def IsInvertibleCA {G A : Type} [Group G] (T : Function.End (G → A)) : Prop :=
  IsCA T ∧ ∃ T' : Function.End (G → A), IsCA T' ∧ T' * T = 1 ∧ T * T' = 1

/-- Problem 2 of Alcalá-Arroyo and Castillo-Ramirez, answered positively: for every group `G`
and every finite alphabet `A` with at least two symbols, every cellular automaton is in the
submonoid generated by the invertible and the lazy cellular automata. -/
def claim : Prop :=
  ∀ (G : Type) [Group G] (A : Type) [Finite A] [Nontrivial A] (T : Function.End (G → A)),
    IsCA T → T ∈ Submonoid.closure ({T | IsInvertibleCA T} ∪ {T | IsLazy T})

set_option synthInstance.maxSize 2048 in
-- `result` is one declaration that contains every lemma of the proof as a local `have`.
/-- Problem 2 has a negative answer: over the Klein four-group with the binary alphabet, the
automaton that complements the configurations with exactly one `true` cell and fixes all
others is not a composition of invertible and lazy cellular automata. -/
theorem result : ¬ claim := by
  intro h
  -- Parity facts on the 16 configurations of the Klein four-group.
  have hA : ∀ x : Multiplicative (ZMod 2 × ZMod 2) → Bool,
      (Finset.univ.filter fun g => x g = true).card % 2 = 0 →
        ∃ k : Multiplicative (ZMod 2 × ZMod 2), k ≠ 1 ∧ ∀ g, x (g * k) = x g := by
    decide
  have hB : ∀ (x : Multiplicative (ZMod 2 × ZMod 2) → Bool)
      (k : Multiplicative (ZMod 2 × ZMod 2)), k ≠ 1 → (∀ g, x (g * k) = x g) →
        (Finset.univ.filter fun g => x g = true).card % 2 = 0 := by
    decide
  have hD : ∀ x : Multiplicative (ZMod 2 × ZMod 2) → Bool,
      (Finset.univ.filter fun g => x g = true).card % 2 = 1 →
        (∃ u, ∀ g, x g = true ↔ g = u) ∨ ∃ u, ∀ g, x g = false ↔ g = u := by
    decide
  have hE : ∀ (g₀ : Multiplicative (ZMod 2 × ZMod 2))
      (x y : Multiplicative (ZMod 2 × ZMod 2) → Bool),
      (Finset.univ.filter fun g => x g = true).card % 2 = 1 → (∀ g, g ≠ g₀ → y g = x g) →
        (∀ g, y g = x g) ∨ (Finset.univ.filter fun g => y g = true).card % 2 = 0 := by
    decide
  have hW : ∀ (x : Multiplicative (ZMod 2 × ZMod 2) → Bool)
      (g : Multiplicative (ZMod 2 × ZMod 2)),
      (Finset.univ.filter fun h => x (h * g) = true).card =
        (Finset.univ.filter fun h => x h = true).card := by
    decide
  -- The witness `F`: complement the configurations of weight one.
  obtain ⟨F, hF⟩ : ∃ F : Function.End (Multiplicative (ZMod 2 × ZMod 2) → Bool), ∀ x,
      F x = if (Finset.univ.filter fun g => x g = true).card = 1 then fun g => !x g else x :=
    ⟨fun x => if (Finset.univ.filter fun g => x g = true).card = 1 then fun g => !x g else x,
      fun _ => rfl⟩
  have hFca : IsCA F := by
    refine ⟨Finset.univ, fun z => F (fun h => z ⟨h, Finset.mem_univ h⟩) 1, fun x g => ?_⟩
    change F x g = F (fun h => x (h * g)) 1
    rw [hF, hF, hW x g]
    split_ifs <;> simp
  -- Cellular automata commute with the shifts.
  have hCAeqv : ∀ T : Function.End (Multiplicative (ZMod 2 × ZMod 2) → Bool), IsCA T →
      ∀ x k, T (fun g => x (g * k)) = fun g => T x (g * k) := by
    rintro T ⟨S, μ, hT⟩ x k
    funext g
    rw [hT, hT]
    simp only [mul_assoc]
  -- A shift-equivariant map sends even weight to even weight.
  have hOdd : ∀ T : Function.End (Multiplicative (ZMod 2 × ZMod 2) → Bool),
      (∀ x k, T (fun g => x (g * k)) = fun g => T x (g * k)) → ∀ x,
        (Finset.univ.filter fun g => T x g = true).card % 2 = 1 →
          (Finset.univ.filter fun g => x g = true).card % 2 = 1 := by
    intro T hT x hx
    by_contra hne
    obtain ⟨k, hk, hxk⟩ := hA x (by omega)
    have hfix : (fun g => x (g * k)) = x := funext hxk
    have := hB (T x) k hk fun g => by rw [← congrFun (hT x k) g, hfix]
    omega
  -- A shift-equivariant map sends constant configurations to constant configurations.
  have hConst : ∀ T : Function.End (Multiplicative (ZMod 2 × ZMod 2) → Bool),
      (∀ x k, T (fun g => x (g * k)) = fun g => T x (g * k)) → ∀ b : Bool,
        T (fun _ => b) = fun _ => T (fun _ => b) 1 := by
    intro T hT b
    funext g
    have := congrFun (hT (fun _ => b) g) 1
    simp only [one_mul] at this
    exact this.symm
  -- The invariant, satisfied by every element of the generated submonoid.
  have key := Submonoid.closure_induction
    (s := ({T | IsInvertibleCA T} ∪ {T | IsLazy T} :
      Set (Function.End (Multiplicative (ZMod 2 × ZMod 2) → Bool))))
    (motive := fun T _ => (∀ x k, T (fun g => x (g * k)) = fun g => T x (g * k)) ∧
      (T (fun _ => false) ≠ T (fun _ => true) → ∀ x y,
        (Finset.univ.filter fun g => x g = true).card % 2 = 1 →
        (Finset.univ.filter fun g => y g = true).card % 2 = 1 →
        (Finset.univ.filter fun g => T x g = true).card % 2 = 1 → T x = T y → x = y))
    (fun T hT => by
      rcases hT with ⟨hca, T', -, hT'T, -⟩ | ⟨S, he, μ, p, hμ, hT⟩
      · refine ⟨hCAeqv T hca, fun _ x y _ _ _ hxy => ?_⟩
        have hx : T' (T x) = x := congrFun hT'T x
        have hy : T' (T y) = y := congrFun hT'T y
        rw [← hx, ← hy, hxy]
      · refine ⟨hCAeqv T ⟨S, μ, hT⟩, fun hc x y hx hy hTx hxy => ?_⟩
        -- Away from an occurrence of `p`, a cell keeps its value.
        have hkeep : ∀ x g, (fun s : S => x (s.1 * g)) ≠ p → T x g = x g := by
          intro x g hne
          rw [hT, (hμ _).2 hne]
          simp
        by_cases hconst : ∀ s, p s = p ⟨1, he⟩
        · -- A constant pattern sends both constant configurations to the same one.
          exfalso
          apply hc
          have hb : ∀ c : Bool, T (fun _ => c) = fun _ => !p ⟨1, he⟩ := by
            intro c
            funext g
            rw [hT]
            by_cases hcp : (fun _ : S => c) = p
            · rw [hcp]
              have hμp : μ p ≠ p ⟨1, he⟩ := fun e => (hμ p).1 e rfl
              revert hμp
              generalize μ p = a
              generalize p ⟨1, he⟩ = b
              revert a b
              decide
            · rw [(hμ _).2 hcp]
              have hc' : c ≠ p ⟨1, he⟩ := fun e => hcp (funext fun s => by rw [e, hconst s])
              clear hcp
              revert hc'
              generalize p ⟨1, he⟩ = b
              revert c b
              decide
          rw [hb, hb]
        · -- A non-constant pattern changes at most one cell of an odd-weight configuration.
          push Not at hconst
          obtain ⟨s', hs'⟩ := hconst
          obtain ⟨s₁, hs₁⟩ : ∃ s₁, p s₁ = true := by
            cases h1 : p ⟨1, he⟩
            · exact ⟨s', by simpa [h1] using hs'⟩
            · exact ⟨⟨1, he⟩, h1⟩
          obtain ⟨s₀, hs₀⟩ : ∃ s₀, p s₀ = false := by
            cases h1 : p ⟨1, he⟩
            · exact ⟨⟨1, he⟩, h1⟩
            · exact ⟨s', by simpa [h1] using hs'⟩
          have hstep : ∀ z, (Finset.univ.filter fun g => z g = true).card % 2 = 1 →
              T z = z ∨ (Finset.univ.filter fun g => T z g = true).card % 2 = 0 := by
            intro z hz
            rcases hD z hz with ⟨u, hu⟩ | ⟨u, hu⟩
            · rcases hE (s₁.1⁻¹ * u) z (T z) hz fun g hg => hkeep z g fun hzp => hg
                (eq_inv_mul_of_mul_eq ((hu _).1 (by rw [congrFun hzp s₁, hs₁]))) with h | h
              · exact Or.inl (funext h)
              · exact Or.inr h
            · rcases hE (s₀.1⁻¹ * u) z (T z) hz fun g hg => hkeep z g fun hzp => hg
                (eq_inv_mul_of_mul_eq ((hu _).1 (by rw [congrFun hzp s₀, hs₀]))) with h | h
              · exact Or.inl (funext h)
              · exact Or.inr h
          rcases hstep x hx with h1 | h1
          · rcases hstep y hy with h2 | h2
            · rw [← h1, ← h2, hxy]
            · rw [← hxy] at h2
              omega
          · omega)
    ⟨fun _ _ => rfl, fun _ _ _ _ _ _ h => h⟩
    (fun T₂ T₁ _ _ h₂ h₁ => by
      refine ⟨fun x k => ?_, fun hc x y hx hy hTx hxy => ?_⟩
      · change T₂ (T₁ fun g => x (g * k)) = fun g => T₂ (T₁ x) (g * k)
        rw [h₁.1, h₂.1]
      · change T₂ (T₁ _) ≠ T₂ (T₁ _) at hc
        change (Finset.univ.filter fun g => T₂ (T₁ x) g = true).card % 2 = 1 at hTx
        change T₂ (T₁ x) = T₂ (T₁ y) at hxy
        have hc₁ : T₁ (fun _ => false) ≠ T₁ (fun _ => true) := fun e => hc (by rw [e])
        have hc₂ : T₂ (fun _ => false) ≠ T₂ (fun _ => true) := by
          rw [hConst T₁ h₁.1 false, hConst T₁ h₁.1 true] at hc
          revert hc
          generalize T₁ (fun _ => false) 1 = b₀
          generalize T₁ (fun _ => true) 1 = b₁
          cases b₀ <;> cases b₁
          · exact fun hc => absurd rfl hc
          · exact id
          · exact Ne.symm
          · exact fun hc => absurd rfl hc
        have hx₁ := hOdd T₂ h₂.1 _ hTx
        have hy₁ := hOdd T₂ h₂.1 (T₁ y) (by rw [← hxy]; exact hTx)
        exact h₁.2 hc₁ x y hx hy hx₁ (h₂.2 hc₂ _ _ hx₁ hy₁ hTx hxy))
    (h (Multiplicative (ZMod 2 × ZMod 2)) Bool F hFca)
  -- `F` separates the constants but merges a weight-one and a weight-three configuration.
  have hsep : F (fun _ => false) ≠ F (fun _ => true) := by
    rw [hF, hF]
    decide
  have hmerge : F (fun g => decide (g = 1)) = F (fun g => !decide (g = 1)) := by
    rw [hF, hF]
    decide
  have hodd : (Finset.univ.filter fun g => F (fun g => decide (g = 1)) g = true).card % 2 = 1 := by
    rw [hF]
    decide
  have hne : (fun g : Multiplicative (ZMod 2 × ZMod 2) => decide (g = 1)) ≠
      fun g => !decide (g = 1) := fun e => by simpa using congrFun e 1
  exact hne (key.2 hsep _ _ (by decide) (by decide) hodd hmerge)

end D5.S3.StatisticalMechanics.CellularAutomata.LazyInvertibleGeneration
