/-- Rational slope and intercept assigned to an actual geometric state.
Sharing a coefficient pair is storage only and asserts no state quotient. -/
def affineCoefficients (i : Fin 881) : ℚ × ℚ :=
  let p := coefficients[assignments[i.val]! / 28]!
  ((p.1 : ℚ) / 1000000, (p.2 : ℚ) / 1000000)

/-- Three base-three digits select lower, upper or interior coordinates.
The distinguished value 27 selects the nonnegative-residual certificate. -/
def affinePattern (i : Fin 881) : ℕ := assignments[i.val]! % 28

