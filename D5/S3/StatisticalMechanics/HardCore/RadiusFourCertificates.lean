-- Split only the outer state domain, retaining every direction and conjunct.
-- Fin.addCases supplies the proof that the two halves cover it.
private partial def decideRows : Lean.Elab.Tactic.TacticM Unit :=
  Lean.Elab.Tactic.withMainContext do
    let goal ← Lean.Elab.Tactic.getMainGoal
    let type ← Lean.Meta.whnf (← goal.getType)
    if let .forallE _ dom _ _ := type then
      if let .app (.const ``Fin _) size := dom then
        if let .lit (.natVal n) ← Lean.Meta.whnf size then
          if n > 4 then
            let m := n / 2
            Lean.Elab.Tactic.evalTactic (← `(tactic|
              refine Fin.addCases (m := $(Lean.quote m))
                (n := $(Lean.quote (n - m))) ?_ ?_))
            let goals ← Lean.Elab.Tactic.getGoals
            for g in goals do
              Lean.Elab.Tactic.setGoals [g]
              decideRows
            return
    Lean.Elab.Tactic.evalTactic (← `(tactic| decide +kernel))

private def row (i : Fin 851) : ℕ × ℕ := radiusFourRows[i.val]!

private def pointList : List Point := [
  (-4,0), (-3,-1), (-3,0), (-3,1), (-2,-2), (-2,-1), (-2,0), (-2,1),
  (-2,2), (-1,-3), (-1,-2), (-1,-1), (-1,0), (-1,1), (-1,2), (-1,3),
  (0,-4), (0,-3), (0,-2), (0,-1), (0,1), (0,2), (0,3), (0,4),
  (1,-3), (1,-2), (1,-1), (1,0), (1,1), (1,2), (1,3), (2,-2),
  (2,-1), (2,0), (2,1), (2,2), (3,-1), (3,0), (3,1), (4,0), (0,0)]

private def point (k : Fin 41) : Point := pointList[k.val]!

private def encode (F : Finset Point) : ℕ :=
  ∑ k : Fin 41, if point k ∈ F then 2 ^ k.val else 0

/-- Decode the actual geometric blocked set of a represented state. -/
def radiusFourMask (i : Fin 851) : Finset Point :=
  (Finset.univ.filter fun k : Fin 41 => (row i).1.testBit k.val).image point

-- Generated by sorting the row codes, retaining their original indices, and
-- recursively choosing the median. The certificates below check the result.
private inductive CodeTree where
  | nil
  | node (code : ℕ) (index : Fin 851) (left right : CodeTree)

private def CodeTree.find (code : ℕ) : CodeTree → Option (Fin 851)
  | .nil => none
  | .node key index left right =>
      if code < key then left.find code
      else if key < code then right.find code
      else some index

