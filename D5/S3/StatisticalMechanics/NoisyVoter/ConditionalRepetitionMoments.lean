import D5.S3.StatisticalMechanics.NoisyVoter.RectangularSupport
import Mathlib.Probability.ConditionalExpectation
import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut

/-! # Conditional moments of native repetition counts -/

open MeasureTheory ProbabilityTheory Filter
open scoped BigOperators ENNReal

namespace D5.S3.StatisticalMechanics.NoisyVoter.ConditionalRepetitionMoments

open RepetitionVarianceLinear AncestralSources
open D5.S3.Combinatorics.IsingUniquenessSets (sgn)

variable {V Ω : Type} {G : SimpleGraph V} [G.LocallyFinite] [MeasurableSpace Ω]

/-- Only strictly positive-time refresh and neighbour-choice coordinates. -/
def positiveControl : Coord V → Prop
  | .refresh n _ | .choice n _ => 0 < n
  | _ => False

abbrev Controls (G : SimpleGraph V) [G.LocallyFinite] :=
  (c : {c : Coord V // positiveControl c}) → Value G c.val

def controls (M : Model G (P : Measure Ω)) (ω : Ω) : Controls G :=
  fun c => M.coordinate c.val ω

/-- The sigma-field generated by every actual positive-time control coordinate. -/
@[instance_reducible]
def H (M : Model G (P : Measure Ω)) : MeasurableSpace Ω :=
  MeasurableSpace.comap (controls M) inferInstance

private theorem H_le (P : Measure Ω) (M : Model G P) : H M ≤ ‹MeasurableSpace Ω› :=
  (measurable_pi_iff.mpr (fun c => M.measurable_coordinate c.val)).comap_le

private theorem controls_measurable (P : Measure Ω) (M : Model G P) :
    @Measurable Ω (Controls G) (H M) inferInstance (controls M) :=
  measurable_iff_comap_le.mpr le_rfl

omit [G.LocallyFinite] [MeasurableSpace Ω] in
/-- Sources use neither opinion values nor auxiliary coordinates at time zero. -/
private theorem source_control_congr {Ω' : Type}
    (x : (c : Coord V) → Ω → Value G c)
    (y : (c : Coord V) → Ω' → Value G c) (ω : Ω) (ω' : Ω')
    (h : ∀ c, positiveControl c → x c ω = y c ω') :
    ∀ n v, source x n v ω = source y n v ω' := by
  intro n
  induction n with
  | zero => intros; rfl
  | succ n ih =>
      intro v
      simp only [source, h (.refresh (n + 1) v) (Nat.succ_pos n),
        h (.choice (n + 1) v) (Nat.succ_pos n)]
      split_ifs
      · rfl
      · exact ih _

private noncomputable def fill (M : Model G (P : Measure Ω)) (z : Controls G) :
    (c : Coord V) → Value G c
  | .initial _ | .fresh _ _ => false
  | .refresh 0 _ => false
  | .refresh (n + 1) v => z ⟨.refresh (n + 1) v, Nat.succ_pos n⟩
  | .choice 0 v => ⟨(M.hasNeighbor v).choose, (M.hasNeighbor v).choose_spec⟩
  | .choice (n + 1) v => z ⟨.choice (n + 1) v, Nat.succ_pos n⟩

private theorem fill_measurable (P : Measure Ω) (M : Model G P) (c : Coord V) :
    Measurable (fun z => fill M z c) := by
  cases c with
  | initial v => exact measurable_const
  | fresh n v => exact measurable_const
  | refresh n v => cases n <;> first | exact measurable_const | exact measurable_pi_apply _
  | choice n v => cases n <;> first | exact measurable_const | exact measurable_pi_apply _

private theorem source_H (P : Measure Ω) (M : Model G P) (n : ℕ) (v : V) :
    @Measurable Ω (Label V) (H M) inferInstance (source M.coordinate n v) := by
  have hm := (source_measurable (fun c z => fill M z c)
    (fill_measurable P M) n v).comp (controls_measurable P M)
  convert hm using 1
  funext ω
  apply source_control_congr
  intro c hc
  cases c with
  | initial v => exact False.elim hc
  | fresh n v => exact False.elim hc
  | refresh n v => cases n with
    | zero => exact False.elim (by simp [positiveControl] at hc)
    | succ n => rfl
  | choice n v => cases n with
    | zero => exact False.elim (by simp [positiveControl] at hc)
    | succ n => rfl

private theorem coins_controls_independent (P : Measure Ω) (M : Model G P) :
    IndepFun (fun ω (l : Label V) => coin M.coordinate l ω) (controls M) P := by
  classical
  let A : Set (Coord V) := {c | positiveControl c}
  let B : Set (Coord V) := {c | ¬ positiveControl c}
  have hi := M.independent.indepFun_set B A disjoint_compl_left M.measurable_coordinate
  let g (z : (c : B) → Value G c.val) (l : Label V) : Bool :=
    match l with
    | .inl v => z ⟨.initial v, by simp [B, positiveControl]⟩
    | .inr p => z ⟨.fresh p.1.val p.2, by simp [B, positiveControl]⟩
  have hg : Measurable g := measurable_pi_iff.mpr (by
    intro l; cases l <;> exact measurable_pi_apply _)
  have hh := hi.comp hg measurable_id
  convert hh using 1 <;> first | rfl | (funext ω l; cases l <;> rfl)

/-- Actual number of coalesced observation pairs. -/
noncomputable def C (M : Model G (P : Measure Ω)) (u : V) (d t : ℕ) (ω : Ω) : ℝ := by
  classical
  exact ∑ i ∈ Finset.Icc 1 t,
    if source M.coordinate i u ω = source M.coordinate (i + d) u ω then 1 else 0

/-- Unordered, noncoalesced native source-pair multiplicity. -/
noncomputable def multiplicity (M : Model G (P : Measure Ω)) (u : V) (d t : ℕ)
    (e : Finset (Label V)) (ω : Ω) : ℕ := by
  classical
  exact ((Finset.Icc 1 t).filter (fun i =>
    source M.coordinate i u ω ≠ source M.coordinate (i + d) u ω ∧
    {source M.coordinate i u ω, source M.coordinate (i + d) u ω} = e)).card

noncomputable def pairs (G : SimpleGraph V) [G.LocallyFinite] (u : V) (N : ℕ) :=
  (RectangularSupport.L G u N).powersetCard 2

noncomputable def character (M : Model G (P : Measure Ω)) (e : Finset (Label V))
    (ω : Ω) : ℝ := ∏ l ∈ e, sgn (coin M.coordinate l ω)


private theorem coin_measurable (P : Measure Ω) (M : Model G P) (l : Label V) :
    Measurable (coin M.coordinate l) := by
  cases l <;> exact M.measurable_coordinate _

private theorem character_measurable (P : Measure Ω) (M : Model G P)
    (e : Finset (Label V)) : Measurable (character M e) := by
  classical
  exact Finset.measurable_prod _ (fun l _ =>
    (measurable_of_finite sgn).comp (coin_measurable P M l))

private theorem character_norm (P : Measure Ω) (M : Model G P)
    (e : Finset (Label V)) (ω : Ω) : ‖character M e ω‖ ≤ 1 := by
  classical
  have hs (l : Label V) : ‖sgn (coin M.coordinate l ω)‖ = 1 := by
    cases coin M.coordinate l ω <;> norm_num [sgn]
  simp [character, norm_prod, hs]

private theorem bounded_integrable (P : Measure Ω) [IsProbabilityMeasure P]
    {f : Ω → ℝ} (hf : Measurable f) (b : ℝ) (hb : ∀ ω, ‖f ω‖ ≤ b) : Integrable f P :=
  (show MemLp f 2 P from MemLp.of_bound hf.aestronglyMeasurable b
    (Eventually.of_forall hb)).integrable one_le_two

private theorem character_integrable (P : Measure Ω) (M : Model G P)
    (e : Finset (Label V)) : Integrable (character M e) P := by
  let := M.probability
  exact bounded_integrable P (character_measurable P M e) 1 (character_norm P M e)

open Classical in
private theorem character_pair (P : Measure Ω) (M : Model G P)
    (a b : Label V) (hab : a ≠ b) (ω : Ω) :
    character M {a,b} ω = sgn (coin M.coordinate a ω) * sgn (coin M.coordinate b ω) := by
  classical
  simp [character, hab]

private theorem character_mean (P : Measure Ω) (M : Model G P)
    (e : Finset (Label V)) (he : e.card = 2) : (∫ ω, character M e ω ∂P) = 0 := by
  classical
  obtain ⟨a,b,hab,rfl⟩ := Finset.card_eq_two.mp he
  simpa only [character_pair P M a b hab, ite_eq_right hab] using fixed_pair_sign_mean P M a b

open Classical in
private theorem character_cross_mean (P : Measure Ω) (M : Model G P)
    (e f : Finset (Label V)) (he : e.card = 2) (hf : f.card = 2) :
    (∫ ω, character M e ω * character M f ω ∂P) = if e = f then 1 else 0 := by
  classical
  obtain ⟨a,b,hab,rfl⟩ := Finset.card_eq_two.mp he
  obtain ⟨c,d,hcd,rfl⟩ := Finset.card_eq_two.mp hf
  simp_rw [character_pair P M a b hab, character_pair P M c d hcd]
  rw [fixed_four_sign_mean P M a b c d]
  congr 1
  have hpair : ({a,b} : Finset (Label V)) = {c,d} ↔
      (a = c ∧ b = d) ∨ (a = d ∧ b = c) := by
    rw [← Finset.coe_inj]
    simpa only [Finset.coe_insert, Finset.coe_singleton] using
      (Set.pair_eq_pair_iff (x := a) (y := b) (z := c) (w := d))
  simp [hab, hcd, hpair]

private theorem character_condExp (P : Measure Ω) (M : Model G P)
    (e : Finset (Label V)) :
    P[character M e | H M] =ᵐ[P] fun _ => ∫ ω, character M e ω ∂P := by
  classical
  let := M.probability
  let g (x : Label V → Bool) : ℝ := ∏ l ∈ e, sgn (x l)
  have hg : Measurable g := Finset.measurable_prod _ (fun l _ =>
    (measurable_of_finite sgn).comp (measurable_pi_apply l))
  have hi := (coins_controls_independent P M).comp hg measurable_id
  have hsm : StronglyMeasurable[MeasurableSpace.comap (character M e) inferInstance]
      (character M e) := (measurable_iff_comap_le.mpr le_rfl).stronglyMeasurable
  exact condExp_indep_eq (character_measurable P M e).comap_le (H_le P M) hsm
    ((IndepFun_iff_Indep _ _ P).mp hi)

private theorem character_cross_condExp (P : Measure Ω) (M : Model G P)
    (e f : Finset (Label V)) :
    P[(fun ω => character M e ω * character M f ω) | H M] =ᵐ[P]
      fun _ => ∫ ω, character M e ω * character M f ω ∂P := by
  classical
  let := M.probability
  let g (x : Label V → Bool) : ℝ := (∏ l ∈ e, sgn (x l)) * (∏ l ∈ f, sgn (x l))
  have hg : Measurable g := (Finset.measurable_prod _ (fun l _ =>
    (measurable_of_finite sgn).comp (measurable_pi_apply l))).mul
    (Finset.measurable_prod _ (fun l _ =>
      (measurable_of_finite sgn).comp (measurable_pi_apply l)))
  have hi := (coins_controls_independent P M).comp hg measurable_id
  have hm := (character_measurable P M e).mul (character_measurable P M f)
  exact condExp_indep_eq hm.comap_le (H_le P M)
    (measurable_iff_comap_le.mpr le_rfl).stronglyMeasurable
    ((IndepFun_iff_Indep _ _ P).mp hi)

private theorem C_H (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ) :
    @Measurable Ω ℝ (H M) inferInstance (C M u d t) := by
  classical
  let : Countable V := RectangularSupport.vertices_countable M.connected u
  apply Finset.measurable_sum
  intro i hi
  exact Measurable.ite (measurableSet_eq_fun (source_H P M i u)
    (source_H P M (i + d) u)) measurable_const measurable_const

open Classical in
private theorem multiplicity_sum (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e : Finset (Label V)) (ω : Ω) :
    (multiplicity M u d t e ω : ℝ) = ∑ i ∈ Finset.Icc 1 t,
      if source M.coordinate i u ω ≠ source M.coordinate (i + d) u ω ∧
        {source M.coordinate i u ω, source M.coordinate (i + d) u ω} = e then 1 else 0 := by
  classical
  simp [multiplicity, Finset.sum_boole]

private theorem multiplicity_H (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e : Finset (Label V)) :
    @Measurable Ω ℝ (H M) inferInstance (fun ω => (multiplicity M u d t e ω : ℝ)) := by
  classical
  let : Countable V := RectangularSupport.vertices_countable M.connected u
  simp_rw [multiplicity_sum]
  apply Finset.measurable_sum
  intro i hi
  exact (measurable_of_countable (fun p : Label V × Label V =>
    if p.1 ≠ p.2 ∧ {p.1,p.2} = e then (1 : ℝ) else 0)).comp
      ((source_H P M i u).prodMk (source_H P M (i + d) u))

private theorem multiplicity_bound (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e : Finset (Label V)) (ω : Ω) : ‖(multiplicity M u d t e ω : ℝ)‖ ≤ t := by
  classical
  rw [Real.norm_natCast, Nat.cast_le]
  exact (Finset.card_filter_le _ _).trans (by simp)


private theorem C_bound (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ) (ω : Ω) :
    ‖C M u d t ω‖ ≤ t := by
  classical
  apply (norm_sum_le _ _).trans
  calc
    _ ≤ ∑ i ∈ Finset.Icc 1 t, (1 : ℝ) := by
      apply Finset.sum_le_sum
      intro i hi
      split_ifs <;> norm_num
    _ = t := by simp

private theorem source_support (P : Measure Ω) (M : Model G P) (u : V) (N : ℕ)
    (i : ℕ) (hi : i ≤ N) (ω : Ω) :
    source M.coordinate i u ω ∈ RectangularSupport.L G u N := by
  obtain ⟨f,hf,hfs⟩ := (RectangularSupport.rectangular_history_support
    (Ω := Ω) M.connected M.hasNeighbor u N).2.2.2.2.2
  exact (hfs M.coordinate ω).2 ⟨i, by omega⟩

open Classical in
private theorem source_pair_mem (P : Measure Ω) (M : Model G P) (u : V) (d t i : ℕ)
    (hi : i ∈ Finset.Icc 1 t) (ω : Ω)
    (hne : source M.coordinate i u ω ≠ source M.coordinate (i + d) u ω) :
    {source M.coordinate i u ω, source M.coordinate (i + d) u ω} ∈ pairs G u (t + d) := by
  classical
  apply Finset.mem_powersetCard.mpr
  constructor
  · intro l hl
    simp only [Finset.mem_insert, Finset.mem_singleton] at hl
    rcases hl with rfl | rfl
    · exact source_support P M u (t + d) i (by have := Finset.mem_Icc.mp hi; omega) ω
    · exact source_support P M u (t + d) (i + d) (by have := Finset.mem_Icc.mp hi; omega) ω
  · simp [hne]

open Classical in
private theorem grouped_characters (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (ω : Ω) :
    (∑ e ∈ pairs G u (t + d), (multiplicity M u d t e ω : ℝ) * character M e ω) =
      ∑ i ∈ Finset.Icc 1 t,
        if source M.coordinate i u ω = source M.coordinate (i + d) u ω then 0
        else sgn (coin M.coordinate (source M.coordinate i u ω) ω) *
          sgn (coin M.coordinate (source M.coordinate (i + d) u ω) ω) := by
  classical
  simp_rw [multiplicity_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro i hi
  by_cases heq : source M.coordinate i u ω = source M.coordinate (i + d) u ω
  · simp [heq]
  · rw [ite_eq_right heq]
    rw [Finset.sum_eq_single_of_mem
      {source M.coordinate i u ω, source M.coordinate (i + d) u ω}
      (source_pair_mem P M u d t i hi ω heq)]
    · simp [heq, character_pair P M _ _ heq]
    · intro e he hne
      simp [Ne.symm hne]

private theorem repetition_expansion (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (ω : Ω) : W M.coordinate u d t ω = ((t : ℝ) + C M u d t ω) / 2 +
      (1/2 : ℝ) * ∑ e ∈ pairs G u (t + d),
        (multiplicity M u d t e ω : ℝ) * character M e ω := by
  classical
  rw [grouped_characters]
  have ht : (t : ℝ) = ∑ i ∈ Finset.Icc 1 t, (1 : ℝ) := by simp
  rw [ht]
  unfold W C
  simp_rw [repetition_spin, native_source]
  rw [← Finset.sum_add_distrib, Finset.sum_div, Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  by_cases heq : source M.coordinate i u ω = source M.coordinate (i + d) u ω
  · rw [heq]
    have hs : sgn (coin M.coordinate (source M.coordinate (i + d) u ω) ω) ^ 2 = 1 := by
      cases coin M.coordinate (source M.coordinate (i + d) u ω) ω <;> norm_num [sgn]
    simp [← pow_two, hs]
  · simp only [ite_eq_right heq]
    ring


private noncomputable def term (M : Model G (P : Measure Ω)) (u : V) (d t : ℕ)
    (e : Finset (Label V)) (ω : Ω) : ℝ :=
  (multiplicity M u d t e ω : ℝ) * character M e ω

private theorem term_measurable (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e : Finset (Label V)) : Measurable (term M u d t e) :=
  ((multiplicity_H P M u d t e).mono (H_le P M) le_rfl).mul
    (character_measurable P M e)

private theorem term_bound (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e : Finset (Label V)) (ω : Ω) : ‖term M u d t e ω‖ ≤ t := by
  rw [term, norm_mul]
  calc
    _ ≤ (t : ℝ) * 1 := mul_le_mul (multiplicity_bound P M u d t e ω)
      (character_norm P M e ω) (norm_nonneg _) (Nat.cast_nonneg _)
    _ = t := mul_one _

private theorem term_integrable (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e : Finset (Label V)) : Integrable (term M u d t e) P := by
  let := M.probability
  exact bounded_integrable P (term_measurable P M u d t e) t (term_bound P M u d t e)

private theorem term_condExp (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e : Finset (Label V)) (he : e ∈ pairs G u (t + d)) :
    P[term M u d t e | H M] =ᵐ[P] 0 := by
  let := M.probability
  have hp := condExp_stronglyMeasurable_mul_of_bound (H_le P M)
    (multiplicity_H P M u d t e).stronglyMeasurable (character_integrable P M e)
    t (Eventually.of_forall (multiplicity_bound P M u d t e))
  have hc := character_condExp P M e
  have hm := character_mean P M e (Finset.mem_powersetCard.mp he).2
  filter_upwards [hp,hc] with ω h1 h2
  change P[(fun ω => (multiplicity M u d t e ω : ℝ) * character M e ω) | H M] ω = 0
  simpa only [Pi.mul_def, h2, hm, mul_zero, Pi.zero_apply] using h1

private theorem cross_integrable (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e f : Finset (Label V)) :
    Integrable (fun ω => term M u d t e ω * term M u d t f ω) P := by
  let := M.probability
  apply bounded_integrable P ((term_measurable P M u d t e).mul
    (term_measurable P M u d t f)) ((t : ℝ) * t)
  intro ω
  rw [Pi.mul_apply, norm_mul]
  exact mul_le_mul (term_bound P M u d t e ω) (term_bound P M u d t f ω)
    (norm_nonneg _) (Nat.cast_nonneg _)

open Classical in
private theorem cross_condExp (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ)
    (e f : Finset (Label V)) (he : e ∈ pairs G u (t + d)) (hf : f ∈ pairs G u (t + d)) :
    P[(fun ω => term M u d t e ω * term M u d t f ω) | H M] =ᵐ[P]
      fun ω => if e = f then (multiplicity M u d t e ω : ℝ)^2 else 0 := by
  classical
  let := M.probability
  have hcc : Integrable (fun ω => character M e ω * character M f ω) P := by
    apply bounded_integrable P ((character_measurable P M e).mul (character_measurable P M f)) 1
    intro ω
    rw [Pi.mul_apply, norm_mul]
    calc
      _ ≤ 1 * 1 := mul_le_mul (character_norm P M e ω) (character_norm P M f ω)
        (norm_nonneg _) zero_le_one
      _ = 1 := one_mul _
  have hp := condExp_stronglyMeasurable_mul_of_bound (H_le P M)
    ((multiplicity_H P M u d t e).mul (multiplicity_H P M u d t f)).stronglyMeasurable
    hcc ((t : ℝ) * t) (Eventually.of_forall (fun ω => by
      rw [Pi.mul_apply, norm_mul]
      exact mul_le_mul (multiplicity_bound P M u d t e ω)
        (multiplicity_bound P M u d t f ω) (norm_nonneg _) (Nat.cast_nonneg _)))
  have hh : (fun ω => term M u d t e ω * term M u d t f ω) =
      (fun ω => (multiplicity M u d t e ω : ℝ) * (multiplicity M u d t f ω : ℝ)) *
        (fun ω => character M e ω * character M f ω) := by
    funext ω
    simp only [term, Pi.mul_apply]
    ring
  rw [hh]
  have hc := character_cross_condExp P M e f
  have hm := character_cross_mean P M e f
    (Finset.mem_powersetCard.mp he).2 (Finset.mem_powersetCard.mp hf).2
  filter_upwards [hp,hc] with ω h1 h2
  simp only [Pi.mul_def] at h1 ⊢
  rw [h1]
  simp only [h2, hm]
  split_ifs with hef
  · subst f
    ring
  · ring

private noncomputable def noise (M : Model G (P : Measure Ω)) (u : V) (d t : ℕ) : Ω → ℝ :=
  ∑ e ∈ pairs G u (t + d), term M u d t e

private theorem noise_condExp (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ) :
    P[noise M u d t | H M] =ᵐ[P] 0 := by
  classical
  have hs := condExp_finsetSum (s := pairs G u (t + d)) (fun e _ => term_integrable P M u d t e) (H M)
  have ht : ∀ᵐ ω ∂P, ∀ e ∈ pairs G u (t + d), P[term M u d t e | H M] ω = 0 :=
    (eventually_all_finset _).mpr (fun e he => term_condExp P M u d t e he)
  filter_upwards [hs, ht] with ω h1 h2
  change P[∑ e ∈ pairs G u (t + d), term M u d t e | H M] ω = 0
  rw [h1]
  simp only [Finset.sum_apply]
  exact Finset.sum_eq_zero (fun e he => h2 e he)

private theorem noise_square_condExp (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ) :
    P[(fun ω => noise M u d t ω ^ 2) | H M] =ᵐ[P]
      fun ω => ∑ e ∈ pairs G u (t + d), (multiplicity M u d t e ω : ℝ)^2 := by
  classical
  have heq : (fun ω => noise M u d t ω ^ 2) =
      ∑ e ∈ pairs G u (t + d), ∑ f ∈ pairs G u (t + d),
        (fun ω => term M u d t e ω * term M u d t f ω) := by
    funext ω
    simp only [noise, Finset.sum_apply, pow_two, Finset.sum_mul_sum]
  rw [heq]
  have houter := condExp_finsetSum (s := pairs G u (t + d))
    (f := fun e => ∑ f ∈ pairs G u (t + d),
      (fun ω => term M u d t e ω * term M u d t f ω))
    (fun e _ => integrable_finsetSum' (pairs G u (t + d))
      (fun f _ => cross_integrable P M u d t e f)) (H M)
  have hinner : ∀ e ∈ pairs G u (t + d),
      P[∑ f ∈ pairs G u (t + d), (fun ω => term M u d t e ω * term M u d t f ω) | H M] =ᵐ[P]
        ∑ f ∈ pairs G u (t + d), P[(fun ω => term M u d t e ω * term M u d t f ω) | H M] :=
    fun e he => condExp_finsetSum (s := pairs G u (t + d)) (fun f _ => cross_integrable P M u d t e f) (H M)
  have hcross : ∀ᵐ ω ∂P, ∀ e ∈ pairs G u (t + d), ∀ f ∈ pairs G u (t + d),
      P[(fun ω => term M u d t e ω * term M u d t f ω) | H M] ω =
        if e = f then (multiplicity M u d t e ω : ℝ)^2 else 0 := by
    simp only [eventually_all_finset]
    exact fun e he f hf => cross_condExp P M u d t e f he hf
  have hinner' : ∀ᵐ ω ∂P, ∀ e ∈ pairs G u (t + d),
      P[∑ f ∈ pairs G u (t + d), (fun ω => term M u d t e ω * term M u d t f ω) | H M] ω =
        (∑ f ∈ pairs G u (t + d), P[(fun ω => term M u d t e ω * term M u d t f ω) | H M]) ω := by
    simp only [eventually_all_finset]
    exact hinner
  filter_upwards [houter,hinner',hcross] with ω h1 h2 h3
  rw [h1]
  simp only [Finset.sum_apply]
  apply Finset.sum_congr rfl
  intro e he
  rw [h2 e he]
  simp only [Finset.sum_apply]
  rw [Finset.sum_eq_single_of_mem e he]
  · simp [h3 e he e he]
  · intro f hf hfe
    rw [h3 e he f hf]
    simp [Ne.symm hfe]


private theorem native_W_memLp (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ) :
    MemLp (W M.coordinate u d t) 2 P := by
  let := M.probability
  exact MemLp.of_bound (W_measurable M.coordinate M.measurable_coordinate u d t).aestronglyMeasurable
    t (Eventually.of_forall (fun ω => by
      rw [← W_sample_eq M.coordinate u d t ω]
      exact W_bound u d t (fun c => M.coordinate c ω)))

private theorem conditional_mean (P : Measure Ω) (M : Model G P) (u : V) (d t : ℕ) :
    P[W M.coordinate u d t | H M] =ᵐ[P] fun ω => ((t : ℝ) + C M u d t ω) / 2 := by
  classical
  let := M.probability
  let b : Ω → ℝ := fun ω => ((t : ℝ) + C M u d t ω) / 2
  have hbH : StronglyMeasurable[H M] b :=
    (measurable_const.add (C_H P M u d t) |>.div_const 2).stronglyMeasurable
  have hC : Integrable (C M u d t) P := bounded_integrable P
    ((C_H P M u d t).mono (H_le P M) le_rfl) t (C_bound P M u d t)
  have hb : Integrable b P := ((integrable_const (t : ℝ)).add hC).div_const 2
  have heq : W M.coordinate u d t - b = (1/2 : ℝ) • noise M u d t := by
    funext ω
    have h := repetition_expansion P M u d t ω
    simpa only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, noise, term, Finset.sum_apply,
      b, sub_eq_iff_eq_add, add_comm] using h
  have hsub := condExp_sub (native_W_memLp P M u d t |>.integrable one_le_two) hb (H M)
  have hn := condExp_smul (μ := P) (1/2 : ℝ) (noise M u d t) (H M)
  rw [heq] at hsub
  have hzero := noise_condExp P M u d t
  have hbexp := condExp_of_stronglyMeasurable (H_le P M) hbH hb
  filter_upwards [hsub, hn, hzero] with ω h1 h2 h3
  rw [h2] at h1
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, hbexp, h3, Pi.zero_apply, mul_zero] at h1
  exact sub_eq_zero.mp h1.symm

/-- The conditional first moment and literally centered conditional second moment
of the original synchronous repetition statistic on its original probability space. -/
theorem conditional_repetition_moments (P : Measure Ω) (M : Model G P)
    (u : V) (d t : ℕ) (_hd : 1 ≤ d) :
    (P[W M.coordinate u d t | H M] =ᵐ[P]
      fun ω => ((t : ℝ) + C M u d t ω) / 2) ∧
    (P[(fun ω => (W M.coordinate u d t ω - P[W M.coordinate u d t | H M] ω)^2) | H M] =ᵐ[P]
      fun ω => (1/4 : ℝ) * ∑ e ∈ pairs G u (t + d), (multiplicity M u d t e ω : ℝ)^2) := by
  classical
  constructor
  · exact conditional_mean P M u d t
  · have hm := conditional_mean P M u d t
    have heq : (fun ω => (W M.coordinate u d t ω - P[W M.coordinate u d t | H M] ω)^2) =ᵐ[P]
        (1/4 : ℝ) • (fun ω => noise M u d t ω ^ 2) := by
      filter_upwards [hm] with ω hmean
      rw [hmean, repetition_expansion P M u d t ω]
      simp only [Pi.smul_apply, smul_eq_mul, noise, term, Finset.sum_apply]
      ring
    have hc := condExp_congr_ae (m := H M) heq
    have hs := condExp_smul (μ := P) (1/4 : ℝ) (fun ω => noise M u d t ω ^ 2) (H M)
    have hn := noise_square_condExp P M u d t
    filter_upwards [hc,hs,hn] with ω h1 h2 h3
    simpa only [Pi.smul_apply, smul_eq_mul, h3] using h1.trans h2

end D5.S3.StatisticalMechanics.NoisyVoter.ConditionalRepetitionMoments
