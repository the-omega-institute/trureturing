import Mathlib.Data.Int.Basic
import Mathlib.Tactic.FinCases

/-! The integer recurrence uses binary-tree coordinates and includes every Horner step. -/
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option linter.style.longLine false
set_option autoImplicit false
set_option Elab.async false

namespace D5.S3.StatisticalMechanics.PonciniRasmussenNineHorner
open Lean Elab Term
local syntax "prb1_tree_data% " term : term
elab_rules : term <= expectedType
  | `(prb1_tree_data% $t) => withEnableInfoTree false (elabTerm t (some expectedType))

private inductive Tree (α : Type) where
  | leaf : α → Tree α
  | node : Tree α → Tree α → Tree α
open Tree
private def get {α : Type} : Tree α → Nat → α
  | .leaf a, _ => a
  | .node l r, j => if j % 2 = 0 then get l (j/2) else get r (j/2)
private def decode {m : Nat} (v : Tree Int) : Fin (m+1) → Int := fun i => get v i.val

private def step {m : Nat} (rows : Tree (List Nat)) (one : Nat) (c : Int)
    (v : Fin (m+1) → Int) : Fin (m+1) → Int := fun i =>
  -((get rows i.val).foldl (fun s j => s + v ⟨j % (m+1), Nat.mod_lt j (by omega)⟩) 0) +
    (if i.val == one then c else 0)

private def horner {m : Nat} (rows : Tree (List Nat)) (one : Nat) (cs : List Int) :
    Fin (m+1) → Int := cs.foldl (fun v c => step rows one c v) (fun _ => 0)
