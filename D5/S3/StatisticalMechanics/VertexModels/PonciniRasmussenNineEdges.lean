def incoming (i : Fin 8192) : List Nat := get rows i.val

theorem sparseHamiltonian_eq (v : Fin 8192 → Int) :
    sparseHamiltonian v = fun i =>
      -((incoming i).foldl (fun s j => s + v ⟨j % 8192, Nat.mod_lt j (by omega)⟩) 0) := by
  rfl

def incomingEdges : List (Fin 4862 × Fin 8192) :=
  (List.finRange 4862).flatMap fun t =>
    (incoming ⟨t.val,by omega⟩).map fun s => (t, ⟨s%8192,Nat.mod_lt _ (by omega)⟩)

def outgoingEdges : List (Fin 4862 × Fin 8192) :=
  (List.finRange 4862).flatMap fun s =>
    (List.finRange 8).filterMap fun g =>
      if ht : (transition g s).val < 4862 then
        some (⟨(transition g s).val,ht⟩,⟨s.val,by omega⟩) else none

private def edgeOrder (a b : Fin 4862 × Fin 8192) : Bool :=
  decide (a.1.val*8192+a.2.val ≤ b.1.val*8192+b.2.val)

private theorem sorted_equal :
    incomingEdges.mergeSort edgeOrder = outgoingEdges.mergeSort edgeOrder := by
  decide +kernel

/-- Both sparse descriptions have the same edge multiset with multiplicity. -/
theorem edges_perm : incomingEdges.Perm outgoingEdges :=
  (List.mergeSort_perm incomingEdges _).symm.trans
    (sorted_equal ▸ List.mergeSort_perm outgoingEdges _)

