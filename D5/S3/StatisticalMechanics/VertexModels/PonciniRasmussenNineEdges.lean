noncomputable section
def incoming (i : Fin 8192) : List Nat := get rows i.val

theorem sparseHamiltonian_eq (v : Fin 8192 → Int) :
    sparseHamiltonian v = fun i =>
      -((incoming i).foldl (fun s j => s + v ⟨j % 8192, Nat.mod_lt j (by omega)⟩) 0) := by
  rfl

def incomingEdges : List (Fin 4862 × Fin 8192) :=
  (List.finRange 4862).flatMap fun t =>
    (incoming ⟨t.val,by omega⟩).map fun s => (t, ⟨s%8192,Nat.mod_lt _ (by omega)⟩)

def outgoingEdges : List (Fin 4862 × Fin 8192) :=
  (List.finRange 4862).flatMap fun s =>
    (List.finRange 8).filterMap fun g =>
      if ht : (transition g s).val < 4862 then
        some (⟨(transition g s).val,ht⟩,⟨s.val,by omega⟩) else none

private def mergeForKernel {α : Type*} (le : α → α → Bool) (xs : List α) : List α → List α :=
  xs.rec (fun ys => ys) fun x xs smaller ys =>
    ys.rec (x::xs) fun y ys tail => if le x y then x :: smaller (y::ys) else y :: tail
private theorem mergeForKernel_eq {α : Type*} (le : α → α → Bool) (xs ys : List α) :
    mergeForKernel le xs ys = List.merge xs ys le := by
  induction xs generalizing ys with
  | nil => simp [mergeForKernel, List.merge]
  | cons x xs ih =>
    induction ys with
    | nil => simp [mergeForKernel, List.merge]
    | cons y ys ihy =>
      simp only [mergeForKernel, List.merge]
      split <;> simp_all [mergeForKernel]
private def sortForKernel {α : Type*} (le : α → α → Bool) : Nat → List α → List α
  | 0, xs => xs
  | k+1, xs =>
    let h := xs.length / 2
    if h = 0 then xs else mergeForKernel le (sortForKernel le k (xs.take h)) (sortForKernel le k (xs.drop h))
termination_by structural k => k
private theorem sortForKernel_perm {α : Type*} (le : α → α → Bool) (k : Nat) (xs : List α) :
    (sortForKernel le k xs).Perm xs := by
  induction k generalizing xs with
  | zero => exact List.Perm.refl _
  | succ k ih =>
    simp only [sortForKernel]
    split
    · exact List.Perm.refl _
    · rw [mergeForKernel_eq]
      exact (List.merge_perm_append _).trans ((ih _).append (ih _) |>.trans (by rw [List.take_append_drop]))

private def edgeKey (e : Fin 4862 × Fin 8192) : Nat := e.1.val*8192+e.2.val
private theorem edgeKey_injective : Function.Injective edgeKey := by
  intro a b h
  have ha := a.2.isLt
  have hb := b.2.isLt
  have hval : a.1.val*8192+a.2.val = b.1.val*8192+b.2.val := h
  have ht : a.1.val = b.1.val := by omega
  have hs : a.2.val = b.2.val := by omega
  exact Prod.ext (Fin.ext ht) (Fin.ext hs)

private def sourcePart (k : Nat) : List (Fin 4862) :=
  ((List.finRange 4862).drop (k*256)).take 256
private def encodedPart (k : Nat) : List Nat :=
  (sourcePart k).flatMap fun s =>
    ((List.finRange 8).filterMap fun g =>
      if ht : (transition g s).val < 4862 then
        some ((⟨(transition g s).val,ht⟩ : Fin 4862),(⟨s.val,by omega⟩ : Fin 8192)) else none).map edgeKey
private def natOrder (a b : Nat) : Bool := decide (a ≤ b)
local syntax "prb1_edges% " "[" num,* "]" : term
elab_rules : term
  | `(prb1_edges% [$ns:num,*]) => do
    let ty := Lean.mkConst ``Nat
    let mut out := mkApp (Lean.mkConst ``List.nil [Level.zero]) ty
    for n in ns.getElems.reverse do
