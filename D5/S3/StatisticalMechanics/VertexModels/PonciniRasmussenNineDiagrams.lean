theorem transition_check (i : Fin 4862) : ∀ g : Fin 8,
    ((diagram i).val.mate (false,⟨g.val,by omega⟩) = (false,⟨g.val+1,by omega⟩) ↔
      (transition g i).val = 4862) ∧
    (∀ ht : (transition g i).val < 4862, ∀ x : Boundary 9,
      (diagram ⟨(transition g i).val,ht⟩).val.mate x =
        reconnected g.val (by omega) (diagram i).val x) := by
  let b : Fin 39 := ⟨i.val/128, by omega⟩
  let j : Fin 128 := ⟨i.val%128, Nat.mod_lt _ (by omega)⟩
  have hi : (⟨(b.val*128+j.val)%4862, Nat.mod_lt _ (by omega)⟩ : Fin 4862) = i := Fin.ext (by dsimp [b,j]; omega)
  simpa only [hi] using transition_check_blocks b j

