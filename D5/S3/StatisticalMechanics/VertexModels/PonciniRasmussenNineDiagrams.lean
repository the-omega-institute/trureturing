    ((diagram (⟨(b.val*128+j.val)%4862, Nat.mod_lt _ (by omega)⟩ : Fin 4862)).val.mate (false,⟨g.val,by omega⟩) = (false,⟨g.val+1,by omega⟩) ↔
      (transition g (⟨(b.val*128+j.val)%4862, Nat.mod_lt _ (by omega)⟩ : Fin 4862)).val = 4862) ∧
    (∀ ht : (transition g (⟨(b.val*128+j.val)%4862, Nat.mod_lt _ (by omega)⟩ : Fin 4862)).val < 4862, ∀ x : Boundary 9,
      (diagram ⟨(transition g (⟨(b.val*128+j.val)%4862, Nat.mod_lt _ (by omega)⟩ : Fin 4862)).val,ht⟩).val.mate x =
        reconnected g.val (by omega) (diagram (⟨(b.val*128+j.val)%4862, Nat.mod_lt _ (by omega)⟩ : Fin 4862)).val x) := by
  fin_cases b
  · exact transition_check_part0 j
  · exact transition_check_part1 j
  · exact transition_check_part2 j
  · exact transition_check_part3 j
  · exact transition_check_part4 j
  · exact transition_check_part5 j
