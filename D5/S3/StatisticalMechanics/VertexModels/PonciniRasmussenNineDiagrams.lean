local syntax "prb1_table% " num "[" term,* "]" : term
elab_rules : term
  | `(prb1_table% $depth:num [$rows,*]) => do
    let treeNat := mkApp (mkConst ``D5.S3.StatisticalMechanics.PonciniRasmussenCertificateTree.Tree) (mkConst ``Nat)
    let rec tree (ty : Expr) (fuel : Nat) (vs : Array Expr) : TermElabM Expr := do
      match fuel with
      | 0 => return mkApp2 (mkConst ``D5.S3.StatisticalMechanics.PonciniRasmussenCertificateTree.Tree.leaf) ty vs[0]!
      | fuel+1 =>
        let mut l := #[]
        let mut r := #[]
        for i in [:vs.size] do
          if i%2 = 0 then l := l.push vs[i]! else r := r.push vs[i]!
        return mkApp3 (mkConst ``D5.S3.StatisticalMechanics.PonciniRasmussenCertificateTree.Tree.node) ty (← tree ty fuel l) (← tree ty fuel r)
    let mut values : Array Expr := #[]
    for row in rows.getElems do
      let xs ← match row with
        | `([$xs,*]) => pure xs.getElems
        | _ => throwErrorAt row "row required"
      let mut entries := #[]
      for x in xs do
        let n ← match x with
          | `($n:num) => pure n.getNat
          | _ => throwErrorAt x "natural literal required"
        entries := entries.push (mkNatLit n)
      values := values.push (← tree (mkConst ``Nat) depth.getNat entries)
    tree treeNat 13 values
