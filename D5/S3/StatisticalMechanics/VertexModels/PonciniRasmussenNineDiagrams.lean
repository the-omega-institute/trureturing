local syntax "prb1_tree_data% " term : term
elab_rules : term <= expectedType
  | `(prb1_tree_data% $t) => withEnableInfoTree false (elabTerm t (some expectedType))

private inductive Tree (α : Type) where
  | leaf : α → Tree α
  | node : Tree α → Tree α → Tree α
open Tree
private def get {α : Type} : Tree α → Nat → α
  | .leaf a, _ => a
  | .node l r, j => if j % 2 = 0 then get l (j/2) else get r (j/2)
local syntax "prb1_table% " num "[" term,* "]" : term
elab_rules : term
  | `(prb1_table% $depth:num [$rows,*]) => do
    let treeNat := mkApp (mkConst ``Tree) (mkConst ``Nat)
    let rec tree (ty : Expr) (fuel : Nat) (vs : Array Expr) : TermElabM Expr := do
      match fuel with
      | 0 => return mkApp2 (mkConst ``Tree.leaf) ty vs[0]!
      | fuel+1 =>
        let mut l := #[]
        let mut r := #[]
        for i in [:vs.size] do
          if i%2 = 0 then l := l.push vs[i]! else r := r.push vs[i]!
        return mkApp3 (mkConst ``Tree.node) ty (← tree ty fuel l) (← tree ty fuel r)
    let mut values : Array Expr := #[]
    for row in rows.getElems do
      let xs ← match row with
        | `([$xs,*]) => pure xs.getElems
        | _ => throwErrorAt row "row required"
      let mut entries := #[]
      for x in xs do
        let n ← match x with
          | `($n:num) => pure n.getNat
          | _ => throwErrorAt x "natural literal required"
        entries := entries.push (mkNatLit n)
      values := values.push (← tree (mkConst ``Nat) depth.getNat entries)
    tree treeNat 13 values
