   generality: I
   mirror-B: D5/B/S3/StatisticalMechanics/VertexModels/PonciniRasmussenNineHornerData
   mirror-E: none(waiver:external-open-problem-resolution)
   anchors: [mathlib/module/Mathlib.Data.Int.Basic]
   utility: kind=numeric-reduction; basis=refutes=gid:D5/S3/StatisticalMechanics/VertexModels/PonciniRasmussenMinpolyRefutation.claim; result=D5/S3/StatisticalMechanics/VertexModels/PonciniRasmussenMinpolyRefutation.result; claim=D5/S3/StatisticalMechanics/VertexModels/PonciniRasmussenMinpolyRefutation.claim
   digest: The fixed sparse rows and integer vector states for the nine-strand certificate. -/
import Mathlib.Data.Int.Basic

/-! Exact integer data and finite kernel reduction. -/
set_option autoImplicit false
set_option Elab.async false
set_option maxRecDepth 100000
set_option maxHeartbeats 0
set_option linter.style.longLine false

namespace D5.S3.StatisticalMechanics.PonciniRasmussenNineHorner
private inductive Tree (α : Type) where
  | leaf : α → Tree α
  | node : Tree α → Tree α → Tree α
open Tree
private def get {α : Type} : Tree α → Nat → α
  | .leaf a, _ => a
  | .node l r, j => if j % 2 = 0 then get l (j/2) else get r (j/2)

open Lean Elab Term
local syntax "prb1_vector% " "[" term,* "]" : term
elab_rules : term
  | `(prb1_vector% [$xs,*]) => do
    let mut values : Array Expr := #[]
    for x in xs.getElems do
      let z ← match x with
        | `($n:num) => pure (Int.ofNat n.getNat)
        | `(-$n:num) => pure (-Int.ofNat n.getNat)
        | _ => throwErrorAt x "integer literal required"
      values := values.push (mkIntLit z)
    let rec tree (fuel : Nat) (vs : Array Expr) : TermElabM Expr := do
      match fuel with
      | 0 => return mkApp2 (mkConst ``Tree.leaf) (mkConst ``Int) vs[0]!
      | fuel+1 =>
       if vs.isEmpty then throwError "nonempty vector required"
       let mut l := #[]
       let mut r := #[]
       for i in [:vs.size] do
         if i%2 = 0 then l := l.push vs[i]! else r := r.push vs[i]!
       return mkApp3 (mkConst ``Tree.node) (mkConst ``Int) (← tree fuel l) (← tree fuel r)
    tree 13 values

