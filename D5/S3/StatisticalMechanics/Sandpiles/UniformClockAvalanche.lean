/- GID: D5/S3/StatisticalMechanics/Sandpiles/UniformClockAvalanche
   generality: G
   mirror-B: D5/B/S3/StatisticalMechanics/Sandpiles/UniformClockAvalanche
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: The actual parallel clock avalanche for every natural time. -/

import Mathlib.AlgebraicTopology.SimplicialComplex.Basic
import Mathlib.Combinatorics.Digraph.Basic
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Order.Preorder.Finite
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.StatisticalMechanics.Sandpiles.UniformClockAvalanche

open Finset
universe u

/-- Out-degree counts the actual outgoing arcs. -/
def outdegree {W : Type u} [Fintype W] [DecidableEq W] (G : Digraph W)
    [DecidableRel G.Adj] (w : W) : ℕ := (univ.filter (G.Adj w)).card

/-- All unstable nonsinks fire once, simultaneously. -/
def firing {W : Type u} [Fintype W] [DecidableEq W] (G : Digraph W)
    [DecidableRel G.Adj] (c : W → ℕ) : Finset W :=
  univ.filter fun w => 0 < outdegree G w ∧ outdegree G w ≤ c w

/-- Arrivals use the old firing set; sinks retain their accumulated grains. -/
def step {W : Type u} [Fintype W] [DecidableEq W] (G : Digraph W)
    [DecidableRel G.Adj] (c : W → ℕ) (w : W) : ℕ :=
  c w - (if w ∈ firing G c then outdegree G w else 0) +
    ∑ a : W, if a ∈ firing G c ∧ G.Adj a w then 1 else 0

/-- The actual orbit, with no schedule supplied. -/
def orbit {W : Type u} [Fintype W] [DecidableEq W] (G : Digraph W)
    [DecidableRel G.Adj] (c : W → ℕ) (t : ℕ) : W → ℕ := (step G)^[t] c

/-- Nonempty faces generated by the complete firing sets over all natural times. -/
def avalanche {W : Type u} [Fintype W] [DecidableEq W] (G : Digraph W)
    [DecidableRel G.Adj] (c : W → ℕ) : PreAbstractSimplicialComplex W where
  faces := {s | s.Nonempty ∧ ∃ t : ℕ, s ⊆ firing G (orbit G c t)}
  isRelLowerSet_faces := by
    intro s hs
    refine ⟨hs.1, ?_⟩
    intro r hrs hr
    exact ⟨hr, hs.2.imp fun _ ht => hrs.trans ht⟩

/-- The original vertices occupy a separate summand from clocks and sink. -/
def original {V : Type u} (m : ℕ) : V ↪ (V ⊕ Fin m) ⊕ Unit :=
  Function.Embedding.inl.trans Function.Embedding.inl

/-- Outgoing neighbors in the clock construction. -/
def neighbours {V : Type u} [DecidableEq V] {m : ℕ} (F : Fin m → Finset V) :
    ((V ⊕ Fin m) ⊕ Unit) → Finset ((V ⊕ Fin m) ⊕ Unit)
  | .inl (.inl _) => {.inr ()}
  | .inl (.inr i) => insert
      (if h : i.val + 1 < m then .inl (.inr ⟨i.val + 1, h⟩) else .inr ())
      ((F i).map (original m))
  | .inr _ => ∅

/-- The graph is determined by facets and clock successors, independently of dynamics. -/
def clockGraph {V : Type u} [DecidableEq V] {m : ℕ} (F : Fin m → Finset V) :
    Digraph ((V ⊕ Fin m) ⊕ Unit) := ⟨fun a w => w ∈ neighbours F a⟩

instance {V : Type u} [DecidableEq V] {m : ℕ} (F : Fin m → Finset V) :
    DecidableRel (clockGraph F).Adj := fun _ _ => inferInstanceAs (Decidable (_ ∈ _))

/-- Initial preload, the first active clock, and the chosen original grain. -/
def initial {V : Type u} [DecidableEq V] {m : ℕ} (F : Fin m → Finset V) (b : V) :
    ((V ⊕ Fin m) ⊕ Unit) → ℕ
  | .inl (.inl v) => if v = b then 1 else 0
  | .inl (.inr i) => (F i).card + if i.val = 0 then 1 else 0
  | .inr _ => 0

set_option maxHeartbeats 2400000 in
/-- Exact state profiles, complete firing sets, and actual all-time generated faces. -/
theorem uniform_clock_all_time {V : Type u} [Fintype V] [DecidableEq V]
    (K : AbstractSimplicialComplex V) (m : ℕ) (hm : 1 ≤ m)
    (f : Fin m → {S : Finset V // Maximal (fun T : Finset V => T ∈ K) S})
    (hf : Function.Surjective f) (b : V) :
    let F := fun i => (f i).val
    let G := clockGraph F
    let c := orbit G (initial F b)
    let O := fun t v => if t = 0 then (if v = b then 1 else 0)
      else if h : 1 ≤ t ∧ t ≤ m then
        (if v ∈ F ⟨t - 1, by omega⟩ then 1 else 0) else 0
    let P := fun t (i : Fin m) => if t < i.val then (F i).card
      else if t = i.val then (F i).card + 1 else 0
    let B := fun (i : Fin m) => if h : i.val = 0 then {b}
      else F ⟨i.val - 1, by omega⟩
    let S := fun t => if t = 0 then
        {original m b, Sum.inl (Sum.inr (⟨0, by omega⟩ : Fin m))}
      else if h : t < m then
        insert (Sum.inl (Sum.inr ⟨t, h⟩)) ((F ⟨t - 1, by omega⟩).map (original m))
      else if h : t = m then (F ⟨m - 1, by omega⟩).map (original m) else ∅
    (∀ t v, c t (original m v) = O t v) ∧
    (∀ t i, c t (.inl (.inr i)) = P t i) ∧
    (∀ t, firing G (c t) = S t) ∧
    (∀ τ : Finset ((V ⊕ Fin m) ⊕ Unit), τ ∈ avalanche G (initial F b) ↔
      τ.Nonempty ∧ ((∃ A : Finset V, A ∈ K ∧ τ = A.map (original m)) ∨
        ∃ i : Fin m, τ ⊆ insert (.inl (.inr i)) ((B i).map (original m)))) := by
  classical
  dsimp only
  let F := fun i => (f i).val
  let G := clockGraph F
  let c := orbit G (initial F b)
  let O := fun t v => if t = 0 then (if v = b then 1 else 0)
    else if h : 1 ≤ t ∧ t ≤ m then
      (if v ∈ F ⟨t - 1, by omega⟩ then 1 else 0) else 0
  let P := fun t (i : Fin m) => if t < i.val then (F i).card
    else if t = i.val then (F i).card + 1 else 0
  have degree : ∀ w, outdegree G w = match w with
      | .inl (.inl _) => 1
      | .inl (.inr i) => (F i).card + 1
      | .inr _ => 0 := by
    intro w
    simp only [outdegree, G, clockGraph, filter_mem_eq_inter, univ_inter]
    rcases w with (v | i) | s
    · simp [neighbours]
    · simp only [neighbours]
      rw [card_insert_of_notMem, card_map]
      split <;> simp [original]
    · simp [neighbours]
  have fire : ∀ t (a : ((V ⊕ Fin m) ⊕ Unit)) (q : ((V ⊕ Fin m) ⊕ Unit) → ℕ),
      (∀ v, q (original m v) = O t v) →
      (∀ i, q (.inl (.inr i)) = P t i) →
      (a ∈ firing G q ↔ match a with
        | .inl (.inl v) => O t v = 1
        | .inl (.inr i) => t = i.val
        | .inr _ => False) := by
    intro t a q ho hp
    simp only [firing, mem_filter, mem_univ, true_and, degree]
    rcases a with (v | i) | s
    · rw [show q (.inl (.inl v)) = O t v from ho v]
      dsimp [O]
      split_ifs <;> simp_all
    · rw [hp]
      dsimp [P]
      split_ifs <;> omega
    · simp
  have advance : ∀ t q,
      (∀ v, q (original m v) = O t v) →
      (∀ i, q (.inl (.inr i)) = P t i) →
      (∀ v, step G q (original m v) = O (t + 1) v) ∧
      (∀ i, step G q (.inl (.inr i)) = P (t + 1) i) := by
    intro t q ho hp
    have arrivals : ∀ w, (∑ a, if a ∈ firing G q ∧ G.Adj a w then 1 else 0) =
        if h : t < m then (if G.Adj (.inl (.inr ⟨t, h⟩)) w then 1 else 0)
          + (∑ v : V, if O t v = 1 ∧ G.Adj (original m v) w then 1 else 0)
        else ∑ v : V, if O t v = 1 ∧ G.Adj (original m v) w then 1 else 0 := by
      intro w
      have hsum : (∑ a, if a ∈ firing G q ∧ G.Adj a w then (1 : ℕ) else 0) =
          ((∑ v : V, if O t v = 1 ∧ G.Adj (original m v) w then 1 else 0) +
          (∑ i : Fin m, if t = i.val ∧ G.Adj (.inl (.inr i)) w then 1 else 0)) := by
        simp only [Fintype.sum_sum_type]
        have e0 : (∑ s : Unit, if .inr s ∈ firing G q ∧ G.Adj (.inr s) w then (1 : ℕ) else 0) = 0 := by
          apply sum_eq_zero
          intro s _
          simp [fire t _ q ho hp]
        rw [e0, add_zero]
        congr 1
        · apply sum_congr rfl
          intro v _
          change (if original m v ∈ firing G q ∧ G.Adj (original m v) w then (1 : ℕ) else 0) = _
          have he : original m v ∈ firing G q ↔ O t v = 1 := fire t _ q ho hp
          by_cases h : O t v = 1 <;> by_cases h' : G.Adj (original m v) w <;>
            simp [he, h, h']
        · apply sum_congr rfl
          intro i _
          have he := fire t (.inl (.inr i)) q ho hp
          by_cases h : t = i.val <;> by_cases h' : G.Adj (.inl (.inr i)) w <;>
            simp_all only [and_true, and_false, if_true, if_false, not_false_eq_true]
      rw [hsum]
      have hs : (∑ i : Fin m, if t = i.val ∧ G.Adj (.inl (.inr i)) w then 1 else 0) =
          if h : t < m then (if G.Adj (.inl (.inr ⟨t, h⟩)) w then 1 else 0) else 0 := by
        by_cases ht : t < m
        · rw [dif_pos ht, sum_eq_single (⟨t, ht⟩ : Fin m)]
          · simp
          · intro i _ hi
            have hn : t ≠ i.val := by intro he; exact hi (Fin.ext he.symm)
            simp [hn]
          · simp
        · rw [dif_neg ht]
          apply sum_eq_zero
          intro i _
          have hn : t ≠ i.val := by omega
          simp [hn]
      rw [hs]
      split <;> omega
    constructor
    · intro v
      have hd : outdegree G (original m v) = 1 := degree _
      have he : original m v ∈ firing G q ↔ O t v = 1 := fire t _ q ho hp
      have hsmall : O t v = 0 ∨ O t v = 1 := by
        dsimp [O]
        split_ifs <;> simp
      have hremove : O t v - (if original m v ∈ firing G q then 1 else 0) = 0 := by
        rcases hsmall with h | h <;> simp [he, h]
      rw [step, ho, hd, hremove, zero_add, arrivals]
      have hnone : ∀ a : V, ¬ G.Adj (original m a) (original m v) := by
        intro a; simp [G, clockGraph, neighbours, original]
      simp only [hnone, and_false, if_false, sum_const_zero, add_zero]
      by_cases ht : t < m
      · simp only [dif_pos ht]
        have he : G.Adj (.inl (.inr ⟨t, ht⟩)) (original m v) ↔ v ∈ F ⟨t, ht⟩ := by
          dsimp [G, clockGraph, neighbours]
          split <;> simp [original]
        have hb : 1 ≤ t + 1 ∧ t + 1 ≤ m := by omega
        simp [he, O, show t + 1 ≠ 0 by omega, hb, Nat.add_sub_cancel]
      · have hb : ¬ (1 ≤ t + 1 ∧ t + 1 ≤ m) := by omega
        simp [ht, O, show t + 1 ≠ 0 by omega, hb]
    · intro i
      rw [step, hp, degree, arrivals]
      simp only [fire t _ q ho hp]
      have hnone : ∀ a : V, ¬ G.Adj (original m a) (.inl (.inr i)) := by
        intro a; simp [G, clockGraph, neighbours, original]
      simp only [hnone, and_false, if_false, sum_const_zero, add_zero]
      by_cases ht : t < m
      · simp only [dif_pos ht]
        have he : G.Adj (.inl (.inr ⟨t, ht⟩)) (.inl (.inr i)) ↔ i.val = t + 1 := by
          dsimp [G, clockGraph, neighbours]
          by_cases hs : t + 1 < m
          · simp [hs, original, Fin.ext_iff]
          · have hn : i.val ≠ t + 1 := by have := i.isLt; omega
            simp [hs, original, hn]
        simp only [he]
        dsimp [P]
        split_ifs <;> omega
      · simp only [dif_neg ht]
        dsimp [P]
        split_ifs <;> omega
  have profiles : ∀ t, (∀ v, c t (original m v) = O t v) ∧
      (∀ i, c t (.inl (.inr i)) = P t i) := by
    intro t
    induction t with
    | zero =>
      constructor
      · intro v; simp [c, orbit, initial, original, O]
      · intro i; simp [c, orbit, initial, P]; split_ifs <;> omega
    | succ t ih =>
      simpa only [c, orbit, Function.iterate_succ_apply'] using
        advance t (c t) ih.1 ih.2
  have sets : ∀ t, firing G (c t) =
      if t = 0 then {original m b, Sum.inl (Sum.inr (⟨0, by omega⟩ : Fin m))}
      else if h : t < m then
        insert (.inl (.inr ⟨t, h⟩)) ((F ⟨t - 1, by omega⟩).map (original m))
      else if h : t = m then (F ⟨m - 1, by omega⟩).map (original m) else ∅ := by
    intro t
    ext w
    rw [fire t w (c t) (profiles t).1 (profiles t).2]
    rcases w with (v | i) | s
    · dsimp [O]
      split_ifs <;> simp_all [original] <;> omega
    · dsimp [O]
      split_ifs <;> simp_all [original, Fin.ext_iff] <;> omega
    · split_ifs <;> simp_all [original]
  refine ⟨fun t => (profiles t).1, fun t => (profiles t).2, sets, ?_⟩
  intro τ
  change (τ.Nonempty ∧ ∃ t, τ ⊆ firing G (c t)) ↔ _
  rw [and_congr_right_iff]
  intro hτ
  constructor
  · rintro ⟨t, ht⟩
    rw [sets] at ht
    by_cases h0 : t = 0
    · subst t
      right
      refine ⟨⟨0, by omega⟩, ?_⟩
      simpa [original, Finset.pair_comm] using ht
    · by_cases htm : t < m
      · right
        refine ⟨⟨t, htm⟩, ?_⟩
        simpa [h0, htm] using ht
      · by_cases he : t = m
        · subst t
          simp only [show m ≠ 0 by omega, if_false, lt_self_iff_false, ↓reduceDIte] at ht
          obtain ⟨A, hsub, hA⟩ := subset_map_iff.mp ht
          left
          refine ⟨A, ?_, hA⟩
          have hn : A.Nonempty := by
            rw [hA] at hτ
            exact map_nonempty.mp hτ
          exact (K.isRelLowerSet_faces (f ⟨m - 1, by omega⟩).property.prop).2 hsub hn
        · simp [h0, htm, he] at ht
          exact False.elim (hτ.ne_empty ht)
  · rintro (⟨A, hA, rfl⟩ | ⟨i, hi⟩)
    · obtain ⟨M, hAM, hM⟩ := Finite.exists_le_maximal hA
      obtain ⟨i, hfi⟩ := hf ⟨M, hM⟩
      have hsub : A.map (original m) ⊆ (F i).map (original m) := by
        apply map_subset_map.mpr
        simpa [F, hfi] using hAM
      refine ⟨i.val + 1, ?_⟩
      rw [sets]
      have h0 : i.val + 1 ≠ 0 := by omega
      simp only [h0, if_false]
      by_cases ht : i.val + 1 < m
      · rw [dif_pos ht]
        simpa only [Nat.add_sub_cancel, Fin.eta] using hsub.trans
          (subset_insert (.inl (.inr ⟨i.val + 1, ht⟩)) ((F i).map (original m)))
      · have he : i.val + 1 = m := by omega
        rw [dif_neg ht, dif_pos he]
        have hi : (⟨m - 1, by omega⟩ : Fin m) = i := by apply Fin.ext; dsimp; omega
        simpa only [hi] using hsub
    · refine ⟨i.val, ?_⟩
      rw [sets]
      by_cases h0 : i.val = 0
      · have he : i = (⟨0, by omega⟩ : Fin m) := Fin.ext h0
        rw [he] at hi ⊢
        simpa [original, Finset.pair_comm] using hi
      · simpa [h0, i.isLt] using hi

end D5.S3.StatisticalMechanics.Sandpiles.UniformClockAvalanche
