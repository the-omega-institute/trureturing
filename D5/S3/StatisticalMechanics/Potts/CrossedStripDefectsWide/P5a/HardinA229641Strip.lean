private theorem moves_two_filter (p : Column) :
    movesTwo p = (List.finRange 243).filter (fun q => decide (cost p q = 2)) := by
  have checked : ∀ (block : Fin 27) (offset : Fin 9),
      let col := finProdFinEquiv (block, offset)
      movesTwo col = (List.finRange 243).filter (fun q => decide (cost col q = 2)) := by
    intro block
    simp only [cost, DefectTransfer.bondDefects, Finset.card_filter, edges_sum]
    fin_cases block <;> decide +kernel
  obtain ⟨⟨block, offset⟩, rfl⟩ := (finProdFinEquiv (m := 27) (n := 9)).surjective p
  exact checked block offset

private theorem step_two {R : Type*} [AddCommMonoid R] [Mul R] [One R]
    (w : Column → R) (p : Column)
    (zeroLeft : ∑ q ∈ Finset.univ.filter (fun q => ¬ cost p q = 2), (0 : R) * w q = 0) :
    dotProduct (twoDefect p) w = ((movesTwo p).map (fun q => (1 : R) * w q)).sum :=
  weighted_indicator_sum (fun q => cost p q = 2) (movesTwo p)
    (by rw [moves_two_filter]; exact (List.nodup_finRange _).filter _)
    (fun q => by rw [moves_two_filter]; simp) w zeroLeft

