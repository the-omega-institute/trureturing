private def tableTwo (n : Fin 34) (p : Column) : ℤ :=
  tableTwoValues n (classIndex p)


private theorem table_base (p : Column) : tableTwo 0 p = 0 := rfl

private theorem table_step (k : Fin 33) (p : Column) :
    tableTwo k.succ p = T.mulVec (tableTwo k.castSucc) p +
      ∑ i : Fin 23, oldWeights k.castSucc i * topSeed i p := by
  rw [step_fast]
  have checked : ∀ (n : Fin 33) (block : Fin 27) (offset : Fin 9),
      let p := finProdFinEquiv (block, offset)
      tableTwo n.succ p = ((moves p).map (tableTwo n.castSucc)).sum +
        ∑ i : Fin 23, oldWeights n.castSucc i * topSeed i p := by
    intro n block
    fin_cases n <;> fin_cases block <;> decide +kernel
  obtain ⟨⟨block, offset⟩, rfl⟩ := (finProdFinEquiv (m := 27) (n := 9)).surjective p
  exact checked k block offset

private theorem inherited_powers (n : ℕ) :
    (transfer ^ n).mulVec terminal ∘ Sum.inr =
      (HardinA229538Strip.transfer ^ n).mulVec HardinA229538Strip.terminal := by
  have step : Function.Semiconj (fun (z : Column ⊕ (Column ⊕ Column) → ℤ) => z ∘ Sum.inr)
      transfer.mulVec HardinA229538Strip.transfer.mulVec := by
    intro z
    simp only [transfer, Matrix.fromBlocks_mulVec, Function.comp_def, Sum.elim_inr,
      Matrix.zero_mulVec, zero_add]
  calc
    (transfer ^ n).mulVec terminal ∘ Sum.inr =
        (transfer.mulVec^[n] terminal) ∘ Sum.inr :=
      congrArg (fun v => v ∘ Sum.inr)
        (smul_iterate_apply transfer n (terminal : Column ⊕ (Column ⊕ Column) → ℤ)).symm
    _ = HardinA229538Strip.transfer.mulVec^[n] (terminal ∘ Sum.inr) :=
      (step.iterate_right n).eq terminal
    _ = _ := by
      change HardinA229538Strip.transfer.mulVec^[n] HardinA229538Strip.terminal = _
      exact smul_iterate_apply HardinA229538Strip.transfer n HardinA229538Strip.terminal

private theorem table_powers (n : Fin 34) (p : Column) :
    (transfer ^ n.val).mulVec terminal (Sum.inl p) = tableTwo n p := by
  induction n using Fin.induction generalizing p with
  | zero => simpa only [Fin.val_zero, pow_zero, Matrix.one_mulVec, terminal, Sum.elim_inl, Pi.zero_apply] using
      (table_base p).symm
  | succ k ih =>
    simp only [Fin.val_succ, pow_succ', ← Matrix.mulVec_mulVec, ← Fin.val_castSucc k]
    have ht : (transfer ^ k.castSucc.val).mulVec terminal ∘ Sum.inl = tableTwo k.castSucc := by
      funext q
      exact ih q
    change (Matrix.fromBlocks _ _ _ _).mulVec _ (Sum.inl p) = _
    simp only [Matrix.fromBlocks_mulVec, Sum.elim_inl, Pi.add_apply, ht, inherited_powers]
    rw [weighted_top]
    exact (table_step k p).symm

private def coefficients641 : Fin 30 → ℤ := ![-46656, 279936, 186624, -4611168, 7359984, 21460464, -73617984, 9610272, 227616084, -273411640, -168525432, 522690894, -138135927, -412178619, 287096430, 147888798, -190067859, -12632640, 66347438, -7797810, -13478352, 2851598, 1614489, -424479, -108707, 31983, 3468, -1191, -15, 18]


private theorem new_polynomial : ∀ p : Column,
    tableTwo (Fin.last 33) p = ∑ k : Fin 30, coefficients641 k *
      tableTwo ((Fin.natAdd 3 k).castSucc) p := by
  have onClasses : ∀ j : Fin 25,
      tableTwoValues (Fin.last 33) j = ∑ k : Fin 30, coefficients641 k *
        tableTwoValues ((Fin.natAdd 3 k).castSucc) j := by
    intro j
    fin_cases j <;> decide +kernel
  intro p
  exact onClasses (classIndex p)

private theorem inherited_polynomial (p : Column ⊕ Column) :
    ((HardinA229538Strip.transfer ^ 33).mulVec HardinA229538Strip.terminal) p =
      ∑ k : Fin 30, coefficients641 k *
        ((HardinA229538Strip.transfer ^ (3 + k.val)).mulVec HardinA229538Strip.terminal) p := by
  let f : ℕ → ℤ := fun n =>
    ((HardinA229538Strip.transfer ^ n).mulVec HardinA229538Strip.terminal) p
  have factor :
      f 33 - ∑ k : Fin 30, coefficients641 k * f (3 + k.val) =
        ∑ j : Fin 11, Fin.snoc (α := fun _ => ℤ) (fun k => -HardinA233178Chromatic.coefficients k) 1 j *
          (f (1 + j.val + 22) -
            ∑ k : Fin 20, coefficients538 k * f (1 + j.val + 2 + k.val)) := by
    conv_rhs => rw [Fin.sum_univ_castSucc]
    simp only [Fin.snoc_castSucc, Fin.snoc_last, Fin.val_castSucc, Fin.val_last]
    norm_num [Fin.sum_univ_succ, coefficients641, coefficients538, HardinA233178Chromatic.coefficients]
    ring
  apply sub_eq_zero.mp
  change f 33 - ∑ k : Fin 30, coefficients641 k * f (3 + k.val) = 0
  rw [factor]
  apply Finset.sum_eq_zero
  intro j _
  rw [sub_eq_zero.mpr (old_coordinate p (1 + j.val)), mul_zero]

private theorem vector_polynomial :
    (transfer ^ 33).mulVec terminal =
      ∑ k : Fin 30, coefficients641 k • (transfer ^ (3 + k.val)).mulVec terminal := by
  funext p
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  cases p with
  | inl p =>
    have h (i : Fin 34) := table_powers i p
    rw [← Fin.val_last 33, h]
    simp_rw [show ∀ k : Fin 30, (transfer ^ (3 + k.val)).mulVec terminal (Sum.inl p) =
      tableTwo ((Fin.natAdd 3 k).castSucc) p from
        fun k => h ((Fin.natAdd 3 k).castSucc)]
    exact new_polynomial p
  | inr p =>
    have h (i : ℕ) := congrFun (inherited_powers i) p
    simp_rw [Function.comp_apply] at h
    simpa only [h] using inherited_polynomial p

end

section

open scoped BigOperators
open D5.S3.Combinatorics.TraceAvoidingArrays
open D5.S3.StatisticalMechanics.Potts.StripDefects
open HardinA233178Chromatic (Column)
open HardinA233178Recurrence (columnEquiv)
open HardinA229538Strip (edges cost bondDefects_empty zero_cost_entry oneDefect
  canonicalCount transition_entry labelled_scale cut_total_exclusion)
open D5.S3.StatisticalMechanics.Potts.KingDefects.TwoDefectStrips
open HardinA229637RowColumn (horiz betw)
open DefectTransfer (bondDefects defects literalCount lumped_count)
set_option maxHeartbeats 0
set_option maxRecDepth 100000

def a (n : ℕ) : ℕ := HardinA229637RowColumn.T 5 n

private theorem transfer_count (n : ℕ) :
    (literalCount (q := 3) ∅ edges 2 (n + 1) : ℤ) =
      dotProduct (Sum.elim (1 : Column → ℤ) 0) ((transfer ^ n).mulVec terminal) := by
  let cl (p : Column) (d : ℕ) : Column ⊕ (Column ⊕ Column) :=
    if d ≤ 1 then Sum.inr (HardinA229538Strip.residual p d) else Sum.inl p
  let C (p : Column) (r : Fin 5 → Fin 3) : ℕ := bondDefects edges (columnEquiv p) r
  let col : Column ⊕ (Column ⊕ Column) → Column := Sum.elim id (Sum.elim id id)
  have ctr (p q : Column) : C p (columnEquiv q) = cost p q := rfl
  have cut (p q : Column) (d : ℕ) (hd : d ≤ 2) (x : Column ⊕ (Column ⊕ Column)) :
      (if cost p q ≤ d ∧ cl q (d - cost p q) = x then (1 : ℤ) else 0) =
        (if col x = q then transfer (cl p d) x else 0) := by
    have cutoff : cost p q ≤ 2 ↔ cost p q = 0 ∨ cost p q = 1 ∨ cost p q = 2 :=
      Order.le_two_iff
    by_cases hd' : d ≤ 1
    · have bound : d - cost p q ≤ 1 := (Nat.sub_le _ _).trans hd'
      cases x with
      | inl x => simp [col, cl, transfer, Matrix.fromBlocks, hd', bound]
      | inr x =>
        have entry := transition_entry p q d x
        simp only [Nat.not_lt_of_ge hd', false_and, if_false, sub_eq_zero] at entry
        simpa [col, cl, transfer, Matrix.fromBlocks, hd', bound] using entry
    · have hd₂ : d = 2 := Nat.le_antisymm hd (Nat.lt_of_not_ge hd')
      subst d
      rcases x with x | x
      · by_cases hq : x = q
        · subst x
          by_cases h0 : cost p q = 0 <;> by_cases h1 : cost p q = 1 <;>
            by_cases h2 : cost p q = 2 <;>
              simp [col, cl, transfer, Matrix.fromBlocks, ← zero_cost_entry, cutoff, h0, h1, h2]
        · by_cases h0 : cost p q = 0 <;> by_cases h1 : cost p q = 1 <;>
            by_cases h2 : cost p q = 2 <;>
              simp [col, cl, transfer, Matrix.fromBlocks, ← zero_cost_entry, cutoff, h0, h1, h2, hq, Ne.symm hq]
      · rcases x with x | x <;> by_cases hq : x = q
        all_goals
          by_cases h0 : cost p q = 0 <;> by_cases h1 : cost p q = 1 <;>
            by_cases h2 : cost p q = 2 <;>
              simp [col, cl, HardinA229538Strip.residual, transfer, Matrix.fromBlocks, oneDefect, twoDefect, cutoff,
                h0, h1, h2, hq, eq_comm] <;> exact Ne.symm hq
  apply lumped_count ∅ edges columnEquiv.symm C (fun _ d => d ≤ 2) cl transfer
    (Sum.elim (1 : Column → ℤ) 0) terminal 2
  · intro r t
    simp [C]
  · intro p d hd
    by_cases h : d ≤ 1
    · by_cases z : d = 0 <;> simp [cl, HardinA229538Strip.residual, terminal, HardinA229538Strip.terminal, h, z]
    · have z : d ≠ 0 := Nat.ne_zero_of_lt (Nat.lt_of_not_ge h)
      simp [cl, terminal, h, z]
  · intro p d hd r _
    exact (Nat.sub_le _ _).trans hd
  · intro p d hd x
    rw [← columnEquiv.sum_comp]
    simp_rw [bondDefects_empty, Nat.add_zero, ctr, columnEquiv.symm_apply_apply, cut p _ d hd]
    simp [Finset.sum_ite_eq']
  · intro r _
    exact Nat.sub_le _ _
  · intro x
    rw [← columnEquiv.sum_comp]
    simp_rw [bondDefects_empty, Nat.zero_le, Nat.sub_zero, true_and, columnEquiv.symm_apply_apply]
    cases x <;> simp [cl]

attribute [local irreducible] a

/-- Hardin's order-thirty recurrence, starting at width thirty-four. -/
theorem result (n : ℕ) :
    (a (n + 34) : ℤ) =
      18 * (a (n + 33) : ℤ) - 15 * (a (n + 32) : ℤ) - 1191 * (a (n + 31) : ℤ) +
      3468 * (a (n + 30) : ℤ) + 31983 * (a (n + 29) : ℤ) - 108707 * (a (n + 28) : ℤ) -
      424479 * (a (n + 27) : ℤ) + 1614489 * (a (n + 26) : ℤ) + 2851598 * (a (n + 25) : ℤ) -
      13478352 * (a (n + 24) : ℤ) - 7797810 * (a (n + 23) : ℤ) + 66347438 * (a (n + 22) : ℤ) -
      12632640 * (a (n + 21) : ℤ) - 190067859 * (a (n + 20) : ℤ) + 147888798 * (a (n + 19) : ℤ) +
      287096430 * (a (n + 18) : ℤ) - 412178619 * (a (n + 17) : ℤ) - 138135927 * (a (n + 16) : ℤ) +
      522690894 * (a (n + 15) : ℤ) - 168525432 * (a (n + 14) : ℤ) - 273411640 * (a (n + 13) : ℤ) +
      227616084 * (a (n + 12) : ℤ) + 9610272 * (a (n + 11) : ℤ) - 73617984 * (a (n + 10) : ℤ) +
      21460464 * (a (n + 9) : ℤ) + 7359984 * (a (n + 8) : ℤ) - 4611168 * (a (n + 7) : ℤ) +
      186624 * (a (n + 6) : ℤ) + 279936 * (a (n + 5) : ℤ) - 46656 * (a (n + 4) : ℤ) := by
  have table_count (m : ℕ) : a (m + 1) = canonicalCount ∅ edges 2 (m + 1) := by
    have sweep (A : Fin 5 × Fin (m + 1) → Fin 3) :
        defects (horiz (m + 1)) (betw (m + 1)) (List.ofFn fun i j => A (i, j)) =
          defects ∅ edges (List.ofFn fun j i => A (i, j)) := by
      obtain ⟨horizontal, diagonals, diagonalDisjoint, _⟩ := HardinA233178Chromatic.cut_parts m
      obtain ⟨_, cutDiagonals, cutDiagonalDisjoint, straightDisjoint⟩ :=
        HardinA233178Chromatic.cut_parts 4
      change defects (horiz (m + 1)) (betw (m + 1)) (List.ofFn fun i j => A (i, j)) =
        defects ∅ (Finset.univ.diag ∪ betw 5) (List.ofFn fun j i => A (i, j))
      have count_union {k : ℕ} {E F : Finset (Fin k × Fin k)} (h : Disjoint E F)
          (r t : Fin k → Fin 3) :
          bondDefects (E ∪ F) r t = bondDefects E r t + bondDefects F r t := by
        simp only [bondDefects, Finset.card_filter]
        exact Finset.sum_union h
      have count_map {k l : ℕ} (e : Fin l ↪ Fin k × Fin k) (r t : Fin k → Fin 3) :
          bondDefects (Finset.univ.map e) r t =
            ∑ i, if r (e i).1 = t (e i).2 then 1 else 0 := by
        rw [bondDefects, Finset.card_filter, Finset.sum_map]
      rw [GridBridge.defects_rows _ _ 4, GridBridge.defects_rows _ _ m, horizontal, diagonals]
      simp_rw [bondDefects_empty, count_union diagonalDisjoint, count_union straightDisjoint,
        cutDiagonals, count_union cutDiagonalDisjoint, Finset.diag, Finset.map_map, count_map]
      dsimp only [HardinA233178Chromatic.forwardCutPair, Function.diag, Function.Embedding.coeFn_mk]
      simp only [Finset.sum_const_zero, zero_add, Finset.sum_add_distrib]
      rw [Finset.sum_comm (s := (Finset.univ : Finset (Fin 5))),
        Finset.sum_comm (s := (Finset.univ : Finset (Fin 4))),
        Finset.sum_comm (s := (Finset.univ : Finset (Fin 4)))]
      have antidiagonal :
          (∑ j : Fin m, ∑ i : Fin 4,
            if A (i.castSucc, j.succ) = A (i.succ, j.castSucc) then (1 : ℕ) else 0) =
          ∑ j : Fin m, ∑ i : Fin 4,
            if A (i.succ, j.castSucc) = A (i.castSucc, j.succ) then 1 else 0 := by
        refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
        exact ite_cond_congr (propext eq_comm)
      exact congrArg₂ (· + ·) rfl (congrArg₂ (· + ·) rfl antidiagonal)
    unfold a HardinA229637RowColumn.T canonicalCount
    apply congrArg Finset.card
    ext A
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, sweep]
  have bridge (m : ℕ) :
      dotProduct (Sum.elim (1 : Column → ℤ) 0) ((transfer ^ m).mulVec terminal) =
        6 * (a (m + 1) : ℤ) := by
    rw [← transfer_count]
    have hD : 2 ≠ m * edges.card :=
      (cut_total_exclusion 5 2).mpr (Nat.not_dvd_of_pos_of_lt (by decide) (by decide)) m
    have hscale : literalCount (q := 3) ∅ edges 2 (m + 1) = 6 * a (m + 1) := by
      simpa only [Finset.card_empty, Nat.zero_add, Nat.add_zero, Nat.pred_succ, Nat.succ_ne_zero,
        or_self, ite_false, ite_eq_right hD, table_count] using labelled_scale ∅ edges 2 (m + 1)
    rw [hscale]
    push_cast
    rfl
  have h := integer_readout transfer terminal (Sum.elim (1 : Column → ℤ) 0)
    30 3 coefficients641 vector_polynomial n
  rw [bridge (n + 3 + 30)] at h
  simp_rw [fun k : Fin 30 => bridge (n + 3 + k.val)] at h
  norm_num [coefficients641, Fin.sum_univ_succ, Nat.add_assoc] at h
