private theorem old_weights_initial (i j : Fin 23) :
    oldWeights (i.castAdd 11) j = if i = j then 1 else 0 := by
  simp only [oldWeights, Fin.val_castAdd, dite_eq_left i.isLt, Fin.castLT_castAdd, Matrix.one_apply]

private theorem old_weights_step : ∀ (n : Fin 34) (hn : 23 ≤ n.val) (j : Fin 23),
    oldWeights n j = ∑ k : Fin 20, coefficients538 k *
      oldWeights ((Fin.natAdd (n.val - 20) k).castLE
        ((Nat.sub_add_cancel ((Nat.le_add_right 20 3).trans hn)).trans_le
          (Nat.le_of_lt n.isLt))) j := by
  decide +kernel

private theorem integer_readout {S : Type*} [Fintype S] [DecidableEq S]
    (M : Matrix S S ℤ) (u v : S → ℤ) (d b : ℕ) (c : Fin d → ℤ)
    (h : (M ^ (b + d)).mulVec u = ∑ j : Fin d, c j • (M ^ (b + j.val)).mulVec u) (n : ℕ) :
    dotProduct v ((M ^ (n + b + d)).mulVec u) =
      ∑ j : Fin d, c j * dotProduct v ((M ^ (n + b + j.val)).mulVec u) := by
  have forward_polynomial : DefectTransfer.forward M.transpose u (b + d) =
      ∑ j : Fin d, c j • DefectTransfer.forward M.transpose u (b + j.val) := by
    simpa only [DefectTransfer.forward_eq, ← Matrix.transpose_pow, Matrix.vecMul_transpose] using h
  simpa only [← Matrix.transpose_pow, Matrix.dotProduct_transpose_mulVec] using
    DefectTransfer.forward_shift M.transpose u v d b c forward_polynomial n

private theorem old_coordinate (p : Column ⊕ Column) (n : ℕ) :
    ((HardinA229538Strip.transfer ^ (n + 2 + 20)).mulVec HardinA229538Strip.terminal) p =
      ∑ k : Fin 20, coefficients538 k *
        ((HardinA229538Strip.transfer ^ (n + 2 + k.val)).mulVec HardinA229538Strip.terminal) p := by
  simpa only [single_one_dotProduct] using
    integer_readout HardinA229538Strip.transfer HardinA229538Strip.terminal (Pi.single p 1)
      20 2 coefficients538 HardinA229538Strip.vector_polynomial n

private theorem old_values (n : Fin 34) :
    (HardinA229538Strip.transfer ^ n.val).mulVec HardinA229538Strip.terminal =
      ∑ j : Fin 23, oldWeights n j •
        Sum.elim (tableOne j) (zeroValues j) := by
  have reconstruct (m : ℕ) (hm : m < 34) :
      (HardinA229538Strip.transfer ^ m).mulVec HardinA229538Strip.terminal =
        ∑ j : Fin 23, oldWeights ⟨m, hm⟩ j • Sum.elim (tableOne j) (zeroValues j) := by
    induction m using Nat.strong_induction_on with
    | h m ih =>
      by_cases hsmall : m < 23
      · let i : Fin 34 := ⟨m, hm⟩
        change _ = ∑ j : Fin 23, oldWeights i j • Sum.elim (tableOne j) (zeroValues j)
        rw [show i = (i.castLT hsmall).castAdd 11 from (Fin.castAdd_castLT 11 i hsmall).symm]
        simp_rw [old_weights_initial, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq, Finset.mem_univ, ite_true]
        rw [zero_values]
        exact HardinA229538Strip.table_powers (i.castLT hsmall)
      · have large : 23 ≤ m := Nat.le_of_not_gt hsmall
        have relation :
            (HardinA229538Strip.transfer ^ m).mulVec HardinA229538Strip.terminal =
              ∑ k : Fin 20, coefficients538 k •
                (HardinA229538Strip.transfer ^ (m - 20 + k.val)).mulVec
                  HardinA229538Strip.terminal := by
          funext p
          have hbound : 22 ≤ m := (Nat.le_succ 22).trans large
          have h₁ : m - 22 + 2 + 20 = m := Nat.sub_add_cancel hbound
          have h₂ (k : Fin 20) : m - 22 + 2 + k.val = m - 20 + k.val :=
            congrArg (· + k.val) (Nat.sub_add_sub_cancel hbound (Nat.le_add_right 20 2))
          simpa only [h₁, h₂, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using
            old_coordinate p (m - 22)
        rw [relation]
        have prior (k : Fin 20) : m - 20 + k.val < m := by
          simpa only [Fin.val_natAdd, Nat.sub_add_cancel ((Nat.le_add_right 20 3).trans large)]
            using (Fin.natAdd (m - 20) k).isLt
        have earlier (k : Fin 20) := ih _ (prior k) ((prior k).trans hm)
        simp_rw [earlier]
        simp_rw [old_weights_step ⟨m, hm⟩ large, Finset.sum_smul, Finset.smul_sum]
        rw [Finset.sum_comm]
        simp only [mul_smul]
        rfl
  exact reconstruct n.val n.isLt

