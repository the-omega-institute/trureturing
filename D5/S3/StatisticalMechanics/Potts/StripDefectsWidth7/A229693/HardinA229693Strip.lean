private theorem leading_step (i : Fin 14) :
    leading i.succ = Matrix.vecMul (leading i.castSucc) HardinA229585StripData.T := by
  induction i using Fin.addCases (m := 10) (n := 4) with
  | left i =>
    have hs : (i.castAdd 4).succ = i.succ.castAdd 4 := Fin.ext rfl
    have hc : (i.castAdd 4).castSucc = i.castSucc.castAdd 4 := Fin.ext rfl
    simp only [hs, hc, leading, Fin.append_left]
    exact HardinA229585Strip.finite_certificate.2.2.2.2.2.1.2 i
  | right i =>
    revert i
    decide +kernel

private theorem leading_action (v : Fin 168 → ℤ) (j : Fin 72) :
    Matrix.vecMul v T (j.castAdd 96) =
      Matrix.vecMul (fun k : Fin 72 => v (k.castAdd 96)) HardinA229585StripData.T j := by
  unfold Matrix.vecMul dotProduct
  rw [Fin.sum_univ_add (a := 72) (b := 96)]
  simp only [T, Matrix.reindex_apply, Matrix.submatrix_apply, finSumFinEquiv_symm_apply_castAdd,
    finSumFinEquiv_symm_apply_natAdd, Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₂₁,
    Matrix.zero_apply, mul_zero, Finset.sum_const_zero, add_zero]

