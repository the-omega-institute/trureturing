private theorem sum_zip_mul {n : ℕ} (u v : Fin n → ℤ) :
    (List.zipWith (· * ·) (List.ofFn u) (List.ofFn v)).sum = dotProduct u v := by
  induction n with
  | zero => simp [dotProduct]
  | succ n ih =>
    simp only [List.ofFn_succ, List.zipWith_cons_cons, List.sum_cons, ih, dotProduct,
      Fin.sum_univ_succ]

