private theorem copied_padding_check (j : Fin 40)
    (hj : (exitRead (j.natAdd 56)).val < 72) :
    (List.finRange 16).all (fun i =>
      HardinA229585StripData.T (HardinA229585StripData.zeroBudgetClass i)
