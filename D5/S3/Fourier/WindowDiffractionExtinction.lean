/-- At a positive mode, a finite interval window is extinct exactly when the
mode-scaled window length is an integer. -/
theorem window_fourier_amplitude_eq_zero_iff (length : ℝ) (m : ℕ) (hm : 0 < m) :
    ‖windowFourierCoefficient length m‖ = 0 ↔
      ∃ k : ℤ, (k : ℝ) = (m : ℝ) * length := by
  have hmReal : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  have hden : Real.pi * (m : ℝ) ≠ 0 :=
    mul_ne_zero Real.pi_ne_zero (ne_of_gt hmReal)
  rw [window_fourier_amplitude length m hm, div_eq_zero_iff, or_iff_left hden,
    abs_eq_zero, Real.sin_eq_zero_iff]
  constructor
  · rintro ⟨k, hk⟩
    refine ⟨k, (mul_left_inj' Real.pi_ne_zero).mp ?_⟩
    calc
      (k : ℝ) * Real.pi = Real.pi * (m : ℝ) * length := hk
      _ = ((m : ℝ) * length) * Real.pi := by ring
  · rintro ⟨k, hk⟩
    refine ⟨k, ?_⟩
    rw [hk]
    ring

/-- No positive Fourier mode of the reciprocal-golden-ratio window is extinct. -/
theorem golden_window_fourier_amplitude_ne_zero (m : ℕ) (hm : 0 < m) :
    ‖windowFourierCoefficient (1 / ((1 + Real.sqrt 5) / 2)) m‖ ≠ 0 := by
  intro hzero
  obtain ⟨k, hk⟩ :=
    (window_fourier_amplitude_eq_zero_iff
      (1 / ((1 + Real.sqrt 5) / 2)) m hm).mp hzero
  have hirrational : Irrational ((m : ℝ) / Real.goldenRatio) :=
    Real.goldenRatio_irrational.natCast_div hm.ne'
  exact hirrational.ne_int k (by simpa [div_eq_mul_inv] using hk.symm)

/-- The sine-kernel amplitude at a positive mode is bounded by its denominator. -/
theorem window_fourier_amplitude_le (length : ℝ) (m : ℕ) (hm : 0 < m) :
    ‖windowFourierCoefficient length m‖ ≤ 1 / (Real.pi * (m : ℝ)) := by
  have hmReal : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hm
  rw [window_fourier_amplitude length m hm]
  exact div_le_div_of_nonneg_right (Real.abs_sin_le_one _) (mul_pos Real.pi_pos hmReal).le

