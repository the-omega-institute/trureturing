   digest: The unique planar theta minimizers are the orthogonal images of the hexagonal lattice. -/

import D5.S3.Fourier.PlanarThetaFoundation
import D5.S3.Fourier.HexagonalThetaMinimum

/-! # Montgomery's minimum with actual orthogonal lattice classification -/

set_option autoImplicit false

open scoped BigOperators

namespace D5.S3.Fourier.PlanarTheta
noncomputable section

/-- The lattice generated by a basis is an orthogonal image of the unit-area hexagonal lattice. -/
def IsHexagonalBasis (a b : ℂ) : Prop :=
  ∃ U : ℂ ≃ₗᵢ[ℝ] ℂ,
    Set.range (fun v : ℤ × ℤ => (v.1 : ℂ) * a + (v.2 : ℂ) * b) =
      U '' Set.range (latticePoint (1 / 2) (Real.sqrt 3 / 2))

private lemma basisPoint_injective (a b : ℂ)
    (hab : |a.re * b.im - a.im * b.re| = 1) :
    Function.Injective (fun v : ℤ × ℤ => (v.1 : ℂ) * a + (v.2 : ℂ) * b) := by
  have hd : a.re * b.im - a.im * b.re ≠ 0 := by
    intro hz
    simp [hz] at hab
  intro v w h
  have hr := congrArg Complex.re h
  have hi := congrArg Complex.im h
  simp only [Complex.add_re, Complex.add_im, Complex.mul_re, Complex.mul_im,
    Complex.intCast_re, Complex.intCast_im, zero_mul, sub_zero, zero_add] at hr hi
  have hm : (v.1 : ℝ) = w.1 := by
    apply (mul_right_injective₀ hd)
    nlinarith only [congrArg (fun z => z * b.im) hr,
      congrArg (fun z => z * b.re) hi]
  have hn : (v.2 : ℝ) = w.2 := by
    apply (mul_right_injective₀ hd)
    nlinarith only [congrArg (fun z => z * a.im) hr,
      congrArg (fun z => z * a.re) hi]
  exact Prod.ext (Int.cast_injective hm) (Int.cast_injective hn)

private lemma theta_eq_of_orthogonal_range (a b : ℂ)
    (hab : |a.re * b.im - a.im * b.re| = 1) (hhex : IsHexagonalBasis a b)
    (t : ℝ) : basisTheta t a b = F t (1 / 2) (Real.sqrt 3 / 2) := by
  obtain ⟨U, hU⟩ := hhex
  let B := fun v : ℤ × ℤ => (v.1 : ℂ) * a + (v.2 : ℂ) * b
  let H := fun v : ℤ × ℤ => U (latticePoint (1 / 2) (Real.sqrt 3 / 2) v)
  have hB : Function.Injective B := basisPoint_injective a b hab
  have hH : Function.Injective H := U.injective.comp
    (lattice_geometry (1 / 2) (by positivity : 0 < Real.sqrt 3 / 2)).1
  have hR : Set.range B = Set.range H := by
    change Set.range B = Set.range (U ∘ latticePoint (1 / 2) (Real.sqrt 3 / 2))
    rw [Set.range_comp]
    exact hU
  let eB := Equiv.ofInjective B hB
  let eH := Equiv.ofInjective H hH
  let f := fun z : ℂ => Real.exp (-Real.pi * t * Complex.normSq z)
  calc
    basisTheta t a b = ∑' z : Set.range B, f z := by
      exact eB.tsum_eq (fun z : Set.range B => f z)
    _ = ∑' z : Set.range H, f z :=
      congrArg (fun S : Set ℂ => ∑' z : S, f z) hR
    _ = ∑' v : ℤ × ℤ, f (H v) := (eH.tsum_eq _).symm
    _ = F t (1 / 2) (Real.sqrt 3 / 2) := by
      unfold F
      apply tsum_congr
      intro v
      dsimp [f, H]
      rw [Complex.normSq_eq_norm_sq, U.norm_map,
        ← Complex.normSq_eq_norm_sq,
        (lattice_geometry (1 / 2) (by positivity : 0 < Real.sqrt 3 / 2)).2 v]

lemma basis_normSq_scale (r : ℝ) (a b : ℂ) (v : ℤ × ℤ) :
    Complex.normSq ((v.1 : ℂ) * (r • a) + (v.2 : ℂ) * (r • b)) =
      r ^ 2 * Complex.normSq ((v.1 : ℂ) * a + (v.2 : ℂ) * b) := by
  have he : (v.1 : ℂ) * (r • a) + (v.2 : ℂ) * (r • b) =
      (r : ℂ) * ((v.1 : ℂ) * a + (v.2 : ℂ) * b) := by
    simp only [Complex.real_smul]
    ring
  rw [he, Complex.normSq_mul, Complex.normSq_ofReal, pow_two]

lemma basisTheta_scale (r : ℝ) (a b : ℂ) (t : ℝ) :
    basisTheta t (r • a) (r • b) = basisTheta (t * r ^ 2) a b := by
  unfold basisTheta
  apply tsum_congr
  intro v
  rw [basis_normSq_scale]
  congr 1
  ring

lemma basis_normalized_area (a b : ℂ) {A : ℝ} (hA : 0 < A)
    (hab : |a.re * b.im - a.im * b.re| = A) :
    |(((Real.sqrt A)⁻¹ : ℝ) • a).re * (((Real.sqrt A)⁻¹ : ℝ) • b).im -
      (((Real.sqrt A)⁻¹ : ℝ) • a).im * (((Real.sqrt A)⁻¹ : ℝ) • b).re| = 1 := by
  simp only [Complex.smul_re, Complex.smul_im, smul_eq_mul]
  rw [show (Real.sqrt A)⁻¹ * a.re * ((Real.sqrt A)⁻¹ * b.im) -
      (Real.sqrt A)⁻¹ * a.im * ((Real.sqrt A)⁻¹ * b.re) =
      ((Real.sqrt A)⁻¹) ^ 2 * (a.re * b.im - a.im * b.re) by ring,
      abs_mul, abs_of_nonneg (sq_nonneg _), hab, inv_pow, Real.sq_sqrt hA.le,
      inv_mul_cancel₀ hA.ne']

/-- At every positive temperature, an area-one basis attains Montgomery's lower bound
exactly when its actual lattice is an orthogonal image of the hexagonal lattice. -/
private theorem basis_theta_minimum_unit (a b : ℂ)
    (hab : |a.re * b.im - a.im * b.re| = 1) {t : ℝ} (ht : 0 < t) :
    F t (1 / 2) (Real.sqrt 3 / 2) ≤ basisTheta t a b ∧
      (basisTheta t a b = F t (1 / 2) (Real.sqrt 3 / 2) ↔ IsHexagonalBasis a b) := by
  obtain ⟨x, y, hx, hx', hy, hnorm, hc, e, hQ⟩ := basis_reduction_geometry a b hab
  have he (u : ℝ) : basisTheta u a b = F u x y := by
    unfold basisTheta F
    calc
      _ = ∑' v : ℤ × ℤ, Real.exp (-Real.pi * u * Q x y (e v)) :=
        tsum_congr (fun v => congrArg (fun q => Real.exp (-Real.pi * u * q)) (hQ v))
      _ = _ := e.toEquiv.tsum_eq (fun v => Real.exp (-Real.pi * u * Q x y v))
  have hm := reduced_theta_minimum ht hx hx' hc
  constructor
  · rw [he t]
    exact hm.1
  · constructor
    · intro h
      have hxy := hm.2.mp ((he t).symm.trans h)
      obtain ⟨U, hU⟩ := basis_isometry_of_quadratic_reindex e hQ
      refine ⟨U.symm, ?_⟩
      rw [hxy.1, hxy.2] at hU
      apply Set.ext
      intro z
      constructor
      · rintro ⟨v, rfl⟩
        exact ⟨latticePoint (1 / 2) (Real.sqrt 3 / 2) (e v), ⟨e v, rfl⟩,
          by rw [← hU v, U.symm_apply_apply]⟩
      · rintro ⟨w, ⟨v, rfl⟩, rfl⟩
        refine ⟨e.symm v, ?_⟩
        have h := hU (e.symm v)
        rw [e.apply_symm_apply] at h
        exact U.injective (by rw [h, U.apply_symm_apply])
    · intro h
      exact theta_eq_of_orthogonal_range a b hab h t

/-- Montgomery minimum and actual isometry classification at arbitrary positive covolume. -/
theorem basis_theta_minimum_isometry (a b : ℂ) {A t : ℝ} (hA : 0 < A)
    (hab : |a.re * b.im - a.im * b.re| = A) (ht : 0 < t) :
    F (A * t) (1 / 2) (Real.sqrt 3 / 2) ≤ basisTheta t a b ∧
      (basisTheta t a b = F (A * t) (1 / 2) (Real.sqrt 3 / 2) ↔
        IsHexagonalBasis (((Real.sqrt A)⁻¹ : ℝ) • a) (((Real.sqrt A)⁻¹ : ℝ) • b)) := by
  have hm := basis_theta_minimum_unit (((Real.sqrt A)⁻¹ : ℝ) • a)
    (((Real.sqrt A)⁻¹ : ℝ) • b) (basis_normalized_area a b hA hab) (mul_pos hA ht)
  rw [basisTheta_scale, inv_pow, Real.sq_sqrt hA.le] at hm
  have he : A * t * A⁻¹ = t := by field_simp
  rwa [he] at hm

end
end D5.S3.Fourier.PlanarTheta
