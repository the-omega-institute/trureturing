import D5.S3.Fourier.RepresentativeOrbitCoordinates
import Mathlib.FieldTheory.Finite.Trace
import D5.S3.FiniteGroups.NikolovSegal.Unitary.UnitaryInvolutionField

/-! The field generated by an actual character records its exact doubling period. -/

open scoped BigOperators
open Function

namespace D5.S3.Fourier.CharacterOrbitField

/-- The degree of the actual character field is exactly its actual doubling-orbit size. -/
theorem character_orbit_degree (n d : ℕ) (hn : 3 ≤ n) (ho : Odd n)
    (F : Type*) [Field F] [Finite F] [CharP F 2]
    (ζ : F) (hζ : IsPrimitiveRoot ζ n) (t : Fin d → ZMod n) :
    let : NeZero n := ⟨by omega⟩
    let : Algebra (ZMod 2) F := ZMod.algebra F 2
    let p : Equiv.Perm (Fin d → ZMod n) := Equiv.piCongrRight
      (fun _ => (ZMod.unitOfCoprime 2 (Nat.coprime_two_left.mpr ho)).mulLeft)
    Module.finrank (ZMod 2) (IntermediateField.adjoin (ZMod 2)
      (Set.range (fun i : Fin d => ζ ^ (t i).val))) = minimalPeriod (p : _ → _) t := by
  classical
  let : NeZero n := ⟨by omega⟩
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  let G := Fin d → ZMod n
  let p : Equiv.Perm G := Equiv.piCongrRight
    (fun _ => (ZMod.unitOfCoprime 2 (Nat.coprime_two_left.mpr ho)).mulLeft)
  let K := IntermediateField.adjoin (ZMod 2) (Set.range (fun i : Fin d => ζ ^ (t i).val))
  let φ := FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) K
  let ψ := AddChar.zmodChar n hζ.pow_eq_one
  have hp (a : G) : p a = fun i => (2 : ZMod n) * a i := by
    funext i
    simp [p, Equiv.piCongrRight, Units.mulLeft, ZMod.coe_unitOfCoprime]
  have hpiter (a : G) (l : ℕ) : (p : G → G)^[l] a = fun i => (2 : ZMod n)^l * a i := by
    have he : (p : G → G) = fun a : G => (fun _ => (2 : ZMod n)) * a := funext hp
    rw [he, mul_left_iterate_apply]
    rfl
  have hpow (a : ZMod n) (l : ℕ) : ψ ((2 : ZMod n)^l * a) = (ψ a)^(2^l) := by
    rw [← ψ.map_nsmul_eq_pow]
    congr 1
    simp [nsmul_eq_mul]
  have hψinj : Injective ψ := by
    intro a b hab
    change ζ ^ a.val = ζ ^ b.val at hab
    exact ZMod.val_injective n (hζ.pow_inj (ZMod.val_lt a) (ZMod.val_lt b) hab)
  let g (i : Fin d) : K := ⟨ζ ^ (t i).val,
    IntermediateField.subset_adjoin (ZMod 2) _ ⟨i, rfl⟩⟩
  have hφpow (l : ℕ) (a : K) : (φ^l) a = a^(2^l) := by
    change ((FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) K)^l) a = _
    rw [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
    simp only [ZMod.card]
  have hequiv (l : ℕ) : φ^l = 1 ↔ (p : G → G)^[l] t = t := by
    constructor
    · intro h
      funext i
      have hg := congrArg (fun e : K ≃ₐ[ZMod 2] K => (e (g i) : F)) h
      rw [hφpow] at hg
      change (ζ ^ (t i).val)^(2^l) = ζ ^ (t i).val at hg
      rw [hpiter]
      apply hψinj
      exact (hpow (t i) l).trans hg
    · intro h
      have hh : (φ^l).toAlgHom = (1 : K ≃ₐ[ZMod 2] K).toAlgHom := by
        apply IntermediateField.adjoin_algHom_ext
        rintro a ⟨i, rfl⟩
        apply Subtype.ext
        change ((φ^l) (g i) : F) = ζ ^ (t i).val
        rw [hφpow]
        change (ζ ^ (t i).val)^(2^l) = ζ ^ (t i).val
        have hi := congrFun h i
        rw [hpiter] at hi
        change (2 : ZMod n)^l * t i = t i at hi
        exact (hpow (t i) l).symm.trans (congrArg ψ hi)
      ext a
      exact congrArg Subtype.val (DFunLike.congr_fun hh a)
  have hdiv (l : ℕ) : Module.finrank (ZMod 2) K ∣ l ↔ minimalPeriod (p : G → G) t ∣ l := by
    rw [← FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic, orderOf_dvd_iff_pow_eq_one]
    exact (hequiv l).trans isPeriodicPt_iff_minimalPeriod_dvd
  exact Nat.dvd_antisymm ((hdiv _).mpr (dvd_refl _)) ((hdiv _).mp (dvd_refl _))

/-- A nonzero self-paired actual orbit supplies its own nonidentity field involution. -/
theorem self_paired_character_involution (n d : ℕ) (hn : 3 ≤ n) (ho : Odd n)
    (F : Type*) [Field F] [Finite F] [CharP F 2]
    (ζ : F) (hζ : IsPrimitiveRoot ζ n) (t : Fin d → ZMod n) :
    let : NeZero n := ⟨by omega⟩
    let : Algebra (ZMod 2) F := ZMod.algebra F 2
    let G := Fin d → ZMod n
    let p : Equiv.Perm G := Equiv.piCongrRight
      (fun _ => (ZMod.unitOfCoprime 2 (Nat.coprime_two_left.mpr ho)).mulLeft)
    let K := IntermediateField.adjoin (ZMod 2)
      (Set.range (fun i : Fin d => ζ ^ (t i).val))
    ∀ j : ℕ, (p : G → G)^[j] t = -t → t ≠ 0 →
    ∃ σ : K ≃+* K, Function.Involutive σ ∧ σ ≠ RingEquiv.refl K ∧
      Even (minimalPeriod (p : G → G) t) ∧
      ∀ i : Fin d,
        (σ ⟨ζ ^ (t i).val, IntermediateField.subset_adjoin (ZMod 2) _ ⟨i, rfl⟩⟩ : F) =
          (ζ ^ (t i).val)⁻¹ := by
  classical
  let : NeZero n := ⟨by omega⟩
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  let G := Fin d → ZMod n
  let p : Equiv.Perm G := Equiv.piCongrRight
    (fun _ => (ZMod.unitOfCoprime 2 (Nat.coprime_two_left.mpr ho)).mulLeft)
  let K := IntermediateField.adjoin (ZMod 2) (Set.range (fun i : Fin d => ζ ^ (t i).val))
  let φ := FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) K
  let ψ := AddChar.zmodChar n hζ.pow_eq_one
  dsimp only
  intro j hj ht
  have hp (a : G) : p a = fun i => (2 : ZMod n) * a i := by
    funext i
    simp [p, Equiv.piCongrRight, Units.mulLeft, ZMod.coe_unitOfCoprime]
  have hpiter (a : G) (l : ℕ) : (p : G → G)^[l] a = fun i => (2 : ZMod n)^l * a i := by
    have he : (p : G → G) = fun a : G => (fun _ => (2 : ZMod n)) * a := funext hp
    rw [he, mul_left_iterate_apply]
    rfl
  have hcomm : Function.Commute (p : G → G) Neg.neg := by
    intro a
    rw [hp, hp]
    funext i
    exact mul_neg _ _
  have hj2 : (p : G → G)^[j+j] t = t := by
    rw [iterate_add_apply, hj, hcomm.iterate_left j, hj, neg_neg]
  have hd := character_orbit_degree n d hn ho F ζ hζ t
  change Module.finrank (ZMod 2) K = minimalPeriod (p : G → G) t at hd
  have hφ2 : φ^(j+j) = 1 := by
    apply orderOf_dvd_iff_pow_eq_one.mp
    rw [FiniteField.orderOf_frobeniusAlgEquivOfAlgebraic, hd]
    exact IsPeriodicPt.minimalPeriod_dvd hj2
  let σ : K ≃+* K := (φ^j).toRingEquiv
  have hinv : Function.Involutive σ := by
    intro x
    change ((φ^j)*(φ^j)) x = x
    rw [← pow_add, hφ2]
    rfl
  let g (i : Fin d) : K := ⟨ζ ^ (t i).val,
    IntermediateField.subset_adjoin (ZMod 2) _ ⟨i, rfl⟩⟩
  have hgen (i : Fin d) : (σ (g i) : F) = (ζ ^ (t i).val)⁻¹ := by
    change ((φ^j) (g i) : F) = _
    rw [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate]
    change (ζ ^ (t i).val)^(2^j) = _
    have hpow : ψ ((2 : ZMod n)^j * t i) = (ψ (t i))^(2^j) := by
      rw [← ψ.map_nsmul_eq_pow]
      congr 1
      simp [nsmul_eq_mul]
    have hi := congrFun hj i
    rw [hpiter] at hi
    change (2 : ZMod n)^j * t i = -(t i) at hi
    exact hpow.symm.trans ((congrArg ψ hi).trans (ψ.map_neg_eq_inv _))
  have hne : σ ≠ RingEquiv.refl K := by
    intro heq
    have hneg : t = -t := by
      funext i
      have hh := hgen i
      rw [heq] at hh
      change ψ (t i) = (ψ (t i))⁻¹ at hh
      rw [← ψ.map_neg_eq_inv] at hh
      change ζ ^ (t i).val = ζ ^ (-(t i)).val at hh
      exact ZMod.val_injective n (hζ.pow_inj (ZMod.val_lt _) (ZMod.val_lt _) hh)
    apply ht
    apply p.injective
    rw [hp, hp]
    funext i
    change (2 : ZMod n) * t i = 2 * 0
    rw [mul_zero, two_mul]
    have hi := congrFun hneg i
    change t i = -(t i) at hi
    exact (congrArg (fun a => a + t i) hi).trans (neg_add_cancel (t i))
  have heven : Even (minimalPeriod (p : G → G) t) := by
    let L := NikolovSegal.UnitaryField.fixedField σ
    let : Algebra (ZMod 2) L := ZMod.algebra L 2
    have hdim := Module.finrank_mul_finrank (ZMod 2) L K
    rw [NikolovSegal.UnitaryField.finrank_fixedField σ hinv hne, hd] at hdim
    exact ⟨Module.finrank (ZMod 2) L, by omega⟩
  exact ⟨σ, hinv, hne, heven, hgen⟩

end D5.S3.Fourier.CharacterOrbitField
