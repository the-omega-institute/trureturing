import Mathlib.Tactic

/- Library-search audit trail (2026-09-04):
   * Repository searches for global-bit, tensor-power, rank-one cumulant, and shift-dependent
     cumulant obstructions found no exact theorem. `FiniteMirrorCumulantOddOrderInvisibility`
     concerns parity cancellation, while `SinglePrimeVisibleSpace` concerns readout kernels.
   * Pinned Mathlib supplies finite-index case splitting and elementary nonzero-product lemmas.
     No library theorem packages this three-shift rank-one obstruction. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Analytic.GlobalBitCumulantObstruction

/-- The second-order cumulant family generated by one displacement vector and one global scale. -/
def radialPairCumulant (scale : ℝ) (displacement : Fin 3 → ℝ) (i j : Fin 3) : ℝ :=
  scale * displacement i * displacement j

/-- A symmetric shift-dependent pattern: adjacent pairs correlate, while the distance-two pair
does not. This is the smallest explicit pattern needed to test rank-one radial encoding. -/
def adjacentShiftCumulant (i j : Fin 3) : ℝ :=
  if ((i = 0 ∧ j = 1) ∨ (i = 1 ∧ j = 0) ∨
      (i = 1 ∧ j = 2) ∨ (i = 2 ∧ j = 1)) then 1 else 0

private theorem radial_nonzero_closure (scale : ℝ) (displacement : Fin 3 → ℝ)
    (h01 : radialPairCumulant scale displacement 0 1 ≠ 0)
    (h12 : radialPairCumulant scale displacement 1 2 ≠ 0) :
    radialPairCumulant scale displacement 0 2 ≠ 0 := by
  have hscale : scale ≠ 0 := by
    intro h
    apply h01
    simp [radialPairCumulant, h]
  have hzero : displacement 0 ≠ 0 := by
    intro h
    apply h01
    simp [radialPairCumulant, h]
  have htwo : displacement 2 ≠ 0 := by
    intro h
    apply h12
    simp [radialPairCumulant, h]
  exact mul_ne_zero (mul_ne_zero hscale hzero) htwo

/-- A single global radial bit produces rank-one pair cumulants. Such families obey a nonzero
closure law, but the explicit adjacent-shift pattern violates it. Hence no scale and displacement
vector can encode all shift-dependent pair cumulants through one tensor square. -/
theorem one_global_bit_cannot_encode_all_pair_cumulants :
    (∀ i j, adjacentShiftCumulant i j = adjacentShiftCumulant j i) ∧
      adjacentShiftCumulant 0 1 = 1 ∧
      adjacentShiftCumulant 1 2 = 1 ∧
      adjacentShiftCumulant 0 2 = 0 ∧
      (∀ scale displacement,
        radialPairCumulant scale displacement 0 1 ≠ 0 →
        radialPairCumulant scale displacement 1 2 ≠ 0 →
        radialPairCumulant scale displacement 0 2 ≠ 0) ∧
      ¬ ∃ scale displacement,
        radialPairCumulant scale displacement = adjacentShiftCumulant := by
  refine ⟨?_, by simp [adjacentShiftCumulant], by simp [adjacentShiftCumulant],
    by simp [adjacentShiftCumulant], radial_nonzero_closure, ?_⟩
  · intro i j
    fin_cases i <;> fin_cases j <;> simp [adjacentShiftCumulant]
  · rintro ⟨scale, displacement, representation⟩
    have h01 : radialPairCumulant scale displacement 0 1 ≠ 0 := by
      rw [representation]
      simp [adjacentShiftCumulant]
    have h12 : radialPairCumulant scale displacement 1 2 ≠ 0 := by
      rw [representation]
      simp [adjacentShiftCumulant]
    have h02 := radial_nonzero_closure scale displacement h01 h12
    apply h02
    rw [representation]
    simp [adjacentShiftCumulant]

/-- The obstruction is not caused by an empty radial family: the constant-one pair cumulant has
an explicit radial representation. -/
theorem constant_pair_cumulant_has_radial_representation :
    ∃ scale displacement,
      radialPairCumulant scale displacement = fun _ _ => 1 := by
  refine ⟨1, fun _ => 1, ?_⟩
  funext i j
  simp [radialPairCumulant]

#print axioms one_global_bit_cannot_encode_all_pair_cumulants
#print axioms constant_pair_cumulant_has_radial_representation

end D5.S3.Analytic.GlobalBitCumulantObstruction
