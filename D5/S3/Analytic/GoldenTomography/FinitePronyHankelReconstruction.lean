   generality: G
   mirror-B: D5/B/S3/Analytic/GoldenTomography/FinitePronyHankelReconstruction
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Finite exponential moments satisfy their Prony recurrence and have a full-rank Hankel factorization at separated nodes. -/

import D5.S3.Analytic.GoldenTomography.FiniteVandermondeTomography
import Mathlib.Algebra.Polynomial.Eval.Defs
import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.Tactic

/-!
# Finite Prony--Hankel reconstruction

For a finite exponential sum

`c n = sum j, weight j * node j ^ n`,

the annihilator polynomial of the nodes gives an exact linear recurrence.  The
finite Hankel matrix factors through a rectangular Vandermonde matrix.  When
the nodes are distinct and the weights are nonzero, every Hankel section with
at least as many rows as modes has rank equal to the number of modes.

This is an exact finite-dimensional theorem.  It does not assert numerical
conditioning, noisy-node recovery, confluent reconstruction, or an infinite
Hankel-operator limit.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open scoped BigOperators

namespace D5.S3.Analytic.GoldenTomography.FinitePronyHankelReconstruction

open Matrix
open Polynomial
open D5.S3.Analytic.GoldenTomography.FiniteVandermondeTomography

universe u

variable {K : Type u} [Field K]

/-- The moment sequence of a finite weighted exponential family. -/
def pronyMoment {m : ℕ}
    (nodes weights : Fin m → K) (n : ℕ) : K :=
  ∑ j, weights j * nodes j ^ n

/-- The monic polynomial whose roots are the sampled nodes. -/
def pronyAnnihilator {m : ℕ} (nodes : Fin m → K) : K[X] :=
  ∏ j, (X - C (nodes j))

/-- The rectangular Vandermonde factor with observation times on rows and
modes on columns. -/
def pronyVandermonde {m n : ℕ}
    (nodes : Fin m → K) : Matrix (Fin n) (Fin m) K :=
  fun time mode => nodes mode ^ (time : ℕ)

/-- The finite Hankel section generated by the moment sequence. -/
def pronyHankel {m n : ℕ}
    (nodes weights : Fin m → K) : Matrix (Fin n) (Fin n) K :=
  fun row column => pronyMoment nodes weights ((row : ℕ) + (column : ℕ))

/-- The first matching number of moments, viewed as a function of the hidden
weights. -/
def firstPronyMoments {m : ℕ}
    (nodes weights : Fin m → K) : Fin m → K :=
  fun n => pronyMoment nodes weights n

@[simp]
theorem prony_annihilator_eval_node {m : ℕ}
    (nodes : Fin m → K) (mode : Fin m) :
    (pronyAnnihilator nodes).eval (nodes mode) = 0 := by
  classical
  simp [pronyAnnihilator]

/-- The node annihilator gives the exact Prony recurrence in coefficient form. -/
theorem prony_moment_linear_recurrence {m : ℕ}
    (nodes weights : Fin m → K) (n : ℕ) :
    ∑ k in (pronyAnnihilator nodes).support,
        (pronyAnnihilator nodes).coeff k *
          pronyMoment nodes weights (n + k) = 0 := by
  classical
  let p := pronyAnnihilator nodes
  change ∑ k in p.support, p.coeff k *
      (∑ j, weights j * nodes j ^ (n + k)) = 0
  calc
    (∑ k in p.support, p.coeff k *
        (∑ j, weights j * nodes j ^ (n + k))) =
        ∑ k in p.support, ∑ j,
          p.coeff k * (weights j * nodes j ^ (n + k)) := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [Finset.mul_sum]
    _ = ∑ j, ∑ k in p.support,
          p.coeff k * (weights j * nodes j ^ (n + k)) := by
      rw [Finset.sum_comm]
    _ = 0 := by
      apply Finset.sum_eq_zero
      intro j hj
      calc
        (∑ k in p.support,
            p.coeff k * (weights j * nodes j ^ (n + k))) =
            weights j * nodes j ^ n *
              (∑ k in p.support, p.coeff k * nodes j ^ k) := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro k hk
          rw [pow_add]
          ring
        _ = weights j * nodes j ^ n * p.eval (nodes j) := by
          rw [eval_eq_sum]
        _ = 0 := by
          rw [show p.eval (nodes j) = 0 by
            simpa [p] using prony_annihilator_eval_node nodes j]
          ring

/-- A square Prony Vandermonde matrix is the transpose of Mathlib's canonical
Vandermonde matrix. -/
theorem square_pronyVandermonde_eq_transpose {m : ℕ}
    (nodes : Fin m → K) :
    pronyVandermonde (n := m) nodes = (Matrix.vandermonde nodes)ᵀ := by
  rfl

/-- Every finite Hankel section factors as `V * diag(weights) * Vᵀ`. -/
theorem prony_hankel_factorization {m n : ℕ}
    (nodes weights : Fin m → K) :
    pronyHankel (n := n) nodes weights =
      pronyVandermonde (n := n) nodes * Matrix.diagonal weights *
        (pronyVandermonde (n := n) nodes)ᵀ := by
  classical
  ext row column
  unfold pronyHankel pronyMoment
  rw [Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro mode hmode
  rw [Matrix.mul_diagonal]
  simp only [pronyVandermonde, transpose_apply]
  rw [pow_add]
  ring

/-- The first matching moment window recovers all weights at separated nodes. -/
theorem first_prony_moments_injective {m : ℕ}
    {nodes : Fin m → K} (hNodes : Function.Injective nodes) :
    Function.Injective (firstPronyMoments nodes) := by
  simpa only [firstPronyMoments, pronyMoment, finiteMomentReadout,
    Matrix.vecMul] using finite_moment_readout_injective hNodes

/-- Embed the first `m` observation times into a longer section. -/
def finInitialEmbedding {m n : ℕ} (hmn : m ≤ n) : Fin m → Fin n :=
  fun i => ⟨i, lt_of_lt_of_le i.isLt hmn⟩

/-- The leading `m × m` block of a longer Hankel section is the square Hankel
section. -/
theorem prony_hankel_initial_submatrix {m n : ℕ}
    (hmn : m ≤ n) (nodes weights : Fin m → K) :
    (pronyHankel (n := n) nodes weights).submatrix
        (finInitialEmbedding hmn) (finInitialEmbedding hmn) =
      pronyHankel (n := m) nodes weights := by
  rfl

/-- Distinct nodes and nonzero weights make every sufficiently long Hankel
section have rank exactly equal to the number of modes. -/
theorem prony_hankel_rank {m n : ℕ}
    (hmn : m ≤ n) {nodes weights : Fin m → K}
    (hNodes : Function.Injective nodes)
    (hWeights : ∀ mode, weights mode ≠ 0) :
    Matrix.rank (pronyHankel (n := n) nodes weights) = m := by
  classical
  let V : Matrix (Fin m) (Fin m) K := pronyVandermonde (n := m) nodes
  let D : Matrix (Fin m) (Fin m) K := Matrix.diagonal weights
  have hDetV : Matrix.det V ≠ 0 := by
    rw [V, square_pronyVandermonde_eq_transpose, Matrix.det_transpose]
    exact vandermonde_det_ne_zero_of_injective hNodes
  have hDetD : Matrix.det D ≠ 0 := by
    rw [D, Matrix.det_diagonal]
    exact Finset.prod_ne_zero_iff.mpr fun mode _ => hWeights mode
  have hSquareFactor :
      pronyHankel (n := m) nodes weights = V * D * Vᵀ := by
    simpa [V, D] using prony_hankel_factorization (n := m) nodes weights
  have hDetSquare : Matrix.det (pronyHankel (n := m) nodes weights) ≠ 0 := by
    rw [hSquareFactor, Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose]
    exact mul_ne_zero (mul_ne_zero hDetV hDetD) hDetV
  have hLower :
      m ≤ Matrix.rank (pronyHankel (n := n) nodes weights) := by
    have hBlockRank :
        Matrix.rank
            ((pronyHankel (n := n) nodes weights).submatrix
              (finInitialEmbedding hmn) (finInitialEmbedding hmn)) = m := by
      rw [prony_hankel_initial_submatrix hmn]
      simpa using Matrix.rank_of_det_ne_zero hDetSquare
    rw [← hBlockRank]
    exact Matrix.rank_submatrix_le
      (pronyHankel (n := n) nodes weights)
      (finInitialEmbedding hmn) (finInitialEmbedding hmn)
  have hUpper :
      Matrix.rank (pronyHankel (n := n) nodes weights) ≤ m := by
    rw [prony_hankel_factorization]
    calc
      Matrix.rank
          (pronyVandermonde (n := n) nodes * Matrix.diagonal weights *
            (pronyVandermonde (n := n) nodes)ᵀ) ≤
          Matrix.rank
            (pronyVandermonde (n := n) nodes * Matrix.diagonal weights) :=
        Matrix.rank_mul_le_left _ _
      _ ≤ Matrix.rank (pronyVandermonde (n := n) nodes) :=
        Matrix.rank_mul_le_left _ _
      _ ≤ Fintype.card (Fin m) := Matrix.rank_le_card_width _
      _ = m := Fintype.card_fin m
  exact Nat.le_antisymm hUpper hLower

/-- The exact finite Prony--Hankel package: recurrence, factorization, faithful
weight recovery, and full Hankel rank at every section size `n ≥ m`. -/
theorem finite_prony_hankel_reconstruction {m n : ℕ}
    (hmn : m ≤ n) {nodes weights : Fin m → K}
    (hNodes : Function.Injective nodes)
    (hWeights : ∀ mode, weights mode ≠ 0) :
    (∀ k : ℕ,
      ∑ r in (pronyAnnihilator nodes).support,
          (pronyAnnihilator nodes).coeff r *
            pronyMoment nodes weights (k + r) = 0) ∧
    pronyHankel (n := n) nodes weights =
      pronyVandermonde (n := n) nodes * Matrix.diagonal weights *
        (pronyVandermonde (n := n) nodes)ᵀ ∧
    Function.Injective (firstPronyMoments nodes) ∧
    Matrix.rank (pronyHankel (n := n) nodes weights) = m := by
  exact ⟨prony_moment_linear_recurrence nodes weights,
    prony_hankel_factorization nodes weights,
    first_prony_moments_injective hNodes,
    prony_hankel_rank hmn hNodes hWeights⟩

#print axioms prony_moment_linear_recurrence
#print axioms prony_hankel_factorization
#print axioms first_prony_moments_injective
#print axioms prony_hankel_rank
#print axioms finite_prony_hankel_reconstruction

end D5.S3.Analytic.GoldenTomography.FinitePronyHankelReconstruction
