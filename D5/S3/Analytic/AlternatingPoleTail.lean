import Mathlib.RingTheory.PowerSeries.Binomial

/- Provenance: thin honest wrapper over pinned mathlib's negative-binomial
   power series (`PowerSeries.rescale_neg_one_invOneSubPow`,
   `PowerSeries.invOneSubPow_val_succ_eq_mk_add_choose`) and coefficient
   rescaling (`PowerSeries.coeff_rescale`). -/

namespace D5.S3.Analytic.AlternatingPoleTail

open PowerSeries

/-- The coefficient tail generated by a pole of order `k + 1` at `-1` is
exactly an alternating binomial sequence. In particular, the absolute
coefficients follow the polynomial-in-`n` negative-binomial law. -/
theorem alternating_pole_tail_coeff (k n : ℕ) :
    coeff n
        (rescale (-1 : ℚ) (invOneSubPow ℚ (k + 1)).val) =
      (-1 : ℚ) ^ n * (Nat.choose (k + n) k : ℚ) := by
  rw [coeff_rescale, invOneSubPow_val_succ_eq_mk_add_choose, coeff_mk]

end D5.S3.Analytic.AlternatingPoleTail
