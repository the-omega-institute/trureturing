/- GID: D5/S3/Analytic/Adelic/ReflectedGrowthPairSecondOrderSpectrum
   generality: G
   mirror-B: D5/B/S3/Analytic/Adelic/ReflectedGrowthPairSecondOrderSpectrum
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Identify the reflected-pair signed determinant with the negative second-derivative eigenvalue. -/

import D5.S3.Analytic.Adelic.ReflectedGrowthPairNegativeSquare
import Mathlib.Analysis.SpecialFunctions.ExpDeriv
import Mathlib.Tactic

/- Library-search audit trail (2026-08-31):
   * The frozen `ReflectedGrowthPairNegativeSquare` owner supplies the two
     reciprocal real exponential branches and their signed determinant
     `-delta^2`, but it does not identify that quantity as an operator
     eigenvalue.
   * Pinned Mathlib supplies the exact iterated-derivative formula for
     `t ↦ exp(c * t)` and the additive iterated-derivative rule.
   * This module freezes only the scalar second-order bridge. It does not
     identify the auxiliary parameter with physical time, construct a global
     zeta spectral realization, or assert the Riemann hypothesis. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace D5.S3.Analytic.Adelic.ReflectedGrowthPairSecondOrderSpectrum

open D5.S3.Analytic.Adelic.ReflectedGrowthPairNegativeSquare

/-- The branch generated by the rate `delta`. -/
def positiveRateBranch (delta : ℝ) : ℝ → ℝ :=
  fun time => (reflectedGrowthPair delta time).1

/-- The branch generated by the reflected rate `-delta`. -/
def negativeRateBranch (delta : ℝ) : ℝ → ℝ :=
  fun time => (reflectedGrowthPair delta time).2

/-- The scalar negative second-derivative observer. -/
def negativeSecondDerivative (f : ℝ → ℝ) (time : ℝ) : ℝ :=
  -iteratedDeriv 2 f time

/-- Every derivative of the positive-rate branch is obtained by multiplying
by the corresponding power of `delta`. -/
theorem positive_rate_branch_iterated_derivative
    (n : ℕ) (delta time : ℝ) :
    iteratedDeriv n (positiveRateBranch delta) time =
      delta ^ n * positiveRateBranch delta time := by
  change iteratedDeriv n (fun t : ℝ => Real.exp (delta * t)) time =
    delta ^ n * Real.exp (delta * time)
  exact congrFun (iteratedDeriv_exp_const_mul n delta) time

/-- Every derivative of the reflected branch is obtained by multiplying by
the corresponding power of `-delta`. -/
theorem negative_rate_branch_iterated_derivative
    (n : ℕ) (delta time : ℝ) :
    iteratedDeriv n (negativeRateBranch delta) time =
      (-delta) ^ n * negativeRateBranch delta time := by
  have hbranch :
      negativeRateBranch delta =
        fun t : ℝ => Real.exp ((-delta) * t) := by
    funext t
    simp [negativeRateBranch, reflectedGrowthPair]
  rw [hbranch]
  exact congrFun (iteratedDeriv_exp_const_mul n (-delta)) time

/-- Both reflected branches have the same positive second derivative
coefficient `delta^2`. -/
theorem reflected_rate_branches_second_derivative
    (delta time : ℝ) :
    iteratedDeriv 2 (positiveRateBranch delta) time =
        delta ^ 2 * positiveRateBranch delta time ∧
      iteratedDeriv 2 (negativeRateBranch delta) time =
        delta ^ 2 * negativeRateBranch delta time := by
  constructor
  · exact positive_rate_branch_iterated_derivative 2 delta time
  · calc
      iteratedDeriv 2 (negativeRateBranch delta) time =
          (-delta) ^ 2 * negativeRateBranch delta time :=
        negative_rate_branch_iterated_derivative 2 delta time
      _ = delta ^ 2 * negativeRateBranch delta time := by ring

/-- The symmetric branch-forgetting readout has an explicit derivative at
every order. -/
theorem reflected_growth_sum_iterated_derivative
    (n : ℕ) (delta time : ℝ) :
    iteratedDeriv n (reflectedGrowthSum delta) time =
      delta ^ n * positiveRateBranch delta time +
        (-delta) ^ n * negativeRateBranch delta time := by
  have hpositive : ContDiffAt ℝ n (positiveRateBranch delta) time := by
    unfold positiveRateBranch reflectedGrowthPair
    fun_prop
  have hnegative : ContDiffAt ℝ n (negativeRateBranch delta) time := by
    unfold negativeRateBranch reflectedGrowthPair
    fun_prop
  change iteratedDeriv n
      (fun t : ℝ =>
        positiveRateBranch delta t + negativeRateBranch delta t) time = _
  rw [iteratedDeriv_fun_add hpositive hnegative,
    positive_rate_branch_iterated_derivative,
    negative_rate_branch_iterated_derivative]

/-- The symmetric readout is itself a second-order eigenmode with coefficient
`delta^2`. -/
theorem reflected_growth_sum_second_derivative
    (delta time : ℝ) :
    iteratedDeriv 2 (reflectedGrowthSum delta) time =
      delta ^ 2 * reflectedGrowthSum delta time := by
  rw [reflected_growth_sum_iterated_derivative]
  change delta ^ 2 * positiveRateBranch delta time +
      (-delta) ^ 2 * negativeRateBranch delta time =
    delta ^ 2 *
      (positiveRateBranch delta time + negativeRateBranch delta time)
  ring

/-- The branch-forgetting observer is first-order blind at the reflection
center. -/
theorem reflected_growth_sum_first_derivative_at_zero (delta : ℝ) :
    iteratedDeriv 1 (reflectedGrowthSum delta) 0 = 0 := by
  rw [reflected_growth_sum_iterated_derivative]
  simp [positiveRateBranch, negativeRateBranch, reflectedGrowthPair]

/-- The second derivative at the reflection center records exactly twice the
squared splitting magnitude. -/
theorem reflected_growth_sum_second_derivative_at_zero (delta : ℝ) :
    iteratedDeriv 2 (reflectedGrowthSum delta) 0 =
      2 * delta ^ 2 := by
  rw [reflected_growth_sum_second_derivative]
  simp [reflectedGrowthSum, reflectedGrowthPair]
  ring

/-- A nonzero reflected split is strictly visible to the second-order
symmetric observer. -/
theorem reflected_growth_sum_second_order_visible_of_ne_zero
    (delta : ℝ) (hdelta : delta ≠ 0) :
    0 < iteratedDeriv 2 (reflectedGrowthSum delta) 0 := by
  rw [reflected_growth_sum_second_derivative_at_zero]
  positivity

/-- The signed determinant from the reflected generator is precisely the
negative-second-derivative eigenvalue of both branches and of their symmetric
readout. -/
theorem reflected_growth_pair_second_order_spectrum
    (delta time : ℝ) :
    negativeSecondDerivative (positiveRateBranch delta) time =
        reflectionPairSignedDeterminant delta *
          positiveRateBranch delta time ∧
      negativeSecondDerivative (negativeRateBranch delta) time =
        reflectionPairSignedDeterminant delta *
          negativeRateBranch delta time ∧
      negativeSecondDerivative (reflectedGrowthSum delta) time =
        reflectionPairSignedDeterminant delta *
          reflectedGrowthSum delta time := by
  have hdet :
      reflectionPairSignedDeterminant delta = -(delta ^ 2) :=
    (reflection_pair_signed_determinant delta 0).2.1
  constructor
  · unfold negativeSecondDerivative
    rw [(reflected_rate_branches_second_derivative delta time).1, hdet]
    ring
  constructor
  · unfold negativeSecondDerivative
    rw [(reflected_rate_branches_second_derivative delta time).2, hdet]
    ring
  · unfold negativeSecondDerivative
    rw [reflected_growth_sum_second_derivative, hdet]
    ring

/-- With zero splitting, the symmetric readout has zero second-order signal. -/
example : iteratedDeriv 2 (reflectedGrowthSum 0) 0 = 0 := by
  simp [reflected_growth_sum_second_derivative_at_zero]

#print axioms reflected_growth_pair_second_order_spectrum
#print axioms reflected_growth_sum_first_derivative_at_zero
#print axioms reflected_growth_sum_second_derivative_at_zero
#print axioms reflected_growth_sum_second_order_visible_of_ne_zero

end D5.S3.Analytic.Adelic.ReflectedGrowthPairSecondOrderSpectrum
