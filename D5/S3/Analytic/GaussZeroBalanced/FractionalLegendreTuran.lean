private lemma witness_negative :
    gauss (-(3/2)) (1 + 3/2) 1 (4095/4096) ^ 2 -
      gauss (-(3/2) - 63/64) (1 + 3/2 + 63/64) 1 (4095/4096) *
        gauss (-(3/2) + 63/64) (1 + 3/2 - 63/64) 1 (4095/4096) < 0 := by
  have hm := minus_enclosure
  have hc := center_enclosure
  have hp := plus_enclosure
  norm_num at hm hc hp ⊢
  have hcs := mul_self_le_mul_self (by linarith) hc.2
  have hprod := mul_le_mul (neg_le_neg hm.2) (neg_le_neg hp.2)
    (by norm_num) (by linarith)
  have hnum : (184/100 : ℚ)^2 - (-227/100)*(-150/100) < 0 := by norm_num
  have hnum' : (184/100 : ℝ)^2 - (-227/100)*(-150/100) < 0 := by
    have hcast := (Rat.cast_lt_zero (K := ℝ)).mpr hnum
    convert hcast using 1 <;> norm_num [Rat.cast_def]
  rw [← sub_lt_zero]
  apply lt_of_le_of_lt ?_ hnum'
  nlinarith [hcs, hprod]

