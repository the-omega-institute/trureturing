private lemma minus_enclosure :
    (-23/10 : ℝ) ≤ gauss (-(33/64)) (1 + 33/64) 1 (4095/4096) ∧
      gauss (-(33/64)) (1 + 33/64) 1 (4095/4096) ≤ (-227/100 : ℝ) := by
  have ha := minus_finite_bounds ((fun k : ℕ => ordinaryHypergeometricCoefficient (-(33/64)) (1 + (33/64)) 1 k * (4095/4096) ^ k)) 1000000000000
