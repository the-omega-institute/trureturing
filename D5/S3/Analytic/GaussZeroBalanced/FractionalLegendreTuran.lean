/-- SF21 Conjecture 4, retaining the argument interval of its preceding display. -/
def claim : Prop :=
  ∀ (μ : ℝ) (δ : ℝ) (y : ℝ),
    0 < μ → 0 < δ → δ < 1 → 0 < y → y < 1 →
      gauss (-μ) (1 + μ) 1 y ^ 2 >
        gauss (-μ - δ) (1 + μ + δ) 1 y *
          gauss (-μ + δ) (1 + μ - δ) 1 y

private def Valid (f : ℕ → ℝ) (M : ℝ) (n : ℕ) (a : Box) : Prop :=
  (a.lo : ℝ) ≤ f n * M ∧ f n * M ≤ (a.hi : ℝ) ∧
  (a.sl : ℝ) ≤ (∑ k ∈ Finset.range (n + 1), f k) * M ∧
    (∑ k ∈ Finset.range (n + 1), f k) * M ≤ (a.su : ℝ)

private lemma step_sound (p q r s : ℤ) (f : ℕ → ℝ) (M : ℝ) (n : ℕ)
    (a : Box) (b : ℤ × ℤ)
    (hf : f (n + 1) = f n * ((numerator p q r n : ℝ) / (denominator q s n : ℝ)))
    (ha : Valid f M n a) (h : link p q r s n a b = true) :
    Valid f M (n + 1) (next a b) := by
  simp only [link, decide_eq_true_eq] at h
  rcases h with ⟨hd, hl1, hl2, hu1, hu2⟩
  have hd' : (0 : ℝ) < denominator q s n := by exact Int.cast_pos.mpr hd
  have hl1' : (b.1 : ℝ) * denominator q s n ≤ (a.lo : ℝ) * numerator p q r n := by exact_mod_cast hl1
  have hl2' : (b.1 : ℝ) * denominator q s n ≤ (a.hi : ℝ) * numerator p q r n := by exact_mod_cast hl2
  have hu1' : (a.lo : ℝ) * numerator p q r n ≤ (b.2 : ℝ) * denominator q s n := by exact_mod_cast hu1
  have hu2' : (a.hi : ℝ) * numerator p q r n ≤ (b.2 : ℝ) * denominator q s n := by exact_mod_cast hu2
  have hm : (b.1 : ℝ) ≤ f (n + 1) * M ∧ f (n + 1) * M ≤ (b.2 : ℝ) := by
    rw [hf, mul_right_comm, ← mul_div_assoc]
    constructor
    · apply (le_div_iff₀ hd').2
      by_cases hn : (0 : ℝ) ≤ numerator p q r n
      · exact hl1'.trans (mul_le_mul_of_nonneg_right ha.1 hn)
      · exact hl2'.trans (mul_le_mul_of_nonpos_right ha.2.1 (le_of_not_ge hn))
    · apply (div_le_iff₀ hd').2
      by_cases hn : (0 : ℝ) ≤ numerator p q r n
      · exact (mul_le_mul_of_nonneg_right ha.2.1 hn).trans hu2'
      · exact (mul_le_mul_of_nonpos_right ha.1 (le_of_not_ge hn)).trans hu1'
  refine ⟨hm.1, hm.2, ?_, ?_⟩
  · change ((a.sl + b.1 : ℤ) : ℝ) ≤ (∑ k ∈ Finset.range ((n + 1) + 1), f k) * M
    rw [Int.cast_add, Finset.sum_range_succ, add_mul]
    exact add_le_add ha.2.2.1 hm.1
  · change (∑ k ∈ Finset.range ((n + 1) + 1), f k) * M ≤ ((a.su + b.2 : ℤ) : ℝ)
    rw [Int.cast_add, Finset.sum_range_succ, add_mul]
    exact add_le_add ha.2.2.2 hm.2

private lemma verify_sound (p q r s : ℤ) (f : ℕ → ℝ) (M : ℝ)
    (hf : ∀ n, f (n + 1) = f n * ((numerator p q r n : ℝ) / (denominator q s n : ℝ)))
    (bs : List (ℤ × ℤ)) (n : ℕ) (a : Box)
    (ha : Valid f M n a) (h : verify p q r s n a bs = true) :
    Valid f M (n + bs.length) (bs.foldl next a) := by
  induction bs generalizing n a with
  | nil => simpa [List.foldl_nil] using ha
  | cons b bs ih =>
    simp only [verify, Bool.and_eq_true] at h
    have hs := step_sound p q r s f M n a b (hf n) ha h.1
    simpa only [List.foldl_cons, List.length_cons, Nat.add_assoc, Nat.add_comm 1 bs.length] using
      ih (n + 1) (next a b) hs h.2

private lemma verifyBlocks_sound (p q r s : ℤ) (f : ℕ → ℝ) (M : ℝ)
    (hf : ∀ n, f (n + 1) = f n * ((numerator p q r n : ℝ) / (denominator q s n : ℝ)))
    (cs : List Chunk) (n : ℕ) (a : Box)
    (ha : Valid f M n a) (h : verifyBlocks p q r s n a cs = true) :
    Valid f M (n + 250 * cs.length) (cs.foldl (fun _ c => c.stop) a) := by
  induction cs generalizing n a with
  | nil => simpa [List.foldl_nil] using ha
  | cons c cs ih =>
    simp only [verifyBlocks, Bool.and_eq_true, decide_eq_true_eq] at h
    have hv := verify_sound p q r s f M hf c.samples n c.start (by rwa [h.1.1]) h.2.1
    rw [h.1.2.1, h.1.2.2] at hv
    have hout := ih (n + 250) c.stop hv h.2.2
    convert hout using 1 <;> simp only [List.length_cons, Nat.mul_add, Nat.mul_one,
      List.foldl_cons] <;> omega

private lemma term_succ (ν y : ℝ) (n : ℕ) :
    (fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) (n + 1) =
      (fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n * y * (((n : ℝ) - ν) * ((n : ℝ) + ν + 1) / ((n : ℝ) + 1) ^ 2) := by
  have hc := D5.S3.Analytic.GaussZeroBalanced.Series.coefficient_recurrence
    (a := -ν) (b := 1 + ν) (c := 1) zero_lt_one n
  have hn : (n : ℝ) + 1 ≠ 0 := by exact Nat.cast_add_one_ne_zero n
  have he : ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 (n + 1) =
      ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 n *
        (((n : ℝ) - ν) * ((n : ℝ) + ν + 1)) / ((n : ℝ) + 1) ^ 2 := by
    apply (eq_div_iff (pow_ne_zero 2 hn)).2
    convert hc using 1 <;> push_cast <;> ring
  dsimp only
  rw [he, pow_succ]
  ring

private lemma ratio_bounds (ν : ℝ) (hν : 0 ≤ ν) (n : ℕ) (hn : ν ≤ n) :
    0 ≤ (((n : ℝ) - ν) * ((n : ℝ) + ν + 1) / ((n : ℝ) + 1) ^ 2) ∧
    (((n : ℝ) - ν) * ((n : ℝ) + ν + 1) / ((n : ℝ) + 1) ^ 2) ≤ 1 := by
  have hn0 : (0 : ℝ) ≤ n := Nat.cast_nonneg _
  have hd : (0 : ℝ) < ((n : ℝ) + 1) ^ 2 := by positivity
  constructor
  · positivity
  · apply (div_le_one hd).2
    nlinarith [mul_nonneg hν (show 0 ≤ ν + 1 by linarith)]

private lemma term_norm_step (ν y : ℝ) (hν : 0 ≤ ν) (hy : 0 ≤ y)
    (n : ℕ) (hn : ν ≤ n) :
    ‖(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) (n + 1)‖ ≤ y * ‖(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n‖ := by
  rw [term_succ, norm_mul, norm_mul, Real.norm_of_nonneg hy,
    Real.norm_of_nonneg (ratio_bounds ν hν n hn).1]
  nlinarith [norm_nonneg ((fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n), (ratio_bounds ν hν n hn).2,
    mul_nonneg (norm_nonneg ((fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n)) hy]

private lemma term_summable (ν y : ℝ) (hν : 0 ≤ ν) (hy : 0 ≤ y) (hy1 : y < 1)
    (N : ℕ) (hN : ν ≤ N) : Summable ((fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k)) := by
  apply summable_of_ratio_norm_eventually_le hy1
  filter_upwards [eventually_ge_atTop N] with n hn
  exact term_norm_step ν y hν hy n (hN.trans (by exact_mod_cast hn))

private lemma tail_bound (ν y : ℝ) (hν : 0 ≤ ν) (hy : 0 ≤ y) (hy1 : y < 1)
    (N : ℕ) (hN : ν ≤ N) :
    |gauss (-ν) (1 + ν) 1 y - ∑ n ∈ Finset.range N, (fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n| ≤
      |(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) N| / (1 - y) := by
  have hs := term_summable ν y hν hy hy1 N hN
  have hb : ∀ n, ‖(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) (n + N)‖ ≤ y ^ n * ‖(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) N‖ := by
    intro n
    simpa only [zero_add] using le_geom (u := fun k => ‖(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) (k + N)‖) hy n
      (fun k _ => by
        simpa only [Nat.add_assoc, Nat.add_comm 1 N] using
          term_norm_step ν y hν hy (k + N) (hN.trans (by exact_mod_cast Nat.le_add_left N k)))
  have ht := tsum_of_norm_bounded
    ((hasSum_geometric_of_lt_one hy hy1).mul_right ‖(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) N‖) hb
  have he := Summable.sum_add_tsum_nat_add N hs
  have hf : gauss (-ν) (1 + ν) 1 y = ∑' n, (fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n := by
    simp only [gauss, ordinaryHypergeometric_eq_tsum, smul_eq_mul]
  rw [hf, ← he, add_sub_cancel_left]
  simpa only [Real.norm_eq_abs, inv_mul_eq_div] using ht

private lemma recurrence_integer (p q r s : ℤ) (hq : q ≠ 0) (hs : s ≠ 0) (n : ℕ) :
    (fun k : ℕ => ordinaryHypergeometricCoefficient (-((p : ℝ) / q)) (1 + ((p : ℝ) / q)) 1 k * ((r : ℝ) / s) ^ k) (n + 1) =
      (fun k : ℕ => ordinaryHypergeometricCoefficient (-((p : ℝ) / q)) (1 + ((p : ℝ) / q)) 1 k * ((r : ℝ) / s) ^ k) n *
        ((numerator p q r n : ℝ) / (denominator q s n : ℝ)) := by
  rw [term_succ]
  simp only [numerator, denominator, Int.cast_mul, Int.cast_sub, Int.cast_add,
    Int.cast_natCast, Int.cast_one, Int.cast_pow]
  have hq' : (q : ℝ) ≠ 0 := by exact Int.cast_ne_zero.mpr hq
  have hs' : (s : ℝ) ≠ 0 := by exact Int.cast_ne_zero.mpr hs
  field_simp
  <;> ring

private lemma valid_initial (ν y : ℝ) :
    Valid ((fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k)) 1000000000000 0
      ⟨1000000000000, 1000000000000, 1000000000000, 1000000000000⟩ := by
  norm_num [Valid, ordinaryHypergeometricCoefficient]

private lemma tail_bound_after (ν y : ℝ) (hν : 0 ≤ ν) (hy : 0 ≤ y) (hy1 : y < 1)
    (N : ℕ) (hN : ν ≤ N) :
    |gauss (-ν) (1 + ν) 1 y - ∑ n ∈ Finset.range (N + 1), (fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n| ≤
      |(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) N| * y / (1 - y) := by
  have h := tail_bound ν y hν hy hy1 (N + 1) (by push_cast; linarith)
  have ht := term_norm_step ν y hν hy N hN
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at ht
  exact h.trans (div_le_div_of_nonneg_right (by nlinarith) (by linarith))

private lemma enclose_of_valid (ν y : ℝ) (hν : 0 ≤ ν) (hy : 0 ≤ y) (hy1 : y < 1)
    (N : ℕ) (hN : ν ≤ N) (a : Box) (E : ℤ)
    (ha : Valid ((fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k)) 1000000000000 N a)
    (hlo : -E ≤ a.lo) (hhi : a.hi ≤ E) :
    (a.sl : ℝ) / 1000000000000 - (E : ℝ) / 1000000000000 * y / (1 - y) ≤
        gauss (-ν) (1 + ν) 1 y ∧
      gauss (-ν) (1 + ν) 1 y ≤
        (a.su : ℝ) / 1000000000000 + (E : ℝ) / 1000000000000 * y / (1 - y) := by
  have hlo' : -(E : ℝ) ≤ (a.lo : ℝ) := by exact_mod_cast hlo
  have hhi' : (a.hi : ℝ) ≤ (E : ℝ) := by exact Int.cast_le.mpr hhi
  have ht : |(fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) N| ≤ (E : ℝ) / 1000000000000 := by
    rw [abs_le]
    constructor <;> linarith [ha.1, ha.2.1]
  have herr := tail_bound_after ν y hν hy hy1 N hN
  have he : |gauss (-ν) (1 + ν) 1 y - ∑ n ∈ Finset.range (N + 1), (fun k : ℕ => ordinaryHypergeometricCoefficient (-ν) (1 + ν) 1 k * y ^ k) n| ≤
      (E : ℝ) / 1000000000000 * y / (1 - y) :=
    herr.trans (div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_right ht hy) (by linarith))
  rw [abs_le] at he
  constructor <;> linarith [ha.2.2.1, ha.2.2.2]

