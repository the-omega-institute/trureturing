namespace D5.S3.Analytic.GaussZeroBalanced.FractionalLegendreTuran

private structure Box where
  lo : ℤ
  hi : ℤ
  sl : ℤ
  su : ℤ

private instance instDecidableEqBox : DecidableEq Box
  | ⟨al, ah, asl, asu⟩, ⟨bl, bh, bsl, bsu⟩ =>
      if hl : al = bl then
        if hh : ah = bh then
          if hsl : asl = bsl then
            if hsu : asu = bsu then
              isTrue (by cases hl; cases hh; cases hsl; cases hsu; rfl)
            else isFalse (fun h => hsu (congrArg Box.su h))
          else isFalse (fun h => hsl (congrArg Box.sl h))
        else isFalse (fun h => hh (congrArg Box.hi h))
      else isFalse (fun h => hl (congrArg Box.lo h))

private def numerator (p q r : ℤ) (n : ℕ) : ℤ :=
  ((n : ℤ) * q - p) * (((n : ℤ) + 1) * q + p) * r

private def denominator (q s : ℤ) (n : ℕ) : ℤ :=
  q ^ 2 * ((n : ℤ) + 1) ^ 2 * s

private def next (a : Box) (b : ℤ × ℤ) : Box :=
  ⟨b.1, b.2, a.sl + b.1, a.su + b.2⟩

private def link (p q r s : ℤ) (n : ℕ) (a : Box) (b : ℤ × ℤ) : Bool :=
  decide (0 < denominator q s n ∧
    b.1 * denominator q s n ≤ a.lo * numerator p q r n ∧
    b.1 * denominator q s n ≤ a.hi * numerator p q r n ∧
    a.lo * numerator p q r n ≤ b.2 * denominator q s n ∧
    a.hi * numerator p q r n ≤ b.2 * denominator q s n)

private def verify (p q r s : ℤ) : ℕ → Box → List (ℤ × ℤ) → Bool
  | _, _, [] => true
  | n, a, b :: bs => link p q r s n a b && verify p q r s (n + 1) (next a b) bs

private structure Chunk where
  start : Box
  samples : List (ℤ × ℤ)
  stop : Box

private def verifyBlocks (p q r s : ℤ) : ℕ → Box → List Chunk → Bool
  | _, _, [] => true
  | n, a, c :: cs =>
      decide (c.start = a ∧ c.samples.length = 250 ∧ c.samples.foldl next c.start = c.stop) &&
        (verify p q r s n c.start c.samples && verifyBlocks p q r s (n + 250) c.stop cs)

