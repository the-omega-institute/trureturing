/- GID: D5/S3/Analytic/WeightedCapacity/PrimeReciprocalCharacter
   generality: I
   mirror-B: D5/B/S3/Analytic/WeightedCapacity/PrimeReciprocalCharacter
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: The reciprocal prime character separates finite binary states but generates a strictly coarser topology than all rational characters. -/
import D5.S3.Analytic.WeightedCapacity.ProbeTopologySequences
import Mathlib.Data.Nat.GCD.BigOperators
import Mathlib.Data.Nat.Prime.Nth
import Mathlib.Data.Int.GCD
import Mathlib.Analysis.Normed.Group.AddCircle
import Mathlib.Analysis.SpecificLimits.Basic
import Mathlib.Tactic.FieldSimp

set_option autoImplicit false
namespace D5.S3.Analytic.WeightedCapacity.PrimeReciprocalCharacter
open Set Filter
open scoped BigOperators Topology
open D5.S3.Analytic.WeightedCapacity.DyadicTailFilling
open D5.S3.Analytic.WeightedCapacity.ProbeTopologySequences

/-- The binary state with every coordinate equal to zero. -/
noncomputable def binaryZero : B (fun _ => 1) :=
  ⟨fun _ => 0, by simp [Function.support]⟩

/-- The binary state whose only nonzero coordinate is n. -/
noncomputable def unit (n : ℕ) : B (fun _ => 1) := by
  classical
  refine ⟨fun j => if j = n then 1 else 0, ?_⟩
  apply (Set.finite_singleton n).subset
  intro j hj
  by_contra h
  exact hj (by simp [show j ≠ n from h])

/-- The reciprocal of the increasing enumeration of primes, starting with two. -/
noncomputable def primeRow : ℕ → ℚ := fun n => 1 / (Nat.nth Nat.Prime n : ℚ)

/-- The initial topology of the golden coordinate phases and the reciprocal prime character. -/
noncomputable def oneRowTopology : TopologicalSpace (B (fun _ => 1)) :=
  TopologicalSpace.induced psi inferInstance ⊓
    TopologicalSpace.induced (chi primeRow) inferInstance

/-- The reciprocal prime character separates finite binary states and has trivial zero fibre.
The constant half character sends every unit state outside the quarter ball about zero,
while the topology generated by the prime character and golden phases is strictly coarser
than the topology generated by all rational characters and golden phases. -/
theorem result :
  (Function.Injective (@chi (fun _ => 1) primeRow) ∧
    (∀ u : B (fun _ => 1), chi primeRow u = 0 ↔ u = binaryZero) ∧
    (∀ n : ℕ, unit n ≠ binaryZero ∧
      chi (fun _ => (1 / 2 : ℚ)) (unit n) = ((1 / 2 : ℝ) : AddCircle (1 : ℝ)) ∧
      ¬ dist (chi (fun _ => (1 / 2 : ℚ)) (unit n)) 0 < (1 / 4 : ℝ))) ∧
  tauPlus (fun _ => 1) < oneRowTopology := by
  have prime_elimination (s : Finset ℕ) (p : ℕ → ℕ)
      (hp : ∀ i, Nat.Prime (p i)) (hinj : Function.Injective p)
      (c : ℕ → ℤ) (hc : ∀ i ∈ s, |c i| ≤ 1)
      (k : ℤ) (heq : (∑ i ∈ s, (c i : ℚ) / (p i : ℚ)) = k) :
      ∀ i ∈ s, c i = 0 := by
    classical
    let P : ℕ := ∏ i ∈ s, p i
    have hclear : (∑ i ∈ s, c i * ((∏ j ∈ s.erase i, p j : ℕ) : ℤ)) = k * P := by
      have hq := congrArg (fun q : ℚ => q * (P : ℚ)) heq
      rw [Finset.sum_mul] at hq
      have hterm (i : ℕ) (hi : i ∈ s) :
          (c i : ℚ) / (p i : ℚ) * (P : ℚ) =
            (c i : ℚ) * ((∏ j ∈ s.erase i, p j : ℕ) : ℚ) := by
        have hP : P = p i * ∏ j ∈ s.erase i, p j :=
          (Finset.mul_prod_erase s p hi).symm
        rw [hP, Nat.cast_mul]
        have hne : (p i : ℚ) ≠ 0 := by exact_mod_cast (hp i).ne_zero
        field_simp
      simp_rw [Finset.sum_congr rfl hterm] at hq
      exact_mod_cast hq
    intro i hi
    have hdP : (p i : ℤ) ∣ (P : ℤ) := by
      exact_mod_cast (Finset.dvd_prod_of_mem p hi : p i ∣ P)
    have hdother : (p i : ℤ) ∣ ∑ j ∈ s.erase i,
        c j * ((∏ t ∈ s.erase j, p t : ℕ) : ℤ) := by
      apply Finset.dvd_sum
      intro j hj
      have hij : i ≠ j := (Finset.mem_erase.mp hj).1.symm
      have hd : p i ∣ ∏ t ∈ s.erase j, p t :=
        Finset.dvd_prod_of_mem p (Finset.mem_erase.mpr ⟨hij, hi⟩)
      exact dvd_mul_of_dvd_right (by exact_mod_cast hd) _
    have hdi : (p i : ℤ) ∣ c i * ((∏ j ∈ s.erase i, p j : ℕ) : ℤ) := by
      have hall : (p i : ℤ) ∣ ∑ j ∈ s,
          c j * ((∏ t ∈ s.erase j, p t : ℕ) : ℤ) := by
        rw [hclear]
        exact dvd_mul_of_dvd_right hdP _
      rw [← Finset.add_sum_erase _ _ hi] at hall
      exact (dvd_add_left hdother).mp hall
    have hcop : Nat.Coprime (p i) (∏ j ∈ s.erase i, p j) := by
      apply Nat.Coprime.prod_right
      intro j hj
      exact (hp i).coprime_iff_not_dvd.mpr (by
        intro hd
        have he := (Nat.prime_dvd_prime_iff_eq (hp i) (hp j)).mp hd
        exact (Finset.mem_erase.mp hj).1 (hinj he.symm))
    have hdc : (p i : ℤ) ∣ c i := by
      have hcInt : IsCoprime (p i : ℤ) ((∏ j ∈ s.erase i, p j : ℕ) : ℤ) :=
        Int.isCoprime_iff_nat_coprime.mpr (by simpa only [Int.natAbs_natCast] using hcop)
      exact hcInt.dvd_of_dvd_mul_right hdi
    have habs := hc i hi
    have hp2 := (hp i).two_le
    have hp2z : (2 : ℤ) ≤ p i := by exact_mod_cast hp2
    have hlt : |c i| < (p i : ℤ) := by omega
    apply Int.eq_zero_of_dvd_of_natAbs_lt_natAbs hdc
    rw [Int.natAbs_natCast]
    exact_mod_cast (show ((c i).natAbs : ℤ) < (p i : ℤ) by simpa using hlt)

  have prime_character_injective (p : ℕ → ℕ)
      (hp : ∀ i, Nat.Prime (p i)) (hinj : Function.Injective p) :
      Function.Injective (@chi (fun _ => 1) (fun n => 1 / (p n : ℚ))) := by
    classical
    intro u v huv
    let s := u.property.toFinset ∪ v.property.toFinset
    let c : ℕ → ℤ := fun n => (u.val n : ℕ) - (v.val n : ℕ)
    let r : ℕ → ℚ := fun n => 1 / (p n : ℚ)
    have hsum (w : B (fun _ => 1)) (hw : w.property.toFinset ⊆ s) :
        (∑ n ∈ w.property.toFinset, r n * ((w.val n : ℕ) : ℚ)) =
          ∑ n ∈ s, r n * ((w.val n : ℕ) : ℚ) := by
      apply Finset.sum_subset hw
      intro n _ hn
      have hz : (w.val n : ℕ) = 0 := by simpa using hn
      simp [hz]
    have hu : u.property.toFinset ⊆ s := Finset.subset_union_left
    have hv : v.property.toFinset ⊆ s := Finset.subset_union_right
    have hzero := sub_eq_zero.mpr huv
    change (((∑ n ∈ u.property.toFinset, r n * ((u.val n : ℕ) : ℚ) : ℚ) : ℝ) :
      AddCircle (1 : ℝ)) -
      (((∑ n ∈ v.property.toFinset, r n * ((v.val n : ℕ) : ℚ) : ℚ) : ℝ) :
      AddCircle (1 : ℝ)) = 0 at hzero
    rw [← AddCircle.coe_sub, ← Rat.cast_sub, hsum u hu, hsum v hv,
      ← Finset.sum_sub_distrib] at hzero
    have hterms : (∑ n ∈ s, (r n * ((u.val n : ℕ) : ℚ) - r n * ((v.val n : ℕ) : ℚ))) =
        ∑ n ∈ s, (c n : ℚ) / (p n : ℚ) := by
      apply Finset.sum_congr rfl
      intro n _
      dsimp [r, c]
      push_cast
      ring
    rw [hterms] at hzero
    obtain ⟨k, hk⟩ := (AddCircle.coe_eq_zero_iff (p := (1 : ℝ))).mp hzero
    have hkq : (∑ n ∈ s, (c n : ℚ) / (p n : ℚ)) = (k : ℚ) := by
      have hk' : (k : ℝ) = ((∑ n ∈ s, (c n : ℚ) / (p n : ℚ) : ℚ) : ℝ) := by
        simpa using hk
      exact_mod_cast hk'.symm
    have hc (n : ℕ) (_ : n ∈ s) : |c n| ≤ 1 := by
      have hu' := (u.val n).isLt
      have hv' := (v.val n).isLt
      dsimp only at hu' hv'
      dsimp [c]
      rw [abs_le]
      constructor <;> omega
    have hz := prime_elimination s p hp hinj c hc k hkq
    apply Subtype.ext
    funext n
    apply Fin.ext
    by_cases hn : n ∈ s
    · have hh := hz n hn
      dsimp [c] at hh
      omega
    · have hun : n ∉ u.property.toFinset := fun h => hn (hu h)
      have hvn : n ∉ v.property.toFinset := fun h => hn (hv h)
      have huz : (u.val n : ℕ) = 0 := by simpa using hun
      have hvz : (v.val n : ℕ) = 0 := by simpa using hvn
      omega

  have prime_and_half_counterexamples :
      Function.Injective (@chi (fun _ => 1) primeRow) ∧
      (∀ u : B (fun _ => 1), chi primeRow u = 0 ↔ u = binaryZero) ∧
      (∀ n : ℕ, unit n ≠ binaryZero ∧
        chi (fun _ => (1 / 2 : ℚ)) (unit n) = ((1 / 2 : ℝ) : AddCircle (1 : ℝ)) ∧
        ¬ dist (chi (fun _ => (1 / 2 : ℚ)) (unit n)) 0 < (1 / 4 : ℝ)) := by
    classical
    have hinj : Function.Injective (@chi (fun _ => 1) primeRow) :=
      prime_character_injective (Nat.nth Nat.Prime)
        (Nat.nth_mem_of_infinite Nat.infinite_setOf_prime)
        (Nat.nth_strictMono Nat.infinite_setOf_prime).injective
    have hz : chi primeRow binaryZero = 0 := by simp [chi, binaryZero, Function.support]
    refine ⟨hinj, ?_, ?_⟩
    · intro u
      constructor
      · intro h
        exact hinj (h.trans hz.symm)
      · rintro rfl; exact hz
    · intro n
      have hne : unit n ≠ binaryZero := by
        intro h
        have hh := congrArg (fun u : B (fun _ => 1) => (u.val n : ℕ)) h
        simp [unit, binaryZero] at hh
      have hs : (unit n).property.toFinset = {n} := by
        ext j
        simp [unit, Function.support]
      have hh : chi (fun _ => (1 / 2 : ℚ)) (unit n) =
          ((1 / 2 : ℝ) : AddCircle (1 : ℝ)) := by
        simp only [chi, hs, Finset.sum_singleton]
        norm_num [unit]
      refine ⟨hne, hh, ?_⟩
      rw [hh, dist_eq_norm, sub_zero]
      have hnorm : ‖((1 / 2 : ℝ) : AddCircle (1 : ℝ))‖ = |(1 / 2 : ℝ)| :=
        (AddCircle.norm_coe_eq_abs_iff (1 : ℝ) (by norm_num)).mpr (by norm_num)
      rw [hnorm]
      norm_num

  have prime_row_strict_topology : tauPlus (fun _ => 1) < oneRowTopology := by
    classical
    have hle : tauPlus (fun _ => 1) ≤ oneRowTopology :=
      inf_le_inf_left _ (iInf_le _ primeRow)
    apply lt_of_le_of_ne hle
    intro heq
    have hunit (r : ℕ → ℚ) (n : ℕ) :
        chi r (unit n) = (((r n : ℚ) : ℝ) : AddCircle (1 : ℝ)) := by
      have hs : (unit n).property.toFinset = {n} := by
        ext j
        simp [unit, Function.support]
      simp only [chi, hs, Finset.sum_singleton]
      simp [unit]
    have hpsi : Tendsto (fun n => psi (unit n)) atTop (𝓝 (psi binaryZero)) := by
      apply tendsto_pi_nhds.mpr
      intro j
      apply tendsto_nhds_of_eventually_eq
      filter_upwards [eventually_ge_atTop (j + 1)] with n hn
      have hne : j ≠ n := by omega
      simp [psi, unit, binaryZero, hne]
    have hp : Tendsto (fun n => (Nat.nth Nat.Prime n : ℝ)) atTop atTop :=
      tendsto_natCast_atTop_atTop.comp
        (Nat.nth_strictMono Nat.infinite_setOf_prime).tendsto_atTop
    have hrec : Tendsto (fun n => (1 : ℝ) / (Nat.nth Nat.Prime n : ℝ)) atTop (𝓝 0) := by
      simpa only [Function.comp_def, one_div] using tendsto_inv_atTop_zero.comp hp
    have hcircle : Tendsto (fun n => chi primeRow (unit n)) atTop (𝓝 (chi primeRow binaryZero)) := by
      have h := (AddCircle.continuous_mk' (1 : ℝ)).continuousAt.tendsto.comp hrec
      have hz : chi primeRow binaryZero = 0 := by simp [chi, binaryZero, Function.support]
      simpa [Function.comp_def, hunit, primeRow, hz] using h
    have ht : Tendsto unit atTop (@nhds _ oneRowTopology binaryZero) := by
      unfold oneRowTopology
      rw [@nhds_inf (B (fun _ => 1)) (TopologicalSpace.induced psi inferInstance)
        (TopologicalSpace.induced (chi primeRow) inferInstance) binaryZero]
      apply tendsto_inf.mpr
      constructor
      · rw [nhds_induced, tendsto_comap_iff]
        exact hpsi
      · rw [nhds_induced, tendsto_comap_iff]
        exact hcircle
    rw [← heq] at ht
    obtain ⟨K, hK⟩ := (tendsto_tauPlus_iff_eventually_eq (fun _ => 1) binaryZero unit).mp ht
    exact (prime_and_half_counterexamples.2.2 K).1 (hK K (le_refl _))
  exact ⟨prime_and_half_counterexamples, prime_row_strict_topology⟩

end D5.S3.Analytic.WeightedCapacity.PrimeReciprocalCharacter
