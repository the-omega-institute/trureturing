private theorem generated_term_sum_re_bounds :
    (∑ v ∈ Finset.range 61, ((modeBounds v).termReLo : ℝ)) ≤ (∑ v ∈ Finset.range 61, (2 : ℂ) ^ (-c * (o5Beta v : ℂ))).re ∧
