/- GID: D5/S3/Analytic/Entire/ExponentialKernelRank
   generality: G
   mirror-B: D5/B/S3/Analytic/Entire/ExponentialKernelRank
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Cardinal rank addition for the actual section spaces of distinct entire exponential blocks. -/

import D5.S3.Analytic.Entire.ExponentialBlockIndependence
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.LinearAlgebra.Dimension.Constructions

/-! The row space is generated by all actual sections on the whole plane.
Algebraic probes preserve this space for finitely separated kernels. -/

noncomputable section
open scoped BigOperators

namespace D5.S3.Analytic.Entire

def kernelRowSpace (F : ℂ → ℂ → ℂ) : Submodule ℂ (ℂ → ℂ) :=
  Submodule.span ℂ (Set.range (fun w => fun z => F z w))

private theorem probe_mem_kernel_row_space {F : ℂ → ℂ → ℂ}
    (hF : FiniteSeparated F) (q : (ℂ → ℂ) →ₗ[ℂ] ℂ) :
    (fun z => q (F z)) ∈ kernelRowSpace F := by
  classical
  obtain ⟨k, g, h, _, _, hsep⟩ := hF
  have hrow (w : ℂ) : (fun z => F z w) = ∑ i, h i w • g i := by
    funext z
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_comm] using hsep z w
  have hcol (z : ℂ) : F z = ∑ i, g i z • h i := by
    funext w
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hsep z w
  apply (Subspace.forall_mem_dualAnnihilator_apply_eq_zero_iff _ _).mp
  intro φ hφ
  have hzero : (∑ i, φ (g i) • h i : ℂ → ℂ) = 0 := by
    funext w
    have heq := ((kernelRowSpace F).mem_dualAnnihilator φ).mp hφ
      (fun z => F z w) (Submodule.subset_span ⟨w, rfl⟩)
    rw [hrow, map_sum] at heq
    simpa only [Finset.sum_apply, Pi.smul_apply, map_smul, smul_eq_mul,
      mul_comm, Pi.zero_apply] using heq
  have heq : (fun z => q (F z)) = ∑ i, q (h i) • g i := by
    funext z
    simp only [hcol, map_sum, map_smul, smul_eq_mul, Finset.sum_apply, Pi.smul_apply]
    apply Finset.sum_congr rfl
    intro i _
    exact mul_comm _ _
  have hq := congrArg q hzero
  rw [heq, map_sum]
  simpa only [map_sum, map_smul, map_zero, smul_eq_mul, mul_comm] using hq

/-- Cardinal dimension is additive across distinct exponential blocks.
Both row and column projections act on the actual kernel sections, with no
restriction on the entire factors in a candidate separated representation. -/
theorem exponential_kernel_row_rank_additive {ι : Type} [Fintype ι]
    (α : ι → ℂ) (hα : Function.Injective α) (p : ι → Polynomial ℂ) :
    Module.rank ℂ (kernelRowSpace (weightedHankel (blockEvaluation α p))) =
      Cardinal.sum (fun i => Module.rank ℂ (kernelRowSpace
        (weightedHankel (fun z => Complex.exp (α i*z)*(p i).eval z)))) := by
  classical
  let K : ι → ℂ → ℂ → ℂ :=
    fun i => weightedHankel (fun z => Complex.exp (α i*z)*(p i).eval z)
  let F := weightedHankel (blockEvaluation α p)
  let W : ι → Submodule ℂ (ℂ → ℂ) := fun i => kernelRowSpace (K i)
  have hfinite : FiniteSeparated F := by
    apply ExponentialPolynomial.weighted_separation
    refine ⟨Fintype.card ι, fun j => α ((Fintype.equivFin ι).symm j),
      fun j => p ((Fintype.equivFin ι).symm j), ?_⟩
    intro z
    exact (Equiv.sum_comp (Fintype.equivFin ι).symm
      (fun i => Complex.exp (α i*z)*(p i).eval z)).symm
  have hsum (z w : ℂ) : F z w = ∑ i, K i z w := by
    simp only [F, K, weightedHankel, blockEvaluation, LinearMap.coe_mk,
      AddHom.coe_mk, Finset.mul_sum]
  have hright (i : ι) (z w : ℂ) :
      blockProjection α i (F z) w = K i z w := by
    have hsym : F z = fun t => F t z := by
      funext t
      simp only [F, weightedHankel, add_comm z t]
      ring
    rw [hsym, block_projection_weighted_sum α hα p i z]
    simp only [K, weightedHankel, add_comm z w]
    ring
  have hle (i : ι) : W i ≤ kernelRowSpace F := by
    apply Submodule.span_le.mpr
    rintro _ ⟨w, rfl⟩
    have h := probe_mem_kernel_row_space hfinite
      ((LinearMap.proj w).comp (blockProjection α i))
    change (fun z => K i z w) ∈ kernelRowSpace F
    have heq : (fun z => ((LinearMap.proj w).comp (blockProjection α i)) (F z)) =
        fun z => K i z w := by
      funext z
      exact hright i z w
    rw [← heq]
    exact h
  have hproj (i j : ι) (v : W j) :
      blockProjection α i (v : ℂ → ℂ) = if i = j then (v : ℂ → ℂ) else 0 := by
    suffices ∀ x : ℂ → ℂ, x ∈ kernelRowSpace (K j) →
        blockProjection α i x = if i = j then x else 0 from this v v.property
    intro x hx
    induction hx using Submodule.span_induction with
    | mem v hv =>
        obtain ⟨w, rfl⟩ := hv
        exact block_projection_weighted_single α hα i j (p j) w
    | zero => simp
    | add x y _ _ hx hy =>
        rw [map_add, hx, hy]
        by_cases hij : i = j <;> simp only [hij, if_true, if_false, add_zero]
    | smul c x _ hx =>
        rw [map_smul, hx]
        by_cases hij : i = j <;> simp only [hij, if_true, if_false, smul_zero]
  let S : (∀ i, W i) →ₗ[ℂ] (ℂ → ℂ) :=
    { toFun := fun v => ∑ i, (v i : ℂ → ℂ)
      map_add' := by intros; simp only [Pi.add_apply, Submodule.coe_add, Finset.sum_add_distrib]
      map_smul' := by intros; simp only [Pi.smul_apply, Submodule.coe_smul,
        Finset.smul_sum, RingHom.id_apply] }
  have hinj : Function.Injective S := by
    intro v u h
    funext i
    apply Subtype.ext
    have hi := congrArg (blockProjection α i) h
    change blockProjection α i (∑ j, (v j : ℂ → ℂ)) =
      blockProjection α i (∑ j, (u j : ℂ → ℂ)) at hi
    simpa only [map_sum, hproj, Finset.sum_ite_eq, Finset.mem_univ, if_true] using hi
  have hrange : LinearMap.range S = kernelRowSpace F := by
    apply le_antisymm
    · rintro _ ⟨v, rfl⟩
      exact (kernelRowSpace F).sum_mem (fun i _ => hle i (v i).property)
    · apply Submodule.span_le.mpr
      rintro _ ⟨w, rfl⟩
      refine ⟨fun i => ⟨fun z => K i z w, Submodule.subset_span ⟨w, rfl⟩⟩, ?_⟩
      funext z
      change (∑ i, (fun z => K i z w)) z = F z w
      simpa only [Finset.sum_apply] using (hsum z w).symm
  let e : (∀ i, W i) ≃ₗ[ℂ] kernelRowSpace F :=
    (LinearEquiv.ofInjective S hinj).trans (LinearEquiv.ofEq _ _ hrange)
  calc
    Module.rank ℂ (kernelRowSpace F) = Module.rank ℂ (∀ i, W i) := e.rank_eq.symm
    _ = Cardinal.sum (fun i => Module.rank ℂ (W i)) := rank_pi

#print axioms exponential_kernel_row_rank_additive

end D5.S3.Analytic.Entire
