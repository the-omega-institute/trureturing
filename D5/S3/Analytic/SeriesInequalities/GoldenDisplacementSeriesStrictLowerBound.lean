import D5.S1.Deficit.Displacement.GoldenDisplacementEulerProduct

open GoldenDesubstitutionLength
open GoldenDisplacementEulerProduct

namespace D5.S3.Analytic.SeriesInequalities.GoldenDisplacementSeriesStrictLowerBound

/-- Wherever the golden displacement series is summable, its value is strictly greater than one. -/
theorem one_lt_golden_displacement_series {s w : ℝ} (hsum : Summable (dTerm s w)) :
    1 < ∑' n : ℕ, dTerm s w n := by
  have hnS2Nat : 0 < nS 2 :=
    lt_of_lt_of_le (by norm_num) (le_nS (by norm_num))
  have htwo : 0 < dTerm s w 2 := by
    simp only [dTerm, if_neg (by norm_num : (2 : ℕ) ≠ 0), Nat.cast_ofNat]
    exact mul_pos
      (Real.rpow_pos_of_pos (by exact_mod_cast hnS2Nat) _)
      (Real.rpow_pos_of_pos (by norm_num) _)
  have hstrict : dTerm s w 1 < ∑' n : ℕ, dTerm s w n :=
    lt_hasSum hsum.hasSum 1 (fun n _ => dTerm_nonneg s w n) 2 (by norm_num) htwo
  simpa only [dTerm_one] using hstrict

end D5.S3.Analytic.SeriesInequalities.GoldenDisplacementSeriesStrictLowerBound
