theorem coefficient_next (A B : ℝ) (n : ℕ) :
    coefficient A B (n+2) =
      (A * coefficient A B n + B * coefficient A B (n-1)) /
        ((n+1 : ℝ) * (n+2 : ℝ)) := by
  first | exact? |
    (cases n with
     | zero => norm_num [coefficient]
     | succ n =>
       simp only [Nat.succ_eq_add_one, Nat.add_sub_cancel, Nat.add_assoc]
       rw [coefficient]
       push_cast
       congr 2 <;> ring)
theorem state_total (A B : ℝ) (n : ℕ) :
    (state A B n).total = ∑ k ∈ Finset.range (n+2), coefficient A B k := by
  first | exact? |
    (have hall (m : ℕ) :
         (state A B m).prev = coefficient A B (m-1) ∧
         (state A B m).cur = coefficient A B m ∧
         (state A B m).next = coefficient A B (m+1) ∧
         (state A B m).total = ∑ k ∈ Finset.range (m+2), coefficient A B k := by
       induction m with
       | zero => norm_num [state, coefficient, Finset.sum_range_succ]
       | succ m ih =>
         obtain ⟨hp, hc, hn, ht⟩ := ih
         refine ⟨?_, ?_, ?_, ?_⟩
         · simpa [state] using hc
         · simpa [state] using hn
         · simpa only [state, hp, hc, Nat.succ_eq_add_one, Nat.add_assoc] using
             (coefficient_next A B m).symm
         · simpa only [state, hp, hc, ht, Nat.succ_eq_add_one, Nat.add_assoc,
             Finset.sum_range_succ, coefficient_next]
     exact (hall n).2.2.2)
