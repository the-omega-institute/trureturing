import D5.S0.Certificates.BoxCover.RationalIntervalExpression
import Mathlib.MeasureTheory.Integral.IntervalIntegral.Basic
import Mathlib.Analysis.Real.Pi.Bounds
open Set MeasureTheory
open D5.S0.Certificates.BoxCover.RationalIntervalExpression
open scoped BigOperators
set_option maxHeartbeats 0
set_option maxRecDepth 10000
noncomputable section
namespace D5.S3.Analytic.SpectralGap.WeightedGapPolynomialCertificate
def interval : Set ℝ := Icc 0 Real.pi
def boundedMeasurable (f : ℝ → ℝ) : Prop :=
  Measurable (fun x : interval => f x) ∧
    ∃ B : ℝ, ∀ x : ℝ, x ∈ interval → |f x| ≤ B
def potentialClass (M : WithTop ℝ) (V : ℝ → ℝ) : Prop :=
  boundedMeasurable V ∧ ConvexOn ℝ interval V ∧
    ∀ x : ℝ, x ∈ interval → 0 ≤ V x ∧ (V x : WithTop ℝ) ≤ M
def weightClass (Nlo Nhi : ℝ) (w : ℝ → ℝ) : Prop :=
  boundedMeasurable w ∧ ConcaveOn ℝ interval w ∧
    ∀ x : ℝ, x ∈ interval → Nlo ≤ w x ∧ w x ≤ Nhi
def dirichletTrial (u : ℝ → ℝ) : Prop :=
  ContDiffOn ℝ 1 u interval ∧
    ∀ x : ℝ, x ∉ Ioo 0 Real.pi → u x = 0
def energy (V u : ℝ → ℝ) : ℝ :=
  ∫ x in (0 : ℝ)..Real.pi,
    (derivWithin u interval x) ^ 2 + V x * (u x) ^ 2
def weightedMass (w u : ℝ → ℝ) : ℝ :=
  ∫ x in (0 : ℝ)..Real.pi, w x * (u x) ^ 2
def minmaxUpperBounds (V w : ℝ → ℝ) (n : ℕ) : Set ℝ :=
  {r | ∃ L : Submodule ℝ (ℝ → ℝ),
    FiniteDimensional ℝ L ∧ Module.finrank ℝ L = n ∧
    (∀ u : ℝ → ℝ, u ∈ L → dirichletTrial u) ∧
    (∀ u : ℝ → ℝ, u ∈ L → energy V u ≤ r * weightedMass w u)}
def isSpectrum (V w : ℝ → ℝ) (e : ℕ → ℝ) : Prop :=
  (∀ n : ℕ, 0 < e n) ∧ StrictMono e ∧
    (∀ R : ℝ, ∃ N : ℕ, ∀ n : ℕ, N ≤ n → R < e n) ∧
    ∀ n : ℕ,
      (minmaxUpperBounds V w (n + 1)).Nonempty ∧
      BddBelow (minmaxUpperBounds V w (n + 1)) ∧
      IsGLB (minmaxUpperBounds V w (n + 1)) (e n)
def isShootingEigenvalue (V w : ℝ → ℝ) (z : ℝ) : Prop :=
  ∃ u : ℝ → ℝ,
    ContinuousOn u interval ∧
    IntervalIntegrable (fun t => (V t - z * w t) * u t) volume 0 Real.pi ∧
    u 0 = 0 ∧ u Real.pi = 0 ∧
    ∀ x : ℝ, x ∈ interval →
      u x = x + ∫ t in (0 : ℝ)..x, (x - t) * (V t - z * w t) * u t
def gap (e : ℕ → ℝ) : ℝ := e 1 - e 0
def claim : Prop :=
  ∀ (M : WithTop ℝ) (Nlo Nhi : ℝ) (V w : ℝ → ℝ),
    (1 : WithTop ℝ) < M → 0 < Nlo → 0 < Nhi →
    potentialClass M V → weightClass Nlo Nhi w →
    ((∃ e : ℕ → ℝ, isSpectrum V w e) ∧
      (∃ e0 : ℕ → ℝ, isSpectrum (fun _ => 0) w e0)) ∧
    ∀ (e e0 : ℕ → ℝ),
      isSpectrum V w e → isSpectrum (fun _ => 0) w e0 → gap e0 ≤ gap e
structure State where
  prev : ℝ
  cur : ℝ
  next : ℝ
  total : ℝ
noncomputable def state (A B : ℝ) : ℕ → State
  | 0 => ⟨0, 0, 1, 1⟩
  | n + 1 =>
    let s := state A B n
    let c := (A * s.cur + B * s.prev) / ((n + 1 : ℝ) * (n + 2 : ℝ))
    ⟨s.cur, s.next, c, s.total + c⟩
structure Certificate where
  a : (ℚ × ℚ)
  b : (ℚ × ℚ)
  coeff : ℕ → (ℚ × ℚ)
  total : ℕ → (ℚ × ℚ)
  ac : ℕ → (ℚ × ℚ)
  bp : ℕ → (ℚ × ℚ)
  add : ℕ → (ℚ × ℚ)
def inputBox (d : Certificate) (n : ℕ) : Fin 5 → (ℚ × ℚ) :=
  ![d.a, d.b, d.coeff (n - 1), d.coeff n, d.total n]
def coeffExpr (d : Certificate) (n : ℕ) : Expr 5 :=
  .mul (d.coeff (n+2)).1 (d.coeff (n+2)).2
    (.add (d.add n).1 (d.add n).2
      (.mul (d.ac n).1 (d.ac n).2
        (.input 0 d.a.1 d.a.2) (.input 3 (d.coeff n).1 (d.coeff n).2))
      (.mul (d.bp n).1 (d.bp n).2
        (.input 1 d.b.1 d.b.2) (.input 2 (d.coeff (n-1)).1 (d.coeff (n-1)).2)))
    (.const (1 / ((n+1 : ℚ) * (n+2 : ℚ)))
      (1 / ((n+1 : ℚ) * (n+2 : ℚ))) (1 / ((n+1 : ℚ) * (n+2 : ℚ))))
def totalExpr (d : Certificate) (n : ℕ) : Expr 5 :=
  .add (d.total (n+1)).1 (d.total (n+1)).2
    (.input 4 (d.total n).1 (d.total n).2) (coeffExpr d n)
def stepCheck (d : Certificate) (n : ℕ) : Bool :=
  check (inputBox d n) (coeffExpr d n) && check (inputBox d n) (totalExpr d n)
def StateEnclosed (d : Certificate) (n : ℕ) (s : State) : Prop :=
  (s.prev ∈ Set.Icc (((d.coeff (n-1))).1 : ℝ) (((d.coeff (n-1))).2 : ℝ)) ∧ (s.cur ∈ Set.Icc (((d.coeff n)).1 : ℝ) (((d.coeff n)).2 : ℝ)) ∧
    (s.next ∈ Set.Icc (((d.coeff (n+1))).1 : ℝ) (((d.coeff (n+1))).2 : ℝ)) ∧ (s.total ∈ Set.Icc (((d.total n)).1 : ℝ) (((d.total n)).2 : ℝ))
private theorem coeff_value (d : Certificate) (n : ℕ) (A B : ℝ) (s : State) :
    value ![A, B, s.prev, s.cur, s.total] (coeffExpr d n) =
      (A * s.cur + B * s.prev) / ((n+1 : ℝ) * (n+2 : ℝ)) := by
  first | exact? |
    (simp [coeffExpr, value, Rat.cast_div, Rat.cast_mul, Rat.cast_add,
       Rat.cast_natCast, div_eq_mul_inv])
private theorem total_value (d : Certificate) (n : ℕ) (A B : ℝ) (s : State) :
    value ![A, B, s.prev, s.cur, s.total] (totalExpr d n) =
      s.total + (A * s.cur + B * s.prev) / ((n+1 : ℝ) * (n+2 : ℝ)) := by
  first | exact? | (simp [totalExpr, value, coeff_value])
theorem checked_state (d : Certificate) (A B : ℝ)
    (hA : (A ∈ Set.Icc ((d.a).1 : ℝ) ((d.a).2 : ℝ))) (hB : (B ∈ Set.Icc ((d.b).1 : ℝ) ((d.b).2 : ℝ)))
    (hinit : StateEnclosed d 0 (state A B 0))
    (N : ℕ) (hc : ∀ n, n < N → stepCheck d n = true) :
    StateEnclosed d N (state A B N) := by
  first | exact? |
    (induction N with
     | zero => exact hinit
     | succ N ih =>
       have hs := ih (fun n hn => hc n (Nat.lt_succ_of_lt hn))
       obtain ⟨hp, hcur, hnext, htotal⟩ := hs
       have hx : ∀ i : Fin 5,
           (((inputBox d N i).1 : ℚ) : ℝ) ≤
             ![A, B, (state A B N).prev, (state A B N).cur, (state A B N).total] i ∧
           ![A, B, (state A B N).prev, (state A B N).cur, (state A B N).total] i ≤
             (((inputBox d N i).2 : ℚ) : ℝ) := by
         intro i
