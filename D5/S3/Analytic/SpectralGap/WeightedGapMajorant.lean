namespace D5.S3.Analytic.SpectralGap.WeightedGapMajorant
noncomputable def coefficient (A B : ℝ) : ℕ → ℝ
  | 0 => 0
  | 1 => 1
  | 2 => 0
  | n + 3 => (A * coefficient A B (n+1) + B * coefficient A B n) /
      ((n+2 : ℝ) * (n+3 : ℝ))
private def major : ℕ → ℚ
  | 0 => 0
  | 1 => 2
  | 2 => 0
  | n + 3 => (256 * major (n+1) + 256 * major n) / ((n+2 : ℚ) * (n+3 : ℚ))
private theorem finite_major_bound : ∀ n : Fin 24, major n ≤ 3^16 := by
  first | exact? | decide +kernel
private theorem major_bound (n : ℕ) : major n ≤ 3^16 := by
  first | exact? |
    (induction n using Nat.strong_induction_on with
     | h n ih =>
       by_cases hn : n < 24
       · exact finite_major_bound ⟨n, hn⟩
       obtain ⟨k, rfl⟩ : ∃ k, n = k+3 := ⟨n-3, by omega⟩
       have h1 := ih (k+1) (by omega)
       have h0 := ih k (by omega)
       have hk : 21 ≤ k := by omega
       have hkq : (21 : ℚ) ≤ k := by exact_mod_cast hk
       have hden : (512 : ℚ) ≤ (k+2 : ℚ) * (k+3 : ℚ) := by
         nlinarith [mul_nonneg (sub_nonneg.mpr hkq)
           (show 0 ≤ (k : ℚ) + 21 by positivity)]
       rw [major]
       apply (div_le_iff₀ (by positivity : 0 < (k+2 : ℚ)*(k+3 : ℚ))).2
       nlinarith)
private theorem coefficient_le_major (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32)
    (n : ℕ) : |coefficient A B n| * 2^n ≤ (major n : ℝ) := by
  first | exact? |
    (induction n using Nat.strong_induction_on with
     | h n ih =>
       cases n with
       | zero => norm_num [coefficient, major]
       | succ n =>
         cases n with
         | zero => norm_num [coefficient, major]
         | succ n =>
           cases n with
           | zero => norm_num [coefficient, major]
           | succ k =>
             have h1 := ih (k+1) (by omega)
             have h0 := ih k (by omega)
             have hw1 : 0 ≤ |coefficient A B (k+1)| * (2:ℝ)^(k+1) := by positivity
             have hw0 : 0 ≤ |coefficient A B k| * (2:ℝ)^k := by positivity
             have ha4 : (4:ℝ) * |A| ≤ 256 := by linarith
             have hb8 : (8:ℝ) * |B| ≤ 256 := by linarith
             have hterm1 : 4 * |A| * (|coefficient A B (k+1)| * 2^(k+1)) ≤
                 256*(major (k+1) : ℝ) :=
               (mul_le_mul_of_nonneg_right
                 ha4 hw1).trans
                 (mul_le_mul_of_nonneg_left h1 (by norm_num))
             have hterm0 : 8 * |B| * (|coefficient A B k| * 2^k) ≤
                 256*(major k : ℝ) :=
               (mul_le_mul_of_nonneg_right
                 hb8 hw0).trans
                 (mul_le_mul_of_nonneg_left h0 (by norm_num))
             have hnum : |A * coefficient A B (k+1) + B * coefficient A B k| *
                 2^(k+3) ≤ 256*(major (k+1) : ℝ) + 256*(major k : ℝ) := by
               calc
                 _ ≤ (|A| * |coefficient A B (k+1)| + |B| * |coefficient A B k|)*2^(k+3) :=
                   mul_le_mul_of_nonneg_right (by
                     simpa only [abs_mul] using
                       (abs_add_le (A * coefficient A B (k+1)) (B * coefficient A B k)))
                     (by positivity)
                 _ = 4 * |A| * (|coefficient A B (k+1)| * 2^(k+1)) +
                     8 * |B| * (|coefficient A B k| * 2^k) := by
                       simp only [pow_succ]
                       ring
                 _ ≤ _ := add_le_add hterm1 hterm0
             have hden : 0 < (k+2 : ℝ)*(k+3 : ℝ) := by positivity
             change |(A * coefficient A B (k+1) + B * coefficient A B k) /
               ((k+2 : ℝ)*(k+3 : ℝ))| * 2^(k+3) ≤ (major (k+3) : ℝ)
             rw [major]
             push_cast
             rw [abs_div, abs_of_pos hden, div_mul_eq_mul_div]
             exact (div_le_div_iff_of_pos_right hden).mpr hnum)
theorem coefficient_weighted_bound (A B : ℝ)
    (hA : |A| ≤ 64) (hB : |B| ≤ 32) (n : ℕ) :
    |coefficient A B n| * 2^n ≤ (3:ℝ)^16 := by
  first | exact? |
    (exact (coefficient_le_major A B hA hB n).trans (by exact_mod_cast major_bound n))
theorem geometric_coefficient_tail (c : ℕ → ℝ) (M : ℝ)
    (h : ∀ n, |c n| * 2^n ≤ M) (N : ℕ) :
    |(∑' n, c n) - ∑ n ∈ Finset.range N, c n| ≤ 2*M / 2^N := by
  first | exact? |
    (have hb (n : ℕ) : ‖c n‖ ≤ M * (1/2:ℝ)^n := by
       have hn : 0 < (2:ℝ)^n := by positivity
       have hh := (le_div_iff₀ hn).mpr (h n)
       simpa [Real.norm_eq_abs, div_eq_mul_inv, inv_pow] using hh
     have hg0 : HasSum (fun n : ℕ => (1/2:ℝ)^n) 2 := by
       convert hasSum_geometric_of_abs_lt_one (r := (1/2:ℝ)) (by norm_num) using 1 <;>
         norm_num
     have hsc : Summable c := (hg0.mul_left M).summable.of_norm_bounded hb
     have hgtail : HasSum (fun n : ℕ => M * (1/2:ℝ)^(n+N)) (2*M / 2^N) := by
       convert hg0.mul_left (M*(1/2:ℝ)^N) using 1
       · funext n
         rw [pow_add]
         ring
       · simp only [div_eq_mul_inv, one_mul, inv_pow]
         ring
     have htail := tsum_of_norm_bounded hgtail (fun n => hb (n+N))
     have hsplit : (∑' n, c n) - ∑ n ∈ Finset.range N, c n = ∑' n, c (n+N) := by
       linarith [hsc.sum_add_tsum_nat_add N]
     rw [hsplit]
     simpa only [Real.norm_eq_abs] using htail)
