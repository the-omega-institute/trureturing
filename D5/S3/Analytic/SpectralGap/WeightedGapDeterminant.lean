def solution (A B t : ℝ) : ℝ := ∑' n, coefficient A B n * t^n
private theorem coefficient_geometric_bound (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32)
    (n : ℕ) : |coefficient A B n| ≤ (3:ℝ)^16 * (1/2:ℝ)^n := by
  first |
    (have h := (le_div_iff₀ (by positivity : 0 < (2:ℝ)^n)).mpr
        (coefficient_weighted_bound A B hA hB n)
     simpa [div_eq_mul_inv, inv_pow] using h)
theorem series_summable (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32)
    {t : ℝ} (ht : t ∈ Icc (0:ℝ) 1) :
    Summable (fun n => coefficient A B n * t^n) := by
  first |
    (have hg : Summable (fun n : ℕ => (3:ℝ)^16 * (1/2:ℝ)^n) :=
       (summable_geometric_of_norm_lt_one (x := (1/2:ℝ)) (by norm_num)).mul_left _
     apply hg.of_norm_bounded
     intro n
     rw [Real.norm_eq_abs, abs_mul, abs_pow, abs_of_nonneg ht.1]
     calc
       |coefficient A B n| * t^n ≤ |coefficient A B n| * 1 :=
         mul_le_mul_of_nonneg_left (pow_le_one₀ ht.1 ht.2) (abs_nonneg _)
       _ ≤ _ := by simpa using coefficient_geometric_bound A B hA hB n)
theorem solution_continuous (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32) :
    ContinuousOn (solution A B) (Icc 0 1) := by
  first |
    (apply continuousOn_tsum (u := fun n : ℕ => (3:ℝ)^16 * (1/2:ℝ)^n)
     · intro n
       exact (continuous_const.mul (continuous_id.pow n)).continuousOn
     · exact (summable_geometric_of_norm_lt_one (x := (1/2:ℝ)) (by norm_num)).mul_left _
     · intro n t ht
       rw [Real.norm_eq_abs, abs_mul, abs_pow, abs_of_nonneg ht.1]
       calc
         |coefficient A B n| * t^n ≤ |coefficient A B n| * 1 :=
           mul_le_mul_of_nonneg_left (pow_le_one₀ ht.1 ht.2) (abs_nonneg _)
         _ ≤ _ := by simpa using coefficient_geometric_bound A B hA hB n)
theorem forcing_hasSum (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32)
    {t : ℝ} (ht : t ∈ Icc (0:ℝ) 1) :
    HasSum (fun n => (A * coefficient A B n + B * coefficient A B (n-1)) * t^n)
      ((A+B*t) * solution A B t) := by
  first |
    (have hs := (series_summable A B hA hB ht).hasSum
     have hshift : HasSum (fun n => coefficient A B (n-1) * t^n)
         (t * solution A B t) := by
       rw [← hasSum_nat_add_iff' 1]
       simpa [solution, coefficient, Finset.sum_range_one, pow_succ, mul_assoc,
         mul_left_comm, mul_comm] using hs.mul_left t
     convert (hs.mul_left A).add (hshift.mul_left B) using 1
     · funext n
       ring
     · simp only [solution]
       ring)
theorem volterra_monomial (x : ℝ) (n : ℕ) :
    (∫ t in (0:ℝ)..x, (x-t) * t^n) = x^(n+2) / ((n+1:ℝ)*(n+2:ℝ)) := by
  first |
    (have hi (k : ℕ) : IntervalIntegrable (fun t : ℝ => t^k) volume 0 x :=
       (continuous_id.pow k).intervalIntegrable _ _
     calc
       (∫ t in (0:ℝ)..x, (x-t) * t^n) =
           ∫ t in (0:ℝ)..x, x * t^n - t^(n+1) := by
         congr 1
         funext t
         rw [pow_succ]
         ring
       _ = x * (x^(n+1) / (n+1)) - x^(n+2) / (n+2) := by
         rw [intervalIntegral.integral_sub ((hi n).const_mul x) (hi (n+1)),
           intervalIntegral.integral_const_mul, integral_pow,
           integral_pow]
         norm_num [Nat.add_assoc, add_assoc]
       _ = _ := by
         have hn1 : (n+1:ℝ) ≠ 0 := by positivity
         have hn2 : (n+2:ℝ) ≠ 0 := by positivity
         field_simp
         simp only [pow_succ]
         ring)
theorem forcing_coefficient_bound (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32)
    (n : ℕ) : |A * coefficient A B n + B * coefficient A B (n-1)| ≤
      128 * (3:ℝ)^16 * (1/2:ℝ)^n := by
  first |
    (have hp : |coefficient A B (n-1)| ≤ 2 * (3:ℝ)^16 * (1/2:ℝ)^n := by
       cases n with
       | zero => norm_num [coefficient]
       | succ n =>
         have hh := coefficient_geometric_bound A B hA hB n
         simpa [pow_succ, Nat.succ_eq_add_one, mul_assoc, mul_comm, mul_left_comm] using hh
     have hc := coefficient_geometric_bound A B hA hB n
     calc
       _ ≤ |A| * |coefficient A B n| + |B| * |coefficient A B (n-1)| := by
         simpa only [abs_mul] using
           (abs_add_le (A * coefficient A B n) (B * coefficient A B (n-1)))
       _ ≤ 64 * ((3:ℝ)^16 * (1/2:ℝ)^n) +
           32 * (2 * (3:ℝ)^16 * (1/2:ℝ)^n) :=
         add_le_add (mul_le_mul hA hc (abs_nonneg _) (by norm_num))
           (mul_le_mul hB hp (abs_nonneg _) (by norm_num))
       _ = _ := by ring)
theorem coefficient_continuous (A B : ℝ → ℝ) (hA : Continuous A)
    (hB : Continuous B) (n : ℕ) : Continuous (fun z => coefficient (A z) (B z) n) := by
  first |
    (induction n using Nat.strong_induction_on with
     | h n ih =>
       cases n with
       | zero => simpa only [coefficient] using (continuous_const : Continuous (fun _ : ℝ => (0:ℝ)))
       | succ n =>
         cases n with
         | zero => simpa only [coefficient] using (continuous_const : Continuous (fun _ : ℝ => (1:ℝ)))
         | succ n =>
           cases n with
           | zero => simpa only [coefficient] using (continuous_const : Continuous (fun _ : ℝ => (0:ℝ)))
           | succ k =>
             have hc1 := ih (k+1) (by omega)
             have hc0 := ih k (by omega)
             simpa only [coefficient, Pi.mul_apply, Pi.add_apply] using ((hA.mul hc1).add (hB.mul hc0)).div_const
               ((k+2:ℝ)*(k+3:ℝ)))
