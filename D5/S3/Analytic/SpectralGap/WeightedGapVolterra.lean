theorem solution_volterra (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32)
    {x : ℝ} (hx : x ∈ Icc (0:ℝ) 1) :
    solution A B x = x + ∫ t in (0:ℝ)..x, (x-t) * (A+B*t) * solution A B t := by
  first |
    (let q := fun n => A * coefficient A B n + B * coefficient A B (n-1)
     have hb (n : ℕ) : |q n| ≤ 128 * (3:ℝ)^16 * (1/2:ℝ)^n :=
       forcing_coefficient_bound A B hA hB n
     have hg : Summable (fun n : ℕ => 128 * (3:ℝ)^16 * (1/2:ℝ)^n) :=
       (summable_geometric_of_norm_lt_one (x := (1/2:ℝ)) (by norm_num)).mul_left _
     have hi := intervalIntegral.hasSum_integral_of_dominated_convergence
       (μ := volume) (a := 0) (b := x)
       (F := fun n t => (x-t) * (q n * t^n))
       (f := fun t => (x-t) * (A+B*t) * solution A B t)
       (fun n _ => 128 * (3:ℝ)^16 * (1/2:ℝ)^n)
       (fun n => ((continuous_const.sub continuous_id).mul
         (continuous_const.mul (continuous_id.pow n))).aestronglyMeasurable)
       (fun n => ae_of_all _ (fun t ht => by
         rw [uIoc_of_le hx.1] at ht
         have ht0 : 0 ≤ t := ht.1.le
         have ht1 : t ≤ 1 := ht.2.trans hx.2
         rw [Real.norm_eq_abs, abs_mul, abs_mul, abs_pow, abs_of_nonneg ht0,
           abs_of_nonneg (sub_nonneg.mpr ht.2)]
         have hxt : x-t ≤ 1 := by linarith [hx.2]
         calc
           (x-t) * (|q n| * t^n) ≤ 1 * (|q n| * 1) :=
             mul_le_mul hxt (mul_le_mul_of_nonneg_left (pow_le_one₀ ht0 ht1)
               (abs_nonneg _)) (by positivity) (by norm_num)
           _ ≤ _ := by simpa using hb n))
       (ae_of_all _ (fun _ _ => hg)) intervalIntegrable_const
       (ae_of_all _ (fun t ht => by
         rw [uIoc_of_le hx.1] at ht
         have hs := (forcing_hasSum A B hA hB ⟨ht.1.le, ht.2.trans hx.2⟩).mul_left (x-t)
         simpa only [mul_assoc] using hs))
     have heq (n : ℕ) : (∫ t in (0:ℝ)..x, (x-t) * (q n * t^n)) =
         coefficient A B (n+2) * x^(n+2) := by
       calc
         _ = q n * ∫ t in (0:ℝ)..x, (x-t) * t^n := by
           rw [← intervalIntegral.integral_const_mul]
           congr 1
           funext t
           ring
         _ = q n * (x^(n+2) / ((n+1:ℝ)*(n+2:ℝ))) := by rw [volterra_monomial]
         _ = _ := by rw [coefficient_next]; dsimp [q]; ring
     have ht : HasSum (fun n => coefficient A B (n+2) * x^(n+2)) (solution A B x - x) := by
       have hh := (hasSum_nat_add_iff' 2).2 (series_summable A B hA hB hx).hasSum
       simpa [solution, Finset.sum_range_succ, coefficient] using hh
     have hh : HasSum (fun n => coefficient A B (n+2) * x^(n+2))
         (∫ t in (0:ℝ)..x, (x-t) * (A+B*t) * solution A B t) := by
       simpa only [heq] using hi
     linarith [ht.unique hh])
def aParameter (z : ℝ) : ℝ := -(Real.pi^2)*z*(1-Real.pi/200)
def bParameter (δ z : ℝ) : ℝ := Real.pi^3*(δ-z)/100
theorem parameter_bounds {δ z : ℝ} (hδ : δ ∈ Icc (0:ℝ) 1) (hz : z ∈ Icc (0:ℝ) 5) :
    |aParameter z| ≤ 64 ∧ |bParameter δ z| ≤ 32 := by
  first |
    (have hp : 0 < Real.pi := Real.pi_pos
     have hp3 : Real.pi^3 ≤ 64 := by
       have h := pow_le_pow_left₀ hp.le Real.pi_lt_four.le 3
       norm_num at h
       exact h
     have hc : 0 ≤ 1-Real.pi/200 ∧ 1-Real.pi/200 ≤ 1 := by
       constructor <;> linarith [Real.pi_lt_four]
     constructor
     · have heq : |aParameter z| = Real.pi^2*z*(1-Real.pi/200) := by
         simp [aParameter, abs_mul, abs_of_nonneg (sq_nonneg Real.pi),
           abs_of_nonneg hz.1, abs_of_nonneg hc.1]
       rw [heq]
       calc
         _ ≤ (315/100:ℝ)^2*5*1 := mul_le_mul
           (mul_le_mul (by convert (pow_le_pow_left₀ hp.le Real.pi_lt_d2.le 2) using 1 <;> norm_num) hz.2 hz.1
             (by norm_num)) hc.2 hc.1 (by norm_num)
         _ ≤ 64 := by norm_num
     · have hd : |δ-z| ≤ 5 := by rw [abs_le]; constructor <;> linarith [hδ.1,hδ.2,hz.1,hz.2]
       rw [bParameter, abs_div, abs_mul, abs_of_nonneg (pow_nonneg hp.le 3)]
       norm_num only [abs_of_pos (by norm_num : (0:ℝ)<100)]
       apply (div_le_iff₀ (by norm_num : (0:ℝ)<100)).2
       have hh := mul_le_mul hp3 hd (abs_nonneg (δ-z)) (by norm_num : (0:ℝ)≤64)
       norm_num at hh ⊢
       linarith)
theorem determinant_continuous {δ : ℝ} (hδ : δ ∈ Icc (0:ℝ) 1) :
    ContinuousOn (fun z => solution (aParameter z) (bParameter δ z) 1) (Icc 0 5) := by
  simp only [solution, one_pow, mul_one]
  first |
    (apply continuousOn_tsum (u := fun n : ℕ => (3:ℝ)^16*(1/2:ℝ)^n)
     · intro n
       apply (coefficient_continuous aParameter (bParameter δ) ?_ ?_ n).continuousOn
       · unfold aParameter
         fun_prop
       · unfold bParameter
         fun_prop
     · exact (summable_geometric_of_norm_lt_one (x := (1/2:ℝ)) (by norm_num)).mul_left _
     · intro n z hz
       rw [Real.norm_eq_abs]
       have h := coefficient_weighted_bound (aParameter z) (bParameter δ z)
         (parameter_bounds hδ hz).1 (parameter_bounds hδ hz).2 n
       have hh := (le_div_iff₀ (by positivity : 0 < (2:ℝ)^n)).mpr h
       simpa [div_eq_mul_inv, inv_pow] using hh)
theorem short_full_series_tail (A B : ℝ) (hA : |A| ≤ 64) (hB : |B| ≤ 32) :
    |(∑' n, coefficient A B n) - ∑ n ∈ Finset.range 81, coefficient A B n| ≤
      2*(3:ℝ)^16 / 2^81 := by
  first |
    (exact geometric_coefficient_tail (coefficient A B) ((3:ℝ)^16)
      (coefficient_weighted_bound A B hA hB) 81)
theorem short_remainder_lt : 2*(3:ℝ)^16 / 2^81 < 1 / 10^16 := by
  first | norm_num
