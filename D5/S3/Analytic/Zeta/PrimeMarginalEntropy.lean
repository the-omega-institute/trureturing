open D5.S3.Analytic.ZetaGibbs
open D5.S3.Analytic.Zeta.PrimeExponentLaw
open D5.S3.Analytic.Zeta.ZetaEntropy

noncomputable section

/-- The geometric law of the exponent of `p` under the zeta distribution. -/
def primeExponentPMF (s : ℝ) (hs : 1 < s) (p : Nat.Primes) : PMF ℕ :=
  ⟨fun k ↦ ENNReal.ofReal
      ((1 - (p.1 : ℝ) ^ (-s)) * (p.1 : ℝ) ^ (-(k : ℝ) * s)), by
    rw [← tsum_prime_exponent_masses s hs p.1 p.2]
    exact ENNReal.summable.hasSum⟩

lemma primeExponentPMF_apply (s : ℝ) (hs : 1 < s) (p : Nat.Primes) (k : ℕ) :
    pmfReal (primeExponentPMF s hs p) k =
      (1 - (p.1 : ℝ) ^ (-s)) * (p.1 : ℝ) ^ (-(k : ℝ) * s) := by
  rw [pmfReal, primeExponentPMF]
  apply ENNReal.toReal_ofReal
  exact mul_nonneg (sub_nonneg.mpr (Real.rpow_le_one_of_one_le_of_nonpos
    (by exact_mod_cast p.2.one_lt.le) (by linarith))) (Real.rpow_nonneg (by positivity) _)

/-- This geometric PMF is exactly the `p`-adic exponent marginal of `zetaDist`. -/
theorem primeExponentPMF_eq_map (s : ℝ) (hs : 1 < s) (p : Nat.Primes) :
    primeExponentPMF s hs p =
      (zetaDist s hs).map (fun n : ℕ ↦ n.factorization p.1) := by
  ext k
  change ENNReal.ofReal
    ((1 - (p.1 : ℝ) ^ (-s)) * (p.1 : ℝ) ^ (-(k : ℝ) * s)) = _
  rw [← PMF.toMeasure_apply_singleton _ _ MeasurableSet.of_discrete]
  rw [PMF.toMeasure_map_apply _ _ _ (measurable_of_countable _) MeasurableSet.of_discrete]
  exact (measure_factorization_eq s hs p.1 k p.2).symm

/-- The Shannon atoms of any geometric law with ratio `q ∈ (0, 1)` are summable. -/
theorem geometric_entropy_summable (P : PMF ℕ) (q : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
    (hP : ∀ k, pmfReal P k = (1 - q) * q ^ k) :
    Summable (fun k ↦ Real.negMulLog (pmfReal P k)) := by
  have hgeom : Summable (fun k : ℕ ↦ q ^ k) := summable_geometric_of_norm_lt_one (by
    rw [Real.norm_eq_abs, abs_of_pos hq0]
    exact hq1)
  have hweighted : Summable (fun k : ℕ ↦ (k : ℝ) * q ^ k) :=
    (hasSum_coe_mul_geometric_of_norm_lt_one (by
      rw [Real.norm_eq_abs, abs_of_pos hq0]
      exact hq1)).summable
  apply ((hgeom.mul_left (-(1 - q) * Real.log (1 - q))).add
    (hweighted.mul_left ((1 - q) * (-Real.log q)))).congr
  intro k
  rw [hP]
  have ha : 0 < 1 - q := sub_pos.mpr hq1
  have hqk : 0 < q ^ k := pow_pos hq0 _
  rw [Real.negMulLog, Real.log_mul ha.ne' hqk.ne', Real.log_pow]
  ring

/-- Closed Gibbs formula for any geometric law with ratio `q ∈ (0, 1)`. -/
theorem geometric_entropy_eq (P : PMF ℕ) (q a : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
    (hlog : Real.log q = -a) (hP : ∀ k, pmfReal P k = (1 - q) * q ^ k) :
    countableEntropy P = -Real.log (1 - q) + a * (q / (1 - q)) := by
  have habs : |q| < 1 := by rw [abs_of_pos hq0]; exact hq1
  have hgeom : Summable (fun k : ℕ ↦ q ^ k) := summable_geometric_of_norm_lt_one (by
    simpa [Real.norm_eq_abs] using habs)
  have hweighted : Summable (fun k : ℕ ↦ (k : ℝ) * q ^ k) :=
    (hasSum_coe_mul_geometric_of_norm_lt_one (by
      simpa [Real.norm_eq_abs] using habs)).summable
  have hatom (k : ℕ) :
      Real.negMulLog (pmfReal P k) =
        (-(1 - q) * Real.log (1 - q)) * q ^ k +
          ((1 - q) * a) * ((k : ℝ) * q ^ k) := by
    rw [hP]
    have ha : 0 < 1 - q := sub_pos.mpr hq1
    have hqk : 0 < q ^ k := pow_pos hq0 _
    rw [Real.negMulLog, Real.log_mul ha.ne' hqk.ne', Real.log_pow]
    rw [hlog]
    ring
  rw [countableEntropy]
  simp_rw [hatom]
  rw [(hgeom.mul_left _).tsum_add (hweighted.mul_left _)]
  rw [hgeom.tsum_mul_left, hweighted.tsum_mul_left,
    tsum_geometric_of_norm_lt_one (by simpa [Real.norm_eq_abs] using habs),
    tsum_coe_mul_geometric_of_norm_lt_one (by simpa [Real.norm_eq_abs] using habs)]
  change (-(1 - q) * Real.log (1 - q)) * (1 - q)⁻¹ +
      ((1 - q) * a) * (q / (1 - q) ^ 2) =
    -Real.log (1 - q) + a * (q / (1 - q))
  have hne : 1 - q ≠ 0 := (sub_pos.mpr hq1).ne'
  field_simp [hne]

private lemma primeExponentPMF_apply_geometric (s : ℝ) (hs : 1 < s) (p : Nat.Primes)
    (k : ℕ) : pmfReal (primeExponentPMF s hs p) k =
      (1 - (p.1 : ℝ) ^ (-s)) * ((p.1 : ℝ) ^ (-s)) ^ k := by
  rw [primeExponentPMF_apply]
  congr 1
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
  congr 1
  ring

/-- The Shannon atoms of a prime-exponent marginal form a summable family. -/
theorem primeExponent_entropy_summable (s : ℝ) (hs : 1 < s) (p : Nat.Primes) :
    Summable (fun k ↦ Real.negMulLog (pmfReal (primeExponentPMF s hs p) k)) := by
  exact geometric_entropy_summable _ _
    (Real.rpow_pos_of_pos (by exact_mod_cast p.2.pos) _)
    (Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast p.2.one_lt) (by linarith))
    (primeExponentPMF_apply_geometric s hs p)

/-- Closed Gibbs formula for one prime coordinate. -/
theorem primeExponent_entropy_eq (s : ℝ) (hs : 1 < s) (p : Nat.Primes) :
    countableEntropy (primeExponentPMF s hs p) =
      -Real.log (1 - (p.1 : ℝ) ^ (-s)) +
        s * Real.log p.1 * ((p.1 : ℝ) ^ (-s) / (1 - (p.1 : ℝ) ^ (-s))) := by
  exact geometric_entropy_eq _ _ _
    (Real.rpow_pos_of_pos (by exact_mod_cast p.2.pos) _)
    (Real.rpow_lt_one_of_one_lt_of_neg (by exact_mod_cast p.2.one_lt) (by linarith))
    (by rw [Real.log_rpow (by exact_mod_cast p.2.pos)]; ring)
    (primeExponentPMF_apply_geometric s hs p)

/-- The family of local prime-coordinate entropies is summable. -/
theorem summable_primeExponent_entropy (s : ℝ) (hs : 1 < s) :
    Summable (fun p : Nat.Primes ↦ countableEntropy (primeExponentPMF s hs p)) := by
  have hq : Summable (fun p : Nat.Primes ↦ (p.1 : ℝ) ^ (-s)) :=
    (summable_real_weight s hs).comp_injective Subtype.coe_injective
  have hlogq : Summable (fun p : Nat.Primes ↦
      Real.log p.1 * (p.1 : ℝ) ^ (-s)) :=
    (summable_log_weight s hs).comp_injective Subtype.coe_injective
  have hmajor : Summable (fun p : Nat.Primes ↦
      2 * (p.1 : ℝ) ^ (-s) +
        (2 * s) * (Real.log p.1 * (p.1 : ℝ) ^ (-s))) :=
    (hq.mul_left 2).add (hlogq.mul_left (2 * s))
  apply Summable.of_nonneg_of_le (fun p ↦ ?_) (fun p ↦ ?_) hmajor
  · rw [primeExponent_entropy_eq]
    have hpR : 1 < (p.1 : ℝ) := by exact_mod_cast p.2.one_lt
    have hq0 : 0 < (p.1 : ℝ) ^ (-s) := Real.rpow_pos_of_pos (by positivity) _
    have hq1 : (p.1 : ℝ) ^ (-s) < 1 :=
      Real.rpow_lt_one_of_one_lt_of_neg hpR (by linarith)
    exact add_nonneg (neg_nonneg.mpr (Real.log_nonpos (sub_pos.mpr hq1).le (by linarith)))
      (mul_nonneg (mul_nonneg (by linarith) (Real.log_pos hpR).le)
        (div_nonneg hq0.le (sub_pos.mpr hq1).le))
  · rw [primeExponent_entropy_eq]
    let q : ℝ := (p.1 : ℝ) ^ (-s)
    have hpR : 1 < (p.1 : ℝ) := by exact_mod_cast p.2.one_lt
    have hq0 : 0 < q := Real.rpow_pos_of_pos (by positivity) _
    have hq1 : q < 1 := Real.rpow_lt_one_of_one_lt_of_neg hpR (by linarith)
    have hqhalf : q ≤ (2 : ℝ)⁻¹ := by
      calc
        q ≤ (p.1 : ℝ) ^ (-1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le hpR.le (by linarith)
        _ = (p.1 : ℝ)⁻¹ := Real.rpow_neg_one _
        _ ≤ (2 : ℝ)⁻¹ := inv_anti₀ (by norm_num) (by exact_mod_cast p.2.two_le)
    have ha : 0 < 1 - q := sub_pos.mpr hq1
    have hneglog : -Real.log (1 - q) ≤ 2 * q := by
      have h := Real.log_le_sub_one_of_pos (inv_pos.mpr ha)
      rw [Real.log_inv] at h
      calc
        -Real.log (1 - q) ≤ (1 - q)⁻¹ - 1 := h
        _ = q / (1 - q) := by field_simp [ha.ne']; ring
        _ ≤ 2 * q := by
          rw [div_le_iff₀ ha]
          nlinarith
    have hfrac : q / (1 - q) ≤ 2 * q := by
      rw [div_le_iff₀ ha]
      nlinarith
    dsimp [q] at hneglog hfrac ⊢
    have hslog : 0 ≤ s * Real.log p.1 :=
      mul_nonneg (by linarith) (Real.log_pos hpR).le
    calc
      -Real.log (1 - (p.1 : ℝ) ^ (-s)) +
          s * Real.log p.1 * ((p.1 : ℝ) ^ (-s) / (1 - (p.1 : ℝ) ^ (-s))) ≤
          2 * (p.1 : ℝ) ^ (-s) + s * Real.log p.1 * (2 * (p.1 : ℝ) ^ (-s)) :=
        add_le_add hneglog (mul_le_mul_of_nonneg_left hfrac hslog)
      _ = 2 * (p.1 : ℝ) ^ (-s) +
          (2 * s) * (Real.log p.1 * (p.1 : ℝ) ^ (-s)) := by ring

end

end D5.S3.Analytic.Zeta.PrimeMarginalEntropy
