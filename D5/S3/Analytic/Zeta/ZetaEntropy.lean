namespace D5.S3.Analytic.Zeta.ZetaEntropy

open scoped ENNReal BigOperators
open D5.S3.Analytic.ZetaGibbs

noncomputable section

/-- The real mass function underlying a PMF on the natural numbers. -/
def pmfReal (p : PMF ℕ) (n : ℕ) : ℝ := (p n).toReal

/-- Countable Shannon entropy in nats. Finiteness is the separate `Summable` proposition. -/
def countableEntropy (p : PMF ℕ) : ℝ :=
  ∑' n, Real.negMulLog (pmfReal p n)

lemma pmfReal_summable (p : PMF ℕ) : Summable (pmfReal p) := by
  apply ENNReal.summable_toReal
  rw [p.tsum_coe]
  exact ENNReal.one_ne_top

lemma tsum_pmfReal (p : PMF ℕ) : ∑' n, pmfReal p n = 1 := by
  change (∑' n, (p n).toReal) = 1
  rw [← ENNReal.tsum_toReal_eq (p.apply_ne_top), p.tsum_coe]
  rfl

/-- The logarithmically weighted p-series is summable above exponent one. -/
lemma summable_log_weight (s : ℝ) (hs : 1 < s) :
    Summable (fun n : ℕ ↦ Real.log n * (n : ℝ) ^ (-s)) := by
  let ε := (s - 1) / 2
  have hε : 0 < ε := by dsimp [ε]; linarith
  have hexp : ε - s < -1 := by dsimp [ε]; linarith
  have hmajor : Summable (fun n : ℕ ↦ ε⁻¹ * (n : ℝ) ^ (ε - s)) :=
    ((Real.summable_nat_rpow.mpr hexp).mul_left ε⁻¹)
  apply Summable.of_nonneg_of_le
    (fun n ↦ mul_nonneg (Real.log_natCast_nonneg n) (Real.rpow_nonneg n.cast_nonneg _))
    (fun n ↦ ?_) hmajor
  rcases n.eq_zero_or_pos with rfl | hn
  · simp [Real.zero_rpow (by linarith : -s ≠ 0),
      Real.zero_rpow (by linarith : ε - s ≠ 0)]
  · have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
    calc
      Real.log n * (n : ℝ) ^ (-s) ≤ ((n : ℝ) ^ ε / ε) * (n : ℝ) ^ (-s) :=
        mul_le_mul_of_nonneg_right (Real.log_natCast_le_rpow_div n hε)
          (Real.rpow_nonneg n.cast_nonneg _)
      _ = ε⁻¹ * (n : ℝ) ^ (ε - s) := by
        rw [div_eq_inv_mul, mul_assoc, ← Real.rpow_add hnR]
        ring_nf

lemma zeta_real_apply (s : ℝ) (hs : 1 < s) (n : ℕ) :
    pmfReal (zetaDist s hs) n =
      (n : ℝ) ^ (-s) * (partitionFunction s).toReal⁻¹ := by
  rw [pmfReal, zeta_dist_apply, ENNReal.toReal_mul, ENNReal.toReal_inv]
  rw [weight, ENNReal.toReal_ofReal (Real.rpow_nonneg n.cast_nonneg _)]
  rfl

lemma negMulLog_weight (s : ℝ) (hs : 1 < s) (n : ℕ) :
    Real.negMulLog ((n : ℝ) ^ (-s)) =
      s * (Real.log n * (n : ℝ) ^ (-s)) := by
  rcases n.eq_zero_or_pos with rfl | hn
  · simp [Real.zero_rpow (by linarith : -s ≠ 0)]
  · have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
    rw [Real.negMulLog, Real.log_rpow hnR]
    ring

/-- The countable Shannon terms of the zeta distribution are summable. -/
theorem zeta_entropy_summable (s : ℝ) (hs : 1 < s) :
    Summable (fun n ↦ Real.negMulLog (pmfReal (zetaDist s hs) n)) := by
  have hw := summable_real_weight s hs
  have hl := summable_log_weight s hs
  have h1 : Summable (fun n : ℕ ↦ (partitionFunction s).toReal⁻¹ *
      Real.negMulLog ((n : ℝ) ^ (-s))) := by
    apply Summable.mul_left
    simpa only [negMulLog_weight s hs] using hl.mul_left s
  have h2 : Summable (fun n : ℕ ↦ (n : ℝ) ^ (-s) *
      Real.negMulLog (partitionFunction s).toReal⁻¹) := hw.mul_right _
  apply (h1.add h2).congr
  intro n
  rw [zeta_real_apply, Real.negMulLog_mul]

/-- Expected logarithmic energy, provided its defining series is summable. -/
def expectedLog (p : PMF ℕ) : ℝ := ∑' n, pmfReal p n * Real.log n

lemma partition_toReal_pos (s : ℝ) (hs : 1 < s) : 0 < (partitionFunction s).toReal := by
  exact ENNReal.toReal_pos (partition_function_ne_zero s) (partition_function_ne_top s hs)

lemma zeta_real_pos (s : ℝ) (hs : 1 < s) {n : ℕ} (hn : 0 < n) :
    0 < pmfReal (zetaDist s hs) n := by
  rw [zeta_real_apply]
  exact mul_pos (Real.rpow_pos_of_pos (by exact_mod_cast hn) _)
    (inv_pos.mpr (partition_toReal_pos s hs))

lemma log_zeta_real (s : ℝ) (hs : 1 < s) {n : ℕ} (hn : 0 < n) :
    Real.log (pmfReal (zetaDist s hs) n) =
      -s * Real.log n - Real.log (partitionFunction s).toReal := by
  have hnR : 0 < (n : ℝ) := by exact_mod_cast hn
  rw [zeta_real_apply, Real.log_mul (Real.rpow_pos_of_pos hnR _).ne'
    (inv_ne_zero (partition_toReal_pos s hs).ne'), Real.log_rpow hnR, Real.log_inv]
  ring

lemma negMulLog_le_cross {p q : ℝ} (hp : 0 ≤ p) (hq : 0 < q) :
    Real.negMulLog p ≤ -p * Real.log q + q - p := by
  rcases hp.eq_or_lt with rfl | hp'
  · simp [hq.le]
  · have h := mul_le_mul_of_nonneg_left
      (Real.log_le_sub_one_of_pos (div_pos hq hp')) hp
    rw [Real.log_div hq.ne' hp'.ne'] at h
    have hpq : p * (q / p) = q := by field_simp
    have h' : p * Real.log q - p * Real.log p ≤ q - p := by
      calc
        p * Real.log q - p * Real.log p = p * (Real.log q - Real.log p) := by ring
        _ ≤ p * (q / p - 1) := h
        _ = q - p := by rw [mul_sub, hpq, mul_one]
    rw [Real.negMulLog]
    linarith

/-- Entropy equals inverse temperature times logarithmic energy plus log-partition. -/
theorem zeta_entropy_eq (s : ℝ) (hs : 1 < s) :
    countableEntropy (zetaDist s hs) =
      s * expectedLog (zetaDist s hs) + Real.log (partitionFunction s).toReal := by
  let q := zetaDist s hs
  let Z := (partitionFunction s).toReal
  have hqsum := pmfReal_summable q
  have hqlog : Summable (fun n ↦ pmfReal q n * Real.log n) := by
    have := summable_log_weight s hs
    rw [show (fun n : ℕ ↦ pmfReal q n * Real.log n) =
        fun n : ℕ ↦ Z⁻¹ * (Real.log n * (n : ℝ) ^ (-s)) by
      funext n
      rw [show pmfReal q n = (n : ℝ) ^ (-s) * Z⁻¹ by
        exact zeta_real_apply s hs n]
      ring]
    exact this.mul_left Z⁻¹
  have hterm (n : ℕ) : Real.negMulLog (pmfReal q n) =
      s * (pmfReal q n * Real.log n) + Real.log Z * pmfReal q n := by
    rcases n.eq_zero_or_pos with rfl | hn
    · simp [q, pmfReal, zeta_dist_apply, weight_zero s (by linarith)]
    · rw [Real.negMulLog, log_zeta_real s hs hn]
      ring
  change (∑' n, Real.negMulLog (pmfReal q n)) =
    s * (∑' n, pmfReal q n * Real.log n) + Real.log Z
  simp_rw [hterm]
  rw [(hqlog.mul_left s).tsum_add (hqsum.mul_left (Real.log Z))]
  rw [hqlog.tsum_mul_left s, hqsum.tsum_mul_left (Real.log Z), tsum_pmfReal]
  ring

/-- At fixed expected `log n`, the zeta law maximizes countable Shannon entropy. -/
theorem zeta_max_entropy (s : ℝ) (hs : 1 < s) (p : PMF ℕ)
    (hp0 : pmfReal p 0 = 0)
    (hpEntropy : Summable (fun n ↦ Real.negMulLog (pmfReal p n)))
    (hpLog : Summable (fun n ↦ pmfReal p n * Real.log n))
    (hmoment : expectedLog p = expectedLog (zetaDist s hs)) :
    countableEntropy p ≤ countableEntropy (zetaDist s hs) := by
  let q := zetaDist s hs
  let Z := (partitionFunction s).toReal
  have hpsum := pmfReal_summable p
  have hqsum := pmfReal_summable q
  have hcross : Summable (fun n ↦
      s * (pmfReal p n * Real.log n) + Real.log Z * pmfReal p n +
        (pmfReal q n - pmfReal p n)) :=
    ((hpLog.mul_left s).add (hpsum.mul_left (Real.log Z))).add (hqsum.sub hpsum)
  have hpoint (n : ℕ) : Real.negMulLog (pmfReal p n) ≤
      s * (pmfReal p n * Real.log n) + Real.log Z * pmfReal p n +
        (pmfReal q n - pmfReal p n) := by
    rcases n.eq_zero_or_pos with rfl | hn
    · rw [hp0]
      simp [q, zeta_real_apply, Real.zero_rpow (by linarith : -s ≠ 0)]
    · have h := negMulLog_le_cross (p := pmfReal p n) (q := pmfReal q n)
        ENNReal.toReal_nonneg (zeta_real_pos s hs hn)
      rw [log_zeta_real s hs hn] at h
      dsimp [q, Z] at h ⊢
      linarith
  calc
    countableEntropy p ≤ ∑' n, (s * (pmfReal p n * Real.log n) +
        Real.log Z * pmfReal p n + (pmfReal q n - pmfReal p n)) := by
      rw [countableEntropy]
      exact hpEntropy.tsum_le_tsum hpoint hcross
    _ = s * expectedLog p + Real.log Z := by
      rw [((hpLog.mul_left s).add (hpsum.mul_left (Real.log Z))).tsum_add
        (hqsum.sub hpsum)]
      rw [(hpLog.mul_left s).tsum_add (hpsum.mul_left (Real.log Z)),
        hqsum.tsum_sub hpsum]
      rw [hpLog.tsum_mul_left s, hpsum.tsum_mul_left (Real.log Z),
        tsum_pmfReal, tsum_pmfReal]
      simp [expectedLog]
    _ = s * expectedLog q + Real.log Z := by rw [hmoment]
    _ = countableEntropy q := (zeta_entropy_eq s hs).symm

end

end D5.S3.Analytic.Zeta.ZetaEntropy
