import D5.S3.Analytic.SeriesInequalities.GoldenDisplacementSeriesStrictLowerBound
import D5.S3.Analytic.Asymptotics.GoldenDisplacementSeriesTendstoOne

open Filter
open GoldenDisplacementEulerProduct
open D5.S3.Analytic.SeriesInequalities.GoldenDisplacementSeriesStrictLowerBound
open D5.S3.Analytic.Asymptotics.GoldenDisplacementSeriesTendstoOne

namespace D5.S3.Analytic.Extrema.GoldenDisplacementSeriesInfimum

/-- For every fixed second parameter, one is the greatest lower bound of the attained values. -/
theorem golden_displacement_series_slice_isGLB (w : ℝ) :
    IsGLB
      {x : ℝ | ∃ s : ℝ, Summable (dTerm s w) ∧ ∑' n : ℕ, dTerm s w n = x}
      1 := by
  constructor
  · rintro x ⟨s, hsum, rfl⟩
    exact (one_lt_golden_displacement_series hsum).le
  · intro b hb
    apply ge_of_tendsto (golden_displacement_series_tendsto_one w)
    filter_upwards [eventually_ge_atTop (max 0 (2 - w))] with s hs
    apply hb
    refine ⟨s, ?_, rfl⟩
    have hs0 : 0 ≤ s := le_trans (le_max_left 0 (2 - w)) hs
    have hsw : 1 < s + w := by
      linarith [le_trans (le_max_right 0 (2 - w)) hs]
    exact (dTerm_summable hs0 hsw).of_norm

/-- No fixed-parameter slice attains its greatest lower bound. -/
theorem one_not_mem_golden_displacement_series_slice (w : ℝ) :
    1 ∉ {x : ℝ | ∃ s : ℝ, Summable (dTerm s w) ∧ ∑' n : ℕ, dTerm s w n = x} := by
  rintro ⟨s, hsum, hvalue⟩
  have hstrict := one_lt_golden_displacement_series hsum
  rw [hvalue] at hstrict
  exact lt_irrefl 1 hstrict

/-- One is the greatest lower bound when both real parameters are allowed to vary. -/
theorem golden_displacement_series_isGLB :
    IsGLB
      {x : ℝ | ∃ s w : ℝ, Summable (dTerm s w) ∧ ∑' n : ℕ, dTerm s w n = x}
      1 := by
  constructor
  · rintro x ⟨s, w, hsum, rfl⟩
    exact (one_lt_golden_displacement_series hsum).le
  · intro b hb
    apply (golden_displacement_series_slice_isGLB 0).2
    rintro x ⟨s, hsum, hvalue⟩
    exact hb ⟨s, 0, hsum, hvalue⟩

/-- The full two-parameter value set does not attain its greatest lower bound. -/
theorem one_not_mem_golden_displacement_series_values :
    1 ∉ {x : ℝ | ∃ s w : ℝ, Summable (dTerm s w) ∧ ∑' n : ℕ, dTerm s w n = x} := by
  rintro ⟨s, w, hsum, hvalue⟩
  exact one_not_mem_golden_displacement_series_slice w ⟨s, hsum, hvalue⟩

end D5.S3.Analytic.Extrema.GoldenDisplacementSeriesInfimum
