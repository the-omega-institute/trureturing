import D5.S3.VertexAlgebra.TwistedGround.BarnesWall.OddGaussSum
import D5.S3.VertexAlgebra.TwistedGround.BarnesWall.WeylIntertwinerTraceProduct
import Batteries.Tactic.OpenPrivate

/-! Weyl traces of the two literal quaternion Pauli words in odd slot count. -/

open scoped BigOperators Matrix
set_option autoImplicit false

namespace D5.S3.VertexAlgebra.TwistedGround.BarnesWall.OddWeylTrace

open LatticeTwistedGroundRealization.SignQuotient (F₂ complexSign)
open TailPauliPairing (Word parity parity_flip complement pairing)
open OddGaussSum (Half traceExponent tensor_trace_gauss_sum)
open private EvenIndex evenLabel displacementMap actionI actionJ actual_preimageI actual_preimageJ
  actionI_eq actionJ_eq pauliMap pauliMap_even parity_complement_add block_single wordI wordJ
  preimageIMap preimageJMap evenLabel_parity actionI_odd actionJ_odd
  lift_phase_polar quadratic_eq_of_polar_of_single from D5.S3.VertexAlgebra.TwistedGround.BarnesWall.OddGaussSum

local notation "wordFlip" => TailPauliPairing.flip

noncomputable section

variable {ι : Type} [Fintype ι] [LinearOrder ι]

private theorem binary_zero_or_one (a : F₂) : a = 0 ∨ a = 1 :=
  (show ∀ z : F₂, z = 0 ∨ z = 1 by decide) a

private def evenIndexOf (t : ι) (u : Word ι) (hu : parity u = 0) : EvenIndex t :=
  if h : u t = false then .inl ⟨u, hu, h⟩
  else .inr ⟨u, hu, by cases hbit : u t <;> simp_all⟩

private theorem evenLabel_evenIndexOf (t : ι) (u : Word ι) (hu : parity u = 0) :
    evenLabel t (evenIndexOf t u hu) = u := by
  unfold evenIndexOf
  split <;> rfl

private theorem evenLabel_injective (t : ι) : Function.Injective (evenLabel t) := by
  intro u v h
  cases u with
  | inl u =>
    cases v with
    | inl v => exact congrArg Sum.inl (Subtype.ext h)
    | inr v =>
      change u.val = v.val at h
      have hbit : u.val t = v.val t := congrFun h t
      rw [u.property.2, v.property.2] at hbit
      cases hbit
  | inr u =>
    cases v with
    | inl v =>
      change u.val = v.val at h
      have hbit : u.val t = v.val t := congrFun h t
      rw [u.property.2, v.property.2] at hbit
      cases hbit
    | inr v => exact congrArg Sum.inr (Subtype.ext h)

private theorem displacementMap_single (t : ι) (u : EvenIndex t) :
    displacementMap t (Pi.single u 1) = Pi.single (evenLabel t u) 1 := by
  conv_lhs => rw [← Pi.basisFun_apply, displacementMap, Module.Basis.constr_basis]

private theorem displacementMap_at_label (t : ι) (x : EvenIndex t → F₂) (u : EvenIndex t) :
    displacementMap t x (evenLabel t u) = x u := by
  classical
  have h : (LinearMap.proj (evenLabel t u)).comp (displacementMap t) =
      (LinearMap.proj u : (EvenIndex t → F₂) →ₗ[F₂] F₂) := by
    apply (Pi.basisFun F₂ (EvenIndex t)).ext
    intro v
    simp only [LinearMap.comp_apply, LinearMap.proj_apply, Pi.basisFun_apply,
      displacementMap_single, Pi.single_apply]
    by_cases huv : u = v
    · subst v
      simp
    · have hlabel : evenLabel t u ≠ evenLabel t v :=
        fun he => huv (evenLabel_injective t he)
      simp [huv, Ne.symm huv, hlabel, Ne.symm hlabel]
  exact LinearMap.congr_fun h x

private theorem displacementMap_at_odd (t : ι) (x : EvenIndex t → F₂) (u : Word ι)
    (hu : parity u = 1) : displacementMap t x u = 0 := by
  classical
  have h : (LinearMap.proj u).comp (displacementMap t) = 0 := by
    apply (Pi.basisFun F₂ (EvenIndex t)).ext
    intro v
    have hne : u ≠ evenLabel t v := by
      intro he
      exact one_ne_zero (hu.symm.trans ((congrArg parity he).trans (evenLabel_parity t v)))
    simp [LinearMap.comp_apply, Pi.basisFun_apply, displacementMap_single,
      Pi.single_apply, hne, hne.symm]
  exact LinearMap.congr_fun h x

/-- The submodule generated by the even tensor rows. -/
def evenDisplacement (t : ι) : Submodule F₂ (Word ι → F₂) :=
  LinearMap.range (displacementMap t)

theorem mem_evenDisplacement_iff (t : ι) (w : Word ι → F₂) :
    w ∈ evenDisplacement t ↔ ∀ u : Word ι, parity u = 1 → w u = 0 := by
  constructor
  · rintro ⟨x, rfl⟩ u hu
    exact displacementMap_at_odd t x u hu
  · intro hw
    let x : EvenIndex t → F₂ := fun i => w (evenLabel t i)
    refine ⟨x, ?_⟩
    funext u
    rcases binary_zero_or_one (parity u) with hu | hu
    · let i := evenIndexOf t u hu
      have hi : evenLabel t i = u := evenLabel_evenIndexOf t u hu
      rw [← hi, displacementMap_at_label]
    · rw [displacementMap_at_odd t x u hu, hw u hu]

private theorem even_single_mem_displacement (t : ι) (u : Word ι) (hu : parity u = 0) :
    Pi.single u (1 : F₂) ∈ evenDisplacement t := by
  refine ⟨Pi.single (evenIndexOf t u hu) 1, ?_⟩
  rw [displacementMap_single, evenLabel_evenIndexOf]

private theorem row_add_self (x : Word ι → F₂) : x + x = 0 := by
  funext u
  exact CharTwo.add_self_eq_zero (x u)

private theorem displacement_of_action_eq {g : (Word ι → F₂) →ₗ[F₂] (Word ι → F₂)}
    {x w : Word ι → F₂} (hx : g x = x + w) : (g + LinearMap.id : (Word ι → F₂) →ₗ[F₂] (Word ι → F₂)) x = w := by
  change g x + x = w
  rw [hx, add_right_comm x w x, row_add_self, zero_add]

private theorem range_le_evenDisplacement (t : ι) (g : (Word ι → F₂) →ₗ[F₂] (Word ι → F₂))
    (hg : ∀ u : Word ι, g (Pi.single u 1) ∈ evenDisplacement t) :
    LinearMap.range g ≤ evenDisplacement t := by
  rintro _ ⟨x, rfl⟩
  have hexpand : (∑ u : Word ι, x u • Pi.single u (1 : F₂)) = x := by
    simpa only [Pi.basisFun_apply, Pi.basisFun_repr] using
      (Pi.basisFun F₂ (Word ι)).sum_repr x
  rw [← hexpand, map_sum]
  apply Submodule.sum_mem
  intro u _
  rw [map_smul]
  exact Submodule.smul_mem _ _ (hg u)

private theorem generator_fixes_displacement (r t : ι) (isZ : Bool) (x : EvenIndex t → F₂) :
    pauliMap r isZ (displacementMap t x) = displacementMap t x := by
  have h : (pauliMap r isZ).comp (displacementMap t) = displacementMap t := by
    apply (Pi.basisFun F₂ (EvenIndex t)).ext
    intro u
    simp only [Pi.basisFun_apply, LinearMap.comp_apply, displacementMap_single,
      pauliMap_even r isZ _ (evenLabel_parity t u)]
  exact LinearMap.congr_fun h x

private theorem actions_fix_even_single (r₁ r₂ : ι) (u : Word ι) (hu : parity u = 0) :
    actionI r₁ (Pi.single u 1) = Pi.single u 1 ∧
      actionJ r₁ r₂ (Pi.single u 1) = Pi.single u 1 := by
  simp [actionI, actionJ, pauliMap_even _ _ u hu]

/-- Both Pauli words have the entire even-row submodule as their displacement image. -/
theorem tensor_displacement_ranges (r₁ r₂ t : ι) (h₁₂ : r₁ ≠ r₂) :
    LinearMap.range (actionI r₁ + LinearMap.id) = evenDisplacement t ∧
      LinearMap.range (actionJ r₁ r₂ + LinearMap.id) = evenDisplacement t := by
  have hflip (u : Word ι) (hu : parity u = 1) (r : ι) :
      Pi.single (wordFlip u r) (1 : F₂) ∈ evenDisplacement t := by
    apply even_single_mem_displacement
    rw [parity_flip, hu, CharTwo.add_self_eq_zero]
  constructor
  · apply le_antisymm
    · apply range_le_evenDisplacement
      intro u
      rcases binary_zero_or_one (parity u) with hu | hu
      · change actionI r₁ (Pi.single u 1) + Pi.single u 1 ∈ evenDisplacement t
        rw [(actions_fix_even_single r₁ r₂ u hu).1, row_add_self]
        exact Submodule.zero_mem _
      · rw [displacement_of_action_eq (actionI_odd r₁ u hu)]
        exact hflip u hu r₁
    · rintro _ ⟨x, rfl⟩
      exact ⟨preimageIMap r₁ t x, displacement_of_action_eq (actual_preimageI r₁ t x)⟩
  · apply le_antisymm
    · apply range_le_evenDisplacement
      intro u
      rcases binary_zero_or_one (parity u) with hu | hu
      · change actionJ r₁ r₂ (Pi.single u 1) + Pi.single u 1 ∈ evenDisplacement t
        rw [(actions_fix_even_single r₁ r₂ u hu).2, row_add_self]
        exact Submodule.zero_mem _
      · have hj := actionJ_odd r₁ r₂ u hu
        rw [add_assoc] at hj
        rw [displacement_of_action_eq hj]
        apply Submodule.add_mem _ (hflip u hu r₂)
        cases h : u r₁
        · simpa [h] using hflip u hu r₁
        · simpa [h] using (evenDisplacement t).zero_mem
    · rintro _ ⟨x, rfl⟩
      exact ⟨preimageJMap r₁ r₂ t x, displacement_of_action_eq (actual_preimageJ r₁ r₂ t h₁₂ x)⟩

/-- Splitting the even rows at the spectator bit gives the two coefficient functions. -/
def spectatorDisplacementEquiv (t : ι) :
    ((Half t false → F₂) × (Half t true → F₂)) ≃ₗ[F₂] evenDisplacement t :=
  (LinearEquiv.sumArrowLequivProdArrow (Half t false) (Half t true) F₂ F₂).symm.trans
    (LinearEquiv.ofLeftInverse (f := displacementMap t)
      (g := fun w u => w (evenLabel t u))
      (fun x => funext (displacementMap_at_label t x)))

private theorem spectatorDisplacementEquiv_val (t : ι)
    (p : (Half t false → F₂) × (Half t true → F₂)) :
    (spectatorDisplacementEquiv t p).val = displacementMap t (Sum.elim p.1 p.2) :=
  rfl

private abbrev tensorPairing [LinearOrder (Word ι)] :
    LinearMap.BilinForm F₂ (Word ι → F₂) :=
  TensorGram.halfGram.toBilin' + TensorGram.halfGram.toBilin'.flip

private theorem complement_complement (u : Word ι) : complement (complement u) = u := by
  funext r
  simp [complement]

private theorem pairing_with_even_single [LinearOrder (Word ι)]
    (hodd : (Fintype.card ι : F₂) = 1) (hm : 3 ≤ Fintype.card ι)
    (w : Word ι → F₂) (v : Word ι) (hv : parity v = 0) :
    tensorPairing w (Pi.single v 1) = w (complement v) := by
  classical
  have h : tensorPairing.flip (Pi.single v 1) =
      (LinearMap.proj (complement v) : (Word ι → F₂) →ₗ[F₂] F₂) := by
    apply (Pi.basisFun F₂ (Word ι)).ext
    intro u
    simp only [tensorPairing, LinearMap.BilinForm.flip_apply, LinearMap.BilinForm.add_apply,
      LinearMap.proj_apply, Pi.basisFun_apply, Matrix.toBilin'_single,
      TensorGram.halfGram_symmetrize hodd hm, TensorGram.gram_mod_two_of_even_right hodd u v hv]
    have hc : v = complement u ↔ u = complement v := by
      constructor <;> intro he <;> rw [he, complement_complement]
    by_cases he : u = complement v
    · have hvu := hc.mpr he
      rw [pairing, if_pos hvu]
      subst u
      simp only [Pi.single_eq_same]
    · have hvu := mt hc.mp he
      rw [pairing, if_neg hvu]
      simp only [Pi.single_apply, if_neg he, if_neg (Ne.symm he)]
  exact LinearMap.congr_fun h w

/-- Even-row vectors pair trivially with one another under the symmetrized half Gram. -/
theorem evenDisplacement_self_orthogonal [LinearOrder (Word ι)] (t : ι)
    (hodd : (Fintype.card ι : F₂) = 1) (hm : 3 ≤ Fintype.card ι)
    (w : Word ι → F₂) (hw : w ∈ evenDisplacement t) (z : Word ι → F₂)
    (hz : z ∈ evenDisplacement t) : tensorPairing w z = 0 := by
  rcases hz with ⟨y, rfl⟩
  have h : (tensorPairing w).comp (displacementMap t) = 0 := by
    apply (Pi.basisFun F₂ (EvenIndex t)).ext
    intro v
    simp only [Pi.basisFun_apply, LinearMap.comp_apply, displacementMap_single,
      pairing_with_even_single hodd hm w _ (evenLabel_parity t v), LinearMap.zero_apply]
    apply (mem_evenDisplacement_iff t w).mp hw
    simpa only [evenLabel_parity t v, add_zero] using
      (parity_complement_add (evenLabel t v)).trans hodd
  exact LinearMap.congr_fun h y

/-- A nonzero odd coefficient is detected by its even complementary basis row. -/
theorem separates_outside_evenDisplacement [LinearOrder (Word ι)] (t : ι)
    (hodd : (Fintype.card ι : F₂) = 1) (hm : 3 ≤ Fintype.card ι)
    (w : Word ι → F₂) (hw : w ∉ evenDisplacement t) :
    ∃ z ∈ evenDisplacement t, tensorPairing w z = 1 := by
  have hex : ∃ u : Word ι, parity u = 1 ∧ w u ≠ 0 := by
    by_contra hn
    apply hw
    apply (mem_evenDisplacement_iff t w).mpr
    intro u hu
    by_contra hne
    exact hn ⟨u, hu, hne⟩
  obtain ⟨u, hu, hne⟩ := hex
  have hv : parity (complement u) = 0 := by
    apply add_right_cancel (b := (1 : F₂))
    simpa only [hu, zero_add] using (parity_complement_add u).trans hodd
  refine ⟨Pi.single (complement u) 1, even_single_mem_displacement t _ hv, ?_⟩
  rw [pairing_with_even_single hodd hm w _ hv, complement_complement]
  exact (binary_zero_or_one (w u)).resolve_left hne

private theorem pairing_even_vector_with_complement [LinearOrder (Word ι)]
    (t : ι) (hodd : (Fintype.card ι : F₂) = 1) (hm : 3 ≤ Fintype.card ι)
    (x : EvenIndex t → F₂) (u : EvenIndex t) :
    tensorPairing (displacementMap t x) (Pi.single (complement (evenLabel t u)) 1) = x u := by
  classical
  have h : (tensorPairing (Pi.single (complement (evenLabel t u)) 1)).comp
      (displacementMap t) = (LinearMap.proj u : (EvenIndex t → F₂) →ₗ[F₂] F₂) := by
    apply (Pi.basisFun F₂ (EvenIndex t)).ext
    intro v
    simp only [Pi.basisFun_apply, LinearMap.comp_apply, displacementMap_single,
      pairing_with_even_single hodd hm _ _ (evenLabel_parity t v), LinearMap.proj_apply,
      Pi.single_apply]
    by_cases huv : u = v
    · subst v
      simp
    · have hne : complement (evenLabel t u) ≠ complement (evenLabel t v) := by
        intro he
        apply huv
        apply evenLabel_injective t
        simpa only [complement_complement] using congrArg complement he
      simp [huv, Ne.symm huv, hne, hne.symm]
  rw [show tensorPairing (displacementMap t x) (Pi.single (complement (evenLabel t u)) 1) =
      tensorPairing (Pi.single (complement (evenLabel t u)) 1) (displacementMap t x) by
    simp only [tensorPairing, LinearMap.BilinForm.add_apply, LinearMap.BilinForm.flip_apply]
    exact add_comm _ _]
  exact LinearMap.congr_fun h x

/-- The symmetrized half Gram separates every nonzero charge. -/
theorem tensorPairing_perfect [LinearOrder (Word ι)] (t : ι)
    (hodd : (Fintype.card ι : F₂) = 1) (hm : 3 ≤ Fintype.card ι)
    (w : Word ι → F₂) (hw : w ≠ 0) : ∃ z : Word ι → F₂, tensorPairing w z = 1 := by
  classical
  by_cases he : w ∈ evenDisplacement t
  · rcases he with ⟨x, rfl⟩
    have hex : ∃ u : EvenIndex t, x u ≠ 0 := by
      by_contra hn
      apply hw
      have hx : x = 0 := by
        funext u
        by_contra hne
        exact hn ⟨u, hne⟩
      rw [hx, map_zero]
    obtain ⟨u, hu⟩ := hex
    exact ⟨Pi.single (complement (evenLabel t u)) 1,
      (pairing_even_vector_with_complement t hodd hm x u).trans
        ((binary_zero_or_one (x u)).resolve_left hu)⟩
  · obtain ⟨z, _, hz⟩ := separates_outside_evenDisplacement t hodd hm w he
    exact ⟨z, hz⟩

private theorem word_phase_zero_on_evenDisplacement [LinearOrder (Word ι)]
    (r₁ r₂ t : ι) (hodd : (Fintype.card ι : F₂) = 1) (hm : 5 ≤ Fintype.card ι)
    (word : List (ι × Bool)) (hword : ∀ step ∈ word, step.1 = r₁ ∨ step.1 = r₂)
    (hfix : ∀ x ∈ evenDisplacement t,
      x ᵥ* TensorLift.modTwo (TensorLift.wordMatrix word) = x)
    (w : Word ι → F₂) (hw : w ∈ evenDisplacement t) : TensorLift.wordLiftExponent word w = 0 := by
  rcases hw with ⟨x, rfl⟩
  let q : (EvenIndex t → F₂) → F₂ := fun y => TensorLift.wordLiftExponent word (displacementMap t y)
  have hpolar (y z : EvenIndex t → F₂) : q (y + z) = q y + q z := by
    have hp := lift_phase_polar hodd (by omega) word (displacementMap t y) (displacementMap t z)
    dsimp only at hp
    dsimp only [q]
    rw [map_add, hp, hfix _ ⟨y, rfl⟩, hfix _ ⟨z, rfl⟩, CharTwo.add_self_eq_zero, add_zero]
  have hsingle (u : EvenIndex t) : q (Pi.single u 1) = 0 := by
    unfold q
    rw [displacementMap_single]
    exact TensorLift.wordLiftExponent_eq_zero_on_block hodd hm r₁ r₂ (evenLabel t u) word hword _
      (block_single r₁ r₂ _ _ (fun _ _ _ => rfl))
  have hz := quadratic_eq_of_polar_of_single q 0
    (fun y z => by simpa only [LinearMap.zero_apply, add_zero] using hpolar y z)
    (fun u => by simpa only [LinearMap.zero_apply] using hsingle u) x
  exact hz

private theorem fixed_and_phase_zero [LinearOrder (Word ι)] (r₁ r₂ t : ι)
    (hodd : (Fintype.card ι : F₂) = 1) (hm : 5 ≤ Fintype.card ι)
    (w : Word ι → F₂) (hw : w ∈ evenDisplacement t) :
    (actionI r₁ w = w ∧ TensorLift.wordLiftExponent (wordI r₁) w = 0) ∧
    (actionJ r₁ r₂ w = w ∧ TensorLift.wordLiftExponent (wordJ r₁ r₂) w = 0) := by
  have hfixI (x : Word ι → F₂) (hx : x ∈ evenDisplacement t) : actionI r₁ x = x := by
    rcases hx with ⟨y, rfl⟩
    simp only [actionI, LinearMap.comp_apply, generator_fixes_displacement]
  have hfixJ (x : Word ι → F₂) (hx : x ∈ evenDisplacement t) : actionJ r₁ r₂ x = x := by
    rcases hx with ⟨y, rfl⟩
    simp only [actionJ, LinearMap.comp_apply, generator_fixes_displacement]
  refine ⟨⟨hfixI w hw, ?_⟩, ⟨hfixJ w hw, ?_⟩⟩
  · exact word_phase_zero_on_evenDisplacement r₁ r₂ t hodd hm (wordI r₁) (by simp [wordI])
      (fun x hx => (actionI_eq hodd r₁ x).symm.trans (hfixI x hx)) w hw
  · exact word_phase_zero_on_evenDisplacement r₁ r₂ t hodd hm (wordJ r₁ r₂) (by simp [wordJ])
      (fun x hx => (actionJ_eq hodd r₁ r₂ x).symm.trans (hfixJ x hx)) w hw

/-- The normalized trace product for the two prescribed odd-slot Pauli words.

To apply this to the Barnes–Wall twisted ground, supply its negative-central-sign
reflection-quotient representation in tensor-row coordinates. The charge operators
must multiply with the tensor half Gram, the ground dimension must be
`2 ^ (2 ^ (m - 1))`, and the two nonzero ground intertwiners must realize the stated
covariance for the prescribed lifts. -/
theorem normalized_tensor_trace_mul [LinearOrder (Word ι)] (r₁ r₂ t : ι)
    (h₁₂ : r₁ ≠ r₂) (ht₁ : t ≠ r₁) (ht₂ : t ≠ r₂)
    (hodd : (Fintype.card ι : F₂) = 1) (hm : 5 ≤ Fintype.card ι)
    {V : Type*} [AddCommGroup V] [Module ℂ V] [Module.Finite ℂ V] [Nontrivial V]
    (P : (Word ι → F₂) → Module.End ℂ V) (hzero : P 0 = 1)
    (hmul : ∀ x y : Word ι → F₂,
      P x * P y = complexSign (TensorGram.halfGram.toBilin' x y) • P (x + y))
    (hdim : Module.finrank ℂ V = 2 ^ (2 ^ (Fintype.card ι - 1)))
    {Ui Uj : Module.End ℂ V} (hneI : Ui ≠ 0) (hneJ : Uj ≠ 0)
    (hcovI : ∀ x : Word ι → F₂, Ui * P x =
      complexSign (TensorLift.wordLiftExponent [(r₁, false), (r₁, true)] x) •
        (P (x ᵥ* TensorLift.modTwo (TensorLift.wordMatrix [(r₁, false), (r₁, true)])) * Ui))
    (hcovJ : ∀ x : Word ι → F₂, Uj * P x =
      complexSign (TensorLift.wordLiftExponent [(r₁, false), (r₂, false), (r₂, true)] x) •
        (P (x ᵥ* TensorLift.modTwo (TensorLift.wordMatrix [(r₁, false), (r₂, false), (r₂, true)])) * Uj)) :
    ((Module.finrank ℂ V : ℂ) * LinearMap.trace ℂ V (Ui * Uj)) /
      (LinearMap.trace ℂ V Ui * LinearMap.trace ℂ V Uj) =
        (2 : ℂ) ^ (2 ^ (Fintype.card ι - 2)) := by
  classical
  let H : LinearMap.BilinForm F₂ (Word ι → F₂) := TensorGram.halfGram.toBilin'
  let qI := TensorLift.wordLiftExponent (wordI r₁)
  let qJ := TensorLift.wordLiftExponent (wordJ r₁ r₂)
  let e := (spectatorDisplacementEquiv t).toEquiv
  letI : Fintype (evenDisplacement t) := Fintype.ofEquiv _ e
  let coords (w : evenDisplacement t) : EvenIndex t → F₂ := Sum.elim (e.symm w).1 (e.symm w).2
  let a (w : evenDisplacement t) := preimageIMap r₁ t (coords w)
  let b (w : evenDisplacement t) := preimageJMap r₁ r₂ t (coords w)
  have hw (w : evenDisplacement t) : displacementMap t (coords w) = w.val :=
    (spectatorDisplacementEquiv_val t (e.symm w)).symm.trans
      (congrArg Subtype.val (e.apply_symm_apply w))
  have ha (w : evenDisplacement t) : actionI r₁ (a w) + a w = w.val :=
    (displacement_of_action_eq (actual_preimageI r₁ t (coords w))).trans (hw w)
  have hb (w : evenDisplacement t) : actionJ r₁ r₂ (b w) + b w = w.val :=
    (displacement_of_action_eq (actual_preimageJ r₁ r₂ t h₁₂ (coords w))).trans (hw w)
  have hcard : Fintype.card (Word ι → F₂) = (Module.finrank ℂ V) ^ 2 := by
    change Fintype.card ((ι → Bool) → ZMod 2) = _
    rw [Fintype.card_fun, Fintype.card_fun, Fintype.card_bool, ZMod.card, hdim, ← pow_mul,
      ← pow_succ, Nat.sub_add_cancel (show 1 ≤ Fintype.card ι by omega)]
  have covI (x : Word ι → F₂) : Ui * P x = complexSign (qI x) • (P (actionI r₁ x) * Ui) := by
    simpa only [qI, actionI_eq hodd r₁ x, wordI] using hcovI x
  have covJ (x : Word ι → F₂) : Uj * P x = complexSign (qJ x) • (P (actionJ r₁ r₂ x) * Uj) := by
    simpa only [qJ, actionJ_eq hodd r₁ r₂ x, wordJ] using hcovJ x
  have hm₃ : 3 ≤ Fintype.card ι := by omega
  have htrace := WeylIntertwinerTraceProduct.normalized_trace_mul_eq_gauss_sum
    (H := H) (W := evenDisplacement t) hzero hmul (tensorPairing_perfect t hodd hm₃) hcard
    covI covJ a b ha hb
    (fun w hw => (fixed_and_phase_zero r₁ r₂ t hodd hm w hw).1)
    (fun w hw => (fixed_and_phase_zero r₁ r₂ t hodd hm w hw).2)
    (separates_outside_evenDisplacement t hodd hm₃) hneI hneJ
  refine htrace.trans ?_
  let f (w : evenDisplacement t) := complexSign (qI (a w) + qJ (b w) + H w.val (a w + b w + w.val))
  change (∑ w, f w) = _
  rw [← e.sum_comp f]
  have hf (p : (Half t false → F₂) × (Half t true → F₂)) :
      f (e p) = complexSign (traceExponent r₁ r₂ t H qI qJ p) := by
    have hval : (e p).val = displacementMap t (Sum.elim p.1 p.2) :=
      spectatorDisplacementEquiv_val t p
    simp only [f, a, b, coords, Equiv.symm_apply_apply, hval, traceExponent]
  simp_rw [hf]
  exact tensor_trace_gauss_sum r₁ r₂ t h₁₂ ht₁ ht₂ hodd hm

end
end D5.S3.VertexAlgebra.TwistedGround.BarnesWall.OddWeylTrace
