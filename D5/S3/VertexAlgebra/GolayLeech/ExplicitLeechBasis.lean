def unitVector (axis : Fin 24) : Coordinates := fun other => if other = axis then 1 else 0

def generatorVector (index : Fin 60) : Coordinates :=
  if first : index.val < 24 then (8 : ℤ) • unitVector ⟨index.val, first⟩
  else if second : index.val < 47 then
    (4 : ℤ) • (unitVector ⟨index.val - 23, by omega⟩ - unitVector 0)
  else if third : index.val < 59 then
    fun axis => 2 * ((generator axis ⟨index.val - 47, by omega⟩).val : ℤ)
  else fun axis => if axis = 0 then -3 else 1

def columnParity (column : Fin 24) : ℤ := if column.val = 23 then 1 else 0

 theorem finite_column_certificate : ∀ column : Fin 24,
    (∀ axis, basisMatrix axis column % 2 = columnParity column) ∧
    encode (fun position => columnMessages position column) =
      reduction (fun axis => (basisMatrix axis column - columnParity column) / 2) ∧
    (∑ axis, basisMatrix axis column) % 8 = 4 * columnParity column := by
  decide

 theorem basis_column_member (column : Fin 24) : member (fun axis => basisMatrix axis column) := by
  rw [member_iff_congruences]
  refine ⟨columnParity column, ?_, (finite_column_certificate column).1,
    ⟨fun position => columnMessages position column, (finite_column_certificate column).2.1⟩,
    (finite_column_certificate column).2.2⟩
  unfold columnParity
  split <;> simp

 theorem finite_generator_coordinates : ∀ index : Fin 60,
    basisMatrix *ᵥ (fun column => generatorCoordinates column index) = generatorVector index := by
  intro index
  ext axis
  fin_cases index <;> fin_cases axis <;> decide

 theorem finite_gram_certificate : basisMatrixᵀ * basisMatrix = (8 : ℤ) • gramMatrix ∧
    (∀ left right, gramMatrix left right = gramMatrix right left) ∧
    (∀ axis, Even (gramMatrix axis axis)) := by
  refine ⟨?_, ?_, ?_⟩
  · ext left right
    fin_cases left <;> fin_cases right <;> decide
  · intro left right
    fin_cases left <;> fin_cases right <;> decide
  · intro axis
    fin_cases axis <;> decide

 theorem basis_determinant : basisMatrix.det = 2 ^ 36 := by
  have checked : ∀ axis position : Fin 24, position < axis → basisMatrix axis position = 0 := by
    intro axis position
    fin_cases axis <;> fin_cases position <;> decide
  have triangular : basisMatrix.IsUpperTriangular := fun {_ _} condition => checked _ _ condition
  rw [Matrix.det_of_isUpperTriangular triangular]
  norm_num [Fin.prod_univ_succ, basisMatrix, Matrix.of_apply]

 theorem gram_determinant : gramMatrix.det = 1 := by
  have determinant := congrArg Matrix.det finite_gram_certificate.1
  simp only [Matrix.det_mul, Matrix.det_transpose, Matrix.det_smul,
    Fintype.card_fin, basis_determinant] at determinant
  norm_num at determinant
  nlinarith

 theorem basis_injective : Function.Injective (Matrix.mulVec basisMatrix) := by
  exact Matrix.mulVec_injective_of_det_ne_zero (by rw [basis_determinant]; norm_num)

end D5.S3.VertexAlgebra.GolayLeech.ExplicitLeechBasis
