/- GID: D5/S3/VertexAlgebra/BRST/MonsterRankTwoPresentation
   generality: I
   mirror-B: D5/B/S3/VertexAlgebra/BRST/MonsterRankTwoPresentation
   mirror-E: none(waiver:algebraic-Monster-presentation)
   anchors: []
   utility: none
   digest: The real rank-two Monster presentation and its triangular spanning theorem. -/

import D5.S3.VertexAlgebra.BRST.MonsterPositiveCocycle
import Mathlib.Data.Fin.VecNotation

/-!
The generators and relations specialize the Monster presentation of Borcherds,
*Monstrous moonshine and monstrous Lie superalgebras* (1992), and the rank-two quotient in
Jurisich, *Generalized Kac–Moody Lie algebras, free Lie algebras and the structure of the
Monster Lie algebra* (1998), Theorem 6.1. The spanning proof follows the two Lie-span
inductions of §7 of the direct-presentation derivation dated 2026-11-24.

Weights use paper coordinates `(m,n)`. The corresponding native Cartan coordinates
are `(m,-n)` in the ordered null basis.
-/

set_option autoImplicit false

noncomputable section

namespace D5.S3.VertexAlgebra.MonsterRankTwoPresentation

open MonsterPositiveCocycle
open scoped Classical

variable {J : Type*} (order : J → ℕ+)

/-- The rank-two Cartan in paper coordinates. -/
abbrev CartanCoordinates := Fin 2 → ℝ

/-- The simple weights, indexed by the real label `none` and the imaginary labels
`some j`, as in the positive Serre presentation. -/
def simpleWeight : Option J → Weight
  | none => realRoot
  | some j => imaginaryRoot (order j : ℕ)

/-- View a lattice weight as a real Cartan coordinate vector. -/
def weightCoordinates (p : Weight) : CartanCoordinates := ![(p.1 : ℝ), (p.2 : ℝ)]

/-- Pair a Cartan coordinate vector with a lattice weight using the paper form. -/
def cartanWeight (p : Weight) : CartanCoordinates →ₗ[ℝ] ℝ :=
  (-(p.2 : ℝ)) • LinearMap.proj 0 + (-(p.1 : ℝ)) • LinearMap.proj 1

theorem cartanWeight_apply (p : Weight) (h : CartanCoordinates) :
    cartanWeight p h = -(h 0 * (p.2 : ℝ) + h 1 * (p.1 : ℝ)) := by
  simp only [cartanWeight, LinearMap.add_apply, LinearMap.smul_apply, LinearMap.proj_apply,
    smul_eq_mul]
  ring

theorem cartanWeight_weightCoordinates (p q : Weight) :
    cartanWeight q (weightCoordinates p) = weightForm p q :=
  cartanWeight_apply q (weightCoordinates p)

/-- The free generators before imposing the rank-two presentation relations. -/
inductive Generator (J : Type*) where
  | cartan : Fin 2 → Generator J
  | positive : Option J → Generator J
  | negative : Option J → Generator J

local notation "F" => FreeLieAlgebra ℝ (Generator J)
local notation "H₀" => fun i => FreeLieAlgebra.of ℝ (Generator.cartan (J := J) i)
local notation "E₀" => fun i => FreeLieAlgebra.of ℝ (Generator.positive (J := J) i)
local notation "F₀" => fun i => FreeLieAlgebra.of ℝ (Generator.negative (J := J) i)

private def coordinateMap {V : Type*} [AddCommMonoid V] [Module ℝ V]
    (g : Fin 2 → V) : CartanCoordinates →ₗ[ℝ] V :=
  (LinearMap.proj 0).smulRight (g 0) + (LinearMap.proj 1).smulRight (g 1)

private theorem coordinateMap_apply {V : Type*} [AddCommMonoid V] [Module ℝ V]
    (g : Fin 2 → V) (h : CartanCoordinates) :
    coordinateMap g h = h 0 • g 0 + h 1 • g 1 :=
  rfl

private theorem coordinateMap_single {V : Type*} [AddCommMonoid V] [Module ℝ V]
    (g : Fin 2 → V) (i : Fin 2) : coordinateMap g (Pi.single i 1) = g i := by
  fin_cases i <;> simp [coordinateMap_apply]

private theorem coordinates_expand (h : CartanCoordinates) :
    h 0 • Pi.single (0 : Fin 2) (1 : ℝ) + h 1 • Pi.single (1 : Fin 2) (1 : ℝ) = h := by
  funext i
  fin_cases i <;> simp

/-- The defining relators in the free real Lie algebra. The mixed relator uses
the coordinate-linear image of the simple weight in the two Cartan generators. -/
inductive IsRelation (order : J → ℕ+) : F → Prop where
  | cartan_comm (i k : Fin 2) : IsRelation order ⁅H₀ i, H₀ k⁆
  | cartan_positive (i : Fin 2) (a : Option J) :
      IsRelation order
        (⁅H₀ i, E₀ a⁆ - cartanWeight (simpleWeight order a) (Pi.single i 1) • E₀ a)
  | cartan_negative (i : Fin 2) (a : Option J) :
      IsRelation order
        (⁅H₀ i, F₀ a⁆ - (-cartanWeight (simpleWeight order a) (Pi.single i 1)) • F₀ a)
  | mixed (a b : Option J) :
      IsRelation order
        (⁅E₀ a, F₀ b⁆ - if a = b then coordinateMap H₀ (weightCoordinates (simpleWeight order a))
          else 0)
  | serre_positive (j : J) :
      IsRelation order (adIter (E₀ none) (order j : ℕ) (E₀ (some j)))
  | serre_negative (j : J) :
      IsRelation order (adIter (F₀ none) (order j : ℕ) (F₀ (some j)))

/-- The Lie ideal generated by the defining relators. -/
def relationIdeal : LieIdeal ℝ F := LieSubmodule.lieSpan ℝ F (IsRelation order)

/-- The real rank-two presentation with the given imaginary labels and orders. -/
abbrev Presented := F ⧸ relationIdeal order

local notation "M" => Presented order

/-- The canonical quotient map on the free algebra. -/
def quotient : F →ₗ⁅ℝ⁆ M :=
  { (relationIdeal order).toSubmodule.mkQ with
    map_lie' := fun {x y} => LieSubmodule.Quotient.mk_bracket (relationIdeal order) x y }

/-- The images of the two free Cartan generators. -/
def cartanBasis (i : Fin 2) : M := quotient order (H₀ i)

/-- The linear map from the rank-two coordinates to the presented Lie algebra. -/
def cartan : CartanCoordinates →ₗ[ℝ] M := coordinateMap (cartanBasis order)

/-- The positive real and imaginary simple generators. -/
def e (a : Option J) : M := quotient order (E₀ a)

/-- The negative real and imaginary simple generators. -/
def f (a : Option J) : M := quotient order (F₀ a)

private theorem map_adIter {A B : Type*} [LieRing A] [LieAlgebra ℝ A]
    [LieRing B] [LieAlgebra ℝ B] (g : A →ₗ⁅ℝ⁆ B) (x y : A) (k : ℕ) :
    g (adIter x k y) = adIter (g x) k (g y) := by
  induction k with
  | zero => rfl
  | succ k ih => rw [adIter, adIter, LieHom.map_lie, ih]

private theorem relation_eq_zero {x : F} (hx : IsRelation order x) : quotient order x = 0 :=
  (Submodule.Quotient.mk_eq_zero _).mpr (LieSubmodule.subset_lieSpan hx)

@[simp] theorem cartan_single (i : Fin 2) : cartan order (Pi.single i 1) = cartanBasis order i :=
  coordinateMap_single _ i

private theorem cartanBasis_commute (i k : Fin 2) :
    ⁅cartanBasis order i, cartanBasis order k⁆ = 0 := by
  simpa only [LieHom.map_lie, cartanBasis] using
    relation_eq_zero order (IsRelation.cartan_comm (order := order) i k)

private theorem cartanBasis_lie_e (i : Fin 2) (a : Option J) :
    ⁅cartanBasis order i, e order a⁆ =
      cartanWeight (simpleWeight order a) (Pi.single i 1) • e order a := by
  apply sub_eq_zero.mp
  simpa only [LieHom.map_lie, map_sub, map_smul, cartanBasis, e] using
    relation_eq_zero order (IsRelation.cartan_positive (order := order) i a)

private theorem cartanBasis_lie_f (i : Fin 2) (a : Option J) :
    ⁅cartanBasis order i, f order a⁆ =
      (-cartanWeight (simpleWeight order a) (Pi.single i 1)) • f order a := by
  apply sub_eq_zero.mp
  simpa only [LieHom.map_lie, map_sub, map_smul, cartanBasis, f] using
    relation_eq_zero order (IsRelation.cartan_negative (order := order) i a)

/-- Cartan vectors commute in the quotient. -/
theorem cartan_commute (h k : CartanCoordinates) : ⁅cartan order h, cartan order k⁆ = 0 := by
  simp only [cartan, coordinateMap_apply, add_lie, lie_add, smul_lie, lie_smul,
    cartanBasis_commute, smul_zero, add_zero]

/-- A Cartan vector acts on a positive simple generator by its simple weight. -/
theorem cartan_lie_e (h : CartanCoordinates) (a : Option J) :
    ⁅cartan order h, e order a⁆ = cartanWeight (simpleWeight order a) h • e order a := by
  conv_rhs => rw [← coordinates_expand h]
  simp only [cartan, coordinateMap_apply, add_lie, smul_lie, cartanBasis_lie_e,
    map_add, map_smul, add_smul, smul_smul, smul_eq_mul]

/-- A Cartan vector acts on a negative simple generator by the opposite weight. -/
theorem cartan_lie_f (h : CartanCoordinates) (a : Option J) :
    ⁅cartan order h, f order a⁆ = (-cartanWeight (simpleWeight order a) h) • f order a := by
  conv_rhs => rw [← coordinates_expand h]
  simp only [cartan, coordinateMap_apply, add_lie, smul_lie, cartanBasis_lie_f,
    map_add, map_smul, neg_add, add_smul, smul_smul, smul_eq_mul, mul_neg]

/-- Opposite simple generators bracket to the Cartan vector on the diagonal. -/
theorem lie_e_f (a b : Option J) :
    ⁅e order a, f order b⁆ =
      if a = b then cartan order (weightCoordinates (simpleWeight order a)) else 0 := by
  have h := relation_eq_zero order (IsRelation.mixed (order := order) a b)
  apply sub_eq_zero.mp
  by_cases hab : a = b
  · simpa only [ite_eq_left hab, LieHom.map_lie, map_sub, map_add, map_smul,
      coordinateMap_apply, cartan, cartanBasis, e, f] using h
  · simpa only [ite_eq_right hab, LieHom.map_lie, map_sub, map_zero, e, f] using h

/-- The positive real-imaginary Serre relator vanishes. -/
theorem serre_e (j : J) : adIter (e order none) (order j : ℕ) (e order (some j)) = 0 := by
  simpa only [map_adIter, e] using
    relation_eq_zero order (IsRelation.serre_positive (order := order) j)

/-- The negative real-imaginary Serre relator vanishes. -/
theorem serre_f (j : J) : adIter (f order none) (order j : ℕ) (f order (some j)) = 0 := by
  simpa only [map_adIter, f] using
    relation_eq_zero order (IsRelation.serre_negative (order := order) j)

private def descend {A B : Type*} [LieRing A] [LieAlgebra ℝ A]
    [LieRing B] [LieAlgebra ℝ B] (I : LieIdeal ℝ A) (g : A →ₗ⁅ℝ⁆ B) (hg : I ≤ g.ker) :
    A ⧸ I →ₗ⁅ℝ⁆ B :=
  { I.toSubmodule.liftQ g.toLinearMap hg with
    map_lie' := by
      intro x y
      induction x using Submodule.Quotient.induction_on with
      | _ x =>
        induction y using Submodule.Quotient.induction_on with
        | _ y => exact g.map_lie x y }

private def serreMap (g : Option J → M)
    (hg : ∀ j : J, adIter (g none) (order j : ℕ) (g (some j)) = 0) :
    PositivePresentation order →ₗ⁅ℝ⁆ M :=
  descend (serreIdeal order) (FreeLieAlgebra.lift ℝ g) (by
    apply LieSubmodule.lieSpan_le.mpr
    rintro _ ⟨j, rfl⟩
    change FreeLieAlgebra.lift ℝ g
      (adIter (FreeLieAlgebra.of ℝ none) (order j : ℕ) (FreeLieAlgebra.of ℝ (some j))) = 0
    rw [map_adIter, FreeLieAlgebra.lift_of_apply, FreeLieAlgebra.lift_of_apply]
    exact hg j)

/-- Interpret the Serre quotient using the positive generators. -/
def positiveMap : PositivePresentation order →ₗ⁅ℝ⁆ M :=
  serreMap order (e order) (serre_e order)

/-- Interpret a copy of the same Serre quotient using the negative generators. -/
def negativeMap : PositivePresentation order →ₗ⁅ℝ⁆ M :=
  serreMap order (f order) (serre_f order)

@[simp] theorem positiveMap_generator (a : Option J) :
    positiveMap order (generator order a) = e order a :=
  FreeLieAlgebra.lift_of_apply _ _

@[simp] theorem negativeMap_generator (a : Option J) :
    negativeMap order (generator order a) = f order a :=
  FreeLieAlgebra.lift_of_apply _ _

section LieSpan

open LieSubalgebra
open Submodule (mem_sup_left mem_sup_right)

variable {R L : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]

private theorem lie_mem_sup_right {U V T : Submodule R L} {x y : L}
    (hy : y ∈ U ⊔ V)
    (hU : ∀ u, u ∈ U → ⁅x, u⁆ ∈ T)
    (hV : ∀ v, v ∈ V → ⁅x, v⁆ ∈ T) : ⁅x, y⁆ ∈ T := by
  obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp hy
  rw [lie_add]
  exact T.add_mem (hU u hu) (hV v hv)

private theorem lie_mem_sup_left {U V T : Submodule R L} {x y : L}
    (hx : x ∈ U ⊔ V)
    (hU : ∀ u, u ∈ U → ⁅u, y⁆ ∈ T)
    (hV : ∀ v, v ∈ V → ⁅v, y⁆ ∈ T) : ⁅x, y⁆ ∈ T := by
  obtain ⟨u, hu, v, hv, rfl⟩ := Submodule.mem_sup.mp hx
  rw [add_lie]
  exact T.add_mem (hU u hu) (hV v hv)

private theorem lie_lieSpan_mem {s : Set L} {x : L}
    (h : ∀ y ∈ s, ⁅x, y⁆ ∈ lieSpan R L s) {y : L} (hy : y ∈ lieSpan R L s) :
    ⁅x, y⁆ ∈ lieSpan R L s := by
  induction hy using lieSpan_induction with
  | mem y hy => exact h y hy
  | zero => rw [lie_zero]; exact zero_mem _
  | add y z _ _ hy hz => rw [lie_add]; exact add_mem hy hz
  | smul r y _ hy => rw [lie_smul]; exact SMulMemClass.smul_mem r hy
  | lie y z hy hz ihy ihz =>
    rw [leibniz_lie]
    exact add_mem (lie_mem _ ihy hz) (lie_mem _ hy ihz)

private theorem lieSpan_range_free {X : Type*} (q : FreeLieAlgebra R X →ₗ⁅R⁆ L) :
    lieSpan R L (Set.range (q ∘ FreeLieAlgebra.of R)) = q.range := by
  let S := lieSpan R L (Set.range (q ∘ FreeLieAlgebra.of R))
  let g : FreeLieAlgebra R X →ₗ⁅R⁆ S :=
    FreeLieAlgebra.lift R fun x => ⟨q (FreeLieAlgebra.of R x),
      subset_lieSpan (Set.mem_range_self x)⟩
  have hg : S.incl.comp g = q := by
    apply FreeLieAlgebra.hom_ext
    intro x
    simp [g]
  apply le_antisymm
  · apply lieSpan_le.mpr
    rintro z ⟨x, hx⟩
    rw [← hx]
    exact q.mem_range_self (FreeLieAlgebra.of R x)
  · rintro x ⟨y, rfl⟩
    have heq : (g y : L) = q y := DFunLike.congr_fun hg y
    change q y ∈ S
    rw [← heq]
    exact (g y).property

variable {positive negative : Set L} {H : LieSubalgebra R L}

local notation "P" => lieSpan R L positive
local notation "N" => lieSpan R L negative
local notation "T" => ((toSubmodule N ⊔ toSubmodule H) ⊔ toSubmodule P)

/-- The first mixed-bracket induction keeps a simple positive generator
against the negative span inside the negative span plus the Cartan. -/
private theorem simple_lie_negativeSpan
    (hn : ∀ h ∈ H, ∀ y ∈ N, ⁅h, y⁆ ∈ N)
    (hm : ∀ x ∈ positive, ∀ y ∈ negative, ⁅x, y⁆ ∈ H)
    {x y : L} (hx : x ∈ positive) (hy : y ∈ N) :
    ⁅x, y⁆ ∈ (N).toSubmodule ⊔ (H).toSubmodule := by
  induction hy using lieSpan_induction with
  | mem y hy => exact mem_sup_right (hm x hx y hy)
  | zero => rw [lie_zero]; exact zero_mem _
  | add y z _ _ hy hz => rw [lie_add]; exact add_mem hy hz
  | smul r y _ hy => rw [lie_smul]; exact SMulMemClass.smul_mem r hy
  | lie y z hy hz ihy ihz =>
    have h₁ : ⁅⁅x, y⁆, z⁆ ∈ N :=
      lie_mem_sup_left ihy (fun _ hu => (N).lie_mem hu hz) (fun _ hu => hn _ hu z hz)
    have h₂ : ⁅⁅x, z⁆, y⁆ ∈ N :=
      lie_mem_sup_left ihz (fun _ hu => (N).lie_mem hu hy) (fun _ hu => hn _ hu y hy)
    rw [leibniz_lie, ← lie_skew y ⁅x, z⁆]
    exact mem_sup_left (add_mem h₁ (neg_mem h₂))

private theorem lie_cartan_mem_positive
    (hp : ∀ h ∈ H, ∀ x ∈ P, ⁅h, x⁆ ∈ P) {x h : L} (hx : x ∈ P) (hh : h ∈ H) :
    ⁅x, h⁆ ∈ P := by
  rw [← lie_skew]
  exact neg_mem (hp h hh x hx)

private theorem positive_lie_triangular
    (hp : ∀ h ∈ H, ∀ x ∈ P, ⁅h, x⁆ ∈ P)
    {x y : L} (hx : x ∈ P) (hxn : ∀ z ∈ N, ⁅x, z⁆ ∈ T) (hy : y ∈ T) :
    ⁅x, y⁆ ∈ T :=
  lie_mem_sup_right hy
    (fun _ huv => lie_mem_sup_right huv hxn (fun _ hh =>
      mem_sup_right (lie_cartan_mem_positive hp hx hh)))
    (fun _ hv => mem_sup_right ((P).lie_mem hx hv))

/-- Jacobi extends the mixed containment from simple positive generators
to the full positive Lie span. -/
private theorem positiveSpan_lie_negativeSpan
    (hp : ∀ h ∈ H, ∀ x ∈ P, ⁅h, x⁆ ∈ P)
    (hn : ∀ h ∈ H, ∀ y ∈ N, ⁅h, y⁆ ∈ N)
    (hm : ∀ x ∈ positive, ∀ y ∈ negative, ⁅x, y⁆ ∈ H)
    {x : L} (hx : x ∈ P) : ∀ y ∈ N, ⁅x, y⁆ ∈ T := by
  induction hx using lieSpan_induction with
  | mem x hx =>
    exact fun y hy => mem_sup_left (simple_lie_negativeSpan hn hm hx hy)
  | zero =>
    intro y _
    rw [zero_lie]
    exact zero_mem _
  | add x z _ _ hx hz =>
    intro y hy
    rw [add_lie]
    exact add_mem (hx y hy) (hz y hy)
  | smul r x _ hx =>
    intro y hy
    rw [smul_lie]
    exact SMulMemClass.smul_mem r (hx y hy)
  | lie x z hx hz ihx ihz =>
    intro y hy
    rw [lie_lie]
    exact sub_mem (positive_lie_triangular hp hx ihx (ihz y hy))
      (positive_lie_triangular hp hz ihz (ihx y hy))

/-- If the two generated halves are normalized by the Cartan and mixed
generator brackets are Cartan vectors, their submodule sum is bracket closed. -/
private theorem triangularSpan_lie
    (hp : ∀ h ∈ H, ∀ x ∈ P, ⁅h, x⁆ ∈ P)
    (hn : ∀ h ∈ H, ∀ y ∈ N, ⁅h, y⁆ ∈ N)
    (hm : ∀ x ∈ positive, ∀ y ∈ negative, ⁅x, y⁆ ∈ H)
    {x y : L} (hx : x ∈ T) (hy : y ∈ T) : ⁅x, y⁆ ∈ T := by
  have hP {x y : L} (hx : x ∈ P) (hy : y ∈ T) : ⁅x, y⁆ ∈ T :=
    positive_lie_triangular hp hx (positiveSpan_lie_negativeSpan hp hn hm hx) hy
  have hH {x y : L} (hx : x ∈ H) (hy : y ∈ T) : ⁅x, y⁆ ∈ T :=
    lie_mem_sup_right hy
      (fun _ huv => lie_mem_sup_right huv
        (fun _ hu => mem_sup_left (mem_sup_left (hn x hx _ hu)))
        (fun _ hv => mem_sup_left (mem_sup_right ((H).lie_mem hx hv))))
      (fun _ hv => mem_sup_right (hp x hx _ hv))
  have hN {x y : L} (hx : x ∈ N) (hy : y ∈ T) : ⁅x, y⁆ ∈ T := by
    apply lie_mem_sup_right hy
    · intro z hz
      rw [← lie_skew]
      exact neg_mem (lie_mem_sup_left hz
        (fun _ hu => mem_sup_left (mem_sup_left ((N).lie_mem hu hx)))
        (fun v hv => mem_sup_left (mem_sup_left (hn v hv x hx))))
    · intro z hz
      rw [← lie_skew]
      exact neg_mem (hP hz (mem_sup_left (mem_sup_left hx)))
  exact lie_mem_sup_left hx (fun _ huv => lie_mem_sup_left huv
      (fun _ hu => hN hu hy) (fun _ hv => hH hv hy)) (fun _ hv => hP hv hy)

end LieSpan

section Spanning

open LieSubalgebra
open Submodule (mem_sup_left mem_sup_right)

local notation "P" => lieSpan ℝ M (Set.range (e order))
local notation "N" => lieSpan ℝ M (Set.range (f order))

private def cartanSubalgebra : LieSubalgebra ℝ M where
  toSubmodule := LinearMap.range (cartan order)
  lie_mem' := by
    rintro _ _ ⟨h, rfl⟩ ⟨k, rfl⟩
    rw [cartan_commute]
    exact (LinearMap.range (cartan order)).zero_mem

local notation "H" => cartanSubalgebra order
local notation "T" => ((toSubmodule N ⊔ toSubmodule H) ⊔ toSubmodule P)

private theorem cartan_lie_positiveSpan (h : M) (hh : h ∈ H) (x : M) (hx : x ∈ P) :
    ⁅h, x⁆ ∈ P := by
  obtain ⟨h, rfl⟩ := hh
  apply lie_lieSpan_mem _ hx
  rintro _ ⟨a, rfl⟩
  rw [cartan_lie_e]
  exact (P).smul_mem _ (subset_lieSpan (Set.mem_range_self a))

private theorem cartan_lie_negativeSpan (h : M) (hh : h ∈ H) (x : M) (hx : x ∈ N) :
    ⁅h, x⁆ ∈ N := by
  obtain ⟨h, rfl⟩ := hh
  apply lie_lieSpan_mem _ hx
  rintro _ ⟨a, rfl⟩
  rw [cartan_lie_f]
  exact (N).smul_mem _ (subset_lieSpan (Set.mem_range_self a))

private theorem simple_lie_simple_mem_cartan (x : M) (hx : x ∈ Set.range (e order))
    (y : M) (hy : y ∈ Set.range (f order)) : ⁅x, y⁆ ∈ H := by
  obtain ⟨a, rfl⟩ := hx
  obtain ⟨b, rfl⟩ := hy
  rw [lie_e_f]
  split
  · exact LinearMap.mem_range_self _ _
  · exact (H).zero_mem

private theorem triangularSubmodule_eq_top : T = ⊤ := by
  let S : LieSubalgebra ℝ M :=
    { toSubmodule := T
      lie_mem' := fun {x y} hx hy => triangularSpan_lie
        (cartan_lie_positiveSpan order) (cartan_lie_negativeSpan order)
        (simple_lie_simple_mem_cartan order) hx hy }
  have hs : lieSpan ℝ M (Set.range (quotient order ∘ FreeLieAlgebra.of ℝ)) ≤ S := by
    apply lieSpan_le.mpr
    rintro z ⟨g, hg⟩
    rw [← hg]
    change quotient order (FreeLieAlgebra.of ℝ g) ∈ T
    cases g with
    | cartan i =>
      exact mem_sup_left (mem_sup_right (show cartanBasis order i ∈ H from
        ⟨Pi.single i 1, cartan_single order i⟩))
    | positive a => exact mem_sup_right (subset_lieSpan (Set.mem_range_self a))
    | negative a => exact mem_sup_left (mem_sup_left (subset_lieSpan (Set.mem_range_self a)))
  rw [lieSpan_range_free] at hs
  have hq : Function.Surjective (quotient order) := Submodule.Quotient.mk_surjective _
  apply top_unique
  intro x _
  obtain ⟨y, rfl⟩ := hq x
  exact hs ((quotient order).mem_range_self y)

private theorem serreMap_range (g : Option J → M)
    (hg : ∀ j : J, adIter (g none) (order j : ℕ) (g (some j)) = 0) :
    (serreMap order g hg).range = lieSpan ℝ M (Set.range g) := by
  have hq : Function.Surjective (presentationQuotient order) := Submodule.Quotient.mk_surjective _
  calc
    (serreMap order g hg).range =
        ((serreMap order g hg).comp (presentationQuotient order)).range := by
      ext x
      simp only [LieHom.mem_range, LieHom.comp_apply]
      exact hq.exists
    _ = lieSpan ℝ M (Set.range g) := by
      rw [← lieSpan_range_free]
      congr 2
      funext a
      exact FreeLieAlgebra.lift_of_apply g a

/-- Every element of the rank-two Monster presentation is a sum of a negative
Serre image, a Cartan vector, and a positive Serre image. -/
theorem presentation_triangular_span (z : M) :
    ∃ (xNeg : PositivePresentation order) (h : CartanCoordinates) (xPos : PositivePresentation order),
      z = negativeMap order xNeg + cartan order h + positiveMap order xPos := by
  have hz : z ∈ T := by rw [triangularSubmodule_eq_top]; trivial
  obtain ⟨u, hu, p, hp, rfl⟩ := Submodule.mem_sup.mp hz
  obtain ⟨n, hn, h, hh, rfl⟩ := Submodule.mem_sup.mp hu
  change n ∈ N at hn
  change p ∈ P at hp
  rw [← serreMap_range order (f order) (serre_f order)] at hn
  rw [← serreMap_range order (e order) (serre_e order)] at hp
  obtain ⟨xNeg, rfl⟩ := hn
  obtain ⟨xPos, rfl⟩ := hp
  obtain ⟨c, rfl⟩ := hh
  exact ⟨xNeg, c, xPos, rfl⟩

end Spanning

section UniversalProperty

variable {L : Type*} [LieRing L] [LieAlgebra ℝ L]

private def freeLift (c : CartanCoordinates →ₗ[ℝ] L) (pos neg : Option J → L) :
    F →ₗ⁅ℝ⁆ L :=
  FreeLieAlgebra.lift ℝ fun
    | .cartan i => c (Pi.single i 1)
    | .positive a => pos a
    | .negative a => neg a

private theorem freeLift_cartan (c : CartanCoordinates →ₗ[ℝ] L) (pos neg : Option J → L)
    (h : CartanCoordinates) : freeLift c pos neg (coordinateMap H₀ h) = c h := by
  conv_rhs => rw [← coordinates_expand h]
  simp only [coordinateMap_apply, map_add, map_smul, freeLift, FreeLieAlgebra.lift_of_apply]

variable (c : CartanCoordinates →ₗ[ℝ] L) (pos neg : Option J → L)
variable (hc : ∀ h k, ⁅c h, c k⁆ = 0)
variable (hp : ∀ h a, ⁅c h, pos a⁆ = cartanWeight (simpleWeight order a) h • pos a)
variable (hn : ∀ h a, ⁅c h, neg a⁆ = (-cartanWeight (simpleWeight order a) h) • neg a)
variable (hm : ∀ a b, ⁅pos a, neg b⁆ =
  if a = b then c (weightCoordinates (simpleWeight order a)) else 0)
variable (hs₁ : ∀ j, adIter (pos none) (order j : ℕ) (pos (some j)) = 0)
variable (hs₂ : ∀ j, adIter (neg none) (order j : ℕ) (neg (some j)) = 0)

/-- Evaluate the rank-two quotient on images that satisfy the defining relations. -/
def lift : M →ₗ⁅ℝ⁆ L :=
  descend (relationIdeal order) (freeLift c pos neg) (by
    apply LieSubmodule.lieSpan_le.mpr
    intro x hx
    change freeLift c pos neg x = 0
    cases hx with
    | cartan_comm i k =>
      simpa only [LieHom.map_lie, freeLift, FreeLieAlgebra.lift_of_apply] using
        hc (Pi.single i 1) (Pi.single k 1)
    | cartan_positive i a =>
      simpa only [LieHom.map_lie, map_sub, map_smul, freeLift, FreeLieAlgebra.lift_of_apply] using
        sub_eq_zero.mpr (hp (Pi.single i 1) a)
    | cartan_negative i a =>
      simpa only [LieHom.map_lie, map_sub, map_smul, freeLift, FreeLieAlgebra.lift_of_apply] using
        sub_eq_zero.mpr (hn (Pi.single i 1) a)
    | mixed a b =>
      rw [map_sub, LieHom.map_lie]
      change ⁅freeLift c pos neg (E₀ a), freeLift c pos neg (F₀ b)⁆ - _ = 0
      rw [show freeLift c pos neg (E₀ a) = pos a from FreeLieAlgebra.lift_of_apply _ _,
        show freeLift c pos neg (F₀ b) = neg b from FreeLieAlgebra.lift_of_apply _ _, hm]
      by_cases hab : a = b
      · rw [ite_eq_left hab, ite_eq_left hab, freeLift_cartan, sub_self]
      · rw [ite_eq_right hab, ite_eq_right hab, map_zero, sub_self]
    | serre_positive j =>
      simpa only [map_adIter, freeLift, FreeLieAlgebra.lift_of_apply] using hs₁ j
    | serre_negative j =>
      simpa only [map_adIter, freeLift, FreeLieAlgebra.lift_of_apply] using hs₂ j)

@[simp] theorem lift_e (a : Option J) :
    lift order c pos neg hc hp hn hm hs₁ hs₂ (e order a) = pos a :=
  FreeLieAlgebra.lift_of_apply _ _

@[simp] theorem lift_f (a : Option J) :
    lift order c pos neg hc hp hn hm hs₁ hs₂ (f order a) = neg a :=
  FreeLieAlgebra.lift_of_apply _ _

@[simp] theorem lift_cartan (h : CartanCoordinates) :
    lift order c pos neg hc hp hn hm hs₁ hs₂ (cartan order h) = c h := by
  have hq : cartan order h = quotient order (coordinateMap H₀ h) := by
    simp only [cartan, coordinateMap_apply, map_add, map_smul, cartanBasis]
  rw [hq]
  exact freeLift_cartan c pos neg h

/-- Homomorphisms out of the presentation are determined by the Cartan
and the simple generators of each sign. -/
theorem hom_ext {g₁ g₂ : M →ₗ⁅ℝ⁆ L}
    (hC : ∀ h, g₁ (cartan order h) = g₂ (cartan order h))
    (hE : ∀ a, g₁ (e order a) = g₂ (e order a))
    (hF : ∀ a, g₁ (f order a) = g₂ (f order a)) : g₁ = g₂ := by
  have heq : g₁.comp (quotient order) = g₂.comp (quotient order) := by
    apply FreeLieAlgebra.hom_ext
    intro a
    cases a with
    | cartan i =>
      simpa only [cartan_single, cartanBasis, LieHom.comp_apply] using hC (Pi.single i 1)
    | positive a => exact hE a
    | negative a => exact hF a
  have hq : Function.Surjective (quotient order) := Submodule.Quotient.mk_surjective _
  ext x
  obtain ⟨y, rfl⟩ := hq x
  exact DFunLike.congr_fun heq y

end UniversalProperty

private def chevalleyHom : M →ₗ⁅ℝ⁆ M :=
  lift order (-cartan order) (f order) (e order)
    (by intro h k; simp [cartan_commute])
    (by intro h a; simp [cartan_lie_f, neg_smul])
    (by intro h a; simp [cartan_lie_e, neg_smul])
    (by
      intro a b
      rw [← lie_skew, lie_e_f]
      by_cases hab : a = b
      · subst b; simp
      · simp [hab, Ne.symm hab])
    (serre_f order) (serre_e order)

@[simp] private theorem chevalleyHom_e (a : Option J) :
    chevalleyHom order (e order a) = f order a := lift_e ..

@[simp] private theorem chevalleyHom_f (a : Option J) :
    chevalleyHom order (f order a) = e order a := lift_f ..

@[simp] private theorem chevalleyHom_cartan (h : CartanCoordinates) :
    chevalleyHom order (cartan order h) = -cartan order h := lift_cartan ..

private theorem chevalleyHom_involutive : Function.Involutive (chevalleyHom order) := by
  have h : (chevalleyHom order).comp (chevalleyHom order) = LieHom.id := by
    apply hom_ext order <;> intro a <;> simp
  exact DFunLike.congr_fun h

/-- The Chevalley equivalence interchanges the two sets of simple generators
and acts by negation on the Cartan. -/
def chevalley : M ≃ₗ⁅ℝ⁆ M :=
  { (chevalleyHom order).toLinearMap with
    invFun := chevalleyHom order
    left_inv := chevalleyHom_involutive order
    right_inv := chevalleyHom_involutive order
    map_lie' := fun {x y} => (chevalleyHom order).map_lie x y }

@[simp] theorem chevalley_e (a : Option J) :
    chevalley order (e order a) = f order a := chevalleyHom_e order a

@[simp] theorem chevalley_f (a : Option J) :
    chevalley order (f order a) = e order a := chevalleyHom_f order a

@[simp] theorem chevalley_cartan (h : CartanCoordinates) :
    chevalley order (cartan order h) = -cartan order h := chevalleyHom_cartan order h

theorem chevalley_involutive : Function.Involutive (chevalley order) :=
  chevalleyHom_involutive order

end D5.S3.VertexAlgebra.MonsterRankTwoPresentation
