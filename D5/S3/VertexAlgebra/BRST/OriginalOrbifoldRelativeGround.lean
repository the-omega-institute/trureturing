/-! At hyperbolic half-norm one the native relative shell has zero excitation
cutoff. Its generator is the actual orbifold vacuum, the charge ground
monomial, and the native ghost ket at site 1. -/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

noncomputable section

open scoped TensorProduct

namespace D5.S3.VertexAlgebra.OriginalOrbifoldRelativeGround

open OriginalOrbifoldCriticalMatter OriginalOrbifoldBRSTZeroEnergy
open OriginalOrbifoldRelativeMassShell
open LatticeGeneratingFieldLocality (Charge)
open LatticePositiveEnergy (chargeEnergy oscillatorEnergy oscillatorEnergy_eq_zero_iff
  carrierBasis_apply)
open D5.S3.Quantum.Fermionic
open BcGhostRelativeEnergy (level)
open CountableOccupationFock (ket)
open private fullBasis_apply orbifoldMode_basis from
  D5.S3.VertexAlgebra.BRST.OriginalOrbifoldBRSTZeroEnergy
open private number_ket from D5.S3.Quantum.Fermionic.BcGhostCharge

local instance : AddCommGroup State := TensorProduct.addCommGroup (M := Matter)

private abbrev UCharge := Charge hyperbolicData

/-- The original orbifold vacuum tensor the unexcited momentum monomial
and the relative bc ket `c 1 vacuum = ket {1}`. -/
def groundState (a : UCharge) : State :=
  (orbifoldVertexAlgebra.vacuum ⊗ₜ[ℂ] Finsupp.single a (MvPolynomial.monomial 0 1))
    ⊗ₜ[ℂ] ket {1}

/-- At half-norm one the basis labels in the actual shell have weight zero,
the prescribed charge with zero oscillator exponent, and only ghost site 1. -/
theorem allowedLabels_iff (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1)
    (i : FullLabel) :
    i ∈ allowedLabels a ↔
      i.1.1 = 0 ∧ i.2.1.1 = a ∧ i.2.1.2 = 0 ∧ i.2.2 = {1} := by
  change (i.2.1.1 = a ∧ 3 ∉ i.2.2 ∧
    ((i.1.1 + oscillatorEnergy i.2.1.2 + level i.2.2 : ℕ) : ℤ) =
      1 - chargeEnergy hyperbolicData a) ↔ _
  rw [ha, sub_self]
  constructor
  · rintro ⟨hm, hb, hcut⟩
    have hweight : i.1.1 = 0 := by omega
    have hosc : oscillatorEnergy i.2.1.2 = 0 := by omega
    have hghost : level i.2.2 = 0 := by omega
    have he := (BcGhostRelativeEnergy.level_cast i.2.2).symm
    rw [hghost, Nat.cast_zero] at he
    exact ⟨hweight, hm, (oscillatorEnergy_eq_zero_iff _ _).mp hosc,
      (LatticeZeroMomentumBRST.ghost_level_zero_iff _ hb).mp he⟩
  · rintro ⟨hweight, hm, hosc, hghost⟩
    refine ⟨hm, by simp [hghost], ?_⟩
    have he := (oscillatorEnergy_eq_zero_iff _ _).mpr hosc
    simp [hweight, he, hghost, BcGhostRelativeEnergy.level]

private theorem orbifold_eigenspace_zero :
    (orbifoldMode 0).eigenspace 0 = Submodule.span ℂ {orbifoldVertexAlgebra.vacuum} :=
  TwistedGround.OriginalOrbifoldLowSpectrum.actual_leech_low_spectrum.2.2.2.2.2.2

private def weightZeroLabel : OrbifoldLabel :=
  ⟨0, ⟨0, by
    change 0 < Module.finrank ℂ ((orbifoldMode 0).eigenspace ((0 : ℕ) : ℂ))
    have hr : Module.finrank ℂ ((orbifoldMode 0).eigenspace 0) = 1 :=
      TwistedGround.OriginalOrbifoldLowSpectrum.actual_leech_low_spectrum.2.2.2.1
    rw [Nat.cast_zero, hr]
    exact Nat.zero_lt_one⟩⟩

private theorem basisAtGround_mem_line (a : UCharge) (i : FullLabel)
    (hweight : i.1.1 = 0) (hm : i.2.1.1 = a) (hosc : i.2.1.2 = 0)
    (hghost : i.2.2 = {1}) :
    fullBasis i ∈ Submodule.span ℂ {groundState a} := by
  have horb : orbifoldBasis i.1 ∈ (orbifoldMode 0).eigenspace 0 := by
    apply Module.End.mem_eigenspace_iff.mpr
    simpa only [hweight, Nat.cast_zero] using orbifoldMode_basis i.1
  rw [orbifold_eigenspace_zero] at horb
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp horb
  apply Submodule.mem_span_singleton.mpr
  exact ⟨c, by
    rw [fullBasis_apply, carrierBasis_apply, ← hc, hm, hosc, hghost, groundState,
      TensorProduct.smul_tmul', TensorProduct.smul_tmul']⟩

private def groundLabel (a : UCharge) : FullLabel :=
  (weightZeroLabel, (a, 0), {1})

theorem groundState_ne_zero (a : UCharge) : groundState a ≠ 0 := by
  let i := groundLabel a
  have hi := basisAtGround_mem_line a i rfl rfl rfl rfl
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hi
  intro hz
  exact fullBasis.ne_zero i (by simpa only [hz, smul_zero] using hc.symm)

/-- The simultaneous momentum, b₀, and total L₀ conditions give exactly the
line generated by the original ground tensor. -/
theorem relativeMassShell_eq_groundLine (a : UCharge)
    (ha : chargeEnergy hyperbolicData a = 1) :
    relativeMassShell a = Submodule.span ℂ {groundState a} := by
  rw [relativeMassShell_eq_span]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    obtain ⟨hw, hm, ho, hg⟩ := (allowedLabels_iff a ha i).mp hi
    exact basisAtGround_mem_line a i hw hm ho hg
  · apply Submodule.span_le.mpr
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    let i := groundLabel a
    have hi : i ∈ allowedLabels a := (allowedLabels_iff a ha i).mpr ⟨rfl, rfl, rfl, rfl⟩
    have hmem := Submodule.subset_span (R := ℂ) (s := fullBasis '' allowedLabels a)
      (Set.mem_image_of_mem fullBasis hi)
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (basisAtGround_mem_line a i rfl rfl rfl rfl)
    have hc0 : c ≠ 0 := by
      intro hz
      exact fullBasis.ne_zero i (by simpa only [hz, zero_smul] using hc.symm)
    change groundState a ∈ Submodule.span ℂ (fullBasis '' allowedLabels a)
    simpa only [← hc, smul_smul, inv_mul_cancel₀ hc0, one_smul] using
      (Submodule.span ℂ (fullBasis '' allowedLabels a)).smul_mem c⁻¹ hmem

theorem groundState_mem (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1) :
    groundState a ∈ relativeMassShell a := by
  rw [relativeMassShell_eq_groundLine a ha]
  exact Submodule.subset_span (Set.mem_singleton _)

/-- The native ghost-number operator is the identity on the entire shell. -/
theorem ghostNumber_on_shell (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1)
    {x : State} (hx : x ∈ relativeMassShell a) :
    BcGhostChargeTensor.number (M := Matter) x = x := by
  have hg : BcGhostChargeTensor.number (M := Matter) (groundState a) = groundState a := by
    norm_num [groundState, BcGhostChargeTensor.liftGhost, TensorProduct.map_tmul,
      number_ket, BcGhostCharge.charge, Finset.filter_singleton]
  rw [relativeMassShell_eq_groundLine a ha] at hx
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hx
  rw [map_smul, hg]

/-- Nilpotence forces the native differential to vanish on the ground line. -/
theorem Q_on_shell (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1)
    {x : State} (hx : x ∈ relativeMassShell a) : Q x = 0 := by
  have hQ := Q_mem_relativeMassShell a (groundState_mem a ha)
  rw [relativeMassShell_eq_groundLine a ha] at hQ hx
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hQ
  have hsq : Q (Q (groundState a)) = 0 := by
    simpa only [pow_two, Module.End.mul_apply, LinearMap.zero_apply] using
      LinearMap.congr_fun Q_squared (groundState a)
  rw [← hc, map_smul, ← hc, smul_smul] at hsq
  have hcc : c * c = 0 := (smul_eq_zero.mp hsq).resolve_right (groundState_ne_zero a)
  have hc0 : c = 0 := (mul_eq_zero.mp hcc).elim id id
  obtain ⟨z, rfl⟩ := Submodule.mem_span_singleton.mp hx
  rw [map_smul, ← hc, hc0, zero_smul, smul_zero]

theorem differential_eq_zero (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1) :
    differential a = 0 := by
  apply LinearMap.ext
  intro x
  exact Subtype.ext (Q_on_shell a ha x.property)

open D5.S3.HomologicalAlgebra.FinitePerturbation (Boundaries boundaryMap)

private theorem differential_mul_self (a : UCharge) : differential a * differential a = 0 := by
  simpa only [pow_two] using differential_squared a

/-- The kernel of the native shell differential modulo its actual image in the kernel. -/
abbrev Cohomology (a : UCharge) :=
  D5.S3.HomologicalAlgebra.FinitePerturbation.Cohomology
    (differential a) (differential_mul_self a)

private theorem boundaries_eq_bot (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1) :
    Boundaries (differential a) (differential_mul_self a) = ⊥ := by
  apply LinearMap.range_eq_bot.mpr
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  change differential a x = 0
  rw [differential_eq_zero a ha, LinearMap.zero_apply]

/-- Since all shell states are cycles and the only boundary is zero, the
cohomology class determines a unique shell state. -/
def cohomologyEquivShell (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1) :
    Cohomology a ≃ₗ[ℂ] relativeMassShell a :=
  ((Boundaries (differential a) (differential_mul_self a)).quotEquivOfEqBot
    (boundaries_eq_bot a ha)).trans
      ((LinearEquiv.ofEq _ _ (LinearMap.ker_eq_top.mpr (differential_eq_zero a ha))).trans
        Submodule.topEquiv)

/-- The class of the displayed ground tensor under the original relative differential. -/
def groundClass (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1) : Cohomology a :=
  (Boundaries (differential a) (differential_mul_self a)).mkQ
    ⟨⟨groundState a, groundState_mem a ha⟩,
      LinearMap.mem_ker.mpr (by rw [differential_eq_zero a ha, LinearMap.zero_apply])⟩

theorem cohomologyEquivShell_groundClass (a : UCharge)
    (ha : chargeEnergy hyperbolicData a = 1) :
    cohomologyEquivShell a ha (groundClass a ha) = ⟨groundState a, groundState_mem a ha⟩ := by
  apply Subtype.ext
  simp [cohomologyEquivShell, groundClass]

theorem groundClass_ne_zero (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1) :
    groundClass a ha ≠ 0 := by
  intro hz
  have he : (⟨groundState a, groundState_mem a ha⟩ : relativeMassShell a) = 0 :=
    (cohomologyEquivShell_groundClass a ha).symm.trans
      ((congrArg (cohomologyEquivShell a ha) hz).trans (cohomologyEquivShell a ha).map_zero)
  exact groundState_ne_zero a (congrArg (fun x : relativeMassShell a => (x : State)) he)

theorem cohomology_finrank_one (a : UCharge) (ha : chargeEnergy hyperbolicData a = 1) :
    Module.finrank ℂ (Cohomology a) = 1 := by
  rw [(cohomologyEquivShell a ha).finrank_eq, relativeMassShell_eq_groundLine a ha]
  exact finrank_span_singleton (groundState_ne_zero a)

theorem oneOne_chargeEnergy : chargeEnergy hyperbolicData (fun _ => 1) = 1 := by
  rw [hyperbolic_chargeEnergy, one_mul]

theorem oneOne_relativeGround :
    Module.finrank ℂ (Cohomology (fun _ => 1)) = 1 ∧
      groundClass (fun _ => 1) oneOne_chargeEnergy ≠ 0 :=
  ⟨cohomology_finrank_one _ oneOne_chargeEnergy, groundClass_ne_zero _ oneOne_chargeEnergy⟩

