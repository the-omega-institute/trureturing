/-- Actual source products, with the original integer indexing. -/
abbrev sourceProduct (D : LatticeData) (a : Carrier D) (n : ℤ)
    (b : Carrier D) : Carrier D := ((Y D a)[[n]]) b

def jacobiLeft {D : LatticeData} {M : Type u} [AddCommGroup M] [Module ℂ M]
    (F : Carrier D →ₗ[ℂ] VertexOperator ℂ M)
    (a b : Carrier D) (w : M) (p q r : ℤ) (i : ℕ) : M :=
  integerBinomial p i • ((F (sourceProduct D a (r + i) b))[[p + q - i]]) w

def jacobiFirst {D : LatticeData} {M : Type u} [AddCommGroup M] [Module ℂ M]
    (F : Carrier D →ₗ[ℂ] VertexOperator ℂ M)
    (a b : Carrier D) (w : M) (p q r : ℤ) (i : ℕ) : M :=
  (((-1 : ℂ)^i) * integerBinomial r i) •
    ((F a)[[p + r - i]]) (((F b)[[q + i]]) w)

def jacobiSecond {D : LatticeData} {M : Type u} [AddCommGroup M] [Module ℂ M]
    (F : Carrier D →ₗ[ℂ] VertexOperator ℂ M)
    (a b : Carrier D) (w : M) (p q r : ℤ) (i : ℕ) : M :=
  (((-1 : ℂ)^i) * integerBinomial r i) •
    (StateFieldResidueReconstruction.epsilon r • ((F b)[[q + r - i]]) (((F a)[[p + i]]) w))

/-- Full untwisted mixed module Jacobi, using actual source Y. Truncation is
part of `VertexOperator` (a linear map to Laurent series), not a CCR axiom.
In particular translation, source products, degree, nilpotence and any Fock
equivalence are absent from the fields of this record. -/
structure FullJacobiLatticeModule (D : LatticeData) (M : Type u)
    [AddCommGroup M] [Module ℂ M] where
  stateField : Carrier D →ₗ[ℂ] VertexOperator ℂ M
  vacuum_field : stateField (vacuum D) = identityField
  borcherds : ∀ (a b : Carrier D) (w : M) (p q r : ℤ),
    Function.HasFiniteSupport (jacobiLeft stateField a b w p q r) ∧
    Function.HasFiniteSupport (jacobiFirst stateField a b w p q r) ∧
    Function.HasFiniteSupport (jacobiSecond stateField a b w p q r) ∧
      (∑ᶠ i : ℕ, jacobiLeft stateField a b w p q r i) =
        ∑ᶠ i : ℕ, (((-1 : ℂ)^i) * integerBinomial r i) •
          (((stateField a)[[p + r - i]]) (((stateField b)[[q + i]]) w) -
            StateFieldResidueReconstruction.epsilon r • ((stateField b)[[q + r - i]])
              (((stateField a)[[p + i]]) w))

variable {D : LatticeData} {M : Type u} [AddCommGroup M] [Module ℂ M]

abbrev mode (J : FullJacobiLatticeModule D M) (a : Carrier D) (n : ℤ) :
    Module.End ℂ M := (J.stateField a)[[n]]

private theorem identity_modes (n : ℤ) :
    ((identityField : VertexOperator ℂ M)[[n]]) =
      if n = -1 then LinearMap.id else 0 := by
  rw [identityField, VertexOperator.ncoeff_of_coeff]
  simp only [show -n - 1 = 0 ↔ n = -1 by omega]

theorem vacuum_modes (J : FullJacobiLatticeModule D M) (n : ℤ) :
    mode J (vacuum D) n = if n = -1 then LinearMap.id else 0 := by
  rw [mode, J.vacuum_field, identity_modes]

/-- Honest field truncation for each state and input vector. -/
theorem module_truncation (J : FullJacobiLatticeModule D M)
    (a : Carrier D) (w : M) :
    ∃ N : ℤ, ∀ n : ℤ, N ≤ n → mode J a n w = 0 := by
  refine ⟨-((HahnModule.of ℂ).symm (J.stateField a w)).order, ?_⟩
  intro n hn
  apply VertexOperator.ncoeff_eq_zero_of_lt_order
  omega

def commutatorTerm (J : FullJacobiLatticeModule D M)
    (a b : Carrier D) (p q : ℤ) (i : ℕ) : Module.End ℂ M :=
  integerBinomial p i • mode J (sourceProduct D a i b) (p + q - i)

/-- Source field truncation, before evaluation or binomial weighting, makes
the endomorphism-valued sum finite even when p is negative. -/
theorem commutator_terms_finite (J : FullJacobiLatticeModule D M)
    (a b : Carrier D) (p q : ℤ) :
    Function.HasFiniteSupport (commutatorTerm J a b p q) := by
  classical
  apply (LatticeActualStateFieldCalculus.nonnegative_products_finite D a b).subset
  intro i member
  contrapose! member
  have zeroState : sourceProduct D a i b = 0 := by
    simpa only [Function.mem_support, not_not, LatticeAllStateReconstruction.mu]
      using member
  simp [commutatorTerm, zeroState, mode]

/-- The r=0 specialization of full mixed Jacobi on arbitrary M. -/
theorem module_mode_commutator (J : FullJacobiLatticeModule D M)
    (a b : Carrier D) (p q : ℤ) :
    mode J a p * mode J b q - mode J b q * mode J a p =
      ∑ᶠ i : ℕ, commutatorTerm J a b p q i := by
  classical
  apply LinearMap.ext
  intro w
  obtain ⟨leftFinite, firstFinite, secondFinite, h⟩ := J.borcherds a b w p q 0
  have right : (∑ᶠ i : ℕ,
      (((-1 : ℂ)^i) * integerBinomial 0 i) •
        (mode J a (p + 0 - i) (mode J b (q + i) w) -
          StateFieldResidueReconstruction.epsilon 0 • mode J b (q + 0 - i) (mode J a (p + i) w))) =
      mode J a p (mode J b q w) - mode J b q (mode J a p w) := by
    rw [finsum_eq_single _ 0]
    · simp [integerBinomial, StateFieldResidueReconstruction.epsilon]
    · intro i different
      simp [integerBinomial, Ring.choose_zero_pos ℤ (Nat.pos_of_ne_zero different)]
  rw [right] at h
  have evaluation : (∑ᶠ i : ℕ, commutatorTerm J a b p q i) w =
      ∑ᶠ i : ℕ, jacobiLeft J.stateField a b w p q 0 i := by
    change (LinearMap.applyₗ w) (∑ᶠ i : ℕ, commutatorTerm J a b p q i) = _
    rw [map_finsum (LinearMap.applyₗ w) (commutator_terms_finite J a b p q)]
    apply finsum_congr
    intro i
    simp only [commutatorTerm, jacobiLeft, zero_add,
      LinearMap.applyₗ_apply_apply, LinearMap.smul_apply]
  rw [evaluation]
  exact h.symm

/-- The p=0 specialization. Separate finite supports are retained before
splitting the right-hand finsum; StateFieldResidueReconstruction.epsilon uses the original integer power. -/
theorem module_iterate (J : FullJacobiLatticeModule D M)
    (a b : Carrier D) (w : M) (r q : ℤ) :
    Function.HasFiniteSupport (jacobiFirst J.stateField a b w 0 q r) ∧
    Function.HasFiniteSupport (jacobiSecond J.stateField a b w 0 q r) ∧
      mode J (sourceProduct D a r b) q w =
        (∑ᶠ i : ℕ, jacobiFirst J.stateField a b w 0 q r i) -
        (∑ᶠ i : ℕ, jacobiSecond J.stateField a b w 0 q r i) := by
  classical
  obtain ⟨leftFinite, firstFinite, secondFinite, h⟩ := J.borcherds a b w 0 q r
  refine ⟨firstFinite, secondFinite, ?_⟩
  have left : (∑ᶠ i : ℕ, jacobiLeft J.stateField a b w 0 q r i) =
      mode J (sourceProduct D a r b) q w := by
    rw [finsum_eq_single _ 0]
    · simp [jacobiLeft, integerBinomial]
    · intro i different
      simp [jacobiLeft, integerBinomial,
        Ring.choose_zero_pos ℤ (Nat.pos_of_ne_zero different)]
  rw [left] at h
  simp_rw [smul_sub] at h
  change _ = ∑ᶠ i : ℕ, (jacobiFirst J.stateField a b w 0 q r i -
    jacobiSecond J.stateField a b w 0 q r i) at h
  rw [finsum_sub_distrib firstFinite secondFinite] at h
  exact h

private theorem minus_two_weight (i : ℕ) :
    (-1 : ℂ)^i * integerBinomial (-2) i = (i + 1 : ℂ) := by
  have choose : integerBinomial (-2) i = (-1 : ℂ)^i * (i + 1 : ℂ) := by
    unfold integerBinomial
    rw [show (-2 : ℤ) = -(2 : ℤ) by norm_num, Ring.choose_neg,
      show (2 : ℤ) + i - 1 = ((i + 1 : ℕ) : ℤ) by omega,
      Ring.choose_natCast, Nat.choose_succ_self_right]
    simp only [Units.smul_def, smul_eq_mul, Int.cast_mul,
      Int.cast_negOnePow_natCast, Int.cast_natCast, Nat.cast_add, Nat.cast_one]
    simp only [Int.cast_add, Int.cast_natCast, Int.cast_one]
  have square : (-1 : ℂ)^i * (-1 : ℂ)^i = 1 := by
    rw [← pow_add, ← two_mul, pow_mul]
    norm_num
  rw [choose, ← mul_assoc, square, one_mul]

/-- Module translation is DERIVED from p=0, r=-2, b=vacuum. This is the
field of the actual source translation, not an assumed operator on M. -/
theorem module_translation_modes (J : FullJacobiLatticeModule D M)
    (a : Carrier D) (q : ℤ) :
    mode J (translation D a) q = -(q : ℂ) • mode J a (q - 1) := by
  classical
  apply LinearMap.ext
  intro w
  obtain ⟨firstFinite, secondFinite, h⟩ := module_iterate J a (vacuum D) w (-2) q
  dsimp only [jacobiFirst, jacobiSecond, sourceProduct] at h
  simp only [zero_add] at h
  rw [J.vacuum_field] at h
  simp_rw [minus_two_weight] at h
  simp only [show StateFieldResidueReconstruction.epsilon (-2) = 1 by norm_num [StateFieldResidueReconstruction.epsilon], one_smul] at h
  rw [← LatticeActualVertexAlgebra.translation_as_mode D a] at h
  let left (i : ℕ) : M := (i + 1 : ℂ) •
    mode J a (-2 - i) (((identityField : VertexOperator ℂ M)[[q + i]]) w)
  let right (i : ℕ) : M := (i + 1 : ℂ) •
    ((identityField : VertexOperator ℂ M)[[q - 2 - i]]) (mode J a i w)
  change mode J (translation D a) q w =
    (∑ᶠ i : ℕ, left i) - (∑ᶠ i : ℕ, right i) at h
  rcases lt_trichotomy q 0 with negative | zero | positive
  · have rightZero : ∀ i : ℕ, right i = 0 := by
      intro i
      simp [right, identity_modes, show q - 2 - (i : ℤ) ≠ -1 by omega]
    simp only [rightZero, finsum_zero, sub_zero] at h
    let k : ℕ := (-q - 1).toNat
    have index : q + (k : ℤ) = -1 := by dsimp [k]; omega
    have modeIndex : (-2 : ℤ) - k = q - 1 := by dsimp [k]; omega
    have scalar : (k + 1 : ℂ) = -(q : ℂ) := by
      exact_mod_cast (show (k : ℤ) + 1 = -q by dsimp [k]; omega)
    have leftSum : (∑ᶠ i : ℕ, left i) = -(q : ℂ) • mode J a (q - 1) w := by
      rw [finsum_eq_single _ k]
      · simp only [left, identity_modes, if_pos index, LinearMap.id_apply,
          modeIndex, scalar]
      · intro i different
        simp [left, identity_modes,
          show q + (i : ℤ) ≠ -1 by dsimp [k] at different; omega]
    rw [leftSum] at h
    simpa only [LinearMap.smul_apply] using h
  · subst q
    have leftZero : ∀ i : ℕ, left i = 0 := by
      intro i
      simp [left, identity_modes, show (0 : ℤ) + i ≠ -1 by omega]
    have rightZero : ∀ i : ℕ, right i = 0 := by
      intro i
      simp [right, identity_modes, show (-2 : ℤ) - i ≠ -1 by omega]
    simpa only [leftZero, rightZero, finsum_zero, sub_self, Int.cast_zero,
      neg_zero, zero_smul, LinearMap.smul_apply, LinearMap.zero_apply] using h
  · have leftZero : ∀ i : ℕ, left i = 0 := by
      intro i
      simp [left, identity_modes, show q + (i : ℤ) ≠ -1 by omega]
    simp only [leftZero, finsum_zero, zero_sub] at h
    let k : ℕ := (q - 1).toNat
    have index : q - 2 - (k : ℤ) = -1 := by dsimp [k]; omega
    have modeIndex : (k : ℤ) = q - 1 := by dsimp [k]; omega
    have scalar : (k + 1 : ℂ) = (q : ℂ) := by
      exact_mod_cast (show (k : ℤ) + 1 = q by dsimp [k]; omega)
    have rightSum : (∑ᶠ i : ℕ, right i) = (q : ℂ) • mode J a (q - 1) w := by
      rw [finsum_eq_single _ k]
      · simp only [right, identity_modes, if_pos index, LinearMap.id_apply]
        rw [modeIndex, scalar]
      · intro i different
        simp [right, identity_modes,
          show q - 2 - (i : ℤ) ≠ -1 by dsimp [k] at different; omega]
    rw [rightSum] at h
    change _ = -(q : ℂ) • mode J a (q - 1) w
    simpa only [neg_smul] using h

/-- Actual current state, rather than a new abstract Heisenberg generator. -/
def currentState (D : LatticeData) (i : Fin D.rank) : Carrier D :=
  ((neutralField D i)[[-1]]) (vacuum D)

theorem current_state_field (D : LatticeData) (i : Fin D.rank) :
    Y D (currentState D i) = neutralField D i := stateField_current D i

/-- Creativity for the actual current, inherited from the full source Y. -/
theorem source_current_vacuum (D : LatticeData) (i : Fin D.rank)
    (n : ℤ) (hn : 0 ≤ n) : neutralMode D i n (vacuum D) = 0 := by
  have h := stateField_creativity D (currentState D i) n hn
  rw [current_state_field, neutralField_ncoeff] at h
  exact h

/-- Source nonnegative current products are computed using the ACTUAL
source neutral commutator at (k,-1) and source creativity. -/
theorem source_current_product (D : LatticeData) (i j : Fin D.rank) (k : ℕ) :
    sourceProduct D (currentState D i) k (currentState D j) =
      if k = 1 then (D.G i j : ℂ) • vacuum D else 0 := by
  classical
  have h := congrArg (fun A : Module.End ℂ (Carrier D) => A (vacuum D))
    (neutralMode_heisenberg D i j (k : ℤ) (-1))
  simp only [LinearMap.sub_apply, Module.End.mul_apply, LinearMap.smul_apply,
    Module.End.one_apply, source_current_vacuum D i k (Int.natCast_nonneg k),
    map_zero, sub_zero] at h
  have creationState : neutralMode D j (-1) (vacuum D) = currentState D j := by
    rw [currentState, neutralField_ncoeff]
  rw [creationState] at h
  rw [sourceProduct, current_state_field, neutralField_ncoeff]
  by_cases hk : k = 1
  · subst k
    simpa using h
  · have index : (k : ℤ) + -1 ≠ 0 := by omega
    simpa [hk, index] using h

abbrev current (J : FullJacobiLatticeModule D M) (i : Fin D.rank) (n : ℤ) :
    Module.End ℂ M := mode J (currentState D i) n

/-- Arbitrary-M all-integer current Heisenberg relation. Only the k=1
actual source product survives the mixed Jacobi commutator. -/
theorem module_current_heisenberg (J : FullJacobiLatticeModule D M)
    (i j : Fin D.rank) (m n : ℤ) :
    current J i m * current J j n - current J j n * current J i m =
      (if m + n = 0 then (m : ℂ) * (D.G i j : ℂ) else 0) •
        (1 : Module.End ℂ M) := by
  classical
  rw [module_mode_commutator]
  have finite := commutator_terms_finite J (currentState D i) (currentState D j) m n
  rw [finsum_eq_single _ 1]
  · simp only [commutatorTerm, source_current_product, ite_true,
      integerBinomial, Ring.choose_one_right]
    simp only [mode, map_smul, Pi.smul_apply]
    change (m : ℂ) • ((D.G i j : ℂ) • mode J (vacuum D) (m + n - 1)) = _
    rw [vacuum_modes]
    by_cases hmn : m + n = 0
    · simp [hmn, show m + n - 1 = -1 by omega, smul_smul, Module.End.one_eq_id]
    · simp [hmn, show m + n - 1 ≠ -1 by omega]
  · intro k hk
    simp [commutatorTerm, source_current_product, hk, mode]

private theorem smul_commutator_left (c : ℂ) (A B : Module.End ℂ M) :
    (c • A) * B - B * (c • A) = c • (A * B - B * A) := by
  rw [smul_mul_assoc, mul_smul_comm, smul_sub]

private theorem smul_commutator_right (c : ℂ) (A B : Module.End ℂ M) :
    A * (c • B) - (c • B) * A = c • (A * B - B * A) := by
  rw [smul_mul_assoc, mul_smul_comm, smul_sub]

private theorem sum_commutator_left (A : Fin D.rank → Module.End ℂ M)
    (B : Module.End ℂ M) :
    (∑ i, A i) * B - B * (∑ i, A i) = ∑ i, (A i * B - B * A i) := by
  rw [Finset.sum_mul, Finset.mul_sum, Finset.sum_sub_distrib]

private theorem sum_commutator_right (A : Module.End ℂ M)
    (B : Fin D.rank → Module.End ℂ M) :
    A * (∑ i, B i) - (∑ i, B i) * A = ∑ i, (A * B i - B i * A) := by
  rw [Finset.sum_mul, Finset.mul_sum, Finset.sum_sub_distrib]

/-- Row convention: the free index is the FIRST index of H. -/
def rowMode (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ) (i : Fin D.rank) (n : ℤ) :
    Module.End ℂ M := ∑ j, H i j • current J j n

def creation (J : FullJacobiLatticeModule D M) (i : Fin D.rank) (r : ℕ) :
    Module.End ℂ M := current J i (-(r : ℤ) - 1)

def annihilation (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ) (i : Fin D.rank) (r : ℕ) :
    Module.End ℂ M := (r + 1 : ℂ)⁻¹ • rowMode J H i ((r : ℤ) + 1)

theorem row_current_commutator (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ)
    (i k : Fin D.rank) (m n : ℤ) :
    rowMode J H i m * current J k n - current J k n * rowMode J H i m =
      (if m + n = 0 then (m : ℂ) * (H * gramComplex D) i k else 0) •
        (1 : Module.End ℂ M) := by
  classical
  rw [rowMode, sum_commutator_left]
  simp_rw [smul_commutator_left, module_current_heisenberg]
  by_cases h : m + n = 0
  · simp only [if_pos h, smul_smul]
    rw [← Finset.sum_smul]
    congr 1
    simp only [Matrix.mul_apply, gramComplex, Matrix.map_apply, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j hj
    ring
  · simp [h]

theorem normalized_XX (J : FullJacobiLatticeModule D M)
    (i j : Fin D.rank) (r s : ℕ) : Commute (creation J i r) (creation J j s) := by
  apply sub_eq_zero.mp
  have h := module_current_heisenberg J i j (-(r : ℤ) - 1) (-(s : ℤ) - 1)
  simpa [creation, show -(r : ℤ) - 1 + (-(s : ℤ) - 1) ≠ 0 by omega] using h

theorem normalized_DD (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ)
    (i j : Fin D.rank) (r s : ℕ) :
    Commute (annihilation J H i r) (annihilation J H j s) := by
  apply sub_eq_zero.mp
  unfold annihilation
  rw [smul_commutator_left, smul_commutator_right]
  have h : rowMode J H i ((r : ℤ) + 1) * rowMode J H j ((s : ℤ) + 1) -
      rowMode J H j ((s : ℤ) + 1) * rowMode J H i ((r : ℤ) + 1) = 0 := by
    change rowMode J H i ((r : ℤ) + 1) *
      (∑ k, H j k • current J k ((s : ℤ) + 1)) -
      (∑ k, H j k • current J k ((s : ℤ) + 1)) * rowMode J H i ((r : ℤ) + 1) = 0
    rw [sum_commutator_right]
    simp_rw [smul_commutator_right, row_current_commutator]
    simp [show (r : ℤ) + 1 + ((s : ℤ) + 1) ≠ 0 by omega]
  rw [h, smul_zero, smul_zero]

/-- HG, in precisely that orientation, contracts the row-normalized DX. -/
theorem normalized_DX (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ) (hHG : H * gramComplex D = 1)
    (i k : Fin D.rank) (r s : ℕ) :
    annihilation J H i r * creation J k s -
      creation J k s * annihilation J H i r =
        (if r = s then (if i = k then (1 : ℂ) else 0) else 0) •
          (1 : Module.End ℂ M) := by
  classical
  rw [annihilation, creation, smul_commutator_left, row_current_commutator, hHG]
  have frequency : (r : ℤ) + 1 + (-(s : ℤ) - 1) = 0 ↔ r = s := by omega
  have nonzero : (r + 1 : ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero r
  simp only [frequency, Matrix.one_apply]
  by_cases hrs : r = s
  · subst s
    by_cases hik : i = k <;>
      simp [hik, smul_smul, Int.cast_add, Int.cast_natCast, nonzero]
  · simp [hrs]

/-- The opposite inverse orientation GH reconstructs each positive current. -/
theorem gram_rowMode (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ) (hGH : gramComplex D * H = 1)
    (j : Fin D.rank) (n : ℤ) :
    (∑ i, gramComplex D j i • rowMode J H i n) = current J j n := by
  classical
  have contract (k : Fin D.rank) :
      (∑ i, gramComplex D j i * H i k) = if j = k then 1 else 0 := by
    simpa only [Matrix.mul_apply, Matrix.one_apply] using
      congrArg (fun A : Matrix (Fin D.rank) (Fin D.rank) ℂ => A j k) hGH
  simp only [rowMode, Finset.smul_sum, smul_smul]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_smul, contract]
  simp [eq_comm]

theorem positive_current_from_normalized (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ) (hGH : gramComplex D * H = 1)
    (j : Fin D.rank) (r : ℕ) :
    (r + 1 : ℂ) • (∑ i, gramComplex D j i • annihilation J H i r) =
      current J j ((r : ℤ) + 1) := by
  classical
  have nonzero : (r + 1 : ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero r
  unfold annihilation
  rw [Finset.smul_sum]
  have term (i : Fin D.rank) :
      (r + 1 : ℂ) • (gramComplex D j i •
        ((r + 1 : ℂ)⁻¹ • rowMode J H i ((r : ℤ) + 1))) =
      gramComplex D j i • rowMode J H i ((r : ℤ) + 1) := by
    rw [smul_comm (r + 1 : ℂ) (gramComplex D j i),
      smul_smul (r + 1 : ℂ) ((r + 1 : ℂ)⁻¹)
        (rowMode J H i ((r : ℤ) + 1)),
      mul_inv_cancel₀ nonzero, one_smul]
  simp_rw [term]
  exact gram_rowMode J H hGH j ((r : ℤ) + 1)

/-- No zero-mode condition occurs in either vacuum-kernel description. -/
theorem normalized_vacuum_iff (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ) (hGH : gramComplex D * H = 1)
    (w : M) :
    (∀ (i : Fin D.rank) (r : ℕ), annihilation J H i r w = 0) ↔
      (∀ (j : Fin D.rank) (n : ℤ), 0 < n → current J j n w = 0) := by
  classical
  constructor
  · intro hw j n hn
    let r : ℕ := (n - 1).toNat
    have index : n = (r : ℤ) + 1 := by dsimp [r]; omega
    rw [index, ← positive_current_from_normalized J H hGH j r]
    simp only [LinearMap.smul_apply, LinearMap.sum_apply, hw, smul_zero,
      Finset.sum_const_zero]
  · intro hw i r
    simp [annihilation, rowMode, hw, show (0 : ℤ) < (r : ℤ) + 1 by omega]

/-- A vector-dependent cutoff extracted from the actual Laurent series. -/
def currentCutoff (J : FullJacobiLatticeModule D M) (i : Fin D.rank) (w : M) : ℕ :=
  (-((HahnModule.of ℂ).symm (J.stateField (currentState D i) w)).order).toNat

theorem current_vanish_above_cutoff (J : FullJacobiLatticeModule D M)
    (i : Fin D.rank) (w : M) (r : ℕ) (hr : currentCutoff J i w ≤ r) :
    current J i ((r : ℤ) + 1) w = 0 := by
  apply VertexOperator.ncoeff_eq_zero_of_lt_order
  dsimp only [currentCutoff] at hr
  omega

/-- Finset.sup on the empty rank-zero set is zero. -/
def activeBound (J : FullJacobiLatticeModule D M) (w : M) : ℕ :=
  Finset.univ.sup (fun i : Fin D.rank => currentCutoff J i w)

theorem annihilation_vanish_above_bound (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ)
    (i : Fin D.rank) (w : M) (r : ℕ) (hr : activeBound J w ≤ r) :
    annihilation J H i r w = 0 := by
  classical
  have vanish (j : Fin D.rank) : current J j ((r : ℤ) + 1) w = 0 := by
    apply current_vanish_above_cutoff
    exact le_trans (Finset.le_sup (f := fun j => currentCutoff J j w) (Finset.mem_univ j)) hr
  simp [annihilation, rowMode, vanish]

/-- Truncation plus finite original rank gives finite active support; no
grading, positivity or local-nilpotence hypothesis is used. -/
theorem finite_active_support (J : FullJacobiLatticeModule D M)
    (H : Matrix (Fin D.rank) (Fin D.rank) ℂ) (w : M) :
    Function.HasFiniteSupport
      (fun x : Fin D.rank × ℕ => annihilation J H x.1 x.2 w) := by
  classical
  apply (Finset.univ ×ˢ Finset.range (activeBound J w)).finite_toSet.subset
  intro x member
  by_contra outside
  have large : activeBound J w ≤ x.2 := by
    simpa only [Finset.mem_coe, Finset.mem_product, Finset.mem_univ,
      true_and, Finset.mem_range, not_lt] using outside
  exact member (annihilation_vanish_above_bound J H x.1 w x.2 large)

/- Remaining conformal/reconstruction boundary (no declarations assumed):
For the actual omega D H, derive omega_0 h_i = T h_i and omega_1 h_i = h_i
from the actual conformal suppliers, then use the m=1 module commutator and
module_translation_modes to derive [omega^M_1,a_i(n)] = -n a_i(n).
Local nilpotence additionally requires a genuine algebraic lower-bounded
grading linked to that actual omega^M_1 (or generalized weight spaces).
Its finite-component decomposition and degree shifts must prove that every
annihilation power eventually kills each vector. Truncation above establishes
finite active support only. No Fock reconstruction or module classification
is claimed in this file. -/

end
