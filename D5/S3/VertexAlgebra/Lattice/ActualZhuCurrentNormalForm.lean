/- GID: D5/S3/VertexAlgebra/Lattice/ActualZhuCurrentNormalForm
   generality: I
   mirror-B: D5/B/S3/VertexAlgebra/Lattice/ActualZhuCurrentNormalForm
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: All-charge right-current oscillator normal form in the literal quotient. -/
/-
Dong--Li--Mason, DOI 10.1006/jabr.1997.7112, Theorem 3.4 and Remark 2.11.
The ambient Zhu algebra is not asserted commutative. Only the subalgebra
generated by the neutral currents receives a commutative ring structure.
-/
import D5.S3.VertexAlgebra.Lattice.ActualZhuOscillator

/-! Source normal form, using the native direct ground/right-current relation. -/
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace D5.S3.VertexAlgebra.Lattice.ActualZhuCurrentNormalForm
open LatticeGeneratingFieldLocality LatticeFiniteNegativeGeneration
open LatticeAllStateField LatticeAllStateReconstruction
open LatticeSugawaraConformal LatticeSugawaraCurrents
open LatticeActualConformalState LatticePositiveEnergy
open ActualZhuProduct ActualZhuFinite ActualZhuAlgebra ActualZhuGroundCurrent
open ActualZhuOscillator
open scoped BigOperators VertexOperator
noncomputable section

variable (D : LatticeData)

def H (i : Fin D.rank) : Q D := (zhuO D).mkQ (currentState D i)
def E (δ : Charge D) : Q D := (zhuO D).mkQ (Finsupp.single δ 1)

variable [hD : Fact (Matrix.PosDef (D.G.map (Int.cast : ℤ → ℝ)))]
local instance : Ring (Q D) := quotientRing D hD.out
local instance : Algebra ℂ (Q D) := quotientAlgebra D hD.out

/-- Exact left-current action on an arbitrary charge-sector polynomial. -/
theorem oscillator_left_current (δ : Charge D) (i : Fin D.rank) (p : Oscillator D) :
    (zhuO D).mkQ (Finsupp.single δ (MvPolynomial.X (i,0) * p)) =
      H D i * (zhuO D).mkQ (Finsupp.single δ p) -
        (bilinear D (unitCharge D i) δ : ℂ) • (zhuO D).mkQ (Finsupp.single δ p) := by
  have he := congrArg (zhuO D).mkQ (current_star_single D δ i p)
  change H D i * (zhuO D).mkQ (Finsupp.single δ p) = _ at he
  rw [map_add, map_smul] at he
  simp only [neutralMode_single, neutralPolynomialMode, show (-1 : ℤ) < 0 by omega,
    ite_eq_left, show (-(-1 : ℤ)-1).toNat = 0 by norm_num, LinearMap.mulLeft_apply] at he
  rw [he]
  abel

/-- Direct ground transport extends to every oscillator tail, without skew symmetry. -/
theorem oscillator_right_current (δ : Charge D) (i : Fin D.rank) (p : Oscillator D) :
    (zhuO D).mkQ (Finsupp.single δ p) * H D i =
      (zhuO D).mkQ (Finsupp.single δ (MvPolynomial.X (i,0) * p)) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C c =>
    have hg := ground_right_current D δ i hD.out
    change E D δ * H D i = _ at hg
    simpa [MvPolynomial.C_eq_smul_one, ← Finsupp.smul_single, map_smul,
      smul_mul_assoc, mul_smul_comm, E, neutralMode_single, neutralPolynomialMode] using
      congrArg (fun x : Q D => c • x) hg
  | add p q hp hq =>
    simp only [mul_add, Finsupp.single_add, map_add, add_mul, hp, hq]
  | mul_X p x hp =>
    obtain ⟨j,n⟩ := x
    have hn := oscillator_variable_class D hD.out δ j n p
    have hn' := oscillator_variable_class D hD.out δ j n (MvPolynomial.X (i,0) * p)
    rw [mul_comm p (MvPolynomial.X (j,n)), hn, smul_mul_assoc,
      oscillator_left_current D δ j p, sub_mul, mul_assoc, smul_mul_assoc, hp,
      ← oscillator_left_current D δ j (MvPolynomial.X (i,0) * p)]
    rw [mul_comm (MvPolynomial.X (i,0)) (MvPolynomial.X (j,n) * p),
      mul_assoc, mul_comm p (MvPolynomial.X (i,0)), ← mul_assoc, hn', mul_assoc]

/-- The generators of the neutral-current subalgebra commute in the literal quotient. -/
theorem currents_commute (i j : Fin D.rank) : Commute (H D i) (H D j) := by
  change H D i * H D j = H D j * H D i
  have hi := oscillator_right_current D 0 i (MvPolynomial.X (j,0))
  have hj := oscillator_right_current D 0 j (MvPolynomial.X (i,0))
  change H D j * H D i = _ at hi
  change H D i * H D j = _ at hj
  rw [hi, hj, mul_comm (MvPolynomial.X (i,0))]

/-- Only the current subalgebra is commutative. -/
def currentAlgebra : Subalgebra ℂ (Q D) := Algebra.adjoin ℂ (Set.range (H D))

local instance : IsMulCommutative (currentAlgebra D) :=
  Algebra.isMulCommutative_adjoin ℂ (by
    rintro _ ⟨i,rfl⟩ _ ⟨j,rfl⟩ _
    exact currents_commute D i j)
open scoped IsMulCommutative

def currentGenerator (i : Fin D.rank) : currentAlgebra D :=
  ⟨H D i, Algebra.subset_adjoin (Set.mem_range_self i)⟩

/-- Evaluation remembers the physical (-1)^n normalization of h_i(-n-1). -/
def oscillatorEvaluation : Oscillator D →ₐ[ℂ] currentAlgebra D :=
  MvPolynomial.aeval fun x : Index D => (-1 : ℂ)^x.2 • currentGenerator D x.1

/-- Full oscillator normal form, with the charged ground class on the left. -/
theorem oscillator_normal_form (δ : Charge D) (p : Oscillator D) :
    (zhuO D).mkQ (Finsupp.single δ p) =
      E D δ * (oscillatorEvaluation D p : Q D) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C c =>
    simp [oscillatorEvaluation, E, MvPolynomial.C_eq_smul_one,
      ← Finsupp.smul_single, map_smul]
  | add p q hp hq =>
    simp only [Finsupp.single_add, map_add, Subalgebra.coe_add, mul_add, hp, hq]
  | mul_X p x hp =>
    obtain ⟨i,n⟩ := x
    rw [mul_comm p (MvPolynomial.X (i,n)), oscillator_variable_class D hD.out δ i n p,
      ← oscillator_right_current D δ i p, hp]
    simp only [oscillatorEvaluation, map_mul, MvPolynomial.aeval_X,
      Subalgebra.coe_mul, Subalgebra.coe_smul, smul_mul_assoc, mul_smul_comm, mul_assoc]
    congr 1
    exact congrArg (fun x : currentAlgebra D => E D δ * (x : Q D))
      (mul_comm (MvPolynomial.aeval (fun x : Index D =>
        (-1 : ℂ)^x.2 • currentGenerator D x.1) p) (currentGenerator D i))

#print axioms oscillator_right_current
#print axioms oscillator_normal_form
end
end D5.S3.VertexAlgebra.Lattice.ActualZhuCurrentNormalForm
