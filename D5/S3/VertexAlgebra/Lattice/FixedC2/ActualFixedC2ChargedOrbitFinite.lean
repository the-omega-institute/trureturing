import D5.S3.VertexAlgebra.Lattice.FixedC2.ActualFixedC2ChargedFinite
import D5.S3.VertexAlgebra.Lattice.FixedC2.ActualFixedC2ChargedOrbit

set_option autoImplicit false

namespace D5.S3.VertexAlgebra.Lattice.ActualFixedC2

open ActualLeechHyperbolic (leechData)
open LatticeGeneratingFieldLocality LatticeInvolution

noncomputable section

local instance (D : LatticeData) : AddCommGroup (FixedCarrier D) :=
  (fixedSpace D).addCommGroup

/-- Every fixed state on a nonzero Leech charge orbit has class in the neutral
module generated by the ground and the first oscillator classes. -/
theorem leech_charged_orbit_image_le_single_span (c : Charge leechData) (hc : c ≠ 0) :
    (fixedChargeOrbit leechData c).map (fixedC2 leechData).mkQ ≤ leechChargedSingleSpan c := by
  apply Submodule.map_le_iff_le_comap.mpr
  refine fixed_charge_orbit_le_of_ground_and_singles leechData c _
    (leech_charged_ground_class_mem c) (leech_charged_oscillator_class_mem c hc) ?_
  intro x y v hv
  exact leech_charged_single_span_mode_mem c
    (neutral_pair_class_mem_neutral_image leechData x.1 y.1 x.2 y.2) hv

/-- The image of each nonzero fixed Leech charge orbit in the intrinsic C₂
quotient is finite dimensional. -/
theorem leech_fixed_charge_orbit_image_finite (c : Charge leechData) (hc : c ≠ 0) :
    FiniteDimensional ℂ ((fixedChargeOrbit leechData c).map (fixedC2 leechData).mkQ) := by
  let : FiniteDimensional ℂ (leechChargedSingleSpan c) := leech_charged_single_span_finite c
  exact FiniteDimensional.of_injective _
    (Submodule.inclusion_injective (leech_charged_orbit_image_le_single_span c hc))

#print axioms leech_charged_orbit_image_le_single_span
#print axioms leech_fixed_charge_orbit_image_finite

end
end D5.S3.VertexAlgebra.Lattice.ActualFixedC2
