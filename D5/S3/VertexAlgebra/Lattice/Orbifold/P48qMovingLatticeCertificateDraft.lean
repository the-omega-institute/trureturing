private def U : Matrix48 := fun i j => (UData.getD i.val #[]).getD j.val 0
private def V : Matrix48 := fun i j => (VData.getD i.val #[]).getD j.val 0
private def E : Matrix48 := fun i j => (EData.getD i.val #[]).getD j.val 0

private def normEntry (i j : Fin 48) : ℤ :=
  (if i = j then 1 else 0) + A i j + nebeSquare i j

private theorem normEntry_matrix : (normEntry : Matrix48) = N := by
  apply Matrix.ext
  intro i j
  simp only [norm, normEntry, pow_two, nebeSquare_eq, Matrix.add_apply, Matrix.one_apply]

private def certificateRow (i : Fin 48) : List ℤ :=
  List.ofFn fun j : Fin 48 =>
    (List.zipWith (· * ·) (List.ofFn (U i)) (List.ofFn fun k : Fin 48 => B k j)).sum +
    (List.zipWith (· * ·) (List.ofFn (normEntry i)) (List.ofFn fun k : Fin 48 => V k j)).sum +
    (3 : ℤ) • E i j

-- Each row checks both products using integer list dot products.
set_option maxRecDepth 4096 in
set_option maxHeartbeats 12000000 in
-- Kernel reduction checks two length-48 dot products at each of 48 × 48 entries.
private theorem certificateRows (i : Fin 48) :
    certificateRow i = List.ofFn ((1 : Matrix48) i) := by
  fin_cases i <;> decide +kernel

private theorem certificate_identity : (1 : Matrix48) = U * B + N * V + (3 : ℤ) • E := by
  apply Matrix.ext
  intro i j
  rw [Matrix.add_apply, Matrix.add_apply, Matrix.smul_apply,
    Matrix.mul_apply (M := U), Matrix.mul_apply (M := N),
    ← normEntry_matrix]
  simpa only [certificateRow, dotOfFn_eq]
    using congrFun (List.ofFn_injective (certificateRows i)).symm j

private theorem difference_mul_norm : B * N = 0 := by
  have hCube : A * A ^ 2 = 1 := by
    simpa only [pow_one] using (pow_add A 1 2).symm.trans nebeOrderThree_cube
  simp only [norm, sub_mul, one_mul, mul_add, mul_one, ← pow_two, hCube]
  abel

private theorem correction_mul_difference : C * B = (3 : ℤ) • (1 : Matrix48) - N := by
  simp only [norm, mul_sub, add_mul, Matrix.smul_mul, one_mul, mul_one, ← pow_two]
  abel

/-- Integral exactness at the middle term in the original Nebe row coordinates. -/
public theorem nebeOrderThree_moving_exact :
    ∀ x : Fin 48 → ℤ,
      x ᵥ* (1 + A + A ^ 2) = 0 ↔ ∃ y : Fin 48 → ℤ, y ᵥ* (1 - A) = x := by
  change ∀ x : Fin 48 → ℤ, x ᵥ* N = 0 ↔ ∃ y : Fin 48 → ℤ, y ᵥ* B = x
  intro x
  constructor
  · intro hx
    have hrow : x = (x ᵥ* U) ᵥ* B + (3 : ℤ) • (x ᵥ* E) := by
      simpa only [Matrix.vecMul_one, Matrix.vecMul_add, ← Matrix.vecMul_vecMul,
        Matrix.vecMul_smul, hx, Matrix.zero_vecMul, add_zero] using
        congrArg (fun M : Matrix48 => x ᵥ* M) certificate_identity
    have hE3 : (3 : ℤ) • ((x ᵥ* E) ᵥ* N) = 0 := calc
      _ = ((x ᵥ* U) ᵥ* B + (3 : ℤ) • (x ᵥ* E)) ᵥ* N := by
        rw [Matrix.add_vecMul, Matrix.vecMul_vecMul (x ᵥ* U) B N, difference_mul_norm,
          Matrix.vecMul_zero, Matrix.smul_vecMul, zero_add]
      _ = 0 := by rw [← hrow, hx]
    have hE : (x ᵥ* E) ᵥ* N = 0 := by
      funext j
      have hj : (3 : ℤ) * (((x ᵥ* E) ᵥ* N) j) = 0 := by
        simpa only [Pi.smul_apply, Int.zsmul_eq_mul, Pi.zero_apply] using congrFun hE3 j
      exact (mul_eq_zero.mp hj).resolve_left (by decide)
    refine ⟨x ᵥ* U + (x ᵥ* E) ᵥ* C, ?_⟩
    rw [Matrix.add_vecMul, Matrix.vecMul_vecMul (x ᵥ* E) C B, correction_mul_difference,
      Matrix.vecMul_sub ((3 : ℤ) • (1 : Matrix48)) N (x ᵥ* E),
      hE, sub_zero, Matrix.vecMul_smul, Matrix.vecMul_one]
    exact hrow.symm
  · rintro ⟨y, rfl⟩
    rw [Matrix.vecMul_vecMul, difference_mul_norm, Matrix.vecMul_zero]

#print axioms nebeOrderThree_moving_exact

end P48qMovingLatticeCertificateDraft
