/-- The catalogue Gram matrix in the listed basis. -/
def p48pGram : Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j => (gramData.getD i.val #[]).getD j.val 0

/-- The 48 norm-twelve frame vectors, in the original row coordinates. -/
def p48pFrameRows : Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j => (frameRowsData.getD i.val #[]).getD j.val 0

/-- The columns of the pairing matrix, in the frame's encounter order. -/
def p48pPairingFrame : Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j => (pairingFrameData.getD i.val #[]).getD j.val 0

theorem p48pGram_transpose : p48pGramᵀ = p48pGram := by
  apply Matrix.ext
  intro i
  have h : List.ofFn (p48pGramᵀ i) = List.ofFn (p48pGram i) := by
    fin_cases i <;> decide +kernel
  exact congrFun (List.ofFn_injective h)

theorem p48pGram_even_diagonal (i : Fin 48) : Even (p48pGram i i) := by
  refine ⟨p48pGram i i / 2, ?_⟩
  fin_cases i <;> decide +kernel

/-- The rank-48 lattice data in the Nebe–Sloane catalogue basis. -/
def p48pCatalogueData : LatticeData where
  rank := 48
  G := p48pGram
  symmetric i j := congrFun (congrFun p48pGram_transpose j) i
  even_diagonal := p48pGram_even_diagonal

/-- The listed columns are the Gram pairings with the frame rows. -/
theorem p48pPairingFrame_eq : p48pPairingFrame = p48pGram * p48pFrameRowsᵀ := by
  symm
  apply mul_eq_of_dotProductRows
  intro i
  fin_cases i <;> decide +kernel

/-- The frame rows have norm twelve and are pairwise orthogonal. -/
theorem p48pFrameRows_orthogonal :
    p48pFrameRows * p48pGram * p48pFrameRowsᵀ = (12 : ℤ) • 1 := by
  rw [Matrix.mul_assoc, ← p48pPairingFrame_eq]
  apply mul_eq_of_dotProductRows
  intro i
  fin_cases i <;> decide +kernel

/-- The frame pairings give the norm-twelve identity in the catalogue basis. -/
theorem p48pPairingFrame_mul_transpose :
    p48pPairingFrame * p48pPairingFrameᵀ = (12 : ℤ) • p48pGram := by
  apply mul_eq_of_dotProductRows
  intro i
  fin_cases i <;> decide +kernel

/-- All columns of the pairing matrix agree modulo two. -/
theorem p48pPairingFrame_columns_same_parity (i j k : Fin 48) :
    (p48pPairingFrame i j : ZMod 2) = (p48pPairingFrame i k : ZMod 2) := by
  have h : List.ofFn (fun l : Fin 48 => p48pPairingFrame i l % 2) =
      List.ofFn (fun _ : Fin 48 => p48pPairingFrame i 0 % 2) := by
    fin_cases i <;> decide +kernel
  have hRow := List.ofFn_injective h
  exact (ZMod.intCast_eq_intCast_iff' _ _ 2).2
    ((congrFun hRow j).trans (congrFun hRow k).symm)

/-- Injectivity of the concrete syndrome on words of Hamming weight at most
three excludes vectors of norm two in the catalogue P48p lattice. -/
theorem p48p_catalogue_rootless
    (hInjective : Set.InjOn (ternarySyndrome p48pPairingFrame) {u | hammingNorm u ≤ 3})
    (x : Charge p48pCatalogueData) : bilinear p48pCatalogueData x x ≠ 2 := by
  refine bilinear_ne_two_of_short_syndrome_injective p48pCatalogueData p48pPairingFrame
    p48pPairingFrame_mul_transpose p48pPairingFrame_columns_same_parity ?_ hInjective x
  simpa only [Fintype.card_fin] using (by decide : 24 < 48)

