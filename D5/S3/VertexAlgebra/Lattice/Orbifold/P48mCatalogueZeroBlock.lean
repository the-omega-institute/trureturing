private def catalogueRows : Array (Array (Array ℤ)) :=
  #[generator1Rows, generator2Rows, generator3Rows, generator4Rows, generator5Rows, generator6Rows]

private def catalogueRow (g : Fin 6) (i : ℕ) : Array ℤ :=
  (catalogueRows.getD g.val #[]).getD i #[]

/-- The catalogue matrices in the order given by the source. -/
def catalogueGenerator (g : Fin 6) : Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j => (catalogueRow g i.val).getD j.val 0

set_option maxHeartbeats 3000000 in
-- Each decision compares the 32 trailing row slices of a single generator
-- with the list of zero slices. Each slice has exactly 16 entries.
private theorem catalogue_zero_slices (g : Fin 6) :
    (List.ofFn fun i : Fin 32 => (catalogueRow g i.val).toList.drop 32) =
      List.ofFn (fun _ : Fin 32 => List.replicate 16 (0 : ℤ)) := by
  fin_cases g <;> decide +kernel

/-- The upper-right 32-by-16 block of every catalogue generator is zero. -/
theorem catalogue_upper_right (g : Fin 6) (i j : Fin 48)
    (hi : i.val < 32) (hj : 32 ≤ j.val) :
    catalogueGenerator g i j = 0 := by
  have hRow : (catalogueRow g i.val).toList.drop 32 = List.replicate 16 (0 : ℤ) :=
    congrFun (List.ofFn_injective (catalogue_zero_slices g)) (⟨i.val, hi⟩ : Fin 32)
  have hjlt : j.val < 48 := j.isLt
  have hk : j.val - 32 < 16 := by omega
  have hadd : 32 + (j.val - 32) = j.val := by omega
  have hEntry :
      ((catalogueRow g i.val).toList.drop 32)[j.val - 32]? =
        (List.replicate 16 (0 : ℤ))[j.val - 32]? :=
    congrArg (fun xs : List ℤ => xs[j.val - 32]?) hRow
  rw [List.getElem?_drop, List.getElem?_replicate_of_lt hk, hadd,
    Array.getElem?_toList] at hEntry
  change (catalogueRow g i.val).getD j.val 0 = 0
  simp only [Array.getD_eq_getD_getElem?, hEntry, Option.getD_some]

/-- Rational row vectors supported on the first 32 coordinates. -/
def rowBlock : Submodule ℚ (Fin 48 → ℚ) where
  carrier := {v | ∀ j : Fin 48, 32 ≤ j.val → v j = 0}
  zero_mem' := by
    intro j hj
    rfl
  add_mem' := by
    intro u v hu hv j hj
    change u j + v j = 0
    rw [hu j hj, hv j hj, add_zero]
  smul_mem' := by
    intro a v hv j hj
    change a • v j = 0
    rw [hv j hj, smul_zero]

/-- In every rational matrix representation sending the specified six group
elements to the catalogue matrices, their generated subgroup preserves the
proper nonzero rational subspace of row vectors supported on coordinates 0–31. -/
theorem exists_invariant_block {G : Type*} [Group G]
    (ρ : G →* Matrix (Fin 48) (Fin 48) ℚ) (g : Fin 6 → G)
    (hCatalogue : ∀ j, ρ (g j) = (Int.castRingHom ℚ).mapMatrix (catalogueGenerator j)) :
    ∃ W : Submodule ℚ (Fin 48 → ℚ), W ≠ ⊥ ∧ W ≠ ⊤ ∧
      ∀ h ∈ Subgroup.closure (Set.range g), ∀ v ∈ W, v ᵥ* ρ h ∈ W := by
  refine ⟨rowBlock, ?_, ?_, ?_⟩
  · intro hBot
    let e : Fin 48 → ℚ := Pi.single (0 : Fin 48) 1
    have he : e ∈ rowBlock := by
      intro j hj
      have hj0 : j ≠ 0 := by
        intro h
        subst j
        change 32 ≤ 0 at hj
        omega
      simp [e, Pi.single_apply, hj0, Ne.symm hj0]
    rw [hBot, Submodule.mem_bot] at he
    have hz : e 0 = 0 := congrFun he 0
    simp [e] at hz
  · intro hTop
    let e : Fin 48 → ℚ := Pi.single (32 : Fin 48) 1
    have he : e ∈ rowBlock := by
      rw [hTop]
      exact Submodule.mem_top
    have hz : e 32 = 0 := he 32 (by decide)
    simp [e] at hz
  · intro h hGenerated
    refine Subgroup.closure_induction
      (p := fun k _ => ∀ v ∈ rowBlock, v ᵥ* ρ k ∈ rowBlock) ?_ ?_ ?_ ?_ hGenerated
    · rintro _ ⟨a, rfl⟩ v hv j hj
      rw [Matrix.vecMul_apply_eq_sum]
      apply Finset.sum_eq_zero
      intro i hi
      by_cases hil : i.val < 32
      · rw [hCatalogue]
        change v i * (↑(catalogueGenerator a i j) : ℚ) = 0
        rw [catalogue_upper_right a i j hil hj, Int.cast_zero, mul_zero]
      · rw [hv i (Nat.le_of_not_gt hil), zero_mul]
    · intro v hv
      simpa only [map_one, Matrix.vecMul_one] using hv
    · intro x y _ _ hx hy v hv
      rw [map_mul, ← Matrix.vecMul_vecMul]
      exact hy _ (hx _ hv)
    · intro x _ hx v hv
      -- Right multiplication by an invertible matrix restricts to an injective
      -- endomorphism of the finite-dimensional row subspace, hence is onto.
      let f : rowBlock →ₗ[ℚ] rowBlock := (ρ x).vecMulLinear.restrict hx
      have hCancel (w : Fin 48 → ℚ) : (w ᵥ* ρ x) ᵥ* ρ x⁻¹ = w := by
        rw [Matrix.vecMul_vecMul, ← map_mul, mul_inv_cancel, map_one, Matrix.vecMul_one]
      have hf : Function.Injective f := by
        intro a b hab
        apply Subtype.ext
        have hab' : (a : Fin 48 → ℚ) ᵥ* ρ x = (b : Fin 48 → ℚ) ᵥ* ρ x :=
          congrArg Subtype.val hab
        simpa only [hCancel] using congrArg (fun w : Fin 48 → ℚ => w ᵥ* ρ x⁻¹) hab'
      obtain ⟨u, hu⟩ := LinearMap.surjective_of_injective hf ⟨v, hv⟩
      have hu' : (u : Fin 48 → ℚ) ᵥ* ρ x = v := congrArg Subtype.val hu
      have huv : v ᵥ* ρ x⁻¹ = (u : Fin 48 → ℚ) := by
        rw [← hu', hCancel]
      rw [huv]
      exact u.property

#print axioms catalogue_upper_right
#print axioms exists_invariant_block

end D5.S3.VertexAlgebra.Lattice.Orbifold.P48mCatalogueZeroBlock
