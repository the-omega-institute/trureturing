private def changeOfBasis : Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j => if i ≤ j then (changeOfBasisColumns.getD j.val #[]).getD i.val 0 else 0

private theorem changeOfBasis_upper : changeOfBasis.IsUpperTriangular := by
  intro i j hij
  change j < i at hij
  simp only [changeOfBasis, if_neg (not_le_of_gt hij)]

private theorem changeOfBasis_diag_pos (i : Fin 48) : 0 < changeOfBasis i i := by
  fin_cases i <;> decide +kernel

private theorem gram_symmetric : nebeGram.IsSymm :=
  Matrix.IsSymm.ext fun i j => nebeLatticeData.symmetric j i

private def productEntry (i j : Fin 48) : ℤ :=
  (List.ofFn fun k : Fin 48 => nebeGram i k * changeOfBasis k j).sum

private theorem productEntry_eq (i j : Fin 48) :
    productEntry i j = (nebeGram * changeOfBasis) i j := by
  rw [productEntry, List.sum_ofFn, Matrix.mul_apply]

private theorem product_lower : (nebeGram * changeOfBasis).IsLowerTriangular := by
  have rows (i : Fin 48) :
      (List.ofFn fun j : Fin 48 => if i < j then productEntry i j else 0) =
        List.ofFn (fun _ : Fin 48 => (0 : ℤ)) := by
    fin_cases i <;> decide +kernel
  intro i j hij
  change i < j at hij
  have h := congrFun (List.ofFn_injective (rows i)) j
  simpa only [if_pos hij, productEntry_eq] using h

private theorem product_diag_pos (i : Fin 48) : 0 < productEntry i i := by
  fin_cases i <;> decide +kernel

/-- Nebe's actual P48q Gram matrix is positive definite over the reals. -/
theorem nebeGram_posDef : Matrix.PosDef (nebeGram.map (Int.cast : ℤ → ℝ)) := by
  refine posDef_intCast_of_triangular nebeGram changeOfBasis gram_symmetric changeOfBasis_upper
    product_lower changeOfBasis_diag_pos fun i => ?_
  rw [← productEntry_eq]
  exact product_diag_pos i

#print axioms posDef_intCast_of_triangular
#print axioms nebeGram_posDef

end D5.S3.VertexAlgebra.Lattice.Orbifold.P48qGramPositivity
