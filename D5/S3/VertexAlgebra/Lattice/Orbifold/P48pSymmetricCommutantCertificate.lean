def commutantM : Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j => (commutantData.getD i.val #[]).getD j.val 0

set_option maxHeartbeats 6000000 in
/-- The integer matrix has diagonal entries ±23 and off-diagonal entries in
`{0, ±2}`.  Its exact replay hash is recorded in the worker envelope. -/
theorem commutantM_symmetric : commutantMᵀ = commutantM := by
  apply Matrix.ext
  intro i
  have h : List.ofFn (commutantMᵀ i) = List.ofFn (commutantM i) := by
    fin_cases i <;> decide +kernel
  exact congrFun (List.ofFn_injective h)

set_option maxHeartbeats 6000000 in
/-- Scoped component check for the quadratic generator. -/
theorem commutantM_sq : commutantM * commutantM = (621 : ℤ) • 1 := by
  apply mul_eq_of_dotProductRows
  intro i
  fin_cases i <;> decide +kernel

/- The four orbit matrices are kept in their sparse signed-orbit form.  The
   constructor mirrors each upper-triangular signed entry and leaves all other
   coordinates zero. -/
private def signedOrbitMatrix (entries : List ((Nat × Nat) × ℤ)) :
    Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j =>
    let value : ℤ := entries.foldl (fun acc entry =>
      if (entry.1.1 = i.val ∧ entry.1.2 = j.val) ∨
          (entry.1.1 = j.val ∧ entry.1.2 = i.val) then entry.2 else acc) 0
    value

