def J : Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j => (jData.getD i.val #[]).getD j.val 0


/- The four symmetric orbit averages are stored in the frame coordinate basis.
   `J` is the reduced skew generator, so the catalogue's first reduced
   average is recovered by `Z1 = 2 J - 6 I`. -/

theorem orbitB0_symmetric : B0ᵀ = B0 := by
  apply Matrix.ext
  intro i
  fin_cases i <;> decide +kernel

theorem orbitB1_symmetric : B1ᵀ = B1 := by
  apply Matrix.ext
  intro i
  fin_cases i <;> decide +kernel

theorem orbitB16_symmetric : B16ᵀ = B16 := by
  apply Matrix.ext
  intro i
  fin_cases i <;> decide +kernel

theorem orbitB11_symmetric : B11ᵀ = B11 := by
  apply Matrix.ext
  intro i
  fin_cases i <;> decide +kernel

set_option maxHeartbeats 6000000 in
theorem J_transpose : Jᵀ = -J := by
  apply Matrix.ext
  intro i
  have h : List.ofFn (Jᵀ i) = List.ofFn ((-J) i) := by
    fin_cases i <;> decide +kernel
  exact congrFun (List.ofFn_injective h)

set_option maxHeartbeats 6000000 in
theorem J_sq : J * J = (-27 : ℤ) • 1 := by
  apply mul_eq_of_dotProductRows
  intro i
  fin_cases i <;> decide +kernel

def Z1 : Matrix (Fin 48) (Fin 48) ℤ :=
  (2 : ℤ) • J - (6 : ℤ) • (1 : Matrix (Fin 48) (Fin 48) ℤ)

theorem Z1_eq_twoJ_sub_sixI : Z1 =
    (2 : ℤ) • J - (6 : ℤ) • (1 : Matrix (Fin 48) (Fin 48) ℤ) := rfl

theorem Z1_transpose : Z1ᵀ =
    (-6 : ℤ) • (1 : Matrix (Fin 48) (Fin 48) ℤ) - (2 : ℤ) • J := by
  rw [Z1, Matrix.transpose_sub, Matrix.transpose_smul, Matrix.transpose_one,
    J_transpose]
  module

def Z2 : Matrix (Fin 48) (Fin 48) ℤ := Z1ᵀ

theorem Z2_eq_neg_sixI_sub_twoJ : Z2 =
    (-6 : ℤ) • (1 : Matrix (Fin 48) (Fin 48) ℤ) - (2 : ℤ) • J :=
  Z1_transpose

/- Exact reduced-z identities for the four consistent pair orbits. -/
theorem orbit_average_B0 :
    (27 : ℤ) • B0 - J * B0 * J =
      (27 : ℤ) • (1 : Matrix (Fin 48) (Fin 48) ℤ) + commutantM := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> decide +kernel

theorem orbit_average_B1 :
    (27 : ℤ) • B1 - J * B1 * J = (4 : ℤ) • commutantM := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> decide +kernel

theorem orbit_average_B16 :
    (27 : ℤ) • B16 - J * B16 * J = 0 := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> decide +kernel

theorem orbit_average_B11 :
    (27 : ℤ) • B11 - J * B11 * J =
      (27 : ℤ) • (1 : Matrix (Fin 48) (Fin 48) ℤ) - commutantM := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> decide +kernel

/- The frame-coordinate signed maps lift to integral maps in the catalogue
   basis.  The divisor is part of the exact reconstruction formula. -/
def catalogueFrameMap (O : Matrix (Fin 48) (Fin 48) ℤ) (n : ℤ) :
    Matrix (Fin 48) (Fin 48) ℤ :=
  fun i j =>
    (p48pGram * p48pFrameRowsᵀ * O * p48pFrameRows) i j / (12 * n)

def tCatalogueMap : Matrix (Fin 48) (Fin 48) ℤ :=
  catalogueFrameMap tFrameMatrix 1

def uCatalogueMap : Matrix (Fin 48) (Fin 48) ℤ :=
  catalogueFrameMap uFrameMatrix 1

def zCatalogueMap : Matrix (Fin 48) (Fin 48) ℤ :=
  catalogueFrameMap Z1 12

set_option maxRecDepth 32768 in
set_option maxHeartbeats 160000000 in
theorem tCatalogueMap_isometry :
    tCatalogueMap * p48pGram * tCatalogueMapᵀ = p48pGram := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> decide +kernel

set_option maxRecDepth 32768 in
set_option maxHeartbeats 160000000 in
theorem uCatalogueMap_isometry :
    uCatalogueMap * p48pGram * uCatalogueMapᵀ = p48pGram := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> decide +kernel

set_option maxRecDepth 32768 in
set_option maxHeartbeats 160000000 in
theorem zCatalogueMap_isometry :
    zCatalogueMap * p48pGram * zCatalogueMapᵀ = p48pGram := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> decide +kernel

private def ratCast : Matrix (Fin 48) (Fin 48) ℤ →+*
    Matrix (Fin 48) (Fin 48) ℚ :=
  (Int.castRingHom ℚ).mapMatrix

private theorem ratCast_smul (n : ℤ) (A : Matrix (Fin 48) (Fin 48) ℤ) :
    ratCast (n • A) = (n : ℚ) • ratCast A := by
  rw [map_zsmul, Int.cast_smul_eq_zsmul]

def B0Rat : Matrix (Fin 48) (Fin 48) ℚ := ratCast B0
def B1Rat : Matrix (Fin 48) (Fin 48) ℚ := ratCast B1
def B16Rat : Matrix (Fin 48) (Fin 48) ℚ := ratCast B16
def B11Rat : Matrix (Fin 48) (Fin 48) ℚ := ratCast B11
def JRat : Matrix (Fin 48) (Fin 48) ℚ := ratCast J
def commutantMRat : Matrix (Fin 48) (Fin 48) ℚ := ratCast commutantM

theorem orbit_average_B0_rat :
    (27 : ℚ) • B0Rat - JRat * B0Rat * JRat =
      (27 : ℚ) • (1 : Matrix (Fin 48) (Fin 48) ℚ) + commutantMRat := by
  simpa only [map_add, map_sub, map_mul, map_one, ratCast_smul] using
    congrArg ratCast orbit_average_B0

theorem orbit_average_B1_rat :
    (27 : ℚ) • B1Rat - JRat * B1Rat * JRat =
      (4 : ℚ) • commutantMRat := by
  simpa only [map_sub, map_mul, map_zero, ratCast_smul] using
    congrArg ratCast orbit_average_B1

theorem orbit_average_B16_rat :
    (27 : ℚ) • B16Rat - JRat * B16Rat * JRat = 0 := by
  simpa only [map_sub, map_mul, map_zero, ratCast_smul] using
    congrArg ratCast orbit_average_B16

theorem orbit_average_B11_rat :
    (27 : ℚ) • B11Rat - JRat * B11Rat * JRat =
      (27 : ℚ) • (1 : Matrix (Fin 48) (Fin 48) ℚ) - commutantMRat := by
  simpa only [map_add, map_sub, map_mul, map_one, ratCast_smul] using
    congrArg ratCast orbit_average_B11

theorem J_sq_rat : JRat * JRat = (-27 : ℚ) • 1 := by
  simpa only [map_mul, ratCast_smul, map_one] using congrArg ratCast J_sq

def reducedZ (A : Matrix (Fin 48) (Fin 48) ℚ) : Matrix (Fin 48) (Fin 48) ℚ :=
  (27 : ℚ) • A - JRat * A * JRat

private theorem reducedZ_add (A B : Matrix (Fin 48) (Fin 48) ℚ) :
    reducedZ (A + B) = reducedZ A + reducedZ B := by
  simp [reducedZ, Matrix.mul_add, Matrix.add_mul, sub_eq_add_neg]

private theorem reducedZ_smul (a : ℚ) (A : Matrix (Fin 48) (Fin 48) ℚ) :
    reducedZ (a • A) = a • reducedZ A := by
  simp only [reducedZ, Matrix.smul_mul, Matrix.mul_smul, smul_sub, smul_smul]
  module

theorem rational_symmetric_commutant_span
    (a0 a1 a16 a11 : ℚ) (B : Matrix (Fin 48) (Fin 48) ℚ)
    (hB : B = a0 • B0Rat + a1 • B1Rat + a16 • B16Rat + a11 • B11Rat)
    (hcomm : B * JRat = JRat * B) :
    ∃ x y : ℚ, B = x • (1 : Matrix (Fin 48) (Fin 48) ℚ) + y • commutantMRat := by
  have hL : reducedZ B =
      (27 * (a0 + a11)) • (1 : Matrix (Fin 48) (Fin 48) ℚ) +
        (a0 + 4 * a1 - a11) • commutantMRat := by
    rw [hB, reducedZ_add, reducedZ_add, reducedZ_add]
    rw [reducedZ_smul, reducedZ_smul, reducedZ_smul, reducedZ_smul]
    rw [show reducedZ B0Rat =
        (27 : ℚ) • (1 : Matrix (Fin 48) (Fin 48) ℚ) + commutantMRat by
          exact orbit_average_B0_rat]
    rw [show reducedZ B1Rat = (4 : ℚ) • commutantMRat by
          exact orbit_average_B1_rat]
    rw [show reducedZ B16Rat = 0 by exact orbit_average_B16_rat]
    rw [show reducedZ B11Rat =
        (27 : ℚ) • (1 : Matrix (Fin 48) (Fin 48) ℚ) - commutantMRat by
          exact orbit_average_B11_rat]
    module
  have hcomm' : JRat * B = B * JRat := hcomm.symm
  have hLcomm : reducedZ B = (54 : ℚ) • B := by
    rw [reducedZ, hcomm', Matrix.mul_assoc, J_sq_rat]
    simp only [Matrix.mul_smul, Matrix.mul_one, sub_smul]
    module
  let x : ℚ := (27 * (a0 + a11)) / 54
  let y : ℚ := (a0 + 4 * a1 - a11) / 54
  refine ⟨x, y, ?_⟩
  apply (smul_right_injective (Matrix (Fin 48) (Fin 48) ℚ) (by norm_num : (54 : ℚ) ≠ 0))
  rw [← hLcomm, hL, smul_add, smul_smul, smul_smul]
  dsimp [x, y]
  module

end D5.S3.VertexAlgebra.Lattice.Orbifold.P48pSymmetricCommutantCertificate
