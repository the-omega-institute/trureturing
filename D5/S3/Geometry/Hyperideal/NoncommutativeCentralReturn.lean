/- GID: D5/S3/Geometry/Hyperideal/NoncommutativeCentralReturn
   generality: G
   mirror-B: D5/B/S3/Geometry/Hyperideal/NoncommutativeCentralReturn
   mirror-E: none(waiver:central-return-commutativity)
   anchors: []
   utility: none
   digest: A central low return word forces a group generated by the marked pair to be commutative. -/

import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.GroupTheory.Subgroup.Center
import Mathlib.GroupTheory.Subgroup.Centralizer

/-! Centrality of the low return word controls the marked group. -/
namespace D5.S3.Geometry.Hyperideal.NoncommutativeCentralReturn

variable {G : Type*} [Group G]

/-- If the low return word is central in the subgroup generated by the marked pair,
then that generated subgroup, and hence the ambient group under the generation
hypothesis, is commutative. -/
theorem commutative_of_central_low_return (u v : G)
    (hgen : Subgroup.closure ({u, v} : Set G) = ⊤)
    (hcentral : ∀ g : G, g ∈ Subgroup.closure ({u, v} : Set G) →
      g * (v⁻¹ * u ^ 2) = (v⁻¹ * u ^ 2) * g) :
    ∀ g h : G, g * h = h * g := by
  let H : Subgroup G := Subgroup.closure ({u, v} : Set G)
  have hcomm_low : ∀ g : G, g ∈ H → Commute (v⁻¹ * u ^ 2) g := by
    intro g hg
    exact (hcentral g (by simpa [H] using hg)).symm
  have huH : u ∈ H := Subgroup.subset_closure (by simp)
  have hvH : v ∈ H := Subgroup.subset_closure (by simp)
  have hlow_u : Commute u (v⁻¹ * u ^ 2) := (hcomm_low u huH).symm
  have huv : Commute u v := by
    have hpow : Commute u (u ^ 2) := (Commute.refl u).pow_right 2
    have hinv : Commute u (v⁻¹ * u ^ 2)⁻¹ := hlow_u.inv_right
    have hprod : Commute u ((u ^ 2) * (v⁻¹ * u ^ 2)⁻¹) := hpow.mul_right hinv
    simpa [mul_assoc] using hprod
  have hpair : ({u, v} : Set G).Pairwise Commute := by
    intro a ha b hb hab
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ha hb
    rcases ha with rfl | rfl <;> rcases hb with rfl | rfl
    · exact Commute.refl _
    · exact huv
    · exact huv.symm
    · exact Commute.refl _
  have hcommH : IsMulCommutative H := Subgroup.isMulCommutative_closure hpair
  intro g h
  have hgh := hcommH.is_comm.comm (⟨g, by simpa [H, hgen]⟩ : H)
    (⟨h, by simpa [H, hgen]⟩ : H)
  exact congrArg Subtype.val hgh

end D5.S3.Geometry.Hyperideal.NoncommutativeCentralReturn
