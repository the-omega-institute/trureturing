import D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth
import D5.S3.Arith.ModularForms.CubicThetaLattice
import Mathlib.Data.Int.CardIntervalMod
import Mathlib.Algebra.Order.Floor.BigOperators


/-! Exact lattice growth and circle-vertex identities. -/
noncomputable section
namespace D5.S3.Geometry.ShannonFixedRadiusCircleVertices
open D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth

namespace ShannonA374338


/-- Retain the vertices and adjoin intersections of distinct circles of the fixed radius. -/
def vertices (a b : (EuclideanSpace ℝ (Fin 2))) : ℕ → Set (EuclideanSpace ℝ (Fin 2))
  | 0 => {a, b}
  | n + 1 => vertices a b n ∪ {p | ∃ u ∈ vertices a b n, ∃ v ∈ vertices a b n,
      u ≠ v ∧ p ∈ Metric.sphere u (dist a b) ∧ p ∈ Metric.sphere v (dist a b)}

/-- Total vertices, including the two starting points; iteration 1 has count 4. -/
noncomputable def vertexCount (a b : (EuclideanSpace ℝ (Fin 2))) (n : ℕ) : ℕ :=
  (vertices a b n).ncard

/-- The three conjectured formulas, for every pair of distinct initial vertices. -/
def claim : Prop :=
  ∀ (a b : (EuclideanSpace ℝ (Fin 2))), a ≠ b →
    (∀ (n k : ℕ), n = 3 * k + 1 →
      vertexCount a b n = (3 * n ^ 2 + 5 * n + 4) / 3) ∧
    (∀ (n k : ℕ), 1 ≤ k → n = 3 * k →
      vertexCount a b n = (3 * n ^ 2 + 5 * n) / 3) ∧
    (∀ (n k : ℕ), 1 ≤ k → n = 3 * k - 1 →
      vertexCount a b n = (3 * n ^ 2 + 5 * n + 2) / 3)

end ShannonA374338

namespace HexCounts
open Finset

private def residue (L r : ℕ) : Finset ℕ := (range (L+1)).filter (fun v => v%3=r)
def square (L : ℕ) : Finset (ℕ×ℕ) :=
  ((range (L+1)) ×ˢ (range (L+1))).filter (fun p => p.1%3=p.2%3)
private def triangle (n : ℕ) : Finset (ℕ×ℕ) :=
  ((range (n+1)) ×ˢ (range (n+1))).filter (fun p => p.1+p.2 ≤ n)
private def corner (n : ℕ) : Finset (ℕ×ℕ) :=
  (triangle n).filter (fun p => p.1%3=p.2%3)

private theorem residue_card (L r : ℕ) (hr : r<3) : (residue L r).card = (L+3-r)/3 := by
  have h := Nat.count_modEq_card (L+1) (r := 3) (by decide) r
  simp only [Nat.count_eq_card_filter_range, Nat.ModEq, Nat.mod_eq_of_lt hr] at h
  unfold residue
  rw [h]
  split_ifs <;> omega

private theorem square_decompose (L : ℕ) :
    square L = (range 3).biUnion (fun r => residue L r ×ˢ residue L r) := by
  ext p
  simp only [square, mem_filter, mem_product, mem_range, mem_biUnion, residue]
  constructor
  · rintro ⟨⟨hx,hy⟩,he⟩
    exact ⟨p.1%3, Nat.mod_lt _ (by decide), ⟨hx,rfl⟩,hy,he.symm⟩
  · rintro ⟨r,hr,⟨hx,hxr⟩,hy,hyr⟩
    exact ⟨⟨hx,hy⟩,hxr.trans hyr.symm⟩

private theorem residue_products_disjoint (L : ℕ) :
    (↑(range 3) : Set ℕ).PairwiseDisjoint (fun r => residue L r ×ˢ residue L r) := by
  intro r hr s hs hrs
  apply disjoint_left.mpr
  intro p hp hq
  simp only [mem_product, residue, mem_filter] at hp hq
  exact hrs (hp.1.2.symm.trans hq.1.2)

private theorem square_card (L : ℕ) :
    (square L).card = ((L+3)/3)^2+((L+2)/3)^2+((L+1)/3)^2 := by
  rw [square_decompose, card_biUnion (residue_products_disjoint L)]
  simp only [card_product]
  rw [show range 3 = {0,1,2} from by decide]
  simp [residue_card, pow_two]
  omega

private def slice (n : ℕ) : Finset (ℕ×ℕ) :=
  (antidiagonal n).filter (fun p => p.1%3=p.2%3)

private theorem slice_zero_card (k : ℕ) : (slice (3*k)).card = k+1 := by
  symm
  conv_lhs => rw [← card_range (k+1)]
  apply card_bij (fun i _ => (3*i,3*(k-i)))
  · intro i hi
    simp only [mem_range] at hi
    simp only [slice,mem_filter,mem_antidiagonal]
    omega
  · intro i hi j hj he
    have := congrArg Prod.fst he
    dsimp at this
    omega
  · rintro ⟨v,w⟩ hp
    simp only [slice,mem_filter,mem_antidiagonal] at hp
    refine ⟨v/3,?_,?_⟩
    · simp only [mem_range]
      omega
    · apply Prod.ext <;> dsimp <;> omega

private theorem slice_one_card (k : ℕ) : (slice (3*k+1)).card = k := by
  symm
  conv_lhs => rw [← card_range k]
  apply card_bij (fun i _ => (3*i+2,3*(k-1-i)+2))
  · intro i hi
    simp only [mem_range] at hi
    simp only [slice,mem_filter,mem_antidiagonal]
    omega
  · intro i hi j hj he
    have := congrArg Prod.fst he
    dsimp at this
    omega
  · rintro ⟨v,w⟩ hp
    simp only [slice,mem_filter,mem_antidiagonal] at hp
    refine ⟨v/3,?_,?_⟩
    · simp only [mem_range]
      omega
    · apply Prod.ext <;> dsimp <;> omega

private theorem slice_two_card (k : ℕ) : (slice (3*k+2)).card = k+1 := by
  symm
  conv_lhs => rw [← card_range (k+1)]
  apply card_bij (fun i _ => (3*i+1,3*(k-i)+1))
  · intro i hi
    simp only [mem_range] at hi
    simp only [slice,mem_filter,mem_antidiagonal]
    omega
  · intro i hi j hj he
    have := congrArg Prod.fst he
    dsimp at this
    omega
  · rintro ⟨v,w⟩ hp
    simp only [slice,mem_filter,mem_antidiagonal] at hp
    refine ⟨v/3,?_,?_⟩
    · simp only [mem_range]
      omega
    · apply Prod.ext <;> dsimp <;> omega

private theorem corner_decompose (n : ℕ) : corner n = (range (n+1)).biUnion slice := by
  ext p
  simp only [corner,triangle,mem_filter,mem_product,mem_range,
    mem_biUnion,slice,mem_antidiagonal]
  constructor
  · rintro ⟨⟨⟨hv,hw⟩,hs⟩,he⟩
    exact ⟨p.1+p.2,by omega,rfl,he⟩
  · rintro ⟨i,hi,hs,he⟩
    exact ⟨⟨⟨by omega,by omega⟩,by omega⟩,he⟩

private theorem slices_disjoint (n : ℕ) :
    (↑(range (n+1)) : Set ℕ).PairwiseDisjoint slice := by
  intro i hi j hj hij
  apply disjoint_left.mpr
  intro p hp hq
  simp only [slice,mem_filter,mem_antidiagonal] at hp hq
  exact hij (hp.1.symm.trans hq.1)

private theorem corner_card_sum (n : ℕ) :
    (corner n).card = ∑ t ∈ range (n+1), (slice t).card := by
  rw [corner_decompose,card_biUnion (slices_disjoint n)]

private theorem corner_card_succ (n : ℕ) :
    (corner (n+1)).card = (corner n).card + (slice (n+1)).card := by
  simp only [corner_card_sum,sum_range_succ]

private theorem corner_card_three (k : ℕ) :
    (corner (3*(k+1))).card = (corner (3*k)).card+3*k+3 := by
  rw [show 3*(k+1)=((3*k+1)+1)+1 by omega,corner_card_succ,corner_card_succ,
    corner_card_succ]
  rw [show (3*k+1)+1 = 3*k+2 by omega, show ((3*k+1)+1)+1 = 3*(k+1) by omega,
    slice_zero_card,slice_one_card,slice_two_card]
  omega

private theorem corner_card_zero (k : ℕ) :
    2*(corner (3*k)).card = 3*k^2+3*k+2 := by
  induction k with
  | zero => decide
  | succ k ih =>
    rw [corner_card_three]
    nlinarith

private theorem corner_card_one (k : ℕ) :
    2*(corner (3*k+1)).card = 3*k^2+5*k+2 := by
  rw [corner_card_succ,slice_one_card]
  have := corner_card_zero k
  nlinarith

private theorem corner_card_two (k : ℕ) :
    2*(corner (3*k+2)).card = 3*k^2+7*k+4 := by
  rw [show 3*k+2=(3*k+1)+1 by omega,corner_card_succ]
  rw [show 3*k+1+1=3*k+2 by omega,slice_two_card]
  have := corner_card_one k
  nlinarith


def polygon (L n : ℕ) : Finset (ℕ×ℕ) :=
  (square L).filter (fun p => n < p.1+p.2 ∧ p.1+p.2 < 2*L-n)

private theorem lower_corner (L n : ℕ) (hn : n ≤ L) :
    (square L).filter (fun p => p.1+p.2 ≤ n) = corner n := by
  ext p
  simp only [square,corner,triangle,mem_filter,mem_product,mem_range]
  omega

private theorem corner_reflection (L n : ℕ) (hn : n ≤ L) :
    ((square L).filter (fun p => 2*L-n ≤ p.1+p.2)).card = (corner n).card := by
  rw [← lower_corner L n hn]
  apply card_bij (fun p _ => (L-p.1,L-p.2))
  · intro p hp
    simp only [square,mem_filter,mem_product,mem_range] at hp ⊢
    omega
  · intro p hp q hq he
    simp only [square,mem_filter,mem_product,mem_range] at hp hq
    have hx := congrArg Prod.fst he
    have hy := congrArg Prod.snd he
    apply Prod.ext <;> dsimp at * <;> omega
  · intro q hq
    simp only [square,mem_filter,mem_product,mem_range] at hq
    refine ⟨(L-q.1,L-q.2),?_,?_⟩
    · simp only [square,mem_filter,mem_product,mem_range]
      omega
    · apply Prod.ext <;> dsimp <;> omega

private theorem polygon_balance (L n : ℕ) (hn : n < L) :
    (polygon L n).card+2*(corner n).card = (square L).card := by
  have h1 := card_filter_add_card_filter_not (s := square L) (fun p => p.1+p.2 ≤ n)
  have h2 := card_filter_add_card_filter_not
    (s := (square L).filter (fun p => ¬ p.1+p.2 ≤ n))
    (fun p => p.1+p.2 < 2*L-n)
  have he1 : ((square L).filter (fun p => ¬ p.1+p.2 ≤ n)).filter
      (fun p => p.1+p.2 < 2*L-n) = polygon L n := by
    ext p
    simp only [polygon,mem_filter,not_le,and_assoc]
  have he2 : ((square L).filter (fun p => ¬ p.1+p.2 ≤ n)).filter
      (fun p => ¬ p.1+p.2 < 2*L-n) =
      (square L).filter (fun p => 2*L-n ≤ p.1+p.2) := by
    ext p
    simp only [mem_filter,not_lt,not_le]
    have hgap : n < 2*L-n := by omega
    constructor
    · rintro ⟨⟨hp,hl⟩,hu⟩
      exact ⟨hp,hu⟩
    · rintro ⟨hp,hu⟩
      exact ⟨⟨hp,by omega⟩,hu⟩
  rw [lower_corner L n (by omega)] at h1
  rw [he1,he2,corner_reflection L n (by omega)] at h2
  omega

private theorem square_expand_three (L : ℕ) :
    (square (L+3)).card = (square L).card+2*L+5 := by
  rw [square_card,square_card]
  have h0 : (L+3+3)/3=(L+3)/3+1 := by
    exact Nat.add_div_right (L + 3) (by decide)
  have h1 : (L+3+2)/3=(L+2)/3+1 := by
    simpa only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      (Nat.add_div_right (L + 2) (by decide : 0 < 3))
  have h2 : (L+3+1)/3=(L+1)/3+1 := by
    simpa only [Nat.add_assoc, Nat.add_left_comm, Nat.add_comm] using
      (Nat.add_div_right (L + 1) (by decide : 0 < 3))
  have hs : (L+3)/3+(L+2)/3+(L+1)/3=L+1 := by
    have h := Int.sum_range_add_ediv ((L : ℤ) + 1) (n := 3) (by decide)
    norm_num [Finset.sum_range_succ, add_assoc] at h
    have h' : (L+1)/3+((L+2)/3+(L+3)/3)=L+1 := by
      exact Int.ofNat_inj.mp h
    omega
  rw [h0,h1,h2]
  nlinarith

private theorem polygon_expand_three (L n : ℕ) (hn : n<L) :
    (polygon (L+3) n).card = (polygon L n).card+2*L+5 := by
  have h0 := polygon_balance L n hn
  have h1 := polygon_balance (L+3) n (by omega)
  rw [square_expand_three] at h1
  omega

theorem polygon_zero (k : ℕ) :
    (polygon (2*(3*k)+1) (3*k)).card = 9*k^2+5*k := by
  have h := polygon_balance (2*(3*k)+1) (3*k) (by omega)
  rw [corner_card_zero,square_card] at h
  have h0 : (2*(3*k)+1+3)/3=2*k+1 := by
    have h := Nat.add_mul_div_left 4 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  have h1 : (2*(3*k)+1+2)/3=2*k+1 := by
    have h := Nat.add_mul_div_left 3 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  have h2 : (2*(3*k)+1+1)/3=2*k := by
    have h := Nat.add_mul_div_left 2 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  rw [h0,h1,h2] at h
  nlinarith

theorem polygon_one (k : ℕ) :
    (polygon (2*(3*k+1)+1) (3*k+1)).card = 9*k^2+11*k+4 := by
  have h := polygon_balance (2*(3*k+1)+1) (3*k+1) (by omega)
  rw [corner_card_one,square_card] at h
  have h0 : (2*(3*k+1)+1+3)/3=2*k+2 := by
    have h := Nat.add_mul_div_left 6 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  have h1 : (2*(3*k+1)+1+2)/3=2*k+1 := by
    have h := Nat.add_mul_div_left 5 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  have h2 : (2*(3*k+1)+1+1)/3=2*k+1 := by
    have h := Nat.add_mul_div_left 4 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  rw [h0,h1,h2] at h
  nlinarith

theorem polygon_two (k : ℕ) :
    (polygon (2*(3*k+2)+1) (3*k+2)).card = 9*k^2+17*k+8 := by
  have h := polygon_balance (2*(3*k+2)+1) (3*k+2) (by omega)
  rw [corner_card_two,square_card] at h
  have h0 : (2*(3*k+2)+1+3)/3=2*k+2 := by
    have h := Nat.add_mul_div_left 8 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  have h1 : (2*(3*k+2)+1+2)/3=2*k+2 := by
    have h := Nat.add_mul_div_left 7 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  have h2 : (2*(3*k+2)+1+1)/3=2*k+2 := by
    have h := Nat.add_mul_div_left 6 (2*k) (by decide : 0 < 3)
    norm_num only [Nat.reduceDiv] at h
    convert h using 1 <;> first | ring | (congr 1 <;> ring)
  rw [h0,h1,h2] at h
  nlinarith


end HexCounts

namespace HexShapeCounts
open Finset

def inverse (n : ℕ) (p : ℕ×ℕ) : ℤ×ℤ :=
  let q := D5.S3.Arith.ModularForms.CubicThetaLattice.normThird ((p.1 : ℤ), (p.2 : ℤ))
  (q.1 - (n : ℤ), q.2)

def shape (m n : ℕ) : Finset (ℤ×ℤ) :=
  (HexCounts.polygon (m-1+2*n) n).image (inverse n)

private theorem shape_mem (m n : ℕ) (hm : 2 ≤ m) (hn : 2 ≤ n) (p : ℤ×ℤ) :
    p ∈ shape m n ↔ p ∈ D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.H m n := by
  simp only [shape,mem_image]
  constructor
  · rintro ⟨q,hq,rfl⟩
    simp only [HexCounts.polygon,HexCounts.square,mem_filter,mem_product,mem_range] at hq
    simp only [D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.H,Set.mem_setOf_eq,D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.HexGrowth.Hex,D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.transform,inverse,D5.S3.Arith.ModularForms.CubicThetaLattice.normThird]
    omega
  · intro hp
    simp only [D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.H,Set.mem_setOf_eq,D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.HexGrowth.Hex,D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.transform] at hp
    let q : ℕ×ℕ := ((p.1-p.2+n).toNat,(p.1+2*p.2+n).toNat)
    refine ⟨q,?_,?_⟩
    · simp only [HexCounts.polygon,HexCounts.square,mem_filter,mem_product,mem_range]
      dsimp [q]
      omega
    · apply Prod.ext <;> dsimp [inverse,q,D5.S3.Arith.ModularForms.CubicThetaLattice.normThird] <;> omega

theorem shape_card (m n : ℕ) :
    (shape m n).card = (HexCounts.polygon (m-1+2*n) n).card := by
  unfold shape
  apply card_image_of_injOn
  intro p hp q hq he
  simp only [Finset.mem_coe,HexCounts.polygon,HexCounts.square,mem_filter,mem_product,mem_range] at hp hq
  have hx := congrArg Prod.fst he
  have hy := congrArg Prod.snd he
  dsimp [inverse,D5.S3.Arith.ModularForms.CubicThetaLattice.normThird] at hx hy
  apply Prod.ext <;> omega

private theorem H_coe (m n : ℕ) (hm : 2 ≤ m) (hn : 2 ≤ n) :
    D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.H m n = (shape m n : Set (ℤ×ℤ)) := by
  ext p
  exact (shape_mem m n hm hn p).symm

private theorem H_card (m n : ℕ) (hm : 2 ≤ m) (hn : 2 ≤ n) :
    (D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.H m n).ncard = (HexCounts.polygon (m-1+2*n) n).card := by
  rw [H_coe m n hm hn,Set.ncard_coe_finset,shape_card]

theorem grown_coe (m n : ℕ) (hm : m=2 ∨ m=5) (hn : 2 ≤ n) :
    D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.grown m n = (shape m n : Set (ℤ×ℤ)) := by
  rw [D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.exact_shape m n hm hn,H_coe m n (by omega) hn]

theorem count_difference (n : ℕ) :
    (shape 5 n).card = (shape 2 n).card+4*n+7 := by
  rw [shape_card,shape_card]
  norm_num
  rw [show 4+2*n=(1+2*n)+3 by omega,
    HexCounts.polygon_expand_three (1+2*n) n (by omega)]
  omega

end HexShapeCounts

namespace CircleGrowth
open D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.CircleGrowth
open HexEmbedding

private theorem initial_two : D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.initial 2 = ({(0,0),(1,0)} : Set (ℤ×ℤ)) := by
  ext p
  rcases p with ⟨x,y⟩
  simp only [D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.initial,Set.mem_setOf_eq,Set.mem_insert_iff,Set.mem_singleton_iff,
    Prod.mk.injEq]
  omega

private theorem vertices_image (a b : (EuclideanSpace ℝ (Fin 2))) (hab : a ≠ b) (n : ℕ) :
    ShannonA374338.vertices a b n = embed a b '' D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.grown 2 n := by
  induction n with
  | zero =>
    rw [D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.grown,initial_two,Set.image_pair]
    simp [embed,axial,frame_zero,frame_one,ShannonA374338.vertices]
  | succ n ih =>
    ext p
    constructor
    · rintro (hp|hp)
      · rw [ih] at hp
        obtain ⟨w,hw,rfl⟩ := hp
        exact ⟨w,Or.inl hw,rfl⟩
      · obtain ⟨c,hc,d,hd,hcd,hpc,hpd⟩ := hp
        rw [ih] at hc hd
        obtain ⟨u,hu,rfl⟩ := hc
        obtain ⟨v,hv,rfl⟩ := hd
        obtain ⟨w,rfl,hwu,hwv⟩ := intersection_lattice a b hab u v
          (fun h => hcd (congrArg (embed a b) h)) p hpc hpd
        refine ⟨w,Or.inr ⟨u-w,?_,v-w,?_,?_,?_,?_⟩,rfl⟩
        · simpa only [neg_sub] using (directions_neg (w-u)).mpr hwu
        · simpa only [neg_sub] using (directions_neg (w-v)).mpr hwv
        · intro h
          apply hcd
          congr 1
          exact (sub_left_inj).mp h
        · simpa using hu
        · simpa using hv
    · rintro ⟨w,hw,rfl⟩
      rcases hw with hw|hw
      · exact Or.inl (ih.symm ▸ Set.mem_image_of_mem _ hw)
      · obtain ⟨d,hd,e,he,hde,hwd,hwe⟩ := hw
        refine Or.inr ⟨embed a b (w+d),?_,embed a b (w+e),?_,?_,?_,?_⟩
        · rw [ih]; exact Set.mem_image_of_mem _ hwd
        · rw [ih]; exact Set.mem_image_of_mem _ hwe
        · exact fun h => hde (add_left_cancel (embed_injective a b hab h))
        · apply embed_adjacent a b hab
          simpa using (directions_neg d).mpr hd
        · apply embed_adjacent a b hab
          simpa using (directions_neg e).mpr he

private theorem vertex_card (a b : (EuclideanSpace ℝ (Fin 2))) (hab : a ≠ b) (n : ℕ) (hn : 2 ≤ n) :
    ShannonA374338.vertexCount a b n = (HexCounts.polygon (2*n+1) n).card := by
  unfold ShannonA374338.vertexCount
  rw [vertices_image a b hab n,Set.ncard_image_of_injective _ (embed_injective a b hab),
    D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.exact_shape 2 n (Or.inl rfl) hn,HexShapeCounts.H_card 2 n (by decide) hn]
  congr 2
  omega

private theorem first_four (a b : (EuclideanSpace ℝ (Fin 2))) (hab : a ≠ b) : ShannonA374338.vertexCount a b 1=4 := by
  have hg : D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.grown 2 1 =
      (↑({(0,0),(1,0),(0,1),(1,-1)} : Finset (ℤ×ℤ)) : Set (ℤ×ℤ)) := by
    rw [D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.first_step 2]
    ext p
    rcases p with ⟨x,y⟩
    simp [D5.S3.StatisticalMechanics.Percolation.TriangularTwoNeighborGrowth.AxialGrowth.first,Prod.mk.injEq]
    omega
  unfold ShannonA374338.vertexCount
  rw [vertices_image a b hab 1,Set.ncard_image_of_injective _ (embed_injective a b hab),hg,
    Set.ncard_coe_finset]
  decide

end CircleGrowth

namespace ShannonA374338

theorem result : claim := by
  intro a b hab
  constructor
  · intro n k hn
    subst n
    by_cases hk : k=0
    · subst k
      norm_num [CircleGrowth.first_four a b hab]
    · rw [CircleGrowth.vertex_card a b hab _ (by omega),HexCounts.polygon_one]
      ring_nf
      omega
  constructor
  · intro n k hk hn
    subst n
    rw [CircleGrowth.vertex_card a b hab _ (by omega),HexCounts.polygon_zero]
    ring_nf
    omega
  · intro n k hk hn
    obtain ⟨j,rfl⟩ : ∃ j, k=j+1 := ⟨k-1,by omega⟩
    have he : n=3*j+2 := by
      exact Eq.symm (Nat.add_right_cancel (congrFun (congrArg HAdd.hAdd (id (Eq.symm hn))) n))
    rw [he]
    rw [CircleGrowth.vertex_card a b hab _ (by omega),HexCounts.polygon_two]
    ring_nf
    omega

end ShannonA374338

