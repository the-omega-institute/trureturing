abbrev V := Fin 5
abbrev E := Fin 8
def ends : E → V × V := ![
  (3, 0), (3, 0), (3, 1), (3, 2),
  (4, 0), (4, 0), (4, 1), (4, 2)]
def gain : E → Fin 2 := ![0, 1, 0, 0, 0, 1, 0, 0]
def bit (m : Fin 256) (e : E) : Bool := decide ((m.val / 2^e.val) % 2 = 1)
def selected (m : Fin 256) (e : E) : Bool := bit m e
def active (m : Fin 256) (v : V) : Bool :=
  decide (∃ e : E, selected m e = true ∧ ((ends e).1 = v ∨ (ends e).2 = v))
def adjacent (m : Fin 256) (u v : V) : Bool :=
  decide (∃ e : E, selected m e = true ∧
    (((ends e).1 = u ∧ (ends e).2 = v) ∨ ((ends e).1 = v ∧ (ends e).2 = u)))
def reach : Fin 256 → Nat → V → V → Bool
  | _, 0, u, v => decide (u = v)
  | m, k + 1, u, v => reach m k u v || decide (∃ w : V, reach m k u w = true ∧ adjacent m w v = true)
/-- Unbounded walks in the supported quotient multigraph; multiplicities are retained in E. -/
def sourceReach (m : Fin 256) (u v : V) : Prop :=
  Relation.ReflTransGen (fun a b => adjacent m a b = true) u v

def sourceRoot (m : Fin 256) (v : V) : Prop :=
  active m v = true ∧ ∀ w : V, w.val < v.val →
    ¬ (active m w = true ∧ sourceReach m w v)

def root (m : Fin 256) (v : V) : Bool :=
  decide (active m v = true ∧ ∀ w : V, w.val < v.val →
    ¬(active m w = true ∧ reach m 5 w v = true))
def balancedAt (m : Fin 256) (r : V) : Bool :=
  decide (∃ q : V → Fin 2, ∀ e : E, selected m e = true →
    reach m 5 r (ends e).1 = true →
      (q (ends e).1).val + (q (ends e).2).val ≡ (gain e).val [MOD 2])
/-- Each step traverses a selected incidence and accumulates its C₂ gain.
Reverse traversal has the same gain, since every C₂ element is its own inverse. -/
def gainStep (m : Fin 256) (u v : V × Fin 2) : Prop :=
  ∃ e : E, selected m e = true ∧
    ((u.1 = (ends e).1 ∧ v.1 = (ends e).2) ∨
      (u.1 = (ends e).2 ∧ v.1 = (ends e).1)) ∧ v.2 = u.2 + gain e

/-- Unbounded lifted walks encode the accumulated gain, including the empty walk. -/
def gainWalk (m : Fin 256) (u v : V) (g : Fin 2) : Prop :=
  Relation.ReflTransGen (gainStep m) (u, 0) (v, g)

/-- The source subgroup is generated by all closed-walk gains. -/
def closedGainSubgroup (m : Fin 256) (r : V) : AddSubgroup (Fin 2) :=
  AddSubgroup.closure {g | gainWalk m r r g}

def balanceSound : Prop := ∀ m r,
  balancedAt m r = true → closedGainSubgroup m r = ⊥

def pSupport (m : Fin 256) : Finset V :=
  Finset.univ.filter (fun v => v.val < 3 ∧ active m v = true)
def lSupport (m : Fin 256) : Finset V :=
  Finset.univ.filter (fun v => 3 ≤ v.val ∧ active m v = true)
def rootSet (m : Fin 256) : Finset V :=
  Finset.univ.filter (fun v => root m v = true)
def hdim (m : Fin 256) (r : V) : Nat := if balancedAt m r = true then 3 else 1
def subsetInequality (m : Fin 256) : Prop :=
  ((Finset.univ.filter (fun e => selected m e = true)).card : ℤ) ≤
    (pSupport m).card + 3 * (lSupport m).card -
      ∑ r ∈ rootSet m, (hdim m r : ℤ)



abbrev Point := Fin 3 × Fin 2
abbrev Line := Fin 2 × Fin 2

def pointAction (g : Fin 2) (p : Point) : Point := (p.1, p.2 + g)
def lineAction (g : Fin 2) (l : Line) : Line := (l.1, l.2 + g)

def copySign (s : Fin 2) : ℝ := if s = 0 then 1 else -1

def basePoint (z : Fin 6 → ℝ) (i : Fin 3) : ℝ × ℝ :=
  ![(z 0, z 1), (z 2, z 3), (z 4, z 5)] i

def picture (z : Fin 6 → ℝ) (p : Point) : ℝ × ℝ :=
  (copySign p.2 * (basePoint z p.1).1, copySign p.2 * (basePoint z p.1).2)

def incidence (p : Point) (l : Line) : Prop := p.1 = 0 ∨ p.2 = l.2

instance (p : Point) (l : Line) : Decidable (incidence p l) :=
  inferInstanceAs (Decidable (p.1 = 0 ∨ p.2 = l.2))


abbrev Plane := EuclideanSpace ℝ (Fin 2)

def planeVector (v : ℝ × ℝ) : Plane := WithLp.toLp 2 ![v.1, v.2]

/-- The orthogonal C₂ representation on the actual Euclidean picture space. -/
noncomputable def tau : Multiplicative (Fin 2) →* (Plane ≃ₗᵢ[ℝ] Plane) where
  toFun g := if g.toAdd = 0 then LinearIsometryEquiv.refl ℝ Plane
    else LinearIsometryEquiv.neg ℝ
  map_one' := by ext x i; rfl
  map_mul' g k := by
    fin_cases g <;> fin_cases k <;> ext x i <;> simp

/-- The trivial real one-dimensional character, with image in {±1}. -/
def chi : Multiplicative (Fin 2) →* ℝˣ := 1

/-- The actual actions on point and line labels are bundled permutations. -/
def pointPermutation (g : Fin 2) : Equiv.Perm Point where
  toFun := pointAction g
  invFun := pointAction (-g)
  left_inv p := by simp [pointAction, add_assoc]
  right_inv p := by simp [pointAction, add_assoc]

def linePermutation (g : Fin 2) : Equiv.Perm Line where
  toFun := lineAction g
  invFun := lineAction (-g)
  left_inv l := by simp [lineAction, add_assoc]
  right_inv l := by simp [lineAction, add_assoc]

def labelRepresentation : Multiplicative (Fin 2) →*
    (Equiv.Perm Point × Equiv.Perm Line) where
  toFun g := (pointPermutation g.toAdd, linePermutation g.toAdd)
  map_one' := by apply Prod.ext <;> ext a <;> simp [pointPermutation, linePermutation,
    pointAction, lineAction]
  map_mul' g k := by
    apply Prod.ext <;> ext a <;> simp [pointPermutation, linePermutation,
      pointAction, lineAction, add_comm, add_left_comm]

/-- Faithful incidence automorphisms, orthogonal half-turn, and trivial character. -/
def sourceActionBridge : Prop :=
  Function.Injective labelRepresentation ∧
  (∀ g p l, incidence ((labelRepresentation g).1 p) ((labelRepresentation g).2 l) ↔
    incidence p l) ∧
  (∀ g : Fin 2, ∀ v : ℝ × ℝ,
    tau (Multiplicative.ofAdd g) (planeVector v) =
      planeVector (copySign g * v.1, copySign g * v.2)) ∧
  (∀ g, (chi g : ℝ) = 1)

def representativeIndex : Fin 3 × Fin 2 ≃ Fin 6 := finProdFinEquiv

def representativeCoordinates (z : Fin 6 → ℝ) (ik : Fin 3 × Fin 2) : ℝ :=
  if ik.2 = 0 then (picture z (ik.1, 0)).1 else (picture z (ik.1, 0)).2

def sourceGenericPicture (z : Fin 6 → ℝ) : Prop :=
  (∀ g p, planeVector (picture z (pointAction g p)) =
    tau (Multiplicative.ofAdd g) (planeVector (picture z p))) ∧
  AlgebraicIndependent ℚ (representativeCoordinates z)

def orbitPoint : E → Fin 3 := ![0, 0, 1, 2, 0, 0, 1, 2]
def orbitLine : E → Fin 2 := ![0, 0, 0, 0, 1, 1, 1, 1]
def liftedIncidence (e : E) (s : Fin 2) : Point × Line :=
  ((orbitPoint e, s + gain e), (orbitLine e, s))

abbrev CoverVertex := Point ⊕ Line

def coverAdjacent : CoverVertex → CoverVertex → Bool
  | Sum.inl p, Sum.inr l => decide (incidence p l)
  | Sum.inr l, Sum.inl p => decide (incidence p l)
  | _, _ => false

def coverReach : Nat → CoverVertex → CoverVertex → Bool
  | 0, u, v => decide (u = v)
  | k + 1, u, v => coverReach k u v ||
      decide (∃ w : CoverVertex, coverReach k u w = true ∧ coverAdjacent w v = true)

def coverConnected : Prop := ∀ u v : CoverVertex,
  Relation.ReflTransGen (fun a b => coverAdjacent a b = true) u v

/-- Quotient components are supported components, represented exactly once by their least vertex. -/
def componentBridge : Prop :=
  (∀ m u v, reach m 5 u v = true ↔ sourceReach m u v) ∧
  (∀ m v, root m v = true ↔ sourceRoot m v) ∧
  (∀ m v, active m v = true → ∃! r, sourceRoot m r ∧ sourceReach m r v)

/-- Free C₂ action, exact labelled quotient cover, degree, connectivity and orbit counts. -/
def incidenceBridge : Prop :=
  (∀ g p, pointAction g p = p ↔ g = 0) ∧
  (∀ g l, lineAction g l = l ↔ g = 0) ∧
  (∀ g p l, incidence (pointAction g p) (lineAction g l) ↔ incidence p l) ∧
  (Function.Injective (fun es : E × Fin 2 => liftedIncidence es.1 es.2)) ∧
  (∀ p l, incidence p l ↔ ∃ e s, liftedIncidence e s = (p, l)) ∧
  (∀ l : Line, (Finset.univ.filter (fun p : Point => incidence p l)).card = 4) ∧
  (Finset.univ.filter (fun pl : Point × Line => incidence pl.1 pl.2)).card = 16 ∧
  Fintype.card Point = 6 ∧ Fintype.card Line = 4 ∧ Fintype.card E = 8 ∧
  coverConnected

def sceneNormal (z : Fin 6 → ℝ) (l : Line) : ℝ × ℝ :=
  (copySign l.2 * -(z 1), copySign l.2 * z 0)

def sceneHeight (z : Fin 6 → ℝ) (p : Point) : ℝ :=
  if p.1 = 0 then 0 else if p.1 = 1 then -(z 0 * z 3 - z 1 * z 2)
  else -(z 0 * z 5 - z 1 * z 4)

def sceneEquation (z : Fin 6 → ℝ) (y : Point → ℝ) (n : Line → ℝ × ℝ)
    (h : Line → ℝ) (p : Point) (l : Line) : Prop :=
  (n l).1 * (picture z p).1 + (n l).2 * (picture z p).2 + y p + h l = 0

def symmetricScene (z : Fin 6 → ℝ) (y : Point → ℝ) (n : Line → ℝ × ℝ)
    (h : Line → ℝ) : Prop :=
  (∀ p l, incidence p l → sceneEquation z y n h p l) ∧
  (∀ (i : Fin 3) (j : Fin 2), y (i, 1) = y (i, 0)) ∧
  (∀ (j : Fin 2), n (j, 1) = (- (n (j, 0)).1, - (n (j, 0)).2)) ∧
  (∀ (j : Fin 2), h (j, 1) = h (j, 0))

/-- Both positive-copy normals agree, both negative-copy normals agree, and each
positive-copy normal differs from each negative-copy normal. All four labels are included. -/
def normalComparison (n : Line → ℝ × ℝ) : Prop :=
  ∀ j k : Fin 2, n (j, 0) = n (k, 0) ∧ n (j, 1) = n (k, 1) ∧
    n (j, 0) ≠ n (k, 1)

def equivariantPicture (z : Fin 6 → ℝ) : Prop := ∀ g p,
  picture z (pointAction g p) =
    (copySign g * (picture z p).1, copySign g * (picture z p).2)

def trivialScene (n : Line → ℝ × ℝ) (h : Line → ℝ) : Prop :=
  (∀ l l', n l = n l') ∧ ∀ l l', h l = h l'

abbrev Parameters := (ℝ × ℝ) × ℝ

/-- The source has d = 3, τ(1) = -I₂ and χ = 1. -/
def parameterAction (g : Fin 2) : Parameters →ₗ[ℝ] Parameters where
  toFun p := if g = 0 then p else ((-p.1.1, -p.1.2), p.2)
  map_add' p q := by
    by_cases hg : g = 0 <;> simp [hg, add_comm]
  map_smul' r p := by
    by_cases hg : g = 0 <;> simp [hg]

/-- Exact coordinate criterion in the source's definition of H. -/
def sourceInvariant (K : AddSubgroup (Fin 2)) (p : Parameters) : Prop :=
  ∀ g ∈ K, ∀ x₁ x₂ y : ℝ,
    ((parameterAction g p).1.1 * x₁ + (parameterAction g p).1.2 * x₂ + y + p.2 = 0 ↔
      p.1.1 * x₁ + p.1.2 * x₂ + y + p.2 = 0)

/-- Affine hyperplane with normal (n₁,n₂,1) and constant h, as in scene_eq. -/
def hyperplane (p : Parameters) : Set Parameters :=
  {q | p.1.1 * q.1.1 + p.1.2 * q.1.2 + q.2 + p.2 = 0}

/-- Intersection of fixed submodules of the actual induced parameter action. -/
def H (K : AddSubgroup (Fin 2)) : Submodule ℝ Parameters :=
  ⨅ g : K, (parameterAction g.val).fixedSubmodule


def invariantBridge : Prop :=
    (∀ p : Parameters, parameterAction 0 p = p ∧
      parameterAction 1 p = ((-p.1.1, -p.1.2), p.2)) ∧
    (∀ g : Fin 2, ∀ p q : Parameters,
      q ∈ hyperplane (parameterAction g p) ↔ parameterAction g q ∈ hyperplane p) ∧
    (∀ K : AddSubgroup (Fin 2), ∀ p : Parameters,
      sourceInvariant K p ↔
        ∀ g ∈ K, ∀ q : Parameters,
          parameterAction g q ∈ hyperplane p ↔ q ∈ hyperplane p) ∧
    (∀ g k : Fin 2, ∀ p : Parameters,
      parameterAction (g + k) p = parameterAction g (parameterAction k p)) ∧
    (∀ K : AddSubgroup (Fin 2), ∀ p : Parameters,
      sourceInvariant K p ↔ p ∈ H K) ∧
    Module.finrank ℝ (H ⊥) = 3 ∧
    (∀ K : AddSubgroup (Fin 2), K ≠ ⊥ → Module.finrank ℝ (H K) = 1)

/-- Normalized planes are uniquely encoded by their parameters, whose action is τχ. -/
def sourceParameterBridge : Prop :=
  Function.Injective hyperplane ∧
  (∀ g p, planeVector ((parameterAction g p).1) =
    (chi (Multiplicative.ofAdd g) : ℝ) •
      tau (Multiplicative.ofAdd g) (planeVector p.1)) ∧
  (∀ g p, (parameterAction g p).2 = (chi (Multiplicative.ofAdd g) : ℝ) * p.2)

/-- The full source orbit count equality, using the actual invariant submodule. -/
def sourceFullCount : Prop :=
  ((Finset.univ.filter (fun pl : Point × Line => incidence pl.1 pl.2)).card : ℚ) /
      Fintype.card (Fin 2) =
    (Fintype.card Point : ℚ) / Fintype.card (Fin 2) +
      3 * ((Fintype.card Line : ℚ) / Fintype.card (Fin 2)) - Module.finrank ℝ (H ⊤)

/-- Literal source scene equations and explicit all-group line transformations.
The full hyperplane normal has final coefficient one. -/
def sourceScene (z : Fin 6 → ℝ) (y : Point → ℝ) (n : Line → ℝ × ℝ)
    (h : Line → ℝ) : Prop :=
  (∀ p l, incidence p l → ((picture z p, y p) : Parameters) ∈ hyperplane (n l, h l)) ∧
  (∀ g p, y (pointAction g p) = (chi (Multiplicative.ofAdd g) : ℝ) * y p) ∧
  (∀ g l, planeVector (n (lineAction g l)) =
    (chi (Multiplicative.ofAdd g) : ℝ) •
      tau (Multiplicative.ofAdd g) (planeVector (n l))) ∧
  (∀ g l, h (lineAction g l) = (chi (Multiplicative.ofAdd g) : ℝ) * h l) ∧
  (∀ l, (((n l).1, (n l).2), (1 : ℝ)) ≠ (0 : Parameters))

/-- Source flatness uses the literal lifting equations and actual all-group transformations. -/
def sourceFlatPicture (z : Fin 6 → ℝ) : Prop :=
  ∀ (y : Point → ℝ) (n : Line → ℝ × ℝ) (h : Line → ℝ),
    sourceScene z y n h → trivialScene n h

/-- The finite count predicate for the eight-edge quotient. Its source closed-walk and
    invariant-space correspondence is not part of this definition. -/
def countCondition : Prop := ∀ m : Fin 256, subsetInequality m

namespace FiniteRepresentation
set_option Elab.async false
set_option maxRecDepth 100000
/-- The exact selected-bit decoder, retaining all eight edge labels. -/
def decoded (m : Fin 256) : Finset E :=
  Finset.univ.filter (fun e => selected m e = true)

def encodedValue (J : Finset E) : Nat := ∑ e ∈ J, 2 ^ e.val

set_option maxHeartbeats 10000000 in
-- Kernel reduction checks each of the 256 binary masks.
/-- The finite binary representation uses the existing decoder without changing it. -/
noncomputable def maskEquiv : Fin 256 ≃ Finset E :=
  Equiv.ofBijective decoded <| (Fintype.bijective_iff_injective_and_card decoded).mpr <| by
    refine ⟨?_, by simp [Fintype.card_finset, E]⟩
    have hdecode : ∀ m : Fin 256, encodedValue (decoded m) = m.val := by
      intro m
      fin_cases m <;> decide
    intro m n h
    apply Fin.ext
    exact (hdecode m).symm.trans ((congrArg encodedValue h).trans (hdecode n))

abbrev ActiveVertex (m : Fin 256) := {v : V // active m v = true}

/-- Source components are quotients of supported vertices by unbounded walks. -/
def supportedSetoid (m : Fin 256) : Setoid (ActiveVertex m) where
  r u v := sourceReach m u.val v.val
  iseqv := by
    have hs : ∀ u v : V, adjacent m u v = true → adjacent m v u = true := by
      intro u v h
      obtain ⟨e, he, hor⟩ := of_decide_eq_true h
      apply decide_eq_true
      exact ⟨e, he, hor.elim (fun h => Or.inr h) (fun h => Or.inl h)⟩
    letI : Std.Symm (fun u v : V => adjacent m u v = true) := ⟨hs⟩
    refine ⟨fun _ => .refl, ?_, fun h k => h.trans k⟩
    intro u v h
    change Relation.ReflTransGen (fun a b => adjacent m a b = true) u.val v.val at h
    change Relation.ReflTransGen (fun a b => adjacent m a b = true) v.val u.val
    exact symm h

abbrev SupportedComponent (m : Fin 256) := Quotient (supportedSetoid m)
noncomputable instance (m : Fin 256) : Fintype (SupportedComponent m) := Fintype.ofFinite _

/-- Every supported component is represented by its least supported vertex. -/
noncomputable def supportedComponentEquiv (hc : componentBridge) (m : Fin 256) :
    SupportedComponent m ≃ ↥(rootSet m) := by
  classical
  let pick (v : ActiveVertex m) : V := Classical.choose (hc.2.2 m v.val v.property)
  have hp (v : ActiveVertex m) : sourceRoot m (pick v) ∧ sourceReach m (pick v) v.val :=
    (Classical.choose_spec (hc.2.2 m v.val v.property)).1
  have hu (v : ActiveVertex m) (r : V)
      (hr : sourceRoot m r ∧ sourceReach m r v.val) : r = pick v :=
    (Classical.choose_spec (hc.2.2 m v.val v.property)).2 r hr
  let f (v : ActiveVertex m) : ↥(rootSet m) :=
    ⟨pick v, Finset.mem_filter.mpr ⟨Finset.mem_univ _, (hc.2.1 m _).mpr (hp v).1⟩⟩
  have hf (u v : ActiveVertex m) (h : sourceReach m u.val v.val) : f u = f v := by
    apply Subtype.ext
    exact hu v (pick u) ⟨(hp u).1, (hp u).2.trans h⟩
  let q : SupportedComponent m → ↥(rootSet m) := Quotient.lift f hf
  let g (r : ↥(rootSet m)) : SupportedComponent m :=
    Quotient.mk _ ⟨r.val, ((hc.2.1 m r.val).mp (Finset.mem_filter.mp r.property).2).1⟩
  refine ⟨q, g, ?_, ?_⟩
  · intro c
    induction c using Quotient.inductionOn with
    | _ v =>
      apply Quotient.sound
      exact (hp v).2
  · intro r
    apply Subtype.ext
    exact (hu ⟨r.val, ((hc.2.1 m r.val).mp (Finset.mem_filter.mp r.property).2).1⟩ r.val
      ⟨(hc.2.1 m r.val).mp (Finset.mem_filter.mp r.property).2, .refl⟩).symm



/-- Literal point-label orbits for the translation action on the copy coordinate. -/
def pointOrbitSetoid : Setoid Point where
  r p q := ∃ g : Fin 2, pointAction g p = q
  iseqv := ⟨by decide, by decide, by decide⟩

/-- Literal line-label orbits for the same action. -/
def lineOrbitSetoid : Setoid Line where
  r p q := ∃ g : Fin 2, lineAction g p = q
  iseqv := ⟨by decide, by decide, by decide⟩

def pointOrbitEquiv : Quotient pointOrbitSetoid ≃ Fin 3 where
  toFun := Quotient.lift Prod.fst (by
    intro p q h
    obtain ⟨g, hg⟩ := h
    simpa only [pointAction] using congrArg (fun x : Point => x.1) hg)
  invFun i := Quotient.mk _ (i, 0)
  left_inv := by
    intro c
    induction c using Quotient.inductionOn with
    | _ p => exact Quotient.sound ⟨p.2, by simp [pointAction]⟩
  right_inv _ := rfl

def lineOrbitEquiv : Quotient lineOrbitSetoid ≃ Fin 2 where
  toFun := Quotient.lift Prod.fst (by
    intro p q h
    obtain ⟨g, hg⟩ := h
    simpa only [lineAction] using congrArg (fun x : Line => x.1) hg)
  invFun i := Quotient.mk _ (i, 0)
  left_inv := by
    intro c
    induction c using Quotient.inductionOn with
    | _ p => exact Quotient.sound ⟨p.2, by simp [lineAction]⟩
  right_inv _ := rfl

abbrev IncidenceLabel := {pl : Point × Line // incidence pl.1 pl.2}

/-- Labelled cover incidences are precisely edge labels and copy coordinates. -/
noncomputable def incidenceLiftEquiv (hb : incidenceBridge) : E × Fin 2 ≃ IncidenceLabel := by
  have hi := hb.2.2.2.1
  have he := hb.2.2.2.2.1
  let f (es : E × Fin 2) : IncidenceLabel :=
    ⟨liftedIncidence es.1 es.2, (he _ _).mpr ⟨es.1, es.2, rfl⟩⟩
  apply Equiv.ofBijective f
  constructor
  · intro a b h
    exact hi (congrArg Subtype.val h)
  · intro pl
    obtain ⟨e, s, h⟩ := (he pl.val.1 pl.val.2).mp pl.property
    exact ⟨(e,s), Subtype.ext h⟩

/-- Incidence orbits are simultaneous translations of both endpoint labels. -/
def incidenceOrbitSetoid : Setoid IncidenceLabel where
  r a b := ∃ g : Fin 2,
    (pointAction g a.val.1, lineAction g a.val.2) = b.val
  iseqv := by
    refine ⟨by decide, by decide, ?_⟩
    intro a b c hab hbc
    obtain ⟨g, hg⟩ := hab
    obtain ⟨h, hh⟩ := hbc
    refine ⟨g+h, ?_⟩
    have hcompose : ∀ g h : Fin 2, ∀ pl : Point × Line,
        (pointAction (g+h) pl.1, lineAction (g+h) pl.2) =
        (pointAction h (pointAction g pl.1), lineAction h (lineAction g pl.2)) := by decide
    rw [hcompose]
    exact (congrArg (fun pl : Point × Line =>
      (pointAction h pl.1, lineAction h pl.2)) hg).trans hh

/-- Taking an incidence orbit forgets only its copy coordinate, never its edge label. -/
noncomputable def incidenceOrbitEquiv (hb : incidenceBridge) : Quotient incidenceOrbitSetoid ≃ E := by
  classical
  let lift := incidenceLiftEquiv hb
  have hshift : ∀ a b : E × Fin 2,
      (∃ g : Fin 2,
        (pointAction g (liftedIncidence a.1 a.2).1,
         lineAction g (liftedIncidence a.1 a.2).2) = liftedIncidence b.1 b.2) ↔
      a.1 = b.1 := by decide
  let f (pl : IncidenceLabel) : E := (lift.symm pl).1
  have hf (a b : IncidenceLabel) (h : incidenceOrbitSetoid.r a b) : f a = f b := by
    change ∃ g : Fin 2, (pointAction g a.val.1, lineAction g a.val.2) = b.val at h
    apply (hshift (lift.symm a) (lift.symm b)).mp
    change ∃ g : Fin 2,
      (pointAction g (lift (lift.symm a)).val.1,
       lineAction g (lift (lift.symm a)).val.2) = (lift (lift.symm b)).val
    simpa only [lift.apply_symm_apply] using h
  refine ⟨Quotient.lift f hf, fun e => Quotient.mk _ (lift (e,0)), ?_, ?_⟩
  · intro c
    induction c using Quotient.inductionOn with
    | _ pl =>
      apply Quotient.sound
      have hh := (hshift ((lift.symm pl).1,0) (lift.symm pl)).mpr rfl
      change ∃ g : Fin 2,
        (pointAction g (lift ((lift.symm pl).1,0)).val.1,
         lineAction g (lift ((lift.symm pl).1,0)).val.2) = pl.val
      change ∃ g : Fin 2,
        (pointAction g (lift ((lift.symm pl).1,0)).val.1,
         lineAction g (lift ((lift.symm pl).1,0)).val.2) = (lift (lift.symm pl)).val at hh
      simpa only [lift.apply_symm_apply] using hh
  · intro e
    exact congrArg Prod.fst (lift.symm_apply_apply (e,0))

/-- Supported orbit labels, computed from the actual endpoint maps on selected edges. -/
def pointLabels (J : Finset E) : Finset (Fin 3) := J.image orbitPoint
def lineLabels (J : Finset E) : Finset (Fin 2) := J.image orbitLine

def pointVertex (i : Fin 3) : V := ⟨i.val, by omega⟩
def lineVertex (j : Fin 2) : V := ⟨3+j.val, by omega⟩

/-- The selected cover keeps each incidence as the literal source endpoint pair. -/
def liftedEdges (J : Finset E) : Finset (Point × Line) :=
  (J.product Finset.univ).image (fun es => liftedIncidence es.1 es.2)

def liftedPoints (J : Finset E) : Finset Point := (liftedEdges J).image Prod.fst
def liftedLines (J : Finset E) : Finset Line := (liftedEdges J).image Prod.snd

/-- Transport actual supported point orbits to their first-coordinate labels. -/
def pointOrbitSupport (J : Finset E) : Finset (Fin 3) :=
  (liftedPoints J).image (fun p => pointOrbitEquiv (Quotient.mk _ p))

/-- Transport actual supported line orbits to their first-coordinate labels. -/
def lineOrbitSupport (J : Finset E) : Finset (Fin 2) :=
  (liftedLines J).image (fun l => lineOrbitEquiv (Quotient.mk _ l))

/-- Source-oriented labelled steps: line to point adds gain; reverse traversal subtracts it. -/
def labelledSourceStep (J : Finset E) (u v : V × Fin 2) : Prop :=
  ∃ e ∈ J,
    ((u.1 = lineVertex (orbitLine e) ∧ v.1 = pointVertex (orbitPoint e) ∧
        v.2 = u.2 + gain e) ∨
     (u.1 = pointVertex (orbitPoint e) ∧ v.1 = lineVertex (orbitLine e) ∧
        v.2 = u.2 - gain e))

/-- The subgroup generated by labelled closed source walks at a supported basepoint. -/
def labelledClosedGainSubgroup (J : Finset E) (r : V) : AddSubgroup (Fin 2) :=
  AddSubgroup.closure {g | Relation.ReflTransGen (labelledSourceStep J) (r,0) (r,g)}


/-- Actual supported orbit classes of points in the selected incidence cover. -/
noncomputable def sourcePointSupport (J : Finset E) : Finset (Quotient pointOrbitSetoid) :=
  by
    classical
    exact (liftedPoints J).image (Quotient.mk pointOrbitSetoid)

/-- Actual supported orbit classes of lines in the selected incidence cover. -/
noncomputable def sourceLineSupport (J : Finset E) : Finset (Quotient lineOrbitSetoid) :=
  by
    classical
    exact (liftedLines J).image (Quotient.mk lineOrbitSetoid)

/-- The component's gain subgroup is computed at its supported least root. -/
noncomputable def componentGain (hc : componentBridge) (m : Fin 256)
    (c : SupportedComponent m) : AddSubgroup (Fin 2) :=
  labelledClosedGainSubgroup (decoded m) ((supportedComponentEquiv hc m c).val)

/-- The component weight is the dimension of the actual invariant hyperplane submodule. -/
noncomputable def sourceWeight (hc : componentBridge) (m : Fin 256)
    (c : SupportedComponent m) : ℤ := Module.finrank ℝ (H (componentGain hc m c))

/-- The source inequality quantifies over all actual incidence-orbit subsets, including empty. -/
def sourceSubsetCount (hc : componentBridge) (hi : incidenceBridge) : Prop :=
  ∀ J : Finset (Quotient incidenceOrbitSetoid),
    let edges := J.image (incidenceOrbitEquiv hi)
    let m := maskEquiv.symm edges
    (J.card : ℤ) ≤ (sourcePointSupport edges).card +
      3 * (sourceLineSupport edges).card - ∑ c : SupportedComponent m, sourceWeight hc m c

/-- Literal orbit relations agree with the bundled actual incidence automorphism action. -/
def actualOrbitBridge : Prop :=
  (∀ p q : Point, pointOrbitSetoid.r p q ↔
    ∃ g : Multiplicative (Fin 2), (labelRepresentation g).1 p = q) ∧
  (∀ l k : Line, lineOrbitSetoid.r l k ↔
    ∃ g : Multiplicative (Fin 2), (labelRepresentation g).2 l = k) ∧
  (∀ a b : IncidenceLabel, incidenceOrbitSetoid.r a b ↔
    ∃ g : Multiplicative (Fin 2),
      ((labelRepresentation g).1 a.val.1, (labelRepresentation g).2 a.val.2) = b.val)

/-- The finite walk representation and the actual H-weight source count are connected. -/
def sourceSubsetBridge : Prop := actualOrbitBridge ∧
  (∀ m, labelledSourceStep (decoded m) = gainStep m) ∧
  (∀ m r, labelledClosedGainSubgroup (decoded m) r = closedGainSubgroup m r) ∧
  ∃ hc : componentBridge, ∃ hi : incidenceBridge, sourceSubsetCount hc hi

end FiniteRepresentation

open FiniteRepresentation


set_option maxRecDepth 100000 in
set_option maxHeartbeats 10000000 in
/-- A generic real nontrivial symmetric scene, with supported-component and quotient-cover
bridges, the exact closed-walk balance equivalence and an integer count certificate.
The actual invariant hyperplane submodule, orthogonal action and full equality are included.
The actual source orbit-subset/component sum is included.
These data provide the actual labelled witness used in the general source refutation. -/
noncomputable def witnessData : sourceActionBridge ∧ invariantBridge ∧ sourceParameterBridge ∧
    sourceFullCount ∧ componentBridge ∧ incidenceBridge ∧ balanceSound ∧
    (∀ m r, closedGainSubgroup m r = ⊥ → balancedAt m r = true) ∧ countCondition ∧ FiniteRepresentation.sourceSubsetBridge ∧
    ∃ z : Fin 6 → ℝ, AlgebraicIndependent ℚ z ∧ equivariantPicture z ∧ sourceGenericPicture z ∧ ¬ sourceFlatPicture z ∧
      ∃ y : Point → ℝ, ∃ n : Line → ℝ × ℝ, ∃ h : Line → ℝ,
        symmetricScene z y n h ∧ sourceScene z y n h ∧ normalComparison n ∧ ¬ trivialScene n h := by
  have hinvariant : invariantBridge := by
    have hgeometric (g : Fin 2) (p q : Parameters) :
        q ∈ hyperplane (parameterAction g p) ↔ parameterAction g q ∈ hyperplane p := by
      fin_cases g <;> simp [hyperplane, parameterAction, neg_mul, mul_neg]
    have hgeometry (K : AddSubgroup (Fin 2)) (p : Parameters) :
        sourceInvariant K p ↔ ∀ g ∈ K, ∀ q : Parameters,
          parameterAction g q ∈ hyperplane p ↔ q ∈ hyperplane p := by
      have hh (g : Fin 2) : (parameterAction g p).2 = p.2 := by
        by_cases hg0 : g = 0 <;> simp [parameterAction, hg0]
      constructor
      · intro hp g hg q
        rw [← hgeometric]
        simpa only [hyperplane, Set.mem_ofPred_eq, hh g] using hp g hg q.1.1 q.1.2 q.2
      · intro hp g hg x₁ x₂ y
        have h := hp g hg ((x₁,x₂),y)
        rw [← hgeometric] at h
        simpa only [hyperplane, Set.mem_ofPred_eq, Prod.fst, Prod.snd, hh g] using h
    have hmem (K : AddSubgroup (Fin 2)) (p : Parameters) :
        p ∈ H K ↔ ∀ g ∈ K, parameterAction g p = p := by
      simp [H, LinearMap.mem_fixedSubmodule_iff]
    have hsource (K : AddSubgroup (Fin 2)) (p : Parameters) :
        sourceInvariant K p ↔ p ∈ H K := by
      rw [hmem]
      constructor
      · intro hp g hg
        have h₁ := (hp g hg 1 0 (-(p.1.1 + p.2))).mpr (by ring)
        have h₂ := (hp g hg 0 1 (-(p.1.2 + p.2))).mpr (by ring)
        have hn₁ : (parameterAction g p).1.1 = p.1.1 := by linarith
        have hn₂ : (parameterAction g p).1.2 = p.1.2 := by linarith
        have hh : (parameterAction g p).2 = p.2 := by
          by_cases hg0 : g = 0 <;> simp [parameterAction, hg0]
        exact Prod.ext (Prod.ext hn₁ hn₂) hh
      · intro hp g hg x₁ x₂ y
        rw [hp g hg]
    have hbot : H ⊥ = ⊤ := by
      ext p
      simp [hmem, parameterAction]
    have hnonbot (K : AddSubgroup (Fin 2)) (hK : K ≠ ⊥) :
        H K = LinearMap.ker (LinearMap.fst ℝ (ℝ × ℝ) ℝ) := by
      have hOne : (1 : Fin 2) ∈ K := by
        rcases K.bot_or_exists_ne_zero with h | ⟨g, hg, hne⟩
        · exact (hK h).elim
        · fin_cases g
          · exact (hne rfl).elim
          · exact hg
      ext p
      rw [hmem]
      simp only [LinearMap.mem_ker, LinearMap.fst_apply]
      constructor
      · intro hp
        have hn := hp 1 hOne
        have h₁ := congrArg (fun q : Parameters => q.1.1) hn
        have h₂ := congrArg (fun q : Parameters => q.1.2) hn
        simp [parameterAction] at h₁ h₂
        exact Prod.ext (by change p.1.1 = 0; linarith) (by change p.1.2 = 0; linarith)
      · intro hp g hg
        rcases p with ⟨⟨a,b⟩,h⟩
        have ha : a = 0 := congrArg Prod.fst hp
        have hb : b = 0 := congrArg Prod.snd hp
        simp [parameterAction, ha, hb]
    refine ⟨?_, hgeometric, hgeometry, ?_, hsource, ?_, ?_⟩
    · intro p
      simp [parameterAction]
    · intro g k p
      fin_cases g <;> fin_cases k <;> simp [parameterAction]
    · rw [hbot, finrank_top]
      simp [Parameters, Module.finrank_prod, Module.finrank_self]
    · intro K hK
      rw [hnonbot K hK, LinearMap.ker_fst]
      calc
        Module.finrank ℝ (LinearMap.range (LinearMap.inr ℝ (ℝ × ℝ) ℝ)) =
            Module.finrank ℝ ℝ :=
          LinearMap.finrank_range_of_inj
            (LinearMap.inr_injective (R := ℝ) (M := ℝ × ℝ) (M₂ := ℝ))
        _ = 1 := Module.finrank_self ℝ
  have haction : sourceActionBridge := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro g k hk
      have hh := congrArg (fun a => a.1 (0, 0)) hk
      have he : g.toAdd = k.toAdd := by
        simpa [labelRepresentation, pointPermutation, pointAction] using congrArg Prod.snd hh
      exact congrArg Multiplicative.ofAdd he
    · intro g p l
      change incidence (pointAction g.toAdd p) (lineAction g.toAdd l) ↔ incidence p l
      simp [incidence, pointAction, lineAction]
    · intro g v
      fin_cases g <;> ext i <;> fin_cases i <;> simp [tau, planeVector, copySign]
    · intro g
      rfl
  have hparameters : sourceParameterBridge := by
    refine ⟨?_, ?_, ?_⟩
    · intro p q hpq
      have h0 : ((0, 0), -p.2) ∈ hyperplane q := by
        rw [← hpq]
        simp [hyperplane]
      have h1 : ((1, 0), -(p.1.1 + p.2)) ∈ hyperplane q := by
        rw [← hpq]
        simp [hyperplane]
      have h2 : ((0, 1), -(p.1.2 + p.2)) ∈ hyperplane q := by
        rw [← hpq]
        simp [hyperplane]
      simp [hyperplane] at h0 h1 h2
      exact Prod.ext (Prod.ext (by linarith) (by linarith)) (by linarith)
    · intro g p
      fin_cases g <;> ext i <;> fin_cases i <;>
        simp [parameterAction, planeVector, tau, chi]
    · intro g p
      fin_cases g <;> simp [parameterAction, chi]
  have hdiag (m : Fin 256) (k : Nat) (u : V) : reach m k u u = true := by
    induction k with
    | zero => simp [reach]
    | succ k ih => simp [reach, ih]
  have hclosed : ∀ m : Fin 256, ∀ r u v : V,
      reach m 5 r u = true → adjacent m u v = true → reach m 5 r v = true := by
    intro m
    rcases m with ⟨m, hm⟩
    interval_cases m <;> decide +revert
  have hsound (m : Fin 256) (k : Nat) : ∀ u v : V,
      reach m k u v = true → sourceReach m u v := by
    induction k with
    | zero =>
      intro u v h
      have huv : u = v := by simpa [reach] using h
      subst v
      exact .refl
    | succ k ih =>
      intro u v h
      simp only [reach, Bool.or_eq_true, decide_eq_true_eq] at h
      rcases h with h | ⟨w, hr, ha⟩
      · exact ih u v h
      · exact (ih u w hr).tail ha
  have hreach (m : Fin 256) (u v : V) :
      reach m 5 u v = true ↔ sourceReach m u v := by
    constructor
    · exact hsound m 5 u v
    · intro h
      induction h with
      | refl => exact hdiag m 5 u
      | @tail w v hw ha ih => exact hclosed m u w v ih ha
  have hroot (m : Fin 256) (v : V) : root m v = true ↔ sourceRoot m v := by
    simp only [root, decide_eq_true_eq, sourceRoot, hreach]
  have hcomponents : componentBridge := by
    refine ⟨hreach, hroot, ?_⟩
    have hfinite : ∀ m : Fin 256, ∀ v : V, active m v = true →
        ∃! r, root m r = true ∧ reach m 5 r v = true := by
      intro m
      rcases m with ⟨m, hm⟩
      interval_cases m <;> unfold ExistsUnique <;> decide +revert
    intro m v hv
    simpa only [hroot, hreach] using hfinite m v hv
  have hprojection (m : Fin 256) (u v : V × Fin 2)
      (hw : Relation.ReflTransGen (gainStep m) u v) : sourceReach m u.1 v.1 := by
    apply Relation.ReflTransGen.lift Prod.fst ?_ u v hw
    intro a b h
    rcases h with ⟨e, he, hor, hg⟩
    apply decide_eq_true
    refine ⟨e, he, ?_⟩
    rcases hor with ⟨ha, hb⟩ | ⟨ha, hb⟩
    · exact Or.inl ⟨ha.symm, hb.symm⟩
    · exact Or.inr ⟨hb.symm, ha.symm⟩
  have hbalance : balanceSound := by
    intro m r hb
    obtain ⟨q, hq⟩ := of_decide_eq_true hb
    have halgebra : ∀ a b s t g : Fin 2,
        a.val + b.val ≡ g.val [MOD 2] → t = s + g → b + t = a + s := by decide
    have hinvariant (v : V × Fin 2) (hw :
        Relation.ReflTransGen (gainStep m) (r, 0) v) : q v.1 + v.2 = q r := by
      induction hw with
      | refl => simp
      | @tail u v hu hs ih =>
        rcases hs with ⟨e, he, hor, hg⟩
        have huReach := hprojection m (r, 0) u hu
        have hedge : adjacent m u.1 v.1 = true := by
          apply decide_eq_true
          refine ⟨e, he, ?_⟩
          rcases hor with ⟨ha, hb⟩ | ⟨ha, hb⟩
          · exact Or.inl ⟨ha.symm, hb.symm⟩
          · exact Or.inr ⟨hb.symm, ha.symm⟩
        have hfirst : reach m 5 r (ends e).1 = true := by
          apply (hreach m r (ends e).1).mpr
          rcases hor with ⟨ha, hb⟩ | ⟨ha, hb⟩
          · simpa only [Prod.fst] using ha ▸ huReach
          · simpa only [Prod.fst] using hb ▸ huReach.tail hedge
        have hmod := hq e he hfirst
        have hpair : q v.1 + v.2 = q u.1 + u.2 := by
          rcases hor with ⟨ha, hb⟩ | ⟨ha, hb⟩
          · rw [ha, hb]
            exact halgebra _ _ _ _ _ hmod hg
          · rw [ha, hb]
            exact halgebra _ _ _ _ _ (by simpa only [Nat.add_comm] using hmod) hg
        exact hpair.trans ih
    apply le_antisymm
    · apply (AddSubgroup.closure_le _).mpr
      intro g hg
      have hg0 : g = 0 := by
        have hi := hinvariant (r, g) hg
        apply add_left_cancel (a := q r)
        simpa only [Prod.fst, Prod.snd, add_zero] using hi
      subst g
      exact (⊥ : AddSubgroup (Fin 2)).zero_mem
    · exact bot_le
  have hreverse : ∀ m r, closedGainSubgroup m r = ⊥ → balancedAt m r = true := by
    classical
    intro m r hbot
    have htwo : ∀ a b : Fin 2, a + b + b = a := by decide
    have hzero : ∀ a b : Fin 2, a + b = 0 → a = b := by decide
    have hmod : ∀ a b g : Fin 2, b = a + g →
        a.val + b.val ≡ g.val [MOD 2] := by decide
    have hswap (u v : V × Fin 2) (hs : gainStep m u v) : gainStep m v u := by
      rcases hs with ⟨e, he, hor, hg⟩
      refine ⟨e, he, hor.elim (fun h => Or.inr ⟨h.2, h.1⟩)
        (fun h => Or.inl ⟨h.2, h.1⟩), ?_⟩
      rw [hg]
      exact (htwo u.2 (gain e)).symm
    letI : Std.Symm (gainStep m) := ⟨hswap⟩
    have hshift (c : Fin 2) (u v : V × Fin 2)
        (hw : Relation.ReflTransGen (gainStep m) u v) :
        Relation.ReflTransGen (gainStep m) (u.1, u.2 + c) (v.1, v.2 + c) := by
      apply Relation.ReflTransGen.lift (fun x : V × Fin 2 => (x.1, x.2 + c)) ?_ u v hw
      intro a b hs
      rcases hs with ⟨e, he, hor, hg⟩
      refine ⟨e, he, hor, ?_⟩
      change b.2 + c = (a.2 + c) + gain e
      rw [hg]
      ac_rfl
    have hlift (v : V) (hv : sourceReach m r v) : ∃ g, gainWalk m r v g := by
      induction hv with
      | refl => exact ⟨0, .refl⟩
      | @tail u v hu ha ih =>
        obtain ⟨g, hg⟩ := ih
        obtain ⟨e, he, hor⟩ := of_decide_eq_true ha
        refine ⟨g + gain e, hg.tail ?_⟩
        exact ⟨e, he, hor.elim (fun h => Or.inl ⟨h.1.symm, h.2.symm⟩)
          (fun h => Or.inr ⟨h.2.symm, h.1.symm⟩), rfl⟩
    have hunique (v : V) (g h : Fin 2) (hg : gainWalk m r v g)
        (hh : gainWalk m r v h) : g = h := by
      have hback := hshift (g + h) (v, h) (r, 0) (symm hh)
      have hstart : h + (g + h) = g := by
        rw [← add_assoc, add_comm h g]
        exact htwo g h
      have hloop : gainWalk m r r (g + h) := by
        apply hg.trans
        simpa only [Prod.fst, Prod.snd, hstart, zero_add] using hback
      have hmem : g + h ∈ closedGainSubgroup m r := AddSubgroup.subset_closure hloop
      rw [hbot, AddSubgroup.mem_bot] at hmem
      exact hzero g h hmem
    let q : V → Fin 2 := fun v => if hv : sourceReach m r v then
      Classical.choose (hlift v hv) else 0
    have hq (v : V) (hv : sourceReach m r v) : gainWalk m r v (q v) := by
      dsimp only [q]
      rw [dif_pos hv]
      exact Classical.choose_spec (hlift v hv)
    apply decide_eq_true
    refine ⟨q, ?_⟩
    intro e he hu
    have hru := (hreach m r (ends e).1).mp hu
    have hedge : adjacent m (ends e).1 (ends e).2 = true := by
      apply decide_eq_true
      exact ⟨e, he, Or.inl ⟨rfl, rfl⟩⟩
    have hrv := hru.tail hedge
    have hpath : gainWalk m r (ends e).2 (q (ends e).1 + gain e) :=
      (hq (ends e).1 hru).tail ⟨e, he, Or.inl ⟨rfl, rfl⟩, rfl⟩
    exact hmod _ _ _ (hunique (ends e).2 _ _ (hq (ends e).2 hrv) hpath)
  have hcoverSound (k : Nat) : ∀ u v : CoverVertex, coverReach k u v = true →
      Relation.ReflTransGen (fun a b => coverAdjacent a b = true) u v := by
    induction k with
    | zero =>
      intro u v h
      have huv : u = v := by simpa [coverReach] using h
      subst v
      exact .refl
    | succ k ih =>
      intro u v h
      simp only [coverReach, Bool.or_eq_true, decide_eq_true_eq] at h
      rcases h with h | ⟨w, hr, ha⟩
      · exact ih u v h
      · exact (ih u w hr).tail ha
  have hcoverFinite : ∀ u v : CoverVertex, coverReach 4 u v = true := by decide
  have hincidences : incidenceBridge := by
    refine ⟨by decide, by decide, by decide, by decide, by decide, by decide,
      by decide, by decide, by decide, by decide, ?_⟩
    intro u v
    exact hcoverSound 4 u v (hcoverFinite u v)
  have hcounts : countCondition := by
    intro m
    rcases m with ⟨m, hm⟩
    interval_cases m <;> unfold subsetInequality <;> decide +revert
  have hfullCount : sourceFullCount := by
    have hglobal : Module.finrank ℝ (H ⊤) = 1 :=
      hinvariant.2.2.2.2.2.2 ⊤ top_ne_bot
    unfold sourceFullCount
    rw [hincidences.2.2.2.2.2.2.1, hglobal]
    norm_num [Fintype.card_prod]
  classical
  have hpoint_support (J : Finset E) : pointOrbitSupport J = pointLabels J := by
    ext i
    simp only [pointOrbitSupport, liftedPoints, liftedEdges, pointLabels,
      Finset.mem_image]
    constructor
    · rintro ⟨p, ⟨pl, ⟨⟨e,s⟩, he, rfl⟩, rfl⟩, h⟩
      exact ⟨e, (Finset.mem_product.mp he).1, h⟩
    · rintro ⟨e, he, h⟩
      exact ⟨(liftedIncidence e 0).1,
        ⟨liftedIncidence e 0, ⟨(e,0), Finset.mem_product.mpr ⟨he, Finset.mem_univ _⟩, rfl⟩, rfl⟩, h⟩

  have hline_support (J : Finset E) : lineOrbitSupport J = lineLabels J := by
    ext i
    simp only [lineOrbitSupport, liftedLines, liftedEdges, lineLabels,
      Finset.mem_image]
    constructor
    · rintro ⟨l, ⟨pl, ⟨⟨e,s⟩, he, rfl⟩, rfl⟩, h⟩
      exact ⟨e, (Finset.mem_product.mp he).1, h⟩
    · rintro ⟨e, he, h⟩
      exact ⟨(liftedIncidence e 0).2,
        ⟨liftedIncidence e 0, ⟨(e,0), Finset.mem_product.mpr ⟨he, Finset.mem_univ _⟩, rfl⟩, rfl⟩, h⟩

  have hsupport_card (m : Fin 256) :
      (pointLabels (decoded m)).card = (pSupport m).card ∧
      (lineLabels (decoded m)).card = (lSupport m).card := by
    have hs : (pointLabels (decoded m)).image pointVertex = pSupport m ∧
        (lineLabels (decoded m)).image lineVertex = lSupport m := by
      rcases m with ⟨m, hm⟩
      interval_cases m <;> decide +revert
    have hp : Function.Injective pointVertex := by
      intro i j h
      exact Fin.ext (congrArg (fun v : V => v.val) h)
    have hl : Function.Injective lineVertex := by
      intro i j h
      apply Fin.ext
      have := congrArg Fin.val h
      dsimp [lineVertex] at this
      omega
    constructor
    · rw [← hs.1, Finset.card_image_of_injective _ hp]
    · rw [← hs.2, Finset.card_image_of_injective _ hl]

  have hcount_components (m : Fin 256) (W : SupportedComponent m → ℤ)
      (hd : ∀ r : ↥(rootSet m),
        W ((supportedComponentEquiv hcomponents m).symm r) = (hdim m r.val : ℤ)) :
      ((decoded m).card : ℤ) ≤
        (pSupport m).card + 3 * (lSupport m).card - ∑ c : SupportedComponent m, W c := by
    have hs : (∑ c : SupportedComponent m, W c) =
        ∑ r ∈ rootSet m, (hdim m r : ℤ) := by
      calc
        (∑ c : SupportedComponent m, W c) = ∑ r : ↥(rootSet m), (hdim m r.val : ℤ) :=
          (Fintype.sum_equiv (supportedComponentEquiv hcomponents m).symm
            (fun r => (hdim m r.val : ℤ)) W (fun r => (hd r).symm)).symm
        _ = ∑ r ∈ rootSet m, (hdim m r : ℤ)  :=
          Finset.sum_coe_sort (rootSet m) (fun r : V => (hdim m r : ℤ))
    rw [hs]
    exact hcounts m


  have hlabel_step (m : Fin 256) : labelledSourceStep (decoded m) = gainStep m := by
    have he : ∀ e : E, ends e = (lineVertex (orbitLine e), pointVertex (orbitPoint e)) := by decide
    have hr : ∀ a b : Fin 2, a-b = a+b := by decide
    funext u v
    apply propext
    simp only [labelledSourceStep, decoded, Finset.mem_filter, Finset.mem_univ, true_and,
      gainStep, he, hr]
    constructor
    · rintro ⟨e, hs, ⟨hu,hv,hg⟩ | ⟨hu,hv,hg⟩⟩
      · exact ⟨e, hs, Or.inl ⟨hu,hv⟩, hg⟩
      · exact ⟨e, hs, Or.inr ⟨hu,hv⟩, hg⟩
    · rintro ⟨e, hs, ⟨hu,hv⟩ | ⟨hu,hv⟩, hg⟩
      · exact ⟨e, hs, Or.inl ⟨hu,hv,hg⟩⟩
      · exact ⟨e, hs, Or.inr ⟨hu,hv,hg⟩⟩

  have hclosed_gains (m : Fin 256) (r : V)
      : labelledClosedGainSubgroup (decoded m) r = closedGainSubgroup m r := by
    simp only [labelledClosedGainSubgroup, closedGainSubgroup, gainWalk, hlabel_step m]


  have hsourceWeight (m : Fin 256) (r : ↥(rootSet m)) :
      sourceWeight hcomponents m ((supportedComponentEquiv hcomponents m).symm r) =
        (hdim m r.val : ℤ) := by
    unfold sourceWeight componentGain
    rw [(supportedComponentEquiv hcomponents m).apply_symm_apply, hclosed_gains]
    unfold hdim
    split_ifs with hb
    · rw [hbalance m r.val hb, hinvariant.2.2.2.2.2.1]
    · have hn : closedGainSubgroup m r.val ≠ ⊥ := by
        intro hk
        exact hb (hreverse m r.val hk)
      rw [hinvariant.2.2.2.2.2.2 _ hn]

  have hsourceSubset : sourceSubsetCount hcomponents hincidences := by
    intro J
    let edges := J.image (incidenceOrbitEquiv hincidences)
    let m := maskEquiv.symm edges
    have hm : decoded m = edges := maskEquiv.apply_symm_apply edges
    have hc := hcount_components m (sourceWeight hcomponents m) (hsourceWeight m)
    have hp : (sourcePointSupport edges).card = (pSupport m).card := by
      have ht : (sourcePointSupport edges).image pointOrbitEquiv = pointOrbitSupport edges := by
        ext i
        simp only [sourcePointSupport, pointOrbitSupport, Finset.mem_image]
        constructor
        · rintro ⟨c, ⟨p, hp, rfl⟩, he⟩
          exact ⟨p, hp, he⟩
        · rintro ⟨p, hp, he⟩
          exact ⟨Quotient.mk pointOrbitSetoid p, ⟨p, hp, rfl⟩, he⟩
      rw [← Finset.card_image_of_injective _ pointOrbitEquiv.injective, ht,
        hpoint_support, ← hm]
      exact (hsupport_card m).1
    have hl : (sourceLineSupport edges).card = (lSupport m).card := by
      have ht : (sourceLineSupport edges).image lineOrbitEquiv = lineOrbitSupport edges := by
        ext i
        simp only [sourceLineSupport, lineOrbitSupport, Finset.mem_image]
        constructor
        · rintro ⟨c, ⟨l, hl, rfl⟩, he⟩
          exact ⟨l, hl, he⟩
        · rintro ⟨l, hl, he⟩
          exact ⟨Quotient.mk lineOrbitSetoid l, ⟨l, hl, rfl⟩, he⟩
      rw [← Finset.card_image_of_injective _ lineOrbitEquiv.injective, ht,
        hline_support, ← hm]
      exact (hsupport_card m).2
    have hcard : J.card = (decoded m).card := by
      rw [hm]
      exact (Finset.card_image_of_injective J (incidenceOrbitEquiv hincidences).injective).symm
    change (J.card : ℤ) ≤ (sourcePointSupport edges).card +
      3 * (sourceLineSupport edges).card - ∑ c : SupportedComponent m, sourceWeight hcomponents m c
    rw [hp, hl, hcard]
    exact hc
  have hsubsetBridge : sourceSubsetBridge := by
    refine ⟨?_, hlabel_step, hclosed_gains, hcomponents, hincidences, hsourceSubset⟩
    refine ⟨?_, ?_, ?_⟩
    · intro p q
      constructor
      · rintro ⟨g, hg⟩
        exact ⟨Multiplicative.ofAdd g, hg⟩
      · rintro ⟨g, hg⟩
        exact ⟨g.toAdd, hg⟩
    · intro l k
      constructor
      · rintro ⟨g, hg⟩
        exact ⟨Multiplicative.ofAdd g, hg⟩
      · rintro ⟨g, hg⟩
        exact ⟨g.toAdd, hg⟩
    · intro a b
      constructor
      · rintro ⟨g, hg⟩
        exact ⟨Multiplicative.ofAdd g, hg⟩
      · rintro ⟨g, hg⟩
        exact ⟨g.toAdd, hg⟩
  refine ⟨haction, hinvariant, hparameters, hfullCount, hcomponents, hincidences,
    hbalance, hreverse, hcounts, hsubsetBridge, ?_⟩
  have hreal : ¬ Algebra.IsAlgebraic ℚ ℝ := by
    intro h
    have hc := Algebra.IsAlgebraic.cardinalMk_le_max ℚ ℝ
    have hq : #ℚ ≤ ℵ₀ := Cardinal.mk_le_aleph0
    have hbound : #ℝ ≤ ℵ₀ := by
      calc
        #ℝ ≤ max #ℚ ℵ₀ := hc
        _ = ℵ₀ := max_eq_right hq
    exact (not_le_of_gt (Cardinal.aleph0_lt_mk (α := ℝ))) hbound
  have hgeneric : ∃ x : Fin 6 → ℝ, AlgebraicIndependent ℚ x := by
    obtain ⟨ι, x, hx⟩ := exists_isTranscendenceBasis' ℚ ℝ
    have htr : Algebra.Transcendental ℚ ℝ :=
      Algebra.transcendental_iff_not_isAlgebraic.mpr hreal
    haveI : Nonempty ι := hx.nonempty_iff_transcendental.mpr htr
    have hcard : #ℝ = #ℚ ⊔ #ι ⊔ ℵ₀ := by
      simpa using hx.lift_cardinalMk_eq_max_lift
    have hinf : Infinite ι := by
      apply Cardinal.infinite_iff.mpr
      by_contra hlt
      have hι : #ι ≤ ℵ₀ := (lt_of_not_ge hlt).le
      have hq : #ℚ ≤ ℵ₀ := Cardinal.mk_le_aleph0
      have hbound : #ℝ ≤ ℵ₀ := by
        rw [hcard]
        exact max_le (max_le hq hι) le_rfl
      exact (not_le_of_gt (Cardinal.aleph0_lt_mk (α := ℝ))) hbound
    letI : Infinite ι := hinf
    let f : Fin 6 → ι := fun i => Infinite.natEmbedding ι i.val
    have hf : Function.Injective f :=
      (Infinite.natEmbedding ι).injective.comp Fin.val_injective
    exact ⟨x ∘ f, hx.1.comp f hf⟩
  obtain ⟨z, hz⟩ := hgeneric
  have hequiv : equivariantPicture z := by
    intro g p
    fin_cases g <;> fin_cases p <;>
      simp [equivariantPicture, picture, pointAction, basePoint, copySign]
  have hsourceGeneric : sourceGenericPicture z := by
    constructor
    · intro g p
      rw [hequiv g p]
      exact (haction.2.2.1 g (picture z p)).symm
    · have hc : representativeCoordinates z = z ∘ representativeIndex := by
        funext ik
        fin_cases ik <;>
          simp [representativeCoordinates, picture, basePoint, copySign,
            representativeIndex, finProdFinEquiv]
      rw [hc]
      exact hz.comp representativeIndex representativeIndex.injective
  let y : Point → ℝ := sceneHeight z
  let n : Line → ℝ × ℝ := sceneNormal z
  let h : Line → ℝ := fun _ => 0
  have hscene : symmetricScene z y n h := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro p l hp
      fin_cases p <;> fin_cases l <;>
        simp [incidence, sceneEquation, picture, basePoint, sceneNormal, sceneHeight,
          copySign, y, n, h] at hp ⊢
      all_goals ring
    · intro i j
      fin_cases i <;> rfl
    · intro j
      fin_cases j <;> simp [n, sceneNormal, copySign]
    · intro j
      rfl
  have hsourceScene : sourceScene z y n h := by
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro p l hp
      exact hscene.1 p l hp
    · intro g p
      fin_cases g <;> fin_cases p <;> simp [pointAction, sceneHeight, y, chi]
    · intro g l
      fin_cases g <;> fin_cases l <;> ext i <;> fin_cases i <;>
        simp [lineAction, sceneNormal, n, tau, chi, planeVector, copySign]
    · intro g l
      simp [h, chi]
    · intro l hn
      have hh := congrArg Prod.snd hn
      norm_num at hh
  have hnontrivial : ¬ trivialScene n h := by
    intro ht
    have hn := ht.1 (0, 0) (0, 1)
    have ha : z 0 = 0 := by
      have hh := congrArg Prod.snd hn
      simp [n, sceneNormal, copySign] at hh
      linarith
    exact hz.ne_zero 0 ha
  refine ⟨z, hz, hequiv, hsourceGeneric, ?_, y, n, h, hscene, hsourceScene, ?_, hnontrivial⟩
  · intro hflat
    exact hnontrivial (hflat y n h hsourceScene)
  · intro j k
    refine ⟨rfl, rfl, ?_⟩
    intro heq
    have hh := congrArg Prod.snd heq
    have ha : z 0 = 0 := by
      simp [n, sceneNormal, copySign] at hh
      linarith
    exact hz.ne_zero 0 ha

