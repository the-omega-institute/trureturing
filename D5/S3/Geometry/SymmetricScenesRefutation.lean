namespace OriginalSource

variable {G P L : Type} [Group G] [Fintype G] [Fintype P] [Fintype L]

/-- Finite connected incidence geometry with the source's free labelled symmetry.
The degree condition is the standing hypothesis for d-scenes. -/
structure IncidenceGeometry (d : ℕ) (G P L : Type) [Group G] [Fintype G]
    [Fintype P] [Fintype L] where
  dimension : 2 ≤ d
  incidence : P → L → Prop
  labels : G →* (Equiv.Perm P × Equiv.Perm L)
  preserves : ∀ g p l, incidence ((labels g).1 p) ((labels g).2 l) ↔ incidence p l
  faithful : Function.Injective labels
  freePoints : ∀ g p, (labels g).1 p = p → g = 1
  freeLines : ∀ g l, (labels g).2 l = l → g = 1
  nonemptyVertices : Nonempty (P ⊕ L)
  connected : ∀ u v : P ⊕ L, Relation.ReflTransGen
    (fun a b => match a, b with
      | Sum.inl p, Sum.inr l => incidence p l
      | Sum.inr l, Sum.inl p => incidence p l
      | _, _ => False) u v
  degree : ∀ l : L, d ≤ Nat.card {p : P // incidence p l}

variable {d : ℕ} (S : IncidenceGeometry d G P L)

abbrev Space (d : ℕ) := EuclideanSpace ℝ (Fin (d - 1))

/-- The orthogonal picture action and real unit sign character, as in §3.2. -/
structure Symmetry (d : ℕ) (G : Type) [Group G] where
  tau : G →* (Space d ≃ₗᵢ[ℝ] Space d)
  chi : G →* ℝˣ
  sign : ∀ g, (chi g : ℝ) = 1 ∨ (chi g : ℝ) = -1

namespace IncidenceGeometry

abbrev pointAction : MulAction G P :=
  MulAction.compHom P ((MonoidHom.fst _ _).comp S.labels)

abbrev lineAction : MulAction G L :=
  MulAction.compHom L ((MonoidHom.snd _ _).comp S.labels)

def pointOrbits : Setoid P := by
  letI := S.pointAction
  exact MulAction.orbitRel G P

def lineOrbits : Setoid L := by
  letI := S.lineAction
  exact MulAction.orbitRel G L

abbrev PointOrbit := Quotient S.pointOrbits
abbrev LineOrbit := Quotient S.lineOrbits
abbrev Incidence := {pl : P × L // S.incidence pl.1 pl.2}

/-- The induced permutation of actual incidences retains both endpoint labels. -/
def incidencePermutation (g : G) : Equiv.Perm S.Incidence where
  toFun e := ⟨((S.labels g).1 e.val.1, (S.labels g).2 e.val.2),
    (S.preserves g _ _).mpr e.property⟩
  invFun e := ⟨((S.labels g⁻¹).1 e.val.1, (S.labels g⁻¹).2 e.val.2),
    (S.preserves g⁻¹ _ _).mpr e.property⟩
  left_inv e := by
    apply Subtype.ext
    change ((S.labels g⁻¹).1 ((S.labels g).1 e.val.1),
      (S.labels g⁻¹).2 ((S.labels g).2 e.val.2)) = e.val
    rw [map_inv]
    exact Prod.ext ((S.labels g).1.symm_apply_apply _) ((S.labels g).2.symm_apply_apply _)
  right_inv e := by
    apply Subtype.ext
    change ((S.labels g).1 ((S.labels g⁻¹).1 e.val.1),
      (S.labels g).2 ((S.labels g⁻¹).2 e.val.2)) = e.val
    rw [map_inv]
    exact Prod.ext ((S.labels g).1.apply_symm_apply _) ((S.labels g).2.apply_symm_apply _)

def incidenceRepresentation : G →* Equiv.Perm S.Incidence where
  toFun := S.incidencePermutation
  map_one' := by ext e : 1; apply Subtype.ext; simp [incidencePermutation]
  map_mul' g k := by ext e : 1; apply Subtype.ext; simp [incidencePermutation, map_mul]

def incidenceOrbits : Setoid S.Incidence := by
  letI := MulAction.compHom S.Incidence S.incidenceRepresentation
  exact MulAction.orbitRel G S.Incidence

abbrev IncidenceOrbit := Quotient S.incidenceOrbits

noncomputable instance : Fintype S.PointOrbit := Fintype.ofFinite _
noncomputable instance : Fintype S.LineOrbit := Fintype.ofFinite _
noncomputable instance : Fintype S.Incidence := Fintype.ofFinite _
noncomputable instance : Fintype S.IncidenceOrbit := Fintype.ofFinite _

def edgePoint : S.IncidenceOrbit → S.PointOrbit :=
  Quotient.lift (fun e => Quotient.mk S.pointOrbits e.val.1) (by
    intro a b hab
    apply Quotient.sound
    obtain ⟨g, hg⟩ := hab
    exact ⟨g, congrArg (fun e : S.Incidence => e.val.1) hg⟩)

def edgeLine : S.IncidenceOrbit → S.LineOrbit :=
  Quotient.lift (fun e => Quotient.mk S.lineOrbits e.val.2) (by
    intro a b hab
    apply Quotient.sound
    obtain ⟨g, hg⟩ := hab
    exact ⟨g, congrArg (fun e : S.Incidence => e.val.2) hg⟩)

/-- A choice of actual orbit representatives and their literal line-to-point gains.
The realization equality identifies each gain edge with its actual incidence orbit. -/
structure GainChart where
  pointRepresentative : S.PointOrbit → P
  lineRepresentative : S.LineOrbit → L
  pointSection : ∀ p, Quotient.mk S.pointOrbits (pointRepresentative p) = p
  lineSection : ∀ l, Quotient.mk S.lineOrbits (lineRepresentative l) = l
  gain : S.IncidenceOrbit → G
  realizes : ∀ e, ∃ h : S.incidence
      ((S.labels (gain e)).1 (pointRepresentative (S.edgePoint e)))
      (lineRepresentative (S.edgeLine e)),
    Quotient.mk S.incidenceOrbits
      ⟨((S.labels (gain e)).1 (pointRepresentative (S.edgePoint e)),
        lineRepresentative (S.edgeLine e)), h⟩ = e

end IncidenceGeometry

variable (A : Symmetry d G)

namespace Symmetry

/-- Induced action on normalized hyperplane parameters (n,h). -/
noncomputable def parameterMap (g : G) : (Space d × ℝ) →ₗ[ℝ] (Space d × ℝ) :=
  LinearMap.prodMap ((A.chi g : ℝ) • (A.tau g).toLinearEquiv.toLinearMap)
    ((A.chi g : ℝ) • LinearMap.id)

/-- Actual invariant-hyperplane parameter subspace, rather than a dimension-valued proxy. -/
noncomputable def invariantParameters (K : Subgroup G) : Submodule ℝ (Space d × ℝ) :=
  ⨅ g : K, (A.parameterMap g.val).fixedSubmodule

end Symmetry

namespace IncidenceGeometry

variable (C : S.GainChart)

def symmetricPicture (x : P → Space d) : Prop :=
  ∀ g p, x ((S.labels g).1 p) = A.tau g (x p)

def genericPicture (x : P → Space d) : Prop :=
  S.symmetricPicture A x ∧
    AlgebraicIndependent ℚ (fun ik : S.PointOrbit × Fin (d - 1) =>
      x (C.pointRepresentative ik.1) ik.2)

/-- The literal affine equation with final normal coefficient one. -/
def scene (I : P → L → Prop) (x : P → Space d)
    (y : P → ℝ) (n : L → Space d) (h : L → ℝ) : Prop :=
  (∀ p l, I p l → inner ℝ (n l) (x p) + y p + h l = 0) ∧
  (∀ g p, y ((S.labels g).1 p) = (A.chi g : ℝ) * y p) ∧
  (∀ g l, n ((S.labels g).2 l) = (A.chi g : ℝ) • A.tau g (n l)) ∧
  (∀ g l, h ((S.labels g).2 l) = (A.chi g : ℝ) * h l)

def trivial (n : L → Space d) (h : L → ℝ) : Prop :=
  (∀ l k, n l = n k) ∧ ∀ l k, h l = h k

/-- Scene data with their literal incidence and symmetry equations. -/
structure LiftedScene (I : P → L → Prop) (x : P → Space d) where
  height : P → ℝ
  normal : L → Space d
  constant : L → ℝ
  equations : S.scene A I x height normal constant

def flat (I : P → L → Prop) (x : P → Space d) : Prop :=
  ∀ y n h, S.scene A I x y n h → trivial n h

/-- Literal incidence deletion in the definition of minimal flatness in §2.1. -/
def minimallyFlat (x : P → Space d) : Prop :=
  S.flat A S.incidence x ∧ ∀ e : S.Incidence,
    ¬ S.flat A (fun p l => S.incidence p l ∧ (p,l) ≠ e.val) x



abbrev Vertex := S.PointOrbit ⊕ S.LineOrbit

noncomputable def pointSupport (J : Finset S.IncidenceOrbit) : Finset S.PointOrbit :=
  by classical exact J.image S.edgePoint

noncomputable def lineSupport (J : Finset S.IncidenceOrbit) : Finset S.LineOrbit :=
  by classical exact J.image S.edgeLine

def active (J : Finset S.IncidenceOrbit) : S.Vertex → Prop
  | Sum.inl p => p ∈ S.pointSupport J
  | Sum.inr l => l ∈ S.lineSupport J

abbrev SupportedVertex (J : Finset S.IncidenceOrbit) := {v : S.Vertex // S.active J v}

/-- The actual supported quotient incidence graph, including every selected edge label. -/
def supportedGraph (J : Finset S.IncidenceOrbit) : SimpleGraph (S.SupportedVertex J) where
  Adj u v := ∃ e ∈ J,
    (u.val = Sum.inr (S.edgeLine e) ∧ v.val = Sum.inl (S.edgePoint e)) ∨
    (v.val = Sum.inr (S.edgeLine e) ∧ u.val = Sum.inl (S.edgePoint e))
  symm := ⟨by intro u v; rintro ⟨e, he, h⟩; exact ⟨e, he, h.symm⟩⟩
  loopless := ⟨by
    intro u
    rintro ⟨e, _, h⟩
    rcases h with h | h
    · have hn := h.1.symm.trans h.2
      cases hn
    · have hn := h.1.symm.trans h.2
      cases hn⟩

abbrev Component (J : Finset S.IncidenceOrbit) :=
  Quotient (S.supportedGraph J).reachableSetoid

noncomputable instance (J : Finset S.IncidenceOrbit) : Fintype (S.Component J) :=
  Fintype.ofFinite _

/-- Unbounded oriented gain walks: forward multiplication by gain, reverse by its inverse. -/
def gainStep (J : Finset S.IncidenceOrbit) (u v : S.Vertex × G) : Prop :=
  ∃ e ∈ J,
    (u.1 = Sum.inr (S.edgeLine e) ∧ v.1 = Sum.inl (S.edgePoint e) ∧
      v.2 = u.2 * C.gain e) ∨
    (u.1 = Sum.inl (S.edgePoint e) ∧ v.1 = Sum.inr (S.edgeLine e) ∧
      v.2 = u.2 * (C.gain e)⁻¹)

def closedGains (J : Finset S.IncidenceOrbit) (v : S.SupportedVertex J) : Subgroup G :=
  Subgroup.closure {g | Relation.ReflTransGen (S.gainStep C J) (v.val,1) (v.val,g)}

/-- Each supported connected component is counted once; its root is an actual member. -/
noncomputable def componentWeight (J : Finset S.IncidenceOrbit) (c : S.Component J) : ℤ :=
  Module.finrank ℝ (A.invariantParameters (S.closedGains C J c.out))

noncomputable def globalCount : Prop :=
  (Nat.card S.Incidence : ℚ) / Fintype.card G =
    (Fintype.card P : ℚ) / Fintype.card G +
      d * ((Fintype.card L : ℚ) / Fintype.card G) -
      Module.finrank ℝ (A.invariantParameters ⊤)

noncomputable def subsetCounts : Prop := by
  classical
  exact ∀ J : Finset S.IncidenceOrbit,
    (J.card : ℤ) ≤ (S.pointSupport J).card + d * (S.lineSupport J).card -
      ∑ c : S.Component J, S.componentWeight A C J c

end IncidenceGeometry

/-- The accepted cover embedded in the full finite connected source class. -/
noncomputable def witnessGeometry : IncidenceGeometry 3 (Multiplicative (Fin 2)) Point Line where
  dimension := by norm_num
  incidence := incidence
  labels := labelRepresentation
  preserves := witnessData.1.2.1
  faithful := witnessData.1.1
  freePoints := by
    intro g p hp
    have hi : incidenceBridge := witnessData.2.2.2.2.2.1
    change pointAction g.toAdd p = p at hp
    change g.toAdd = 0
    exact (hi.1 g.toAdd p).mp hp
  freeLines := by
    intro g l hl
    have hi : incidenceBridge := witnessData.2.2.2.2.2.1
    change lineAction g.toAdd l = l at hl
    change g.toAdd = 0
    exact (hi.2.1 g.toAdd l).mp hl
  nonemptyVertices := ⟨Sum.inl (0,0)⟩
  connected := by
    intro u v
    have hi : incidenceBridge := witnessData.2.2.2.2.2.1
    rcases hi with ⟨_, _, _, _, _, _, _, _, _, _, hc⟩
    induction hc u v with
    | refl => exact .refl
    | @tail a b h hab ih =>
      apply ih.tail
      cases a <;> cases b <;> simpa [coverAdjacent] using hab
  degree := by
    intro l
    have hi : incidenceBridge := witnessData.2.2.2.2.2.1
    rcases hi with ⟨_, _, _, _, _, hd, _⟩
    classical
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype, hd l]
    norm_num

/-- The accepted half-turn and trivial unit character in the full source signature. -/
noncomputable def witnessSymmetry : Symmetry 3 (Multiplicative (Fin 2)) where
  tau := tau
  chi := chi
  sign := by intro g; left; simp [chi]

/-- Transport of the accepted point-orbit equivalence to the general action quotient. -/
noncomputable def witnessPointOrbitEquiv : witnessGeometry.PointOrbit ≃ Fin 3 :=
  (Quotient.congrRight (fun p q => by
    change (∃ g : Multiplicative (Fin 2), pointAction g.toAdd q = p) ↔
      pointOrbitSetoid.r p q
    constructor
    · rintro ⟨g, hg⟩
      exact pointOrbitSetoid.symm ⟨g.toAdd, hg⟩
    · intro h
      obtain ⟨g, hg⟩ := pointOrbitSetoid.symm h
      exact ⟨Multiplicative.ofAdd g, hg⟩)).trans pointOrbitEquiv

/-- Transport of the accepted hyperplane-orbit equivalence, preserving parallel labels. -/
noncomputable def witnessLineOrbitEquiv : witnessGeometry.LineOrbit ≃ Fin 2 :=
  (Quotient.congrRight (fun l k => by
    change (∃ g : Multiplicative (Fin 2), lineAction g.toAdd k = l) ↔
      lineOrbitSetoid.r l k
    constructor
    · rintro ⟨g, hg⟩
      exact lineOrbitSetoid.symm ⟨g.toAdd, hg⟩
    · intro h
      obtain ⟨g, hg⟩ := lineOrbitSetoid.symm h
      exact ⟨Multiplicative.ofAdd g, hg⟩)).trans lineOrbitEquiv

/-- Incidence orbits retain the eight original gain-edge labels. -/
noncomputable def witnessIncidenceOrbitEquiv : witnessGeometry.IncidenceOrbit ≃ E :=
  (Quotient.congrRight (fun a b => by
    change (∃ g : Multiplicative (Fin 2),
      witnessGeometry.incidencePermutation g b = a) ↔ incidenceOrbitSetoid.r a b
    constructor
    · rintro ⟨g, hg⟩
      apply incidenceOrbitSetoid.symm
      exact ⟨g.toAdd, congrArg Subtype.val hg⟩
    · intro h
      obtain ⟨g, hg⟩ := incidenceOrbitSetoid.symm h
      exact ⟨Multiplicative.ofAdd g, Subtype.ext hg⟩)).trans
    (incidenceOrbitEquiv witnessData.2.2.2.2.2.1)

/-- Coordinates of the actual quotient vertices in the accepted five-vertex graph. -/
noncomputable def witnessVertexEquiv : witnessGeometry.Vertex ≃ V :=
  (Equiv.sumCongr witnessPointOrbitEquiv witnessLineOrbitEquiv).trans finSumFinEquiv

/-- Literal orbit representatives at copy zero, with the original incidence gains. -/
noncomputable def witnessChart : witnessGeometry.GainChart where
  pointRepresentative p := (witnessPointOrbitEquiv p, 0)
  lineRepresentative l := (witnessLineOrbitEquiv l, 0)
  pointSection p := by
    exact witnessPointOrbitEquiv.injective (by
      change witnessPointOrbitEquiv (witnessPointOrbitEquiv.symm (witnessPointOrbitEquiv p)) = _
      exact witnessPointOrbitEquiv.apply_symm_apply _)
  lineSection l := by
    exact witnessLineOrbitEquiv.injective (by
      change witnessLineOrbitEquiv (witnessLineOrbitEquiv.symm (witnessLineOrbitEquiv l)) = _
      exact witnessLineOrbitEquiv.apply_symm_apply _)
  gain e := Multiplicative.ofAdd (gain (witnessIncidenceOrbitEquiv e))
  realizes := by
    intro e
    obtain ⟨k, rfl⟩ := witnessIncidenceOrbitEquiv.symm.surjective e
    let hi : incidenceBridge := witnessData.2.2.2.2.2.1
    change ∃ h : incidence
        (pointAction (gain (witnessIncidenceOrbitEquiv (witnessIncidenceOrbitEquiv.symm k)))
          (witnessPointOrbitEquiv (witnessGeometry.edgePoint
            (witnessIncidenceOrbitEquiv.symm k)), 0))
        (witnessLineOrbitEquiv (witnessGeometry.edgeLine
            (witnessIncidenceOrbitEquiv.symm k)), 0), _
    rw [witnessIncidenceOrbitEquiv.apply_symm_apply]
    have hp : witnessPointOrbitEquiv (witnessGeometry.edgePoint
        (witnessIncidenceOrbitEquiv.symm k)) = orbitPoint k := rfl
    have hl : witnessLineOrbitEquiv (witnessGeometry.edgeLine
        (witnessIncidenceOrbitEquiv.symm k)) = orbitLine k := rfl
    rw [hp, hl]
    refine ⟨(hi.2.2.2.2.1 _ _).mpr ⟨k,0, by simp [liftedIncidence, pointAction]⟩, ?_⟩
    rfl

/-- Embedding of actual accepted scenes in the full source scene class.
It uses the same picture, heights, normals and constants on every original label. -/
noncomputable def embedScene (z : Fin 6 → ℝ) (y : Point → ℝ)
    (n : Line → ℝ × ℝ) (h : Line → ℝ) (hs : sourceScene z y n h) :
    witnessGeometry.LiftedScene witnessSymmetry witnessGeometry.incidence
      (fun p => planeVector (picture z p)) where
  height := y
  normal := fun l => planeVector (n l)
  constant := h
  equations := by
    rcases hs with ⟨hi, hy, hn, hh, _⟩
    refine ⟨?_, hy, hn, hh⟩
    intro p l hp
    simpa [hyperplane, planeVector, PiLp.inner_apply, Fin.sum_univ_two, mul_comm]
      using hi p l hp

/-- Full lifting sufficiency with the original general class and literal minimality.
Gain charts are choices of representatives of actual orbits, not extra geometric hypotheses. -/
def liftingSufficiency : Prop :=
  ∀ (d : ℕ) (G P L : Type) [Group G] [Fintype G] [Fintype P] [Fintype L]
    (S : IncidenceGeometry d G P L) (A : Symmetry d G) (C : S.GainChart),
    S.globalCount A → S.subsetCounts A C →
      ∀ x : P → Space d, S.genericPicture A C x → S.minimallyFlat A x



end OriginalSource

#print axioms OriginalSource.witnessGeometry
#print axioms OriginalSource.witnessSymmetry
#print axioms OriginalSource.witnessPointOrbitEquiv
#print axioms OriginalSource.witnessLineOrbitEquiv
#print axioms OriginalSource.embedScene
#print axioms OriginalSource.liftingSufficiency

open OriginalSource

set_option maxRecDepth 100000 in
set_option maxHeartbeats 1000000 in
/-- The lifting clause of Conjecture 6.1 fails on the connected free C₂ incidence geometry.
Every literal source count holds, while the same algebraically independent picture has a
nontrivial scene. The conclusion uses the general source class and its flatness subclause. -/
theorem result : ¬ OriginalSource.liftingSufficiency := by
  classical
  let S := witnessGeometry
  let A := witnessSymmetry
  let C := witnessChart
  have hi : incidenceBridge := witnessData.2.2.2.2.2.1
  have hc : componentBridge := witnessData.2.2.2.2.1
  have hb : balanceSound := witnessData.2.2.2.2.2.2.1
  have hr : ∀ m r, closedGainSubgroup m r = ⊥ → balancedAt m r = true :=
    witnessData.2.2.2.2.2.2.2.1
  have hinv : invariantBridge := witnessData.2.1
  let T : (Plane × ℝ) ≃ₗ[ℝ] Parameters :=
    ((WithLp.linearEquiv 2 ℝ (Fin 2 → ℝ)).trans
      (LinearEquiv.finTwoArrow ℝ ℝ)).prodCongr (LinearEquiv.refl ℝ ℝ)
  have hT (g : Fin 2) (p : Plane × ℝ) :
      T (A.parameterMap (Multiplicative.ofAdd g) p) = parameterAction g (T p) := by
    fin_cases g <;> ext <;>
      simp [T, A, witnessSymmetry, OriginalSource.Symmetry.parameterMap,
        parameterAction, chi, tau]
  have hH (K : Subgroup (Multiplicative (Fin 2))) :
      Module.finrank ℝ (A.invariantParameters K) =
        Module.finrank ℝ (H K.toAddSubgroup') := by
    have hm (p : Plane × ℝ) : p ∈ A.invariantParameters K ↔ T p ∈ H K.toAddSubgroup' := by
      simp only [OriginalSource.Symmetry.invariantParameters, H,
        Submodule.mem_iInf, LinearMap.mem_fixedSubmodule_iff]
      constructor
      · intro hp g
        have hh := congrArg T (hp ⟨Multiplicative.ofAdd g.val, g.property⟩)
        simpa only [hT] using hh
      · intro hp g
        apply T.injective
        have hh := hp ⟨g.val.toAdd,g.property⟩
        change T (A.parameterMap (Multiplicative.ofAdd g.val.toAdd) p) = T p
        rw [hT]
        exact hh
    let e : A.invariantParameters K ≃ₗ[ℝ] H K.toAddSubgroup' :=
      { toFun := fun p => ⟨T p.val, (hm p.val).mp p.property⟩
        invFun := fun p => ⟨T.symm p.val, (hm _).mpr (by simpa using p.property)⟩
        left_inv := by intro p; apply Subtype.ext; exact T.symm_apply_apply p.val
        right_inv := by intro p; apply Subtype.ext; exact T.apply_symm_apply p.val
        map_add' := by intro p q; apply Subtype.ext; exact T.map_add p.val q.val
        map_smul' := by intro r p; apply Subtype.ext; exact T.map_smul r p.val }
    exact e.finrank_eq
  have hglobal : S.globalCount A := by
    have hcard : Nat.card S.Incidence = 16 := by
      rw [Nat.card_eq_fintype_card]
      calc
        Fintype.card S.Incidence = Fintype.card (E × Fin 2) :=
          Fintype.card_congr (incidenceLiftEquiv hi).symm
        _ = 16 := by decide
    have htop : Module.finrank ℝ (A.invariantParameters ⊤) = 1 := by
      rw [hH]
      exact hinv.2.2.2.2.2.2 ⊤ top_ne_bot
    change (Nat.card S.Incidence : ℚ) / Fintype.card (Multiplicative (Fin 2)) = _
    rw [hcard,htop]
    norm_num [Point,Line,Fintype.card_prod]
  have hep (e : S.IncidenceOrbit) :
      witnessPointOrbitEquiv (S.edgePoint e) = orbitPoint (witnessIncidenceOrbitEquiv e) := by
    obtain ⟨k, rfl⟩ := witnessIncidenceOrbitEquiv.symm.surjective e
    rw [witnessIncidenceOrbitEquiv.apply_symm_apply]
    rfl
  have hel (e : S.IncidenceOrbit) :
      witnessLineOrbitEquiv (S.edgeLine e) = orbitLine (witnessIncidenceOrbitEquiv e) := by
    obtain ⟨k, rfl⟩ := witnessIncidenceOrbitEquiv.symm.surjective e
    rw [witnessIncidenceOrbitEquiv.apply_symm_apply]
    rfl
  have hvep (p : S.PointOrbit) :
      witnessVertexEquiv (Sum.inl p) = pointVertex (witnessPointOrbitEquiv p) := rfl
  have hvel (l : S.LineOrbit) :
      witnessVertexEquiv (Sum.inr l) = lineVertex (witnessLineOrbitEquiv l) := rfl
  have heends (e : E) : ends e = (lineVertex (orbitLine e), pointVertex (orbitPoint e)) := by
    fin_cases e <;> rfl
  have hsubsets : S.subsetCounts A C := by
    intro J
    let edges := J.image witnessIncidenceOrbitEquiv
    let m := maskEquiv.symm edges
    have hm : decoded m = edges := maskEquiv.apply_symm_apply edges
    have hsel (e : E) : selected m e = true ↔ e ∈ edges := by
      rw [← hm]; simp only [decoded, Finset.mem_filter, Finset.mem_univ, true_and]
    have hp : (S.pointSupport J).image witnessPointOrbitEquiv = pointLabels edges := by
      simp only [OriginalSource.IncidenceGeometry.pointSupport, pointLabels,
        edges, Finset.image_image]
      congr 1
      funext e
      exact hep e
    have hl : (S.lineSupport J).image witnessLineOrbitEquiv = lineLabels edges := by
      simp only [OriginalSource.IncidenceGeometry.lineSupport, lineLabels,
        edges, Finset.image_image]
      congr 1
      funext e
      exact hel e
    have ha (v : S.Vertex) : S.active J v ↔ active m (witnessVertexEquiv v) = true := by
      cases v with
      | inl p =>
        rw [hvep]
        change p ∈ S.pointSupport J ↔ _
        have hmp : p ∈ S.pointSupport J ↔ witnessPointOrbitEquiv p ∈ pointLabels edges := by
          rw [← hp]; simp
        rw [hmp]
        simp only [pointLabels, Finset.mem_image, active, decide_eq_true_eq, hsel, heends]
        constructor
        · rintro ⟨e, he, heq⟩
          exact ⟨e, he, Or.inr (congrArg pointVertex heq)⟩
        · rintro ⟨e, he, hh | hh⟩
          · have heq := congrArg (fun v : V => v.val) hh
            simp only [lineVertex, pointVertex] at heq
            omega
          · exact ⟨e, he, by apply Fin.ext; exact congrArg (fun v : V => v.val) hh⟩
      | inr l =>
        rw [hvel]
        change l ∈ S.lineSupport J ↔ _
        have hml : l ∈ S.lineSupport J ↔ witnessLineOrbitEquiv l ∈ lineLabels edges := by
          rw [← hl]; simp
        rw [hml]
        simp only [lineLabels, Finset.mem_image, active, decide_eq_true_eq, hsel, heends]
        constructor
        · rintro ⟨e, he, heq⟩
          exact ⟨e, he, Or.inl (congrArg lineVertex heq)⟩
        · rintro ⟨e, he, hh | hh⟩
          · refine ⟨e, he, ?_⟩
            apply Fin.ext
            have heq := congrArg (fun v : V => v.val) hh
            simp only [lineVertex] at heq
            omega
          · have heq := congrArg (fun v : V => v.val) hh
            simp only [lineVertex, pointVertex] at heq
            omega
    let q : S.SupportedVertex J ≃ ActiveVertex m := witnessVertexEquiv.subtypeEquiv ha
    have hadj (u v : S.SupportedVertex J) :
        (S.supportedGraph J).Adj u v ↔ adjacent m (q u).val (q v).val = true := by
      change (∃ e ∈ J, _ ∨ _) ↔ _
      simp only [adjacent, decide_eq_true_eq, heends, hsel, edges, Finset.mem_image]
      constructor
      · rintro ⟨e, he, ⟨hu,hv⟩ | ⟨hu,hv⟩⟩
        · refine ⟨witnessIncidenceOrbitEquiv e, ⟨e,he,rfl⟩, Or.inl ⟨?_,?_⟩⟩
          · exact (congrArg witnessVertexEquiv hu).trans (by rw [hvel,hel]) |>.symm
          · exact (congrArg witnessVertexEquiv hv).trans (by rw [hvep,hep]) |>.symm
        · refine ⟨witnessIncidenceOrbitEquiv e, ⟨e,he,rfl⟩, Or.inr ⟨?_,?_⟩⟩
          · exact (congrArg witnessVertexEquiv hu).trans (by rw [hvel,hel]) |>.symm
          · exact (congrArg witnessVertexEquiv hv).trans (by rw [hvep,hep]) |>.symm
      · rintro ⟨_, ⟨e,he,rfl⟩, ⟨hu,hv⟩ | ⟨hu,hv⟩⟩
        · refine ⟨e, he, Or.inl ⟨?_,?_⟩⟩
          · apply witnessVertexEquiv.injective; simpa only [q, Equiv.subtypeEquiv, Equiv.coe_fn_mk, hvel,hel] using hu.symm
          · apply witnessVertexEquiv.injective; simpa only [q, Equiv.subtypeEquiv, Equiv.coe_fn_mk, hvep,hep] using hv.symm
        · refine ⟨e, he, Or.inr ⟨?_,?_⟩⟩
          · apply witnessVertexEquiv.injective; simpa only [q, Equiv.subtypeEquiv, Equiv.coe_fn_mk, hvel,hel] using hu.symm
          · apply witnessVertexEquiv.injective; simpa only [q, Equiv.subtypeEquiv, Equiv.coe_fn_mk, hvep,hep] using hv.symm
    have hadj_active (u v : V) (h : adjacent m u v = true) : active m v = true := by
      obtain ⟨e, he, ⟨hu,hv⟩ | ⟨hu,hv⟩⟩ := of_decide_eq_true h
      · exact decide_eq_true ⟨e, he, Or.inr hv⟩
      · exact decide_eq_true ⟨e, he, Or.inl hu⟩
    have hreach (u v : S.SupportedVertex J) :
        (S.supportedGraph J).Reachable u v ↔ sourceReach m (q u).val (q v).val := by
      constructor
      · intro h
        rw [SimpleGraph.reachable_iff_reflTransGen] at h
        exact Relation.ReflTransGen.lift (fun a => (q a).val)
          (fun a b hab => (hadj a b).mp hab) u v h
      · intro h
        have lift (a : ActiveVertex m) (b : V) (h : sourceReach m a.val b) :
            ∃ hb : active m b = true,
              (S.supportedGraph J).Reachable (q.symm a) (q.symm ⟨b,hb⟩) := by
          induction h with
          | refl => exact ⟨a.property, .refl _⟩
          | @tail b c hbc ha ih =>
            obtain ⟨hb, hh⟩ := ih
            have hc' := hadj_active b c ha
            refine ⟨hc', hh.trans ?_⟩
            apply SimpleGraph.Adj.reachable
            apply (hadj _ _).mpr
            simpa only [q.apply_symm_apply] using ha
        obtain ⟨_,hh⟩ := lift (q u) (q v).val h
        simpa only [q.symm_apply_apply] using hh
    let cq : S.Component J ≃ SupportedComponent m := Quotient.congr q hreach
    let F : (S.Vertex × Multiplicative (Fin 2)) ≃ (V × Fin 2) :=
      { toFun := fun u => (witnessVertexEquiv u.1,u.2.toAdd)
        invFun := fun u => (witnessVertexEquiv.symm u.1,Multiplicative.ofAdd u.2)
        left_inv := by intro u; simp
        right_inv := by intro u; simp }
    have hstep (u v : S.Vertex × Multiplicative (Fin 2)) :
        S.gainStep C J u v ↔ gainStep m (F u) (F v) := by
      rw [← witnessData.2.2.2.2.2.2.2.2.2.1.2.1 m]
      rw [hm]
      simp only [OriginalSource.IncidenceGeometry.gainStep, labelledSourceStep,
        edges, Finset.mem_image]
      constructor
      · rintro ⟨e,he,⟨hu,hv,hg⟩ | ⟨hu,hv,hg⟩⟩
        · refine ⟨witnessIncidenceOrbitEquiv e,⟨e,he,rfl⟩,Or.inl ⟨?_,?_,?_⟩⟩
          · exact (congrArg witnessVertexEquiv hu).trans (by rw [hvel,hel])
          · exact (congrArg witnessVertexEquiv hv).trans (by rw [hvep,hep])
          · simpa [F,C,witnessChart,sub_eq_add_neg] using congrArg Multiplicative.toAdd hg
        · refine ⟨witnessIncidenceOrbitEquiv e,⟨e,he,rfl⟩,Or.inr ⟨?_,?_,?_⟩⟩
          · exact (congrArg witnessVertexEquiv hu).trans (by rw [hvep,hep])
          · exact (congrArg witnessVertexEquiv hv).trans (by rw [hvel,hel])
          · simpa [F,C,witnessChart,sub_eq_add_neg] using congrArg Multiplicative.toAdd hg
      · rintro ⟨_,⟨e,he,rfl⟩,⟨hu,hv,hg⟩ | ⟨hu,hv,hg⟩⟩
        · refine ⟨e,he,Or.inl ⟨?_,?_,?_⟩⟩
          · apply witnessVertexEquiv.injective; simpa only [F, Equiv.coe_fn_mk, hvel,hel] using hu
          · apply witnessVertexEquiv.injective; simpa only [F, Equiv.coe_fn_mk, hvep,hep] using hv
          · simpa [F,C,witnessChart,sub_eq_add_neg] using congrArg Multiplicative.ofAdd hg
        · refine ⟨e,he,Or.inr ⟨?_,?_,?_⟩⟩
          · apply witnessVertexEquiv.injective; simpa only [F, Equiv.coe_fn_mk, hvep,hep] using hu
          · apply witnessVertexEquiv.injective; simpa only [F, Equiv.coe_fn_mk, hvel,hel] using hv
          · simpa [F,C,witnessChart,sub_eq_add_neg] using congrArg Multiplicative.ofAdd hg
    have hw (u v : S.Vertex × Multiplicative (Fin 2)) :
        Relation.ReflTransGen (S.gainStep C J) u v ↔
          Relation.ReflTransGen (gainStep m) (F u) (F v) := by
      constructor
      · exact Relation.ReflTransGen.lift F (fun a b h => (hstep a b).mp h) u v
      · intro h
        have hh := Relation.ReflTransGen.lift F.symm
          (fun a b h => (hstep (F.symm a) (F.symm b)).mpr (by simpa using h))
          (F u) (F v) h
        change Relation.ReflTransGen (S.gainStep C J) (F.symm (F u)) (F.symm (F v)) at hh
        simpa only [F.symm_apply_apply] using hh
    have hclosed (v : S.SupportedVertex J) :
        (S.closedGains C J v).toAddSubgroup' = closedGainSubgroup m (q v).val := by
      rw [OriginalSource.IncidenceGeometry.closedGains, Subgroup.toAddSubgroup'_closure]
      congr 1
      ext g
      exact hw (v.val,1) (v.val,Multiplicative.ofAdd g)
    have hbal (u v : V) (huv : sourceReach m u v) : balancedAt m u = balancedAt m v := by
      change Relation.ReflTransGen (fun a b => adjacent m a b = true) u v at huv
      have hsym : ∀ a b, adjacent m a b = true → adjacent m b a = true := by
        intro a b h
        obtain ⟨e,he,hh⟩ := of_decide_eq_true h
        exact decide_eq_true ⟨e,he,hh.elim Or.inr Or.inl⟩
      letI : Std.Symm (fun a b => adjacent m a b = true) := ⟨hsym⟩
      have hs (w : V) : reach m 5 u w = true ↔ reach m 5 v w = true := by
        rw [hc.1 m u w, hc.1 m v w]
        exact ⟨fun h => (symm huv).trans h, fun h => huv.trans h⟩
      apply Bool.eq_iff_iff.mpr
      simp only [balancedAt, decide_eq_true_eq, hs]
    have hdimH (v : V) : Module.finrank ℝ (H (closedGainSubgroup m v)) = hdim m v := by
      unfold hdim
      split_ifs with h
      · rw [hb m v h, hinv.2.2.2.2.2.1]
      · exact hinv.2.2.2.2.2.2 _ (fun hh => h (hr m v hh))
    let roots := (supportedComponentEquiv hc m)
    have hweight (c : S.Component J) : S.componentWeight A C J c =
        (hdim m (roots (cq c)).val : ℤ) := by
      change (Module.finrank ℝ (A.invariantParameters (S.closedGains C J c.out)) : ℤ) = _
      rw [hH,hclosed,hdimH]
      have heq : Quotient.mk (supportedSetoid m) (q c.out) = cq c := by
        change cq (Quotient.mk _ c.out) = cq c
        rw [Quotient.out_eq]
      have hh : sourceReach m (roots (cq c)).val (q c.out).val := by
        have hroot := (Classical.choose_spec (hc.2.2 m (q c.out).val (q c.out).property)).1.2
        change sourceReach m (roots (Quotient.mk _ (q c.out))).val (q c.out).val at hroot
        simpa only [heq] using hroot
      simp only [hdim, hbal _ _ hh]
    have hsum : (∑ c : S.Component J, S.componentWeight A C J c) =
        ∑ r ∈ rootSet m, (hdim m r : ℤ) := by
      calc
        _ = ∑ r : ↥(rootSet m), (hdim m r.val : ℤ) :=
          Fintype.sum_equiv (cq.trans roots) _ _ hweight
        _ = _ := Finset.sum_coe_sort (rootSet m) (fun r : V => (hdim m r : ℤ))
    have hpCard : (S.pointSupport J).card = (pSupport m).card := by
      rw [← Finset.card_image_of_injective _ witnessPointOrbitEquiv.injective,hp,← hm]
      have h : (pointLabels (decoded m)).image pointVertex = pSupport m := by
        ext v
        simp only [pSupport, pointLabels, decoded, Finset.mem_filter, Finset.mem_univ,
          true_and, Finset.mem_image, active, decide_eq_true_eq, heends]
        constructor
        · rintro ⟨_,⟨e,he,rfl⟩,rfl⟩
          exact ⟨(orbitPoint e).isLt, e,he,Or.inr rfl⟩
        · rintro ⟨hv,e,he,hh | hh⟩
          · have hv' := congrArg (fun v : V => v.val) hh
            simp only [lineVertex] at hv'; omega
          · exact ⟨orbitPoint e,⟨e,he,rfl⟩,hh⟩
      rw [← h,Finset.card_image_of_injective _ (by
        intro a b h; apply Fin.ext; exact congrArg (fun v : V => v.val) h)]
    have hlCard : (S.lineSupport J).card = (lSupport m).card := by
      rw [← Finset.card_image_of_injective _ witnessLineOrbitEquiv.injective,hl,← hm]
      have h : (lineLabels (decoded m)).image lineVertex = lSupport m := by
        ext v
        simp only [lSupport, lineLabels, decoded, Finset.mem_filter, Finset.mem_univ,
          true_and, Finset.mem_image, active, decide_eq_true_eq, heends]
        constructor
        · rintro ⟨_,⟨e,he,rfl⟩,rfl⟩
          exact ⟨by simp [lineVertex], e,he,Or.inl rfl⟩
        · rintro ⟨hv,e,he,hh | hh⟩
          · exact ⟨orbitLine e,⟨e,he,rfl⟩,hh⟩
          · have hv' := congrArg (fun v : V => v.val) hh
            simp only [pointVertex] at hv'; omega
      rw [← h,Finset.card_image_of_injective _ (by
        intro a b h; apply Fin.ext; have hh := congrArg (fun v : V => v.val) h
        simp only [lineVertex] at hh; omega)]
    have hcard : J.card = (decoded m).card := by
      rw [hm]; exact (Finset.card_image_of_injective J witnessIncidenceOrbitEquiv.injective).symm
    change (J.card : ℤ) ≤ (S.pointSupport J).card + 3 * (S.lineSupport J).card - _
    rw [hpCard,hlCard,hsum,hcard]
    exact witnessData.2.2.2.2.2.2.2.2.1 m
  obtain ⟨z,hz,_,hgen,_,y,n,h,_,hs,_,hnt⟩ := witnessData.2.2.2.2.2.2.2.2.2.2
  have hg : S.genericPicture A C (fun p => planeVector (picture z p)) := by
    refine ⟨hgen.1, ?_⟩
    let e := Equiv.prodCongr witnessPointOrbitEquiv (Equiv.refl (Fin 2))
    have he : (fun ik : S.PointOrbit × Fin 2 =>
        planeVector (picture z (C.pointRepresentative ik.1)) ik.2) =
        representativeCoordinates z ∘ e := by
      funext ik
      rcases ik with ⟨i,k⟩
      fin_cases k <;> rfl
    rw [he]
    exact hgen.2.comp e e.injective
  intro suff
  have hf := (suff 3 (Multiplicative (Fin 2)) Point Line S A C hglobal hsubsets
    (fun p => planeVector (picture z p)) hg).1
  have ht := hf y (fun l => planeVector (n l)) h (embedScene z y n h hs).equations
  apply hnt
  refine ⟨?_, ht.2⟩
  intro l k
  have hh := ht.1 l k
  have h0 := congrArg (fun v : Plane => v 0) hh
  have h1 := congrArg (fun v : Plane => v 1) hh
  exact Prod.ext h0 h1

