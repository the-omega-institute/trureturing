/- GID: D5/S3/Geometry/InvolutionOrbitDimension
   generality: G
   mirror-B: D5/B/S3/Geometry/InvolutionOrbitDimension
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: [mathlib/module/Mathlib.Topology.MetricSpace.HausdorffDimension]
   utility: none
   digest: Isometric involution quotients preserve Hausdorff dimension of every subset. -/

import D5.S3.Geometry.IsometricOrbitMetric
import Mathlib.Topology.MetricSpace.HausdorffDimension
import Mathlib.Algebra.Ring.BooleanRing

/-! Hausdorff geometry of a finite isometric identification. -/

set_option autoImplicit false
noncomputable section

open Set Metric Topology TopologicalSpace MeasureTheory

namespace D5.S3.Geometry.InvolutionOrbitDimension
open D5.S3.Geometry.MostowPrasadDescent
open D5.S3.Geometry.MostowPrasadCovering
open D5.S3.Geometry.IsometricOrbitMetric

variable {X : Type*} [MetricSpace X]

/-- The two-element isometric action generated by an involution. -/
def representation (c : X ≃ᵢ X) (hc : Function.Involutive c) :
    Multiplicative Bool →* (X ≃ᵢ X) where
  toFun b := if b.toAdd then c else 1
  map_one' := rfl
  map_mul' b d := by
    change Bool at b d
    cases b <;> cases d
    · rfl
    · rfl
    · rfl
    · ext x; exact (hc x).symm

private theorem proper (c : X ≃ᵢ X) (hc : Function.Involutive c) :
    ProperlyDiscontinuousRepresentation (representation c hc) := by
  intro K L _ _
  exact Set.toFinite _

/-- The orbit space, carrying the finite-action orbit metric. -/
abbrev Orbit (c : X ≃ᵢ X) (hc : Function.Involutive c) :=
  OrbitQuotient (representation c hc)

noncomputable instance orbitMetric (c : X ≃ᵢ X) (hc : Function.Involutive c) :
    MetricSpace (Orbit c hc) := orbitMetricSpace (representation c hc) (proper c hc)

/-- The canonical orbit projection. -/
def project (c : X ≃ᵢ X) (hc : Function.Involutive c) : X → Orbit c hc :=
  orbitQuotientMk (representation c hc)

private theorem orbit_range (c : X ≃ᵢ X) (hc : Function.Involutive c) (y : X) :
    range (fun g => representation c hc g y) = {y, c y} := by
  ext z
  constructor
  · rintro ⟨g, rfl⟩
    change Bool at g
    cases g
    · exact Or.inl rfl
    · exact Or.inr rfl
  · rintro (rfl | rfl)
    · exact ⟨Multiplicative.ofAdd false, rfl⟩
    · exact ⟨Multiplicative.ofAdd true, rfl⟩

private theorem project_dist (c : X ≃ᵢ X) (hc : Function.Involutive c) (x y : X) :
    dist (project c hc x) (project c hc y) = min (dist x y) (dist x (c y)) := by
  change infDist x (range (fun g => representation c hc g y)) = _
  rw [orbit_range]
  apply le_antisymm
  · exact le_min (infDist_le_dist_of_mem (by simp))
      (infDist_le_dist_of_mem (by simp))
  · apply (le_infDist (by simp : ({y, c y} : Set X).Nonempty)).mpr
    intro z hz
    rcases hz with rfl | hz
    · exact min_le_left _ _
    · have hz' : z = c y := Set.mem_singleton_iff.mp hz
      rw [hz']
      exact min_le_right _ _

private theorem project_lipschitz (c : X ≃ᵢ X) (hc : Function.Involutive c) :
    LipschitzWith 1 (project c hc) := by
  apply LipschitzWith.of_dist_le_mul
  intro x y
  rw [project_dist, NNReal.coe_one, one_mul]
  exact min_le_left _ _

/-- A ball smaller than a quarter of the displacement of its center is a metric sheet. -/
private theorem project_isometry_ball (c : X ≃ᵢ X) (hc : Function.Involutive c)
    (x : X) {r : ℝ} (hr : 4 * r ≤ dist x (c x)) :
    Isometry (fun y : ball x r => project c hc y) := by
  apply Isometry.of_dist_eq
  intro y z
  rw [project_dist, Subtype.dist_eq]
  apply min_eq_left
  have hy : dist y.1 x < r := y.2
  have hz : dist z.1 x < r := z.2
  have hsmall := dist_triangle_right y.1 z.1 x
  have hbig := dist_triangle x y.1 (c x)
  have hbig' := dist_triangle y.1 (c z.1) (c x)
  have hcz : dist (c z.1) (c x) = dist z.1 x := c.dist_eq _ _
  have hxy : dist x y.1 = dist y.1 x := dist_comm _ _
  linarith

private theorem dimH_project_local (c : X ≃ᵢ X) (hc : Function.Involutive c)
    (x : X) {r : ℝ} (hr : 4 * r ≤ dist x (c x)) (s : Set X) :
    dimH (s ∩ ball x r) ≤ dimH (project c hc '' s) := by
  let t : Set (ball x r) := Subtype.val ⁻¹' s
  have h1 := (project_isometry_ball c hc x hr).dimH_image t
  have h2 := isometry_subtype_coe.dimH_image t
  have hset : Subtype.val '' t = s ∩ ball x r := by
    ext y
    simp only [t, mem_image, mem_preimage, mem_inter_iff, Subtype.exists, exists_and_right,
      exists_eq_right]
    tauto
  rw [hset] at h2
  rw [h2, ← h1]
  apply dimH_mono
  rintro q ⟨y, hy, rfl⟩
  exact ⟨y, hy, rfl⟩

/-- Every subset of a second-countable metric space has the same Hausdorff dimension as
its image in the orbit metric of an isometric involution. Fixed points are included. -/
theorem dimH_project [SecondCountableTopology X]
    (c : X ≃ᵢ X) (hc : Function.Involutive c) (s : Set X) :
    dimH (project c hc '' s) = dimH s := by
  apply le_antisymm ((project_lipschitz c hc).dimH_image_le s)
  let free : Set X := {x ∈ s | c x ≠ x}
  let fixed : Set X := {x ∈ s | c x = x}
  have hdecomp : s = free ∪ fixed := by
    ext x
    simp only [free, fixed, mem_union, mem_ofPred_eq]
    tauto
  conv_lhs => rw [hdecomp, dimH_union]
  apply max_le
  · let r : X → ℝ := fun x => dist x (c x) / 5
    obtain ⟨u, hus, huc, hcover⟩ := countable_cover_nhdsWithin
      (s := free) (f := fun x => ball x (r x)) (by
        intro x hx
        apply mem_nhdsWithin_of_mem_nhds
        apply ball_mem_nhds
        exact div_pos (dist_pos.mpr hx.2.symm) (by norm_num))
    calc
      dimH free ≤ dimH (⋃ x ∈ u, free ∩ ball x (r x)) := by
        apply dimH_mono
        intro y hy
        obtain ⟨x, hxu, hxy⟩ := Set.mem_iUnion₂.mp (hcover hy)
        exact Set.mem_iUnion₂.mpr ⟨x, hxu, hy, hxy⟩
      _ = ⨆ x ∈ u, dimH (free ∩ ball x (r x)) := dimH_bUnion huc _
      _ ≤ dimH (project c hc '' s) := by
        apply iSup₂_le
        intro x hx
        apply (dimH_project_local c hc x (by dsimp [r]; nlinarith [(dist_nonneg (x := x) (y := c x))]) free).trans
        exact dimH_mono (image_mono (by intro y hy; exact hy.1))
  · let t : Set fixed := univ
    have hiso : Isometry (fun x : fixed => project c hc x) := by
      apply Isometry.of_dist_eq
      intro x y
      rw [project_dist, y.2.2, min_self, Subtype.dist_eq]
    have h1 := hiso.dimH_image t
    have h2 := isometry_subtype_coe.dimH_image t
    have hset : Subtype.val '' t = fixed := by simp [t]
    rw [hset] at h2
    rw [h2, ← h1]
    apply dimH_mono
    rintro q ⟨x, _, rfl⟩
    exact ⟨x, x.2.1, rfl⟩

#print axioms project_isometry_ball
#print axioms dimH_project
end D5.S3.Geometry.InvolutionOrbitDimension
