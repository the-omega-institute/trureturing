private theorem moment_nonneg {m : ℕ} (z : Fin m → ℝ) (hz : ∀ r, 0 ≤ z r) (k : ℕ) :
    0 ≤ P _ z k := by
  rw [P_evalSum]
  exact Finset.sum_nonneg (fun r _ => pow_nonneg (hz r) k)

private theorem root_le_first_moment {m : ℕ} (z : Fin m → ℝ) (hz : ∀ r, 0 ≤ z r) (r : Fin m) :
    z r ≤ P _ z 1 := by
  simpa [P_evalSum] using Finset.single_le_sum (fun i _ => hz i) (Finset.mem_univ r)

private theorem deficit_u_nonneg {m : ℕ} (z : Fin m → ℝ) (hz : ∀ r, 0 ≤ z r) :
    0 ≤ (P _ z 1)^2-P _ z 2 := by
  rw [P_evalSum m z 1]
  simp only [pow_one]
  exact sub_nonneg.mpr (coordinateB_le_sum_sq z hz)

private theorem deficit_v_nonneg {m : ℕ} (z : Fin m → ℝ) (hz : ∀ r, 0 ≤ z r) :
    0 ≤ P _ z 1 * P _ z 4-P _ z 5 := by
  have h : P _ z 5 ≤ P _ z 1 * P _ z 4 := calc
    P _ z 5 ≤ ∑ r, P _ z 1 * z r ^ 4 := by
      rw [P_evalSum]
      apply Finset.sum_le_sum; intro r _
      rw [show z r ^ 5 = z r * z r ^ 4 by ring]
      exact mul_le_mul_of_nonneg_right (root_le_first_moment z hz r) (by positivity)
    _ = P _ z 1 * P _ z 4 := by rw [← Finset.mul_sum, P_evalSum m z 4]
  linarith

