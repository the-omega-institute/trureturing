    (hx : 0 < x) (hy : 0 < y) (hz : ∀ r, 0 ≤ z r) :
    0 < Q (m+2 : ℕ) x y (P _ z 1) (P _ z 2)
      (P _ z 4) (P _ z 5) (P _ z 6) := by
  rcases m with _ | m
  · simpa [P_evalSum] using Q_pos_two x y hx hy
  rcases m with _ | m
  · simpa [P_evalSum, Fin.sum_univ_succ] using Q_pos_three x y (z 0) hx hy (hz 0)
  · apply Q_pos_ge_four _ x y _ _ _ _ _
      (by norm_cast; omega) hx hy (moment_nonneg z hz 1) (moment_nonneg z hz 4)
      (deficit_u_nonneg z hz) (deficit_v_nonneg z hz) (deficit_w_nonneg z)

