    P _ z 6-2*P _ z 1*P _ z 5+(P _ z 1)^2*P _ z 4 =
      ∑ r, z r^4*(z r-P _ z 1)^2 := by
  have h r : z r^4*(z r-P _ z 1)^2 =
      z r^6-2*P _ z 1*z r^5+(P _ z 1)^2*z r^4 := by ring
  simp_rw [h, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
  simp only [P_evalSum]

private theorem deficit_w_nonneg {m : ℕ} (z : Fin m → ℝ) :
    0 ≤ P _ z 6-2*P _ z 1*P _ z 5+(P _ z 1)^2*P _ z 4 := by
  rw [deficit_w_identity]; apply Finset.sum_nonneg; intro r _; positivity

