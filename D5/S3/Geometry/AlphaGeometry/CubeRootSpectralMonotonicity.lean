private def Dx (n x y a b c d e : ℝ) : ℝ := ((48 * (x ^ 5)) + (((((-2) + (4 * (n ^ 2))) * ((2 * a) + (2 * x) + (2 * y))) + ((-4) * n * x)) * (c + (x ^ 4) + (y ^ 4))) + ((-8) * n * (d + (x ^ 5) + (y ^ 5))) + (4 * (x ^ 3) * ((((a + x + y) ^ 2) * ((-2) + (4 * (n ^ 2)))) + ((-2) * n * (b + (x ^ 2) + (y ^ 2))))) + ((-40) * n * (x ^ 4) * (a + x + y)))
private def Dy (n x y a b c d e : ℝ) : ℝ := ((48 * (y ^ 5)) + (((((-2) + (4 * (n ^ 2))) * ((2 * a) + (2 * x) + (2 * y))) + ((-4) * n * y)) * (c + (x ^ 4) + (y ^ 4))) + ((-8) * n * (d + (x ^ 5) + (y ^ 5))) + (4 * (y ^ 3) * ((((a + x + y) ^ 2) * ((-2) + (4 * (n ^ 2)))) + ((-2) * n * (b + (x ^ 2) + (y ^ 2))))) + ((-40) * n * (y ^ 4) * (a + x + y)))
private def twoCore (n a b c d e x y : ℝ) : ℝ := N n x y a b c d e/(9*(x^4+y^4+c)^2)
private theorem hasDerivAt_N (n a b c d e : ℝ) (X Y : ℝ → ℝ) (xp yp t : ℝ)
    (hX : HasDerivAt X xp t) (hY : HasDerivAt Y yp t) :
    HasDerivAt (fun q => N n (X q) (Y q) a b c d e)
      (Dx n (X t) (Y t) a b c d e*xp + Dy n (X t) (Y t) a b c d e*yp) t := by
  have h := (((((hasDerivAt_const t ((8 * e))).add ((hasDerivAt_const t (8)).mul (hX.pow 6))).add ((hasDerivAt_const t (8)).mul (hY.pow 6))).add (((((((hasDerivAt_const t (a)).add hX).add hY).pow 2).mul (hasDerivAt_const t (((-2) + (4 * (n ^ 2)))))).add (((hasDerivAt_const t ((-2))).mul (hasDerivAt_const t (n))).mul (((hasDerivAt_const t (b)).add (hX.pow 2)).add (hY.pow 2)))).mul (((hasDerivAt_const t (c)).add (hX.pow 4)).add (hY.pow 4)))).add ((((hasDerivAt_const t ((-8))).mul (hasDerivAt_const t (n))).mul (((hasDerivAt_const t (a)).add hX).add hY)).mul (((hasDerivAt_const t (d)).add (hX.pow 5)).add (hY.pow 5))))
  convert h using 1 <;> (try dsimp [N, Dx, Dy]) <;> (first | rfl | ring)
private theorem numerator_Dx_Dy (n x y a b c d e : ℝ) :
    x^2*(Dy n x y a b c d e*(x^4+y^4+c)-8*N n x y a b c d e*y^3) -
      y^2*(Dx n x y a b c d e*(x^4+y^4+c)-8*N n x y a b c d e*x^3) =
        4*(x-y)*Q n x y a b c d e := by
  unfold Dx Dy N Q; ring
private theorem pair_direction_derivative (n a b c d e : ℝ) (X Y : ℝ → ℝ) (t : ℝ)
    (hx : 0 < X t) (hy : 0 < Y t) (hc : 0 ≤ c)
    (hX : HasDerivAt X (-1/(3*(X t)^2)) t)
    (hY : HasDerivAt Y (1/(3*(Y t)^2)) t) :
    HasDerivAt (fun q => twoCore n a b c d e (X q) (Y q))
      (4*(X t-Y t)*Q n (X t) (Y t) a b c d e /
        (27*(X t)^2*(Y t)^2*((X t)^4+(Y t)^4+c)^3)) t := by
  have hN := hasDerivAt_N n a b c d e X Y _ _ t hX hY
  have hS := ((hX.pow 4).add (hY.pow 4)).add_const c
  have hD := (hS.pow 2).const_mul 9
  have hs : 0 < (X t)^4+(Y t)^4+c := by positivity
  have hne : 9*((X t)^4+(Y t)^4+c)^2 ≠ 0 := by positivity
  have h := hN.div hD hne
  convert h using 1 <;> try rfl
  dsimp
  rw [← numerator_Dx_Dy n (X t) (Y t) a b c d e]
  have hx0 := hx.ne'; have hy0 := hy.ne'; have hs0 := hs.ne'
  field_simp [hx0, hy0, hs0]
  ring
private theorem cubeRoot_linear_hasDerivAt (l direction t : ℝ) (hl : 0 < l+direction*t) :
    HasDerivAt (fun q : ℝ => (l+direction*q)^(1/3 : ℝ))
      (direction/(3*((l+direction*t)^(1/3 : ℝ))^2)) t := by
  have h := ((hasDerivAt_const t l).add ((hasDerivAt_id t).const_mul direction)).rpow_const (p := (1/3 : ℝ)) (Or.inl hl.ne')
  convert h using 1 <;> try rfl
  dsimp
  rw [show (1/3 : ℝ)-1 = -((1/3)*2) by norm_num,
    Real.rpow_neg hl.le, Real.rpow_mul hl.le]
  simp only [Real.rpow_two, div_eq_mul_inv, mul_inv_rev, inv_pow]
  ring
private def lambdaPairCore (m : ℕ) (z : Fin m → ℝ) (l1 l2 : ℝ) : ℝ :=
  twoCore (m+2 : ℕ) (P _ z 1) (P _ z 2) (P _ z 4) (P _ z 5) (P _ z 6)
    (l1^(1/3 : ℝ)) (l2^(1/3 : ℝ))
private theorem lambda_pair_hasDerivAt (m : ℕ) (z : Fin m → ℝ) (l1 l2 t : ℝ)
    (hz : ∀ r, 0 ≤ z r) (h1 : 0 < l1-t) (h2 : 0 < l2+t) :
    HasDerivAt (fun q => lambdaPairCore m z (l1-q) (l2+q))
      (4*((l1-t)^(1/3 : ℝ)-(l2+t)^(1/3 : ℝ))*
        Q (m+2 : ℕ) ((l1-t)^(1/3 : ℝ)) ((l2+t)^(1/3 : ℝ))
          (P _ z 1) (P _ z 2) (P _ z 4) (P _ z 5) (P _ z 6) /
        (27*((l1-t)^(1/3 : ℝ))^2*((l2+t)^(1/3 : ℝ))^2*
          (((l1-t)^(1/3 : ℝ))^4+((l2+t)^(1/3 : ℝ))^4+P _ z 4)^3)) t := by
  apply pair_direction_derivative (m+2 : ℕ) (P _ z 1) (P _ z 2)
    (P _ z 4) (P _ z 5) (P _ z 6)
    (fun q : ℝ => (l1-q)^(1/3 : ℝ)) (fun q : ℝ => (l2+q)^(1/3 : ℝ)) t
    (Real.rpow_pos_of_pos h1 _) (Real.rpow_pos_of_pos h2 _) (moment_nonneg z hz 4)
  · simpa [sub_eq_add_neg] using cubeRoot_linear_hasDerivAt l1 (-1) t (by simpa using h1)
  · simpa using cubeRoot_linear_hasDerivAt l2 1 t (by simpa using h2)
private theorem lambda_pair_deriv_pos (m : ℕ) (z : Fin m → ℝ) (l1 l2 t : ℝ)
    (hz : ∀ r, 0 ≤ z r) (h1 : 0 < l1-t) (h2 : 0 < l2+t) (hlt : l2+t < l1-t) :
    0 < deriv (fun q => lambdaPairCore m z (l1-q) (l2+q)) t := by
  rw [(lambda_pair_hasDerivAt m z l1 l2 t hz h1 h2).deriv]
  have hx := Real.rpow_pos_of_pos h1 (1/3 : ℝ)
  have hy := Real.rpow_pos_of_pos h2 (1/3 : ℝ)
  have hxy := Real.rpow_lt_rpow h2.le hlt (by norm_num : 0 < (1/3 : ℝ))
  have hQ := Q_pos_moments m _ _ z hx hy hz
  have hc := moment_nonneg z hz 4
  apply div_pos
  · exact mul_pos (mul_pos (by norm_num) (sub_pos.mpr hxy)) hQ
  · positivity
end D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Calculus

noncomputable section
open scoped BigOperators
namespace D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Transfer
open D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Algebra D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Moments D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Calculus
set_option maxHeartbeats 0

private theorem lambda_pair_symmetric (m : ℕ) (z : Fin m → ℝ) (l1 l2 : ℝ) :
    lambdaPairCore m z l1 l2 = lambdaPairCore m z l2 l1 := by
  unfold lambdaPairCore twoCore N
  congr 1 <;> ring

private theorem lambda_pair_strictMono (m : ℕ) (z : Fin m → ℝ) (l1 l2 : ℝ)
    (hz : ∀ r, 0 ≤ z r) (h2 : 0 < l2) (hlt : l2 < l1) :
    StrictMonoOn (fun q => lambdaPairCore m z (l1-q) (l2+q))
      (Set.Icc 0 ((l1-l2)/2)) := by
  apply strictMonoOn_of_deriv_pos (convex_Icc _ _)
  · intro t ht
    exact (lambda_pair_hasDerivAt m z l1 l2 t hz (by linarith [ht.2])
      (by linarith [ht.1])).continuousAt.continuousWithinAt
  · intro t ht
    simp only [interior_Icc, Set.mem_Ioo] at ht
    exact lambda_pair_deriv_pos m z l1 l2 t hz (by linarith [ht.2])
      (by linarith [ht.1]) (by linarith [ht.2])

private theorem strict_equalizing_transfer (m : ℕ) (z : Fin m → ℝ) (l1 l2 delta : ℝ)
    (hz : ∀ r, 0 ≤ z r) (h2 : 0 < l2) (hlt : l2 < l1)
    (hd : 0 < delta) (hdmax : delta ≤ (l1-l2)/2) :
    lambdaPairCore m z l1 l2 < lambdaPairCore m z (l1-delta) (l2+delta) := by
  have h := lambda_pair_strictMono m z l1 l2 hz h2 hlt
    (show (0 : ℝ) ∈ Set.Icc 0 ((l1-l2)/2) by constructor <;> linarith)
    (show delta ∈ Set.Icc 0 ((l1-l2)/2) from ⟨hd.le,hdmax⟩) hd
  simpa using h

private theorem strict_t_transform (m : ℕ) (z : Fin m → ℝ) (l1 l2 t : ℝ)
    (hz : ∀ r, 0 ≤ z r) (h2 : 0 < l2) (hlt : l2 < l1)
    (ht : 0 < t) (ht1 : t < 1) :
    lambdaPairCore m z l1 l2 <
      lambdaPairCore m z ((1-t)*l1+t*l2) ((1-t)*l2+t*l1) := by
  by_cases hh : t ≤ 1/2
  · have hd : 0 < t*(l1-l2) := mul_pos ht (sub_pos.mpr hlt)
    have hm : t*(l1-l2) ≤ (l1-l2)/2 := by nlinarith
    have h := strict_equalizing_transfer m z l1 l2 (t*(l1-l2)) hz h2 hlt hd hm
    convert h using 1 <;> congr 1 <;> ring
  · have hd : 0 < (1-t)*(l1-l2) := mul_pos (by linarith) (sub_pos.mpr hlt)
    have hm : (1-t)*(l1-l2) ≤ (l1-l2)/2 := by nlinarith
    have h := strict_equalizing_transfer m z l1 l2 ((1-t)*(l1-l2)) hz h2 hlt hd hm
    rw [lambda_pair_symmetric m z ((1-t)*l1+t*l2) ((1-t)*l2+t*l1)]
    convert h using 1 <;> congr 1 <;> ring

end D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Transfer

noncomputable section
open scoped BigOperators
namespace D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Vector
open D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Algebra D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Moments D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Calculus D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Transfer
set_option maxHeartbeats 0

private def rootVector {m : ℕ} (x y : ℝ) (z : Fin m → ℝ) : Fin (m+2) → ℝ :=
  Fin.cons x (Fin.cons y z)

def spectralN {n : ℕ} (r : Fin n → ℝ) : ℝ :=
  ((4*(n : ℝ)^2-2)*(P _ r 1)^2-2*(n : ℝ)*P _ r 2)*P _ r 4 -
    8*(n : ℝ)*P _ r 1*P _ r 5+8*P _ r 6

def spectralRatio {n : ℕ} (r : Fin n → ℝ) : ℝ := spectralN r/(9*(P _ r 4)^2)

def lambdaRatio {n : ℕ} (l : Fin n → ℝ) : ℝ :=
  spectralRatio (fun i => l i^(1/3 : ℝ))

private theorem moment_rootVector {m : ℕ} (x y : ℝ) (z : Fin m → ℝ) (k : ℕ) :
    P _ (rootVector x y z) k = x^k+y^k+P _ z k := by
  simp [P_evalSum, rootVector, Fin.sum_univ_succ, add_assoc]

private theorem spectralRatio_rootVector {m : ℕ} (x y : ℝ) (z : Fin m → ℝ) :
    spectralRatio (rootVector x y z) = twoCore (m+2 : ℕ)
      (P _ z 1) (P _ z 2) (P _ z 4) (P _ z 5) (P _ z 6) x y := by
  unfold spectralRatio spectralN twoCore N
  simp_rw [moment_rootVector]
  simp only [pow_one]
  congr 1 <;> ring

private theorem cubeRoot_cube (x : ℝ) (hx : 0 ≤ x) : (x^3)^(1/3 : ℝ) = x := by
  rw [← Real.rpow_natCast x 3, ← Real.rpow_mul hx]
  norm_num

private theorem lambdaRatio_rootVector {m : ℕ} (l1 l2 : ℝ) (z : Fin m → ℝ)
    (hz : ∀ r, 0 ≤ z r) :
    lambdaRatio (rootVector l1 l2 (fun r => z r^3)) = lambdaPairCore m z l1 l2 := by
  have hv : (fun i => rootVector l1 l2 (fun r => z r^3) i^(1/3 : ℝ)) =
      rootVector (l1^(1/3 : ℝ)) (l2^(1/3 : ℝ)) z := by
    ext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp [rootVector]
    · refine Fin.cases ?_ (fun k => ?_) j
      · simp [rootVector]
      · change (z k^3)^(1/3 : ℝ) = z k
        exact cubeRoot_cube _ (hz k)
  unfold lambdaRatio
  rw [hv, spectralRatio_rootVector]
  rfl

end D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Vector

noncomputable section
open scoped BigOperators
namespace D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Pair
open D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Moments D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Calculus D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Transfer D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Vector
set_option maxHeartbeats 0

private theorem cube_cubeRoot (x : ℝ) (hx : 0 ≤ x) : (x^(1/3 : ℝ))^3 = x := by
  rw [← Real.rpow_natCast _ 3, ← Real.rpow_mul hx]
  norm_num

private def pairPerm {m : ℕ} (i j : Fin (m+2)) : Equiv.Perm (Fin (m+2)) :=
  (Equiv.swap 1 ((Equiv.swap 0 i) j)).trans (Equiv.swap 0 i)

private theorem pairPerm_zero {m : ℕ} (i j : Fin (m+2)) (hij : i ≠ j) : pairPerm i j 0 = i := by
  have hk : (Equiv.swap 0 i) j ≠ 0 := by
    intro h
    have h' := congrArg (Equiv.swap 0 i) h
    simp only [Equiv.swap_apply_self, Equiv.swap_apply_left] at h'
    exact hij h'.symm
  simp only [pairPerm, Equiv.trans_apply]
  rw [Equiv.swap_apply_of_ne_of_ne (by intro h; have hv := congrArg Fin.val h; simp at hv : (0 : Fin (m+2)) ≠ 1) hk.symm,
    Equiv.swap_apply_left]

private theorem pairPerm_one {m : ℕ} (i j : Fin (m+2)) : pairPerm i j 1 = j := by
  simp [pairPerm]

theorem lambdaRatio_perm {n : ℕ} (l : Fin n → ℝ) (p : Equiv.Perm (Fin n)) :
    lambdaRatio (l ∘ p) = lambdaRatio l := by
  unfold lambdaRatio spectralRatio spectralN
  simp_rw [P_evalSum]
  simp only [Function.comp_apply]
  have hsum (k : ℕ) : (∑ i, (l (p i)^(1/3 : ℝ))^k) = ∑ i, (l i^(1/3 : ℝ))^k := Equiv.sum_comp p (fun i => (l i^(1/3 : ℝ))^k)
  rw [hsum 1, hsum 2, hsum 4, hsum 5, hsum 6]

def pairLine {n : ℕ} (l : Fin n → ℝ) (i j : Fin n) (t : ℝ) : Fin n → ℝ :=
  l + t • (Pi.single j 1-Pi.single i 1)

private theorem pairLine_reindex {m : ℕ} (l : Fin (m+2) → ℝ) (i j : Fin (m+2)) (hij : i ≠ j)
    (hl : ∀ k, 0 < l k) (t : ℝ) :
    pairLine l i j t ∘ pairPerm i j =
      rootVector (l i-t) (l j+t)
        (fun k => ((l (pairPerm i j k.succ.succ))^(1/3 : ℝ))^3) := by
  ext k
  refine Fin.cases ?_ (fun k => ?_) k
  · simp [pairLine, pairPerm_zero i j hij, rootVector, hij, hij.symm, sub_eq_add_neg]
  · refine Fin.cases ?_ (fun k => ?_) k
    · simp [pairLine, pairPerm_one, rootVector, hij, hij.symm, sub_eq_add_neg]
    · have hki : pairPerm i j k.succ.succ ≠ i := by
        have h := (pairPerm i j).injective.ne (by simp : k.succ.succ ≠ (0 : Fin (m+2)))
        simpa only [pairPerm_zero i j hij] using h
      have hkj : pairPerm i j k.succ.succ ≠ j := by
        have h := (pairPerm i j).injective.ne (by intro h; have hv := congrArg Fin.val h; simp at hv : k.succ.succ ≠ (1 : Fin (m+2)))
        simpa only [pairPerm_one i j] using h
      simp [pairLine, rootVector, Function.comp_apply, Pi.single_apply, hki, hkj,
        sub_eq_add_neg]
      simpa only [one_div] using (cube_cubeRoot _ (hl _).le).symm

theorem mixPair_eq_pairLine {n : ℕ} (l : Fin n → ℝ) (i j : Fin n) (hij : i ≠ j) (t : ℝ) :
    ((1-t) • l+t • (l ∘ Equiv.swap i j)) = pairLine l i j (t*(l i-l j)) := by
  ext k
  by_cases hki : k=i
  · subst k; simp [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Function.comp_apply, pairLine, hij, hij.symm]; ring
  by_cases hkj : k=j
  · subst k; simp [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Function.comp_apply, pairLine, hij, hij.symm]; ring
  · simp [Pi.add_apply, Pi.smul_apply, smul_eq_mul, Function.comp_apply, pairLine, hki, hkj, Equiv.swap_apply_of_ne_of_ne hki hkj]
    ring

private theorem strict_t_transform_any_pair_succ (m : ℕ) (l : Fin (m+2) → ℝ)
    (hl : ∀ k, 0 < l k) (i j : Fin (m+2)) (hij : l j < l i)
    (t : ℝ) (ht : 0 < t) (ht1 : t < 1) :
    lambdaRatio l < lambdaRatio (((1-t) • l+t • (l ∘ Equiv.swap i j))) := by
  have hne : i ≠ j := by intro h; simpa [h] using hij
  let z : Fin m → ℝ := fun k => (l (pairPerm i j k.succ.succ))^(1/3 : ℝ)
  have hz : ∀ k, 0 ≤ z k := fun k => (Real.rpow_pos_of_pos (hl _) _).le
  have he (d : ℝ) : lambdaRatio (pairLine l i j d) =
      lambdaPairCore m z (l i-d) (l j+d) := by
    rw [← lambdaRatio_perm (pairLine l i j d) (pairPerm i j), pairLine_reindex l i j hne hl d]
    exact lambdaRatio_rootVector _ _ _ hz
  have hstart : lambdaRatio l = lambdaPairCore m z (l i) (l j) := by
    simpa [pairLine] using he 0
  rw [hstart, mixPair_eq_pairLine l i j hne t, he]
  convert strict_t_transform m z (l i) (l j) t hz (hl j) hij ht ht1 using 1 <;> congr 1 <;> ring

theorem strict_t_transform_any_pair (n : ℕ) (hn : 2 ≤ n) (l : Fin n → ℝ)
    (hl : ∀ k, 0 < l k) (i j : Fin n) (hij : l j < l i)
    (t : ℝ) (ht : 0 < t) (ht1 : t < 1) :
    lambdaRatio l < lambdaRatio (((1-t) • l+t • (l ∘ Equiv.swap i j))) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m+2 := ⟨n-2, by omega⟩
  exact strict_t_transform_any_pair_succ m l hl i j hij t ht ht1

end D5.S3.Geometry.AlphaGeometry.CubeRootSpectralMonotonicity.Pair


