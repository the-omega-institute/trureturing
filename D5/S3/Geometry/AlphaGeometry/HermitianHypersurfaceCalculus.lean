namespace D5.S3.Geometry.AlphaGeometry.HermitianDensityCoordinates

def G (n : ℕ) (k : Fin (n^2-1)) : Matrix (Fin n) (Fin n) ℂ := fun r s =>
  let row := k.val / n
  let col := k.val % n
  if row = col then
    (if r.val = row ∧ s.val = row then 1 else 0) -
      (if r.val = n-1 ∧ s.val = n-1 then 1 else 0)
  else if row < col then
    if (r.val = row ∧ s.val = col) ∨ (r.val = col ∧ s.val = row) then 1 else 0
  else
    (if r.val = row ∧ s.val = col then Complex.I else 0) -
      (if r.val = col ∧ s.val = row then Complex.I else 0)

def rho {n : ℕ} (x : Fin (n^2-1) → ℝ) : Matrix (Fin n) (Fin n) ℂ :=
  ((1 : ℝ)/(n : ℝ)) • (1 : Matrix (Fin n) (Fin n) ℂ) + ∑ k, x k • G n k

def chartPoint {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ) : Fin (n^2-1) → ℝ := fun k =>
  let row := k.val / n
  let col := k.val % n
  if h : row < n ∧ col < n then
    let entry := A ⟨row,h.1⟩ ⟨col,h.2⟩
    if row = col then entry.re - 1/(n : ℝ)
    else if row < col then entry.re else entry.im
  else 0

private lemma G_isHermitian (n : ℕ) (k : Fin (n^2-1)) : (G n k).IsHermitian := by
  unfold Matrix.IsHermitian
  ext r s
  simp only [Matrix.conjTranspose_apply]
  unfold G
  dsimp only
  split_ifs <;> simp_all [and_comm,or_comm] <;> aesop

private lemma G_indices {n : ℕ} (hn : 0 < n) (k : Fin (n^2-1)) :
    k.val / n < n ∧ k.val % n < n := by
  refine ⟨(Nat.div_lt_iff_lt_mul hn).mpr ?_,Nat.mod_lt _ hn⟩
  have hk := k.isLt
  nlinarith [Nat.sub_le (n^2) 1]

private lemma G_diagonal_not_last {n : ℕ} (hn : 0 < n) (k : Fin (n^2-1))
    (heq : k.val / n = k.val % n) : k.val / n ≠ n-1 := by
  intro hlast
  have hd := Nat.div_add_mod k.val n
  have hk := k.isLt
  have hcol : k.val % n = n-1 := heq.symm.trans hlast
  rw [hlast,hcol] at hd
  have hnm : n-1+1=n := Nat.sub_add_cancel hn
  have hn2 : 1 ≤ n^2 := by nlinarith
  have hsub : n^2-1+1=n^2 := Nat.sub_add_cancel hn2
  nlinarith

private lemma G_trace {n : ℕ} (hn : 0 < n) (k : Fin (n^2-1)) : (G n k).trace = 0 := by
  classical
  by_cases heq : k.val / n = k.val % n
  · let r0 : Fin n := ⟨k.val/n,(G_indices hn k).1⟩
    let last : Fin n := ⟨n-1,Nat.sub_lt hn (by decide)⟩
    have hrow (r : Fin n) : r.val = k.val/n ↔ r = r0 := by
      change r.val = r0.val ↔ r = r0
      exact Fin.ext_iff.symm
    have hlast (r : Fin n) : r.val = n-1 ↔ r = last := by
      change r.val = last.val ↔ r = last
      exact Fin.ext_iff.symm
    simp only [Matrix.trace,Matrix.diag,G,if_pos heq,and_self]
    simp_rw [hrow,hlast]
    simp
  · unfold Matrix.trace
    apply Finset.sum_eq_zero
    intro r _
    dsimp only [Matrix.diag,G]
    split_ifs <;> simp_all <;> aesop

theorem rho_isHermitian {n : ℕ} (x : Fin (n^2-1) → ℝ) : (rho x).IsHermitian := by
  unfold rho
  apply Matrix.IsHermitian.add
  · exact Matrix.isHermitian_one.smul (IsSelfAdjoint.all _)
  · have H (s : Finset (Fin (n^2-1))) : (∑ k ∈ s, x k • G n k).IsHermitian := by
      induction s using Finset.induction with
      | empty => simpa using (Matrix.isHermitian_zero : (0 : Matrix (Fin n) (Fin n) ℂ).IsHermitian)
      | insert k s hks ih =>
        rw [Finset.sum_insert hks]
        exact ((G_isHermitian n k).smul (IsSelfAdjoint.all _)).add ih
    exact H Finset.univ

theorem rho_trace {n : ℕ} (hn : 0 < n) (x : Fin (n^2-1) → ℝ) : (rho x).trace = 1 := by
  simp only [rho,Matrix.trace_add,Matrix.trace_sum,Matrix.trace_smul,G_trace hn,
    smul_zero,Finset.sum_const_zero,add_zero,Matrix.trace_one,Fintype.card_fin]
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  change ((1 : ℝ)/(n : ℝ)) • (n : ℂ) = 1
  have hnC : (n : ℂ) ≠ 0 := by exact_mod_cast hn.ne'
  simp [Complex.real_smul,hnC]

private theorem rho_continuous (n : ℕ) : Continuous (@rho n) := by
  unfold rho
  fun_prop


private lemma grid_injective {n : ℕ} {k l : Fin (n^2-1)}
    (hr : k.val / n = l.val / n) (hc : k.val % n = l.val % n) : k = l := by
  apply Fin.ext
  have hk := Nat.div_add_mod k.val n
  have hl := Nat.div_add_mod l.val n
  rw [hr,hc] at hk
  exact hk.symm.trans hl

private lemma G_diag_re {n : ℕ} (hn : 0 < n) (k l : Fin (n^2-1))
    (hk : k.val/n = k.val%n) :
    (G n l ⟨k.val/n,(G_indices hn k).1⟩ ⟨k.val%n,(G_indices hn k).2⟩).re =
      if l = k then 1 else 0 := by
  have hlast := G_diagonal_not_last hn k hk
  by_cases he : l = k
  · subst l
    simp [G,hk,show k.val%n ≠ n-1 by omega]
  · have hd : ¬(l.val/n = l.val%n ∧ k.val/n = l.val/n ∧ k.val%n = l.val/n) := by
      intro h
      apply he
      exact grid_injective h.2.1.symm (by omega)
    unfold G
    dsimp only
    split_ifs <;> norm_num <;> try omega
    all_goals first | contradiction | aesop

private lemma G_upper_re {n : ℕ} (hn : 0 < n) (k l : Fin (n^2-1))
    (hk : k.val/n < k.val%n) :
    (G n l ⟨k.val/n,(G_indices hn k).1⟩ ⟨k.val%n,(G_indices hn k).2⟩).re =
      if l = k then 1 else 0 := by
  by_cases he : l = k
  · subst l
    simp [G,show ¬k.val/n = k.val%n by omega,hk,Complex.I_re]
  · have hf : ¬(k.val/n = l.val/n ∧ k.val%n = l.val%n) := by
      intro h; exact he (grid_injective h.1.symm h.2.symm)
    have hr : ¬(l.val/n < l.val%n ∧ k.val/n = l.val%n ∧ k.val%n = l.val/n) := by omega
    unfold G
    dsimp only
    split_ifs <;> norm_num <;> omega

private lemma G_lower_im {n : ℕ} (hn : 0 < n) (k l : Fin (n^2-1))
    (hk : k.val%n < k.val/n) :
    (G n l ⟨k.val/n,(G_indices hn k).1⟩ ⟨k.val%n,(G_indices hn k).2⟩).im =
      if l = k then 1 else 0 := by
  by_cases he : l = k
  · subst l
    simp [G,show ¬k.val/n = k.val%n by omega,show ¬k.val/n < k.val%n by omega,
      Complex.I_im,show ¬(k.val/n = k.val%n ∧ k.val%n = k.val/n) by omega]
  · have hf : ¬(k.val/n = l.val/n ∧ k.val%n = l.val%n) := by
      intro h; exact he (grid_injective h.1.symm h.2.symm)
    have hr : ¬(l.val%n ≤ l.val/n ∧ k.val/n = l.val%n ∧ k.val%n = l.val/n) := by omega
    unfold G
    dsimp only
    split_ifs <;> norm_num <;> omega

theorem chart_left_inverse {n : ℕ} (hn : 0 < n) : ∀ x : Fin (n^2-1) → ℝ, chartPoint (rho x) = x := by
  intro x
  funext k
  let r : Fin n := ⟨k.val/n,(G_indices hn k).1⟩
  let c : Fin n := ⟨k.val%n,(G_indices hn k).2⟩
  simp only [chartPoint,dif_pos (G_indices hn k)]
  change (if k.val/n = k.val%n then (rho x r c).re - 1/(n : ℝ)
    else if k.val/n < k.val%n then (rho x r c).re else (rho x r c).im) = x k
  rcases lt_trichotomy (k.val/n) (k.val%n) with hk | hk | hk
  · have hrc : r ≠ c := by intro he; have := congrArg Fin.val he; dsimp [r,c] at this; omega
    simp only [if_neg (ne_of_lt hk),if_pos hk]
    simp [rho,Matrix.sum_apply,Matrix.one_apply,hrc,Complex.re_sum,Complex.smul_re,
      r,c,G_upper_re hn k _ hk]
  · simp only [if_pos hk]
    have hrc : r = c := Fin.ext hk
    simp only [rho,Matrix.add_apply,Matrix.smul_apply,Matrix.sum_apply,
      Complex.add_re,Complex.re_sum,Complex.smul_re,smul_eq_mul]
    rw [show (1 : Matrix (Fin n) (Fin n) ℂ) r c = 1 by simp [Matrix.one_apply,hrc]]
    simp only [Complex.one_re,mul_one]
    have hd (l : Fin (n^2-1)) : (G n l r c).re = if l=k then 1 else 0 := G_diag_re hn k l hk
    simp_rw [hd]
    simp
  · simp only [if_neg (ne_of_gt hk),if_neg (not_lt_of_ge hk.le)]
    have hrc : r ≠ c := by intro he; have := congrArg Fin.val he; dsimp [r,c] at this; omega
    simp [rho,Matrix.sum_apply,Matrix.one_apply,hrc,Complex.im_sum,Complex.smul_im,r,c,G_lower_im hn k _ hk]

private lemma grid_lt {n : ℕ} (hn : 0 < n) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) : n*r.val+s.val < n^2-1 := by
  have hn2 : 1 ≤ n^2 := by nlinarith
  have hsub : n^2-1+1 = n^2 := Nat.sub_add_cancel hn2
  have hr := r.isLt
  have hs := s.isLt
  have hr' : r.val ≤ n-1 := by omega
  have hs' : s.val ≤ n-1 := by omega
  rcases h with h | h
  · have hr'' : r.val+2 ≤ n := by omega
    have hmul : n*(r.val+2) ≤ n*n := Nat.mul_le_mul_left n hr''
    nlinarith [Nat.sub_add_cancel hn,hsub]
  · have hs'' : s.val+2 ≤ n := by omega
    have hmul : n*(r.val+1) ≤ n*n := Nat.mul_le_mul_left n (by omega)
    nlinarith [Nat.sub_add_cancel hn,hsub]

private def gridIndex {n : ℕ} (hn : 0 < n) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) : Fin (n^2-1) := ⟨n*r.val+s.val,grid_lt hn r s h⟩

private lemma gridIndex_row {n : ℕ} (hn : 0 < n) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) : (gridIndex hn r s h).val/n = r.val := by
  simp only [gridIndex]
  rw [Nat.mul_add_div hn]
  simp [Nat.div_eq_of_lt s.isLt]

private lemma gridIndex_col {n : ℕ} (hn : 0 < n) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) : (gridIndex hn r s h).val%n = s.val := by
  simp [gridIndex,Nat.add_mod,Nat.mod_eq_of_lt s.isLt]

private lemma chart_at_grid {n : ℕ} (hn : 0 < n) (A : Matrix (Fin n) (Fin n) ℂ) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) :
    chartPoint A (gridIndex hn r s h) =
      if r.val = s.val then (A r s).re - 1/(n : ℝ)
      else if r.val < s.val then (A r s).re else (A r s).im := by
  simp (config := { congrConsts := false }) only [chartPoint,gridIndex_row,gridIndex_col,dif_pos (show r.val < n ∧ s.val < n from ⟨r.isLt,s.isLt⟩)]

private lemma extract_real {n : ℕ} (hn : 0 < n) {A B : Matrix (Fin n) (Fin n) ℂ}
    (hchart : chartPoint A = chartPoint B) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) (hrs : r.val ≤ s.val) :
    (A r s).re = (B r s).re := by
  have he := congrFun hchart (gridIndex hn r s h)
  rw [chart_at_grid hn A,chart_at_grid hn B] at he
  by_cases hrc : r.val = s.val
  · simp only [if_pos hrc] at he
    linarith
  · simpa only [if_neg hrc,if_pos (lt_of_le_of_ne hrs hrc)] using he

private lemma extract_imag {n : ℕ} (hn : 0 < n) {A B : Matrix (Fin n) (Fin n) ℂ}
    (hchart : chartPoint A = chartPoint B) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) (hrs : s.val < r.val) :
    (A r s).im = (B r s).im := by
  have he := congrFun hchart (gridIndex hn r s h)
  simpa (config := { congrConsts := false }) only [chart_at_grid hn A,chart_at_grid hn B,
    if_neg (ne_of_gt hrs),if_neg (not_lt_of_ge hrs.le)] using he

private lemma diagonal_imag_zero {n : ℕ} {A : Matrix (Fin n) (Fin n) ℂ} (hA : A.IsHermitian) (r : Fin n) :
    (A r r).im = 0 := by
  have he := congrArg Complex.im (hA.apply r r)
  change -(A r r).im = (A r r).im at he
  linarith

private lemma entry_eq_nonfinal {n : ℕ} (hn : 0 < n) {A B : Matrix (Fin n) (Fin n) ℂ}
    (hA : A.IsHermitian) (hB : B.IsHermitian)
    (hchart : chartPoint A = chartPoint B) (r s : Fin n)
    (h : r.val ≠ n-1 ∨ s.val ≠ n-1) : A r s = B r s := by
  have hs : s.val ≠ n-1 ∨ r.val ≠ n-1 := h.symm
  rcases lt_trichotomy r.val s.val with hrs | hrs | hrs
  · apply Complex.ext
    · exact extract_real hn hchart r s h hrs.le
    · have hi := extract_imag hn hchart s r hs hrs
      have ha := congrArg Complex.im (hA.apply r s)
      have hb := congrArg Complex.im (hB.apply r s)
      change -(A s r).im = (A r s).im at ha
      change -(B s r).im = (B r s).im at hb
      linarith
  · have he : r=s := Fin.ext hrs
    subst s
    apply Complex.ext
    · exact extract_real hn hchart r r h le_rfl
    · rw [diagonal_imag_zero hA,diagonal_imag_zero hB]
  · apply Complex.ext
    · have hi := extract_real hn hchart s r hs hrs.le
      have ha := congrArg Complex.re (hA.apply r s)
      have hb := congrArg Complex.re (hB.apply r s)
      change (A s r).re = (A r s).re at ha
      change (B s r).re = (B r s).re at hb
      exact ha.symm.trans (hi.trans hb)
    · exact extract_imag hn hchart r s h hrs

private lemma chart_injective {n : ℕ} (hn : 0 < n) {A B : Matrix (Fin n) (Fin n) ℂ}
    (hA : A.IsHermitian) (hB : B.IsHermitian) (hAt : A.trace = 1) (hBt : B.trace = 1)
    (hchart : chartPoint A = chartPoint B) : A = B := by
  classical
  ext r s
  by_cases h : r.val ≠ n-1 ∨ s.val ≠ n-1
  · exact entry_eq_nonfinal hn hA hB hchart r s h
  · have hr : r.val = n-1 := by tauto
    have hs : s.val = n-1 := by tauto
    have hrs : r=s := Fin.ext (hr.trans hs.symm)
    subst s
    apply Complex.ext
    · have hsum : (∑ i, (A i i).re) = ∑ i, (B i i).re := by
        simpa only [Matrix.trace,Matrix.diag,Complex.re_sum] using congrArg Complex.re (hAt.trans hBt.symm)
      have hd : (∑ i, ((A i i).re - (B i i).re)) = 0 := by
        rw [Finset.sum_sub_distrib,hsum,sub_self]
      rw [Finset.sum_eq_single r] at hd
      · linarith
      · intro i _ hir
        have hilast : i.val ≠ n-1 := by intro he; exact hir (Fin.ext (he.trans hr.symm))
        rw [entry_eq_nonfinal hn hA hB hchart i i (Or.inl hilast),sub_self]
      · simp
    · rw [diagonal_imag_zero hA,diagonal_imag_zero hB]

theorem hermitian_trace_one_chart_equiv {n : ℕ} (hn : 0 < n) : ∀ A : Matrix (Fin n) (Fin n) ℂ, A.IsHermitian → A.trace = 1 → rho (chartPoint A) = A := by
  intro A hA ht
  exact chart_injective hn (rho_isHermitian _) hA (rho_trace hn _) ht
    (chart_left_inverse hn _)


open Filter Topology

theorem hermitian_posdef_open (n : ℕ) : IsOpen {A : {A : Matrix (Fin n) (Fin n) ℂ // A.IsHermitian} | A.val.PosDef} := by
  apply isOpen_iff_mem_nhds.mpr
  intro A hA
  have hpos : IsStrictlyPositive A.val := hA.isStrictlyPositive
  have he := (upperHemicontinuous_spectrum ℝ (Matrix (Fin n) (Fin n) ℂ)).forall_isOpen
    A.val (Set.Ioi 0) isOpen_Ioi (by
      intro t ht
      exact hpos.spectrum_pos ht)
  have hes := (continuous_subtype_val.tendsto A).eventually he
  filter_upwards [hes] with B hB
  apply Matrix.IsStrictlyPositive.posDef
  exact (CStarAlgebra.isStrictlyPositive_iff_isSelfAdjoint_and_spectrum_pos).mpr
    ⟨B.property.isSelfAdjoint,hB⟩

theorem positive_chart_open (n : ℕ) : IsOpen {x : Fin (n^2-1) → ℝ | (rho x).PosDef} := by
  let f : (Fin (n^2-1) → ℝ) → {A : Matrix (Fin n) (Fin n) ℂ // A.IsHermitian} :=
    fun x => ⟨rho x, rho_isHermitian x⟩
  have hf : Continuous f := (rho_continuous n).subtype_mk _
  exact (hermitian_posdef_open n).preimage hf

end D5.S3.Geometry.AlphaGeometry.HermitianDensityCoordinates

noncomputable section
open scoped BigOperators Topology
open Filter
namespace D5.S3.Geometry.AlphaGeometry.EuclideanHypersurfaceGauss

open Matrix

def christoffel {m : ℕ} (g : (Fin m → ℝ) → Matrix (Fin m) (Fin m) ℝ)
    (x : Fin m → ℝ) (k i j : Fin m) : ℝ :=
  (1/2 : ℝ) * ∑ l, (g x)⁻¹ k l *
    (fderiv ℝ (fun t => g t l j) x (Pi.single i 1) +
     fderiv ℝ (fun t => g t l i) x (Pi.single j 1) -
     fderiv ℝ (fun t => g t i j) x (Pi.single l 1))

def ricci {m : ℕ} (g : (Fin m → ℝ) → Matrix (Fin m) (Fin m) ℝ)
    (x : Fin m → ℝ) (i j : Fin m) : ℝ :=
  ∑ k, (fderiv ℝ (fun t => christoffel g t k i j) x (Pi.single k 1) -
    fderiv ℝ (fun t => christoffel g t k i k) x (Pi.single j 1) +
    ∑ l, (christoffel g x k k l * christoffel g x l i j -
      christoffel g x k j l * christoffel g x l i k))

def scalarCurvature {m : ℕ} (g : (Fin m → ℝ) → Matrix (Fin m) (Fin m) ℝ)
    (x : Fin m → ℝ) : ℝ := ∑ i, ∑ j, (g x)⁻¹ i j * ricci g x i j

section
set_option backward.isDefEq.respectTransparency false
open Matrix

private lemma scalar_as_matrix_trace {m : ℕ} (g : (Fin m → ℝ) → Matrix (Fin m) (Fin m) ℝ)
    (x : Fin m → ℝ) : scalarCurvature g x = ((g x)⁻¹ᵀ * (Matrix.of (fun i j => ricci g x i j))).trace := by
  change (∑ i, ∑ j, (g x)⁻¹ i j * ricci g x i j) =
    ∑ i, ∑ j, (g x)⁻¹ j i * ricci g x j i
  rw [Finset.sum_comm]

theorem coordinate_gauss_scalar_of_ricci {m : ℕ}
    (g : (Fin m → ℝ) → Matrix (Fin m) (Fin m) ℝ) (x : Fin m → ℝ)
    (b : Matrix (Fin m) (Fin m) ℝ) (hg : (g x).IsSymm)
    (hRicci : (Matrix.of (fun i j => ricci g x i j)) = ((g x)⁻¹*b).trace • b - b*(g x)⁻¹*b) :
    scalarCurvature g x = ((g x)⁻¹*b).trace^2 - (((g x)⁻¹*b)^2).trace := by
  rw [scalar_as_matrix_trace, hg.inv.eq,hRicci,Matrix.mul_sub,Matrix.mul_smul,
    Matrix.trace_sub,Matrix.trace_smul]
  have he : (g x)⁻¹*(b*(g x)⁻¹*b) = ((g x)⁻¹*b)^2 := by noncomm_ring
  rw [he]
  simp only [smul_eq_mul,pow_two]

end

section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1000000
open Filter
variable {m : ℕ} {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

def structureRHS (e : Fin m → (Fin m → ℝ) → E) (N : (Fin m → ℝ) → E)
    (Γ : (Fin m → ℝ) → Fin m → Fin m → Fin m → ℝ)
    (b : (Fin m → ℝ) → Fin m → Fin m → ℝ) (i j : Fin m) (t : (Fin m → ℝ)) : E :=
  (∑ l, Γ t l i j • e l t) + b t i j • N t

private lemma structure_partial (e : Fin m → (Fin m → ℝ) → E) (N : (Fin m → ℝ) → E)
    (Γ : (Fin m → ℝ) → Fin m → Fin m → Fin m → ℝ)
    (b : (Fin m → ℝ) → Fin m → Fin m → ℝ) (x : (Fin m → ℝ))
    (he : ∀ l, DifferentiableAt ℝ (e l) x) (hN : DifferentiableAt ℝ N x)
    (hΓ : ∀ l i j, DifferentiableAt ℝ (fun t => Γ t l i j) x)
    (hb : ∀ i j, DifferentiableAt ℝ (fun t => b t i j) x) (i j k : Fin m) :
    fderiv ℝ (structureRHS e N Γ b i j) x (Pi.single k 1) =
      (∑ l, (fderiv ℝ (fun t => Γ t l i j) x (Pi.single k 1) • e l x +
        Γ x l i j • fderiv ℝ (e l) x (Pi.single k 1))) +
      fderiv ℝ (fun t => b t i j) x (Pi.single k 1) • N x +
        b x i j • fderiv ℝ N x (Pi.single k 1) := by
  have hp := (HasFDerivAt.fun_sum (u := Finset.univ)
    (fun l _ => (hΓ l i j).hasFDerivAt.smul (he l).hasFDerivAt)).add
      ((hb i j).hasFDerivAt.smul hN.hasFDerivAt)
  rw [show structureRHS e N Γ b i j = (fun t => (∑ l, Γ t l i j • e l t) + b t i j • N t) from rfl]
  change HasFDerivAt (structureRHS e N Γ b i j) _ x at hp
  rw [← show structureRHS e N Γ b i j = (fun t => (∑ l, Γ t l i j • e l t) + b t i j • N t) from rfl]
  rw [hp.fderiv]
  simp only [ContinuousLinearMap.add_apply,ContinuousLinearMap.sum_apply,
    ContinuousLinearMap.smulRight_apply,ContinuousLinearMap.smul_apply]
  simp only [Finset.sum_add_distrib]
  abel

private lemma dual_first_partial (e : Fin m → (Fin m → ℝ) → E) (N : (Fin m → ℝ) → E)
    (Γ : (Fin m → ℝ) → Fin m → Fin m → Fin m → ℝ)
    (b : (Fin m → ℝ) → Fin m → Fin m → ℝ) (x : (Fin m → ℝ)) (a : Fin m → E →L[ℝ] ℝ)
    (ha : ∀ k l, a k (e l x) = if k=l then 1 else 0)
    (hN : ∀ k, a k (N x) = 0)
    (hstr : ∀ i j, fderiv ℝ (e i) x (Pi.single j 1) = structureRHS e N Γ b i j x)
    (k i j : Fin m) : a k (fderiv ℝ (e i) x (Pi.single j 1)) = Γ x k i j := by
  rw [hstr]
  simp [structureRHS,map_sum,map_add,map_smul,ha,hN]

private lemma dual_second_partial (e : Fin m → (Fin m → ℝ) → E) (N : (Fin m → ℝ) → E)
    (Γ : (Fin m → ℝ) → Fin m → Fin m → Fin m → ℝ)
    (b : (Fin m → ℝ) → Fin m → Fin m → ℝ) (x : (Fin m → ℝ)) (a : Fin m → E →L[ℝ] ℝ)
    (he : ∀ l, DifferentiableAt ℝ (e l) x) (hN : DifferentiableAt ℝ N x)
    (hΓ : ∀ l i j, DifferentiableAt ℝ (fun t => Γ t l i j) x)
    (hb : ∀ i j, DifferentiableAt ℝ (fun t => b t i j) x)
    (ha : ∀ k l, a k (e l x) = if k=l then 1 else 0)
    (haN : ∀ k, a k (N x) = 0)
    (hstr : ∀ i j, (fun t => fderiv ℝ (e i) t (Pi.single j 1)) =ᶠ[𝓝 x] structureRHS e N Γ b i j)
    (l i j k : Fin m) :
    a l (fderiv ℝ (fun t => fderiv ℝ (e i) t (Pi.single j 1)) x (Pi.single k 1)) =
      fderiv ℝ (fun t => Γ t l i j) x (Pi.single k 1) +
        (∑ r, Γ x r i j * Γ x l r k) + b x i j * a l (fderiv ℝ N x (Pi.single k 1)) := by
  rw [(hstr i j).fderiv_eq,structure_partial e N Γ b x he hN hΓ hb]
  have hs : ∀ i j, fderiv ℝ (e i) x (Pi.single j 1) = structureRHS e N Γ b i j x :=
    fun i j => (hstr i j).eq_of_nhds
  simp only [map_add,map_sum,map_smul,smul_eq_mul,ha,haN]
  have hf (r : Fin m) : a l (fderiv ℝ (e r) x (Pi.single k 1)) = Γ x l r k :=
    dual_first_partial e N Γ b x a ha haN hs l r k
  simp_rw [hf]
  simp [Finset.sum_add_distrib]

theorem ricci_of_structure
    (g : (Fin m → ℝ) → Matrix (Fin m) (Fin m) ℝ)
    (e : Fin m → (Fin m → ℝ) → E) (N : (Fin m → ℝ) → E)
    (b : (Fin m → ℝ) → Fin m → Fin m → ℝ) (x : (Fin m → ℝ)) (a : Fin m → E →L[ℝ] ℝ)
    (he : ∀ l, DifferentiableAt ℝ (e l) x) (hN : DifferentiableAt ℝ N x)
    (hΓ : ∀ l i j, DifferentiableAt ℝ (fun t => christoffel g t l i j) x)
    (hb : ∀ i j, DifferentiableAt ℝ (fun t => b t i j) x)
    (ha : ∀ k l, a k (e l x) = if k=l then 1 else 0)
    (haN : ∀ k, a k (N x) = 0)
    (hstr : ∀ i j, (fun t => fderiv ℝ (e i) t (Pi.single j 1)) =ᶠ[𝓝 x]
      structureRHS e N (christoffel g) b i j)
    (hmixed : ∀ i j k,
      fderiv ℝ (fun t => fderiv ℝ (e i) t (Pi.single j 1)) x (Pi.single k 1) =
      fderiv ℝ (fun t => fderiv ℝ (e i) t (Pi.single k 1)) x (Pi.single j 1))
    (hΓsym : ∀ k i j, christoffel g x k i j = christoffel g x k j i)
    (hshape : ∀ k j, a k (fderiv ℝ N x (Pi.single j 1)) = -∑ l, (g x)⁻¹ k l*b x j l)
    (i j : Fin m) :
    ricci g x i j = b x i j * (∑ k, ∑ l, (g x)⁻¹ k l*b x k l) -
      ∑ k, ∑ l, b x i k*(g x)⁻¹ k l*b x j l := by
  have hcoeff (k : Fin m) :
      fderiv ℝ (fun t => christoffel g t k i j) x (Pi.single k 1) -
        fderiv ℝ (fun t => christoffel g t k i k) x (Pi.single j 1) +
        (∑ l, (christoffel g x k k l*christoffel g x l i j -
          christoffel g x k j l*christoffel g x l i k)) =
      b x i j*(∑ l, (g x)⁻¹ k l*b x k l) -
        b x i k*(∑ l, (g x)⁻¹ k l*b x j l) := by
    have h1 := dual_second_partial e N (christoffel g) b x a he hN hΓ hb ha haN hstr k i j k
    have h2 := dual_second_partial e N (christoffel g) b x a he hN hΓ hb ha haN hstr k i k j
    have hv := (h1.symm.trans (congrArg (a k) (hmixed i j k))).trans h2
    have hp1 : (∑ r, christoffel g x r i j*christoffel g x k r k) =
        ∑ r, christoffel g x k k r*christoffel g x r i j := by
      apply Finset.sum_congr rfl
      intro r _
      rw [hΓsym k r k]
      ring
    have hp2 : (∑ r, christoffel g x r i k*christoffel g x k r j) =
        ∑ r, christoffel g x k j r*christoffel g x r i k := by
      apply Finset.sum_congr rfl
      intro r _
      rw [hΓsym k r j]
      ring
    rw [hp1,hp2,hshape,hshape] at hv
    rw [Finset.sum_sub_distrib]
    linarith
  unfold ricci
  simp_rw [hcoeff]
  rw [Finset.sum_sub_distrib,← Finset.mul_sum]
  congr 1
  apply Finset.sum_congr rfl
  intro k _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l _
  ring

end

section
set_option backward.isDefEq.respectTransparency false
variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] {m : ℕ}

private lemma det_contDiffAt (g : E → Matrix (Fin m) (Fin m) ℝ) (x : E)
    (hg : ∀ i j, ContDiffAt ℝ (⊤ : ℕ∞) (fun t => g t i j) x) :
    ContDiffAt ℝ (⊤ : ℕ∞) (fun t => (g t).det) x := by
  simp_rw [Matrix.det_apply']
  apply ContDiffAt.sum
  intro σ _
  apply contDiffAt_const.mul
  apply contDiffAt_prod
  intro i _
  exact hg (σ i) i

private lemma adjugate_entry_contDiffAt (g : E → Matrix (Fin m) (Fin m) ℝ) (x : E)
    (hg : ∀ i j, ContDiffAt ℝ (⊤ : ℕ∞) (fun t => g t i j) x) (i j : Fin m) :
    ContDiffAt ℝ (⊤ : ℕ∞) (fun t => (g t).adjugate i j) x := by
  simp_rw [Matrix.adjugate_apply]
  apply det_contDiffAt
  intro a b
  by_cases h : a = j
  · subst a
    simp only [Matrix.updateRow_self]
    change ContDiffAt ℝ (⊤ : ℕ∞) (fun _ : E => (Pi.single i (1 : ℝ) : Fin m → ℝ) b) x
    exact contDiffAt_const
  · simpa [Matrix.updateRow_apply,h] using hg a b

lemma inverse_entry_contDiffAt (g : E → Matrix (Fin m) (Fin m) ℝ) (x : E)
    (hg : ∀ i j, ContDiffAt ℝ (⊤ : ℕ∞) (fun t => g t i j) x)
    (hdet : (g x).det ≠ 0) (i j : Fin m) :
    ContDiffAt ℝ (⊤ : ℕ∞) (fun t => (g t)⁻¹ i j) x := by
  simp_rw [Matrix.inv_def,Ring.inverse_eq_inv',Matrix.smul_apply,smul_eq_mul]
  exact ((det_contDiffAt g x hg).inv hdet).mul (adjugate_entry_contDiffAt g x hg i j)

end

end D5.S3.Geometry.AlphaGeometry.EuclideanHypersurfaceGauss

noncomputable section
open scoped BigOperators MatrixOrder ComplexOrder Matrix Topology Matrix.Norms.Elementwise
open Filter
namespace D5.S3.Geometry.AlphaGeometry.HermitianCubeDerivative

def herm_inner {n : ℕ} (A B : Matrix (Fin n) (Fin n) ℂ) : ℝ :=
  RCLike.re (Matrix.trace (A * B))

private lemma cube_derivative_hermitian {n : ℕ} (Y V : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) :
    ((Y.val)^2*V.val + Y.val*V.val*Y.val + V.val*(Y.val)^2).IsHermitian := by
  unfold Matrix.IsHermitian
  simp only [Matrix.conjTranspose_add,Matrix.conjTranspose_mul,Y.property.isHermitian.eq,V.property.isHermitian.eq,
    Matrix.conjTranspose_pow]
  noncomm_ring

noncomputable def cubeDerivative {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) →ₗ[ℝ] (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) :=
  ((selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ)).toLinearMap.comp
    ((LinearMap.mul ℝ (A := (Matrix (Fin n) (Fin n) ℂ))) (Y.val^2) +
      ((LinearMap.mul ℝ (A := (Matrix (Fin n) (Fin n) ℂ))) Y.val).comp
        ((LinearMap.mul ℝ (A := (Matrix (Fin n) (Fin n) ℂ))).flip Y.val) +
      (LinearMap.mul ℝ (A := (Matrix (Fin n) (Fin n) ℂ))).flip (Y.val^2))).comp
    (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)).subtype

private lemma cubeDerivative_val {n : ℕ} (Y V : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) :
    (cubeDerivative Y V).val = Y.val^2*V.val + Y.val*V.val*Y.val + V.val*Y.val^2 := by
  change ((selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ))
    (Y.val^2*V.val + Y.val*(V.val*Y.val) + V.val*Y.val^2)).val = _
  have he : Y.val^2*V.val + Y.val*(V.val*Y.val) + V.val*Y.val^2 =
      Y.val^2*V.val + Y.val*V.val*Y.val + V.val*Y.val^2 := by noncomm_ring
  rw [he]
  exact (cube_derivative_hermitian Y V).isSelfAdjoint.coe_selfAdjointPart_apply ℝ

private lemma cube_coefficient_pos {n : ℕ} {Y : (Matrix (Fin n) (Fin n) ℂ)} (hY : Y.PosDef) (i j : Fin n) :
    0 < (hY.isHermitian.eigenvalues i)^2 +
      hY.isHermitian.eigenvalues i*hY.isHermitian.eigenvalues j +
      (hY.isHermitian.eigenvalues j)^2 := by
  exact add_pos (add_pos (sq_pos_of_pos (hY.eigenvalues_pos i))
    (mul_pos (hY.eigenvalues_pos i) (hY.eigenvalues_pos j)))
    (sq_pos_of_pos (hY.eigenvalues_pos j))

private lemma diagonal_cube_derivative_apply {n : ℕ} (d : Fin n → ℂ) (V : (Matrix (Fin n) (Fin n) ℂ)) (i j : Fin n) :
    ((Matrix.diagonal d)^2*V + Matrix.diagonal d*V*Matrix.diagonal d +
      V*(Matrix.diagonal d)^2) i j = (d i^2+d i*d j+d j^2)*V i j := by
  simp only [pow_two,Matrix.diagonal_mul_diagonal,Matrix.add_apply,
    Matrix.diagonal_mul,Matrix.mul_diagonal,Pi.mul_apply]
  ring

private lemma cube_derivative_kernel {n : ℕ} {Y : (Matrix (Fin n) (Fin n) ℂ)} (hY : Y.PosDef) (V : (Matrix (Fin n) (Fin n) ℂ))
    (hV : Y^2*V + Y*V*Y + V*Y^2 = 0) : V = 0 := by
  let e := Unitary.conjStarAlgAut ℂ ((Matrix (Fin n) (Fin n) ℂ)) hY.isHermitian.eigenvectorUnitary
  let d : Fin n → ℂ := fun i => (hY.isHermitian.eigenvalues i : ℂ)
  have hd : e.symm Y = Matrix.diagonal d := by
    have hy : Y = e (Matrix.diagonal d) := hY.isHermitian.spectral_theorem
    rw [hy,e.symm_apply_apply]
  have hh := congrArg e.symm hV
  simp only [map_add,map_mul,map_pow,map_zero,hd] at hh
  have hzero : e.symm V = 0 := by
    ext i j
    have hij := congrFun (congrFun hh i) j
    rw [diagonal_cube_derivative_apply] at hij
    have hp : d i^2+d i*d j+d j^2 ≠ 0 := by
      dsimp [d]
      exact_mod_cast (ne_of_gt (cube_coefficient_pos hY i j))
    exact (mul_eq_zero.mp hij).resolve_left hp
  exact e.symm.injective (by simpa using hzero)

private lemma cubeDerivative_injective {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) (hY : Y.val.PosDef) :
    Function.Injective (cubeDerivative Y) := by
  apply (LinearMap.ker_eq_bot).mp
  apply LinearMap.ker_eq_bot'.mpr
  intro V hV
  apply Subtype.ext
  exact cube_derivative_kernel hY V.val (by simpa only [cubeDerivative_val, Submodule.coe_zero] using congrArg Subtype.val hV)

theorem positive_hermitian_cube_derivative_equiv {n : ℕ}
    (Y : selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) (hY : Y.val.PosDef) :
    Function.Bijective (cubeDerivative Y) :=
  ⟨cubeDerivative_injective Y hY,
    LinearMap.surjective_of_injective (cubeDerivative_injective Y hY)⟩

noncomputable def cubeDerivativeEquiv {n : ℕ}
    (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) (hY : Y.val.PosDef) : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) ≃L[ℝ] (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) :=
  (LinearEquiv.ofInjectiveEndo (cubeDerivative Y) (positive_hermitian_cube_derivative_equiv Y hY).1).toContinuousLinearEquiv


set_option backward.isDefEq.respectTransparency false

private theorem hermProject_val {n : ℕ} (A : Matrix (Fin n) (Fin n) ℂ)
    (hA : A.IsHermitian) : (selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ) A).val = A :=
  hA.isSelfAdjoint.coe_selfAdjointPart_apply ℝ

noncomputable def cube {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) := (selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ)) (Y.val^3)

lemma cube_val {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) : (cube Y).val = Y.val^3 :=
  hermProject_val _ (Y.property.isHermitian.pow _)

lemma cube_contDiff (n : ℕ) : ContDiff ℝ (⊤ : ℕ∞) (@cube n) := by
  have hv : ContDiff ℝ (⊤ : ℕ∞) (fun Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) => Y.val) := ((selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))).subtypeL.contDiff
  have hm : ContDiff ℝ (⊤ : ℕ∞) (fun p : (Matrix (Fin n) (Fin n) ℂ) × (Matrix (Fin n) (Fin n) ℂ) => (LinearMap.mul ℝ (A := Matrix (Fin n) (Fin n) ℂ)).toContinuousBilinearMap p.1 p.2) :=
    ((LinearMap.mul ℝ (A := Matrix (Fin n) (Fin n) ℂ)).toContinuousBilinearMap).isBoundedBilinearMap.contDiff
  have hsq : ContDiff ℝ (⊤ : ℕ∞) (fun Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) => (LinearMap.mul ℝ (A := Matrix (Fin n) (Fin n) ℂ)).toContinuousBilinearMap Y.val Y.val) := hm.comp (hv.prodMk hv)
  have hcu := hm.comp (hsq.prodMk hv)
  convert ((selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ))).contDiff.comp hcu using 1 <;> try rfl
  funext Y
  simp (config := { congrConsts := false }) only [cube,pow_succ,pow_zero,one_mul,Function.comp_apply]
  rfl

lemma cube_hasFDerivAt {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) :
    HasFDerivAt cube (cubeDerivative Y).toContinuousLinearMap Y := by
  let v : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) →L[ℝ] (Matrix (Fin n) (Fin n) ℂ) := ((selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))).subtypeL
  have hv := v.hasFDerivAt (x := Y)
  have hsq := ContinuousLinearMap.hasFDerivAt_of_bilinear ((LinearMap.mul ℝ (A := Matrix (Fin n) (Fin n) ℂ)).toContinuousBilinearMap) hv hv
  have hcu := ContinuousLinearMap.hasFDerivAt_of_bilinear ((LinearMap.mul ℝ (A := Matrix (Fin n) (Fin n) ℂ)).toContinuousBilinearMap) hsq hv
  have hp := ((selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ))).hasFDerivAt.comp Y hcu
  convert hp using 1 <;> try rfl
  · funext X
    simp (config := { congrConsts := false }) only [cube,pow_succ,pow_zero,one_mul,Function.comp_apply]
    rfl
  · ext1 V
    apply Subtype.ext
    change (cubeDerivative Y V).val =
      ((selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ)) (Y.val*Y.val*V.val + (Y.val*V.val+V.val*Y.val)*Y.val)).val
    rw [cubeDerivative_val]
    change Y.val^2*V.val + Y.val*V.val*Y.val + V.val*Y.val^2 =
      ((selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ)) _).val
    change Y.val^2*V.val + Y.val*V.val*Y.val + V.val*Y.val^2 =
      ((selfAdjointPartL ℝ (Matrix (Fin n) (Fin n) ℂ)) (Y.val*Y.val*V.val + (Y.val*V.val+V.val*Y.val)*Y.val)).val
    have he : Y.val*Y.val*V.val + (Y.val*V.val+V.val*Y.val)*Y.val =
        Y.val^2*V.val + Y.val*V.val*Y.val + V.val*Y.val^2 := by noncomm_ring
    rw [he,hermProject_val _ (cube_derivative_hermitian Y V)]

private theorem trace_cubic_variation {n : ℕ} (Y V : (Matrix (Fin n) (Fin n) ℂ)) :
    Matrix.trace (V*Y*Y+Y*V*Y+Y*Y*V) = 3*Matrix.trace (Y*Y*V) := by
  rw [Matrix.trace_add, Matrix.trace_add,
    Matrix.trace_mul_cycle V Y Y, Matrix.trace_mul_cycle Y V Y]
  ring

noncomputable def F {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) : ℝ := (Y.val^3).trace.re

noncomputable def DF {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ)) →L[ℝ] ℝ :=
  (3 : ℝ) • (((Complex.reCLM.comp (Matrix.traceLinearMap (Fin n) ℝ ℂ : (Matrix (Fin n) (Fin n) ℂ) →ₗ[ℝ] ℂ).toContinuousLinearMap)).comp (((LinearMap.mul ℝ (A := Matrix (Fin n) (Fin n) ℂ)).toContinuousBilinearMap (Y.val^2)).comp ((selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))).subtypeL))

private lemma DF_apply {n : ℕ} (Y V : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) : DF Y V = 3*herm_inner (Y.val^2) V.val := rfl

lemma F_hasFDerivAt {n : ℕ} (Y : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) : HasFDerivAt F (DF Y) Y := by
  have hp := (((Complex.reCLM.comp (Matrix.traceLinearMap (Fin n) ℝ ℂ : (Matrix (Fin n) (Fin n) ℂ) →ₗ[ℝ] ℂ).toContinuousLinearMap)).comp ((selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))).subtypeL).hasFDerivAt.comp Y
    (cube_hasFDerivAt Y)
  convert hp using 1 <;> try rfl
  · funext X
    change (X.val^3).trace.re = (cube X).val.trace.re
    rw [cube_val]
  · ext1 V
    change 3*(Y.val^2*V.val).trace.re = (cubeDerivative Y V).val.trace.re
    rw [cubeDerivative_val]
    change 3*(Y.val^2*V.val).trace.re =
      (Y.val^2*V.val+Y.val*V.val*Y.val+V.val*Y.val^2).trace.re
    have he : Y.val^2*V.val+Y.val*V.val*Y.val+V.val*Y.val^2 =
        V.val*Y.val*Y.val+Y.val*V.val*Y.val+Y.val*Y.val*V.val := by noncomm_ring
    rw [he,D5.S3.Geometry.AlphaGeometry.HermitianCubeDerivative.trace_cubic_variation]
    simp [pow_two,Complex.mul_re]

lemma F_fderiv {n : ℕ} (Y V : (selfAdjoint.submodule ℝ (Matrix (Fin n) (Fin n) ℂ))) :
    fderiv ℝ F Y V = 3*herm_inner (Y.val^2) V.val := by
  rw [(F_hasFDerivAt Y).fderiv,DF_apply]

end D5.S3.Geometry.AlphaGeometry.HermitianCubeDerivative
