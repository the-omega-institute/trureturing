import Mathlib.Analysis.InnerProductSpace.Projection.Submodule

open scoped RealInnerProductSpace

namespace D5.S3.QuantumStates.DynamicsResidualQuotient

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- The linear observable closure generated by all forward iterates of a visible subspace. -/
def observableClosure (K : V →ₗ[ℝ] V) (W : Submodule ℝ V) : Submodule ℝ V :=
  Submodule.span ℝ {x | ∃ n w, w ∈ W ∧ (K : V → V)^[n] w = x}

private theorem observableClosure_invariant (K : V →ₗ[ℝ] V) (W : Submodule ℝ V) :
    ∀ x ∈ observableClosure K W, K x ∈ observableClosure K W := by
  intro x hx
  let S : Set V := {x | ∃ n w, w ∈ W ∧ (K : V → V)^[n] w = x}
  change x ∈ Submodule.span ℝ S at hx
  change K x ∈ Submodule.span ℝ S
  have hmap : Submodule.map K (Submodule.span ℝ S) ≤ Submodule.span ℝ S := by
    rw [Submodule.map_span_le]
    intro y hy
    change ∃ n w, w ∈ W ∧ (K : V → V)^[n] w = y at hy
    rcases hy with ⟨n, w, hw, rfl⟩
    apply Submodule.subset_span
    refine ⟨n + 1, w, hw, ?_⟩
    rw [Function.iterate_succ_apply']
  exact hmap ⟨x, hx, rfl⟩

/- Library-search audit trail (2026-08-20):
   * Repository search found no theorem packaging an adjoint observable closure
     with an invariant orthogonal residual and quotient descent.
   * Pinned-Mathlib searches hit and use `Submodule.mem_orthogonal'`,
     `Submodule.liftQ`, `Submodule.liftQ_apply`, and
     `Submodule.Quotient.mk_eq_zero`; no exact final theorem was found.
   * The closure is constructed from the source's iterated adjoint observable
     span, and the quotient map is the canonical map induced by the proved
     residual invariance. -/

/-- The final orthogonal residual is invariant under the Schrödinger map when
the observable closure is generated by its adjoint. -/
theorem dynamics_residual_invariant_and_quotient
    {K Phi : V →ₗ[ℝ] V} [FiniteDimensional ℝ V] (W : Submodule ℝ V)
    (hadjoint : ∀ x a, inner ℝ (Phi x) a = inner ℝ x (K a)) :
    let visible := observableClosure K W
    let residual := visibleᗮ
    (∀ x ∈ residual, Phi x ∈ residual) ∧
      ∃ induced : (V ⧸ residual) →ₗ[ℝ] (V ⧸ residual),
        ∀ x, induced (residual.mkQ x) = residual.mkQ (Phi x) := by
  let visible := observableClosure K W
  let residual := visibleᗮ
  have hvisible : ∀ a ∈ visible, K a ∈ visible := by
    exact observableClosure_invariant K W
  have hinvariant : ∀ x ∈ residual, Phi x ∈ residual := by
    intro x hx
    rw [Submodule.mem_orthogonal']
    intro a ha
    rw [hadjoint]
    exact (Submodule.mem_orthogonal' visible x).mp hx (K a) (hvisible a ha)
  have hker : residual ≤ (residual.mkQ.comp Phi).ker := by
    intro x hx
    apply (Submodule.Quotient.mk_eq_zero residual).mpr
    exact hinvariant x hx
  let induced := residual.liftQ (residual.mkQ.comp Phi) hker
  refine ⟨hinvariant, induced, ?_⟩
  intro x
  change induced (Submodule.Quotient.mk x) = Submodule.Quotient.mk (Phi x)
  rw [Submodule.liftQ_apply]
  rfl

example :
    ∀ x ∈ (observableClosure (LinearMap.id : ℝ →ₗ[ℝ] ℝ) (⊥ : Submodule ℝ ℝ))ᗮ,
      (LinearMap.id : ℝ →ₗ[ℝ] ℝ) x ∈ (observableClosure (LinearMap.id : ℝ →ₗ[ℝ] ℝ)
        (⊥ : Submodule ℝ ℝ))ᗮ := by
  intro x hx
  exact (dynamics_residual_invariant_and_quotient
    (K := LinearMap.id) (Phi := LinearMap.id) (⊥ : Submodule ℝ ℝ)
    (by intro a x; rfl)).1 x hx

#print axioms dynamics_residual_invariant_and_quotient

end D5.S3.QuantumStates.DynamicsResidualQuotient
