/- GID: D5/S3/QuantumStates/DynamicsResidualQuotientUnique
   generality: G
   mirror-B: D5/B/S3/QuantumStates/DynamicsResidualQuotientUnique
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: An iterated observable residual is invariant and has unique quotient descent. -/

import Mathlib.Analysis.InnerProductSpace.Projection.Submodule

open scoped RealInnerProductSpace

namespace D5.S3.QuantumStates.DynamicsResidualQuotientUnique

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- The observable subspace generated by every forward iterate of a visible seed. -/
def observableClosureUnique (K : V →ₗ[ℝ] V) (W : Submodule ℝ V) : Submodule ℝ V :=
  Submodule.span ℝ {x | ∃ n w, w ∈ W ∧ (K : V → V)^[n] w = x}

private theorem observableClosureUnique_invariant (K : V →ₗ[ℝ] V) (W : Submodule ℝ V) :
    ∀ x ∈ observableClosureUnique K W, K x ∈ observableClosureUnique K W := by
  intro x hx
  let S : Set V := {x | ∃ n w, w ∈ W ∧ (K : V → V)^[n] w = x}
  change x ∈ Submodule.span ℝ S at hx
  change K x ∈ Submodule.span ℝ S
  have hmap : Submodule.map K (Submodule.span ℝ S) ≤ Submodule.span ℝ S := by
    rw [Submodule.map_span_le]
    intro y hy
    change ∃ n w, w ∈ W ∧ (K : V → V)^[n] w = y at hy
    rcases hy with ⟨n, w, hw, rfl⟩
    apply Submodule.subset_span
    refine ⟨n + 1, w, hw, ?_⟩
    rw [Function.iterate_succ_apply']
  exact hmap ⟨x, hx, rfl⟩

/-- Adjoint-compatible evolution descends uniquely through the final residual quotient. -/
theorem dynamics_residual_invariant_and_unique_quotient
    {K Phi : V →ₗ[ℝ] V} [FiniteDimensional ℝ V] (W : Submodule ℝ V)
    (hadjoint : ∀ x a, inner ℝ (Phi x) a = inner ℝ x (K a)) :
    let visible := observableClosureUnique K W
    let residual := visibleᗮ
    (∀ x ∈ residual, Phi x ∈ residual) ∧
      ∃! induced : (V ⧸ residual) →ₗ[ℝ] (V ⧸ residual),
        ∀ x, induced (residual.mkQ x) = residual.mkQ (Phi x) := by
  let visible := observableClosureUnique K W
  let residual := visibleᗮ
  have hvisible : ∀ a ∈ visible, K a ∈ visible := by
    exact observableClosureUnique_invariant K W
  have hinvariant : ∀ x ∈ residual, Phi x ∈ residual := by
    intro x hx
    rw [Submodule.mem_orthogonal']
    intro a ha
    rw [hadjoint]
    exact (Submodule.mem_orthogonal' visible x).mp hx (K a) (hvisible a ha)
  have hker : residual ≤ (residual.mkQ.comp Phi).ker := by
    intro x hx
    apply (Submodule.Quotient.mk_eq_zero residual).mpr
    exact hinvariant x hx
  let induced := residual.liftQ (residual.mkQ.comp Phi) hker
  have hinduced : ∀ x, induced (residual.mkQ x) = residual.mkQ (Phi x) := by
    intro x
    change induced (Submodule.Quotient.mk x) = Submodule.Quotient.mk (Phi x)
    rw [Submodule.liftQ_apply]
    rfl
  refine ⟨hinvariant, induced, hinduced, ?_⟩
  intro other hother
  apply LinearMap.ext
  intro q
  obtain ⟨x, rfl⟩ := Submodule.mkQ_surjective residual q
  exact (hother x).trans (hinduced x).symm

#print axioms dynamics_residual_invariant_and_unique_quotient

end D5.S3.QuantumStates.DynamicsResidualQuotientUnique
