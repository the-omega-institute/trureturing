set_option exponentiation.threshold 1024 in
/-- Ordinary rational comparisons against the exact Machin sums. -/
theorem pi_rounding_comparisons : piLower250 ≤ piLowerQ ∧ piUpperQ ≤ piUpper250 := by
  norm_num [piLower250, piUpper250, piLowerQ, piUpperQ,
    atan5UpperQ, atan239UpperQ, atan5_prefix_value, atan239_prefix_value]

theorem pi_250_bounds : (piLower250 : ℝ) ≤ Real.pi ∧ Real.pi ≤ (piUpper250 : ℝ) := by
  have hl : (piLower250 : ℝ) ≤ (piLowerQ : ℝ) := by
    exact_mod_cast pi_rounding_comparisons.1
  have hu : (piUpperQ : ℝ) ≤ (piUpper250 : ℝ) := by
    exact_mod_cast pi_rounding_comparisons.2
  exact ⟨hl.trans pi_machin_bounds.1, pi_machin_bounds.2.trans hu⟩

