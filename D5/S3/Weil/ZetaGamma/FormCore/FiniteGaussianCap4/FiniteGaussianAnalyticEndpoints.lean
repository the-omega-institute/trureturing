/-- Only rational squares are checked; no numerical square-root oracle is used. -/
theorem sqrt_pi_square_comparisons :
    0 ≤ sqrtPiLower250 ∧ 0 ≤ sqrtPiUpper250 ∧
      sqrtPiLower250 ^ 2 ≤ piLower250 ∧ piUpper250 ≤ sqrtPiUpper250 ^ 2 := by
  norm_num [sqrtPiLower250, sqrtPiUpper250, piLower250, piUpper250]

theorem sqrt_pi_250_bounds :
    (sqrtPiLower250 : ℝ) ≤ Real.sqrt Real.pi ∧
      Real.sqrt Real.pi ≤ (sqrtPiUpper250 : ℝ) := by
  have hl : (sqrtPiLower250 : ℝ) ^ 2 ≤ (piLower250 : ℝ) := by
    exact_mod_cast sqrt_pi_square_comparisons.2.2.1
  have hu : (piUpper250 : ℝ) ≤ (sqrtPiUpper250 : ℝ) ^ 2 := by
    exact_mod_cast sqrt_pi_square_comparisons.2.2.2
  have hpos : (0 : ℝ) ≤ (sqrtPiUpper250 : ℝ) := by
    exact_mod_cast sqrt_pi_square_comparisons.2.1
  exact ⟨Real.le_sqrt_of_sq_le (hl.trans pi_250_bounds.1),
    Real.sqrt_le_iff.mpr ⟨hpos, pi_250_bounds.2.trans hu⟩⟩

theorem sqrt_six_square_comparisons :
    0 ≤ sqrt6Lower250 ∧ 0 ≤ sqrt6Upper250 ∧
      sqrt6Lower250 ^ 2 ≤ 6 ∧ 6 ≤ sqrt6Upper250 ^ 2 := by
  norm_num [sqrt6Lower250, sqrt6Upper250]

theorem sqrt_six_250_bounds :
    (sqrt6Lower250 : ℝ) ≤ Real.sqrt 6 ∧ Real.sqrt 6 ≤ (sqrt6Upper250 : ℝ) := by
  have hl : (sqrt6Lower250 : ℝ) ^ 2 ≤ 6 := by
    exact_mod_cast sqrt_six_square_comparisons.2.2.1
  have hu : (6 : ℝ) ≤ (sqrt6Upper250 : ℝ) ^ 2 := by
    exact_mod_cast sqrt_six_square_comparisons.2.2.2
  have hpos : (0 : ℝ) ≤ (sqrt6Upper250 : ℝ) := by
    exact_mod_cast sqrt_six_square_comparisons.2.1
  exact ⟨Real.le_sqrt_of_sq_le hl, Real.sqrt_le_iff.mpr ⟨hpos, hu⟩⟩

/-- Actual five analytic inputs consumed together. Exp endpoints remain exact
finite rational expressions; no claim is made that their decimal evaluation,
the 256-entry certificate, or any physical M bound has been accepted. -/
theorem finiteGaussian_analytic_endpoints :
    ((piLower250 : ℝ) ≤ Real.pi ∧ Real.pi ≤ (piUpper250 : ℝ)) ∧
    ((expNeg12LowerQ : ℝ) ≤ Real.exp (-12) ∧
      Real.exp (-12) ≤ (expNeg12UpperQ : ℝ)) ∧
    ((expNegTwoPiLowerQ : ℝ) ≤ Real.exp (-(2 * Real.pi)) ∧
      Real.exp (-(2 * Real.pi)) ≤ (expNegTwoPiUpperQ : ℝ)) ∧
    ((sqrtPiLower250 : ℝ) ≤ Real.sqrt Real.pi ∧
      Real.sqrt Real.pi ≤ (sqrtPiUpper250 : ℝ)) ∧
    ((sqrt6Lower250 : ℝ) ≤ Real.sqrt 6 ∧ Real.sqrt 6 ≤ (sqrt6Upper250 : ℝ)) := by
  exact ⟨pi_250_bounds, exp_neg_twelve_bounds, exp_neg_two_pi_bounds,
    sqrt_pi_250_bounds, sqrt_six_250_bounds⟩

