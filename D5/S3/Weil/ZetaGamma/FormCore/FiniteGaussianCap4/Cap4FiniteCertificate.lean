    rootCQ 0 j = ∑ k : I, lowerQ 0 k * pivotsQ k * lowerQ j k := by
  fin_cases j <;> norm_num at h <;>
    norm_num [rootCQ, lowerQ, lowerEntriesQ, pivotsQ, Fin.sum_univ_succ]

