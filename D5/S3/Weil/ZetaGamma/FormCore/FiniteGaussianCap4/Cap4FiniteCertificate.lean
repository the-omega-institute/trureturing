theorem finite16CQ_eq_rootCQ : finite16CQ = rootCQ := by
  ext i j
  fin_cases i
  · exact reconstruction_row_0 j
  · exact reconstruction_row_1 j
  · exact reconstruction_row_2 j
  · exact reconstruction_row_3 j
  · exact reconstruction_row_4 j
  · exact reconstruction_row_5 j
  · exact reconstruction_row_6 j
  · exact reconstruction_row_7 j
  · exact reconstruction_row_8 j
  · exact reconstruction_row_9 j
  · exact reconstruction_row_10 j
  · exact reconstruction_row_11 j
  · exact reconstruction_row_12 j
  · exact reconstruction_row_13 j
  · exact reconstruction_row_14 j
  · exact reconstruction_row_15 j

private theorem rootCQ_symm (i j : I) : rootCQ i j = rootCQ j i := by
  fin_cases i <;> fin_cases j <;> rfl

private theorem weighted_sum_swap (i j : I) :
    (∑ k : I, lowerQ i k * pivotsQ k * lowerQ j k) =
      ∑ k : I, lowerQ j k * pivotsQ k * lowerQ i k := by
  apply Finset.sum_congr rfl
  intro k _
  simp only [mul_assoc, mul_comm, mul_left_comm]

