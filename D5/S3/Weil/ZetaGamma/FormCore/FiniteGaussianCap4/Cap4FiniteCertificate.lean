theorem rational_factor_identity :
    finite16CQ = lowerQ * Matrix.diagonal pivotsQ * lowerQᵀ := by
  rw [finite16CQ_eq_rootCQ]
  ext i j
  rw [Matrix.mul_apply]
  simp only [Matrix.mul_diagonal, Matrix.transpose_apply]
  by_cases h : j ≤ i
  · exact rootCQ_factor_lower i j h
  · rw [rootCQ_symm i j, weighted_sum_swap i j]
    exact rootCQ_factor_lower j i (le_of_lt (lt_of_not_ge h))

theorem pivotsQ_pos (i : I) : 0 < pivotsQ i := by
  fin_cases i <;> norm_num [pivotsQ]

-- The real matrix is obtained by the exact rational ring homomorphism.
def weights (i : I) : ℝ := (weightsQ i : ℝ)
def center : Matrix I I ℝ := centerQ.map (Rat.castHom ℝ)
def recurrence : Matrix I I ℝ := recurrenceQ.map (Rat.castHom ℝ)
def finite16C : Matrix I I ℝ := finite16CQ.map (Rat.castHom ℝ)
def lower : Matrix I I ℝ := lowerQ.map (Rat.castHom ℝ)
def pivots (i : I) : ℝ := (pivotsQ i : ℝ)

-- Public reconstruction interface: exact coefficient, exact center, all 16 indices.
theorem finite16C_entry (i j : I) :
    finite16C i j =
      (157438844598004744192 / 1028725771676171625 : ℝ) * weights i * weights j -
      center i j + (1 / 10 : ℝ) * recurrence i j -
      (if i = j then (23 / 20 : ℝ) * weights i else 0) -
      (if i = j then (1 / 1000000 : ℝ) else 0) := by
  by_cases h : i = j <;>
    simp [finite16C, finite16CQ, weights, center, recurrence, rhoQ, h]

theorem real_factor_identity :
    finite16C = lower * Matrix.diagonal pivots * lowerᵀ := by
  unfold finite16C
  rw [rational_factor_identity, Matrix.map_mul, Matrix.map_mul,
    Matrix.diagonal_map (map_zero (Rat.castHom ℝ)), Matrix.transpose_map]
  rfl

theorem pivots_pos (i : I) : 0 < pivots i :=
  Rat.cast_pos.mpr (pivotsQ_pos i)

theorem lower_diagonal (i : I) : lower i i = 1 := by
  simp [lower, lowerQ]

theorem lower_isLowerTriangular : lower.IsLowerTriangular := by
  intro i j hij
  have h : i < j := hij
  simp [lower, lowerQ, ne_of_lt h, not_lt_of_ge (le_of_lt h)]

theorem lower_det : lower.det = 1 := by
  rw [Matrix.det_of_isLowerTriangular lower lower_isLowerTriangular]
  simp [lower_diagonal]

theorem lower_transpose_isUnit : IsUnit lowerᵀ := by
  apply (Matrix.isUnit_iff_isUnit_det lowerᵀ).mpr
  rw [Matrix.det_transpose, lower_det]
  exact isUnit_one

theorem lower_transpose_mulVec_injective : Function.Injective lowerᵀ.mulVec :=
  Matrix.mulVec_injective_iff_isUnit.mpr lower_transpose_isUnit

theorem diagonal_pivots_posDef : (Matrix.diagonal pivots).PosDef :=
  Matrix.PosDef.diagonal pivots_pos

-- Consumer: the requested finite real certificate, without hypotheses.
theorem finite16C_posDef : finite16C.PosDef := by
  rw [real_factor_identity]
  simpa only [Matrix.conjTranspose_eq_transpose_of_trivial, Matrix.transpose_transpose] using
    diagonal_pivots_posDef.conjTranspose_mul_mul_same
      (B := lowerᵀ) lower_transpose_mulVec_injective

end Cap4FiniteCertificate
