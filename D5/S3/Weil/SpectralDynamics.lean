open scoped ComplexConjugate

/-- The unit-modulus coordinate multiplier generated by the logarithmic length. -/
noncomputable def verticalPhase (t : ℝ) (a : PrimeAxisTable) : ℂ :=
  labeledZetaCoefficient (Complex.I * (t : ℂ)) a

private theorem labeledZetaCoefficient_add (s w : ℂ) (a : PrimeAxisTable) :
    labeledZetaCoefficient (s + w) a =
      labeledZetaCoefficient s a * labeledZetaCoefficient w a := by
  have hn : ((((primeAxisEncoding a : ℕ+) : ℕ) : ℂ)) ≠ 0 := by
    exact_mod_cast (ne_of_gt (PNat.pos (primeAxisEncoding a)))
  simp only [labeledZetaCoefficient]
  rw [Complex.cpow_add s w hn]
  simp only [one_div, mul_inv_rev]
  ring

@[simp]
theorem verticalPhase_norm (t : ℝ) (a : PrimeAxisTable) :
    ‖verticalPhase t a‖ = 1 := by
  rw [verticalPhase, labeledZetaCoefficient, norm_div, norm_one,
    Complex.norm_natCast_cpow_of_pos (PNat.pos (primeAxisEncoding a))]
  simp

@[simp]
theorem verticalPhase_zero (a : PrimeAxisTable) : verticalPhase 0 a = 1 := by
  simp [verticalPhase, labeledZetaCoefficient]

theorem verticalPhase_add (t u : ℝ) (a : PrimeAxisTable) :
    verticalPhase (t + u) a = verticalPhase t a * verticalPhase u a := by
  unfold verticalPhase
  rw [show Complex.I * ((t + u : ℝ) : ℂ) =
    Complex.I * (t : ℂ) + Complex.I * (u : ℂ) by push_cast; ring]
  exact labeledZetaCoefficient_add _ _ _

theorem verticalPhase_neg_mul (t : ℝ) (a : PrimeAxisTable) :
    verticalPhase (-t) a * verticalPhase t a = 1 := by
  simpa using (verticalPhase_add (-t) t a).symm

/-- Vertical spectral evolution acts diagonally on the zeta coefficient space. -/
noncomputable def verticalEvolution (t : ℝ) :
    ZetaHilbertSpace →ₗ[ℂ] ZetaHilbertSpace where
  toFun x :=
    ⟨fun a ↦ verticalPhase t a * x a, by
      change Memℓp (fun a ↦ verticalPhase t a * x a) 2
      rw [memℓp_gen_iff (by norm_num)]
      simpa only [norm_mul, verticalPhase_norm, one_mul] using
        (lp.memℓp x).summable (by norm_num)⟩
  map_add' x y := by
    apply lp.ext
    funext a
    change verticalPhase t a * (x a + y a) =
      verticalPhase t a * x a + verticalPhase t a * y a
    ring
  map_smul' c x := by
    apply lp.ext
    funext a
    simp [mul_left_comm]

@[simp]
theorem verticalEvolution_apply (t : ℝ) (x : ZetaHilbertSpace)
    (a : PrimeAxisTable) :
    verticalEvolution t x a = verticalPhase t a * x a :=
  rfl

/-- The vertical multipliers form a norm-preserving group on the Hilbert space. -/
theorem vertical_evolution_unitary_group (t u : ℝ) (x : ZetaHilbertSpace) :
    verticalEvolution 0 x = x ∧
      verticalEvolution (t + u) x =
        verticalEvolution t (verticalEvolution u x) ∧
      verticalEvolution (-t) (verticalEvolution t x) = x ∧
      ‖verticalEvolution t x‖ = ‖x‖ := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · apply lp.ext
    funext a
    simp
  · apply lp.ext
    funext a
    simp [verticalPhase_add, mul_assoc]
  · apply lp.ext
    funext a
    rw [verticalEvolution_apply, verticalEvolution_apply, ← mul_assoc,
      verticalPhase_neg_mul, one_mul]
  · have hsq : ‖verticalEvolution t x‖ ^ 2 = ‖x‖ ^ 2 := by
      calc
        ‖verticalEvolution t x‖ ^ 2 =
            ‖verticalEvolution t x‖ ^ (2 : ℝ) :=
          (Real.rpow_two _).symm
        _ = ∑' a : PrimeAxisTable,
            ‖verticalEvolution t x a‖ ^ (2 : ℝ) :=
          lp.norm_rpow_eq_tsum (by norm_num) _
        _ = ∑' a : PrimeAxisTable, ‖x a‖ ^ (2 : ℝ) := by
          congr 1
          funext a
          rw [verticalEvolution_apply, norm_mul, verticalPhase_norm, one_mul]
        _ = ‖x‖ ^ (2 : ℝ) :=
          (lp.norm_rpow_eq_tsum (by norm_num) _).symm
        _ = ‖x‖ ^ 2 := Real.rpow_two _
    nlinarith [norm_nonneg (verticalEvolution t x), norm_nonneg x]

/-- The nonnegative horizontal multiplier generated by the logarithmic length. -/
noncomputable def horizontalWeight (δ : ℝ) (a : PrimeAxisTable) : ℂ :=
  labeledZetaCoefficient (δ : ℂ) a

theorem horizontalWeight_norm_le_one (δ : ℝ) (hδ : 0 ≤ δ)
    (a : PrimeAxisTable) : ‖horizontalWeight δ a‖ ≤ 1 := by
  rw [horizontalWeight, labeledZetaCoefficient, norm_div, norm_one,
    Complex.norm_natCast_cpow_of_pos (PNat.pos (primeAxisEncoding a))]
  have hn : (1 : ℝ) ≤ ((primeAxisEncoding a : ℕ+) : ℕ) := by
    exact_mod_cast PNat.pos (primeAxisEncoding a)
  simpa using
    inv_le_one_of_one_le₀ (Real.one_le_rpow hn hδ)

@[simp]
theorem horizontalWeight_zero (a : PrimeAxisTable) : horizontalWeight 0 a = 1 := by
  simp [horizontalWeight, labeledZetaCoefficient]

theorem horizontalWeight_add (δ ε : ℝ) (a : PrimeAxisTable) :
    horizontalWeight (δ + ε) a = horizontalWeight δ a * horizontalWeight ε a := by
  simpa [horizontalWeight] using
    labeledZetaCoefficient_add (δ : ℂ) (ε : ℂ) a

/-- Forward horizontal spectral evolution is a bounded diagonal contraction. -/
noncomputable def horizontalEvolution (δ : ℝ) (hδ : 0 ≤ δ) :
    ZetaHilbertSpace →ₗ[ℂ] ZetaHilbertSpace where
  toFun x :=
    ⟨fun a ↦ horizontalWeight δ a * x a, by
      change Memℓp (fun a ↦ horizontalWeight δ a * x a) 2
      exact (lp.memℓp x).mono' fun a ↦ by
        rw [norm_mul]
        simpa using mul_le_mul_of_nonneg_right
          (horizontalWeight_norm_le_one δ hδ a) (norm_nonneg (x a))⟩
  map_add' x y := by
    apply lp.ext
    funext a
    change horizontalWeight δ a * (x a + y a) =
      horizontalWeight δ a * x a + horizontalWeight δ a * y a
    ring
  map_smul' c x := by
    apply lp.ext
    funext a
    simp [mul_left_comm]

@[simp]
theorem horizontalEvolution_apply (δ : ℝ) (hδ : 0 ≤ δ)
    (x : ZetaHilbertSpace) (a : PrimeAxisTable) :
    horizontalEvolution δ hδ x a = horizontalWeight δ a * x a :=
  rfl

/-- The bounded horizontal maps form a contraction semigroup. -/
theorem horizontal_evolution_contraction_semigroup
    (δ ε : ℝ) (hδ : 0 ≤ δ) (hε : 0 ≤ ε) (x : ZetaHilbertSpace) :
    horizontalEvolution 0 (by norm_num : (0 : ℝ) ≤ 0) x = x ∧
      horizontalEvolution (δ + ε) (add_nonneg hδ hε) x =
        horizontalEvolution δ hδ (horizontalEvolution ε hε x) ∧
      ‖horizontalEvolution δ hδ x‖ ≤ ‖x‖ := by
  refine ⟨?_, ?_, ?_⟩
  · apply lp.ext
    funext a
    simp
  · apply lp.ext
    funext a
    simp [horizontalWeight_add, mul_assoc]
  · apply lp.norm_mono (by norm_num)
    intro a
    rw [horizontalEvolution_apply, norm_mul]
    simpa using mul_le_mul_of_nonneg_right
      (horizontalWeight_norm_le_one δ hδ a) (norm_nonneg (x a))

/-- The labeled zeta vector follows the vertical group and forward horizontal semigroup. -/
theorem labeled_zeta_evolution_spec
    (σ σ' t : ℝ) (hσ : criticalAbscissa < σ) (hσσ' : σ ≤ σ') :
    verticalEvolution t
        (labeledZetaVector (σ : ℂ) (by simpa using hσ)) =
      labeledZetaVector ((σ : ℂ) + Complex.I * (t : ℂ)) (by simpa using hσ) ∧
    horizontalEvolution (σ' - σ) (sub_nonneg.mpr hσσ')
        (labeledZetaVector ((σ : ℂ) + Complex.I * (t : ℂ)) (by simpa using hσ)) =
      labeledZetaVector ((σ' : ℂ) + Complex.I * (t : ℂ))
        (by simpa using hσ.trans_le hσσ') := by
  refine ⟨?_, ?_⟩
  · apply lp.ext
    funext a
    rw [verticalEvolution_apply]
    simp only [labeledZetaVector_apply]
    rw [verticalPhase, labeledZetaCoefficient_add]
    ring
  · apply lp.ext
    funext a
    rw [horizontalEvolution_apply]
    simp only [labeledZetaVector_apply]
    rw [horizontalWeight]
    rw [show (σ' : ℂ) + Complex.I * (t : ℂ) =
      ((σ' - σ : ℝ) : ℂ) + ((σ : ℂ) + Complex.I * (t : ℂ)) by
        push_cast
        ring]
    rw [labeledZetaCoefficient_add, labeledZetaCoefficient_add,
      labeledZetaCoefficient_add]

/-- Two spectral parameters are paired by the zeta kernel's pole direction. -/
def KernelResonant (s w : ℂ) : Prop :=
  s + conj w = 1

/-- The concrete zero symmetries form the two unique cross-pair resonances. -/
theorem zero_quartet_resonance_spec (Z : ZeroData) (n : ℕ) :
    Z.zero (Z.conjugation (Z.reflection n)) = 1 - conj (Z.zero n) ∧
      KernelResonant (Z.zero n) (Z.zero (Z.conjugation (Z.reflection n))) ∧
      KernelResonant (Z.zero (Z.conjugation n)) (Z.zero (Z.reflection n)) ∧
      ∀ w, KernelResonant (Z.zero n) w ↔
        w = Z.zero (Z.conjugation (Z.reflection n)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [Z.zero_conjugation, Z.zero_reflection]
    simp
  · simp [KernelResonant, Z.zero_conjugation, Z.zero_reflection]
  · simp [KernelResonant, Z.zero_conjugation, Z.zero_reflection]
  · intro w
    simpa [KernelResonant, Z.zero_conjugation, Z.zero_reflection] using
      (resonance_partner_spec (Z.zero n) w).1

/-- Reflection, half-density unitarity, resonance, and the `l2` threshold use one line. -/
theorem critical_line_characterizations {A : Type*} [AddMonoid A]
    (length : LedgerLength A) (hNontrivial : ∃ a, length a ≠ 0) (s : ℂ) :
    (s = mirror s ↔ s.re = criticalAbscissa) ∧
      ((∀ a, ‖halfDensityReading length s a‖ = 1) ↔
        s.re = criticalAbscissa) ∧
      (s + conj s = 1 ↔ s.re = criticalAbscissa) ∧
      (Memℓp (labeledZetaCoefficient s) 2 ↔ criticalAbscissa < s.re) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact (mirror_reversal_spec length s).2
  · exact (unitarity_line_iff length hNontrivial s).2
  · exact (resonance_partner_spec s s).2.1
  · exact labeled_zeta_mem_iff s

