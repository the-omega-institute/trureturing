/-- The lifted golden logarithmic coordinate of a natural Euler address. -/
def eulerGoldenCoordinate (address : ℕ) : ℂ :=
  (goldenScaleCoordinate (address : ℝ) : ℂ)

/-- The Prony node generated by an Euler address under one complex Mellin
step. -/
def eulerMellinPronyNode (address : ℕ) (step : ℂ) : ℂ :=
  goldenExponentialPronyCoordinate (step * eulerGoldenCoordinate address)

/-- The corresponding von Mangoldt weight at a base Mellin parameter. -/
def eulerMellinPronyWeight (address : ℕ) (base : ℂ) : ℂ :=
  (ArithmeticFunction.vonMangoldt address : ℂ) *
    goldenExponentialPronyCoordinate (base * eulerGoldenCoordinate address)

/-- A finite von Mangoldt trace sampled along `base + time * step`. -/
def finiteEulerShiftTrace {m : ℕ}
    (addresses : Fin m → ℕ) (base step : ℂ) (time : ℕ) : ℂ :=
  ∑ mode,
    (ArithmeticFunction.vonMangoldt (addresses mode) : ℂ) *
      goldenExponentialPronyCoordinate
        ((base + (time : ℂ) * step) *
          eulerGoldenCoordinate (addresses mode))

/-- The golden exponential at a positive integer address is the standard
complex Mellin character. -/
theorem euler_mellin_prony_node_eq_cpow
    {address : ℕ} (hAddress : 0 < address) (step : ℂ) :
    eulerMellinPronyNode address step = (address : ℂ) ^ (-step) := by
  unfold eulerMellinPronyNode eulerGoldenCoordinate
  unfold goldenExponentialPronyCoordinate goldenScaleCoordinate
  have hAddressC : (address : ℂ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hAddress)
  rw [Complex.cpow_def_of_ne_zero hAddressC]
  congr 1
  rw [← Complex.ofReal_log (Nat.cast_nonneg address)]
  push_cast
  have hPeriodC : (goldenScalePeriod : ℂ) ≠ 0 := by
    exact_mod_cast golden_scale_period_ne_zero
  field_simp [hPeriodC]
  ring

/-- Unit Mellin step gives the reciprocal integer node. -/
theorem euler_mellin_prony_node_one
    {address : ℕ} (hAddress : 0 < address) :
    eulerMellinPronyNode address 1 = (address : ℂ)⁻¹ := by
  rw [euler_mellin_prony_node_eq_cpow hAddress]
  simpa using Complex.cpow_neg_one (address : ℂ)

/-- At a genuine prime power the von Mangoldt Prony weight is exactly `log p`
times the base Mellin character. -/
theorem euler_mellin_prony_weight_prime_power
    (prime : Nat.Primes) {exponent : ℕ} (hExponent : exponent ≠ 0)
    (base : ℂ) :
    eulerMellinPronyWeight (prime.1 ^ exponent) base =
      (Real.log (prime.1 : ℝ) : ℂ) *
        goldenExponentialPronyCoordinate
          (base * eulerGoldenCoordinate (prime.1 ^ exponent)) := by
  unfold eulerMellinPronyWeight
  rw [ArithmeticFunction.vonMangoldt_apply_pow hExponent,
    ArithmeticFunction.vonMangoldt_apply_prime prime.2]

/-- Every finite von Mangoldt shift trace is exactly a finite Prony time trace
with nodes `n ^ (-step)`. -/
theorem finite_euler_shift_trace_eq_prony {m : ℕ}
    (addresses : Fin m → ℕ) (base step : ℂ) (time : ℕ) :
    finiteEulerShiftTrace addresses base step time =
      crystalTimeSample
        (fun mode => eulerMellinPronyNode (addresses mode) step)
        (fun mode => eulerMellinPronyWeight (addresses mode) base)
        time := by
  classical
  unfold finiteEulerShiftTrace crystalTimeSample
  apply Finset.sum_congr rfl
  intro mode _
  unfold eulerMellinPronyNode eulerMellinPronyWeight
  rw [show
      (base + (time : ℂ) * step) *
          eulerGoldenCoordinate (addresses mode) =
        base * eulerGoldenCoordinate (addresses mode) +
          (time : ℂ) *
            (step * eulerGoldenCoordinate (addresses mode)) by ring,
    golden_exponential_prony_coordinate_add,
    golden_exponential_prony_coordinate_nat_mul]
  ring

/-- The same finite trace is the standard finite von Mangoldt Dirichlet
window. -/
theorem finite_euler_shift_trace_eq_vonMangoldt_dirichlet_window
    {m : ℕ} (addresses : Fin m → ℕ)
    (hAddresses : ∀ mode, 0 < addresses mode)
    (base step : ℂ) (time : ℕ) :
    finiteEulerShiftTrace addresses base step time =
      ∑ mode,
        (ArithmeticFunction.vonMangoldt (addresses mode) : ℂ) *
          (addresses mode : ℂ) ^
            (-(base + (time : ℂ) * step)) := by
  classical
  unfold finiteEulerShiftTrace
  apply Finset.sum_congr rfl
  intro mode _
  change
    (ArithmeticFunction.vonMangoldt (addresses mode) : ℂ) *
        eulerMellinPronyNode (addresses mode)
          (base + (time : ℂ) * step) = _
  rw [euler_mellin_prony_node_eq_cpow (hAddresses mode)]

/-- Distinct positive integer addresses give distinct unit-step Euler nodes. -/
theorem euler_mellin_prony_node_one_injective
    {m : ℕ} {addresses : Fin m → ℕ}
    (hAddresses : ∀ mode, 0 < addresses mode)
    (hInjective : Function.Injective addresses) :
    Function.Injective
      (fun mode => eulerMellinPronyNode (addresses mode) 1) := by
  intro left right hNode
  have hInverse :
      ((addresses left : ℂ)⁻¹) = (addresses right : ℂ)⁻¹ := by
    simpa [euler_mellin_prony_node_one (hAddresses left),
      euler_mellin_prony_node_one (hAddresses right)] using hNode
  apply hInjective
  exact_mod_cast (inv_injective hInverse)

/-- Consequently, the first matching number of unit-step Euler observations
recovers arbitrary amplitudes on a finite family of distinct addresses. -/
theorem finite_euler_unit_step_window_injective
    {m : ℕ} {addresses : Fin m → ℕ}
    (hAddresses : ∀ mode, 0 < addresses mode)
    (hInjective : Function.Injective addresses) :
    Function.Injective
      (firstCrystalTimeWindow
        (fun mode => eulerMellinPronyNode (addresses mode) 1)) := by
  exact first_crystal_time_window_injective
    (euler_mellin_prony_node_one_injective hAddresses hInjective)

/-- The canonical meromorphic continuation of the Euler heat trace. -/
def continuedEulerTrace (s : ℂ) : ℂ :=
  -logDeriv classicalZeta s

/-- On the Euler half-plane, the continued trace is exactly the von Mangoldt
L-series already defined by the repository. -/
theorem continued_euler_trace_eq_single_address_heat_trace
    {s : ℂ} (hs : 1 < s.re) :
    continuedEulerTrace s = singleAddressHeatTrace s := by
  rw [single_address_heat_trace_eq_log_derivative hs]
  simp [continuedEulerTrace, logDeriv_apply]

/-- A zeta zero of multiplicity `m` is a pole center of the continued Euler
trace with principal coefficient `-m`. The remaining local term is the
logarithmic derivative of an analytic unit. -/
theorem continued_euler_trace_principal_part
    {rho : ℂ} {m : ℕ}
    (hMultiplicity : HasZetaZeroMultiplicity rho m) :
    ∃ u : ℂ → ℂ,
      AnalyticAt ℂ u rho ∧
      u rho ≠ 0 ∧
      continuedEulerTrace =ᶠ[𝓝[≠] rho]
        fun z => -(m : ℂ) / (z - rho) - logDeriv u z := by
  rcases hMultiplicity.2 with ⟨u, huAnalytic, huNonzero, hFactor⟩
  refine ⟨u, huAnalytic, huNonzero, ?_⟩
  have hLog :
      logDeriv classicalZeta =ᶠ[𝓝 rho]
        logDeriv (fun z : ℂ => (z - rho) ^ m * u z) :=
    logDeriv_congr_nhds hFactor
  have huAnalyticEventually :
      ∀ᶠ z in 𝓝 rho, AnalyticAt ℂ u z :=
    huAnalytic.eventually_analyticAt
  have huNonzeroEventually :
      ∀ᶠ z in 𝓝 rho, u z ≠ 0 :=
    huAnalytic.continuousAt.eventually_ne huNonzero
  filter_upwards [
    hLog.filter_mono nhdsWithin_le_nhds,
    huAnalyticEventually.filter_mono nhdsWithin_le_nhds,
    huNonzeroEventually.filter_mono nhdsWithin_le_nhds,
    self_mem_nhdsWithin] with z hzLog hzAnalytic hzUnit hzNe
  have hzSub : z - rho ≠ 0 := by
    simpa using hzNe
  have hProduct :
      logDeriv (fun w : ℂ => (w - rho) ^ m * u w) z =
        logDeriv (fun w : ℂ => (w - rho) ^ m) z +
          logDeriv u z := by
    exact logDeriv_mul z (pow_ne_zero m hzSub) hzUnit
      (by fun_prop) hzAnalytic.differentiableAt
  have hPower :
      logDeriv (fun w : ℂ => (w - rho) ^ m) z =
        (m : ℂ) * logDeriv (fun w : ℂ => w - rho) z := by
    simpa using
      (logDeriv_fun_pow (x := z)
        (f := fun w : ℂ => w - rho) (by fun_prop) m)
  have hLinear :
      logDeriv (fun w : ℂ => w - rho) z = 1 / (z - rho) := by
    simp [logDeriv_apply, hzSub]
  rw [continuedEulerTrace, hzLog, hProduct, hPower, hLinear]
  push_cast
  ring

/-- The golden Prony node attached to a zeta-pole center. -/
def zetaZeroPronyNode (rho : ℂ) : ℂ :=
  goldenExponentialPronyCoordinate (rho - criticalAbscissa)

/-- The node never vanishes. -/
theorem zeta_zero_prony_node_ne_zero (rho : ℂ) :
    zetaZeroPronyNode rho ≠ 0 := by
  exact golden_exponential_prony_coordinate_ne_zero _

/-- Functional-equation reflection sends a zero-side Prony node to its
inverse. -/
theorem zeta_zero_prony_node_reflection (rho : ℂ) :
    zetaZeroPronyNode (1 - rho) = (zetaZeroPronyNode rho)⁻¹ := by
  unfold zetaZeroPronyNode
  rw [show (1 - rho : ℂ) - criticalAbscissa =
      -(rho - criticalAbscissa) by
        apply Complex.ext <;> simp [criticalAbscissa] <;> ring,
    golden_exponential_prony_coordinate_neg]

/-- Complex conjugation of the zero location conjugates its node. -/
theorem zeta_zero_prony_node_conj (rho : ℂ) :
    zetaZeroPronyNode (starRingEnd ℂ rho) =
      starRingEnd ℂ (zetaZeroPronyNode rho) := by
  unfold zetaZeroPronyNode
  rw [show starRingEnd ℂ rho - criticalAbscissa =
      starRingEnd ℂ (rho - criticalAbscissa) by
        simp [criticalAbscissa],
    golden_exponential_prony_coordinate_conj]

/-- The node radius is the golden exponential of the signed horizontal
displacement from the critical line. -/
theorem zeta_zero_prony_node_norm (rho : ℂ) :
    ‖zetaZeroPronyNode rho‖ =
      Real.goldenRatio ^ (-2 * (rho.re - criticalAbscissa)) := by
  unfold zetaZeroPronyNode
  simpa using
    (golden_exponential_prony_coordinate_norm
      (rho - (criticalAbscissa : ℂ)))

/-- The critical line is exactly the unit-circle locus of the actual zero-side
Prony nodes. -/
theorem zeta_zero_prony_node_norm_eq_one_iff (rho : ℂ) :
    ‖zetaZeroPronyNode rho‖ = 1 ↔ rho.re = criticalAbscissa := by
  unfold zetaZeroPronyNode
  simpa [sub_eq_zero] using
    (golden_exponential_prony_coordinate_norm_eq_one_iff
      (rho - (criticalAbscissa : ℂ)))

/-- Equality of zero-side nodes forces equality of horizontal zero
coordinates. Vertical exponential aliasing is the only remaining collision
mechanism. -/
theorem zeta_zero_prony_node_eq_implies_re_eq
    {rho sigma : ℂ}
    (hNode : zetaZeroPronyNode rho = zetaZeroPronyNode sigma) :
    rho.re = sigma.re := by
  have hReal :=
    golden_exponential_prony_coordinate_eq_implies_re_eq hNode
  simpa [zetaZeroPronyNode] using hReal

/-- The node attached to one entry of canonical `ZeroData`. -/
def zeroDataZetaPronyNode (Z : ZeroData) (n : ℕ) : ℂ :=
  zetaZeroPronyNode (Z.zero n)

/-- The residue coefficient of the continued Euler trace at one stored zero. -/
def zeroDataEulerPoleWeight (Z : ZeroData) (n : ℕ) : ℂ :=
  -(Z.multiplicity n : ℂ)

/-- Stored reflection acts by node inversion. -/
theorem zero_data_zeta_prony_node_reflection
    (Z : ZeroData) (n : ℕ) :
    zeroDataZetaPronyNode Z (Z.reflection n) =
      (zeroDataZetaPronyNode Z n)⁻¹ := by
  unfold zeroDataZetaPronyNode
  rw [Z.zero_reflection, zeta_zero_prony_node_reflection]

/-- Stored conjugation acts by node conjugation. -/
theorem zero_data_zeta_prony_node_conjugation
    (Z : ZeroData) (n : ℕ) :
    zeroDataZetaPronyNode Z (Z.conjugation n) =
      starRingEnd ℂ (zeroDataZetaPronyNode Z n) := by
  unfold zeroDataZetaPronyNode
  rw [Z.zero_conjugation, zeta_zero_prony_node_conj]

/-- Every stored zero supplies the asserted continued-Euler principal part. -/
theorem zero_data_continued_euler_trace_principal_part
    (Z : ZeroData) (n : ℕ) :
    ∃ u : ℂ → ℂ,
      AnalyticAt ℂ u (Z.zero n) ∧
      u (Z.zero n) ≠ 0 ∧
      continuedEulerTrace =ᶠ[𝓝[≠] Z.zero n]
        fun z => zeroDataEulerPoleWeight Z n / (z - Z.zero n) -
          logDeriv u z := by
  simpa [zeroDataEulerPoleWeight] using
    (continued_euler_trace_principal_part (Z.zero_multiplicity n))

/-- One stored Euler pole is mapped to a nonzero golden Prony node, reflection
acts by inversion, and unit radius is exactly the critical-line condition. -/
theorem zero_data_euler_pole_golden_prony_realization
    (Z : ZeroData) (n : ℕ) :
    (∃ u : ℂ → ℂ,
      AnalyticAt ℂ u (Z.zero n) ∧
      u (Z.zero n) ≠ 0 ∧
      continuedEulerTrace =ᶠ[𝓝[≠] Z.zero n]
        fun z => zeroDataEulerPoleWeight Z n / (z - Z.zero n) -
          logDeriv u z) ∧
    zeroDataZetaPronyNode Z n ≠ 0 ∧
    zeroDataZetaPronyNode Z (Z.reflection n) =
      (zeroDataZetaPronyNode Z n)⁻¹ ∧
    (‖zeroDataZetaPronyNode Z n‖ = 1 ↔
      (Z.zero n).re = criticalAbscissa) := by
  exact ⟨zero_data_continued_euler_trace_principal_part Z n,
    zeta_zero_prony_node_ne_zero (Z.zero n),
    zero_data_zeta_prony_node_reflection Z n,
    zeta_zero_prony_node_norm_eq_one_iff (Z.zero n)⟩

/-- Under RH, every actual stored zero-side Prony node is unitary. -/
theorem zero_data_zeta_prony_node_unit_of_rh
    (hRH : RiemannHypothesis) (Z : ZeroData) (n : ℕ) :
    ‖zeroDataZetaPronyNode Z n‖ = 1 := by
  apply (zeta_zero_prony_node_norm_eq_one_iff (Z.zero n)).2
  exact zeroData_zero_on_critical_line_of_rh hRH Z n

/-- A finite collection of continued-Euler pole residues generates an actual
finite Prony moment sequence. -/
def finiteZetaPolePronyMoment {m : ℕ}
    (Z : ZeroData) (indices : Fin m → ℕ) (time : ℕ) : ℂ :=
  crystalTimeSample
    (fun mode => zeroDataZetaPronyNode Z (indices mode))
    (fun mode => zeroDataEulerPoleWeight Z (indices mode))
    time

/-- Component form of the finite pole-residue Prony moment. -/
theorem finite_zeta_pole_prony_moment_apply {m : ℕ}
    (Z : ZeroData) (indices : Fin m → ℕ) (time : ℕ) :
    finiteZetaPolePronyMoment Z indices time =
      ∑ mode,
        zeroDataEulerPoleWeight Z (indices mode) *
          zeroDataZetaPronyNode Z (indices mode) ^ time := by
  rfl

/-- If the selected exponential nodes are distinct, the first matching pole
moments recover their residue weights exactly. The injectivity hypothesis is
explicit because one golden period can alias vertical frequencies. -/
theorem finite_zeta_pole_prony_window_injective
    {m : ℕ} (Z : ZeroData) (indices : Fin m → ℕ)
    (hNodes : Function.Injective
      (fun mode => zeroDataZetaPronyNode Z (indices mode))) :
    Function.Injective
      (firstCrystalTimeWindow
        (fun mode => zeroDataZetaPronyNode Z (indices mode))) := by
  exact first_crystal_time_window_injective hNodes

example : Nonempty ℕ := ⟨1⟩
example : Nonempty ℂ := ⟨0⟩

