namespace D5.S3.Weil.GoldenCriticalSpectrum.EulerPronyArithmeticRealization

open D5.S3.Observer.GoldenPrimeCircle.GoldenScaleCircle
open D5.S3.ObserverMemory.FourierFibers.FiniteCrystalTimeFrequencyBridge
open D5.S3.Weil.Convention
