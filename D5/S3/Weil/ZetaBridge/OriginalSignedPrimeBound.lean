  have hcpos : (0 : ℝ) < c := by rcases hc with rfl | rfl <;> norm_num
  have hcle : c ≤ 5041 := by rcases hc with rfl | rfl <;> norm_num
  have hhalf : Real.log (c : ℝ) / 2 ≤ Prime80.halfWindow := by
    have hl := Real.log_le_log hcpos (by exact_mod_cast hcle : (c : ℝ) ≤ 5041)
    rw [Prime80.log_5041] at hl
    linarith
  have hcut : primeCutoff (Real.log (c : ℝ) / 2) = c := by
    unfold primeCutoff
    rw [show 2 * (Real.log (c : ℝ) / 2) = Real.log (c : ℝ) by ring,
      Real.exp_log hcpos]
    simp
  have he : primeQuadratic (Real.log (c : ℝ) / 2) M u =
      primeQuadratic (Real.log (c : ℝ) / 2) c u := by
    unfold primeQuadratic
    rw [primeAction_cutoff _ M hM, hcut]
  rw [Prime80.original_prime_integral, norm_neg, he]
  have arithmetic : Prime80.ArithmeticCertificate rows := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · dsimp only [rows]
      repeat' first
        | refine List.forall_mem_cons.mpr ⟨?_, ?_⟩
        | exact List.forall_mem_nil _
        | norm_num
    · have hs : (rows.map Prime80.Row.q).IsChain (· < ·) := by decide +kernel
      exact (List.isChain_iff_pairwise.mp hs).nodup
    · decide +kernel
    · have hs : (List.range 5041).filter (fun n => decide (n.primeFactors.card = 1)) =
          rows.map Prime80.Row.q := by decide +kernel
      intro n
      rw [← hs, List.mem_filter]
      simp only [decide_eq_true_eq]
      exact ⟨fun h => ⟨List.mem_range.mpr n.isLt, h⟩, fun h => h.2⟩
  have geometry : Prime80.CellCertificate rows cells := by
    refine ⟨?_, ?_⟩
    · decide +kernel
    · decide +kernel
  have hb := Prime80.memLp_quadratic_prime80 arithmetic geometry hhalf hcle (Lp.memLp u)
  rw [← OriginalEvenCosineComplete.l2_energy
    (volume.restrict (window (Real.log (c : ℝ) / 2))) u] at hb
  exact hb

