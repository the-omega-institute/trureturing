#print axioms normalized_zero_mode_factorization
#print axioms phase_flattened_zero_mode_eq_radial
#print axioms zero_mode_functional_reflection_time_reversal
#print axioms zero_mode_conjugation
#print axioms phase_flattened_critical_line_mirror_reciprocal
#print axioms zeroData_reflection_conjugation_commute
#print axioms zeroData_phase_flattened_mirror_reciprocal

end D5.S3.Weil.ZetaLinear.ReflectedZeroModePhaseFlattening
