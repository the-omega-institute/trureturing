/- GID: D5/S3/Weil/ZetaLinear/ReflectedZeroModePhaseFlattening
   generality: I
   mirror-B: D5/B/S3/Weil/ZetaLinear/ReflectedZeroModePhaseFlattening
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Separate normalized zero modes into radial and phase channels. -/

import D5.S3.Weil.ZetaLinear.CriticalDampingGenerator
import Mathlib.Tactic

/- Library-search audit trail (2026-08-31):
   * The frozen `CriticalDampingGenerator` identifies critical-line location
     with skewness of the normalized zero generator, but it does not expose the
     corresponding exponential mode, its radial-phase factorization, or the
     distinction between functional reflection, conjugation, and same-height
     critical-line reflection.
   * The frozen `ZeroSum` owner supplies the duplicate-free zero enumeration
     and its reflection and conjugation permutations.
   * Pinned Mathlib supplies complex exponential addition, conjugation, and
     norm identities. The coordinate transports and phase-flattening bridge
     are constructed directly below.
   * The time parameter is an auxiliary mode parameter. No identification
     with physical time and no Riemann-hypothesis premise is introduced. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace D5.S3.Weil.ZetaLinear.ReflectedZeroModePhaseFlattening

open D5.S3.Weil.Convention
open D5.S3.Weil.ZeroSum
open scoped ComplexConjugate

/-- The signed horizontal displacement of a point from the critical
abscissa. -/
def criticalDisplacement (rho : ℂ) : ℝ :=
  rho.re - criticalAbscissa

/-- The scalar generator remaining after the uniform damping shift in
`CriticalDampingGenerator` cancels. -/
def normalizedZeroGenerator (rho : ℂ) : ℂ :=
  -((criticalDisplacement rho : ℂ)) + Complex.I * (rho.im : ℂ)

/-- The exponential mode generated by `normalizedZeroGenerator`. -/
def normalizedZeroMode (rho : ℂ) (time : ℝ) : ℂ :=
  Complex.exp (normalizedZeroGenerator rho * (time : ℂ))

/-- The real-radial part of the normalized mode. -/
def radialZeroMode (rho : ℂ) (time : ℝ) : ℂ :=
  Complex.exp (((-(criticalDisplacement rho * time) : ℝ) : ℂ))

/-- The unit-modulus phase channel determined by the ordinate. -/
def commonZeroPhase (rho : ℂ) (time : ℝ) : ℂ :=
  Complex.exp (Complex.I * ((rho.im * time : ℝ) : ℂ))

/-- Remove the ordinate phase without changing the radial channel. -/
def phaseFlattenedZeroMode (rho : ℂ) (time : ℝ) : ℂ :=
  normalizedZeroMode rho time *
    Complex.exp (-(Complex.I * ((rho.im * time : ℝ) : ℂ)))

/-- Functional-equation reflection before conjugation. -/
def functionalReflection (rho : ℂ) : ℂ :=
  1 - rho

/-- Reflection across the critical line at the same ordinate. -/
def criticalLineMirror (rho : ℂ) : ℂ :=
  1 - conj rho

/-- The uniform damping parameter cancels and leaves the normalized zero
 generator. -/
theorem shifted_normalized_generator_eq
    (rho : ℂ) (omega : ℝ) :
    -(((omega + rho.re - criticalAbscissa : ℝ) : ℂ)) +
        Complex.I * (rho.im : ℂ) + (omega : ℂ) =
      normalizedZeroGenerator rho := by
  apply Complex.ext <;>
    simp [normalizedZeroGenerator, criticalDisplacement] <;>
    ring

@[simp]
theorem normalized_zero_generator_re (rho : ℂ) :
    (normalizedZeroGenerator rho).re = -criticalDisplacement rho := by
  simp [normalizedZeroGenerator]

@[simp]
theorem normalized_zero_generator_im (rho : ℂ) :
    (normalizedZeroGenerator rho).im = rho.im := by
  simp [normalizedZeroGenerator]

/-- The normalized generator is skew exactly when the point lies on the
critical line. -/
theorem normalized_zero_generator_skew_iff_critical_line (rho : ℂ) :
    starRingEnd ℂ (normalizedZeroGenerator rho) =
        -normalizedZeroGenerator rho ↔
      rho.re = criticalAbscissa := by
  constructor
  · intro h
    have hre := congrArg Complex.re h
    simp [normalizedZeroGenerator, criticalDisplacement] at hre
    linarith
  · intro h
    apply Complex.ext <;>
      simp [normalizedZeroGenerator, criticalDisplacement, h]

/-- Every normalized mode factors into its radial amplitude and common phase. -/
theorem normalized_zero_mode_factorization (rho : ℂ) (time : ℝ) :
    normalizedZeroMode rho time =
      radialZeroMode rho time * commonZeroPhase rho time := by
  unfold normalizedZeroMode radialZeroMode commonZeroPhase
  rw [← Complex.exp_add]
  congr 1
  apply Complex.ext <;>
    simp [normalizedZeroGenerator, criticalDisplacement] <;>
    ring

/-- The common phase has unit norm. -/
theorem common_zero_phase_norm_one (rho : ℂ) (time : ℝ) :
    ‖commonZeroPhase rho time‖ = 1 := by
  simp [commonZeroPhase, Complex.norm_exp]

/-- The radial norm is the real exponential of the negative displacement-time
product. -/
theorem radial_zero_mode_norm (rho : ℂ) (time : ℝ) :
    ‖radialZeroMode rho time‖ =
      Real.exp (-(criticalDisplacement rho * time)) := by
  simp [radialZeroMode, Complex.norm_exp]

/-- Multiplying by the inverse ordinate phase leaves exactly the radial mode. -/
theorem phase_flattened_zero_mode_eq_radial (rho : ℂ) (time : ℝ) :
    phaseFlattenedZeroMode rho time = radialZeroMode rho time := by
  unfold phaseFlattenedZeroMode
  rw [normalized_zero_mode_factorization]
  have hphase :
      commonZeroPhase rho time *
          Complex.exp (-(Complex.I * ((rho.im * time : ℝ) : ℂ))) = 1 := by
    rw [commonZeroPhase, ← Complex.exp_add]
    simp
  rw [mul_assoc, hphase, mul_one]

@[simp]
theorem critical_displacement_functional_reflection (rho : ℂ) :
    criticalDisplacement (functionalReflection rho) =
      -criticalDisplacement rho := by
  simp [criticalDisplacement, functionalReflection, criticalAbscissa]
  ring

@[simp]
theorem functional_reflection_im (rho : ℂ) :
    (functionalReflection rho).im = -rho.im := by
  simp [functionalReflection]

@[simp]
theorem critical_displacement_conjugation (rho : ℂ) :
    criticalDisplacement (conj rho) = criticalDisplacement rho := by
  simp [criticalDisplacement]

@[simp]
theorem critical_displacement_critical_line_mirror (rho : ℂ) :
    criticalDisplacement (criticalLineMirror rho) =
      -criticalDisplacement rho := by
  simp [criticalDisplacement, criticalLineMirror, criticalAbscissa]
  ring

@[simp]
theorem critical_line_mirror_im (rho : ℂ) :
    (criticalLineMirror rho).im = rho.im := by
  simp [criticalLineMirror]

/-- Conjugation followed by functional reflection is the same-height
critical-line mirror. -/
theorem functional_reflection_conjugation_eq_mirror (rho : ℂ) :
    functionalReflection (conj rho) = criticalLineMirror rho := by
  rfl

/-- Functional reflection followed by conjugation gives the same mirror. -/
theorem conjugation_functional_reflection_eq_mirror (rho : ℂ) :
    conj (functionalReflection rho) = criticalLineMirror rho := by
  apply Complex.ext <;>
    simp [functionalReflection, criticalLineMirror]

/-- Functional reflection negates the complete normalized generator. -/
theorem normalized_zero_generator_functional_reflection (rho : ℂ) :
    normalizedZeroGenerator (functionalReflection rho) =
      -normalizedZeroGenerator rho := by
  apply Complex.ext <;>
    simp [normalizedZeroGenerator]

/-- Conjugation preserves the radial rate and reverses only the frequency. -/
theorem normalized_zero_generator_conjugation (rho : ℂ) :
    normalizedZeroGenerator (conj rho) =
      conj (normalizedZeroGenerator rho) := by
  apply Complex.ext <;>
    simp [normalizedZeroGenerator, criticalDisplacement]

/-- Same-height critical-line reflection reverses the radial rate while
preserving the frequency. -/
theorem normalized_zero_generator_critical_line_mirror (rho : ℂ) :
    normalizedZeroGenerator (criticalLineMirror rho) =
      -conj (normalizedZeroGenerator rho) := by
  apply Complex.ext <;>
    simp [normalizedZeroGenerator]

/-- Functional reflection of coordinates is the same mode transformation as
time reversal. -/
theorem zero_mode_functional_reflection_time_reversal
    (rho : ℂ) (time : ℝ) :
    normalizedZeroMode (functionalReflection rho) time =
      normalizedZeroMode rho (-time) := by
  unfold normalizedZeroMode
  rw [normalized_zero_generator_functional_reflection]
  congr 1
  push_cast
  ring

/-- Complex conjugation reverses the frequency channel and preserves the time
orientation. -/
theorem zero_mode_conjugation (rho : ℂ) (time : ℝ) :
    normalizedZeroMode (conj rho) time =
      conj (normalizedZeroMode rho time) := by
  unfold normalizedZeroMode
  rw [normalized_zero_generator_conjugation, ← Complex.exp_conj]
  congr 1
  simp

/-- After phase flattening, a point and its same-height critical-line mirror
form reciprocal radial branches. -/
theorem phase_flattened_critical_line_mirror_reciprocal
    (rho : ℂ) (time : ℝ) :
    phaseFlattenedZeroMode rho time *
        phaseFlattenedZeroMode (criticalLineMirror rho) time = 1 := by
  rw [phase_flattened_zero_mode_eq_radial,
    phase_flattened_zero_mode_eq_radial]
  unfold radialZeroMode
  rw [critical_displacement_critical_line_mirror, ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- The two stored zero symmetries commute because both compositions enumerate
 the same critical-line mirror. -/
theorem zeroData_reflection_conjugation_commute
    (Z : ZeroData) (n : ℕ) :
    Z.reflection (Z.conjugation n) =
      Z.conjugation (Z.reflection n) := by
  apply Z.zero_injective
  calc
    Z.zero (Z.reflection (Z.conjugation n)) =
        1 - conj (Z.zero n) := by
      rw [Z.zero_reflection, Z.zero_conjugation]
    _ = conj (1 - Z.zero n) := by simp
    _ = conj (Z.zero (Z.reflection n)) := by
      rw [Z.zero_reflection]
    _ = Z.zero (Z.conjugation (Z.reflection n)) := by
      exact (Z.zero_conjugation (Z.reflection n)).symm

/-- Reflection after conjugation is the same-height critical-line mirror in the
actual zero enumeration. -/
theorem zeroData_reflection_conjugation_zero
    (Z : ZeroData) (n : ℕ) :
    Z.zero (Z.reflection (Z.conjugation n)) =
      criticalLineMirror (Z.zero n) := by
  rw [Z.zero_reflection, Z.zero_conjugation]
  rfl

/-- The phase-flattened modes of an enumerated zero and its same-height mirror
are reciprocal. -/
theorem zeroData_phase_flattened_mirror_reciprocal
    (Z : ZeroData) (n : ℕ) (time : ℝ) :
    phaseFlattenedZeroMode (Z.zero n) time *
        phaseFlattenedZeroMode
          (Z.zero (Z.reflection (Z.conjugation n))) time = 1 := by
  rw [zeroData_reflection_conjugation_zero]
  exact phase_flattened_critical_line_mirror_reciprocal (Z.zero n) time

