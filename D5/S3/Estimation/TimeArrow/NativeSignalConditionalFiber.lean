noncomputable section
/-- The signal symbol is `none`; every other vertex retains its identity. -/
def collapseVertex {M q : ℕ} (S : Support M q) : Vertex M → Option (Vertex M)
  | .inl i => if i ∈ S.val then none else some (.inl i)
  | .inr i => some (.inr i)
/-- Pair observations have two sites per edge; path observations retain every
vertex, including the terminal vertex. -/
def Sites (s : ℕ) : Experiment → Type
  | .pair => Fin s × Bool
  | .path => Fin (s + 1)
/-- The complete observation, represented by its vertex sites. -/
def siteEquiv (M s : ℕ) (e : Experiment) : Obs M s e ≃ (Sites s e → Vertex M) :=
  match e with
  | .pair =>
    { toFun := fun o k => if k.2 then (o k.1).2 else (o k.1).1
      invFun := fun f k => (f (k, false), f (k, true))
      left_inv := by intro o; funext k; rfl
      right_inv := by intro f; funext k; rcases k with ⟨k, b⟩; cases b <;> rfl }
  | .path => Equiv.refl _
/-- The conditioning readout contains the entire collapsed history. -/
def collapsedObs {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) : Sites s e → Option (Vertex M) :=
  fun k => collapseVertex S (siteEquiv M s e o k)
/-- Exactly the sigma-algebra generated by the complete collapsed history. -/
def collapsedSigma {M q s : ℕ} (S : Support M q) (e : Experiment) :
    MeasurableSpace (Obs M s e) :=
  MeasurableSpace.comap (collapsedObs S e) ⊤
/-- The original finite histories with the same collapsed readout. -/
def Fiber {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e) :=
  {o' : Obs M s e // collapsedObs S e o' = collapsedObs S e o}
/-- The positions at which the signal identity was erased. -/
def SignalSites {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e) :=
  {k : Sites s e // collapsedObs S e o k = none}
private theorem collapseVertex_eq_none {M q : ℕ} (S : Support M q) (x : Vertex M) :
    collapseVertex S x = none ↔ ∃ i ∈ S.val, x = Sum.inl i := by
  classical
  cases x with
  | inl i => simp [collapseVertex]
  | inr i => simp [collapseVertex]
/-- An erased vertex is exactly a freely chosen member of the true support. -/
def signalVertexEquiv {M q : ℕ} (S : Support M q) :
    {x : Vertex M // collapseVertex S x = none} ≃ {i : Fin M // i ∈ S.val} := by
  classical
  refine (Equiv.ofBijective
    (fun i : {i : Fin M // i ∈ S.val} =>
      (⟨Sum.inl i.val, by simp [collapseVertex, i.property]⟩ :
        {x : Vertex M // collapseVertex S x = none})) ?_).symm
  constructor
  · intro i j h
    exact Subtype.ext (Sum.inl.inj (congrArg Subtype.val h))
  · intro x
    rcases (collapseVertex_eq_none S x.val).mp x.property with ⟨i, hi, hx⟩
    exact ⟨⟨i, hi⟩, Subtype.ext hx.symm⟩
private theorem collapseVertex_preserves {M q : ℕ} (S : Support M q)
    (r : ℝ) {x y : Vertex M} (h : collapseVertex S x = collapseVertex S y) :
    b r S x = b r S y ∧ chi x = chi y := by
  classical
  cases x with
  | inl i =>
    cases y with
    | inl j =>
      by_cases hi : i ∈ S.val <;> by_cases hj : j ∈ S.val
      · simp [b, chi, hi, hj]
      · simp [collapseVertex, hi, hj] at h
      · simp [collapseVertex, hi, hj] at h
      · have hij : i = j := by simpa [collapseVertex, hi, hj] using h
        subst j; exact ⟨rfl, rfl⟩
    | inr j => by_cases hi : i ∈ S.val <;> simp [collapseVertex, hi] at h
  | inr i =>
    cases y with
    | inl j => by_cases hj : j ∈ S.val <;> simp [collapseVertex, hj] at h
    | inr j => simp [b, chi]
private theorem collapseVertex_injective_off_signal {M q : ℕ} (S : Support M q)
    {x y : Vertex M} (hy : collapseVertex S y ≠ none)
    (h : collapseVertex S x = collapseVertex S y) : x = y := by
  classical
  cases x with
  | inl i =>
    cases y with
    | inl j =>
      have hj : j ∉ S.val := by simpa [collapseVertex] using hy
      have hi : i ∉ S.val := by
        intro hi
        exact hy (h.symm.trans (by simp [collapseVertex, hi]))
      simpa [collapseVertex, hi, hj] using h
    | inr j => by_cases hi : i ∈ S.val <;> simp [collapseVertex, hi] at h
  | inr i =>
    cases y with
    | inl j =>
      have hj : j ∉ S.val := by simpa [collapseVertex] using hy
      simp [collapseVertex, hj] at h
    | inr j => simpa [collapseVertex] using h
private theorem same_fiber_probability {M q s : ℕ} (S : Support M q)
    (r : ℝ) (e : Experiment) (o o' : Obs M s e)
    (h : collapsedObs S e o' = collapsedObs S e o) :
    probability r e S o' = probability r e S o := by
  classical
  have hs (k : Sites s e) := collapseVertex_preserves S r (congrFun h k)
  cases e with
  | pair =>
    apply Finset.prod_congr rfl
    intro k _
    have hx := (hs (k, false)).1
    have hy := (hs (k, true)).2
    change b r S (o' k).1 = b r S (o k).1 at hx
    change chi (o' k).2 = chi (o k).2 at hy; simp only [transition, hx, hy]
  | path =>
    apply congrArg (fun z : ℝ => (2 * (M : ℝ))⁻¹ * z)
    apply Finset.prod_congr rfl
    intro k _
    have hx := (hs k.castSucc).1
    have hy := (hs k.succ).2
    change b r S (o' k.castSucc) = b r S (o k.castSucc) at hx
    change chi (o' k.succ) = chi (o k.succ) at hy; simp only [transition, hx, hy]
/-- Each complete history fiber is a product of its individual vertex fibers.
No independence assumption is imposed on the path edges. -/
def fiberSiteEquiv {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) : Fiber S e o ≃
      ((k : Sites s e) → {x : Vertex M // collapseVertex S x = collapsedObs S e o k}) :=
  ((siteEquiv M s e).subtypeEquiv
    (p := fun y : Obs M s e => collapsedObs S e y = collapsedObs S e o)
    (q := fun f : Sites s e → Vertex M => ∀ k,
      collapseVertex S (f k) = collapsedObs S e o k)
    (fun y => ⟨fun h k => congrFun h k, fun h => funext h⟩)).trans
      (Equiv.subtypePiEquivPi
        (α := Sites s e) (β := fun _ => Vertex M)
        (p := fun k x => collapseVertex S x = collapsedObs S e o k))
/-- Finite conditional probability on a positive native history fiber. -/
def conditionalFiberMass {M q s : ℕ} (S : Support M q) (r : ℝ)
    (e : Experiment) (o : Obs M s e) (A : Finset (Fiber S e o)) : ℝ := by
  classical
  letI : Fintype (Fiber S e o) := by unfold Fiber; infer_instance
  exact (∑ y ∈ A, probability r e S y.val) / (∑ y : Fiber S e o, probability r e S y.val)
private theorem conditionalFiberMass_eq_card {M q s : ℕ} (S : Support M q)
    (r : ℝ) (e : Experiment) (o : Obs M s e)
    (hp : 0 < probability r e S o) (A : Finset (Fiber S e o)) :
    conditionalFiberMass S r e o A =
      (A.card : ℝ) / Nat.card (Fiber S e o) := by
  classical
  letI : Fintype (Fiber S e o) := by unfold Fiber; infer_instance
  have hy (y : Fiber S e o) : probability r e S y.val = probability r e S o := same_fiber_probability S r e o y.val y.property
  simp only [conditionalFiberMass, hy, sum_const, nsmul_eq_mul, card_univ, Nat.card_eq_fintype_card]
  exact mul_div_mul_right _ _ (ne_of_gt hp)
def departureSite (s : ℕ) (e : Experiment) (k : Fin s) : Sites s e :=
  match e with
  | .pair => (k, false)
  | .path => k.castSucc
def successorSite (s : ℕ) (e : Experiment) (k : Fin s) : Sites s e :=
  match e with
  | .pair => (k, true)
  | .path => k.succ
/-- The two departure counts use actual departure labels and successor signs
fixed by the very same complete collapsed-history fiber. -/
theorem native_fiber_departure_counts {M q s : ℕ} (S : Support M q)
    (e : Experiment) (o : Obs M s e) (y : Fiber S e o) (i : Fin M) (z : ℝ) :
    count e y.val i z =
      (Finset.univ.filter fun k : Fin s =>
        siteEquiv M s e y.val (departureSite s e k) = Sum.inl i ∧
          chi (siteEquiv M s e o (successorSite s e k)) = z).card := by
  classical
  apply congrArg Finset.card
  ext k
  have hchi := (collapseVertex_preserves S 0 (congrFun y.property (successorSite s e k))).2
  cases e with
  | pair =>
    change chi (y.val k).2 = chi (o k).2 at hchi
    change k ∈ (univ.filter fun a =>
      (y.val a).1 = Sum.inl i ∧ chi (y.val a).2 = z) ↔
      k ∈ (univ.filter fun a => (y.val a).1 = Sum.inl i ∧ chi (o a).2 = z)
    simp only [mem_filter, mem_univ, true_and, hchi]
  | path =>
    change chi (y.val k.succ) = chi (o k.succ) at hchi
    change k ∈ (univ.filter fun a : Fin s =>
      y.val a.castSucc = Sum.inl i ∧ chi (y.val a.succ) = z) ↔
      k ∈ (univ.filter fun a : Fin s => y.val a.castSucc = Sum.inl i ∧ chi (o a.succ) = z)
    simp only [mem_filter, mem_univ, true_and, hchi]
/-- Retain only the freely varying signal identities. Every other site is
reconstructed from the same complete collapsed history. -/
def fiberLabelEquiv {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) : Fiber S e o ≃ (SignalSites S e o → {i : Fin M // i ∈ S.val}) :=
  (fiberSiteEquiv S e o).trans
    { toFun := fun f k => signalVertexEquiv S
        ⟨(f k.val).val, (f k.val).property.trans k.property⟩
      invFun := fun f k => if hk : collapsedObs S e o k = none then
        ⟨((signalVertexEquiv S).symm (f ⟨k, hk⟩)).val,
          ((signalVertexEquiv S).symm (f ⟨k, hk⟩)).property.trans hk.symm⟩
        else ⟨siteEquiv M s e o k, rfl⟩
      left_inv := by
        intro f
        funext k
        apply Subtype.ext
        by_cases hk : collapsedObs S e o k = none
        · simp only [dif_pos hk]
          exact congrArg Subtype.val ((signalVertexEquiv S).symm_apply_apply ⟨(f k).val, (f k).property.trans hk⟩)
        · simp only [dif_neg hk]
          exact (collapseVertex_injective_off_signal S hk (f k).property).symm
      right_inv := by
        intro f
        funext k
        simp only [dif_pos k.property]; exact (signalVertexEquiv S).apply_symm_apply (f k) }
/-- The uniform conditional law holds for arbitrary events of the erased
signal labels, not just rectangular site cylinders. -/
theorem native_signal_assignment_law {M q s : ℕ} (S : Support M q)
    (r : ℝ) (e : Experiment) (o : Obs M s e) [Fintype (Sites s e)]
    (hq : 1 ≤ q) (hqm : q < M) (hr : 0 < r) (hr1 : r < 1)
    (ha : 0 ≤ compensation M q r) (ha1 : compensation M q r < 1)
    (A : Finset (SignalSites S e o → {i : Fin M // i ∈ S.val})) :
    conditionalFiberMass S r e o (A.map (fiberLabelEquiv S e o).symm.toEmbedding) =
      (A.card : ℝ) / (q : ℝ) ^ Nat.card (SignalSites S e o) := by
  classical
  letI : Fintype (Fiber S e o) := by unfold Fiber; infer_instance
  letI : Fintype (SignalSites S e o) := by unfold SignalSites; infer_instance
  have hp := ((finite_support_bayes (s := s) hq hqm hr hr1 ha ha1 e).2.2.1 S o).1
  rw [conditionalFiberMass_eq_card S r e o hp, card_map]
  have hc := Fintype.card_congr (fiberLabelEquiv S e o)
  simp only [Fintype.card_fun, Fintype.card_coe, S.property] at hc; simp only [Nat.card_eq_fintype_card, hc, Nat.cast_pow]
/-- An exact site enumeration gives two departure-label words and all
remaining erased labels. In particular, terminal path labels belong in the
remaining block, not in either departure word. -/
def labelBlockEquiv {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e)
    (kp km kr : ℕ) (J : SignalSites S e o ≃ ((Fin kp ⊕ Fin km) ⊕ Fin kr)) :
    (SignalSites S e o → {i : Fin M // i ∈ S.val}) ≃
      (((Fin kp → {i : Fin M // i ∈ S.val}) × (Fin km → {i : Fin M // i ∈ S.val})) ×
        (Fin kr → {i : Fin M // i ∈ S.val})) :=
  (Equiv.arrowCongr J (Equiv.refl _)).trans
    ((Equiv.sumArrowEquivProdArrow (Fin kp ⊕ Fin km) (Fin kr) _).trans
      (Equiv.prodCongr (Equiv.sumArrowEquivProdArrow (Fin kp) (Fin km) _) (Equiv.refl _)))
/-- Exact joint occupation mass of two disjoint signal-site blocks, under the
native history law. The enumeration is explicit; assigning its first two
blocks to the positive and negative departure positions is a separate native
readout obligation. Existing frozen word-sector counting supplies the
multinomial factors. -/
private theorem native_multinomial_label_blocks {M q s : ℕ} (S : Support M q)
    (r : ℝ) (e : Experiment) (o : Obs M s e) [Fintype (Sites s e)]
    (hq : 1 ≤ q) (hqm : q < M) (hr : 0 < r) (hr1 : r < 1)
    (ha : 0 ≤ compensation M q r) (ha1 : compensation M q r < 1)
    (kp km kr : ℕ) (J : SignalSites S e o ≃ ((Fin kp ⊕ Fin km) ⊕ Fin kr))
    (ap am : Multiset {i : Fin M // i ∈ S.val}) (hap : ap.card = kp) (ham : am.card = km) :
    let A := ((D5.S3.Quantum.Entanglement.OccupancyWordSectors.sectorWords kp ap) ×ˢ
      (D5.S3.Quantum.Entanglement.OccupancyWordSectors.sectorWords km am)) ×ˢ
        (univ : Finset (Fin kr → {i : Fin M // i ∈ S.val}))
    conditionalFiberMass S r e o
      ((A.map (labelBlockEquiv S e o kp km kr J).symm.toEmbedding).map
        (fiberLabelEquiv S e o).symm.toEmbedding) =
      ((Nat.multinomial univ ap.count : ℝ) * (Nat.multinomial univ am.count : ℝ)) /
        (q : ℝ) ^ (kp + km) := by
  classical
  letI : Fintype (SignalSites S e o) := by unfold SignalSites; infer_instance
  dsimp only
  rw [native_signal_assignment_law S r e o hq hqm hr hr1 ha ha1]
  have hc := Fintype.card_congr J
  simp only [Fintype.card_sum, Fintype.card_fin] at hc; simp only [card_map, Finset.card_product,
    D5.S3.Quantum.Entanglement.OccupancyWordSectors.sector_words_card_multinomial ap hap,
    D5.S3.Quantum.Entanglement.OccupancyWordSectors.sector_words_card_multinomial am ham,
    card_univ, Fintype.card_fun, Fintype.card_coe, Fintype.card_fin, S.property, Nat.cast_mul,
    Nat.card_eq_fintype_card, hc, Nat.cast_pow, pow_add]
  have hqR : (q : ℝ) ≠ 0 := by exact_mod_cast (by omega : q ≠ 0)
  exact mul_div_mul_right _ _ (pow_ne_zero kr hqR)
private theorem departureSite_injective (s : ℕ) (e : Experiment) :
    Function.Injective (departureSite s e) := by
  cases e with
  | pair => intro j k h; exact congrArg Prod.fst h
  | path => exact Fin.castSucc_injective s
private theorem fiber_label_vertex {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) (y : Fiber S e o) (k : SignalSites S e o) :
    Sum.inl ((fiberLabelEquiv S e o y k).val) = siteEquiv M s e y.val k.val := by
  exact congrArg Subtype.val ((signalVertexEquiv S).symm_apply_apply
    ⟨siteEquiv M s e y.val k.val, (congrFun y.property k.val).trans k.property⟩)
/-- Departure counts of a signal-label assignment use only erased departure
coordinates and the successor signs of the same collapsed history. -/
def departureLabelCount {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e)
    [Fintype (Sites s e)] (g : SignalSites S e o → {i : Fin M // i ∈ S.val})
    (i : Fin M) (z : ℝ) : ℕ := by
  classical
  letI : Fintype (SignalSites S e o) := by unfold SignalSites; infer_instance
  exact (univ.filter fun k : SignalSites S e o => (g k).val = i ∧ ∃ j : Fin s, departureSite s e j = k.val ∧
      chi (siteEquiv M s e o (successorSite s e j)) = z).card
/-- Exact native count readout from the full signal-label assignment. This
bijection excludes non-departure pair coordinates and the terminal path site. -/
theorem native_departure_label_count {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) [Fintype (Sites s e)] (y : Fiber S e o) (i : Fin M) (hi : i ∈ S.val)
    (z : ℝ) :
    count e y.val i z = departureLabelCount S e o (fiberLabelEquiv S e o y) i z := by
  classical
  letI : Fintype (SignalSites S e o) := by unfold SignalSites; infer_instance
  rw [native_fiber_departure_counts]
  unfold departureLabelCount
  let D := univ.filter fun j : Fin s =>
    siteEquiv M s e y.val (departureSite s e j) = Sum.inl i ∧
      chi (siteEquiv M s e o (successorSite s e j)) = z
  let B := univ.filter fun k : SignalSites S e o => (fiberLabelEquiv S e o y k).val = i ∧
    ∃ j : Fin s, departureSite s e j = k.val ∧
      chi (siteEquiv M s e o (successorSite s e j)) = z
  change D.card = B.card
  have hsignal (j : Fin s) (hj : j ∈ D) : collapsedObs S e o (departureSite s e j) = none := by
    have he := (mem_filter.mp hj).2.1
    have hc := congrFun y.property (departureSite s e j)
    have hn : collapseVertex S (siteEquiv M s e y.val (departureSite s e j)) = none := by
      rw [he]; simp [collapseVertex, hi]
    exact hc.symm.trans hn
  let f : {j : Fin s // j ∈ D} → {k : SignalSites S e o // k ∈ B} := fun j =>
    ⟨⟨departureSite s e j.val, hsignal j.val j.property⟩, mem_filter.mpr ⟨mem_univ _, by
      constructor
      · apply Sum.inl.inj
        rw [fiber_label_vertex]; exact (mem_filter.mp j.property).2.1
      · exact ⟨j.val, rfl, (mem_filter.mp j.property).2.2⟩⟩⟩
  have hf : Function.Bijective f := by
    constructor
    · intro j k hjk
      apply Subtype.ext
      apply departureSite_injective s e
      exact congrArg (fun x => x.val.val) hjk
    · intro k
      obtain ⟨hklabel, j, hjsite, hjchi⟩ := (mem_filter.mp k.property).2
      have hj : j ∈ D := mem_filter.mpr ⟨mem_univ _, by
        constructor
        · rw [hjsite, ← fiber_label_vertex, hklabel]
        · exact hjchi⟩
      refine ⟨⟨j, hj⟩, ?_⟩
      apply Subtype.ext
      apply Subtype.ext
      exact hjsite
  simpa only [Fintype.card_coe] using Fintype.card_congr (Equiv.ofBijective f hf)
/-- An erased site contributes to the positive or negative departure block
according to its successor in the complete collapsed history. -/
def isSignedDeparture {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e)
    (z : ℝ) (k : SignalSites S e o) : Prop :=
  ∃ j : Fin s, departureSite s e j = k.val ∧
    chi (siteEquiv M s e o (successorSite s e j)) = z
private theorem signed_departure_disjoint {M q s : ℕ} (S : Support M q)
    (e : Experiment) (o : Obs M s e) (k : SignalSites S e o) :
    ¬ (isSignedDeparture S e o 1 k ∧ isSignedDeparture S e o (-1) k) := by
  rintro ⟨⟨j, hj, hpos⟩, ⟨l, hl, hneg⟩⟩
  have h : j = l := departureSite_injective s e (hj.trans hl.symm)
  subst l
  linarith
/-- The three blocks are actual positive departures, actual negative
 departures, and all remaining erased sites. -/
def signedDepartureBlocks {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) [Fintype (Sites s e)] : Fin 3 → Finset (SignalSites S e o) := by
  classical
  letI : Fintype (SignalSites S e o) := by unfold SignalSites; infer_instance
  exact ![univ.filter (isSignedDeparture S e o 1), univ.filter (isSignedDeparture S e o (-1)),
    univ.filter fun k => ¬ isSignedDeparture S e o 1 k ∧
      ¬ isSignedDeparture S e o (-1) k]
private def signedBlockSiteEquiv {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) [Fintype (Sites s e)] :
    (({k // k ∈ signedDepartureBlocks S e o 0} ⊕
      {k // k ∈ signedDepartureBlocks S e o 1}) ⊕
      {k // k ∈ signedDepartureBlocks S e o 2}) ≃ SignalSites S e o := by
  classical
  refine
    { toFun := Sum.elim (Sum.elim Subtype.val Subtype.val) Subtype.val
      invFun := fun k => if hp : isSignedDeparture S e o 1 k then
        Sum.inl (Sum.inl ⟨k, by simp [signedDepartureBlocks, hp]⟩)
        else if hn : isSignedDeparture S e o (-1) k then
          Sum.inl (Sum.inr ⟨k, by simp [signedDepartureBlocks, hn]⟩)
        else Sum.inr ⟨k, by simp [signedDepartureBlocks, hp, hn]⟩
      left_inv := ?_
      right_inv := ?_ }
  · rintro ((k | k) | k)
    · have hk : isSignedDeparture S e o 1 k.val := by exact (mem_filter.mp k.property).2
      simp [hk]
    · have hk : isSignedDeparture S e o (-1) k.val := by exact (mem_filter.mp k.property).2
      have hp : ¬ isSignedDeparture S e o 1 k.val := fun hp => signed_departure_disjoint S e o k.val ⟨hp, hk⟩
      simp [hp, hk]
    · have hk : ¬ isSignedDeparture S e o 1 k.val ∧
          ¬ isSignedDeparture S e o (-1) k.val := by exact (mem_filter.mp k.property).2
      simp [hk.1, hk.2]
  · intro k
    dsimp only
    split_ifs <;> rfl
/-- A canonical finite enumeration of the actual two departure blocks and
remaining coordinates. No externally chosen partition is assumed. -/
def nativeDepartureEnumeration {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) [Fintype (Sites s e)] :
    SignalSites S e o ≃
      ((Fin (signedDepartureBlocks S e o 0).card ⊕
        Fin (signedDepartureBlocks S e o 1).card) ⊕
        Fin (signedDepartureBlocks S e o 2).card) := by
  classical
  exact (signedBlockSiteEquiv S e o).symm.trans (Equiv.sumCongr (Equiv.sumCongr (Fintype.equivFinOfCardEq (Fintype.card_coe _))
        (Fintype.equivFinOfCardEq (Fintype.card_coe _)))
      (Fintype.equivFinOfCardEq (Fintype.card_coe _)))
/-- Every background row retains both original departure counts on a
complete collapsed history fiber. -/
theorem native_background_row_counts {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) (y : Fiber S e o) (i : Fin M) (hi : i ∉ S.val) (z : ℝ) :
    count e y.val i z = count e o i z := by
  classical
  rw [native_fiber_departure_counts S e o y i z, native_fiber_departure_counts S e o (⟨o, rfl⟩ : Fiber S e o) i z]
  apply congrArg Finset.card
  ext j
  simp only [mem_filter, mem_univ, true_and]
  have hcollapse := congrFun y.property (departureSite s e j)
  have he : siteEquiv M s e y.val (departureSite s e j) = Sum.inl i ↔
      siteEquiv M s e o (departureSite s e j) = Sum.inl i := by
    constructor
    · intro h
      have hc : collapseVertex S (siteEquiv M s e o (departureSite s e j)) =
          collapseVertex S (Sum.inl i) := hcollapse.symm.trans (congrArg (collapseVertex S) h)
      exact collapseVertex_injective_off_signal S (by simp [collapseVertex, hi]) hc
    · intro h
      have hc : collapseVertex S (siteEquiv M s e y.val (departureSite s e j)) =
          collapseVertex S (Sum.inl i) := hcollapse.trans (congrArg (collapseVertex S) h)
      exact collapseVertex_injective_off_signal S (by simp [collapseVertex, hi]) hc
  rw [he]
end
end D5.S3.Estimation.TimeArrow.NativeSignalConditionalFiber
open D5.S3.Estimation.TimeArrow.ActualMarkedPathPgfPoissonEnvelope
open scoped BigOperators Topology
open Finset Filter
namespace D5.S3.Estimation.TimeArrow.SharedRectangleCalibration
noncomputable section
/-- The four score increments relative to the lower-left count cell. -/
def offsets (r ε : ℝ) : Fin 4 → ℝ :=
  ![0, Real.log ((1 + r) / (1 - ε)), Real.log ((1 - r) / (1 + ε)),
    Real.log ((1 + r) / (1 - ε)) + Real.log ((1 - r) / (1 + ε))]
/-- The checkerboard change of the calibration equation at fixed root. -/
def checkerboard (r ε x : ℝ) : ℝ :=
  Real.sigmoid x + Real.sigmoid (x + offsets r ε 3) -
    Real.sigmoid (x + offsets r ε 1) - Real.sigmoid (x + offsets r ε 2)
/-- Real interpolation of the four counts with both margins fixed. The
order is A, B, C, D, and the count in A is the parameter `t`. -/
def cellCounts (N R U t : ℝ) : Fin 4 → ℝ :=
  ![t, U - t, R - t, N - R - U + t]
/-- All rows outside the four cells remain in the calibration sum. -/
def calibratedMean {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t x : ℝ) : ℝ :=
  (∑ i, Real.sigmoid (x + outside i)) +
    ∑ j, cellCounts N R U t j * Real.sigmoid (x + offsets r ε j)
/-- The variance of the same full Bernoulli calibration. -/
def calibratedVariance {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t x : ℝ) : ℝ :=
  (∑ i, Real.sigmoid (x + outside i) * (1 - Real.sigmoid (x + outside i))) +
    ∑ j, cellCounts N R U t j * Real.sigmoid (x + offsets r ε j) *
      (1 - Real.sigmoid (x + offsets r ε j))
private theorem sigmoid_log {u : ℝ} (hu : 0 < u) :
    Real.sigmoid (Real.log u) = u / (1 + u) := by
  rw [Real.sigmoid_def, Real.exp_neg, Real.exp_log hu]
  field_simp <;> ring
private theorem checkerboard_center {r : ℝ} (hr : 0 < r) (hr1 : r < 1) :
    checkerboard r 0 0 = -r ^ 4 / (2 * (2 - r ^ 2) * (4 - r ^ 2)) := by
  have hp : 0 < 1 + r := by linarith
  have hm : 0 < 1 - r := by linarith
  have hpq : 0 < (1 + r) * (1 - r) := mul_pos hp hm
  have h2 : 0 < 2 - r ^ 2 := by nlinarith
  have h4 : 0 < 4 - r ^ 2 := by nlinarith
  have hlog : Real.log (1 + r) + Real.log (1 - r) = Real.log ((1 + r) * (1 - r)) :=
    (Real.log_mul (ne_of_gt hp) (ne_of_gt hm)).symm
  change Real.sigmoid 0 + Real.sigmoid (0 + (Real.log ((1 + r) / (1 - 0)) + Real.log ((1 - r) / (1 + 0)))) -
    Real.sigmoid (0 + Real.log ((1 + r) / (1 - 0))) -
    Real.sigmoid (0 + Real.log ((1 - r) / (1 + 0))) = _
  simp only [zero_add, sub_zero, add_zero, div_one, Real.sigmoid_zero]
  rw [hlog, sigmoid_log hpq, sigmoid_log hp, sigmoid_log hm]
  field_simp <;> ring
private theorem checkerboard_center_neg {r : ℝ} (hr : 0 < r) (hr1 : r < 1) :
    checkerboard r 0 0 < 0 := by
  rw [checkerboard_center hr hr1]
  have h2 : 0 < 2 - r ^ 2 := by nlinarith
  have h4 : 0 < 4 - r ^ 2 := by nlinarith
  exact div_neg_of_neg_of_pos (neg_neg_of_pos (pow_pos hr 4)) (by positivity)
theorem sigmoid_shift_deriv (a x : ℝ) :
    HasDerivAt (fun x : ℝ => Real.sigmoid (x + a))
      (Real.sigmoid (x + a) * (1 - Real.sigmoid (x + a))) x := by
  simpa only [Function.comp_def, mul_one] using! (Real.hasDerivAt_sigmoid (x + a)).comp x ((hasDerivAt_id x).add_const a)
/-- Differentiate the complete calibration along one common root. The
histogram derivative is the checkerboard term, rather than four independent
root derivatives. -/
theorem moving_calibration_deriv {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t x v : ℝ) (θ : ℝ → ℝ) (hθ : HasDerivAt θ v t)
    (hx : θ t = x) :
    HasDerivAt (fun t => calibratedMean outside r ε N R U t (θ t))
      (checkerboard r ε x + calibratedVariance outside r ε N R U t x * v) t := by
  classical
  have ho : HasDerivAt (fun t => ∑ i, Real.sigmoid (θ t + outside i))
      ((∑ i, Real.sigmoid (x + outside i) * (1 - Real.sigmoid (x + outside i))) * v) t := by
    convert! HasDerivAt.sum (fun i (_ : i ∈ (univ : Finset ι)) =>
      (sigmoid_shift_deriv (outside i) (θ t)).comp t hθ) using 1
    · ext a
      simp
    · simp only [hx, sum_mul]
  have hc (j : Fin 4) : HasDerivAt (fun t => cellCounts N R U t j)
      (![1, -1, -1, 1] j) t := by
    fin_cases j
    · exact hasDerivAt_id t
    · change HasDerivAt (fun a : ℝ => U - a) (-1) t
      simpa only [sub_zero, zero_sub] using! (hasDerivAt_const t U).sub (hasDerivAt_id t)
    · change HasDerivAt (fun a : ℝ => R - a) (-1) t
      simpa only [sub_zero, zero_sub] using! (hasDerivAt_const t R).sub (hasDerivAt_id t)
    · change HasDerivAt (fun a : ℝ => N - R - U + a) 1 t
      simpa only [zero_add] using! (hasDerivAt_const t (N - R - U)).add (hasDerivAt_id t)
  have hi := ho.add (HasDerivAt.sum (fun j (_ : j ∈ (univ : Finset (Fin 4))) =>
    (hc j).mul ((sigmoid_shift_deriv (offsets r ε j) (θ t)).comp t hθ)))
  convert! hi using 1
  simp [calibratedVariance, checkerboard, hx, Fin.sum_univ_four, cellCounts, offsets, Function.comp_def]
  <;> ring
/-- Every differentiable root of the same constant calibration equation has
the shared implicit response `-Delta / Dcal`. -/
theorem shared_root_response {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U q t x v : ℝ) (θ : ℝ → ℝ) (hθ : HasDerivAt θ v t)
    (hx : θ t = x)
    (hcal : ∀ᶠ a in 𝓝 t, calibratedMean outside r ε N R U a (θ a) = q)
    (hv : calibratedVariance outside r ε N R U t x ≠ 0) :
    v = -checkerboard r ε x / calibratedVariance outside r ε N R U t x := by
  have hd := moving_calibration_deriv outside r ε N R U t x v θ hθ hx
  have hz := hd.unique ((hasDerivAt_const t q).congr_of_eventuallyEq hcal)
  apply (eq_div_iff hv).mpr
  nlinarith
private theorem calibration_root_deriv {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t x : ℝ) :
    HasDerivAt (calibratedMean outside r ε N R U t)
      (calibratedVariance outside r ε N R U t x) x := by
  classical
  have ho := HasDerivAt.sum (fun i (_ : i ∈ (univ : Finset ι)) =>
    sigmoid_shift_deriv (outside i) x)
  have hi := HasDerivAt.sum (fun j (_ : j ∈ (univ : Finset (Fin 4))) =>
    (sigmoid_shift_deriv (offsets r ε j) x).const_mul (cellCounts N R U t j))
  convert! ho.add hi using 1
  · funext y
    simp only [calibratedMean, Pi.add_apply, Finset.sum_apply]
  · simp only [calibratedVariance, mul_assoc]
/-- A locally defined shared calibration root exists whenever its actual full
variance is nonzero. Its derivative is computed from the same histogram. -/
theorem exists_shared_calibration_root {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U q t x : ℝ)
    (hcal : calibratedMean outside r ε N R U t x = q)
    (hv : calibratedVariance outside r ε N R U t x ≠ 0) :
    ∃ θ : ℝ → ℝ, θ t = x ∧
      (∀ᶠ a in 𝓝 t, calibratedMean outside r ε N R U a (θ a) = q) ∧
      HasDerivAt θ
        (-checkerboard r ε x / calibratedVariance outside r ε N R U t x) t := by
  classical
  let f := calibratedMean outside r ε N R U
  let f₁ : ℝ → ℝ → ℝ →L[ℝ] ℝ := fun _ x =>
    ContinuousLinearMap.toSpanSingleton ℝ (checkerboard r ε x)
  let f₂ : ℝ → ℝ → ℝ →L[ℝ] ℝ := fun t x =>
    ContinuousLinearMap.toSpanSingleton ℝ (calibratedVariance outside r ε N R U t x)
  have df₁ : ∀ᶠ a : ℝ × ℝ in 𝓝 (t, x), HasFDerivAt (f · a.2) (f₁ a.1 a.2) a.1 := by
    apply Filter.Eventually.of_forall
    intro a
    have hd := moving_calibration_deriv outside r ε N R U a.1 a.2 0 (fun _ => a.2) (hasDerivAt_const a.1 a.2) rfl
    simpa only [mul_zero, add_zero] using hd.hasFDerivAt
  have df₂ : ∀ᶠ a : ℝ × ℝ in 𝓝 (t, x), HasFDerivAt (f a.1 ·) (f₂ a.1 a.2) a.2 :=
    Filter.Eventually.of_forall fun a =>
      (calibration_root_deriv outside r ε N R U a.1 a.2).hasFDerivAt
  have cf₁ : ContinuousAt (Function.uncurry f₁) (t, x) := by
    unfold f₁
    apply (ContinuousLinearMap.toSpanSingletonCLE (𝕜 := ℝ) (E := ℝ)).continuous.continuousAt.comp
    dsimp [checkerboard]
    fun_prop
  have cf₂ : ContinuousAt (Function.uncurry f₂) (t, x) := by
    unfold f₂
    apply (ContinuousLinearMap.toSpanSingletonCLE (𝕜 := ℝ) (E := ℝ)).continuous.continuousAt.comp
    dsimp [calibratedVariance, cellCounts]
    fun_prop
  have iv : (f₂ t x).IsInvertible := by
    apply ContinuousLinearMap.IsInvertible.of_inverse (g := ContinuousLinearMap.toSpanSingleton ℝ
        (calibratedVariance outside r ε N R U t x)⁻¹)
    · ext a
      simp [f₂, mul_comm, mul_left_comm, hv]
    · ext a
      simp [f₂, mul_comm, mul_left_comm, hv]
  let θ := implicitFunctionOfBivariate df₁ df₂ cf₁ cf₂ iv
  have hx : θ t = x := (eventually_apply_eq_iff_implicitFunctionOfBivariate df₁ df₂ cf₁ cf₂ iv).self_of_nhds.mp rfl
  have hθ := (hasStrictFDerivAt_implicitFunctionOfBivariate df₁ df₂ cf₁ cf₂ iv).hasFDerivAt.hasDerivAt
  have he : ∀ᶠ a in 𝓝 t, calibratedMean outside r ε N R U a (θ a) = q := by
    simpa only [f, θ, hcal] using eventually_apply_implicitFunctionOfBivariate df₁ df₂ cf₁ cf₂ iv
  refine ⟨θ, hx, he, ?_⟩
  rwa [shared_root_response outside r ε N R U q t x _ θ hθ hx he hv] at hθ
/-- The compensated group response uses the same root and full variance. -/
theorem compensated_group_deriv {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U q bg t x v : ℝ) (θ : ℝ → ℝ) (hθ : HasDerivAt θ v t)
    (hx : θ t = x)
    (hcal : ∀ᶠ u in 𝓝 t, calibratedMean outside r ε N R U u (θ u) = q)
    (hv : calibratedVariance outside r ε N R U t x ≠ 0) :
    HasDerivAt (fun u => (bg + u) * Real.sigmoid (θ u) - u / 2)
      (Real.sigmoid x - 1 / 2 - (bg + t) * Real.sigmoid x * (1 - Real.sigmoid x) *
        checkerboard r ε x / calibratedVariance outside r ε N R U t x) t := by
  have hr := shared_root_response outside r ε N R U q t x v θ hθ hx hcal hv
  have hg := (((hasDerivAt_id t).const_add bg).mul
    ((Real.hasDerivAt_sigmoid (θ t)).comp t hθ)).sub ((hasDerivAt_id t).div_const 2)
  convert! hg using 1
  simp only [Function.comp_apply, id_eq, hr, hx]; ring
private theorem continuous_checkerboard_parameters {r : ℝ} (hr : 0 < r) (hr1 : r < 1) :
    ContinuousAt (fun a : ℝ × ℝ => checkerboard r a.1 a.2) (0, 0) := by
  have hp : (1 + r) / (1 - (0 : ℝ)) ≠ 0 := by simp; linarith
  have hm : (1 - r) / (1 + (0 : ℝ)) ≠ 0 := by simp; linarith
  have hpden : (1 : ℝ) - ((0, 0) : ℝ × ℝ).1 ≠ 0 := by norm_num
  have hmden : (1 : ℝ) + ((0, 0) : ℝ × ℝ).1 ≠ 0 := by norm_num
  have cp : ContinuousAt (fun a : ℝ × ℝ => Real.log ((1 + r) / (1 - a.1))) (0, 0) :=
    (continuousAt_const.div (continuousAt_const.sub continuous_fst.continuousAt) hpden).log hp
  have cm : ContinuousAt (fun a : ℝ × ℝ => Real.log ((1 - r) / (1 + a.1))) (0, 0) :=
    (continuousAt_const.div (continuousAt_const.add continuous_fst.continuousAt) hmden).log hm
  change ContinuousAt (fun a : ℝ × ℝ =>
    Real.sigmoid a.2 + Real.sigmoid (a.2 + (Real.log ((1 + r) / (1 - a.1)) +
      Real.log ((1 - r) / (1 + a.1)))) -
    Real.sigmoid (a.2 + Real.log ((1 + r) / (1 - a.1))) -
    Real.sigmoid (a.2 + Real.log ((1 - r) / (1 + a.1)))) (0, 0)
  exact (((continuous_sigmoid.continuousAt.comp continuous_snd.continuousAt).add
    (continuous_sigmoid.continuousAt.comp (continuous_snd.continuousAt.add (cp.add cm)))).sub
    (continuous_sigmoid.continuousAt.comp (continuous_snd.continuousAt.add cp))).sub
    (continuous_sigmoid.continuousAt.comp (continuous_snd.continuousAt.add cm))
/-- Strictly negative checkerboard response persists in a full neighborhood
of the compensated symmetric center, with one constant for all outside rows. -/
theorem checkerboard_negative_neighborhood {r : ℝ} (hr : 0 < r) (hr1 : r < 1) :
    ∃ d : ℝ, 0 < d ∧ ∀ᶠ a : ℝ × ℝ in 𝓝 (0, 0), checkerboard r a.1 a.2 < -d := by
  let d := -checkerboard r 0 0 / 2
  have hd : 0 < d := by dsimp [d]; linarith [checkerboard_center_neg hr hr1]
  refine ⟨d, hd, ?_⟩
  exact (continuous_checkerboard_parameters hr hr1).eventually_lt_const (by dsimp [d]; linarith [checkerboard_center_neg hr hr1])
private theorem cellCounts_sum (N R U t : ℝ) : (∑ j, cellCounts N R U t j) = N := by simp [Fin.sum_univ_four, cellCounts]; ring
private theorem calibratedVariance_pos {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t x : ℝ) (hN : 0 < N)
    (hc : ∀ j, 0 ≤ cellCounts N R U t j) :
    0 < calibratedVariance outside r ε N R U t x := by
  classical
  have hp (a : ℝ) : 0 < Real.sigmoid a * (1 - Real.sigmoid a) :=
    mul_pos (Real.sigmoid_pos a) (sub_pos.mpr (Real.sigmoid_lt_one a))
  have hj : ∃ j, 0 < cellCounts N R U t j := by
    by_contra hn
    push_neg at hn
    have hs := sum_nonpos (fun j (_ : j ∈ (univ : Finset (Fin 4))) => hn j)
    rw [cellCounts_sum] at hs; linarith
  rcases hj with ⟨j, hj⟩
  have ho : 0 ≤ ∑ i, Real.sigmoid (x + outside i) * (1 - Real.sigmoid (x + outside i)) := sum_nonneg fun i _ => (hp _).le
  have hi : 0 < ∑ j, cellCounts N R U t j * Real.sigmoid (x + offsets r ε j) *
      (1 - Real.sigmoid (x + offsets r ε j)) := by
    have he := single_le_sum (s := univ) (f := fun j => cellCounts N R U t j *
      Real.sigmoid (x + offsets r ε j) * (1 - Real.sigmoid (x + offsets r ε j)))
      (fun k _ => by rw [mul_assoc]; exact mul_nonneg (hc k) (hp _).le) (mem_univ j)
    have hjp : 0 < cellCounts N R U t j * Real.sigmoid (x + offsets r ε j) *
        (1 - Real.sigmoid (x + offsets r ε j)) := by
      rw [mul_assoc]; exact mul_pos hj (hp _)
    exact hjp.trans_le he
  exact add_pos_of_nonneg_of_pos ho hi
theorem exists_calibration_root {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U q t : ℝ) (hq : 0 < q)
    (hqM : q < (Fintype.card ι : ℝ) + N)
    :
    ∃ x, calibratedMean outside r ε N R U t x = q := by
  classical
  have hbot (a : ℝ) : Tendsto (fun x : ℝ => Real.sigmoid (x + a)) atBot (𝓝 0) :=
    Real.tendsto_sigmoid_atBot.comp (tendsto_atBot_add_const_right _ a tendsto_id)
  have htop (a : ℝ) : Tendsto (fun x : ℝ => Real.sigmoid (x + a)) atTop (𝓝 1) :=
    Real.tendsto_sigmoid_atTop.comp (tendsto_atTop_add_const_right _ a tendsto_id)
  have hb : Tendsto (calibratedMean outside r ε N R U t) atBot (𝓝 0) := by
    simpa [calibratedMean] using! (tendsto_finsetSum univ (fun i _ => hbot (outside i))).add
        (tendsto_finsetSum univ (fun j _ => (hbot (offsets r ε j)).const_mul
          (cellCounts N R U t j)))
  have ht : Tendsto (calibratedMean outside r ε N R U t) atTop
      (𝓝 ((Fintype.card ι : ℝ) + N)) := by
    simpa [calibratedMean, cellCounts_sum] using! (tendsto_finsetSum univ (fun i _ => htop (outside i))).add
        (tendsto_finsetSum univ (fun j _ => (htop (offsets r ε j)).const_mul
          (cellCounts N R U t j)))
  have hcont : Continuous (calibratedMean outside r ε N R U t) := by
    unfold calibratedMean
    fun_prop
  obtain ⟨x, hx⟩ := intermediate_value_univ₂_eventually₂ hcont continuous_const
    (hb.eventually_le_const hq) (ht.eventually_const_le hqM)
  exact ⟨x,hx⟩
theorem unique_shared_root {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U q t : ℝ) (hN : 0 < N) (hq : 0 < q)
    (hqM : q < (Fintype.card ι : ℝ) + N)
    (hc : ∀ j, 0 ≤ cellCounts N R U t j) :
    ∃! x, calibratedMean outside r ε N R U t x = q := by
  obtain ⟨x,hx⟩ := exists_calibration_root outside r ε N R U q t hq hqM
  have hm : StrictMono (calibratedMean outside r ε N R U t) :=
    strictMono_of_deriv_pos fun x => by
      rw [(calibration_root_deriv outside r ε N R U t x).deriv]; exact calibratedVariance_pos outside r ε N R U t x hN hc
  exact ⟨x, hx, fun y hy => hm.injective (hy.trans hx.symm)⟩
/-- One shared root is defined on the entire feasible open interval. Local
implicit roots agree with it by uniqueness, so their responses belong to one
curve rather than separately selected roots. This does not assert a uniform
lower bound on the variance. -/
theorem shared_calibration_curve {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U q a b : ℝ) (hN : 0 < N) (hq : 0 < q)
    (hqM : q < (Fintype.card ι : ℝ) + N)
    (hc : ∀ t ∈ Set.Ioo a b, ∀ j, 0 ≤ cellCounts N R U t j) :
    ∃ θ : ℝ → ℝ, ∀ t ∈ Set.Ioo a b,
      calibratedMean outside r ε N R U t (θ t) = q ∧
      HasDerivAt θ
        (-checkerboard r ε (θ t) / calibratedVariance outside r ε N R U t (θ t)) t ∧
      0 < calibratedVariance outside r ε N R U t (θ t) := by
  classical
  have hex (t : ℝ) (ht : t ∈ Set.Ioo a b) := unique_shared_root outside r ε N R U q t hN hq hqM (hc t ht)
  let θ : ℝ → ℝ := fun t => if ht : t ∈ Set.Ioo a b then (hex t ht).exists.choose else 0
  have heq (t : ℝ) (ht : t ∈ Set.Ioo a b) :
      calibratedMean outside r ε N R U t (θ t) = q := by simp only [θ, dif_pos ht]; exact (hex t ht).exists.choose_spec
  refine ⟨θ, fun t ht => ?_⟩
  have hv := calibratedVariance_pos outside r ε N R U t (θ t) hN (hc t ht)
  obtain ⟨φ, hφt, hφeq, hφder⟩ := exists_shared_calibration_root outside r ε N R U q t (θ t) (heq t ht) (ne_of_gt hv)
  have hagree : θ =ᶠ[𝓝 t] φ := by
    filter_upwards [hφeq, isOpen_Ioo.mem_nhds ht] with u hu hui
    exact (hex u hui).unique (heq u hui) hu
  exact ⟨heq t ht, hφt ▸ hφder.congr_of_eventuallyEq hagree, hv⟩
open D5.S3.Estimation.SequentialDecisionRisk.FiniteSupportSelectionBayes
private theorem sigmoid_lipschitz_certificate :
    LipschitzWith (1 / 4 : NNReal) Real.sigmoid := by
  apply lipschitzWith_of_nnnorm_deriv_le differentiable_sigmoid
  intro x
  rw [Real.deriv_sigmoid]
  change ‖Real.sigmoid x * (1 - Real.sigmoid x)‖ ≤ (1 / 4 : ℝ)
  rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (Real.sigmoid_nonneg x) (sub_nonneg.mpr (Real.sigmoid_le_one x)))]
  nlinarith [sq_nonneg (Real.sigmoid x - 1 / 2)]
end
end D5.S3.Estimation.TimeArrow.SharedRectangleCalibration
open D5.S3.Estimation.TimeArrow.SharedRectangleCalibration
namespace D5.S3.Estimation.TimeArrow.RectangleCalibrationBounds
noncomputable section
private theorem sigmoid_variance_formula (x : ℝ) :
    Real.sigmoid x * (1 - Real.sigmoid x) =
      Real.exp (-x) / (1 + Real.exp (-x)) ^ 2 := by
  rw [Real.sigmoid_def]
  field_simp <;> ring
/-- A bounded common odds tilt controls every Bernoulli variance by the
same factors, independently of its unshifted score. -/
theorem sigmoid_variance_tilt (x h : ℝ)
    (hl : 1 / 2 ≤ Real.exp (-h)) (hu : Real.exp (-h) ≤ 2) :
    (Real.sigmoid x * (1 - Real.sigmoid x)) / 2 ≤
        Real.sigmoid (x + h) * (1 - Real.sigmoid (x + h)) ∧
      Real.sigmoid (x + h) * (1 - Real.sigmoid (x + h)) ≤
        2 * (Real.sigmoid x * (1 - Real.sigmoid x)) := by
  rw [sigmoid_variance_formula, sigmoid_variance_formula, neg_add, Real.exp_add]
  let w := Real.exp (-x)
  let z := Real.exp (-h)
  have hw : 0 < w := Real.exp_pos _
  have hz : 0 < z := Real.exp_pos _
  change 1 / 2 ≤ z at hl
  change z ≤ 2 at hu
  change w / (1 + w) ^ 2 / 2 ≤ w * z / (1 + w * z) ^ 2 ∧ w * z / (1 + w * z) ^ 2 ≤ 2 * (w / (1 + w) ^ 2)
  have hd : 0 < (1 + w) ^ 2 := sq_pos_of_pos (by positivity)
  have he : 0 < (1 + w * z) ^ 2 := sq_pos_of_pos (by positivity)
  constructor
  · rw [div_div, div_le_div_iff₀ (mul_pos hd (by norm_num : (0 : ℝ) < 2)) he]
    have hp : 0 ≤ z * (2 - z) * w ^ 2 := mul_nonneg (mul_nonneg hz.le (by linarith)) (sq_nonneg w)
    nlinarith
  · rw [← mul_div_assoc, div_le_div_iff₀ he hd]
    have hp : 0 ≤ z * (2 * z - 1) * w ^ 2 := mul_nonneg (mul_nonneg hz.le (by linarith)) (sq_nonneg w)
    nlinarith
private theorem sigmoid_variance_bounds (x : ℝ) :
    0 ≤ Real.sigmoid x * (1 - Real.sigmoid x) ∧
      Real.sigmoid x * (1 - Real.sigmoid x) ≤ 1 / 4 := by
  constructor
  · exact mul_nonneg (Real.sigmoid_nonneg x) (sub_nonneg.mpr (Real.sigmoid_le_one x))
  · nlinarith [sq_nonneg (Real.sigmoid x - 1 / 2)]
/-- Changing the same rectangle histogram has a uniform effect on full
variance at a fixed root. The outside rows cancel exactly. -/
private theorem variance_histogram_displacement {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t t0 x : ℝ) :
    |calibratedVariance outside r ε N R U t x -
      calibratedVariance outside r ε N R U t0 x| ≤ |t - t0| := by
  have hi : calibratedVariance outside r ε N R U t x - calibratedVariance outside r ε N R U t0 x =
      (t - t0) * (Real.sigmoid x * (1 - Real.sigmoid x) +
        Real.sigmoid (x + offsets r ε 3) * (1 - Real.sigmoid (x + offsets r ε 3)) -
        Real.sigmoid (x + offsets r ε 1) * (1 - Real.sigmoid (x + offsets r ε 1)) -
        Real.sigmoid (x + offsets r ε 2) * (1 - Real.sigmoid (x + offsets r ε 2))) := by
    simp [calibratedVariance, cellCounts, offsets, Fin.sum_univ_four]; ring
  rw [hi, abs_mul]
  have hb : |Real.sigmoid x * (1 - Real.sigmoid x) + Real.sigmoid (x + offsets r ε 3) * (1 - Real.sigmoid (x + offsets r ε 3)) -
        Real.sigmoid (x + offsets r ε 1) * (1 - Real.sigmoid (x + offsets r ε 1)) -
        Real.sigmoid (x + offsets r ε 2) * (1 - Real.sigmoid (x + offsets r ε 2))| ≤ 1 := by
    apply abs_le.mpr
    have h0 := sigmoid_variance_bounds x
    have h1 := sigmoid_variance_bounds (x + offsets r ε 1)
    have h2 := sigmoid_variance_bounds (x + offsets r ε 2)
    have h3 := sigmoid_variance_bounds (x + offsets r ε 3)
    constructor <;> linarith
  exact (mul_le_mul_of_nonneg_left hb (abs_nonneg _)).trans_eq (mul_one _)
/-- A bounded root tilt gives uniform full-variance comparison for every
feasible rectangle histogram, including every outside row. -/
private theorem variance_root_tilt {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t x h : ℝ) (hc : ∀ j, 0 ≤ cellCounts N R U t j)
    (hl : 1 / 2 ≤ Real.exp (-h)) (hu : Real.exp (-h) ≤ 2) :
    calibratedVariance outside r ε N R U t x / 2 ≤
        calibratedVariance outside r ε N R U t (x + h) ∧
      calibratedVariance outside r ε N R U t (x + h) ≤
        2 * calibratedVariance outside r ε N R U t x := by
  have ho (i : ι) := sigmoid_variance_tilt (x + outside i) h hl hu
  have hi (j : Fin 4) := sigmoid_variance_tilt (x + offsets r ε j) h hl hu
  unfold calibratedVariance
  constructor
  · rw [add_div, sum_div, sum_div]
    apply add_le_add
    · apply sum_le_sum
      intro i _
      simpa only [add_assoc, add_comm, add_left_comm] using (ho i).1
    · apply sum_le_sum
      intro j _
      have hh := mul_le_mul_of_nonneg_left (hi j).1 (hc j)
      simpa only [mul_div_assoc, mul_assoc, add_assoc, add_comm, add_left_comm] using hh
  · rw [mul_add, mul_sum, mul_sum]
    apply add_le_add
    · apply sum_le_sum
      intro i _
      simpa only [add_assoc, add_comm, add_left_comm] using (ho i).2
    · apply sum_le_sum
      intro j _
      have hh := mul_le_mul_of_nonneg_left (hi j).2 (hc j)
      simpa only [mul_assoc, mul_left_comm, mul_comm, add_assoc, add_left_comm, add_comm] using hh
/-- A single base variance controls the entire feasible central rectangle
fiber and a fixed root box. No histogram-dependent neighborhood is used. -/
theorem central_fiber_variance_bounds {ι : Type*} [Fintype ι] (outside : ι → ℝ)
    (r ε N R U t t0 x h w : ℝ) (hc : ∀ j, 0 ≤ cellCounts N R U t j)
    (ht : |t - t0| ≤ w) (hl : 1 / 2 ≤ Real.exp (-h)) (hu : Real.exp (-h) ≤ 2) :
    (calibratedVariance outside r ε N R U t0 x - w) / 2 ≤
        calibratedVariance outside r ε N R U t (x + h) ∧
      calibratedVariance outside r ε N R U t (x + h) ≤
        2 * (calibratedVariance outside r ε N R U t0 x + w) := by
  have hd := (abs_le.mp ((variance_histogram_displacement outside r ε N R U t t0 x).trans ht))
  have hb := variance_root_tilt outside r ε N R U t x h hc hl hu
  constructor <;> linarith
end
end D5.S3.Estimation.TimeArrow.RectangleCalibrationBounds
open D5.S3.Estimation.TimeArrow.SinglePeakLogLikelihoodCovariance
namespace D5.S3.Estimation.TimeArrow.NativeGrowthRounding
noncomputable section
/-- Index zero corresponds to the first decimal exponent of the original sequence. -/
def decimalExponent : ℕ → ℕ
  | 0 => 1
  | n + 1 => 10 ^ (5 * decimalExponent n)
/-- The original decimal denominator. -/
def denominator (n : ℕ) : ℕ := 10 ^ decimalExponent n
/-- The original integer observation scale. -/
def scale (n : ℕ) : ℕ := denominator n ^ 3
/-- The lower-left signal cell retains the original floor. -/
def centralPositive (r : ℝ) (L : ℕ) : ℕ := ⌊((1 + r) / 2) * (L : ℝ)⌋₊
/-- The second coordinate retains the exact total count. -/
def centralNegative (r : ℝ) (L : ℕ) : ℕ := L - centralPositive r L
/-- The uncompensated score at the original lower-left cell. -/
def center (r : ℝ) (L : ℕ) : ℝ :=
  centralPositive r L * Real.log (1 + r) +
    centralNegative r L * Real.log (1 - r)
/-- Original population size, with its base-two floor. -/
def population (r β : ℝ) (L : ℕ) : ℕ :=
  2 ^ ⌊phi r * (L : ℝ) / (β * Real.log 2)⌋₊
/-- Original signal cardinality, with its final floor. -/
def signalSize (r β : ℝ) (L : ℕ) : ℕ :=
  ⌊(population r β L : ℝ) * Real.exp (-center r L)⌋₊
/-- The original A-cell logit uses the complete background population. -/
def cellLogit (r β : ℝ) (L : ℕ) : ℝ :=
  let M := population r β L
  let q := signalSize r β L
  centralPositive r L * Real.log ((1 + r) / (1 - compensation M q r)) +
    centralNegative r L * Real.log ((1 - r) / (1 + compensation M q r)) -
      Real.log (((M - q : ℕ) : ℝ) / q)
/-- Both central coordinates have a bounded rounding error. -/
theorem central_rounding (r : ℝ) (L : ℕ) (hr : 0 ≤ r) (hr1 : r ≤ 1) :
    centralPositive r L ≤ L ∧
      0 ≤ ((1 + r) / 2) * (L : ℝ) - centralPositive r L ∧
      ((1 + r) / 2) * (L : ℝ) - centralPositive r L < 1 ∧
      (centralNegative r L : ℝ) = (L : ℝ) - centralPositive r L := by
  have ha : 0 ≤ ((1 + r) / 2) * (L : ℝ) := by positivity
  have hk : centralPositive r L ≤ L := by
    apply Nat.floor_le_of_le
    nlinarith [show (0 : ℝ) ≤ L from Nat.cast_nonneg L]
  refine ⟨hk, sub_nonneg.mpr (Nat.floor_le ha), ?_, ?_⟩
  · have h : ((1 + r) / 2) * (L : ℝ) < (⌊((1 + r) / 2) * (L : ℝ)⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one _
    change ((1 + r) / 2) * (L : ℝ) - ⌊((1 + r) / 2) * (L : ℝ)⌋₊ < 1; linarith
  · exact Nat.cast_sub hk
/-- The original score is the information rate times scale minus a bounded error. -/
theorem center_rounding (r : ℝ) (L : ℕ) (hr : 0 ≤ r) (hr1 : r < 1) :
    phi r * (L : ℝ) - Real.log ((1 + r) / (1 - r)) ≤ center r L ∧
      center r L ≤ phi r * (L : ℝ) := by
  obtain ⟨hk, hx0, hx1, hl⟩ := central_rounding r L hr hr1.le
  have hp : 0 < 1 + r := by linarith
  have hm : 0 < 1 - r := by linarith
  have hc : 0 ≤ Real.log (1 + r) - Real.log (1 - r) := sub_nonneg.mpr (Real.log_le_log hm (by linarith))
  have he : center r L = phi r * (L : ℝ) - (((1 + r) / 2) * (L : ℝ) - centralPositive r L) *
        (Real.log (1 + r) - Real.log (1 - r)) := by
    unfold center phi
    rw [hl]; ring
  rw [he, Real.log_div hp.ne' hm.ne']
  constructor <;> nlinarith
/-- The base-two floor costs at most one factor of two. -/
theorem population_exponential_bounds (r β : ℝ) (L : ℕ)
    (hφ : 0 ≤ phi r) (hβ : 0 < β) :
    Real.exp (phi r / β * (L : ℝ)) / 2 ≤ (population r β L : ℝ) ∧
      (population r β L : ℝ) ≤ Real.exp (phi r / β * (L : ℝ)) := by
  let t := phi r * (L : ℝ) / (β * Real.log 2)
  have hlog : 0 < Real.log (2 : ℝ) := Real.log_pos (by norm_num)
  have ht : 0 ≤ t := by dsimp [t]; positivity
  have hm : 0 < (population r β L : ℝ) := by unfold population; positivity
  have he : Real.log (population r β L : ℝ) = (⌊t⌋₊ : ℝ) * Real.log 2 := by simp [population, t, Real.log_pow]
  have hlo := mul_le_mul_of_nonneg_right (Nat.floor_le ht) hlog.le
  have hhi := mul_lt_mul_of_pos_right (Nat.lt_floor_add_one t) hlog
  have hrate : t * Real.log 2 = phi r / β * (L : ℝ) := by
    dsimp [t]
    field_simp
  rw [← he, hrate] at hlo
  have hlower : phi r / β * (L : ℝ) - Real.log 2 ≤
      Real.log (population r β L : ℝ) := by
    rw [add_mul, one_mul, ← he, hrate] at hhi; linarith
  constructor
  · have h := Real.exp_le_exp.mpr hlower
    simpa [Real.exp_sub, Real.exp_log hm, Real.exp_log (by norm_num : (0 : ℝ) < 2)] using h
  · simpa only [Real.exp_log hm] using Real.exp_le_exp.mpr hlo
/-- The fixed nonzero signal amplitude gives a strictly positive information rate. -/
theorem information_rate_bounds (r : ℝ) (hr : 0 < r) (hr1 : r < 1) :
    0 < phi r ∧ phi r < Real.log 2 := by
  have hp : 0 < 1 + r := by linarith
  have hm : 0 < 1 - r := by linarith
  have hstrict := Real.strictConvexOn_mul_log.2 hp.le hm.le (show 1 + r ≠ 1 - r by linarith) (by norm_num : (0 : ℝ) < 1/2)
    (by norm_num : (0 : ℝ) < 1/2) (by norm_num : (1/2 : ℝ) + 1/2 = 1)
  have he : (1/2 : ℝ) • (1+r) + (1/2 : ℝ) • (1-r) = 1 := by simp only [smul_eq_mul]; ring
  rw [he] at hstrict
  dsimp only at hstrict; simp only [Real.log_one, mul_zero, smul_eq_mul] at hstrict
  have hlp : Real.log (1+r) < Real.log 2 := Real.log_lt_log hp (by linarith)
  have hlm : Real.log (1-r) < Real.log 2 := Real.log_lt_log hm (by linarith)
  have h1 := mul_lt_mul_of_pos_left hlp hp
  have h2 := mul_lt_mul_of_pos_left hlm hm
  unfold phi
  constructor <;> nlinarith
end
end D5.S3.Estimation.TimeArrow.NativeGrowthRounding
namespace D5.S3.Estimation.TimeArrow.NativeRectangleReferenceRatios
noncomputable section
theorem original_count_rounding (r : ℝ) (L : ℕ) (hr : 0 < r) (hr1 : r < 1)
    (hL : 1 ≤ L) (hplus : 15 ≤ ((1+r)/2)*(L : ℝ))
    (hminus : 30 ≤ ((1-r)/2)*(L : ℝ)) :
    let k := ⌊((1+r)/2)*(L : ℝ)⌋₊
    let l := L-k
    k ≤ L ∧ 0 < k ∧ 0 < l ∧
      15/16 ≤ ((L : ℝ)*(1+r)/2/(k+1)) ∧ ((L : ℝ)*(1+r)/2/(k+1)) ≤ 1 ∧
      15/16 ≤ ((L : ℝ)*(1-r)/2/(l+1)) ∧ ((L : ℝ)*(1-r)/2/(l+1)) ≤ 1 := by
  let k := ⌊((1+r)/2)*(L : ℝ)⌋₊
  let l := L-k
  have ha0 : 0 ≤ ((1+r)/2)*(L : ℝ) := by positivity
  have hklo := Nat.floor_le ha0
  have hkhi := Nat.lt_floor_add_one (((1+r)/2)*(L : ℝ))
  change (k : ℝ) ≤ _ at hklo
  change _ < (k : ℝ)+1 at hkhi
  have hkL : k ≤ L := by
    apply Nat.floor_le_of_le
    nlinarith only [hr1, show (0 : ℝ) ≤ L by positivity]
  have hlr : (l : ℝ) = (L : ℝ)-k := by exact Nat.cast_sub hkL
  have hkp : 0 < k := by
    have hh : (0 : ℝ) < k := by linarith only [hplus,hkhi]
    exact_mod_cast hh
  have hlp : 0 < l := by
    have hh : (0 : ℝ) < l := by rw [hlr]; linarith only [hminus,hklo]
    exact_mod_cast hh
  refine ⟨hkL,hkp,hlp,?_,?_,?_,?_⟩
  · apply (le_div_iff₀ (by positivity : (0 : ℝ) < k+1)).mpr
    nlinarith only [hplus,hklo]
  · apply (div_le_iff₀ (by positivity : (0 : ℝ) < k+1)).mpr
    linarith only [hkhi]
  · apply (le_div_iff₀ (by positivity : (0 : ℝ) < l+1)).mpr
    rw [hlr]; nlinarith only [hminus,hkhi]
  · apply (div_le_iff₀ (by positivity : (0 : ℝ) < l+1)).mpr
    rw [hlr]; nlinarith only [hklo]
end
end D5.S3.Estimation.TimeArrow.NativeRectangleReferenceRatios
