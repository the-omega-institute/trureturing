/- GID: D5/S3/Estimation/TimeArrow/NativeSignalConditionalFiber
   generality: G
   mirror-B: D5/B/S3/Estimation/TimeArrow/NativeSignalConditionalFiber
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Collapsing the signal identities preserves native pair and path masses on every complete observation fiber. -/

import D5.S3.Estimation.SequentialDecisionRisk.FiniteSupportSelectionBayes

open scoped BigOperators
open Finset
open D5.S3.Estimation.SequentialDecisionRisk.FiniteSupportSelectionBayes

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Estimation.TimeArrow.NativeSignalConditionalFiber
noncomputable section

/-- The signal symbol is `none`; every other vertex retains its identity. -/
def collapseVertex {M q : ℕ} (S : Support M q) : Vertex M → Option (Vertex M)
  | .inl i => if i ∈ S.val then none else some (.inl i)
  | .inr i => some (.inr i)

/-- Pair observations have two sites per edge; path observations retain every
vertex, including the terminal vertex. -/
def Sites (s : ℕ) : Experiment → Type
  | .pair => Fin s × Bool
  | .path => Fin (s + 1)

/-- The complete observation, represented by its vertex sites. -/
def siteEquiv (M s : ℕ) (e : Experiment) : Obs M s e ≃ (Sites s e → Vertex M) :=
  match e with
  | .pair =>
    { toFun := fun o k => if k.2 then (o k.1).2 else (o k.1).1
      invFun := fun f k => (f (k, false), f (k, true))
      left_inv := by intro o; funext k; rfl
      right_inv := by intro f; funext k; rcases k with ⟨k, b⟩; cases b <;> rfl }
  | .path => Equiv.refl _

/-- The conditioning readout contains the entire collapsed history. -/
def collapsedObs {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) : Sites s e → Option (Vertex M) :=
  fun k => collapseVertex S (siteEquiv M s e o k)

/-- Exactly the sigma-algebra generated by the complete collapsed history. -/
def collapsedSigma {M q s : ℕ} (S : Support M q) (e : Experiment) :
    MeasurableSpace (Obs M s e) :=
  MeasurableSpace.comap (collapsedObs S e) ⊤

/-- The original finite histories with the same collapsed readout. -/
def Fiber {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e) :=
  {o' : Obs M s e // collapsedObs S e o' = collapsedObs S e o}

/-- The positions at which the signal identity was erased. -/
def SignalSites {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e) :=
  {k : Sites s e // collapsedObs S e o k = none}

private theorem collapseVertex_eq_none {M q : ℕ} (S : Support M q) (x : Vertex M) :
    collapseVertex S x = none ↔ ∃ i ∈ S.val, x = Sum.inl i := by
  classical
  cases x with
  | inl i => simp [collapseVertex]
  | inr i => simp [collapseVertex]

/-- An erased vertex is exactly a freely chosen member of the true support. -/
def signalVertexEquiv {M q : ℕ} (S : Support M q) :
    {x : Vertex M // collapseVertex S x = none} ≃ {i : Fin M // i ∈ S.val} := by
  classical
  refine (Equiv.ofBijective
    (fun i : {i : Fin M // i ∈ S.val} =>
      (⟨Sum.inl i.val, by simp [collapseVertex, i.property]⟩ :
        {x : Vertex M // collapseVertex S x = none})) ?_).symm
  constructor
  · intro i j h
    exact Subtype.ext (Sum.inl.inj (congrArg Subtype.val h))
  · intro x
    rcases (collapseVertex_eq_none S x.val).mp x.property with ⟨i, hi, hx⟩
    exact ⟨⟨i, hi⟩, Subtype.ext hx.symm⟩

private theorem collapseVertex_preserves {M q : ℕ} (S : Support M q)
    (r : ℝ) {x y : Vertex M} (h : collapseVertex S x = collapseVertex S y) :
    b r S x = b r S y ∧ chi x = chi y := by
  classical
  cases x with
  | inl i =>
    cases y with
    | inl j =>
      by_cases hi : i ∈ S.val <;> by_cases hj : j ∈ S.val
      · simp [b, chi, hi, hj]
      · simp [collapseVertex, hi, hj] at h
      · simp [collapseVertex, hi, hj] at h
      · have hij : i = j := by simpa [collapseVertex, hi, hj] using h
        subst j; exact ⟨rfl, rfl⟩
    | inr j => by_cases hi : i ∈ S.val <;> simp [collapseVertex, hi] at h
  | inr i =>
    cases y with
    | inl j => by_cases hj : j ∈ S.val <;> simp [collapseVertex, hj] at h
    | inr j => simp [b, chi]

private theorem collapseVertex_injective_off_signal {M q : ℕ} (S : Support M q)
    {x y : Vertex M} (hy : collapseVertex S y ≠ none)
    (h : collapseVertex S x = collapseVertex S y) : x = y := by
  classical
  cases x with
  | inl i =>
    cases y with
    | inl j =>
      have hj : j ∉ S.val := by simpa [collapseVertex] using hy
      have hi : i ∉ S.val := by
        intro hi
        exact hy (h.symm.trans (by simp [collapseVertex, hi]))
      simpa [collapseVertex, hi, hj] using h
    | inr j => by_cases hi : i ∈ S.val <;> simp [collapseVertex, hi] at h
  | inr i =>
    cases y with
    | inl j =>
      have hj : j ∉ S.val := by simpa [collapseVertex] using hy
      simp [collapseVertex, hj] at h
    | inr j => simpa [collapseVertex] using h

private theorem vertex_fiber_card {M q : ℕ} (S : Support M q) (y : Vertex M) :
    Nat.card {x : Vertex M // collapseVertex S x = collapseVertex S y} =
      if collapseVertex S y = none then q else 1 := by
  classical
  by_cases hy : collapseVertex S y = none
  · simp only [hy, if_true]
    rw [Nat.card_congr (signalVertexEquiv S)]
    simpa only [Nat.card_eq_fintype_card, Fintype.card_coe] using S.property
  · simp only [hy, if_false]
    apply Nat.card_eq_one_iff_exists.mpr
    refine ⟨⟨y, rfl⟩, fun x => Subtype.ext ?_⟩
    exact collapseVertex_injective_off_signal S hy x.property

private theorem same_fiber_probability {M q s : ℕ} (S : Support M q)
    (r : ℝ) (e : Experiment) (o o' : Obs M s e)
    (h : collapsedObs S e o' = collapsedObs S e o) :
    probability r e S o' = probability r e S o := by
  classical
  have hs (k : Sites s e) :=
    collapseVertex_preserves S r (congrFun h k)
  cases e with
  | pair =>
    apply Finset.prod_congr rfl
    intro k _
    have hx := (hs (k, false)).1
    have hy := (hs (k, true)).2
    change b r S (o' k).1 = b r S (o k).1 at hx
    change chi (o' k).2 = chi (o k).2 at hy
    simp only [transition, hx, hy]
  | path =>
    apply congrArg (fun z : ℝ => (2 * (M : ℝ))⁻¹ * z)
    apply Finset.prod_congr rfl
    intro k _
    have hx := (hs k.castSucc).1
    have hy := (hs k.succ).2
    change b r S (o' k.castSucc) = b r S (o k.castSucc) at hx
    change chi (o' k.succ) = chi (o k.succ) at hy
    simp only [transition, hx, hy]

/-- Each complete history fiber is a product of its individual vertex fibers.
No independence assumption is imposed on the path edges. -/
def fiberSiteEquiv {M q s : ℕ} (S : Support M q) (e : Experiment)
    (o : Obs M s e) : Fiber S e o ≃
      ((k : Sites s e) → {x : Vertex M // collapseVertex S x = collapsedObs S e o k}) where
  toFun y k := ⟨siteEquiv M s e y.val k, congrFun y.property k⟩
  invFun f := ⟨(siteEquiv M s e).symm (fun k => (f k).val), by
    funext k
    simp only [collapsedObs, Equiv.apply_symm_apply]
    exact (f k).property⟩
  left_inv y := by
    apply Subtype.ext
    exact (siteEquiv M s e).symm_apply_apply y.val
  right_inv f := by
    funext k
    apply Subtype.ext
    exact congrFun ((siteEquiv M s e).apply_symm_apply (fun k => (f k).val)) k

/-- Finite conditional probability on a positive native history fiber. -/
def conditionalFiberMass {M q s : ℕ} (S : Support M q) (r : ℝ)
    (e : Experiment) (o : Obs M s e) (A : Finset (Fiber S e o)) : ℝ := by
  classical
  letI : Fintype (Fiber S e o) := by unfold Fiber; infer_instance
  exact (∑ y ∈ A, probability r e S y.val) /
    (∑ y : Fiber S e o, probability r e S y.val)

private theorem conditionalFiberMass_eq_card {M q s : ℕ} (S : Support M q)
    (r : ℝ) (e : Experiment) (o : Obs M s e)
    (hp : 0 < probability r e S o) (A : Finset (Fiber S e o)) :
    conditionalFiberMass S r e o A =
      (A.card : ℝ) / Nat.card (Fiber S e o) := by
  classical
  letI : Fintype (Fiber S e o) := by unfold Fiber; infer_instance
  have hy (y : Fiber S e o) : probability r e S y.val = probability r e S o :=
    same_fiber_probability S r e o y.val y.property
  simp only [conditionalFiberMass, hy, sum_const, nsmul_eq_mul, card_univ,
    Nat.card_eq_fintype_card]
  exact mul_div_mul_right _ _ (ne_of_gt hp)

/-- A product of finite allowed sets inside the individual vertex fibers. -/
def siteCylinder {M q s : ℕ} (S : Support M q) (e : Experiment) (o : Obs M s e)
    [Fintype (Sites s e)]
    (A : (k : Sites s e) →
      Finset {x : Vertex M // collapseVertex S x = collapsedObs S e o k}) :
    Finset (Fiber S e o) := by
  classical
  exact (Fintype.piFinset A).map (fiberSiteEquiv S e o).symm.toEmbedding

/-- Every signal position has exactly `q` choices and every un-erased position
has one choice. This includes the terminal path position. -/
private theorem native_conditional_site_sizes {M q s : ℕ} (S : Support M q)
    (e : Experiment) (o : Obs M s e) (k : Sites s e) :
    Nat.card {x : Vertex M // collapseVertex S x = collapsedObs S e o k} =
      if collapsedObs S e o k = none then q else 1 :=
  vertex_fiber_card S (siteEquiv M s e o k)

/-- The exact native conditional probability of every site cylinder factors.
In particular, consecutive erased path vertices remain separate coordinates. -/
theorem native_conditional_site_law {M q s : ℕ} (S : Support M q)
    (r : ℝ) (e : Experiment) (o : Obs M s e) [Fintype (Sites s e)]
    (hq : 1 ≤ q) (hqm : q < M) (hr : 0 < r) (hr1 : r < 1)
    (ha : 0 ≤ compensation M q r) (ha1 : compensation M q r < 1)
    (A : (k : Sites s e) →
      Finset {x : Vertex M // collapseVertex S x = collapsedObs S e o k}) :
    conditionalFiberMass S r e o (siteCylinder S e o A) =
      (∏ k, (A k).card : ℝ) /
      (∏ k, Nat.card {x : Vertex M // collapseVertex S x = collapsedObs S e o k} : ℝ) ∧
    (∀ A : Set (Obs M s e), @MeasurableSet (Obs M s e) (collapsedSigma S e) A ↔
      ∃ B : Set (Sites s e → Option (Vertex M)), (collapsedObs S e) ⁻¹' B = A) ∧
    (∀ k : Sites s e,
      Nat.card {x : Vertex M // collapseVertex S x = collapsedObs S e o k} =
        if collapsedObs S e o k = none then q else 1) := by
  classical
  refine ⟨?_, ?_, native_conditional_site_sizes S e o⟩
  swap
  · intro A
    exact ⟨fun ⟨B, _, hB⟩ => ⟨B, hB⟩,
      fun ⟨B, hB⟩ => ⟨B, MeasurableSpace.measurableSet_top, hB⟩⟩
  letI : Fintype (Fiber S e o) := by unfold Fiber; infer_instance
  letI (k : Sites s e) :
      Fintype {x : Vertex M // collapseVertex S x = collapsedObs S e o k} :=
    Fintype.ofFinite _
  have hp := ((finite_support_bayes (s := s) hq hqm hr hr1 ha ha1 e).2.2.1 S o).1
  rw [conditionalFiberMass_eq_card S r e o hp]
  have hc := Fintype.card_congr (fiberSiteEquiv S e o)
  simp only [siteCylinder, card_map, Fintype.card_piFinset, Nat.cast_prod]
  simp only [Nat.card_eq_fintype_card, hc, Fintype.card_pi, Nat.cast_prod]

def departureSite (s : ℕ) (e : Experiment) (k : Fin s) : Sites s e :=
  match e with
  | .pair => (k, false)
  | .path => k.castSucc

def successorSite (s : ℕ) (e : Experiment) (k : Fin s) : Sites s e :=
  match e with
  | .pair => (k, true)
  | .path => k.succ

/-- The two departure counts use actual departure labels and successor signs
fixed by the very same complete collapsed-history fiber. -/
theorem native_fiber_departure_counts {M q s : ℕ} (S : Support M q)
    (e : Experiment) (o : Obs M s e) (y : Fiber S e o) (i : Fin M) (z : ℝ) :
    count e y.val i z =
      (Finset.univ.filter fun k : Fin s =>
        siteEquiv M s e y.val (departureSite s e k) = Sum.inl i ∧
          chi (siteEquiv M s e o (successorSite s e k)) = z).card := by
  classical
  apply congrArg Finset.card
  ext k
  have hchi := (collapseVertex_preserves S 0
    (congrFun y.property (successorSite s e k))).2
  cases e with
  | pair =>
    change chi (y.val k).2 = chi (o k).2 at hchi
    change k ∈ (univ.filter fun a =>
      (y.val a).1 = Sum.inl i ∧ chi (y.val a).2 = z) ↔
      k ∈ (univ.filter fun a => (y.val a).1 = Sum.inl i ∧ chi (o a).2 = z)
    simp only [mem_filter, mem_univ, true_and, hchi]
  | path =>
    change chi (y.val k.succ) = chi (o k.succ) at hchi
    change k ∈ (univ.filter fun a : Fin s =>
      y.val a.castSucc = Sum.inl i ∧ chi (y.val a.succ) = z) ↔
      k ∈ (univ.filter fun a : Fin s => y.val a.castSucc = Sum.inl i ∧ chi (o a.succ) = z)
    simp only [mem_filter, mem_univ, true_and, hchi]

end
end D5.S3.Estimation.TimeArrow.NativeSignalConditionalFiber
