import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic
import Mathlib.MeasureTheory.Integral.Bochner.SumMeasure
import Mathlib.Data.Fin.Tuple.Basic
import Mathlib.Algebra.BigOperators.Group.Finset.Pi
import Mathlib.Probability.Process.Filtration
import Mathlib.Tactic

open MeasureTheory Finset
open scoped BigOperators ENNReal
set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section
namespace D5.S3.Estimation.DataProcessing.FiniteHistoryConditionalExpectation
/-- Recorded observations through time `n`; the hidden state is a separate coordinate. -/
abbrev History (Z : ℕ → Type*) (n : ℕ) := (i : Fin n) → Z i.val

/-- Restriction to the first `t` recorded observations. -/
def readPrefix {Z : ℕ → Type*} {t n : ℕ} (htn : t ≤ n) (w : History Z n) : History Z t :=
  fun i => w (Fin.castLE htn i)

/-- Product of the successive history-dependent observation probabilities at a fixed hidden state. -/
def likelihood {J : Type*} {Z : ℕ → Type*}
    (K : (n : ℕ) → J → History Z n → Z n → ℝ) :
    (n : ℕ) → J → History Z n → ℝ
  | 0, _, _ => 1
  | n+1, j, w =>
      likelihood K n j (Fin.init w) * K n j (Fin.init w) (w (Fin.last n))

variable {J : Type*} {Z : ℕ → Type*} [Fintype J] [∀ n, Fintype (Z n)]

/-- The marginal mass of a recorded history under the initial hidden-state law. -/
def historyMass (ν : J → ℝ) (K : (n : ℕ) → J → History Z n → Z n → ℝ)
    (n : ℕ) (h : History Z n) : ℝ := ∑ j, ν j * likelihood K n j h

variable [MeasurableSpace J] [MeasurableSingletonClass J]
  [∀ n, MeasurableSpace (Z n)] [∀ n, MeasurableSingletonClass (Z n)]

/-- The joint law on a fixed hidden state and a complete finite observation record. -/
def historyLaw (ν : J → ℝ) (K : (n : ℕ) → J → History Z n → Z n → ℝ)
    (N : ℕ) : Measure (J × History Z N) :=
  ∑ ω, ENNReal.ofReal (ν ω.1 * likelihood K N ω.1 ω.2) • Measure.dirac ω

/-- The sigma-algebra generated by the recorded prefix alone. -/
@[instance_reducible]
def historySigma {N : ℕ} (t : ℕ) (ht : t ≤ N) : MeasurableSpace (J × History Z N) :=
  MeasurableSpace.comap (fun ω => readPrefix ht ω.2) inferInstance

/-- The increasing finite-horizon filtration of recorded prefixes. -/
def historyFiltration (N : ℕ) :
    Filtration (Fin (N+1)) (inferInstance : MeasurableSpace (J × History Z N)) where
  seq t := historySigma t.val (Nat.le_of_lt_succ t.isLt)
  mono' := by
    intro s t hst
    exact MeasurableSpace.comap_le_comap_of_eq_comp (readPrefix hst)
      (measurable_of_finite _) rfl
  le' t := (measurable_of_finite
    (fun ω : J × History Z N => readPrefix (Nat.le_of_lt_succ t.isLt) ω.2)).comap_le

/-- Nonnegative normalized adaptive kernels produce a probability law with the stated
joint prefix marginals. Conditioning a next-prefix observable on the recorded history
uses the ratio of child and parent history masses. At null histories the displayed
scalar is zero; no conditional probability on such a history is asserted. -/
theorem history_law_conditional_expectation
    (ν : J → ℝ) (hν : (∀ j, 0 ≤ ν j) ∧ ∑ j, ν j = 1)
    (K : (n : ℕ) → J → History Z n → Z n → ℝ)
    (N : ℕ)
    (hK : ∀ n < N, (∀ j h z, 0 ≤ K n j h z) ∧ ∀ j h, ∑ z, K n j h z = 1) :
    IsProbabilityMeasure (historyLaw ν K N) ∧
    (∀ t (ht : t ≤ N) (f : J → History Z t → ℝ),
      (∫ ω, f ω.1 (readPrefix ht ω.2) ∂historyLaw ν K N) =
        ∑ j, ∑ h, ν j * likelihood K t j h * f j h) ∧
    (∀ t (ht : t < N) (f : History Z (t+1) → ℝ),
      (historyLaw ν K N)[(fun ω => f (readPrefix (Nat.succ_le_of_lt ht) ω.2)) |
          historyFiltration (J := J) (Z := Z) N ⟨t, Nat.lt_succ_of_lt ht⟩] =ᵐ[historyLaw ν K N]
      fun ω => ∑ z, historyMass ν K (t+1) (Fin.snoc (readPrefix (Nat.le_of_lt ht) ω.2) z) /
          historyMass ν K t (readPrefix (Nat.le_of_lt ht) ω.2) *
          f (Fin.snoc (readPrefix (Nat.le_of_lt ht) ω.2) z)) := by
  classical
  have marginal (n : ℕ) (hn : n ≤ N) (t : ℕ) (htn : t ≤ n)
      (j : J) (g : History Z t → ℝ) :
      (∑ w : History Z n, likelihood K n j w * g (readPrefix htn w)) =
        ∑ h : History Z t, likelihood K t j h * g h := by
    induction n, htn using Nat.le_induction with
    | base => rfl
    | succ n htn ih =>
      have hp (z : Z n) (h : History Z n) :
          readPrefix (Nat.le.step htn) (Fin.snoc h z) = readPrefix htn h := by
        funext i
        exact @Fin.snoc_castSucc n (fun i : Fin (n+1) => Z i.val) z h (Fin.castLE htn i)
      rw [← (Fin.snocEquiv (fun i : Fin (n+1) => Z i.val)).sum_comp, Fintype.sum_prod_type]
      simp only [Fin.snocEquiv, Equiv.coe_fn_mk, likelihood, Fin.init_snoc, Fin.snoc_last]
      simp_rw [hp]
      rw [Finset.sum_comm]
      simp only [mul_assoc]
      simp_rw [mul_comm (K n _ _ _) (g _), ← mul_assoc, ← Finset.mul_sum]
      calc
        _ = ∑ x : History Z n, likelihood K n j x * g (readPrefix htn x) := by
          apply Finset.sum_congr rfl
          intro x hx
          change likelihood K n j x * g (readPrefix htn x) * (∑ z : Z n, K n j x z) = _
          rw [(hK n (lt_of_lt_of_le (Nat.lt_succ_self n) hn)).2 j x, mul_one]
        _ = _ := ih (Nat.le_trans (Nat.le_succ n) hn)
  have ln (n : ℕ) (hn : n ≤ N) (j : J) (w : History Z n) : 0 ≤ likelihood K n j w := by
    induction n with
    | zero => exact zero_le_one
    | succ n ih =>
      exact mul_nonneg (ih (Nat.le_trans (Nat.le_succ n) hn) (Fin.init w))
        ((hK n (lt_of_lt_of_le (Nat.lt_succ_self n) hn)).1 _ _ _)
  have mn (n : ℕ) (hn : n ≤ N) (h : History Z n) : 0 ≤ historyMass ν K n h :=
    Finset.sum_nonneg fun j _ => mul_nonneg (hν.1 j) (ln n hn j h)
  have total (j : J) : ∑ w : History Z N, likelihood K N j w = 1 := by
    simpa [likelihood] using marginal N le_rfl 0 (Nat.zero_le N) j (fun _ => 1)
  let μ := historyLaw ν K N
  have atom (ω : J × History Z N) : μ {ω} = ENNReal.ofReal (ν ω.1 * likelihood K N ω.1 ω.2) := by
    simp [μ, historyLaw, Measure.coe_finsetSum, Pi.single_apply]
  have hμ : IsProbabilityMeasure μ := by
    constructor
    simp only [μ, historyLaw, Measure.coe_finsetSum, Finset.sum_apply, Measure.smul_apply,
      Measure.dirac_apply_of_mem (Set.mem_univ _), smul_eq_mul, mul_one]
    rw [← ENNReal.ofReal_sum_of_nonneg (fun ω _ => mul_nonneg (hν.1 ω.1) (ln N le_rfl ω.1 ω.2))]
    rw [Fintype.sum_prod_type]
    simp_rw [← Finset.mul_sum, total, mul_one]
    rw [hν.2, ENNReal.ofReal_one]
  let : IsProbabilityMeasure μ := hμ
  have integral (f : J × History Z N → ℝ) :
      (∫ ω, f ω ∂μ) = ∑ ω, (ν ω.1 * likelihood K N ω.1 ω.2) * f ω := by
    rw [integral_fintype Integrable.of_finite]
    simp only [Measure.real, atom,
      ENNReal.toReal_ofReal (mul_nonneg (hν.1 _) (ln N le_rfl _ _)), smul_eq_mul]
  have jointIntegral (t : ℕ) (ht : t ≤ N) (f : J → History Z t → ℝ) :
      (∫ ω, f ω.1 (readPrefix ht ω.2) ∂μ) =
        ∑ j, ∑ h, ν j * likelihood K t j h * f j h := by
    rw [integral, Fintype.sum_prod_type]
    simp_rw [mul_assoc, ← Finset.mul_sum, marginal N le_rfl t ht]
  have marginalIntegral (t : ℕ) (ht : t ≤ N) (f : History Z t → ℝ) :
      (∫ ω, f (readPrefix ht ω.2) ∂μ) = ∑ h, historyMass ν K t h * f h := by
    rw [jointIntegral t ht (fun _ h => f h), Finset.sum_comm]
    simp only [historyMass, Finset.sum_mul]
  refine ⟨hμ, jointIntegral, ?_⟩
  intro t ht f
  have nextMass (h : History Z t) :
      (∑ z, historyMass ν K (t+1) (Fin.snoc h z)) = historyMass ν K t h := by
    simp only [historyMass, likelihood, Fin.init_snoc, Fin.snoc_last]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j hj
    simp_rw [← mul_assoc, ← Finset.mul_sum]
    change ν j * likelihood K t j h * (∑ z : Z t, K t j h z) = _
    rw [(hK t ht).2 j h, mul_one]
  let g (h : History Z t) : ℝ :=
    ∑ z, historyMass ν K (t+1) (Fin.snoc h z) / historyMass ν K t h * f (Fin.snoc h z)
  have balance (h : History Z t) :
      historyMass ν K t h * g h = ∑ z, historyMass ν K (t+1) (Fin.snoc h z) * f (Fin.snoc h z) := by
    dsimp [g]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro z hz
    by_cases hm : historyMass ν K t h = 0
    · have hz0 : historyMass ν K (t+1) (Fin.snoc h z) = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg (fun z _ => mn (t+1) (Nat.succ_le_of_lt ht) _)).mp
          ((nextMass h).trans hm) z (Finset.mem_univ z)
      simp [hm, hz0]
    · field_simp
  have hm : historySigma (J := J) (Z := Z) t (Nat.le_of_lt ht) ≤ (inferInstance : MeasurableSpace (J × History Z N)) :=
    (measurable_of_finite (fun ω : J × History Z N => readPrefix (Nat.le_of_lt ht) ω.2)).comap_le
  change μ[(fun ω => f (readPrefix (Nat.succ_le_of_lt ht) ω.2)) | historySigma t (Nat.le_of_lt ht)]
    =ᵐ[μ] fun ω => g (readPrefix (Nat.le_of_lt ht) ω.2)
  symm
  apply ae_eq_condExp_of_forall_setIntegral_eq hm Integrable.of_finite
  · intro s hs hms
    exact Integrable.of_finite
  · intro s hs hms
    have hsm := hm s hs
    obtain ⟨S, hS, rfl⟩ := hs
    rw [← integral_indicator hsm, ← integral_indicator hsm]
    change (∫ ω, S.indicator g (readPrefix (Nat.le_of_lt ht) ω.2) ∂μ) = _
    rw [marginalIntegral]
    change _ = (∫ ω, (fun w : History Z (t+1) =>
      if Fin.init w ∈ S then f w else 0) (readPrefix (Nat.succ_le_of_lt ht) ω.2) ∂μ)
    rw [marginalIntegral (t+1) (Nat.succ_le_of_lt ht) (fun w => if Fin.init w ∈ S then f w else 0)]
    rw [← (Fin.snocEquiv (fun i : Fin (t+1) => Z i.val)).sum_comp, Fintype.sum_prod_type]
    simp only [Fin.snocEquiv, Equiv.coe_fn_mk, Fin.init_snoc]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro h hh
    by_cases hhS : h ∈ S
    · simpa [hhS] using balance h
    · simp [hhS]
  · exact StronglyMeasurable.aestronglyMeasurable
      (((measurable_of_finite g).comp (comap_measurable _)).stronglyMeasurable)

#print axioms history_law_conditional_expectation
end D5.S3.Estimation.DataProcessing.FiniteHistoryConditionalExpectation
