import D5.S3.Zeros.NicaCovariance.DoubleCommutation
import Mathlib.Data.PNat.Prime

/-!
# Quasi-lattice order of the arithmetic shift

## Audit trail and scope

The private helper `encoding_normalizedTableAdd` locally re-proves the multiplicativity of
`primeAxisEncoding` under `normalizedTableAdd`; SL-008 freezes `PrimeAxisEncoding`, so
de-privatizing the corresponding fact is forbidden and the local re-proof preserves that
boundary. The same boundary is already documented in `ShiftRangeProjection`,
`BackwardShiftAdjoint` and `DoubleCommutation`.

This module upgrades the coprime fragment recorded in `SemigroupRelations` and
`DoubleCommutation` to the actual quasi-lattice order carried by divisibility of prime-axis
addresses: the join is the lcm, the meet is the gcd, and the frozen coprime statements are
recovered as the specializations at a trivial meet.

Not covered here: the universal property of the Nica-Toeplitz algebra generated by these
relations, and the amenability or faithfulness of this representation.
-/

namespace D5.S3.Zeros.NicaCovariance.QuasiLatticeOrder

open D5.S1.Digit
open D5.S3.Weil.SpectralHilbert
open D5.S3.Zeros.SpectralShift
open D5.S3.Zeros.ShiftOperators.BackwardShiftOperator
open D5.S3.Zeros.ShiftOperators.ShiftRangeProjection
open D5.S3.Zeros.ShiftOperators.BackwardShiftAdjoint

noncomputable local instance : DecidableEq PrimeAxisTable := Classical.decEq _

/-- The join of two prime-axis addresses in the divisibility order: their lcm. -/
noncomputable def tableSup (u v : PrimeAxisTable) : PrimeAxisTable :=
  primeAxisEncoding.symm (PNat.lcm (primeAxisEncoding u) (primeAxisEncoding v))

/-- The meet of two prime-axis addresses in the divisibility order: their gcd. -/
noncomputable def tableInf (u v : PrimeAxisTable) : PrimeAxisTable :=
  primeAxisEncoding.symm (PNat.gcd (primeAxisEncoding u) (primeAxisEncoding v))

theorem encoding_tableSup (u v : PrimeAxisTable) :
    primeAxisEncoding (tableSup u v) =
      PNat.lcm (primeAxisEncoding u) (primeAxisEncoding v) :=
  Equiv.apply_symm_apply _ _

theorem encoding_tableInf (u v : PrimeAxisTable) :
    primeAxisEncoding (tableInf u v) =
      PNat.gcd (primeAxisEncoding u) (primeAxisEncoding v) :=
  Equiv.apply_symm_apply _ _

private theorem encoding_normalizedTableAdd (a u : PrimeAxisTable) :
    primeAxisEncoding (normalizedTableAdd a u) =
      primeAxisEncoding a * primeAxisEncoding u := by
  simp [normalizedTableAdd]

/-- The join is the least common upper bound for divisibility of addresses. -/
theorem tableSup_dvd_iff (u v b : PrimeAxisTable) :
    primeAxisEncoding (tableSup u v) ∣ primeAxisEncoding b ↔
      primeAxisEncoding u ∣ primeAxisEncoding b ∧
        primeAxisEncoding v ∣ primeAxisEncoding b := by
  rw [encoding_tableSup]
  refine ⟨fun h => ⟨(PNat.dvd_lcm_left _ _).trans h, (PNat.dvd_lcm_right _ _).trans h⟩,
    fun h => PNat.lcm_dvd h.1 h.2⟩

theorem tableSup_comm (u v : PrimeAxisTable) : tableSup u v = tableSup v u := by
  apply primeAxisEncoding.injective
  simp only [encoding_tableSup]
  exact Subtype.ext (Nat.lcm_comm _ _)

/-- Full Nica covariance: the shift-range projections multiply to the join projection. -/
theorem shift_range_projection_comp (u v : PrimeAxisTable) :
    (shiftRangeProjection u).comp (shiftRangeProjection v) =
      shiftRangeProjection (tableSup u v) := by
  apply ContinuousLinearMap.ext
  intro x
  apply lp.ext
  funext b
  change shiftRangeProjection u (shiftRangeProjection v x) b =
    shiftRangeProjection (tableSup u v) x b
  rw [shiftRangeProjection_apply, shiftRangeProjection_apply,
    shiftRangeProjection_apply]
  by_cases hu : primeAxisEncoding u ∣ primeAxisEncoding b <;>
    by_cases hv : primeAxisEncoding v ∣ primeAxisEncoding b <;>
      simp [hu, hv, tableSup_dvd_iff u v b]


/-- At a trivial meet the join is the product address, so the frozen coprime Nica relation
is the specialization of the quasi-lattice relation. -/
theorem tableSup_eq_normalizedTableAdd_of_coprime {u v : PrimeAxisTable}
    (hcop : Nat.Coprime (primeAxisEncoding u) (primeAxisEncoding v)) :
    tableSup u v = normalizedTableAdd u v := by
  apply primeAxisEncoding.injective
  rw [encoding_tableSup, encoding_normalizedTableAdd]
  exact Subtype.ext hcop.lcm_eq_mul

/-- The shift-range projections form a commuting family. -/
theorem shift_range_projection_commute (u v : PrimeAxisTable) :
    (shiftRangeProjection u).comp (shiftRangeProjection v) =
      (shiftRangeProjection v).comp (shiftRangeProjection u) := by
  rw [shift_range_projection_comp, shift_range_projection_comp, tableSup_comm]

/-- The divisible subspaces meet at the join address. -/
theorem divisibleSubspace_inf (u v : PrimeAxisTable) :
    divisibleSubspace u ⊓ divisibleSubspace v = divisibleSubspace (tableSup u v) := by
  ext x
  simp only [Submodule.mem_inf, mem_divisibleSubspace]
  constructor
  · rintro ⟨hu, hv⟩ b hb
    rw [tableSup_dvd_iff] at hb
    rcases not_and_or.mp hb with hbu | hbv
    · exact hu b hbu
    · exact hv b hbv
  · intro huv
    refine ⟨fun b hbu => huv b fun hb => hbu ((tableSup_dvd_iff u v b).1 hb).1,
      fun b hbv => huv b fun hb => hbv ((tableSup_dvd_iff u v b).1 hb).2⟩

/-- Inclusion of divisible subspaces is exactly reverse divisibility of addresses. -/
theorem divisibleSubspace_le_iff (u v : PrimeAxisTable) :
    divisibleSubspace u ≤ divisibleSubspace v ↔
      primeAxisEncoding v ∣ primeAxisEncoding u := by
  constructor
  · intro hle
    by_contra hnd
    have hmem : (lp.single 2 u (1 : ℂ) : ZetaHilbertSpace) ∈ divisibleSubspace u := by
      rw [mem_divisibleSubspace]
      intro b hb
      have hbu : b ≠ u := by
        rintro rfl
        exact hb dvd_rfl
      exact lp.single_apply_ne (E := fun _ : PrimeAxisTable => ℂ) 2 u (1 : ℂ) hbu
    have := (mem_divisibleSubspace.1 (hle hmem)) u hnd
    rw [lp.single_apply_self] at this
    exact one_ne_zero this
  · intro hdvd x hx
    rw [mem_divisibleSubspace] at hx ⊢
    intro b hb
    exact hx b fun h => hb (hdvd.trans h)

section GcdCommutation

variable (u v : PrimeAxisTable)

private theorem inf_dvd_left : primeAxisEncoding (tableInf u v) ∣ primeAxisEncoding u := by
  rw [encoding_tableInf]
  exact PNat.gcd_dvd_left _ _

private theorem inf_dvd_right : primeAxisEncoding (tableInf u v) ∣ primeAxisEncoding v := by
  rw [encoding_tableInf]
  exact PNat.gcd_dvd_right _ _

private theorem quotient_encoding_left :
    primeAxisEncoding u =
      primeAxisEncoding (normalizedTableSub u (tableInf u v)) *
        primeAxisEncoding (tableInf u v) := by
  conv_lhs => rw [← normalizedTableSub_add_cancel (inf_dvd_left u v)]
  exact encoding_normalizedTableAdd _ _

private theorem quotient_encoding_right :
    primeAxisEncoding v =
      primeAxisEncoding (normalizedTableSub v (tableInf u v)) *
        primeAxisEncoding (tableInf u v) := by
  conv_lhs => rw [← normalizedTableSub_add_cancel (inf_dvd_right u v)]
  exact encoding_normalizedTableAdd _ _

/-- Dividing out the meet makes the two addresses coprime. -/
theorem coprime_quotients :
    Nat.Coprime (primeAxisEncoding (normalizedTableSub u (tableInf u v)) : ℕ)
      (primeAxisEncoding (normalizedTableSub v (tableInf u v)) : ℕ) := by
  set d : ℕ := ((primeAxisEncoding (tableInf u v) : ℕ+) : ℕ) with hd
  set a : ℕ := ((primeAxisEncoding (normalizedTableSub u (tableInf u v)) : ℕ+) : ℕ) with ha
  set b : ℕ := ((primeAxisEncoding (normalizedTableSub v (tableInf u v)) : ℕ+) : ℕ) with hb
  have hdpos : 0 < d := (primeAxisEncoding (tableInf u v)).pos
  have hu : ((primeAxisEncoding u : ℕ+) : ℕ) = a * d := by
    rw [ha, hd, ← PNat.mul_coe, ← quotient_encoding_left u v]
  have hv : ((primeAxisEncoding v : ℕ+) : ℕ) = b * d := by
    rw [hb, hd, ← PNat.mul_coe, ← quotient_encoding_right u v]
  have hgcd : d = Nat.gcd a b * d := by
    calc
      d = Nat.gcd ((primeAxisEncoding u : ℕ+) : ℕ) ((primeAxisEncoding v : ℕ+) : ℕ) := by
        rw [hd, encoding_tableInf]; rfl
      _ = Nat.gcd (a * d) (b * d) := by rw [hu, hv]
      _ = Nat.gcd a b * d := Nat.gcd_mul_right _ _ _
  have : 1 * d = Nat.gcd a b * d := by rw [one_mul]; exact hgcd
  exact (Nat.eq_of_mul_eq_mul_right hdpos this).symm

/-- The general Toeplitz commutation relation for the arithmetic shift: the backward
shift by `u` and the forward translation by `v` exchange after dividing out the meet. -/
theorem backward_shift_comp_forward_translation :
    (backwardShiftCLM u).comp (forwardTranslationCLM v) =
      (forwardTranslationCLM (normalizedTableSub v (tableInf u v))).comp
        (backwardShiftCLM (normalizedTableSub u (tableInf u v))) := by
  set d := tableInf u v with hd
  set u' := normalizedTableSub u d with hu'def
  set v' := normalizedTableSub v d with hv'def
  have hcop : Nat.Coprime (primeAxisEncoding u' : ℕ) (primeAxisEncoding v' : ℕ) :=
    coprime_quotients u v
  have heu : primeAxisEncoding u = primeAxisEncoding u' * primeAxisEncoding d :=
    quotient_encoding_left u v
  have hev : primeAxisEncoding v = primeAxisEncoding v' * primeAxisEncoding d :=
    quotient_encoding_right u v
  apply ContinuousLinearMap.ext
  intro x
  apply lp.ext
  funext a
  change forwardTranslationCLM v x (normalizedTableAdd a u) =
    forwardTranslationCLM v' (backwardShiftCLM u' x) a
  by_cases ha : primeAxisEncoding v' ∣ primeAxisEncoding a
  · set c := normalizedTableSub a v' with hcdef
    have hc : normalizedTableAdd c v' = a := normalizedTableSub_add_cancel ha
    have hR : forwardTranslationCLM v' (backwardShiftCLM u' x) a =
        x (normalizedTableAdd c u') := by
      conv_lhs => rw [← hc]
      rw [forward_translation_apply_translate]
      rfl
    have hea : primeAxisEncoding a = primeAxisEncoding c * primeAxisEncoding v' := by
      conv_lhs => rw [← hc]
      exact encoding_normalizedTableAdd _ _
    have hkey : normalizedTableAdd a u =
        normalizedTableAdd (normalizedTableAdd c u') v := by
      apply primeAxisEncoding.injective
      rw [encoding_normalizedTableAdd, encoding_normalizedTableAdd,
        encoding_normalizedTableAdd, hea, heu, hev]
      exact mul_mul_mul_comm _ _ _ _
    rw [hkey, forward_translation_apply_translate, hR]
  · rw [forward_translation_apply_of_not_dvd v' a _ ha]
    refine forward_translation_apply_of_not_dvd v _ x ?_
    intro hdvd
    apply ha
    rw [PNat.dvd_iff] at hdvd ⊢
    rw [encoding_normalizedTableAdd, PNat.mul_coe, heu, PNat.mul_coe, hev,
      PNat.mul_coe] at hdvd
    have hdpos : 0 < ((primeAxisEncoding d : ℕ+) : ℕ) := (primeAxisEncoding d).pos
    have hcancel :
        ((primeAxisEncoding v' : ℕ+) : ℕ) ∣
          ((primeAxisEncoding a : ℕ+) : ℕ) * ((primeAxisEncoding u' : ℕ+) : ℕ) := by
      have hrw :
          ((primeAxisEncoding a : ℕ+) : ℕ) *
              (((primeAxisEncoding u' : ℕ+) : ℕ) * ((primeAxisEncoding d : ℕ+) : ℕ)) =
            (((primeAxisEncoding a : ℕ+) : ℕ) * ((primeAxisEncoding u' : ℕ+) : ℕ)) *
              ((primeAxisEncoding d : ℕ+) : ℕ) := by
        rw [mul_assoc]
      rw [hrw] at hdvd
      exact (Nat.mul_dvd_mul_iff_right hdpos).mp hdvd
    exact (Nat.Coprime.dvd_of_dvd_mul_right hcop.symm hcancel)

end GcdCommutation

/-- Star form: the coisometry and the isometry exchange through the meet. -/
theorem adjoint_forward_translation_comp (u v : PrimeAxisTable) :
    (ContinuousLinearMap.adjoint (forwardTranslationCLM u)).comp
        (forwardTranslationCLM v) =
      (forwardTranslationCLM (normalizedTableSub v (tableInf u v))).comp
        (ContinuousLinearMap.adjoint
          (forwardTranslationCLM (normalizedTableSub u (tableInf u v)))) := by
  rw [adjoint_forwardTranslationCLM, adjoint_forwardTranslationCLM]
  exact backward_shift_comp_forward_translation u v

