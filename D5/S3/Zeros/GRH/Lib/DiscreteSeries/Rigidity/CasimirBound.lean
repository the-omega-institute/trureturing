/-! Part of: Lowest K-type and Casimir value determine a discrete series coefficient; analytic
vectors (known result; see Lib.DiscreteSeries.Rigidity.CasimirGrowth).

This file: Invariant forms, compact Casimir value, words and filtration of a (g,K)-module.
Commutation rules, Casimir invariance and filtration basics for gl_n-modules. Arithmetic of rho,
lowest K-type and gap of a Harish-Chandra parameter. Casimir value on K-highest vectors and
resulting Parthasarathy-type inequality on weights. -/

noncomputable section

section

variable {n} [Fintype n] {M H} [AddCommGroup M] [Module ℂ M] [NormedAddCommGroup H]
  [InnerProductSpace ℂ H] (ρ : GlModule n M) {ε} (l ν : @HCParam n ε) (x)

/-- The inner product of H is invariant, ⟨E_ab v, w⟩ = ε_aε_b⟨v, E_ba w⟩, and the Casimir
operator satisfies Re⟨y, Ωy⟩ ≥ (|λ|² − |ρ|²)‖y‖² for all y. -/
def IsUnitaryCasimirGe (ρ : GlModule n H) := (∀ a b v w, inner ℂ (ρ.E a b v) w = ↑(ε a * ε b) *
  inner ℂ v (ρ.E b a w)) ∧ ∀ y, l.casimirValue * ‖y‖ ^ 2 ≤ (inner ℂ y (ρ.casimirK 1 y)).re

/-- The integer Σ_a ν_a(ν_a + 2ρ_{c,a}) = |ν + ρ_c|² − |ρ_c|², with ρ_c the half sum of the
compact roots that are positive for l. -/
def HCParam.casimirKValue := ∑ a, ν a * (ν a + twoRho l (ε · = ε ·) a)

namespace GlModule

attribute [scoped simp, scoped grind =] Module.End.mem_invtSubmodule_iff_forall_mem_of_mem

/-- The twist of a gl_n-module by an invertible matrix g: X acts as gXg⁻¹ does in the original
module. -/
def adTwist (g : GL n ℂ) :=
  mk (ρ.ρ ∘ₗ .mulLeftRight ℂ (g, ↑g⁻¹)) (by simp [← map_bracket, mul_assoc, map_sub])

/-- For a list of index pairs (a₁,b₁),…,(a_s,b_s), the endomorphism E_{a₁b₁}⋯E_{a_s b_s} of M,
the product taken in list order. -/
def word w := (List.map ρ.E.uncurry w).prod

variable (ε)

/-- The filtration M_s generated by x: M_0 = U(𝔨)x, the least subspace containing x stable under
the E_ab with ε_a = ε_b, and M_{s+1} = M_s + Σ E_ab M_s. -/
def filtration | 0 => sInf {W | x ∈ W ∧ ∀ a b, ε a = ε b → W ∈ (ρ.E a b).invtSubmodule}
               | s + 1 => filtration s ⊔ ⨆ (a) (b), (filtration s).map (ρ.E a b)

open Matrix Finset Submodule SetLike Module
variable {n : _} [Fintype n] {M : _} [AddCommGroup M] [Module ℂ M] {ε : _} {ρ : GlModule n M} {x :
  _} {y s} (hy : y ∈ ρ.filtration ε x s) {a b} {c : ℂ}

lemma map_single_mul_single c d : ρ (single a b 1 * single c d 1) =
  ite (b = c) (ρ.E a d) 0 := by aesop

lemma apply_eq_sum X : ρ X = ∑ a, ∑ b, X a b • ρ.E a b := by
  simp [← map_smul, ← map_sum, ← matrix_eq_sum_single]

lemma apply_apply_eq_swap_add_bracket X Y : ρ X (ρ Y x) =
  ρ Y (ρ X x) + ρ (X * Y - Y * X) x := by simp [map_bracket]

lemma commute_E_sum_E_mul_mul_E (f : _ → _ → ℂ) {D} : ε a = ε b → Commute (ρ.E a b) D →
    Commute (ρ.E a b) (∑ c, ∑ d, f (ε c) (ε d) • (ρ.E c d * D * ρ.E d c)) := by
  simp_all [ρ.apply_apply_eq_swap_add_bracket (single a b _), commute_iff_eq, DFunLike.ext_iff,
    map_single_mul_single, add_assoc, DFunLike.ite_apply, apply_ite (_ : End ..), smul_sub]

lemma commute_E_casimirK : ε a = ε b → Commute (ρ.E a b) (ρ.casimirK ε) := by
  simpa [casimir, sum_filter] using (ρ.commute_E_sum_E_mul_mul_E (diagonal 1) · (.one_right _))

lemma casimirK_one_adTwist g : (ρ.adTwist g).casimirK 1 = ρ.casimirK 1 := by
  simp [casimir, adTwist, E, ρ.apply_eq_sum (_ * _), mul_apply, single, ite_and, smul_smul,
    sum_mul_sum, mul_right_comm _ _ (_ * _)]; conv_lhs => repeat rw [sum_comm_cycle]; enter [2, _]
  simp [mul_left_comm, ← sum_smul, ← mul_sum, ← sum_mul, ← mul_apply]

lemma filtration_mono : Monotone (ρ.filtration ε x) := monotone_nat_of_le_succ (by simp!)

lemma self_mem_filtration : x ∈ ρ.filtration ε x s := filtration_mono bot_le (by simp_all!)

include hy

@[local simp] lemma E_mem_filtration_succ : ρ.E a b y ∈ ρ.filtration ε x (s + 1) :=
  mem_sup_right (by grw [← le_iSup₂]; tauto)

lemma E_mem_filtration (h : ε a = ε b) : ρ.E a b y ∈ ρ.filtration ε x s := by
  induction s generalizing y; grind [filtration, mem_sInf]; apply mem_comap.1 (le_def.1 (sup_le _
    (iSup₂_le _)) hy) <;> simp [le_def, ρ.apply_apply_eq_swap_add_bracket (single a b _),
    map_single_mul_single] <;> aesop

omit hy

lemma casimirK_eq_smul_of_mem_filtration (hy : y ∈ ρ.filtration ε x 0) : ρ.casimirK ε x = c • x →
  ρ.casimirK ε y = c • y := (mem_sInf.1 hy (LinearMap.eqLocus _ (c • 1))
  ⟨·, by simp_all [← End.mul_apply _, ← (commute_E_casimirK ..).eq]⟩)

/-- The submodule U(𝔤)x generated by x: the images of x under the algebra generated by the
operators ρ(X). -/
def generatedBy x := ρ.restrictTo (ρ.filtration 1 x 0) (by
  simp_all [ρ.apply_eq_sum ·, ← sum_product', sum_smul_mem, E_mem_filtration])

lemma casimirK_generatedBy (h : ρ.casimirK 1 x = c • x) y : (ρ.generatedBy x).casimirK 1 y =
  c • y := by ext1; simpa [casimir] using! casimirK_eq_smul_of_mem_filtration y.2 h

end GlModule

open Finset Fintype
variable {n : _} [Fintype n] {ε l : _} {h h'} (hg : @HasGap n _ ε l h) (r) [@DecidableRel n n r] (i)

attribute [grind norm] Pi.top_apply Prop.top_eq_true

attribute [local grind] twoRho HasGap Pi.neg_def

lemma abs_twoRho_le l : |twoRho l r i| ≤ card n := by grind

lemma twoRho_neg l : twoRho (-l) r i = -twoRho l r i := by simp [twoRho]

lemma card_lt_add_card_gt_add_one {l : n → ℤ} (h : l.Injective) i :
    #{j | l j < l i} + #{j | l i < l j} + 1 = card n := by rw [← card_union_of_disjoint,
  ← @card_insert_of_notMem _ _ i, card_eq_iff_eq_univ] <;> grind [disjoint_left]

include hg

lemma two_mul_paramAddRho : 2 * paramAddRho l i =
  l i + twoRho l ⊤ i := by grind [paramAddRho, card_lt_add_card_gt_add_one _ i]

@[local grind .] lemma two_mul_lowestKType : 2 * l.lowestKType i =
  l i + twoRho l (ε · ≠ ε ·) i - twoRho l (ε · = ε ·)
  i := by simp [lowestKType, twoRho, filter_and, filter_not,
  sdiff_inter_right_comm]; grind [two_mul_paramAddRho]

/-- If l = 2λ is a parameter of some gap g for the signs ε and |l_a| ≤ L for all a, then every
entry of Λ = λ+ρ−2ρ_c satisfies |Λ_a| ≤ L + n. -/
lemma abs_lowestKType_le {L : ℕ} (hL : ∀ a, |l a| ≤ L) a : |l.lowestKType a| ≤
  ↑(L + card n) := by grind

lemma HCParam.HasGap.mono : h' ≤ h → l.HasGap h' := by grind

/-- If l is a parameter of gap h for the signs ε, then the same vector is a parameter of gap h
for the compact form. -/
lemma HCParam.HasGap.signs_one : l.compactForm.HasGap h := ⟨hg.1, hg.2, by simp⟩

lemma HCParam.HasGap.neg : (-l).HasGap h := by grind [Function.Injective]

@[simp] lemma lowestKType_neg : (-l).lowestKType = -l.lowestKType := by grind [hg.neg, twoRho_neg]

end

open Finset Complex InnerProductSpace GlModule
variable {n H M} [Fintype n] [NormedAddCommGroup H] [InnerProductSpace ℂ H] {ε ν x g} {l :
  HCParam ε} {ρ : GlModule n H} (h : IsUnitaryCasimirGe l ρ) [AddCommGroup M] [Module ℂ M] {σ :
  GlModule n M} (r) [DecidableRel r]

lemma HCParam.IsKHighest.of_E_eq_smul : (∀ a b, ε a = ε b → l b ≤ l a → σ.E a b x =
  ite (a = b) (ν a : ℂ) 0 • x) → l.IsKHighest σ ν x := by grind [IsKHighest, zero_smul]

lemma GlModule.casimir_eq_diag_add_twoRho_add (hl : l.Injective) (s : Std.Symm r := by tauto) :
  σ.casimir r = 2 * σ.casimir (r ⊓ (l · < l ·)) + σ.casimir (Eq ⊓ r) + ∑ a,
  (twoRho l r a : ℂ) • σ.E a a := sub_eq_zero.1 (by
  simp [casimir, twoRho, sum_filter, ← sum_boole, ← sum_sub_distrib, sub_smul, sum_smul, two_mul,
    ← sum_add_distrib, ← sum_product']
  apply sum_ninvolution .swap <;> grind [map_single_mul_single, (σ.map_bracket · · |>.symm), s.1])

attribute [local simp] HCParam.casimirKValue HCParam.IsKHighest filter_and filter_eq smul_smul
  sum_smul

lemma HCParam.IsKHighest.casimirK_eq_smul [hg : l.HasGap g] (hx : l.IsKHighest σ ν x) : σ.casimirK ε
  x = (l.casimirKValue ν : ℂ) • x := by simp_all [↓casimir_eq_diag_add_twoRho_add (ε · = ε ·) hg.1,
  casimir, sum_eq_zero, mul_add, add_smul, mul_comm]

include h

lemma IsUnitaryCasimirGe.inner_casimir : ⟪x, ρ.casimir r x⟫_ℂ = ∑ a, ∑ b with r a b, (ε a * ε b).1 *
    ‖ρ.E b a x‖ ^ 2 := by simp [casimir, ← inner_conj_symm x, sum_inner, h.1]

/-- Let l = 2λ have some gap and let `IsUnitaryCasimirGe` hold (invariant inner product, Ω ≥ |λ|² −
|ρ|²). If x ≠ 0 is K-highest of weight Λ + ν, then |ν|² + 2⟨ν, λ⟩ ≥ −n³. -/
lemma HCParam.IsKHighest.casimir_bound [hg : l.HasGap g] (hw : l.IsKHighest ρ (l.lowestKType + ν) x)
  (o : x ≠ 0) : 0 ≤ ∑ a, (Fintype.card n ^ 2 + ν a * (ν a + l a)) := by
  obtain ⟨k⟩ := h.2 x, congr(re ⟪x, $(ρ.casimir_eq_diag_add_twoRho_add (ε · ≠ ε ·) hg.neg.1)
    x + $(hw.casimirK_eq_smul)⟫_ℂ)
  simp_all [h.inner_casimir, ← sum_add_distrib, sum_filter_not_add_sum_filter, casimirValue,
    add_assoc, ← ofReal_pow, ← add_mul, two_mul, ← sum_smul]
  grw [sum_nonpos (by simp_all [sum_nonpos, Int.units_ne_iff_eq_neg])] at k
  simp_all [-sum_add_distrib]; rify; grw [sub_nonneg.2 k, ← sum_sub_distrib]; gcongr with a
  field; norm_cast
  grw [(sq_abs _).ge, abs_twoRho_le, twoRho_neg,
    ← sub_eq_iff_comm.1 (two_mul_lowestKType hg _).symm]
  grind [sq_nonneg (l a - 2 * l.lowestKType a)]
