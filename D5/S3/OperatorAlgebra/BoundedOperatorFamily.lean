import OmegaBuild.Commands
import Mathlib.Analysis.CStarAlgebra.ContinuousMap
import Mathlib.Topology.Algebra.StarSubalgebra

/-! Omega original.
The common norm-closed star algebra of uniformly bounded operator families. -/

compile_only_with_mathlib

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace Omega.BoundedOperatorFamily

variable {P S B : Type*} [CStarAlgebra B]

private abbrev Families (P B : Type*) [NormedRing B] :=
  BoundedContinuousFunction (WithDiscreteTopology P) B

variable (U : P → S → B) (hU : ∀ p s, ‖U p s‖ ≤ 1)

private def family (s : S) : Families P B :=
  BoundedContinuousFunction.ofNormedAddCommGroupDiscrete
    (fun p : WithDiscreteTopology P => U (WithTopology.ofTopology p) s) 1
    (fun p => hU (WithTopology.ofTopology p) s)

/-- The common C-star algebra generated by the uniformly bounded families. -/
def operatorFamilyAlgebra : StarSubalgebra ℂ (Families P B) :=
  (StarAlgebra.adjoin ℂ (Set.range (family U hU))).topologicalClosure

instance operatorFamilyAlgebra_cstar : CStarAlgebra (operatorFamilyAlgebra U hU) :=
  letI : IsClosed (operatorFamilyAlgebra U hU : Set (Families P B)) :=
    StarSubalgebra.isClosed_topologicalClosure _
  StarSubalgebra.cstarAlgebra _

/-- A specified generator of the common algebra. -/
def generator (s : S) : operatorFamilyAlgebra U hU :=
  ⟨family U hU s, (StarSubalgebra.le_topologicalClosure _)
    (StarAlgebra.subset_adjoin ℂ _ ⟨s, rfl⟩)⟩

/-- Evaluation in one member of the family is a unital star algebra homomorphism. -/
def evaluate (p : P) : operatorFamilyAlgebra U hU →⋆ₐ[ℂ] B where
  toFun a := a.val (WithTopology.toTopology ⊥ p)
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl
  map_star' _ := rfl

theorem evaluate_generator (p : P) (s : S) :
    evaluate U hU p (generator U hU s) = U p s := rfl

end Omega.BoundedOperatorFamily
