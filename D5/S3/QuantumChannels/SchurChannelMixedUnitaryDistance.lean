def MixedUnitary (d : ℕ) : Set (QuantumChannel (Fin d) (Fin d)) :=
  {Ψ | ∃ (n : ℕ) (p : Fin n → ℝ)
      (U : Fin n → Matrix.unitaryGroup (Fin d) ℂ),
    (∀ k, 0 ≤ p k) ∧ ∑ k, p k = 1 ∧
    ∀ X, act Ψ X = ∑ k, (p k : ℂ) •
      ((U k : Matrix _ _ ℂ) * X * star (U k : Matrix _ _ ℂ))}

def IsSchurChannel {d : ℕ} (Ψ : QuantumChannel (Fin d) (Fin d)) : Prop :=
  ∃ C : Matrix (Fin d) (Fin d) ℂ, ∀ X, act Ψ X = C ⊙ X

def SchurMixedUnitary (d : ℕ) : Set (QuantumChannel (Fin d) (Fin d)) :=
  {Ψ | IsSchurChannel Ψ ∧ Ψ ∈ MixedUnitary d}

def distToSet {d : ℕ} (Φ : QuantumChannel (Fin d) (Fin d))
    (S : Set (QuantumChannel (Fin d) (Fin d))) : ℝ :=
  sInf ((fun Ψ => diamondDistance Φ Ψ) '' S)

def claim : Prop :=
  ∀ d : ℕ, ∀ Φ : QuantumChannel (Fin d) (Fin d), IsSchurChannel Φ →
    distToSet Φ (MixedUnitary d) = distToSet Φ (SchurMixedUnitary d)

private def AdV (d : ℕ) : QuantumChannel (Fin d) (Fin d × Fin d) :=
  Classical.choose (finite_kraus_quantum_channel
    (fun _ : Unit => (copyIsometry (n := Fin d))) (by simpa using copyIsometry_star_mul (n := Fin d)))

private theorem AdV_action (d : ℕ) (X : Matrix (Fin d) (Fin d) ℂ) :
    CStarMatrix.ofMatrix.symm ((AdV d).toCompletelyPositiveMap
      (CStarMatrix.ofMatrix X)) = (copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ := by
  simpa [AdV] using (Classical.choose_spec (finite_kraus_quantum_channel
    (fun _ : Unit => (copyIsometry (n := Fin d))) (by simpa using copyIsometry_star_mul (n := Fin d)))) X

private def recoveryKraus (d : ℕ) : Option (Fin d × Fin d) →
    Matrix (Fin d) (Fin d × Fin d) ℂ
  | none => ((copyIsometry (n := Fin d)))ᴴ
  | some p => if p.1 = p.2 then 0 else Matrix.single p.2 p 1

private theorem recovery_some_square (d : ℕ) (p : Fin d × Fin d) :
    (recoveryKraus d (some p))ᴴ * recoveryKraus d (some p) =
      if p.1 = p.2 then 0 else Matrix.single p p 1 := by
  classical
  by_cases hp : p.1 = p.2
  · simp [recoveryKraus, hp]
  · simp [recoveryKraus, hp, Matrix.single_mul_single_same]

private theorem recovery_complete (d : ℕ) :
    ∑ k, (recoveryKraus d k)ᴴ * recoveryKraus d k = 1 := by
  classical
  rw [Fintype.sum_option]
  simp only [recoveryKraus, Matrix.conjTranspose_conjTranspose]
  change (copyIsometry (n := Fin d)) * ((copyIsometry (n := Fin d)))ᴴ +
    ∑ p : Fin d × Fin d, (recoveryKraus d (some p))ᴴ * recoveryKraus d (some p) = 1
  simp_rw [recovery_some_square]
  have hsum (p q : Fin d × Fin d) :
      (∑ k : Fin d × Fin d, if k.1 = k.2 then (0 : Matrix _ _ ℂ)
        else Matrix.single k k 1) p q =
        if p.1 = p.2 then 0 else if p = q then 1 else 0 := by
    rw [Matrix.sum_apply, Finset.sum_eq_single p]
    · by_cases hp : p.1 = p.2 <;> simp [Matrix.ite_apply, Matrix.single_apply, hp, eq_comm]
    · intro k hk hkp
      by_cases hkk : k.1 = k.2 <;>
        simp [Matrix.ite_apply, Matrix.single_apply, hkk, hkp]
    · simp
  ext ⟨a, b⟩ ⟨c, e⟩
  rw [Matrix.add_apply, hsum]
  simp [copyIsometry, Matrix.mul_apply, Matrix.conjTranspose_apply,
    Matrix.one_apply, ite_and]
  by_cases hab : a = b <;> by_cases hac : a = c <;>
    by_cases hbe : b = e <;> simp_all [eq_comm]

private def recovery (d : ℕ) : QuantumChannel (Fin d × Fin d) (Fin d) :=
  Classical.choose (finite_kraus_quantum_channel (recoveryKraus d) (recovery_complete d))

private theorem recovery_action (d : ℕ) (X : Matrix (Fin d × Fin d) (Fin d × Fin d) ℂ) :
    CStarMatrix.ofMatrix.symm ((recovery d).toCompletelyPositiveMap
      (CStarMatrix.ofMatrix X)) =
      ∑ k, recoveryKraus d k * X * (recoveryKraus d k)ᴴ :=
  (Classical.choose_spec (finite_kraus_quantum_channel (recoveryKraus d) (recovery_complete d))) X

private theorem copy_conjugation (d : ℕ) (X : Matrix (Fin d) (Fin d) ℂ)
    (p q : Fin d × Fin d) :
    ((copyIsometry (n := Fin d)) * X * (copyIsometry (n := Fin d))ᴴ) p q =
      if p.1 = p.2 ∧ q.1 = q.2 then X p.1 q.1 else 0 := by
  simpa only [copyMatrix, ite_and] using copyMatrix_entry X p q

private theorem recovery_kraus_none (d : ℕ)
    (X : Matrix (Fin d × Fin d) (Fin d × Fin d) ℂ) (i j : Fin d) :
    (recoveryKraus d none * X * (recoveryKraus d none)ᴴ) i j = X (i,i) (j,j) := by
  simp [recoveryKraus, copyIsometry, Matrix.mul_apply, Matrix.conjTranspose_apply,
    Matrix.one_apply, Fintype.sum_prod_type, apply_ite, eq_comm]

private theorem recovery_kraus_some (d : ℕ)
    (X : Matrix (Fin d × Fin d) (Fin d × Fin d) ℂ)
    (p : Fin d × Fin d) (i j : Fin d) :
    (recoveryKraus d (some p) * X * (recoveryKraus d (some p))ᴴ) i j =
      if p.1 ≠ p.2 ∧ i = p.2 ∧ j = p.2 then X p p else 0 := by
  classical
  by_cases hp : p.1 = p.2
  · simp [recoveryKraus, hp]
  · simp [recoveryKraus, hp, Matrix.single_mul_mul_single,
      Matrix.single_apply, ite_and, eq_comm]

private theorem recovery_entries (d : ℕ)
    (X : Matrix (Fin d × Fin d) (Fin d × Fin d) ℂ) (i j : Fin d) :
    CStarMatrix.ofMatrix.symm ((recovery d).toCompletelyPositiveMap
      (CStarMatrix.ofMatrix X)) i j =
      if i = j then ∑ k, X (k,i) (k,i) else X (i,i) (j,j) := by
  rw [recovery_action]
  simp only [Matrix.sum_apply, Fintype.sum_option, recovery_kraus_none,
    recovery_kraus_some]
  rw [Fintype.sum_prod_type]
  by_cases hij : i = j
  · subst j
    simp only [if_pos rfl]
    have hsum : (∑ a : Fin d, ∑ b : Fin d,
        if a ≠ b ∧ i = b ∧ i = b then X (a,b) (a,b) else 0) =
        ∑ a : Fin d, if a = i then 0 else X (a,i) (a,i) := by
      apply Finset.sum_congr rfl
      intro a ha
      rw [Finset.sum_eq_single i]
      · by_cases hai : a = i <;> simp [hai, eq_comm]
      · intro b hb hbi
        simp only [hbi, hbi.symm, and_false, and_true, if_false]
      · simp
    rw [hsum]
    have hsplit : (∑ a : Fin d, X (a,i) (a,i)) =
      X (i,i) (i,i) + ∑ a : Fin d, if a = i then 0 else X (a,i) (a,i) := by
      simpa only [Finset.sum_ite, Finset.sum_const_zero, zero_add, Finset.filter_ne',
        Finset.filter_mem_eq_inter, Finset.univ_inter, Finset.mem_univ] using
        (Finset.add_sum_erase Finset.univ (fun a : Fin d => X (a,i) (a,i))
          (Finset.mem_univ i)).symm
    exact hsplit.symm
  · rw [if_neg hij]
    have hh : ∀ a b : Fin d,
        (if a ≠ b ∧ i = b ∧ j = b then X (a,b) (a,b) else 0) = 0 := by
      intro a b
      split <;> rename_i h
      · exact (hij (h.2.1.trans h.2.2.symm)).elim
      · rfl
    simp only [hh, Finset.sum_const_zero, add_zero]

private theorem reference_error_bounds {r a b : Type}
    [Fintype r] [DecidableEq r] [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (Φ Ψ : QuantumChannel a b)
    (ρ : DensityState (r × a)) :
    0 ≤ referenceError Φ Ψ ρ ∧ referenceError Φ Ψ ρ ≤ 2 := by
  constructor
  · exact traceNorm_nonneg _
  · have h := traceDistance_le_one (referenceState Φ ρ) (referenceState Ψ ρ)
    change referenceError Φ Ψ ρ / 2 ≤ 1 at h
    linarith

private theorem diamond_bounds {a b : Type}
    [Fintype a] [DecidableEq a] [Fintype b] [DecidableEq b]
    (Φ Ψ : QuantumChannel a b) :
    0 ≤ diamondDistance Φ Ψ ∧ diamondDistance Φ Ψ ≤ 2 := by
  have hB : BddAbove ({0} ∪ {x : ℝ | ∃ n : ℕ,
      ∃ ρ : DensityState (Fin n × a), x = referenceError Φ Ψ ρ}) := by
    refine ⟨2, ?_⟩
    intro x hx
    rcases hx with hx | ⟨n, ρ, rfl⟩
    · have hx0 : x = 0 := Set.mem_singleton_iff.mp hx
      rw [hx0]; norm_num
    · exact (reference_error_bounds Φ Ψ ρ).2
  constructor
  · exact le_csSup hB (Or.inl (by simp))
  · apply csSup_le (show ({0} ∪ {x : ℝ | ∃ n : ℕ,
        ∃ ρ : DensityState (Fin n × a), x = referenceError Φ Ψ ρ}).Nonempty from
      ⟨0, Or.inl (by simp)⟩)
    intro x hx
    rcases hx with hx | ⟨n, ρ, rfl⟩
    · have hx0 : x = 0 := Set.mem_singleton_iff.mp hx
      rw [hx0]; norm_num
    · exact (reference_error_bounds Φ Ψ ρ).2

private def identityChannel (d : ℕ) : QuantumChannel (Fin d) (Fin d) :=
  Classical.choose (finite_kraus_quantum_channel
    (fun _ : Unit => (1 : Matrix (Fin d) (Fin d) ℂ)) (by simp))

private theorem identity_action (d : ℕ) (X : Matrix (Fin d) (Fin d) ℂ) :
    act (identityChannel d) X = X := by
  simpa [identityChannel, act] using (Classical.choose_spec
    (finite_kraus_quantum_channel
      (fun _ : Unit => (1 : Matrix (Fin d) (Fin d) ℂ)) (by simp))) X

private theorem identity_schur_mixed (d : ℕ) :
    identityChannel d ∈ SchurMixedUnitary d := by
  constructor
  · refine ⟨fun _ _ => 1, ?_⟩
    intro X
    rw [identity_action]
    apply Matrix.ext
    intro i j
    change X i j = (1 : ℂ) * X i j
    exact (one_mul _).symm
  · refine ⟨1, fun _ => 1, fun _ => 1, ?_, ?_, ?_⟩
    · intro k; norm_num
    · simp
    · intro X
      simp [identity_action, Fin.sum_univ_one]

private theorem distance_image_bdd_below {d : ℕ} (Φ : QuantumChannel (Fin d) (Fin d))
    (S : Set (QuantumChannel (Fin d) (Fin d))) :
    BddBelow ((fun Ψ => diamondDistance Φ Ψ) '' S) := by
  refine ⟨0, ?_⟩
  rintro x ⟨Ψ, hΨ, rfl⟩
  exact (diamond_bounds Φ Ψ).1

private theorem assembly_from_replacement
    (replacement : ∀ d : ℕ, ∀ Φ : QuantumChannel (Fin d) (Fin d),
      IsSchurChannel Φ → ∀ Ψ ∈ MixedUnitary d,
      ∃ Ψ' ∈ SchurMixedUnitary d, diamondDistance Φ Ψ' ≤ diamondDistance Φ Ψ) :
    claim := by
  intro d Φ hΦ
  have hMU : (MixedUnitary d).Nonempty :=
    ⟨identityChannel d, (identity_schur_mixed d).2⟩
  have hSMU : (SchurMixedUnitary d).Nonempty :=
    ⟨identityChannel d, identity_schur_mixed d⟩
  apply le_antisymm
  · apply csInf_le_csInf (distance_image_bdd_below Φ _) (hSMU.image _)
    intro x hx
    rcases hx with ⟨Ψ, hΨ, rfl⟩
    exact ⟨Ψ, hΨ.2, rfl⟩
  · apply le_csInf (hMU.image _)
    rintro x ⟨Ψ, hΨ, rfl⟩
    obtain ⟨Ψ', hΨ', hdist⟩ := replacement d Φ hΦ Ψ hΨ
    exact (csInf_le (distance_image_bdd_below Φ _) ⟨Ψ', hΨ', rfl⟩).trans hdist

def referenceChannel {r a b : Type}
    [Fintype r] [DecidableEq r] [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (T : QuantumChannel a b) :
    QuantumChannel (r × a) (r × b) := by
  refine ⟨{ toLinearMap := referenceLinear T
            map_cstarMatrix_nonneg' := ?_ }, ?_⟩
  · intro k X hX
    let ea := Equiv.prodAssoc (Fin k) r a
    let eb := Equiv.prodAssoc (Fin k) r b
    let A := (blockEquiv (Fin k × r) a).symm
      ((CStarMatrix.reindexₐ ℂ ℂ ea.symm) (blockEquiv (Fin k) (r × a) X))
    have hA : 0 ≤ A := map_nonneg (blockEquiv (Fin k × r) a).symm
      (map_nonneg (CStarMatrix.reindexₐ ℂ ℂ ea.symm)
        (map_nonneg (blockEquiv (Fin k) (r × a)) hX))
    have hY := T.toCompletelyPositiveMap.map_cstarMatrix_nonneg A hA
    have hZ := map_nonneg (blockEquiv (Fin k) (r × b)).symm
      (map_nonneg (CStarMatrix.reindexₐ ℂ ℂ eb)
        (map_nonneg (blockEquiv (Fin k × r) b) hY))
    exact hZ
  · intro X
    change (∑ p : r × b, T.toCompletelyPositiveMap
      (CStarMatrix.ofMatrix fun x y => X (p.1,x) (p.1,y)) p.2 p.2) = ∑ p : r × a, X p p
    rw [Fintype.sum_prod_type, Fintype.sum_prod_type]
    exact Finset.sum_congr rfl (fun i _ =>
      T.trace_preserving (CStarMatrix.ofMatrix fun x y => X (i,x) (i,y)))

theorem trace_contract_rectangular {a b : Type} [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (T : QuantumChannel a b)
    (ρ σ : DensityState a) :
    traceDistance (T.mapState ρ) (T.mapState σ) ≤ traceDistance ρ σ := by
  let A : Matrix a a ℂ := CStarMatrix.ofMatrix.symm ρ.1 - CStarMatrix.ofMatrix.symm σ.1
  have hp (τ : DensityState a) : (CStarMatrix.ofMatrix.symm τ.1).PosSemidef :=
    D5.S3.Quantum.Information.PartialTraceMutualInformation.density_posSemidef τ
  have hA : A.IsHermitian := (hp ρ).isHermitian.sub (hp σ).isHermitian
  let P : Matrix a a ℂ := posPart A
  let M : Matrix a a ℂ := negPart A
  have hP : 0 ≤ P := CFC.posPart_nonneg A
  have hM : 0 ≤ M := CFC.negPart_nonneg A
  have hnorm (B : Matrix a a ℂ) (hB : 0 ≤ B) :
      traceNorm ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T B) = (Matrix.trace B).re := by
    have hout : ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T B).PosSemidef :=
      (map_nonneg CStarMatrix.ofMatrixStarAlgEquiv.symm
        (map_nonneg T.toCompletelyPositiveMap
          (map_nonneg CStarMatrix.ofMatrixStarAlgEquiv hB))).posSemidef
    have h := congrArg Complex.re (traceNorm_of_posSemidef hout)
    have ht := congrArg Complex.re (T.trace_preserving (CStarMatrix.ofMatrix B))
    exact h.trans ht
  have hmap : (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T A = (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T P - (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T M := by
    rw [show A = P - M from (CFC.posPart_sub_negPart A hA).symm]
    dsimp only
    change CStarMatrix.ofMatrix.symm (T.toCompletelyPositiveMap
      (CStarMatrix.ofMatrix P - CStarMatrix.ofMatrix M)) = _
    rw [map_sub]
    rfl
  have hbound : traceNorm ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T A) ≤ traceNorm A := by
    rw [hmap, sub_eq_add_neg]
    calc
      traceNorm ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T P + -(fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T M) ≤
          traceNorm ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T P) + traceNorm (-(fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T M) := traceNorm_add_le _ _
      _ = traceNorm A := by
        rw [traceNorm_neg, hnorm P hP, hnorm M hM]
        exact (trace_norm_jordan_mass A hA).symm
  have hdiff : CStarMatrix.ofMatrix.symm (T.mapState ρ).1 -
      CStarMatrix.ofMatrix.symm (T.mapState σ).1 = (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) T A := by
    dsimp only [A]
    change CStarMatrix.ofMatrix.symm (T.toCompletelyPositiveMap ρ.1) -
      CStarMatrix.ofMatrix.symm (T.toCompletelyPositiveMap σ.1) =
      CStarMatrix.ofMatrix.symm (T.toCompletelyPositiveMap (ρ.1 - σ.1))
    rw [map_sub]
    rfl
  unfold traceDistance
  rw [hdiff]
  exact div_le_div_of_nonneg_right hbound (by norm_num)

theorem reindex_traceNorm {a b : Type} [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (e : a ≃ b) (X : Matrix a a ℂ) :
    traceNorm ((Matrix.reindexAlgEquiv ℂ ℂ e) X) = traceNorm X := by
  let V : Matrix b a ℂ := (1 : Matrix a a ℂ).submatrix e.symm (Equiv.refl a)
  have hV : Vᴴ * V = 1 := by
    dsimp [V]
    rw [Matrix.conjTranspose_submatrix, Matrix.conjTranspose_one,
      Matrix.submatrix_mul_equiv, Matrix.one_mul]
    rfl
  have hs : V * X * Vᴴ = (Matrix.reindexAlgEquiv ℂ ℂ e) X := by
    ext i j
    simp [V, Matrix.mul_apply, Matrix.conjTranspose_apply, Matrix.one_apply,
      Matrix.reindexAlgEquiv_apply, Equiv.coe_refl]
  rw [← hs]
  exact D5.S3.Quantum.Entanglement.ConicalDesignConcurrenceComparability.traceNorm_isometry V hV X

private theorem reference_reindex_error {r s a b : Type}
    [Fintype r] [DecidableEq r] [Fintype s] [DecidableEq s]
    [Fintype a] [DecidableEq a] [Fintype b] [DecidableEq b]
    (e : r ≃ s) (Φ Ψ : QuantumChannel a b) (ρ : DensityState (r × a)) :
    referenceError Φ Ψ (InputInformationBalance.relabel (Equiv.prodCongr e (Equiv.refl a)).symm ρ) =
      referenceError Φ Ψ ρ := by
  have he (T : QuantumChannel a b) :
      CStarMatrix.ofMatrix.symm
        (referenceState T (InputInformationBalance.relabel (Equiv.prodCongr e (Equiv.refl a)).symm ρ)).1 =
      (Matrix.reindexAlgEquiv ℂ ℂ (Equiv.prodCongr e (Equiv.refl b)))
        (CStarMatrix.ofMatrix.symm (referenceState T ρ).1) := by
    ext ⟨i,u⟩ ⟨j,v⟩
    rfl
  unfold referenceError
  rw [he Φ, he Ψ, ← map_sub]
  exact reindex_traceNorm _ _

private theorem reference_error_le_diamond {r a b : Type}
    [Fintype r] [DecidableEq r] [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (Φ Ψ : QuantumChannel a b)
    (ρ : DensityState (r × a)) : referenceError Φ Ψ ρ ≤ diamondDistance Φ Ψ := by
  let e : r ≃ Fin (Fintype.card r) := Fintype.equivFin r
  let σ := InputInformationBalance.relabel (Equiv.prodCongr e (Equiv.refl a)).symm ρ
  have hB : BddAbove ({0} ∪ {x : ℝ | ∃ n : ℕ,
      ∃ τ : DensityState (Fin n × a), x = referenceError Φ Ψ τ}) := by
    refine ⟨2, ?_⟩
    rintro x (hx | ⟨n, τ, rfl⟩)
    · have hx0 : x = 0 := Set.mem_singleton_iff.mp hx
      rw [hx0]; norm_num
    · exact (reference_error_bounds Φ Ψ τ).2
  have h := le_csSup hB (Or.inr ⟨Fintype.card r, σ, rfl⟩)
  rw [reference_reindex_error] at h
  exact h

private def reindexChannel {a b : Type} [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (e : a ≃ b) : QuantumChannel a b where
  toCompletelyPositiveMap := (CStarMatrix.reindexₐ ℂ ℂ e).toStarAlgHom
  trace_preserving X := by
    change (∑ i : b, X (e.symm i) (e.symm i)) = ∑ i : a, X i i
    exact e.symm.sum_comp (fun i : a => X i i)

def leftChannel {a b r : Type} [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] [Fintype r] [DecidableEq r]
    (T : QuantumChannel a b) : QuantumChannel (a × r) (b × r) :=
  (reindexChannel (Equiv.prodComm r b)).comp
    ((referenceChannel (r := r) T).comp (reindexChannel (Equiv.prodComm a r)))

private def Theta {d : ℕ} (T : QuantumChannel (Fin d) (Fin d)) :
    QuantumChannel (Fin d) (Fin d) :=
  (recovery d).comp ((leftChannel T).comp (AdV d))

private theorem Theta_entry {d : ℕ} (T : QuantumChannel (Fin d) (Fin d))
    (X : Matrix (Fin d) (Fin d) ℂ) (i j : Fin d) :
    act (Theta T) X i j =
      if i = j then Matrix.trace (act T (Matrix.single i i (X i i)))
      else act T (Matrix.single i j (X i j)) i j := by
  change (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (Theta T) X i j = _
  unfold Theta
  change (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (recovery d) ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (leftChannel T)
    (CStarMatrix.ofMatrix.symm ((AdV d).toCompletelyPositiveMap (CStarMatrix.ofMatrix X)))) i j = _
  rw [AdV_action]
  rw [show (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (recovery d) ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (leftChannel T)
      ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ)) i j =
      if i = j then ∑ k, ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (leftChannel T)
        ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ)) (k,i) (k,i)
      else ((fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (leftChannel T)
        ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ)) (i,i) (j,j) from
    recovery_entries d _ i j]
  have hblock (u v : Fin d) :
      (CStarMatrix.ofMatrix fun x y =>
        ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ) (x,u) (y,v)) =
      CStarMatrix.ofMatrix (Matrix.single u v (X u v)) := by
    apply CStarMatrix.ext
    intro x y
    change ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ) (x,u) (y,v) =
      (Matrix.single u v (X u v)) x y
    rw [copy_conjugation]
    by_cases hxu : x = u <;> by_cases hyv : y = v <;> simp_all [Matrix.single_apply, eq_comm]
  have hentry (u v k l : Fin d) :
      (fun T X => CStarMatrix.ofMatrix.symm (QuantumChannel.toCompletelyPositiveMap T (CStarMatrix.ofMatrix X))) (leftChannel T) ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ) (k,u) (l,v) =
      act T (Matrix.single u v (X u v)) k l := by
    change ((leftChannel T).toCompletelyPositiveMap
      (CStarMatrix.ofMatrix ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ))) (k,u) (l,v) = _
    change T.toCompletelyPositiveMap
      (CStarMatrix.ofMatrix fun x y => ((copyIsometry (n := Fin d)) * X * ((copyIsometry (n := Fin d)))ᴴ) (x,u) (y,v)) k l = _
    rw [hblock]
    rfl
  simp only [hentry]
  rfl

private theorem reference_comp {r a b c : Type}
    [Fintype r] [DecidableEq r] [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] [Fintype c] [DecidableEq c]
    (S : QuantumChannel b c) (T : QuantumChannel a b) (ρ : DensityState (r × a)) :
    referenceState (S.comp T) ρ = referenceState S (referenceState T ρ) := by
  rfl

private theorem left_reference_state {r a : Type}
    [Fintype r] [DecidableEq r] [Fintype a] [DecidableEq a]
    (T : QuantumChannel a a) (ρ : DensityState (r × (a × a))) :
    referenceState (leftChannel T) ρ =
      InputInformationBalance.relabel (InputInformationBalance.arGrouping (A := r) (R := a) (B := a)).symm
        (referenceState T (InputInformationBalance.relabel (InputInformationBalance.arGrouping (A := r) (R := a) (B := a)) ρ)) := by
  rfl

private theorem traceDistance_reindex {a b : Type} [Fintype a] [DecidableEq a]
    [Fintype b] [DecidableEq b] (e : a ≃ b) (ρ σ : DensityState a) :
    traceDistance (InputInformationBalance.relabel e.symm ρ) (InputInformationBalance.relabel e.symm σ) = traceDistance ρ σ := by
  have hρ : CStarMatrix.ofMatrix.symm (InputInformationBalance.relabel e.symm ρ).1 =
      (Matrix.reindexAlgEquiv ℂ ℂ e) (CStarMatrix.ofMatrix.symm ρ.1) := rfl
  have hσ : CStarMatrix.ofMatrix.symm (InputInformationBalance.relabel e.symm σ).1 =
      (Matrix.reindexAlgEquiv ℂ ℂ e) (CStarMatrix.ofMatrix.symm σ.1) := rfl
  unfold traceDistance
  rw [hρ, hσ, ← map_sub, reindex_traceNorm]

private theorem Theta_pointwise_contract {d : ℕ} {r : Type}
    [Fintype r] [DecidableEq r]
    (T S : QuantumChannel (Fin d) (Fin d)) (ρ : DensityState (r × Fin d)) :
    referenceError (Theta T) (Theta S) ρ ≤ diamondDistance T S := by
  let ρ₀ := referenceState (AdV d) ρ
  let σ := InputInformationBalance.relabel (InputInformationBalance.arGrouping (A := r) (R := Fin d) (B := Fin d)) ρ₀
  have hT : referenceState (Theta T) ρ =
      (referenceChannel (recovery d)).mapState (referenceState (leftChannel T) ρ₀) := by
    exact (reference_comp (recovery d) ((leftChannel T).comp (AdV d)) ρ).trans
      (congrArg (referenceState (recovery d)) (reference_comp (leftChannel T) (AdV d) ρ))
  have hS : referenceState (Theta S) ρ =
      (referenceChannel (recovery d)).mapState (referenceState (leftChannel S) ρ₀) := by
    exact (reference_comp (recovery d) ((leftChannel S).comp (AdV d)) ρ).trans
      (congrArg (referenceState (recovery d)) (reference_comp (leftChannel S) (AdV d) ρ))
  have h := trace_contract_rectangular (referenceChannel (recovery d))
    (referenceState (leftChannel T) ρ₀) (referenceState (leftChannel S) ρ₀)
  rw [← hT, ← hS, left_reference_state T ρ₀, left_reference_state S ρ₀,
    traceDistance_reindex] at h
  change referenceError (Theta T) (Theta S) ρ / 2 ≤ referenceError T S σ / 2 at h
  have hpt : referenceError (Theta T) (Theta S) ρ ≤ referenceError T S σ := by linarith
  exact hpt.trans (reference_error_le_diamond T S σ)

private theorem Theta_diamond_contract {d : ℕ} (T S : QuantumChannel (Fin d) (Fin d)) :
    diamondDistance (Theta T) (Theta S) ≤ diamondDistance T S := by
  apply csSup_le (show ({0} ∪ {x : ℝ | ∃ n : ℕ,
      ∃ ρ : DensityState (Fin n × Fin d), x = referenceError (Theta T) (Theta S) ρ}).Nonempty from
    ⟨0, Or.inl (by simp)⟩)
  rintro x (hx | ⟨n, ρ, rfl⟩)
  · have hx0 : x = 0 := Set.mem_singleton_iff.mp hx
    rw [hx0]; exact (diamond_bounds T S).1
  · exact Theta_pointwise_contract T S ρ

private theorem disk_midpoint_phases (a : ℂ) (ha : ‖a‖ ≤ 1) :
    ∃ z : Bool → ℂ, (∀ b, star (z b) * z b = 1) ∧
      (z false + z true) / 2 = a := by
  by_cases haz : a = 0
  · subst a
    refine ⟨fun b => if b then -1 else 1, ?_, ?_⟩
    · intro b; cases b <;> norm_num
    · norm_num
  let r : ℝ := ‖a‖
  have hr : 0 < r := norm_pos_iff.mpr haz
  let q : ℂ := a / (r : ℂ)
  have hq : star q * q = 1 := by
    dsimp [q, r]
    rw [map_div₀, Complex.conj_ofReal, div_mul_div_comm, Complex.conj_mul']
    simp [Complex.normSq_eq_norm_sq, pow_two, ne_of_gt hr, haz]
  have hqr : q * (r : ℂ) = a := by
    dsimp [q]; field_simp
  let s : ℝ := Real.sqrt (1-r^2)
  let t : Bool → ℂ := fun b => (r : ℂ) + (if b then 1 else -1) * Complex.I * (s : ℂ)
  refine ⟨fun b => q * t b, ?_, ?_⟩
  · intro b
    have ht : star (t b) * t b = 1 := by
      have hr1 : ‖r‖ ≤ 1 := by simpa [r] using ha
      cases b
      · simpa [t, s, Complex.normSq_eq_conj_mul_self, sub_eq_add_neg] using
          congrArg (fun x : ℝ => (x : ℂ))
            (Complex.normSq_ofReal_sub_I_mul_sqrt_one_sub hr1)
      · simpa [t, s, Complex.normSq_eq_conj_mul_self] using
          congrArg (fun x : ℝ => (x : ℂ))
            (Complex.normSq_ofReal_add_I_mul_sqrt_one_sub hr1)
    calc
      star (q * t b) * (q * t b) = (star q * q) * (star (t b) * t b) := by
        simp only [star_mul]; ring
      _ = 1 := by rw [hq, ht]; norm_num
  · dsimp [t]
    norm_num
    calc
      (q * ((r : ℂ) + -(Complex.I * (s : ℂ))) +
        q * ((r : ℂ) + Complex.I * (s : ℂ))) / 2 = q * (r : ℂ) := by ring
      _ = a := hqr

private theorem uniform_coordinate_sum {ι : Type} [Fintype ι] [DecidableEq ι]
    (i : ι) (f : Bool → ℂ) :
    (∑ ε : ι → Bool, f (ε i)) =
      (Fintype.card ({j : ι // j ≠ i} → Bool) : ℂ) * (f false + f true) := by
  let e := Equiv.piSplitAt i (fun _ : ι => Bool)
  rw [← e.symm.sum_comp (fun ε : ι → Bool => f (ε i))]
  simp [e, Equiv.piSplitAt, Fintype.sum_prod_type, add_mul, mul_add, mul_comm]
  ring

private theorem uniform_two_coordinate_sum {ι : Type} [Fintype ι] [DecidableEq ι]
    (i j : ι) (hij : i ≠ j) (f g : Bool → ℂ) :
    (∑ ε : ι → Bool, f (ε i) * g (ε j)) =
      (Fintype.card ({k : {k : ι // k ≠ i} // k ≠ ⟨j, Ne.symm hij⟩} → Bool) : ℂ) *
      (f false + f true) * (g false + g true) := by
  let e := Equiv.piSplitAt i (fun _ : ι => Bool)
  rw [← e.symm.sum_comp (fun ε : ι → Bool => f (ε i) * g (ε j))]
  rw [Fintype.sum_prod_type]
  have h1 (b : Bool) (ε : {j : ι // j ≠ i} → Bool) : e.symm (b, ε) i = b := by
    simp [e, Equiv.piSplitAt]
  have h2 (b : Bool) (ε : {j : ι // j ≠ i} → Bool) :
      e.symm (b, ε) j = ε ⟨j, Ne.symm hij⟩ := by
    simp [e, Equiv.piSplitAt, Ne.symm hij]
  simp_rw [h1, h2, ← Finset.mul_sum, uniform_coordinate_sum (ι := {k : ι // k ≠ i}) ⟨j, Ne.symm hij⟩ g]
  simp [mul_add, add_mul]
  ring

private theorem bool_function_card_split {ι : Type} [Fintype ι] [DecidableEq ι] (i : ι) :
    Fintype.card (ι → Bool) = 2 * Fintype.card ({j : ι // j ≠ i} → Bool) := by
  simpa using Fintype.card_congr (Equiv.piSplitAt i (fun _ : ι => Bool))

private theorem uniform_two_coordinate_average {ι : Type} [Fintype ι] [DecidableEq ι]
    (i j : ι) (hij : i ≠ j) (f g : Bool → ℂ) :
    (Fintype.card (ι → Bool) : ℂ)⁻¹ *
      (∑ ε : ι → Bool, f (ε i) * g (ε j)) =
      ((f false + f true) / 2) * ((g false + g true) / 2) := by
  let m : ℕ := Fintype.card
    ({k : {k : ι // k ≠ i} // k ≠ ⟨j, Ne.symm hij⟩} → Bool)
  have hm : (m : ℂ) ≠ 0 := by
    exact_mod_cast (Fintype.card_ne_zero : m ≠ 0)
  have hc : Fintype.card (ι → Bool) = 4 * m := by
    rw [bool_function_card_split i,
      bool_function_card_split (ι := {k : ι // k ≠ i}) ⟨j, Ne.symm hij⟩]
    dsimp [m]; ring
  rw [uniform_two_coordinate_sum i j hij f g, hc]
  change ((4 * m : ℕ) : ℂ)⁻¹ * ((m : ℂ) * (f false + f true) * (g false + g true)) = _
  push_cast
  field_simp
  <;> ring

private theorem phase_kernel_average {ι : Type} [Fintype ι] [DecidableEq ι]
    (a : ι → ℂ) (z : ι → Bool → ℂ)
    (hz : ∀ i b, star (z i b) * z i b = 1)
    (hm : ∀ i, (z i false + z i true) / 2 = a i) (i j : ι) :
    (Fintype.card (ι → Bool) : ℂ)⁻¹ *
      (∑ ε : ι → Bool, z i (ε i) * star (z j (ε j))) =
      if i = j then 1 else a i * star (a j) := by
  by_cases hij : i = j
  · subst j
    have hf : ∀ ε : ι → Bool, z i (ε i) * star (z i (ε i)) = 1 := by
      intro ε; simpa [mul_comm] using hz i (ε i)
    simp only [hf, Finset.sum_const, Finset.card_univ, nsmul_eq_mul, mul_one, if_pos rfl]
    exact inv_mul_cancel₀ (by exact_mod_cast (Fintype.card_ne_zero : Fintype.card (ι → Bool) ≠ 0))
  · rw [if_neg hij, uniform_two_coordinate_average i j hij (z i) (fun b => star (z j b))]
    rw [hm i]
    have hh : (star (z j false) + star (z j true)) / 2 = star (a j) := by
      have hh := congrArg (starRingEnd ℂ) (hm j)
      change star ((z j false + z j true) / (2 : ℂ)) = star (a j) at hh
      simpa only [star_div₀, star_add, star_ofNat] using hh
    rw [hh]

private theorem unitary_diagonal_norm_le {d : ℕ}
    (U : Matrix.unitaryGroup (Fin d) ℂ) (i : Fin d) :
    ‖(U : Matrix (Fin d) (Fin d) ℂ) i i‖ ≤ 1 := by
  exact entry_norm_bound_of_unitary U.property i i

private theorem phase_unitary_average {d : ℕ} (a : Fin d → ℂ)
    (z : Fin d → Bool → ℂ) (hz : ∀ i b, star (z i b) * z i b = 1)
    (hm : ∀ i, (z i false + z i true) / 2 = a i)
    (X : Matrix (Fin d) (Fin d) ℂ) (i j : Fin d) :
    (Fintype.card (Fin d → Bool) : ℂ)⁻¹ *
      (∑ ε : Fin d → Bool,
        (((Unitary.map (StarMonoidHom.ofClass
          (D5.S3.Quantum.Dynamics.EntropyProductionCoherenceDeletionIdentity.diagonalStarAlgHom (n := Fin d)))
          ⟨fun i => z i (ε i), by
            constructor
            · funext i; exact hz i (ε i)
            · funext i; change z i (ε i) * star (z i (ε i)) = 1
              rw [mul_comm]; exact hz i (ε i)⟩) : Matrix (Fin d) (Fin d) ℂ) * X *
          star ((Unitary.map (StarMonoidHom.ofClass
          (D5.S3.Quantum.Dynamics.EntropyProductionCoherenceDeletionIdentity.diagonalStarAlgHom (n := Fin d)))
          ⟨fun i => z i (ε i), by
            constructor
            · funext i; exact hz i (ε i)
            · funext i; change z i (ε i) * star (z i (ε i)) = 1
              rw [mul_comm]; exact hz i (ε i)⟩) : Matrix (Fin d) (Fin d) ℂ)) i j) =
      (if i = j then 1 else a i * star (a j)) * X i j := by
  have he (ε : Fin d → Bool) :
      (((Unitary.map (StarMonoidHom.ofClass
          (D5.S3.Quantum.Dynamics.EntropyProductionCoherenceDeletionIdentity.diagonalStarAlgHom (n := Fin d)))
          ⟨fun i => z i (ε i), by
            constructor
            · funext i; exact hz i (ε i)
            · funext i; change z i (ε i) * star (z i (ε i)) = 1
              rw [mul_comm]; exact hz i (ε i)⟩) : Matrix (Fin d) (Fin d) ℂ) * X *
        star ((Unitary.map (StarMonoidHom.ofClass
          (D5.S3.Quantum.Dynamics.EntropyProductionCoherenceDeletionIdentity.diagonalStarAlgHom (n := Fin d)))
          ⟨fun i => z i (ε i), by
            constructor
            · funext i; exact hz i (ε i)
            · funext i; change z i (ε i) * star (z i (ε i)) = 1
              rw [mul_comm]; exact hz i (ε i)⟩) : Matrix (Fin d) (Fin d) ℂ)) i j =
        (z i (ε i) * star (z j (ε j))) * X i j := by
    simp [Unitary.coe_map,
      D5.S3.Quantum.Dynamics.EntropyProductionCoherenceDeletionIdentity.diagonalStarAlgHom, Matrix.mul_diagonal, Matrix.diagonal_mul,
      Matrix.star_eq_conjTranspose, Matrix.diagonal_conjTranspose, mul_assoc, mul_comm, mul_left_comm]
  simp_rw [he]
  rw [← Finset.sum_mul, ← mul_assoc, phase_kernel_average a z hz hm]

private theorem channel_trace_matrix {d : ℕ} (T : QuantumChannel (Fin d) (Fin d))
    (X : Matrix (Fin d) (Fin d) ℂ) : Matrix.trace (act T X) = Matrix.trace X :=
  T.trace_preserving (CStarMatrix.ofMatrix X)

private theorem act_smul {d : ℕ} (T : QuantumChannel (Fin d) (Fin d))
    (c : ℂ) (X : Matrix (Fin d) (Fin d) ℂ) : act T (c • X) = c • act T X := by
  unfold act
  change CStarMatrix.ofMatrix.symm (T.toCompletelyPositiveMap (c • CStarMatrix.ofMatrix X)) = _
  rw [map_smul]
  rfl

private theorem Theta_schur {d : ℕ} (T : QuantumChannel (Fin d) (Fin d)) :
    IsSchurChannel (Theta T) := by
  refine ⟨fun i j => if i = j then 1 else act T (Matrix.single i j 1) i j, ?_⟩
  intro X
  apply Matrix.ext
  intro i j
  rw [Theta_entry]
  by_cases hij : i = j
  · subst j
    simp [channel_trace_matrix]
  · rw [if_neg hij]
    have hs : Matrix.single i j (X i j) = (X i j) • Matrix.single i j 1 := by
      simp
    rw [hs, act_smul]
    change X i j * act T (Matrix.single i j 1) i j =
      (if i = j then 1 else act T (Matrix.single i j 1) i j) * X i j
    rw [if_neg hij, mul_comm]

private theorem Theta_fixes_schur {d : ℕ} (T : QuantumChannel (Fin d) (Fin d))
    (hT : IsSchurChannel T) : ∀ X, act (Theta T) X = act T X := by
  obtain ⟨C,hC⟩ := hT
  intro X
  apply Matrix.ext
  intro i j
  rw [Theta_entry]
  by_cases hij : i = j
  · subst j
    have hii : C i i = 1 := by
      have ht := channel_trace_matrix T (Matrix.single i i 1)
      rw [hC] at ht
      simpa [Matrix.trace, Matrix.hadamard_apply, Matrix.single_apply] using ht
    rw [if_pos rfl, channel_trace_matrix, hC]
    simp [hii]
  · rw [if_neg hij, hC, hC]
    simp

private theorem conjugate_single_entry {d : ℕ} (U : Matrix (Fin d) (Fin d) ℂ)
    (c : ℂ) (i j : Fin d) :
    (U * Matrix.single i j c * star U) i j = U i i * c * star (U j j) := by
  simp [Matrix.mul_apply, Matrix.single_apply, Matrix.star_eq_conjTranspose,
    Matrix.conjTranspose_apply, Finset.sum_mul, ite_and]

private theorem Theta_mixture_entries {d n : ℕ} (Ψ : QuantumChannel (Fin d) (Fin d))
    (p : Fin n → ℝ) (U : Fin n → Matrix.unitaryGroup (Fin d) ℂ)
    (hact : ∀ X, act Ψ X = ∑ k, (p k : ℂ) •
      ((U k : Matrix (Fin d) (Fin d) ℂ) * X * star (U k : Matrix (Fin d) (Fin d) ℂ)))
    (X : Matrix (Fin d) (Fin d) ℂ) (i j : Fin d) :
    act (Theta Ψ) X i j =
      if i = j then X i i else
        ∑ k, (p k : ℂ) *
          ((U k : Matrix (Fin d) (Fin d) ℂ) i i * star ((U k : Matrix (Fin d) (Fin d) ℂ) j j)) * X i j := by
  rw [Theta_entry]
  by_cases hij : i = j
  · subst j; simp [channel_trace_matrix]
  · rw [if_neg hij, if_neg hij, hact]
    simp only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, conjugate_single_entry]
    apply Finset.sum_congr rfl
    intro k hk
    ring

private theorem mixedUnitary_of_finite {d : ℕ} {κ : Type} [Fintype κ]
    (Ψ : QuantumChannel (Fin d) (Fin d)) (p : κ → ℝ)
    (U : κ → Matrix.unitaryGroup (Fin d) ℂ)
    (hp : ∀ k, 0 ≤ p k) (hsum : ∑ k, p k = 1)
    (hact : ∀ X, act Ψ X = ∑ k, (p k : ℂ) •
      ((U k : Matrix (Fin d) (Fin d) ℂ) * X * star (U k : Matrix (Fin d) (Fin d) ℂ))) :
    Ψ ∈ MixedUnitary d := by
  classical
  let e := Fintype.equivFin κ
  refine ⟨Fintype.card κ, fun k => p (e.symm k), fun k => U (e.symm k),
    fun k => hp _, ?_, ?_⟩
  · exact (e.symm.sum_comp p).trans hsum
  · intro X
    exact (hact X).trans (e.symm.sum_comp (fun k => (p k : ℂ) •
      ((U k : Matrix (Fin d) (Fin d) ℂ) * X * star (U k : Matrix (Fin d) (Fin d) ℂ)))).symm

private theorem Theta_preserves_mixed {d : ℕ} (Ψ : QuantumChannel (Fin d) (Fin d))
    (hΨ : Ψ ∈ MixedUnitary d) : Theta Ψ ∈ SchurMixedUnitary d := by
  classical
  refine ⟨Theta_schur Ψ, ?_⟩
  obtain ⟨n,p,U,hp,hsum,hact⟩ := hΨ
  have hph : ∀ k : Fin n, ∀ i : Fin d, ∃ z : Bool → ℂ,
      (∀ b, star (z b) * z b = 1) ∧
        (z false + z true) / 2 = (U k : Matrix (Fin d) (Fin d) ℂ) i i := by
    intro k i
    exact disk_midpoint_phases _ (unitary_diagonal_norm_le (U k) i)
  choose z hz hm using hph
  let N : ℕ := Fintype.card (Fin d → Bool)
  have hN : (N : ℝ) ≠ 0 := by exact_mod_cast (Fintype.card_ne_zero : N ≠ 0)
  let q : (Fin n × (Fin d → Bool)) → ℝ := fun k => p k.1 / N
  let D : (Fin n × (Fin d → Bool)) → Matrix.unitaryGroup (Fin d) ℂ :=
    fun k => Unitary.map (StarMonoidHom.ofClass
      (D5.S3.Quantum.Dynamics.EntropyProductionCoherenceDeletionIdentity.diagonalStarAlgHom (n := Fin d)))
      ⟨fun i => z k.1 i (k.2 i), by
        constructor
        · funext i; exact hz k.1 i (k.2 i)
        · funext i; change z k.1 i (k.2 i) * star (z k.1 i (k.2 i)) = 1
          rw [mul_comm]; exact hz k.1 i (k.2 i)⟩
  apply mixedUnitary_of_finite (Theta Ψ) q D
  · intro k
    exact div_nonneg (hp k.1) (Nat.cast_nonneg N)
  · change ∑ k : Fin n × (Fin d → Bool), p k.1 / (N : ℝ) = 1
    rw [Fintype.sum_prod_type]
    simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
    change ∑ k : Fin n, (N : ℝ) * (p k / (N : ℝ)) = 1
    simp only [mul_div_cancel₀ _ hN]
    exact hsum
  · intro X
    apply Matrix.ext
    intro i j
    rw [Theta_mixture_entries Ψ p U hact]
    change (if i = j then X i i else
      ∑ k, (p k : ℂ) * ((U k : Matrix (Fin d) (Fin d) ℂ) i i *
        star ((U k : Matrix (Fin d) (Fin d) ℂ) j j)) * X i j) =
        (∑ k : Fin n × (Fin d → Bool), (q k : ℂ) •
          ((D k : Matrix (Fin d) (Fin d) ℂ) * X * star (D k : Matrix (Fin d) (Fin d) ℂ))) i j
    simp only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, Fintype.sum_prod_type]
    have hinner (k : Fin n) :
        (∑ ε : Fin d → Bool, (q (k,ε) : ℂ) *
          ((D (k,ε) : Matrix (Fin d) (Fin d) ℂ) * X * star (D (k,ε) : Matrix (Fin d) (Fin d) ℂ)) i j) =
        (p k : ℂ) * (if i = j then 1 else
          (U k : Matrix (Fin d) (Fin d) ℂ) i i * star ((U k : Matrix (Fin d) (Fin d) ℂ) j j)) * X i j := by
      have hq (ε : Fin d → Bool) : (q (k, ε) : ℂ) =
          (p k : ℂ) * (N : ℂ)⁻¹ := by simp [q, div_eq_mul_inv]
      simp_rw [hq]
      dsimp only [D]
      rw [← Finset.mul_sum, mul_assoc]
      rw [phase_unitary_average (fun i => (U k : Matrix (Fin d) (Fin d) ℂ) i i)
        (z k) (hz k) (hm k) X i j]
      ring
    simp_rw [hinner]
    by_cases hij : i = j
    · subst j
      simp only [if_true, if_pos rfl, mul_one]
      rw [← Finset.sum_mul]
      have hsumC : ∑ k : Fin n, (p k : ℂ) = 1 := by exact_mod_cast hsum
      rw [hsumC, one_mul]
    · simp only [if_false, if_neg hij]

private theorem channel_ext_act {d : ℕ} (T S : QuantumChannel (Fin d) (Fin d))
    (h : ∀ X, act T X = act S X) : T = S := by
  have hp : T.toCompletelyPositiveMap = S.toCompletelyPositiveMap := by
    exact DFunLike.ext_iff.mpr h
  cases T
  cases S
  congr

theorem result : claim := by
  apply assembly_from_replacement
  intro d Φ hΦ Ψ hΨ
  refine ⟨Theta Ψ, Theta_preserves_mixed Ψ hΨ, ?_⟩
  have hfix : Theta Φ = Φ := channel_ext_act _ _ (Theta_fixes_schur Φ hΦ)
  simpa only [hfix] using Theta_diamond_contract Φ Ψ

end D5.S3.QuantumChannels.SchurChannelMixedUnitaryDistance
