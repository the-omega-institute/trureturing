/- GID: D5/S3/QuantumChannels/ProjectionDiagnostics/CyclicMonitoredContraction
   generality: G
   mirror-B: D5/B/S3/QuantumChannels/ProjectionDiagnostics/CyclicMonitoredContraction
   mirror-E: none(waiver:algebraically-proved)
   anchors: []
   utility: none
   digest: The actual cyclic monitored restriction has no nonzero all-future hidden vector. -/

import D5.S3.QuantumChannels.ProjectionDiagnostics.MonitoredReturnConservation
import D5.S3.ObserverMemory.Dynamics.MaximalUnobservableSubspace
import D5.S3.ObserverMemory.Dynamics.InfiniteObservabilityOrthogonalDuality

/-! Actual cyclic restrictions and their all-future observability. -/

noncomputable section
open scoped InnerProductSpace

namespace D5.S3.QuantumChannels.ProjectionDiagnostics.CyclicMonitoredContraction

open MonitoredReturnConservation
open D5.S3.ObserverMemory.Dynamics

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]
  [FiniteDimensional ℂ E]

/-- The actual forward cyclic space generated by the monitored initial vector. -/
def cyclicSpace (U : E ≃ₗᵢ[ℂ] E) (v : E) : Submodule ℂ E :=
  Submodule.span ℂ (Set.range fun n : ℕ => (U.toLinearMap ^ n) v)

theorem initial_mem (U : E ≃ₗᵢ[ℂ] E) (v : E) : v ∈ cyclicSpace U v := by
  simpa [cyclicSpace] using (Submodule.subset_span (s := Set.range fun n : ℕ =>
    (U.toLinearMap ^ n) v) ⟨0, rfl⟩)

theorem unitary_mem (U : E ≃ₗᵢ[ℂ] E) (v : E) :
    Set.MapsTo U (cyclicSpace U v) (cyclicSpace U v) := by
  intro x hx
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨n, rfl⟩ := hx
      exact Submodule.subset_span ⟨n + 1, by simp [pow_succ', mul_apply_eq_comp]⟩
  | zero => simpa using (cyclicSpace U v).zero_mem
  | add x y _ _ hx hy => simpa using (cyclicSpace U v).add_mem hx hy
  | smul a x _ hx => simpa using (cyclicSpace U v).smul_mem a hx

private theorem click_mem (U : E ≃ₗᵢ[ℂ] E) (v : E) (x : E) :
    (ℂ ∙ v).starProjection (U x) ∈ cyclicSpace U v := by
  rw [Submodule.starProjection_singleton]
  exact (cyclicSpace U v).smul_mem _ (initial_mem U v)

private theorem step_mem (U : E ≃ₗᵢ[ℂ] E) (v : E) :
    Set.MapsTo (monitoredStep U v) (cyclicSpace U v) (cyclicSpace U v) := by
  intro x hx
  exact (cyclicSpace U v).sub_mem (unitary_mem U v hx) (click_mem U v x)

/-- The no-return operator restricted to its actual cyclic space. -/
def cyclicStep (U : E ≃ₗᵢ[ℂ] E) (v : E) : cyclicSpace U v →L[ℂ] cyclicSpace U v :=
  (monitoredStep U v).restrict (step_mem U v)

/-- The actual click operator on the same cyclic space. -/
def cyclicClick (U : E ≃ₗᵢ[ℂ] E) (v : E) : cyclicSpace U v →L[ℂ] cyclicSpace U v :=
  ((ℂ ∙ v).starProjection.comp U.toLinearIsometry.toContinuousLinearMap).restrict
    (fun x _ => click_mem U v x)

theorem step_pow_coe (U : E ≃ₗᵢ[ℂ] E) (v : E) (n : ℕ)
    (x : cyclicSpace U v) :
    ((cyclicStep U v ^ n) x : E) = (monitoredStep U v ^ n) (x : E) := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [pow_succ', pow_succ', mul_apply_eq_comp, mul_apply_eq_comp]
      exact congrArg (monitoredStep U v) ih

/-- Every actual cyclic state with zero click at every future time is zero.
No recurrence, stability, or additional cyclicity hypothesis is assumed. -/
theorem cyclic_future_kernel_eq_bot (U : E ≃ₗᵢ[ℂ] E) (v : E) :
    (⨅ n : ℕ, LinearMap.ker
      ((cyclicClick U v).toLinearMap.comp ((cyclicStep U v).toLinearMap ^ n))) = ⊥ := by
  let A := (monitoredStep U v).toLinearMap
  let B := ((ℂ ∙ v).starProjection.comp
    U.toLinearIsometry.toContinuousLinearMap).toLinearMap
  let H := (Submodule.span ℂ {x : E | ∃ n : ℕ, ∃ y : E,
    x = (A.adjoint ^ n) (B.adjoint y)})ᗮ
  have hH : H = ⨅ n : ℕ, LinearMap.ker (B.comp (A ^ n)) :=
    (InfiniteObservabilityOrthogonalDuality.infinite_unobservable_eq_observable_orthogonal
      A B).symm
  have hstructure := MaximalUnobservableSubspace.future_kernel_is_maximal_invariant A B
  rw [← hH] at hstructure
  let K := H ⊓ cyclicSpace U v
  have hclick (x : E) (hx : x ∈ H) : (ℂ ∙ v).starProjection (U x) = 0 :=
    hstructure.1 hx
  have hstep (x : E) (hx : x ∈ H) : monitoredStep U v x = U x := by
    change U x - (ℂ ∙ v).starProjection (U x) = U x
    rw [hclick x hx, sub_zero]
  have hUK : Set.MapsTo U K K := by
    intro x hx
    refine ⟨?_, unitary_mem U v hx.2⟩
    rw [← hstep x hx.1]
    exact hstructure.2.1 hx.1
  let UK : K →ₗ[ℂ] K := U.toLinearMap.restrict hUK
  have hUKinj : Function.Injective UK := by
    intro x y hxy
    apply Subtype.ext
    exact U.injective (congrArg Subtype.val hxy)
  have hUKsurj := LinearMap.surjective_of_injective hUKinj
  have hinverse : Set.MapsTo U.symm K K := by
    intro x hx
    obtain ⟨y, hy⟩ := hUKsurj ⟨x, hx⟩
    have hy' : U (y : E) = x := congrArg Subtype.val hy
    rw [← hy', U.symm_apply_apply]
    exact y.2
  have hvorth (x : E) (hx : x ∈ K) : inner ℂ v x = 0 := by
    obtain ⟨y, hy⟩ := hUKsurj ⟨x, hx⟩
    have hy' : U (y : E) = x := congrArg Subtype.val hy
    have hp : (ℂ ∙ v).starProjection x = 0 := by
      rw [← hy']
      exact hclick y y.2.1
    exact Submodule.mem_orthogonal_singleton_iff_inner_right.mp
      ((Submodule.starProjection_apply_eq_zero_iff (ℂ ∙ v)).mp hp)
  have horbit (n : ℕ) : ∀ x : E, x ∈ K → inner ℂ ((U.toLinearMap ^ n) v) x = 0 := by
    induction n with
    | zero => simpa using hvorth
    | succ n ih =>
        intro x hx
        rw [pow_succ']
        change inner ℂ (U ((U.toLinearMap ^ n) v)) x = 0
        rw [U.inner_map_eq_flip]
        exact ih _ (hinverse hx)
  have hzero (x : E) (hx : x ∈ K) : x = 0 := by
    have hxorth : x ∈ (cyclicSpace U v)ᗮ := by
      rw [Submodule.mem_orthogonal']
      intro y hy
      induction hy using Submodule.span_induction with
      | mem y hy =>
          obtain ⟨n, rfl⟩ := hy
          exact (inner_eq_zero_symm).2 (horbit n x hx)
      | zero => simp
      | add y z _ _ hy hz => simp [inner_add_right, hy, hz]
      | smul a y _ hy => simp [inner_smul_right, hy]
    exact (inner_self_eq_zero).mp (hxorth x hx.2)
  apply le_antisymm ?_ bot_le
  intro x hx
  change x = 0
  apply Subtype.ext
  apply hzero
  refine ⟨?_, x.2⟩
  change (x : E) ∈ H
  rw [hH]
  apply (Submodule.mem_iInf _).mpr
  intro n
  have hn := (Submodule.mem_iInf _).mp hx n
  rw [LinearMap.mem_ker] at hn ⊢
  have hn' := congrArg (fun y : cyclicSpace U v => (y : E)) hn
  change (ℂ ∙ v).starProjection
    (U (((cyclicStep U v).toLinearMap ^ n) x : E)) = 0 at hn'
  rw [← ContinuousLinearMap.toLinearMap_pow] at hn'
  change (ℂ ∙ v).starProjection (U (((cyclicStep U v ^ n) x : cyclicSpace U v) : E)) = 0 at hn'
  rw [step_pow_coe] at hn'
  change (ℂ ∙ v).starProjection
    (U (((monitoredStep U v).toLinearMap ^ n) (x : E))) = 0
  rw [← ContinuousLinearMap.toLinearMap_pow]
  exact hn'

#print axioms cyclic_future_kernel_eq_bot

end D5.S3.QuantumChannels.ProjectionDiagnostics.CyclicMonitoredContraction
