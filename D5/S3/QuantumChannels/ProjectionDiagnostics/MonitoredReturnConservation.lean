noncomputable section

open scoped InnerProductSpace BigOperators

namespace D5.S3.QuantumChannels.ProjectionDiagnostics.MonitoredReturnConservation

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E] [CompleteSpace E]

/-- One unitary step followed by the no-return projection Q = I - P. -/
def monitoredStep (U : E ≃ₗᵢ[ℂ] E) (v : E) : E →L[ℂ] E :=
  (ContinuousLinearMap.id ℂ E - (ℂ ∙ v).starProjection).comp
    U.toLinearIsometry.toContinuousLinearMap

/-- The unnormalized state after n consecutive no-return outcomes. -/
def monitoredHistory (U : E ≃ₗᵢ[ℂ] E) (v : E) (n : ℕ) : E :=
  (monitoredStep U v ^ n) v

/-- The monitored first-return amplitude, used at positive times. -/
def returnAmplitude (U : E ≃ₗᵢ[ℂ] E) (v : E) (n : ℕ) : ℂ :=
  inner ℂ v (U (monitoredHistory U v (n - 1)))

/-- Squared modulus of the monitored return amplitude. -/
def returnProbability (U : E ≃ₗᵢ[ℂ] E) (v : E) (n : ℕ) : ℝ :=
  ‖returnAmplitude U v n‖ ^ 2

/-- Squared norm of the surviving monitored history. -/
def survivalProbability (U : E ≃ₗᵢ[ℂ] E) (v : E) (n : ℕ) : ℝ :=
  ‖monitoredHistory U v n‖ ^ 2

/-- Stepwise and finite conservation for the monitored return protocol. -/
theorem monitored_return_conservation (U : E ≃ₗᵢ[ℂ] E) (v : E) (hv : ‖v‖ = 1) :
    survivalProbability U v 0 = 1 ∧
    (∀ n : ℕ, returnProbability U v (n + 1) =
      survivalProbability U v n - survivalProbability U v (n + 1)) ∧
    ∀ N : ℕ, (∑ n ∈ Finset.range N, returnProbability U v (n + 1)) +
      survivalProbability U v N = 1 := by
  have hzero : survivalProbability U v 0 = 1 := by
    simp [survivalProbability, monitoredHistory, hv]
  have hstep (n : ℕ) : returnProbability U v (n + 1) =
      survivalProbability U v n - survivalProbability U v (n + 1) := by
    apply (eq_sub_iff_add_eq).2
    have hpyth := Submodule.norm_sq_eq_add_norm_sq_starProjection
      (U (monitoredHistory U v n)) (ℂ ∙ v)
    simpa [returnProbability, returnAmplitude, survivalProbability, monitoredHistory,
      monitoredStep, pow_succ', Submodule.starProjection_orthogonal,
      Submodule.starProjection_singleton, hv, norm_smul] using hpyth.symm
  refine ⟨hzero, hstep, ?_⟩
  intro N
  simp_rw [hstep]
  rw [Finset.sum_range_sub', sub_add_cancel, hzero]

#print axioms monitored_return_conservation

end D5.S3.QuantumChannels.ProjectionDiagnostics.MonitoredReturnConservation
