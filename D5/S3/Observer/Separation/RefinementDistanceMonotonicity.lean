import Mathlib.Data.ENNReal.Real

/- Library-search audit trail (2026-08-16):
   * Repository searches found observer distances but no refinement-monotonicity theorem or
     formalization receipt matching this statement.
   * Pinned-Mathlib source search and `#check` found `iSup_mono'`, the exact generic theorem
     that compares suprema indexed by different types; the proof below applies it directly.
   * Loogle query `iSup_mono` returned the same complete-lattice family (HTTP 200).
   * LeanSearch `/api/search` returned HTTP 404, so it supplied no search conclusion.
-/

namespace D5.S3.Observer.Separation.RefinementDistanceMonotonicity

/-- The extended dual distance generated by observables of seminorm at most one. -/
noncomputable def observerDistance {Observable State : Type*}
    (observables : Set Observable) (seminorm : Observable -> ENNReal)
    (evaluate : State -> Observable -> Real) (rho sigma : State) : ENNReal :=
  ⨆ observable : {A // A ∈ observables ∧ seminorm A ≤ 1},
    ENNReal.ofReal |evaluate rho observable.1 - evaluate sigma observable.1|

/-- Enlarging the observable family while preserving old seminorm costs cannot decrease
the induced dual distance. -/
theorem observer_distance_mono_of_refinement {Observable State : Type*}
    (evaluate : State -> Observable -> Real) (rho sigma : State)
    {oldObservables newObservables : Set Observable}
    {oldSeminorm newSeminorm : Observable -> ENNReal}
    (hsubset : oldObservables ⊆ newObservables)
    (hrestrict : ∀ A ∈ oldObservables, newSeminorm A = oldSeminorm A) :
    observerDistance oldObservables oldSeminorm evaluate rho sigma ≤
      observerDistance newObservables newSeminorm evaluate rho sigma := by
  unfold observerDistance
  apply iSup_mono'
  intro observable
  refine ⟨⟨observable.1, hsubset observable.2.1, ?_⟩, le_rfl⟩
  simpa [hrestrict observable.1 observable.2.1] using observable.2.2

example (evaluate : Bool -> Nat -> Real) (rho sigma : Bool) :
    observerDistance {0} (fun _ : Nat => (0 : ENNReal)) evaluate rho sigma ≤
      observerDistance Set.univ (fun _ : Nat => (0 : ENNReal)) evaluate rho sigma := by
  apply observer_distance_mono_of_refinement evaluate rho sigma
  · exact Set.singleton_subset_iff.mpr (Set.mem_univ 0)
  · intro _ _
    rfl

end D5.S3.Observer.Separation.RefinementDistanceMonotonicity
