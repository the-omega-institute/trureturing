import D5.S3.Observer.Chronology.TruncatedTensorHopf
import Mathlib.Algebra.Algebra.Bilinear
import Mathlib.Algebra.Lie.Free
import Mathlib.Algebra.Lie.OfAssociative
import Mathlib.Tactic

/-!
# Step-two free Lie bridge

The universal degree-two chronological defect has two standard presentations.
In the tensor square it is the alternant `x⊗y-y⊗x`. In the free Lie algebra it
is the bracket of the two free generators. Every map from generators into an
associative algebra extends uniquely to a Lie representation, and both
presentations map to the same ring commutator.

This module proves that correspondence and applies it to the two-event tensor
Magnus coordinate. It does not prove injectivity of the degree-two bracket
map in arbitrary characteristic, construct a Hall basis, invoke PBW as a new
repository theorem, or complete the free Lie algebra analytically.
-/

/- Library-search audit trail (2026-09-01):
   * `TruncatedTensorSignature` owns the alternating tensor commutator and the
     two-event tensor Magnus identity.
   * `TruncatedTensorHopf` owns the group-like and flip-primitive component
     equations.
   * Pinned Mathlib supplies `FreeLieAlgebra.of`, its universal lift, the
     associative-algebra Lie structure, and the tensor multiplication map
     `LinearMap.mul'`.
   * Repository search found no existing theorem identifying the tensor
     alternant and the free Lie bracket under every associative
     representation. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped TensorProduct

namespace D5.S3.Observer.Chronology.StepTwoFreeLieBridge

open D5.S3.Observer.Chronology.TruncatedTensorSignature

universe u v w

variable {R : Type u} {Generator : Type v}
variable [CommRing R]

/-- The degree-two free Lie word generated by an ordered pair. -/
def freeLieDegreeTwo (left right : Generator) :
    FreeLieAlgebra R Generator :=
  ⁅FreeLieAlgebra.of R left, FreeLieAlgebra.of R right⁆

/-- Reversing the generator pair negates the degree-two free Lie word. -/
theorem free_lie_degree_two_swap (left right : Generator) :
    freeLieDegreeTwo (R := R) right left =
      -freeLieDegreeTwo (R := R) left right := by
  simpa [freeLieDegreeTwo] using
    (lie_skew (FreeLieAlgebra.of R right)
      (FreeLieAlgebra.of R left)).symm

/-- A repeated free generator has zero degree-two bracket. -/
theorem free_lie_degree_two_self (value : Generator) :
    freeLieDegreeTwo (R := R) value value = 0 := by
  simp [freeLieDegreeTwo]

section Representation

variable {A : Type w} [Ring A] [Algebra R A]

attribute [local instance 100] LieRing.ofAssociativeRing

/-- The universal free Lie representation generated by a map into an
associative algebra. -/
def freeLieRepresentation (generator : Generator → A) :
    FreeLieAlgebra R Generator →ₗ⁅R⁆ A :=
  FreeLieAlgebra.lift R generator

@[simp]
theorem free_lie_representation_of
    (generator : Generator → A) (value : Generator) :
    freeLieRepresentation (R := R) generator
        (FreeLieAlgebra.of R value) =
      generator value := by
  exact FreeLieAlgebra.lift_of_apply generator value

/-- The free Lie degree-two word is represented by the ordinary associative
ring commutator. -/
theorem free_lie_representation_degree_two
    (generator : Generator → A) (left right : Generator) :
    freeLieRepresentation (R := R) generator
        (freeLieDegreeTwo (R := R) left right) =
      generator left * generator right -
        generator right * generator left := by
  simp [freeLieRepresentation, freeLieDegreeTwo,
    LieRing.of_associative_ring_bracket]

/-- Multiplication of the alternating pure tensor gives the associative ring
commutator. -/
theorem tensor_commutator_mul
    (left right : A) :
    LinearMap.mul' R A
        (tensorCommutator (R := R) left right) =
      left * right - right * left := by
  simp [tensorCommutator]

/-- The tensor alternant and free Lie bracket have the same image under every
associative representation of the generators. -/
theorem tensor_commutator_eq_free_lie_representation
    (generator : Generator → A) (left right : Generator) :
    LinearMap.mul' R A
        (tensorCommutator (R := R)
          (generator left) (generator right)) =
      freeLieRepresentation (R := R) generator
        (freeLieDegreeTwo (R := R) left right) := by
  rw [tensor_commutator_mul,
    free_lie_representation_degree_two]

/-- The represented two-event tensor Magnus coordinate is exactly the image
of the degree-two free Lie bracket. -/
theorem represented_two_event_magnus_eq_free_lie
    (generator : Generator → A) (left right : Generator) :
    LinearMap.mul' R A
        (doubledTensorMagnus
          (eventTensorSignature (R := R) (generator left) *
            eventTensorSignature (R := R) (generator right))) =
      freeLieRepresentation (R := R) generator
        (freeLieDegreeTwo (R := R) left right) := by
  rw [doubled_tensor_magnus_two_events]
  exact tensor_commutator_eq_free_lie_representation
    generator left right

end Representation

example :
    freeLieDegreeTwo (R := ℤ) true true = 0 := by
  exact free_lie_degree_two_self true

#print axioms free_lie_degree_two_swap
#print axioms free_lie_degree_two_self
#print axioms free_lie_representation_degree_two
#print axioms tensor_commutator_mul
#print axioms tensor_commutator_eq_free_lie_representation
#print axioms represented_two_event_magnus_eq_free_lie

end D5.S3.Observer.Chronology.StepTwoFreeLieBridge
