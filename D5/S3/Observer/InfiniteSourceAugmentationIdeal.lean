   generality: G
   mirror-B: D5/B/S3/Observer/InfiniteSourceAugmentationIdeal
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: The infinite square-zero source augmentation ideal is not finitely generated. -/

import Mathlib.Algebra.DualNumber
import Mathlib.Algebra.MvPolynomial.Variables
import Mathlib.RingTheory.Finiteness.Defs
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Noetherian.Defs
import Mathlib.Tactic

/- Library-search audit trail (2026-09-04):
   * Repository searches for infinite source ideals, augmentation ideals, non-finite generation,
     and non-Noetherian quotient rings found no exact theorem or canonical primitive.
   * Pinned Mathlib has finite-index generation results but no exact infinite-index theorem.
     The proof applies `MvPolynomial.eval₂Hom_eq_constantCoeff_of_vars`,
     `Ideal.Quotient.lift`, `Submodule.FG`, and `isNoetherianRing_iff_ideal_fg`.
   * GitHub code searches in the Lean ecosystem for the carrier and conclusion found no hit. -/

open scoped DualNumber

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

namespace D5.S3.Observer.InfiniteSourceAugmentationIdeal

/-- The polynomial algebra with one source coordinate for each integer offset. -/
abbrev SourcePolynomial := MvPolynomial ℤ ℂ

/-- The ideal imposing square zero separately on every source coordinate. -/
def squareRelations : Ideal SourcePolynomial :=
  Ideal.span (Set.range fun h : ℤ => MvPolynomial.X h ^ 2)

/-- The infinite source algebra with coordinatewise square-zero relations. -/
abbrev InfiniteSourceAlgebra := SourcePolynomial ⧸ squareRelations

/-- The image of the source coordinate indexed by `h` in the quotient algebra. -/
def sourceVariable (h : ℤ) : InfiniteSourceAlgebra :=
  Ideal.Quotient.mk squareRelations (MvPolynomial.X h)

/-- The augmentation ideal generated by all nonconstant source coordinates. -/
def augmentationIdeal : Ideal InfiniteSourceAlgebra :=
  Ideal.span (Set.range sourceVariable)

private def polynomialEvaluation (h : ℤ) : SourcePolynomial →+* DualNumber ℂ :=
  MvPolynomial.eval₂Hom (TrivSqZeroExt.inlHom ℂ ℂ)
    (fun j => if j = h then DualNumber.eps else 0)

private theorem square_relations_le_evaluation_kernel (h : ℤ) :
    squareRelations ≤ RingHom.ker (polynomialEvaluation h) := by
  rw [squareRelations, Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  simp [polynomialEvaluation]

private def sourceEvaluation (h : ℤ) : InfiniteSourceAlgebra →+* DualNumber ℂ :=
  Ideal.Quotient.lift squareRelations (polynomialEvaluation h)
    (fun _ hp => RingHom.mem_ker.mp (square_relations_le_evaluation_kernel h hp))

@[simp] private theorem source_evaluation_source_variable_same (h : ℤ) :
    sourceEvaluation h (sourceVariable h) = DualNumber.eps := by
  simp [sourceEvaluation, sourceVariable, polynomialEvaluation]

private theorem source_variable_mem_augmentation_ideal (h : ℤ) :
    sourceVariable h ∈ augmentationIdeal := by
  exact Ideal.mem_span_range_self

private theorem square_relations_le_constant_coeff_kernel :
    squareRelations ≤ RingHom.ker (MvPolynomial.constantCoeff : SourcePolynomial →+* ℂ) := by
  rw [squareRelations, Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  simp

private def constantTerm : InfiniteSourceAlgebra →+* ℂ :=
  Ideal.Quotient.lift squareRelations MvPolynomial.constantCoeff
    (fun _ hp => RingHom.mem_ker.mp (square_relations_le_constant_coeff_kernel hp))

@[simp] private theorem constant_term_source_variable (h : ℤ) :
    constantTerm (sourceVariable h) = 0 := by
  simp [constantTerm, sourceVariable]

private theorem augmentation_ideal_le_constant_term_kernel :
    augmentationIdeal ≤ RingHom.ker constantTerm := by
  rw [augmentationIdeal, Ideal.span_le]
  rintro _ ⟨j, rfl⟩
  simp

private noncomputable def representative (x : InfiniteSourceAlgebra) : SourcePolynomial :=
  Classical.choose (Ideal.Quotient.mk_surjective x)

private theorem representative_spec (x : InfiniteSourceAlgebra) :
    Ideal.Quotient.mk squareRelations (representative x) = x :=
  Classical.choose_spec (Ideal.Quotient.mk_surjective x)

private theorem representative_constant_coeff_eq_zero {x : InfiniteSourceAlgebra}
    (hx : x ∈ augmentationIdeal) : MvPolynomial.constantCoeff (representative x) = 0 := by
  have hxker : x ∈ RingHom.ker constantTerm := augmentation_ideal_le_constant_term_kernel hx
  rw [RingHom.mem_ker] at hxker
  rw [← representative_spec x, constantTerm, Ideal.Quotient.lift_mk] at hxker
  exact hxker

private theorem finite_family_has_fresh_source
    (s : Finset InfiniteSourceAlgebra) (hs : (s : Set InfiniteSourceAlgebra) ⊆ augmentationIdeal) :
    ∃ h : ℤ, sourceVariable h ∉ Ideal.span (s : Set InfiniteSourceAlgebra) := by
  classical
  let used : Finset ℤ := s.biUnion fun x => (representative x).vars
  obtain ⟨h, hnot⟩ : ∃ h : ℤ, h ∉ used := used.exists_notMem
  have hvanish (x : InfiniteSourceAlgebra) (hx : x ∈ s) : sourceEvaluation h x = 0 := by
    rw [← representative_spec x, sourceEvaluation, Ideal.Quotient.lift_mk]
    unfold polynomialEvaluation
    rw [MvPolynomial.eval₂Hom_eq_constantCoeff_of_vars]
    · rw [representative_constant_coeff_eq_zero (hs hx)]
      simp
    · intro j hj
      have hjne : j ≠ h := by
        intro hjh
        subst j
        exact hnot (Finset.mem_biUnion.mpr ⟨x, hx, hj⟩)
      simp [hjne]
  refine ⟨h, ?_⟩
  intro hmem
  have hspan_le : Ideal.span (s : Set InfiniteSourceAlgebra) ≤
      RingHom.ker (sourceEvaluation h) := by
    rw [Ideal.span_le]
    intro x hx
    exact RingHom.mem_ker.mpr (hvanish x hx)
  have hfresh_zero : sourceEvaluation h (sourceVariable h) = 0 :=
    RingHom.mem_ker.mp (hspan_le hmem)
  have heps_zero : (DualNumber.eps : DualNumber ℂ) = 0 := by
    simpa using hfresh_zero
  have hone_zero : (1 : ℂ) = 0 := by
    simpa using congrArg TrivSqZeroExt.snd heps_zero
  exact one_ne_zero hone_zero

/-- Every finite family in the augmentation ideal misses a fresh source coordinate. Consequently
the augmentation ideal is not finitely generated and the infinite source algebra is not
Noetherian. -/
theorem infinite_source_augmentation_ideal_not_finitely_generated :
    (∀ s : Finset InfiniteSourceAlgebra,
        (s : Set InfiniteSourceAlgebra) ⊆ augmentationIdeal →
          ∃ h : ℤ, sourceVariable h ∉ Ideal.span (s : Set InfiniteSourceAlgebra)) ∧
      ¬ augmentationIdeal.FG ∧
      ¬ IsNoetherianRing InfiniteSourceAlgebra := by
  have hfresh := finite_family_has_fresh_source
  have hnotfg : ¬ augmentationIdeal.FG := by
    intro hfg
    obtain ⟨s, hs⟩ := hfg
    have hsubset : (s : Set InfiniteSourceAlgebra) ⊆ augmentationIdeal := by
      intro x hx
      rw [← hs]
      exact Ideal.subset_span hx
    obtain ⟨h, hnot⟩ := hfresh s hsubset
    apply hnot
    rw [hs]
    exact source_variable_mem_augmentation_ideal h
  refine ⟨hfresh, hnotfg, ?_⟩
  intro hnoetherian
  exact hnotfg ((isNoetherianRing_iff_ideal_fg InfiniteSourceAlgebra).mp hnoetherian
    augmentationIdeal)

#print axioms infinite_source_augmentation_ideal_not_finitely_generated

end D5.S3.Observer.InfiniteSourceAugmentationIdeal
