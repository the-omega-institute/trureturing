/-- The equivalence relation bundled from the source kernel `K(Q)`
(`FORMAL_OBSERVER_COMPLETION_REFLECTION.md`, lines 16315-16326). -/
abbrev protocolSetoid {Protocol State Observation : Type*}
    (available : Set Protocol) (evaluate : Protocol -> State -> Observation) :
    Setoid State :=
  Setoid.ker
    (jointReadout (fun protocol : available => evaluate protocol.1))

/-- The source quotient `X / K(Q)` (lines 16513-16516). -/
abbrev ProtocolQuotient {Protocol State Observation : Type*}
    (available : Set Protocol) (evaluate : Protocol -> State -> Observation) : Type _ :=
  Quotient (protocolSetoid available evaluate)

/-- The bundled relation is exactly the already formalized source kernel. -/
theorem protocolSetoid_rel_iff_mem_indistinguishability
    {Protocol State Observation : Type*}
    (available : Set Protocol) (evaluate : Protocol -> State -> Observation)
    (left right : State) :
    protocolSetoid available evaluate left right <->
      (left, right) ∈ experimentIndistinguishability available evaluate := by
  constructor
  · intro sameSignature
    simp only [experimentIndistinguishability, Set.mem_iInter, Set.mem_setOf_eq]
    intro protocol protocolAvailable
    exact congrFun sameSignature ⟨protocol, protocolAvailable⟩
  · intro indistinguishable
    funext protocol
    exact Set.mem_iInter.1 (Set.mem_iInter.1 indistinguishable protocol.1) protocol.2

/-- A finite state quotient generated by an arbitrary protocol family has an
exact finite subfamily certificate using at most one fewer protocol than the
number of target quotient classes (source lines 16509-16536). -/
theorem finite_protocol_subfamily_card_le_quotient_card_sub_one
    {Protocol State Observation : Type*} [Finite State]
    (available : Set Protocol) (evaluate : Protocol -> State -> Observation) :
    ∃ selected : Finset Protocol,
      (selected : Set Protocol) ⊆ available ∧
        experimentIndistinguishability (selected : Set Protocol) evaluate =
          experimentIndistinguishability available evaluate ∧
        selected.card ≤ Nat.card (ProtocolQuotient available evaluate) - 1 := by
  classical
  by_cases stateNonempty : Nonempty State
  · letI : Nonempty State := stateNonempty
    let signature :=
      jointReadout (fun protocol : available => evaluate protocol.1)
    let Classes := Set.range signature
    let classify : State -> Classes := fun state =>
      ⟨signature state, ⟨state, rfl⟩⟩
    letI : Finite Classes := Finite.Set.finite_range signature
    have classifySurjective : Function.Surjective classify := by
      rintro ⟨_, state, rfl⟩
      exact ⟨state, rfl⟩
    have classExact : ∀ left right,
        classify left = classify right <->
          ∀ protocol ∈ available,
            evaluate protocol left = evaluate protocol right := by
      intro left right
      constructor
      · intro sameClass protocol protocolAvailable
        have sameSignature : signature left = signature right :=
          congrArg Subtype.val sameClass
        exact congrFun sameSignature ⟨protocol, protocolAvailable⟩
      · intro allEqual
        apply Subtype.ext
        funext protocol
        exact allEqual protocol.1 protocol.2
    obtain ⟨initial, initialSubset, initialExact⟩ :=
      finite_distinguishing_certificate evaluate available classify
        classifySurjective classExact
    have initialKernel :
        experimentIndistinguishability (initial : Set Protocol) evaluate =
          experimentIndistinguishability available evaluate := by
      ext pair
      simp only [experimentIndistinguishability, Set.mem_iInter,
        Set.mem_setOf_eq]
      exact (initialExact pair.1 pair.2).symm.trans
        (classExact pair.1 pair.2)
    let candidates : Finset (Finset Protocol) :=
      initial.powerset.filter fun candidate : Finset Protocol =>
      experimentIndistinguishability (candidate : Set Protocol) evaluate =
        experimentIndistinguishability available evaluate
    have initialCandidate : initial ∈ candidates := by
      simp [candidates, initialKernel]
    obtain ⟨selected, selectedCandidate, selectedMinimal⟩ :=
      Finset.exists_min_image candidates Finset.card
        ⟨initial, initialCandidate⟩
    have selectedSubsetInitial : selected ⊆ initial :=
      Finset.mem_powerset.mp (Finset.mem_filter.mp selectedCandidate).1
    have selectedKernel :
        experimentIndistinguishability (selected : Set Protocol) evaluate =
          experimentIndistinguishability available evaluate :=
      (Finset.mem_filter.mp selectedCandidate).2
    have selectedSubsetAvailable : (selected : Set Protocol) ⊆ available := by
      intro protocol protocolSelected
      exact initialSubset (selectedSubsetInitial protocolSelected)
    have deletionWitness : ∀ protocol : selected,
        ∃ left right : State,
          (∀ candidate ∈ selected.erase protocol.1,
            evaluate candidate left = evaluate candidate right) ∧
          evaluate protocol.1 left ≠ evaluate protocol.1 right := by
      intro protocol
      have erasedNotExact :
          experimentIndistinguishability
              (selected.erase protocol.1 : Finset Protocol) evaluate ≠
            experimentIndistinguishability available evaluate := by
        intro erasedExact
        have erasedCandidate : selected.erase protocol.1 ∈ candidates := by
          apply Finset.mem_filter.mpr
          refine ⟨Finset.mem_powerset.mpr ?_, erasedExact⟩
          exact (Finset.erase_subset _ _).trans selectedSubsetInitial
        have minimumCard := selectedMinimal _ erasedCandidate
        exact (not_lt_of_ge minimumCard)
          (Finset.card_erase_lt_of_mem protocol.2)
      have erasedNotSelected :
          experimentIndistinguishability
              (selected.erase protocol.1 : Finset Protocol) evaluate ≠
            experimentIndistinguishability (selected : Set Protocol) evaluate := by
        intro erasedSelected
        exact erasedNotExact (erasedSelected.trans selectedKernel)
      have selectedSubsetErased :
          experimentIndistinguishability (selected : Set Protocol) evaluate ⊆
            experimentIndistinguishability
              (selected.erase protocol.1 : Finset Protocol) evaluate :=
        expansion_shrinks_indistinguishability
          (selected.erase protocol.1 : Set Protocol) (selected : Set Protocol)
          evaluate (Finset.erase_subset _ _)
      have selectedStrictErased :
          experimentIndistinguishability (selected : Set Protocol) evaluate ⊂
            experimentIndistinguishability
              (selected.erase protocol.1 : Finset Protocol) evaluate :=
        (Set.ssubset_iff_subset_ne).2
          ⟨selectedSubsetErased, erasedNotSelected.symm⟩
      obtain ⟨pair, pairInErased, pairNotInSelected⟩ :=
        Set.exists_of_ssubset selectedStrictErased
      refine ⟨pair.1, pair.2, ?_, ?_⟩
      · intro candidate candidateErased
        exact Set.mem_iInter.1
          (Set.mem_iInter.1 pairInErased candidate) candidateErased
      · intro protocolEqual
        apply pairNotInSelected
        simp only [experimentIndistinguishability, Set.mem_iInter,
          Set.mem_setOf_eq]
        intro candidate candidateSelected
        by_cases candidateIsProtocol : candidate = protocol.1
        · simpa [candidateIsProtocol] using protocolEqual
        · exact Set.mem_iInter.1
            (Set.mem_iInter.1 pairInErased candidate)
            (Finset.mem_erase.mpr ⟨candidateIsProtocol, candidateSelected⟩)
    let selectedAvailable : selected -> available := fun protocol =>
      ⟨protocol.1, selectedSubsetAvailable protocol.2⟩
    let stageReadout :
        Fin (selected.card + 1) -> Classes -> selected -> Option Observation :=
      fun stage quotientClass protocol =>
        if (selected.equivFin protocol).val < stage.val then
          some (quotientClass.1 (selectedAvailable protocol))
        else
          none
    have stageStrict : ∀ stage : Fin selected.card,
        StrictlyRefines (stageReadout stage.castSucc)
          (stageReadout stage.succ) := by
      intro stage
      let protocol : selected := selected.equivFin.symm stage
      obtain ⟨left, right, otherEqual, protocolDifferent⟩ :=
        deletionWitness protocol
      constructor
      · intro leftClass rightClass fineEqual
        funext candidate
        have coordinateEqual := congrFun fineEqual candidate
        by_cases candidateActive :
            (selected.equivFin candidate).val < stage.val
        · have candidateActiveFine :
              (selected.equivFin candidate).val < stage.succ.val := by
            exact candidateActive.trans (Nat.lt_succ_self stage.val)
          change
            (if (selected.equivFin candidate).val < stage.succ.val then
                some (leftClass.1 (selectedAvailable candidate))
              else none) =
              (if (selected.equivFin candidate).val < stage.succ.val then
                some (rightClass.1 (selectedAvailable candidate))
              else none) at coordinateEqual
          rw [if_pos candidateActiveFine, if_pos candidateActiveFine] at coordinateEqual
          change
            (if (selected.equivFin candidate).val < stage.val then
                some (leftClass.1 (selectedAvailable candidate))
              else none) =
              (if (selected.equivFin candidate).val < stage.val then
                some (rightClass.1 (selectedAvailable candidate))
              else none)
          rw [if_pos candidateActive, if_pos candidateActive]
          exact coordinateEqual
        · change
            (if (selected.equivFin candidate).val < stage.val then
                some (leftClass.1 (selectedAvailable candidate))
              else none) =
              (if (selected.equivFin candidate).val < stage.val then
                some (rightClass.1 (selectedAvailable candidate))
              else none)
          rw [if_neg candidateActive, if_neg candidateActive]
      · refine ⟨classify left, classify right, ?_, ?_⟩
        · funext candidate
          by_cases candidateActive :
              (selected.equivFin candidate).val < stage.val
          · have candidateNeProtocol : candidate.1 ≠ protocol.1 := by
              intro sameValue
              have sameProtocol : candidate = protocol := Subtype.ext sameValue
              subst candidate
              have rankProtocol : selected.equivFin protocol = stage := by
                simp [protocol]
              rw [rankProtocol] at candidateActive
              exact (Nat.lt_irrefl stage.val) candidateActive
            have candidateEqual := otherEqual candidate.1
              (Finset.mem_erase.mpr ⟨candidateNeProtocol, candidate.2⟩)
            change
              (if (selected.equivFin candidate).val < stage.val then
                  some (evaluate candidate.1 left)
                else none) =
                (if (selected.equivFin candidate).val < stage.val then
                  some (evaluate candidate.1 right)
                else none)
            rw [if_pos candidateActive, if_pos candidateActive,
              candidateEqual]
          · change
              (if (selected.equivFin candidate).val < stage.val then
                  some (evaluate candidate.1 left)
                else none) =
                (if (selected.equivFin candidate).val < stage.val then
                  some (evaluate candidate.1 right)
                else none)
            rw [if_neg candidateActive, if_neg candidateActive]
        · intro fineEqual
          have protocolRank : selected.equivFin protocol = stage := by
            simp [protocol]
          have protocolActiveFine :
              (selected.equivFin protocol).val < stage.succ.val := by
            rw [protocolRank]
            exact Nat.lt_succ_self stage.val
          have coordinateEqual := congrFun fineEqual protocol
          change
            (if (selected.equivFin protocol).val < stage.succ.val then
                some (evaluate protocol.1 left)
              else none) =
              (if (selected.equivFin protocol).val < stage.succ.val then
                some (evaluate protocol.1 right)
              else none) at coordinateEqual
          rw [if_pos protocolActiveFine, if_pos protocolActiveFine] at coordinateEqual
          apply protocolDifferent
          exact Option.some.inj coordinateEqual
    have stepBound :=
      strict_refinement_steps_le_card_sub_initial_image selected.card
        stageReadout stageStrict
    have initialRange :
        Set.range (stageReadout 0) =
          {fun _ : selected => (none : Option Observation)} := by
      ext output
      constructor
      · rintro ⟨quotientClass, rfl⟩
        rw [Set.mem_singleton_iff]
        funext protocol
        simp [stageReadout]
      · intro outputConstant
        rw [Set.mem_singleton_iff] at outputConstant
        subst output
        let witnessClass : Classes := classify (Classical.choice stateNonempty)
        refine ⟨witnessClass, ?_⟩
        funext protocol
        simp [stageReadout]
    have selectedCardRangeBound : selected.card ≤ Nat.card Classes - 1 := by
      rw [initialRange] at stepBound
      simpa using stepBound
    have quotientCard :
        Nat.card (ProtocolQuotient available evaluate) = Nat.card Classes := by
      simpa [ProtocolQuotient, protocolSetoid, signature, Classes] using
        Nat.card_congr (Setoid.quotientKerEquivRange signature)
    rw [← quotientCard] at selectedCardRangeBound
    exact ⟨selected, selectedSubsetAvailable, selectedKernel,
      selectedCardRangeBound⟩
  · letI : IsEmpty State := ⟨fun state => stateNonempty ⟨state⟩⟩
    have emptyKernel :
        experimentIndistinguishability
            ((∅ : Finset Protocol) : Set Protocol) evaluate =
          experimentIndistinguishability available evaluate := by
      ext pair
      exact isEmptyElim pair.1
    refine ⟨(∅ : Finset Protocol), ?_, emptyKernel, Nat.zero_le _⟩
    intro protocol protocolSelected
    simp at protocolSelected

/-- Reverse probe for CAS-A1/A2: for the Boolean identity observer, the public
certificate cannot be empty. -/
example :
    ∃ selected : Finset Unit,
      selected.Nonempty ∧
        (selected : Set Unit) ⊆ Set.univ ∧
        experimentIndistinguishability (selected : Set Unit)
            (fun (_ : Unit) (state : Bool) => state) =
          experimentIndistinguishability Set.univ
            (fun (_ : Unit) (state : Bool) => state) := by
  obtain ⟨selected, selectedSubset, selectedKernel, _⟩ :=
    finite_protocol_subfamily_card_le_quotient_card_sub_one
      (Set.univ : Set Unit) (fun (_ : Unit) (state : Bool) => state)
  refine ⟨selected, ?_, selectedSubset, selectedKernel⟩
  rw [Finset.nonempty_iff_ne_empty]
  intro selectedEmpty
  subst selected
  have emptyAgrees :
      (false, true) ∈
        experimentIndistinguishability
          (((∅ : Finset Unit) : Set Unit))
          (fun (_ : Unit) (state : Bool) => state) := by
    simp only [experimentIndistinguishability, Set.mem_iInter,
      Set.mem_setOf_eq]
    intro protocol protocolSelected
    simp at protocolSelected
  rw [selectedKernel] at emptyAgrees
  have identityAgrees := Set.mem_iInter.1
    (Set.mem_iInter.1 emptyAgrees ()) (Set.mem_univ ())
  exact Bool.false_ne_true identityAgrees

/-- Trivialization probe for CAS-A2: the empty protocol family does not retain
the kernel of the Boolean identity observer. -/
example :
    experimentIndistinguishability
        (((∅ : Finset Unit) : Set Unit))
        (fun (_ : Unit) (state : Bool) => state) ≠
      experimentIndistinguishability Set.univ
        (fun (_ : Unit) (state : Bool) => state) := by
  intro sameKernel
  have emptyAgrees :
      (false, true) ∈
        experimentIndistinguishability
          (((∅ : Finset Unit) : Set Unit))
          (fun (_ : Unit) (state : Bool) => state) := by
    simp only [experimentIndistinguishability, Set.mem_iInter,
      Set.mem_setOf_eq]
    intro protocol protocolSelected
    simp at protocolSelected
  rw [sameKernel] at emptyAgrees
  have identityAgrees := Set.mem_iInter.1
    (Set.mem_iInter.1 emptyAgrees ()) (Set.mem_univ ())
  exact Bool.false_ne_true identityAgrees

/-- Quotient-collapse probe for CAS-A3's carrier: the two Boolean identity
signatures define distinct points of the actual kernel quotient. -/
example :
    Quotient.mk
        (protocolSetoid (Set.univ : Set Unit)
          (fun (_ : Unit) (state : Bool) => state)) false ≠
      Quotient.mk
        (protocolSetoid (Set.univ : Set Unit)
          (fun (_ : Unit) (state : Bool) => state)) true := by
  intro collapsed
  have sameSignature := Quotient.exact collapsed
  have identityAgrees := congrFun sameSignature
    (⟨(), Set.mem_univ ()⟩ : (Set.univ : Set Unit))
  exact Bool.false_ne_true identityAgrees

#print axioms finite_protocol_subfamily_card_le_quotient_card_sub_one

end D5.S3.Observer.ProtocolEvaluation.FiniteProtocolCompression
