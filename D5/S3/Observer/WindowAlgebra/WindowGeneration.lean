/- GID: D5/S3/Observer/WindowAlgebra/WindowGeneration
   generality: G
   mirror-B: none(waiver:formal-unit-only)
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Prove that the finite window clock and shift generate the full matrix algebra. -/

/- Library-search audit trail (2026-08-12):
   * `Algebra.subset_adjoin` and the standard `Subalgebra` closure lemmas expose
     generator, power, scalar, sum, and product membership.
   * `Matrix.matrix_eq_sum_single` expands every finite matrix into matrix units.
   * `Subalgebra.centralizer` has the general centralizer lattice API, but the
     pinned library has no concrete theorem identifying this Weyl-pair adjoin.
-/

import D5.S3.Observer.MatrixUnitCertificate
import D5.S3.ObserverMemory.PrimePowerTensorTower

namespace D5.S3.Observer.WindowAlgebra.WindowGeneration

open D5.S3.Observer.MatrixUnitCertificate
open D5.S3.Observer.WindowRegister
open D5.S3.ObserverMemory.PrimePowerTensorTower

noncomputable section

/-- The complex subalgebra generated by address reading and cyclic address updating. -/
noncomputable def windowGeneratedAlgebra (M : Nat) [NeZero M] :
    Subalgebra Complex (Matrix (ZMod M) (ZMod M) Complex) :=
  Algebra.adjoin Complex
    ({clockMatrix M, shiftMatrix M} : Set (Matrix (ZMod M) (ZMod M) Complex))

/-- Every Fourier matrix unit belongs to the algebra generated by the window clock and shift. -/
theorem matrix_unit_mem_windowGeneratedAlgebra (M : Nat) [NeZero M] (i j : ZMod M) :
    matrixUnit M i j ∈ windowGeneratedAlgebra M := by
  rw [matrixUnit]
  apply (windowGeneratedAlgebra M).mul_mem
  · apply (windowGeneratedAlgebra M).smul_mem
    · apply (windowGeneratedAlgebra M).sum_mem
      intro k _
      apply (windowGeneratedAlgebra M).smul_mem
      apply (windowGeneratedAlgebra M).pow_mem
      exact Algebra.subset_adjoin (by simp)
  · apply (windowGeneratedAlgebra M).pow_mem
    exact Algebra.subset_adjoin (by simp)

/-- Address reading and cyclic address updating generate every finite-window observable. -/
theorem window_generators_adjoin_top (M : Nat) [NeZero M] :
    windowGeneratedAlgebra M = ⊤ := by
  apply top_unique
  intro A _
  rw [Matrix.matrix_eq_sum_single A]
  apply (windowGeneratedAlgebra M).sum_mem
  intro i _
  apply (windowGeneratedAlgebra M).sum_mem
  intro j _
  have hUnit : Matrix.single i j (1 : Complex) ∈ windowGeneratedAlgebra M := by
    simpa only [matrix_unit_eq_single] using
      matrix_unit_mem_windowGeneratedAlgebra M i j
  simpa only [Matrix.smul_single, smul_eq_mul, mul_one] using
    (windowGeneratedAlgebra M).smul_mem hUnit (A i j)

/-- The generated-algebra equality and the frozen prime-power factorization hold together. -/
theorem window_generated_full_matrix_and_prime_power_factors (M : Nat) [NeZero M] :
    windowGeneratedAlgebra M = ⊤ ∧
      Function.Bijective (primePowerTensorFactorization M) :=
  ⟨window_generators_adjoin_top M, prime_power_tensor_factor_decomposition M⟩

/-- The generated algebra for the two-address window contains an off-diagonal matrix unit. -/
theorem window_two_off_diagonal_mem_generated :
    Matrix.single (0 : ZMod 2) (1 : ZMod 2) (1 : Complex) ∈
      windowGeneratedAlgebra 2 := by
  simpa only [matrix_unit_eq_single] using
    matrix_unit_mem_windowGeneratedAlgebra 2 (0 : ZMod 2) (1 : ZMod 2)

/-- The exhibited off-diagonal generated observable is nonzero. -/
theorem window_two_off_diagonal_ne_zero :
    Matrix.single (0 : ZMod 2) (1 : ZMod 2) (1 : Complex) ≠ 0 := by
  intro h
  have hEntry := congrArg
    (fun A : Matrix (ZMod 2) (ZMod 2) Complex => A 0 1) h
  rw [Matrix.single_apply, if_pos ⟨rfl, rfl⟩, Matrix.zero_apply] at hEntry
  exact one_ne_zero hEntry

/-- A concrete nonzero off-diagonal observable witnesses nontrivial window generation. -/
theorem window_two_off_diagonal_generated_witness :
    Matrix.single (0 : ZMod 2) (1 : ZMod 2) (1 : Complex) ∈
        windowGeneratedAlgebra 2 ∧
      Matrix.single (0 : ZMod 2) (1 : ZMod 2) (1 : Complex) ≠ 0 :=
  ⟨window_two_off_diagonal_mem_generated, window_two_off_diagonal_ne_zero⟩

end

end D5.S3.Observer.WindowAlgebra.WindowGeneration
