import D5.S3.Observer.AgencyHolonomy.PrimeFrequencyPhaseFlow
import Mathlib.Tactic

/-!
# Phase-twisted stable swap curvature

Attach the Fourier phase `exp (-i t omega_p)` to the memory channel indexed by
`p`. The resulting stable swap curvature depends on spectral time through the
relative channel phases. Since every Fourier phase has norm one, the pairwise
residual bound and its finite holonomy-energy aggregation remain uniform in
`time`.

The scalar relative phase is generated by the frequency difference
`omega_p - omega_q`. For logarithmic addresses this becomes
`log p - log q`, which is the additive frequency carried by a prime ratio.

This file supplies a time-dependent prime-side defect with a rigorous uniform
bound. It does not prove phase synchronization, time monotonicity, an arrow of
time, residual-envelope decay, prime-zero domination, a zero-location theorem,
or RH.
-/

/- Library-search audit trail (2026-08-30):
   * Repository searches found no existing owner for a Fourier-phase-twisted
     stable swap curvature or its finite uniform-in-time energy bound.
   * The unit-norm phase law is imported from `PrimeFrequencyPhaseFlow`.
   * The pairwise residual estimate and finite energy aggregation are imported
     from the two preceding AgencyHolonomy truth sources and specialized here. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Observer.AgencyHolonomy.PhaseTwistedStableSwapCurvature

open D5.S3.Observer.AgencyHolonomy.PrimeFrequencyPhaseFlow
open D5.S3.Observer.AgencyHolonomy.StableResidualSwapCurvatureBound
open D5.S3.Observer.AgencyHolonomy.FiniteHolonomyEnergy

noncomputable section

universe u

/-- A memory channel rotated by its unitary Fourier phase. -/
noncomputable def phaseTwistedChannel
    (frequency time : ℝ) (channel : ℂ) : ℂ :=
  fourierPhase frequency time * channel

/-- Stable residual swap curvature after rotating the two memory channels by
their frequency phases at a common spectral time. -/
noncomputable def phaseTwistedStableSwapCurvature
    (stable residualP residualQ channelP channelQ : ℂ)
    (frequencyP frequencyQ time : ℝ) : ℂ :=
  stableResidualSwapCurvature stable residualP residualQ
    (phaseTwistedChannel frequencyP time channelP)
    (phaseTwistedChannel frequencyQ time channelQ)

/-- Finite ordered-pair energy of the phase-twisted stable swap curvature. -/
noncomputable def phaseTwistedStableHolonomyEnergy
    {ι : Type u} [Fintype ι]
    (stable : ℂ)
    (residual channel : ι → ℂ)
    (frequency : ι → ℝ)
    (time : ℝ) : ℝ :=
  stableResidualHolonomyEnergy stable residual fun p =>
    phaseTwistedChannel (frequency p) time (channel p)

/-- A unitary Fourier twist preserves the norm of a memory channel. -/
theorem phase_twisted_channel_norm
    (frequency time : ℝ) (channel : ℂ) :
    ‖phaseTwistedChannel frequency time channel‖ = ‖channel‖ := by
  have hPhaseNorm : ‖fourierPhase frequency time‖ = 1 :=
    (fourier_phase_character_laws frequency 0 time 0).2.2.2.1
  simp [phaseTwistedChannel, norm_mul, hPhaseNorm]

/-- The phase at the frequency difference reconstructs one channel phase from
the other. This is the scalar relative-frequency law. -/
theorem relative_phase_reconstruction
    (frequencyP frequencyQ time : ℝ) :
    fourierPhase (frequencyP - frequencyQ) time *
        fourierPhase frequencyQ time =
      fourierPhase frequencyP time := by
  have hAdd :=
    (fourier_phase_character_laws
      (frequencyP - frequencyQ) frequencyQ time 0).2.2.1
  simpa using hAdd.symm

/-- For logarithmic addresses, relative phase is controlled by the logarithmic
frequency difference. -/
theorem relative_log_address_phase_reconstruction
    (addressP addressQ : ℕ) (time : ℝ) :
    fourierPhase
        (Real.log (addressP : ℝ) - Real.log (addressQ : ℝ)) time *
        logAddressPhase addressQ time =
      logAddressPhase addressP time := by
  simpa [logAddressPhase] using
    relative_phase_reconstruction
      (Real.log (addressP : ℝ)) (Real.log (addressQ : ℝ)) time

/-- At zero spectral time, every phase twist is the identity and the original
stable residual curvature is recovered exactly. -/
theorem phase_twisted_curvature_zero_time
    (stable residualP residualQ channelP channelQ : ℂ)
    (frequencyP frequencyQ : ℝ) :
    phaseTwistedStableSwapCurvature stable residualP residualQ
        channelP channelQ frequencyP frequencyQ 0 =
      stableResidualSwapCurvature stable residualP residualQ
        channelP channelQ := by
  simp [phaseTwistedStableSwapCurvature, phaseTwistedChannel, fourierPhase]

/--
The phase-twisted curvature has the same exact linear-quadratic decomposition
as the untwisted curvature with rotated channels. Because the rotations are
unitary, the residual norm bounds are unchanged and uniform in spectral time.
-/
theorem phase_twisted_stable_swap_curvature_bound
    (stable residualP residualQ channelP channelQ : ℂ)
    (frequencyP frequencyQ time : ℝ)
    (hChannelP : ‖channelP‖ ≤ 1)
    (hChannelQ : ‖channelQ‖ ≤ 1) :
    phaseTwistedStableSwapCurvature stable residualP residualQ
        channelP channelQ frequencyP frequencyQ time =
      (stable - 1) *
          (residualP * phaseTwistedChannel frequencyP time channelP -
            residualQ * phaseTwistedChannel frequencyQ time channelQ) +
        residualP * residualQ *
          (phaseTwistedChannel frequencyQ time channelQ -
            phaseTwistedChannel frequencyP time channelP) ∧
    ‖phaseTwistedStableSwapCurvature stable residualP residualQ
        channelP channelQ frequencyP frequencyQ time‖ ≤
      ‖stable - 1‖ * (‖residualP‖ + ‖residualQ‖) +
        2 * (‖residualP‖ * ‖residualQ‖) ∧
    ∀ envelope : ℝ,
      0 ≤ envelope →
      ‖residualP‖ ≤ envelope →
      ‖residualQ‖ ≤ envelope →
      ‖phaseTwistedStableSwapCurvature stable residualP residualQ
          channelP channelQ frequencyP frequencyQ time‖ ≤
        2 * ‖stable - 1‖ * envelope + 2 * envelope ^ 2 := by
  have hTwistedChannelP :
      ‖phaseTwistedChannel frequencyP time channelP‖ ≤ 1 := by
    rw [phase_twisted_channel_norm]
    exact hChannelP
  have hTwistedChannelQ :
      ‖phaseTwistedChannel frequencyQ time channelQ‖ ≤ 1 := by
    rw [phase_twisted_channel_norm]
    exact hChannelQ
  have hBound :=
    stable_residual_swap_curvature_bound stable residualP residualQ
      (phaseTwistedChannel frequencyP time channelP)
      (phaseTwistedChannel frequencyQ time channelQ)
      hTwistedChannelP hTwistedChannelQ
  simpa [phaseTwistedStableSwapCurvature] using hBound

/--
For a finite family, unitary frequency phases do not worsen the cardinal-square
residual bound on stable holonomy energy. The estimate is uniform in time, and
zero energy remains equivalent to vanishing of every phase-twisted pairwise
curvature.
-/
theorem phase_twisted_finite_holonomy_energy_bound
    {ι : Type u} [Fintype ι]
    (stable : ℂ)
    (residual channel : ι → ℂ)
    (frequency : ι → ℝ)
    (time envelope : ℝ)
    (hEnvelope : 0 ≤ envelope)
    (hChannel : ∀ p, ‖channel p‖ ≤ 1)
    (hResidual : ∀ p, ‖residual p‖ ≤ envelope) :
    0 ≤ phaseTwistedStableHolonomyEnergy
      stable residual channel frequency time ∧
    phaseTwistedStableHolonomyEnergy
        stable residual channel frequency time ≤
      (Fintype.card ι : ℝ) ^ 2 *
        (2 * ‖stable - 1‖ * envelope + 2 * envelope ^ 2) ^ 2 ∧
    (phaseTwistedStableHolonomyEnergy
          stable residual channel frequency time = 0 ↔
      ∀ p q,
        phaseTwistedStableSwapCurvature stable
          (residual p) (residual q) (channel p) (channel q)
          (frequency p) (frequency q) time = 0) ∧
    (envelope = 0 →
      phaseTwistedStableHolonomyEnergy
        stable residual channel frequency time = 0) := by
  have hTwistedChannel :
      ∀ p, ‖phaseTwistedChannel (frequency p) time (channel p)‖ ≤ 1 := by
    intro p
    rw [phase_twisted_channel_norm]
    exact hChannel p
  have hEnergy :=
    finite_stable_holonomy_energy_bound stable residual
      (fun p => phaseTwistedChannel (frequency p) time (channel p))
      envelope hEnvelope hTwistedChannel hResidual
  simpa [phaseTwistedStableHolonomyEnergy,
    phaseTwistedStableSwapCurvature] using hEnergy

#print axioms phase_twisted_channel_norm
#print axioms relative_phase_reconstruction
#print axioms relative_log_address_phase_reconstruction
#print axioms phase_twisted_curvature_zero_time
#print axioms phase_twisted_stable_swap_curvature_bound
#print axioms phase_twisted_finite_holonomy_energy_bound

end

end D5.S3.Observer.AgencyHolonomy.PhaseTwistedStableSwapCurvature
