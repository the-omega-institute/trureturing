/- GID: D5/S3/Observer/MeasureSeparation/FactorizedTranscriptKernelBarrier
   generality: G
   mirror-B: D5/B/S3/Observer/MeasureSeparation/FactorizedTranscriptKernelBarrier
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Factorized laws and finite repetitions agree on fibers, including zero samples. -/

import Mathlib.MeasureTheory.Measure.DiracProba
import Mathlib.MeasureTheory.Measure.FiniteMeasurePi

/- Library-search audit trail (2026-08-25):
   * Searches in `ObserverMemory` and `ConceptDynamics/Fibers` found deterministic
     fiber results, but no state-indexed probability-law factorization theorem.
   * `KernelTranscriptInvariance` starts from equal laws, while
     `InterventionFamilyTranscriptObstruction` assumes law-profile equality; neither
     exposes the source equation `K = reduced ∘ q`.
   * Pinned Mathlib hits include `ProbabilityTheory.Kernel.comp`, `Kernel.prod`,
     `Measure.map`, `Function.Injective`, `Function.FactorsThrough`, `Setoid.ker`,
     `Measure.pi`, and `ProbabilityMeasure.pi`. No canonical `Function.fiber` was found.
   * `ProbabilityMeasure.pi` is used for finite iid products. A Mathlib `Kernel` would
     add state-side measurability absent from the source, so the named law family below
     is the faithful weaker interface. Primality has no role in any declaration. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

noncomputable section

open MeasureTheory

namespace D5.S3.Observer.MeasureSeparation.FactorizedTranscriptKernelBarrier

/-- A transcript kernel is exactly the source's state-indexed family of conditional
probability distributions; no unasserted measurability in the state is imposed. -/
abbrev TranscriptKernel (X Y : Type*) [MeasurableSpace Y] :=
  X → ProbabilityMeasure Y

/-- The transcript law depends on the state only through the interface `q`. -/
def KernelFactorsThrough {X B Y : Type*} [MeasurableSpace Y]
    (q : X → B) (K : TranscriptKernel X Y) : Prop :=
  ∃ reduced : TranscriptKernel B Y, K = reduced ∘ q

/-- A length-`n` transcript law, allowing arbitrary dependence among its coordinates. -/
abbrev RepeatedTranscriptKernel (n : Nat) (X Y : Type*) [MeasurableSpace Y] :=
  TranscriptKernel X (Fin n → Y)

/-- The conditionally independent length-`n` transcript generated by a one-shot law. -/
noncomputable def iidRepetition {X Y : Type*} [MeasurableSpace Y]
    (n : Nat) (K : TranscriptKernel X Y) : RepeatedTranscriptKernel n X Y :=
  fun x ↦ ProbabilityMeasure.pi (fun _ : Fin n ↦ K x)

/-- Exact identification at the level of transcript laws requires equal-law states to
have equal target values. -/
def IdentifiesTarget {X Y Target : Type*} [MeasurableSpace Y]
    (K : TranscriptKernel X Y) (T : X → Target) : Prop :=
  ∀ x y : X, K x = K y → T x = T y

/-- FPOD 121.2, first clause: factorization makes the law constant on each `q`-fiber. -/
theorem factorized_transcript_kernel_eq_on_fiber
    {X B Y : Type*} [MeasurableSpace Y]
    (q : X → B) (K : TranscriptKernel X Y) (x y : X)
    (hFactor : KernelFactorsThrough q K) (sameFiber : q x = q y) :
    K x = K y := by
  obtain ⟨reduced, hK⟩ := hFactor
  rw [hK]
  exact congrArg reduced sameFiber
#print axioms factorized_transcript_kernel_eq_on_fiber

/-- Every finite iid repetition of a factorized one-shot kernel still factors through
the same interface. This includes the empty product at `n = 0`. -/
theorem iid_repetition_preserves_factorization
    {X B Y : Type*} [MeasurableSpace Y]
    (q : X → B) (K : TranscriptKernel X Y) (n : Nat)
    (hFactor : KernelFactorsThrough q K) :
    KernelFactorsThrough q (iidRepetition n K) := by
  obtain ⟨reduced, hK⟩ := hFactor
  refine ⟨iidRepetition n reduced, ?_⟩
  rw [hK]
  funext x
  rfl
#print axioms iid_repetition_preserves_factorization

/-- An arbitrary dependent length-`n` transcript law agrees on each interface fiber
whenever its whole joint law factors through that interface. -/
theorem factorized_repeated_kernel_eq_on_fiber
    {X B Y : Type*} [MeasurableSpace Y] {n : Nat}
    (q : X → B) (K : RepeatedTranscriptKernel n X Y) (x y : X)
    (hFactor : KernelFactorsThrough q K) (sameFiber : q x = q y) :
    K x = K y := by
  exact factorized_transcript_kernel_eq_on_fiber q K x y hFactor sameFiber
#print axioms factorized_repeated_kernel_eq_on_fiber

/-- A target that varies inside a `q`-fiber cannot be exactly identified by any
dependent repeated transcript whose whole joint law factors through `q`. -/
theorem factorized_repeated_kernel_cannot_identify_fiber_varying_target
    {X B Y Target : Type*} [MeasurableSpace Y] {n : Nat}
    (q : X → B) (K : RepeatedTranscriptKernel n X Y) (T : X → Target)
    (x y : X) (hFactor : KernelFactorsThrough q K)
    (sameFiber : q x = q y) (differentTarget : T x ≠ T y) :
    ¬IdentifiesTarget K T := by
  intro hIdentifies
  apply differentTarget
  exact hIdentifies x y
    (factorized_repeated_kernel_eq_on_fiber q K x y hFactor sameFiber)
#print axioms factorized_repeated_kernel_cannot_identify_fiber_varying_target

/-- The concrete counterexample interface forgets every Boolean state. -/
def booleanInterface : Bool → Unit :=
  fun _ ↦ ()

/-- The concrete counterexample target retains the Boolean state. -/
def booleanTarget : Bool → Bool :=
  id

/-- The concrete one-shot observation law is the same point mass at every state. -/
noncomputable def constantBooleanTranscriptKernel : TranscriptKernel Bool Unit :=
  fun _ ↦ diracProba ()

/-- A contrasting Boolean law records its state as a point mass. -/
noncomputable def distinguishingBooleanTranscriptKernel : TranscriptKernel Bool Bool :=
  fun b ↦ diracProba b

/-- Concrete FPOD 121.2 counterexample: for every sample count, including zero,
repeating a constant noisy law cannot identify the nonconstant Boolean target. -/
theorem boolean_target_not_identified_by_any_iid_repetition :
    ∀ n : Nat,
      ¬IdentifiesTarget (iidRepetition n constantBooleanTranscriptKernel)
        booleanTarget := by
  intro n
  have hOneShot :
      KernelFactorsThrough booleanInterface constantBooleanTranscriptKernel := by
    refine ⟨fun _ ↦ diracProba (), ?_⟩
    rfl
  apply factorized_repeated_kernel_cannot_identify_fiber_varying_target
    booleanInterface (iidRepetition n constantBooleanTranscriptKernel)
      booleanTarget false true
  · exact iid_repetition_preserves_factorization
      booleanInterface constantBooleanTranscriptKernel n hOneShot
  · rfl
  · decide
#print axioms boolean_target_not_identified_by_any_iid_repetition

/-- The factorization hypothesis is necessary: a constant Boolean interface can hide
states whose nonfactorized Dirac transcript laws are unequal. -/
theorem transcript_factorization_is_necessary :
    ∃ (q : Bool → Unit) (K : TranscriptKernel Bool Bool) (x y : Bool),
      q x = q y ∧ K x ≠ K y ∧ ¬KernelFactorsThrough q K := by
  have hDifferent :
      distinguishingBooleanTranscriptKernel false ≠
        distinguishingBooleanTranscriptKernel true := by
    change diracProba false ≠ diracProba true
    intro hEqual
    exact Bool.false_ne_true (injective_diracProba hEqual)
  refine ⟨booleanInterface, distinguishingBooleanTranscriptKernel,
    false, true, rfl, hDifferent, ?_⟩
  intro hFactor
  exact hDifferent
    (factorized_transcript_kernel_eq_on_fiber
      booleanInterface distinguishingBooleanTranscriptKernel false true hFactor rfl)
#print axioms transcript_factorization_is_necessary

/-- The same-fiber hypothesis is necessary: an identity interface supports a
factorized law that distinguishes the two different fibers. -/
theorem same_fiber_is_necessary :
    ∃ (q : Bool → Bool) (K : TranscriptKernel Bool Bool) (x y : Bool),
      KernelFactorsThrough q K ∧ q x ≠ q y ∧ K x ≠ K y := by
  refine ⟨id, distinguishingBooleanTranscriptKernel, false, true, ?_, ?_, ?_⟩
  · exact ⟨distinguishingBooleanTranscriptKernel, rfl⟩
  · exact Bool.false_ne_true
  · change diracProba false ≠ diracProba true
    intro hEqual
    exact Bool.false_ne_true (injective_diracProba hEqual)
#print axioms same_fiber_is_necessary

/-- Fiber variation is necessary for the negative conclusion: a constant target is
identified under every iid repetition of the same constant factorized kernel. -/
theorem fiber_variation_is_necessary_for_nonidentification :
    ∃ (q : Bool → Unit) (K : TranscriptKernel Bool Unit) (T : Bool → Unit),
      KernelFactorsThrough q K ∧
        ∀ n : Nat, IdentifiesTarget (iidRepetition n K) T := by
  refine ⟨booleanInterface, constantBooleanTranscriptKernel,
    fun _ ↦ (), ?_, ?_⟩
  · exact ⟨fun _ ↦ diracProba (), rfl⟩
  · intro n x y _
    rfl
#print axioms fiber_variation_is_necessary_for_nonidentification

/- Degenerate audit: injective and identity interfaces have singleton fibers. -/
example {X B Y : Type*} [MeasurableSpace Y]
    (q : X → B) (K : TranscriptKernel X Y) (hq : Function.Injective q)
    (x y : X) (sameFiber : q x = q y) : K x = K y := by
  exact congrArg K (hq sameFiber)

/- Degenerate audit: no nonemptiness assumption is needed for the empty state type. -/
example {Y : Type*} [MeasurableSpace Y]
    (q : Empty → Unit) (K : TranscriptKernel Empty Y) :
    ∀ x y, q x = q y → K x = K y := by
  intro x
  exact Empty.elim x

/- Degenerate audit: every law is constant on fibers when the state type is a singleton. -/
example {Y : Type*} [MeasurableSpace Y]
    (q : Unit → Unit) (K : TranscriptKernel Unit Y) :
    ∀ x y, q x = q y → K x = K y := by
  rintro ⟨⟩ ⟨⟩ _
  rfl

/- Degenerate audit: zero iid samples still cannot identify the varying target. -/
example :
    ¬IdentifiesTarget (iidRepetition 0 constantBooleanTranscriptKernel)
      booleanTarget :=
  boolean_target_not_identified_by_any_iid_repetition 0

end D5.S3.Observer.MeasureSeparation.FactorizedTranscriptKernelBarrier
