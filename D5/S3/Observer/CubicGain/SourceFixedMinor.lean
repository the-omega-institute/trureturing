private theorem quotient_e1 (t b : ℝ) :
    45 * (sourceE1 b).eval (t*b) = b^7*sourceQuotient 2 t b := by
  unfold sourceQuotient
  simp only [partial_Nt0,partial_Nb2,partial_Nb0,partial_Nt2,partial_Dt,partial_Db,
    expanded_D,expanded_N0,expanded_N2,pair10,pair11,pair12,
    product10,product11,product12]
  simp only [sourceE1,z10,z11,z12,eval_add,eval_mul,eval_pow,eval_C,eval_X]
  ring
/-- Exact normalization of the literal ordered source pair, with no division. -/
theorem source_e1_normalization (t b : ℝ) :
    45 * sourceD t b * (sourceE1 b).eval (t*b) =
      b^7*(sourceBt 0 t b*sourceBb 2 t b-sourceBb 0 t b*sourceBt 2 t b) := by
  rw [source_factor]
  calc
    _ = sourceD t b * (45 * (sourceE1 b).eval (t*b)) := by ring
    _ = sourceD t b * (b^7*sourceQuotient 2 t b) := by rw [quotient_e1]
    _ = _ := by ring

/-- Fixed leading coefficients of the two literal normalized minor polynomials. -/
theorem source_leading_coefficients (b : ℝ) :
    (sourceE0 b).coeff 15 = -102720*(b^2+8*b+4) ∧
    (sourceE1 b).coeff 15 = -657408*(b^2+8*b+4) := by
  constructor <;> simp [sourceE0, sourceE1, coeff_add, coeff_C_mul] <;> ring

/-- At the selected FC root both fixed degree-fifteen leading coefficients are nonzero. -/
theorem selected_root_leading_guard :
    (sourceE0 criticalRoot).coeff 15 ≠ 0 ∧
    (sourceE1 criticalRoot).coeff 15 ≠ 0 := by
  have hb : 0 < criticalRoot := by linarith [criticalRoot_spec.1]
  rw [(source_leading_coefficients criticalRoot).1,
    (source_leading_coefficients criticalRoot).2]
  constructor <;> apply mul_ne_zero (by norm_num) <;> positivity

/-- At the candidate selected-root lift, both literal source Jacobian numerators
vanish and both fixed leading coefficients stay nonzero. The same denominator
and all four interpolation samples are those of the actual whole-world circuit. -/
theorem selected_root_literal_minor_relations :
    let b := criticalRoot
    let t := liftedR b/b
    (sourceBt 0 t b*sourceBb 1 t b-sourceBb 0 t b*sourceBt 1 t b = 0) ∧
    (sourceBt 0 t b*sourceBb 2 t b-sourceBb 0 t b*sourceBt 2 t b = 0) ∧
    (sourceE0 b).coeff 15 ≠ 0 ∧ (sourceE1 b).coeff 15 ≠ 0 ∧
    sourceD t b = circuitD (t,b) ∧ sourceC t b = circuitC (t,b) ∧
    sourceNumerator t b 0 = circuitP (t,b) := by
  dsimp only
  have hb : criticalRoot ≠ 0 := ne_of_gt (by linarith [criticalRoot_spec.1])
  have ht : liftedR criticalRoot/criticalRoot*criticalRoot = liftedR criticalRoot :=
    div_mul_cancel₀ _ hb
  have h0 := source_e0_normalization (liftedR criticalRoot/criticalRoot) criticalRoot
  have h1 := source_e1_normalization (liftedR criticalRoot/criticalRoot) criticalRoot
  rw [ht,selected_root_common_roots.1,mul_zero] at h0
  rw [ht,selected_root_common_roots.2,mul_zero] at h1
  exact ⟨(mul_eq_zero.mp h0.symm).resolve_left (pow_ne_zero _ hb),
    (mul_eq_zero.mp h1.symm).resolve_left (pow_ne_zero _ hb),
    selected_root_leading_guard.1,selected_root_leading_guard.2,
    source_circuit_correspondence _ _⟩

