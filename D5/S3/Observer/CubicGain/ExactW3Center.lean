private def horner (cs : List ℤ) (x a : ℝ) : ℝ :=
  match cs with
  | [] => a
  | c :: cs => horner cs x (a * x+c)

private theorem horner_eq (cs : List ℤ) (x a : ℝ) :
    horner cs x a = a * x^cs.length + (polyDesc cs).eval x := by
  induction cs generalizing a with
  | nil => simp [horner, polyDesc]
  | cons c cs ih =>
    simp only [horner, ih, List.length_cons, polyDesc, Polynomial.eval_add,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    rw [pow_succ]
    ring

private def HornerCertificate : List ℤ → List (ℤ × ℤ) →
    ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → Prop
  | [], _, _, _, a, b, l, u => l ≤ a ∧ b ≤ u
  | _ :: _, [], _, _, _, _, _, _ => False
  | c :: cs, (a',b') :: trace, lo, hi, a, b, l, u =>
    (a' : ℝ) ≤ a * lo+c ∧ (a' : ℝ) ≤ a * hi+c ∧
    b * lo+c ≤ (b' : ℝ) ∧ b * hi+c ≤ (b' : ℝ) ∧
    HornerCertificate cs trace lo hi a' b' l u

private theorem horner_step (x lo hi a b v c l u : ℝ)
    (hx : 0 ≤ x) (hlo : lo ≤ x) (hhi : x ≤ hi)
    (ha : a ≤ v) (hb : v ≤ b)
    (hl : l ≤ a * lo+c) (hl' : l ≤ a * hi+c)
    (hu : b * lo+c ≤ u) (hu' : b * hi+c ≤ u) :
    l ≤ v * x+c ∧ v * x+c ≤ u := by
  constructor
  · have hav := mul_le_mul_of_nonneg_right ha hx
    by_cases h : 0 ≤ a
    · have := mul_le_mul_of_nonneg_left hlo h
      linarith
    · have := mul_le_mul_of_nonpos_left hhi (le_of_not_ge h)
      linarith
  · have hvb := mul_le_mul_of_nonneg_right hb hx
    by_cases h : 0 ≤ b
    · have := mul_le_mul_of_nonneg_left hhi h
      linarith
    · have := mul_le_mul_of_nonpos_left hlo (le_of_not_ge h)
      linarith

private theorem horner_bounds (cs : List ℤ) (trace : List (ℤ × ℤ))
    (x lo hi a b v l u : ℝ) (hx : 0 ≤ x) (hlo : lo ≤ x) (hhi : x ≤ hi)
    (hv : a ≤ v ∧ v ≤ b) (hc : HornerCertificate cs trace lo hi a b l u) :
    l ≤ horner cs x v ∧ horner cs x v ≤ u := by
  induction cs generalizing trace a b v with
  | nil => exact ⟨hc.1.trans hv.1, hv.2.trans hc.2⟩
  | cons c cs ih =>
    cases trace with
    | nil => exact hc.elim
    | cons ab trace =>
      exact ih trace ab.1 ab.2 (v * x+c)
        (horner_step x lo hi a b v c ab.1 ab.2 hx hlo hhi hv.1 hv.2
          hc.1 hc.2.1 hc.2.2.1 hc.2.2.2.1) hc.2.2.2.2

