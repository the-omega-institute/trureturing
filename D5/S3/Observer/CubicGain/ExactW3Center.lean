private def rootLo : ℝ := 12758053 / 100000000
private def rootHi : ℝ := 12758054 / 100000000

private theorem polyDesc_degree_le (cs : List ℤ) :
    (polyDesc cs).degree ≤ (cs.length - 1 : ℕ) := by
  induction cs with
  | nil => simp [polyDesc]
  | cons c cs ih =>
      rw [polyDesc]
      apply le_trans (Polynomial.degree_add_le _ _)
      apply max_le
      · simpa only [List.length_cons, Nat.succ_sub_one] using
          (Polynomial.degree_C_mul_X_pow_le (R := ℝ) cs.length (c : ℝ))
      · calc
          (polyDesc cs).degree ≤ (cs.length - 1 : ℕ) := ih
          _ ≤ (cs.length : ℕ) := WithBot.coe_le_coe.mpr (Nat.pred_le _)

private theorem polyDesc_degree_of_head (c : ℤ) (cs : List ℤ)
    (hc : (c : ℝ) ≠ 0) :
    (polyDesc (c :: cs)).degree = cs.length := by
  rw [polyDesc]
  have hterm0 :
      Polynomial.C (c : ℝ) * Polynomial.X ^ cs.length ≠ 0 :=
    mul_ne_zero (Polynomial.C_ne_zero.mpr hc)
      (pow_ne_zero _ Polynomial.X_ne_zero)
  have htermdeg :
      (Polynomial.C (c : ℝ) * Polynomial.X ^ cs.length).degree =
        (cs.length : WithBot ℕ) := by
    rw [Polynomial.degree_eq_natDegree hterm0,
      Polynomial.natDegree_C_mul_X_pow cs.length (c : ℝ) hc]
  have hlt : (polyDesc cs).degree <
      (Polynomial.C (c : ℝ) * Polynomial.X ^ cs.length).degree := by
    cases cs with
    | nil =>
        rw [htermdeg]
        simp [polyDesc]
    | cons d ds =>
        rw [htermdeg]
        calc
          (polyDesc (d :: ds)).degree ≤ ((d :: ds).length - 1 : ℕ) :=
            polyDesc_degree_le (d :: ds)
          _ < (d :: ds).length := by
            exact WithBot.coe_lt_coe.mpr (by simp)
  calc
    (Polynomial.C (c : ℝ) * Polynomial.X ^ cs.length + polyDesc cs).degree =
        (Polynomial.C (c : ℝ) * Polynomial.X ^ cs.length).degree :=
      Polynomial.degree_add_eq_left_of_degree_lt hlt
    _ = (cs.length : WithBot ℕ) := htermdeg

private theorem criticalPolynomial_degree : criticalPolynomial.degree = 67 := by
  rw [criticalPolynomial]
  apply polyDesc_degree_of_head
  norm_num

private theorem critical_endpoint_signs :
    0 < Polynomial.eval rootLo criticalPolynomial ∧
    Polynomial.eval rootHi criticalPolynomial < 0 := by
  norm_num [rootLo, rootHi, criticalPolynomial, polyDesc]

private theorem critical_strictAnti :
    StrictAntiOn criticalPolynomial.eval (Set.Icc rootLo rootHi) := by
  apply strictAntiOn_of_deriv_neg (convex_Icc _ _) criticalPolynomial.continuous.continuousOn
  intro x hx
  have hmem : x ∈ Set.Icc rootLo rootHi := interior_subset hx
  have h0 : 0 ≤ x := by linarith [hmem.1, show 0 < rootLo by norm_num [rootLo]]
  rw [criticalPolynomial.deriv]
  exact lt_of_le_of_lt
    (critical_derivative_bounds x h0 hmem.1
      (by dsimp [rootHi] at hmem; linarith [hmem.2])).2 (by norm_num)

private theorem refined_endpoint_signs :
    0 < criticalPolynomial.eval (127580539798972/1000000000000000) ∧
    criticalPolynomial.eval (127580539798973/1000000000000000) < 0 := by
  norm_num [criticalPolynomial, polyDesc]

/-- The exact selected algebraic root exists in the source's isolating interval. -/
theorem critical_root_exists :
    criticalPolynomial.degree = 67 ∧
    ∃ b : ℝ, rootLo < b ∧ b < rootHi ∧
      Polynomial.eval b criticalPolynomial = 0 := by
  refine ⟨criticalPolynomial_degree, ?_⟩
  have hcont : ContinuousOn (fun z : ℝ => Polynomial.eval z criticalPolynomial)
      (Set.Icc rootLo rootHi) := criticalPolynomial.continuous.continuousOn
  have hsub : (0 : ℝ) ∈ Set.Icc
      (Polynomial.eval rootHi criticalPolynomial)
      (Polynomial.eval rootLo criticalPolynomial) := by
    constructor <;> linarith [critical_endpoint_signs.1, critical_endpoint_signs.2]
  obtain ⟨b, hb, hzero⟩ :=
    (intermediate_value_Icc' (by norm_num [rootLo, rootHi]) hcont) hsub
  refine ⟨b, ?_, ?_, hzero⟩
  · exact lt_of_le_of_ne hb.1 (by
      intro h
      change Polynomial.eval b criticalPolynomial = 0 at hzero
      rw [← h] at hzero
      linarith [critical_endpoint_signs.1])
  · exact lt_of_le_of_ne hb.2 (by
      intro h
      change Polynomial.eval b criticalPolynomial = 0 at hzero
      rw [h] at hzero
      linarith [critical_endpoint_signs.2])

noncomputable def criticalRoot : ℝ := Classical.choose critical_root_exists.2

theorem criticalRoot_spec :
    rootLo < criticalRoot ∧ criticalRoot < rootHi ∧
      Polynomial.eval criticalRoot criticalPolynomial = 0 := by
  exact Classical.choose_spec critical_root_exists.2

private theorem criticalRoot_refined :
    127580539798972/1000000000000000 < criticalRoot ∧
    criticalRoot < 127580539798973/1000000000000000 := by
  have hb : criticalRoot ∈ Set.Icc rootLo rootHi :=
    ⟨criticalRoot_spec.1.le, criticalRoot_spec.2.1.le⟩
  have hl : (127580539798972/1000000000000000 : ℝ) ∈ Set.Icc rootLo rootHi := by
    norm_num [rootLo, rootHi]
  have hu : (127580539798973/1000000000000000 : ℝ) ∈ Set.Icc rootLo rootHi := by
    norm_num [rootLo, rootHi]
  constructor
  · by_contra h
    have he := critical_strictAnti.antitoneOn hb hl (le_of_not_gt h)
    linarith [refined_endpoint_signs.1, criticalRoot_spec.2.2]
  · by_contra h
    have he := critical_strictAnti.antitoneOn hu hb (le_of_not_gt h)
    linarith [refined_endpoint_signs.2, criticalRoot_spec.2.2]

private theorem criticalRoot_unique (b : ℝ) (hl : rootLo < b) (hu : b < rootHi)
    (hzero : criticalPolynomial.eval b = 0) : b = criticalRoot := by
  apply critical_strictAnti.injOn ⟨hl.le, hu.le⟩
    ⟨criticalRoot_spec.1.le, criticalRoot_spec.2.1.le⟩
  exact hzero.trans criticalRoot_spec.2.2.symm

/-- The source lift `r=-c(b)/a(b)` from the fixed determinant subresultant. -/
def liftedR (b : ℝ) : ℝ :=
  -Polynomial.eval b determinantalLiftNumerator /
    Polynomial.eval b determinantalLiftDenominator

/-- Independent source coordinates of the exact algebraic lift. -/
def liftedCoordinates (b : ℝ) : ℝ × ℝ :=
  (liftedR b / b, b)

/-- The original coefficient-coordinate world reconstructed by the chart. -/
def exactW3 : OriginalWorld := chartWorld (liftedCoordinates criticalRoot)

/-- Rational strip and nonvanishing conditions for the algebraic lift. -/
def SourceCertificate : Prop :=
  9005/10000 ≤ liftedR criticalRoot ∧
  liftedR criticalRoot ≤ 9006/10000 ∧
  12758/100000 ≤ criticalRoot ∧
  criticalRoot ≤ 12759/100000 ∧
  determinantalLiftDenominator.eval criticalRoot ≠ 0

private theorem source_certificate : SourceCertificate := by
  have hb0 : 0 < criticalRoot := by linarith [criticalRoot_refined.1]
  have hd := lift_denominator_bounds criticalRoot hb0.le
    (by linarith [criticalRoot_refined.1]) criticalRoot_refined.2.le
  have hn := lift_numerator_bounds criticalRoot hb0.le
    (by linarith [criticalRoot_refined.1]) criticalRoot_refined.2.le
  have hd0 : 0 < determinantalLiftDenominator.eval criticalRoot := by linarith [hd.1]
  refine ⟨?_, ?_, ?_, ?_, ne_of_gt hd0⟩
  · unfold liftedR
    apply (le_div_iff₀ hd0).mpr
    linarith [hd.2, hn.2]
  · unfold liftedR
    apply (div_le_iff₀ hd0).mpr
    linarith [hd.1, hn.1]
  · linarith [criticalRoot_refined.1]
  · linarith [criticalRoot_refined.2]

/-- The exact algebraic lift is an original parent whenever its source certificate holds. -/
theorem exactW3_parent_of_source_certificate
    (h : SourceCertificate) :
    OriginalParent exactW3 ∧
      AnalyticAt ℝ chartRead (liftedCoordinates criticalRoot) := by
  have hb : 12758/100000 ≤ criticalRoot := h.2.2.1
  have hb' : criticalRoot ≤ 12759/100000 := h.2.2.2.1
  have hr : 9005/10000 ≤ liftedR criticalRoot := h.1
  have hr' : liftedR criticalRoot ≤ 9006/10000 := h.2.1
  have hbpos : 0 < criticalRoot := by linarith [criticalRoot_spec.1]
  have hprod : liftedR criticalRoot / criticalRoot * criticalRoot = liftedR criticalRoot := by
    field_simp [ne_of_gt hbpos]
  have hchart := analytic_original_parent_chart
    (liftedCoordinates criticalRoot)
    (by simpa [liftedCoordinates, hprod] using hr)
    (by simpa [liftedCoordinates, hprod] using hr') hb hb'
  exact ⟨hchart.1, hchart.2.2.2.1⟩

/-- The selected exact algebraic lift belongs to the literal original parent.
Its root is unique in the original isolating interval, and its source and actual
response lift are analytic at the selected center. -/
theorem exactW3_parent :
    SourceCertificate ∧ OriginalParent exactW3 ∧
    AnalyticAt ℝ chartWorld (liftedCoordinates criticalRoot) ∧
    AnalyticAt ℝ chartSource (liftedCoordinates criticalRoot) ∧
    AnalyticAt ℝ chartRead (liftedCoordinates criticalRoot) ∧
    (∀ b : ℝ, 12758053/100000000 < b → b < 12758054/100000000 →
      criticalPolynomial.eval b = 0 → b = criticalRoot) ∧
    (∀ W : OriginalWorld, OriginalParent W → W.1 = liftedR criticalRoot →
      W.2.1 = criticalRoot → W = exactW3) := by
  have h := source_certificate
  have hb0 : 0 < criticalRoot := by linarith [criticalRoot_refined.1]
  have hm : liftedR criticalRoot / criticalRoot * criticalRoot = liftedR criticalRoot :=
    div_mul_cancel₀ _ (ne_of_gt hb0)
  have hc := analytic_original_parent_chart (liftedCoordinates criticalRoot)
    (by simpa [liftedCoordinates, hm] using h.1)
    (by simpa [liftedCoordinates, hm] using h.2.1) h.2.2.1 h.2.2.2.1
  refine ⟨h, (exactW3_parent_of_source_certificate h).1, hc.2.1, hc.2.2.1,
    hc.2.2.2.1, criticalRoot_unique, ?_⟩
  intro W hW hr hb
  exact hc.2.2.2.2.1 W hW (by simpa [liftedCoordinates, hm] using hr) hb

#print axioms critical_root_exists
#print axioms exactW3_parent_of_source_certificate
#print axioms exactW3_parent

