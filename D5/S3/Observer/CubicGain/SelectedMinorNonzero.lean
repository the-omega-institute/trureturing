private def entryData (i j : Fin 28) : List ℤ :=
  if 13-i.val%14 ≤ 28-j.val then
    (if i.val < 14 then e0 else e1).getD (28-j.val-(13-i.val%14)) []
  else []

private def minor (b : ℝ) : Matrix (Fin 28) (Fin 28) ℝ :=
  fun i j => value b (entryData i j)

private def scaledEntry (i j : Fin 28) : ℤ :=
  if 13-i.val%14 ≤ 28-j.val then
    (if i.val < 14 then s0 else s1).getD (28-j.val-(13-i.val%14)) 0
  else 0

private def intInverse (i j : Fin 28) : ℤ :=
  (inverseNumerators.getD i.val []).getD j.val 0

private def preconditioner : Matrix (Fin 28) (Fin 28) ℝ :=
  fun i j => (intInverse i j : ℝ) / 2^64

private theorem finite_residual : ∀ i j : Fin 28,
    |(∑ k : Fin 28, intInverse i k * scaledEntry k j) -
      (if i = j then (2^64 * rootDenominator^17 : ℤ) else 0)| * 128 ≤
      2^64 * rootDenominator^17 := by decide +kernel

private theorem finite_inverse_bound : ∀ i j : Fin 28,
    |intInverse i j| ≤ (2^(64+79) : ℤ) := by decide +kernel

private def slope : List ℤ → ℕ
  | [] => 0
  | _ :: cs => mass cs + slope cs

private theorem finite_slopes : ∀ i j : Fin 28,
    slope (entryData i j) ≤ 2^35 := by decide +kernel

private def encoded {R : Type*} [CommRing R] (cs : List (List ℤ)) (b : R) : Polynomial R :=
  match cs with
  | [] => 0
  | c :: cs => C (value b c) + X * encoded cs b

private theorem encoded_coeff {R : Type*} [CommRing R]
    (cs : List (List ℤ)) (b : R) (k : ℕ) :
    (encoded cs b).coeff k = value b (cs.getD k []) := by
  induction cs generalizing k with
  | nil => simp [encoded, value]
  | cons c cs ih =>
    cases k with
    | zero => simp [encoded]
    | succ k => simpa [encoded] using ih k

private theorem source_encoding0 (b : ℝ) : sourceE0 b = encoded e0 b := by
  simp only [sourceE0, encoded, e0, value, map_add, map_mul, map_intCast,
    map_pow, map_zero, Int.cast_neg, Int.cast_ofNat]
  ring

private theorem source_encoding1 (b : ℝ) : sourceE1 b = encoded e1 b := by
  simp only [sourceE1, encoded, e1, value, map_add, map_mul, map_intCast,
    map_pow, map_zero, Int.cast_neg, Int.cast_ofNat]
  ring

private theorem minor_is_literal (b : ℝ) :
    minor b = fixedMinorR (literalMatrix b) := by
  ext i j
  have hc : fixedMinorR (literalMatrix b) i j =
      (literalRow b i).coeff (28-j.val) := by
    by_cases hj : j.val < 27
    · simp [fixedMinorR, literalMatrix, hj]
    · have hj' : j.val = 27 := by omega
      simp [fixedMinorR, literalMatrix, hj, hj']
  rw [hc]
  by_cases hi : i.val < 14
  · simp only [literalRow, if_pos hi, source_encoding0, coeff_X_pow_mul', encoded_coeff]
    unfold minor entryData
    simp only [if_pos hi, Nat.mod_eq_of_lt hi]
    split_ifs <;> simp [value]
  · have hs : 27-i.val = 13-i.val%14 := by omega
    simp only [literalRow, if_neg hi, source_encoding1, hs]
    rw [coeff_X_pow_mul', encoded_coeff]
    unfold minor entryData
    simp only [if_neg hi]
    split_ifs <;> simp [value]

private theorem value_bound (cs : List ℤ) (x : ℝ) (hx : |x| ≤ 1) :
    |value x cs| ≤ (mass cs : ℝ) := by
  induction cs with
  | nil => simp [value, mass]
  | cons a cs ih =>
    simp only [value, mass, Nat.cast_add]
    calc
      |(a : ℝ) + x * value x cs| ≤ |(a : ℝ)| + |x| * |value x cs| := by
        simpa only [abs_mul] using abs_add_le (a : ℝ) (x*value x cs)
      _ ≤ |(a : ℝ)| + (mass cs : ℝ) := by
        gcongr
        exact mul_le_of_le_one_left (by positivity) hx |>.trans (by simpa using ih)
      _ = _ := by simp [Nat.cast_natAbs, Int.cast_abs]

private theorem value_lipschitz (cs : List ℤ) (x y : ℝ)
    (hx : |x| ≤ 1) (hy : |y| ≤ 1) :
    |value x cs - value y cs| ≤ (slope cs : ℝ) * |x-y| := by
  induction cs with
  | nil => simp [value, slope]
  | cons a cs ih =>
    have he : value x (a::cs) - value y (a::cs) =
        (x-y) * value x cs + y * (value x cs-value y cs) := by simp only [value]; ring
    rw [he]
    calc
      _ ≤ |x-y| * |value x cs| + |y| * |value x cs-value y cs| := by
        simpa only [abs_mul] using abs_add_le ((x-y)*value x cs) (y*(value x cs-value y cs))
      _ ≤ |x-y| * (mass cs : ℝ) + 1 * ((slope cs : ℝ)*|x-y|) := by
        gcongr
        · exact value_bound cs x hx
      _ = _ := by simp only [slope, Nat.cast_add]; ring

private theorem scaled_values0 :
    e0.map (value rootEndpoint) =
      s0.map (fun s : ℤ => (s : ℝ) / (rootDenominator : ℝ)^17) := by
  norm_num [e0, s0, value, rootEndpoint, rootNumerator, rootDenominator]

private theorem scaled_values1 :
    e1.map (value rootEndpoint) =
      s1.map (fun s : ℤ => (s : ℝ) / (rootDenominator : ℝ)^17) := by
  norm_num [e1, s1, value, rootEndpoint, rootNumerator, rootDenominator]

private theorem mapped_getD {α β : Type*} (f : α → β) (xs : List α)
    (k : ℕ) (a : α) : (xs.map f).getD k (f a) = f (xs.getD k a) := by
  simp [List.getD_eq_getElem?_getD, List.getElem?_map, Option.getD_map]

private theorem minor_at_endpoint (i j : Fin 28) :
    minor rootEndpoint i j = (scaledEntry i j : ℝ) / (rootDenominator : ℝ)^17 := by
  let k := 28-j.val-(13-i.val%14)
  have h0 := congrArg (fun xs : List ℝ => xs.getD k 0) scaled_values0
  have h1 := congrArg (fun xs : List ℝ => xs.getD k 0) scaled_values1
  have h0' : value rootEndpoint (e0.getD k []) =
      (s0.getD k 0 : ℝ) / (rootDenominator : ℝ)^17 := by
    calc
      _ = (e0.map (value rootEndpoint)).getD k 0 :=
        (mapped_getD (value rootEndpoint) e0 k []).symm
      _ = _ := h0
      _ = _ := by
        have hz : (fun s : ℤ => (s : ℝ)/(rootDenominator : ℝ)^17) 0 = 0 := by
          norm_num
        rw [← hz]
        exact mapped_getD (fun s : ℤ => (s : ℝ)/(rootDenominator : ℝ)^17) s0 k 0
  have h1' : value rootEndpoint (e1.getD k []) =
      (s1.getD k 0 : ℝ) / (rootDenominator : ℝ)^17 := by
    calc
      _ = (e1.map (value rootEndpoint)).getD k 0 :=
        (mapped_getD (value rootEndpoint) e1 k []).symm
      _ = _ := h1
      _ = _ := by
        have hz : (fun s : ℤ => (s : ℝ)/(rootDenominator : ℝ)^17) 0 = 0 := by
          norm_num
        rw [← hz]
        exact mapped_getD (fun s : ℤ => (s : ℝ)/(rootDenominator : ℝ)^17) s1 k 0
  change value rootEndpoint (entryData i j) = _
  unfold entryData scaledEntry
  split_ifs <;> first | exact h0' | exact h1' | simp [value]

private theorem endpoint_signs :
    0 < criticalPolynomial.eval rootEndpoint ∧
    criticalPolynomial.eval (rootEndpoint + 1/(rootDenominator : ℝ)) < 0 := by
  constructor <;>
    norm_num [criticalPolynomial, polyDesc, rootEndpoint, rootNumerator, rootDenominator]

private theorem refined_root :
    rootEndpoint ≤ criticalRoot ∧ criticalRoot ≤ rootEndpoint + 1/(rootDenominator : ℝ) := by
  have hl : rootEndpoint ≤ rootEndpoint + 1/(rootDenominator : ℝ) := by
    norm_num [rootEndpoint, rootNumerator, rootDenominator]
  obtain ⟨b, hb, hz⟩ := (intermediate_value_Icc' hl
    criticalPolynomial.continuous.continuousOn)
    (show (0 : ℝ) ∈ Set.Icc
      (criticalPolynomial.eval (rootEndpoint + 1/(rootDenominator : ℝ)))
      (criticalPolynomial.eval rootEndpoint) from ⟨endpoint_signs.2.le, endpoint_signs.1.le⟩)
  have he : b = criticalRoot := exactW3_parent.2.2.2.2.2.1 b
    (by have h := hb.1; norm_num [rootEndpoint, rootNumerator, rootDenominator] at h ⊢; linarith)
    (by have h := hb.2; norm_num [rootEndpoint, rootNumerator, rootDenominator] at h ⊢; linarith)
    hz
  exact he ▸ hb

private theorem endpoint_residual (i j : Fin 28) :
    |(preconditioner * minor rootEndpoint) i j - (1 : Matrix (Fin 28) (Fin 28) ℝ) i j| ≤
      1/128 := by
  have hc := finite_residual i j
  have hc' : |(∑ k : Fin 28, (intInverse i k : ℝ) * (scaledEntry k j : ℝ)) -
      (if i=j then (2^64 * (rootDenominator : ℝ)^17) else 0)| * 128 ≤
      2^64 * (rootDenominator : ℝ)^17 := by exact_mod_cast hc
  rw [Matrix.mul_apply]
  simp only [preconditioner, minor_at_endpoint]
  have hd : (0 : ℝ) < 2^64*(rootDenominator : ℝ)^17 := by norm_num [rootDenominator]
  have he : (∑ k : Fin 28, (intInverse i k : ℝ)/2^64 *
      ((scaledEntry k j : ℝ)/(rootDenominator : ℝ)^17)) -
      (1 : Matrix (Fin 28) (Fin 28) ℝ) i j =
      ((∑ k : Fin 28, (intInverse i k : ℝ)*(scaledEntry k j : ℝ)) -
       (if i=j then 2^64*(rootDenominator : ℝ)^17 else 0)) /
       (2^64*(rootDenominator : ℝ)^17) := by
    simp only [div_mul_div_comm, ← Finset.sum_div, Matrix.one_apply]
    have hr : (rootDenominator : ℝ) ≠ 0 := by norm_num [rootDenominator]
    split_ifs <;> field_simp [hr] <;> ring
  rw [he, abs_div, abs_of_pos hd]
  apply (div_le_iff₀ hd).mpr
  norm_num [rootDenominator] at hc' ⊢
  linarith

private theorem preconditioner_bound (i j : Fin 28) : |preconditioner i j| ≤ (2^79 : ℝ) := by
  have h : |(intInverse i j : ℝ)| ≤ (2^(64+79) : ℝ) := by exact_mod_cast finite_inverse_bound i j
  simp only [preconditioner, abs_div]
  norm_num at h ⊢
  apply (div_le_iff₀ (by norm_num : (0 : ℝ) < 18446744073709551616)).mpr
  linarith

private theorem entry_perturbation (i j : Fin 28) :
    |minor criticalRoot i j - minor rootEndpoint i j| ≤
      (2^35 : ℝ) / (rootDenominator : ℝ) := by
  have hlo := exactW3_parent.1.2.2.1
  have hhi := exactW3_parent.1.2.2.2.1
  have hx : |criticalRoot| ≤ 1 := by
    rw [abs_of_pos (by linarith : 0 < criticalRoot)]
    linarith
  have hy : |rootEndpoint| ≤ 1 := by norm_num [rootEndpoint, rootNumerator, rootDenominator]
  have hr : |criticalRoot-rootEndpoint| ≤ 1/(rootDenominator : ℝ) := by
    rw [abs_of_nonneg (sub_nonneg.mpr refined_root.1)]
    linarith [refined_root.2]
  have hs : (slope (entryData i j) : ℝ) ≤ (2^35 : ℝ) := by exact_mod_cast finite_slopes i j
  exact (value_lipschitz (entryData i j) _ _ hx hy).trans (by
    calc
      _ ≤ (2^35 : ℝ) * (1/(rootDenominator : ℝ)) := by gcongr
      _ = _ := by ring)

private theorem selected_residual (i j : Fin 28) :
    |(preconditioner * minor criticalRoot) i j -
      (1 : Matrix (Fin 28) (Fin 28) ℝ) i j| ≤ 1/64 := by
  have hpert : |(preconditioner * minor criticalRoot) i j -
      (preconditioner * minor rootEndpoint) i j| ≤ 1/128 := by
    have he : (preconditioner * minor criticalRoot) i j -
        (preconditioner * minor rootEndpoint) i j =
        ∑ k : Fin 28, preconditioner i k * (minor criticalRoot k j-minor rootEndpoint k j) := by
      simp only [Matrix.mul_apply, mul_sub, Finset.sum_sub_distrib]
    rw [he]
    calc
      _ ≤ ∑ k : Fin 28, |preconditioner i k| *
          |minor criticalRoot k j-minor rootEndpoint k j| := by
        simpa only [abs_mul] using Finset.abs_sum_le_sum_abs
          (fun k : Fin 28 => preconditioner i k*(minor criticalRoot k j-minor rootEndpoint k j)) Finset.univ
      _ ≤ ∑ k : Fin 28, (2^79 : ℝ)*((2^35 : ℝ)/(rootDenominator : ℝ)) := by
        gcongr with k
        · exact preconditioner_bound i k
        · exact entry_perturbation k j
      _ ≤ 1/128 := by norm_num [rootDenominator]
  have ht := abs_add_le
    ((preconditioner * minor criticalRoot) i j-(preconditioner * minor rootEndpoint) i j)
    ((preconditioner * minor rootEndpoint) i j-(1 : Matrix (Fin 28) (Fin 28) ℝ) i j)
  have hc := endpoint_residual i j
  rw [sub_add_sub_cancel] at ht
  linarith

/-- The chosen literal leading minor is nonsingular at the original selected FC root. -/
theorem selected_minor_nonzero :
    Matrix.det (fixedMinorR (literalMatrix criticalRoot)) ≠ 0 := by
  have hdet : Matrix.det (preconditioner * minor criticalRoot) ≠ 0 := by
    apply det_ne_zero_of_sum_row_lt_diag
    intro i
    have hd : (63/64 : ℝ) ≤ |(preconditioner * minor criticalRoot) i i| := by
      have h := selected_residual i i
      simp only [Matrix.one_apply_eq] at h
      have ht := abs_add_le ((preconditioner * minor criticalRoot) i i)
        (-((preconditioner * minor criticalRoot) i i-1))
      simp only [abs_neg] at ht
      have he : (preconditioner * minor criticalRoot) i i +
          -((preconditioner * minor criticalRoot) i i-1) = 1 := by ring
      rw [he] at ht
      norm_num at ht
      linarith
    have ho : ∑ j ∈ Finset.univ.erase i, |(preconditioner * minor criticalRoot) i j| ≤
        (27/64 : ℝ) := by
      calc
        _ ≤ ∑ j ∈ Finset.univ.erase i, (1/64 : ℝ) := by
          apply Finset.sum_le_sum
          intro j hj
          have hji : i ≠ j := Ne.symm (Finset.mem_erase.mp hj).1
          have h := selected_residual i j
          simpa [Matrix.one_apply, hji] using h
        _ = _ := by norm_num
    simp only [Real.norm_eq_abs]
    linarith
  rw [Matrix.det_mul] at hdet
  rw [← minor_is_literal]
  exact (mul_ne_zero_iff.mp hdet).2

#print axioms selected_minor_nonzero

end D5.S3.Observer.CubicGain.SelectedMinorNonzero
