private def intEval : List ℤ → ℝ → ℝ
  | [], _ => 0
  | a :: as, x => (a : ℝ)+x*intEval as x

private def intAdd : List ℤ → List ℤ → List ℤ
  | [], ys => ys
  | xs, [] => xs
  | a :: as, b :: bs => (a+b) :: intAdd as bs

private def intScale (a : ℤ) (xs : List ℤ) : List ℤ := xs.map (a * ·)

private def intMul : List ℤ → List ℤ → List ℤ
  | [], _ => []
  | a :: as, ys => intAdd (intScale a ys) (0 :: intMul as ys)

private def intTrim (xs : List ℤ) : List ℤ :=
  xs.reverse.dropWhile (· == 0) |>.reverse

private theorem intEval_add (xs ys : List ℤ) (x : ℝ) :
    intEval (intAdd xs ys) x = intEval xs x+intEval ys x := by
  induction xs generalizing ys with
  | nil => simp [intAdd, intEval]
  | cons a as ih =>
    cases ys with
    | nil => simp [intAdd, intEval]
    | cons b bs => simp only [intAdd,intEval,Int.cast_add,ih]; ring

private theorem intEval_scale (a : ℤ) (xs : List ℤ) (x : ℝ) :
    intEval (intScale a xs) x = (a : ℝ)*intEval xs x := by
  induction xs with
  | nil => simp [intScale,intEval]
  | cons b bs ih => simp only [intScale,List.map_cons,intEval,Int.cast_mul] at *; rw [ih]; ring

private theorem intEval_mul (xs ys : List ℤ) (x : ℝ) :
    intEval (intMul xs ys) x = intEval xs x*intEval ys x := by
  induction xs with
  | nil => simp [intMul,intEval]
  | cons a as ih =>
    rw [intMul,intEval_add,intEval_scale]
    simp only [intEval,Int.cast_zero,zero_add,ih]
    ring

private theorem intEval_append (xs ys : List ℤ) (x : ℝ) :
    intEval (xs++ys) x = intEval xs x+x^xs.length*intEval ys x := by
  induction xs with
  | nil => simp [intEval]
  | cons a as ih => simp only [List.cons_append,intEval,List.length_cons,ih,pow_succ]; ring

private theorem intEval_reverse_drop (xs : List ℤ) (x : ℝ) :
    intEval (xs.dropWhile (· == 0)).reverse x = intEval xs.reverse x := by
  induction xs with
  | nil => rfl
  | cons a as ih =>
    by_cases h : a = 0
    · subst a
      simp only [List.dropWhile_cons,beq_self_eq_true,ite_true,List.reverse_cons,
        intEval_append,intEval,Int.cast_zero,mul_zero,add_zero] at *
      exact ih
    · simp only [List.dropWhile_cons,beq_iff_eq, h,ite_false]

private theorem intEval_trim (xs : List ℤ) (x : ℝ) :
    intEval (intTrim xs) x = intEval xs x := by
  simpa only [intTrim,List.reverse_reverse] using intEval_reverse_drop xs.reverse x

private def intHom : List (List ℤ) → List ℤ → List ℤ → List ℤ → List ℤ → List ℤ
  | [], _, _, _, h => h
  | e :: es, a, c, p, h =>
      intHom es a c (intMul p a) (intAdd (intMul h c) (intMul e p))

private def realHom : List (List ℤ) → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ
  | [], _, _, _, h, _ => h
  | e :: es, a, c, p, h, x =>
      realHom es a c (p*a) (h*c+intEval e x*p) x

private theorem intEval_hom (es : List (List ℤ)) (a c p h : List ℤ) (x : ℝ) :
    intEval (intHom es a c p h) x =
      realHom es (intEval a x) (intEval c x) (intEval p x) (intEval h x) x := by
  induction es generalizing p h with
  | nil => rfl
  | cons e es ih =>
    rw [intHom,ih,realHom,intEval_add,intEval_mul,intEval_mul,intEval_mul]

