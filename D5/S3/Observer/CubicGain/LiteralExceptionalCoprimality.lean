private theorem integer_bezout :
    integerU * integerF + integerV * factorBase = 1 + C 101 * integerW := by
  simp only [integerU, integerV, integerW, integerF, integerDesc, asc, factorBase]
  norm_num
  ring

private def modularG : Polynomial (ZMod 101) :=
  (factorBase : Polynomial ℤ).map (Int.castRingHom _)

private theorem modular_bezout :
    integerU.map (Int.castRingHom (ZMod 101)) * modularF +
      integerV.map (Int.castRingHom (ZMod 101)) * modularG = 1 := by
  have h := congrArg (Polynomial.map (Int.castRingHom (ZMod 101))) integer_bezout
  have hz : (Int.castRingHom (ZMod 101)) 101 = 0 := by decide +kernel
  simpa only [modularF, modularG, Polynomial.map_add, Polynomial.map_mul,
    Polynomial.map_one, Polynomial.map_C, hz, C_0, zero_mul, add_zero] using h

private theorem modular_g_degree : modularG.natDegree = 6 := by
  simp only [modularG, factorBase, Polynomial.map_mul, Polynomial.map_add,
    Polynomial.map_sub, Polynomial.map_pow, map_X, Polynomial.map_one,
    Polynomial.map_ofNat]
  compute_degree <;> norm_num <;> decide +kernel

private def rationalG : Polynomial ℚ :=
  (factorBase : Polynomial ℤ).map (Int.castRingHom ℚ)

private theorem rational_g_degree : rationalG.natDegree = 6 := by
  simp only [rationalG, factorBase, Polynomial.map_mul, Polynomial.map_add,
    Polynomial.map_sub, Polynomial.map_pow, map_X, Polynomial.map_one,
    Polynomial.map_ofNat]
  compute_degree <;> norm_num

private theorem base_coprime : IsCoprime criticalPolynomial (factorBase : Polynomial ℝ) := by
  have hm : resultant modularF modularG 67 6 ≠ 0 := by
    have h : IsCoprime modularF modularG := ⟨_, _, modular_bezout⟩
    simpa only [modular_degrees.1, modular_g_degree] using resultant_ne_zero _ _ h
  have hi : resultant integerF (factorBase : Polynomial ℤ) 67 6 ≠ 0 := by
    intro hz
    apply hm
    rw [modularF, modularG, resultant_map_map, hz, map_zero]
  have hr : resultant rationalF rationalG ≠ 0 := by
    rw [rational_degrees.1, rational_g_degree, rationalF, rationalG, resultant_map_map]
    exact fun hz => hi ((Int.cast_injective (α := ℚ)) hz)
  have hc : IsCoprime rationalF rationalG := by
    by_contra hn
    apply hr
    apply resultant_eq_zero_iff.mpr
    refine ⟨Or.inl ?_, hn⟩
    intro hz
    have hd := rational_degrees.1
    simp [hz] at hd
  have h := hc.map (Polynomial.mapRingHom (Rat.castHom ℝ))
  have hg : rationalG.map (Rat.castHom ℝ) = (factorBase : Polynomial ℝ) := by
    simp [rationalG, factorBase]
  simpa only [Polynomial.coe_mapRingHom, real_bridge, hg] using h

/-- The exact displayed exceptional factor has degree 133 and is coprime to FC.
This does not identify it with the primitive gcd of the actual minors. -/
theorem displayed_exceptional_factor_coprime :
    (exceptionalFactor : Polynomial ℤ).natDegree = 133 ∧
      IsCoprime criticalPolynomial (exceptionalFactor : Polynomial ℝ) := by
  constructor
  · unfold exceptionalFactor
    compute_degree <;> norm_num
  · have h := base_coprime
    simp only [factorBase, IsCoprime.mul_right_iff] at h
    rcases h with ⟨⟨⟨⟨h0, h1⟩, h2⟩, h3⟩, h4⟩
    exact ((((h0.pow_right).mul_right h1.pow_right).mul_right h2.pow_right).mul_right
      h3.pow_right).mul_right h4.pow_right

