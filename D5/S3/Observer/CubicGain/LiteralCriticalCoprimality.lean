private def bezoutU : Polynomial (ZMod 101) := asc [38,-45,26,-39,37,1,-8,-48,0,4,-3,18,-15,-14,13,-16,44,-2,-30,35,-8,44,-15,33,-45,-35,-41,-1,43,-2,-41,-14,-8,8,-34,-39,-42,41,-18,13,-5,17,19,-37,2,21,14,11,4,-21,-36,-50,-42,-43,-9,28,-7,-26,24,9,12,7,33,-25,36,-8]
private def bezoutV : Polynomial (ZMod 101) := asc [17,14,10,35,-10,-4,1,-42,2,-43,-18,38,-1,-14,-23,-32,-50,9,16,45,35,-16,-7,-12,10,-43,-37,-24,13,16,-24,-28,-45,12,-12,-16,48,-5,-3,-48,-41,-48,-6,-39,8,41,41,13,-44,-45,-25,-4,11,-45,37,47,23,-34,50,7,-30,-2,-7,0,41,48,-24]

private instance prime101 : Fact (Nat.Prime 101) := ⟨by decide +kernel⟩

private theorem modular_bezout :
    bezoutU*modularF+bezoutV*modularF.derivative = 1 := by decide +kernel

private theorem modular_degrees :
    modularF.natDegree = 67 ∧ modularF.derivative.natDegree = 66 := by decide +kernel

private theorem rational_degrees :
    rationalF.natDegree = 67 ∧ rationalF.derivative.natDegree = 66 := by decide +kernel

private theorem modular_resultant_nonzero :
    resultant modularF modularF.derivative 67 66 ≠ 0 := by
  have h : IsCoprime modularF modularF.derivative := ⟨bezoutU,bezoutV,modular_bezout⟩
  simpa only [modular_degrees.1,modular_degrees.2] using resultant_ne_zero _ _ h

private theorem integer_resultant_nonzero :
    resultant integerF integerF.derivative 67 66 ≠ 0 := by
  intro h
  apply modular_resultant_nonzero
  rw [modularF,derivative_map, resultant_map_map, h, map_zero]

private theorem rational_coprime : IsCoprime rationalF rationalF.derivative := by
  have hr : resultant rationalF rationalF.derivative ≠ 0 := by
    rw [rational_degrees.1,rational_degrees.2]
    rw [rationalF,derivative_map,resultant_map_map]
    exact fun h => integer_resultant_nonzero ((Int.cast_injective (α := ℚ)) h)
  by_contra hn
  apply hr
  apply resultant_eq_zero_iff.mpr
  refine ⟨Or.inl ?_,hn⟩
  intro hz
  have hd := rational_degrees.1
  simp [hz] at hd

private theorem real_bridge : rationalF.map (Rat.castHom ℝ) = criticalPolynomial := by
  rw [rationalF,map_map]
  have he : (Rat.castHom ℝ).comp (Int.castRingHom ℚ) = Int.castRingHom ℝ := Subsingleton.elim _ _
  rw [he]
  exact integer_desc_map _

/-- The original literal degree-67 FC has no nonconstant common factor with its derivative. -/
theorem critical_polynomial_is_coprime_derivative :
    IsCoprime criticalPolynomial criticalPolynomial.derivative := by
  have h := rational_coprime.map (Polynomial.mapRingHom (Rat.castHom ℝ))
  simpa only [Polynomial.coe_mapRingHom,← derivative_map,real_bridge] using h

