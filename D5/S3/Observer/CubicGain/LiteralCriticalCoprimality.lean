private def bezoutU : Polynomial (ZMod 101) := integerU.map (Int.castRingHom _)
private def bezoutV : Polynomial (ZMod 101) := integerV.map (Int.castRingHom _)

private instance prime101 : Fact (Nat.Prime 101) := ⟨by decide +kernel⟩

private theorem integer_bezout :
    integerU*integerF+integerV*integerF.derivative = 1+C 101*integerW := by
  simp only [integerU,integerV,integerW,integerF,integerDesc,asc,
    derivative_add,derivative_C_mul_X_pow,derivative_zero]
  norm_num
  ring

private theorem modular_bezout :
    bezoutU*modularF+bezoutV*modularF.derivative = 1 := by
  have h := congrArg (Polynomial.map (Int.castRingHom (ZMod 101))) integer_bezout
  have hz : (Int.castRingHom (ZMod 101)) 101 = 0 := by decide +kernel
  simpa only [bezoutU,bezoutV,modularF,
    Polynomial.map_add,Polynomial.map_mul,Polynomial.map_one,Polynomial.map_C,
    ← derivative_map,hz,
    C_0,zero_mul,add_zero] using h

private theorem integer_real_bridge : integerF.map (Int.castRingHom ℝ) = criticalPolynomial :=
  integer_desc_map _

private theorem integer_degree : integerF.natDegree = 67 := by
  have h : (integerF.map (Int.castRingHom ℝ)).natDegree = 67 := by
    rw [integer_real_bridge]
    exact natDegree_eq_of_degree_eq_some critical_root_exists.1
  rwa [natDegree_map_eq_of_injective (Int.cast_injective (α := ℝ))] at h

private theorem modular_leading : modularF.coeff 67 ≠ 0 := by
  norm_num [modularF,coeff_map,integerF,integerDesc,coeff_add,coeff_C_mul_X_pow,coeff_X]
    <;> decide +kernel

private theorem modular_degrees :
    modularF.natDegree = 67 ∧ modularF.derivative.natDegree = 66 := by
  have hf : modularF.natDegree = 67 := natDegree_eq_of_le_of_coeff_ne_zero
    ((natDegree_map_le : modularF.natDegree ≤ integerF.natDegree).trans_eq integer_degree)
    modular_leading
  refine ⟨hf,natDegree_eq_of_le_of_coeff_ne_zero ?_ ?_⟩
  · simpa only [hf] using natDegree_derivative_le modularF
  · rw [coeff_derivative]
    exact mul_ne_zero modular_leading (by decide +kernel)

private theorem rational_degrees :
    rationalF.natDegree = 67 ∧ rationalF.derivative.natDegree = 66 := by
  have hf : rationalF.natDegree = 67 := by
    rw [rationalF,natDegree_map_eq_of_injective (Int.cast_injective (α := ℚ)),integer_degree]
  exact ⟨hf,by rw [natDegree_derivative,hf]⟩

private theorem modular_resultant_nonzero :
    resultant modularF modularF.derivative 67 66 ≠ 0 := by
  have h : IsCoprime modularF modularF.derivative := ⟨bezoutU,bezoutV,modular_bezout⟩
  simpa only [modular_degrees.1,modular_degrees.2] using resultant_ne_zero _ _ h

private theorem integer_resultant_nonzero :
    resultant integerF integerF.derivative 67 66 ≠ 0 := by
  intro h
  apply modular_resultant_nonzero
  rw [modularF,derivative_map, resultant_map_map, h, map_zero]

private theorem rational_coprime : IsCoprime rationalF rationalF.derivative := by
  have hr : resultant rationalF rationalF.derivative ≠ 0 := by
    rw [rational_degrees.1,rational_degrees.2]
    rw [rationalF,derivative_map,resultant_map_map]
    exact fun h => integer_resultant_nonzero ((Int.cast_injective (α := ℚ)) h)
  by_contra hn
  apply hr
  apply resultant_eq_zero_iff.mpr
  refine ⟨Or.inl ?_,hn⟩
  intro hz
  have hd := rational_degrees.1
  simp [hz] at hd

private theorem real_bridge : rationalF.map (Rat.castHom ℝ) = criticalPolynomial := by
  rw [rationalF,map_map]
  have he : (Rat.castHom ℝ).comp (Int.castRingHom ℚ) = Int.castRingHom ℝ := Subsingleton.elim _ _
  rw [he]
  exact integer_desc_map _

/-- The original literal degree-67 FC has no nonconstant common factor with its derivative. -/
theorem critical_polynomial_is_coprime_derivative :
    IsCoprime criticalPolynomial criticalPolynomial.derivative := by
  have h := rational_coprime.map (Polynomial.mapRingHom (Rat.castHom ℝ))
  simpa only [Polynomial.coe_mapRingHom,← derivative_map,real_bridge] using h

end D5.S3.Observer.CubicGain.LiteralCriticalCoprimality
