/- GID: D5/S3/Observer/HyperbolicTransport/GoldenHyperbolicInflation
   generality: I
   mirror-B: D5/B/S3/Observer/HyperbolicTransport/GoldenHyperbolicInflation
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Golden inflation expands visibly; its conjugate residual contracts. -/

import D5.S1.Scale.FibonacciEigen
import Mathlib.Algebra.Order.Field.Power

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Observer.HyperbolicTransport.GoldenHyperbolicInflation

open D5.S1.Scale

/-- Golden inflation in visible-hidden coordinates: the visible face uses the
expanding eigenvalue and the hidden face uses the contracting eigenvalue. -/
noncomputable def goldenInflation {V H : Type*}
    [AddCommMonoid V] [Module ℝ V] [AddCommMonoid H] [Module ℝ H]
    (x : V × H) : V × H :=
  (Real.goldenRatio • x.1, contractingEigenvalue • x.2)

/-- The residual scale generated by iterating the contracting golden face. -/
noncomputable def endogenousResidualScale (n : ℕ) : ℝ :=
  |contractingEigenvalue| ^ n

private theorem goldenInflation_iterate {V H : Type*}
    [AddCommMonoid V] [Module ℝ V] [AddCommMonoid H] [Module ℝ H]
    (n : ℕ) (x : V × H) :
    (goldenInflation^[n]) x =
      (Real.goldenRatio ^ n • x.1, Real.goldenConj ^ n • x.2) := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply', ih]
      simp [goldenInflation, contracting_eigenvalue_eq_goldenConj,
        pow_succ, smul_smul, mul_comm]

private theorem abs_goldenConj_eq_inv_goldenRatio :
    |Real.goldenConj| = Real.goldenRatio⁻¹ := by
  rw [abs_of_neg Real.goldenConj_neg, Real.inv_goldenRatio]

private theorem endogenousResidualScale_eq_zpow (n : ℕ) :
    endogenousResidualScale n = Real.goldenRatio ^ (-(n : ℤ)) := by
  rw [endogenousResidualScale, contracting_eigenvalue_eq_goldenConj,
    abs_goldenConj_eq_inv_goldenRatio, zpow_neg, zpow_natCast, ← inv_pow]

/-- Golden inflation transports the two observer faces hyperbolically.  Its
hidden scale is both the absolute Galois-conjugate multiplier and the exact
endogenous parameter `goldenRatio ^ (-n)`; the one-step scale is strictly
between zero and one. -/
theorem golden_visible_hidden_hyperbolic_transport {V H : Type*}
    [AddCommMonoid V] [Module ℝ V] [AddCommMonoid H] [Module ℝ H]
    (n : ℕ) (x : V × H) :
    (goldenInflation^[n]) x =
        (Real.goldenRatio ^ n • x.1, Real.goldenConj ^ n • x.2) ∧
      endogenousResidualScale n = Real.goldenRatio ^ (-(n : ℤ)) ∧
      endogenousResidualScale n = |Real.goldenConj| ^ n ∧
      0 < endogenousResidualScale 1 ∧
      endogenousResidualScale 1 < 1 := by
  refine ⟨goldenInflation_iterate n x, endogenousResidualScale_eq_zpow n, ?_, ?_, ?_⟩
  · rw [endogenousResidualScale, contracting_eigenvalue_eq_goldenConj]
  · rw [endogenousResidualScale, pow_one, contracting_eigenvalue_eq_goldenConj,
      abs_goldenConj_eq_inv_goldenRatio]
    exact inv_pos.mpr Real.goldenRatio_pos
  · rw [endogenousResidualScale, pow_one, contracting_eigenvalue_eq_goldenConj,
      abs_goldenConj_eq_inv_goldenRatio]
    exact inv_lt_one_of_one_lt₀ Real.one_lt_goldenRatio

/-- Reverse probe: the public transport theorem alone forces strict contraction
of every nonzero real hidden coordinate after one step. -/
example (hidden : ℝ) (hhidden : hidden ≠ 0) :
    |((goldenInflation^[1]) ((0 : ℝ), hidden)).2| < |hidden| := by
  rcases golden_visible_hidden_hyperbolic_transport 1 ((0 : ℝ), hidden) with
    ⟨htransport, _, hconjugate, _, hcontracting⟩
  rw [htransport]
  simp only [pow_one, smul_eq_mul, abs_mul]
  have hscale : |Real.goldenConj| = endogenousResidualScale 1 := by
    simpa using hconjugate.symm
  rw [hscale]
  simpa using mul_lt_mul_of_pos_right hcontracting (abs_pos.mpr hhidden)

#print axioms golden_visible_hidden_hyperbolic_transport

end D5.S3.Observer.HyperbolicTransport.GoldenHyperbolicInflation
