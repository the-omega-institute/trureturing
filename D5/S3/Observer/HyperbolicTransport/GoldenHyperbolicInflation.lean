import D5.S1.Scale.FibonacciEigen
import Mathlib.Algebra.Order.Field.Power

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Observer.HyperbolicTransport.GoldenHyperbolicInflation

open D5.S1.Scale

/-- The residual scale generated by iterating the contracting golden face. -/
noncomputable def endogenousResidualScale (n : ℕ) : ℝ :=
  |contractingEigenvalue| ^ n

private theorem spectral_readout_iterate {W : Type*}
    [AddCommMonoid W] [Module ℝ W]
    (Phi P : Module.End ℝ W) (eigenvalue : ℝ)
    (hspectral : P.comp Phi = eigenvalue • P) (n : ℕ) (x : W) :
    P (((Phi : W → W)^[n]) x) = eigenvalue ^ n • P x := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply']
      have hstep :
          P (Phi (((Phi : W → W)^[n]) x)) =
            eigenvalue • P (((Phi : W → W)^[n]) x) := by
        simpa using congrArg
          (fun map : Module.End ℝ W => map (((Phi : W → W)^[n]) x)) hspectral
      rw [hstep, ih]
      simp [pow_succ, smul_smul, mul_comm]

private theorem abs_goldenConj_eq_inv_goldenRatio :
    |Real.goldenConj| = Real.goldenRatio⁻¹ := by
  rw [abs_of_neg Real.goldenConj_neg, Real.inv_goldenRatio]

private theorem endogenousResidualScale_eq_zpow (n : ℕ) :
    endogenousResidualScale n = Real.goldenRatio ^ (-(n : ℤ)) := by
  rw [endogenousResidualScale, contracting_eigenvalue_eq_goldenConj,
    abs_goldenConj_eq_inv_goldenRatio, zpow_neg, zpow_natCast, ← inv_pow]

/-- Let `Phi` be the source golden operator on its six-dimensional real
ambient space, and let `P_parallel` and `P_perp` be the given complementary
rank-three spectral projections.  Their observer readouts transport by the
two golden eigenvalues, while the absolute hidden multiplier is the endogenous
scale `goldenRatio ^ (-n)`. -/
theorem golden_visible_hidden_hyperbolic_transport
    (Phi P_parallel P_perp : Module.End ℝ (Fin 6 → ℝ))
    (hPhi_parallel :
      Phi.comp P_parallel = Real.goldenRatio • P_parallel)
    (hPhi_perp :
      Phi.comp P_perp = contractingEigenvalue • P_perp)
    (hsplit :
      P_parallel.comp P_parallel = P_parallel ∧
        P_perp.comp P_perp = P_perp ∧
        P_parallel.comp P_perp = 0 ∧
        P_parallel + P_perp = LinearMap.id ∧
        P_parallel.comp Phi = Phi.comp P_parallel ∧
        P_perp.comp Phi = Phi.comp P_perp ∧
        Module.finrank ℝ (LinearMap.range P_parallel) = 3 ∧
        Module.finrank ℝ (LinearMap.range P_perp) = 3)
    (n : ℕ) (x : Fin 6 → ℝ) :
    P_parallel (((Phi : (Fin 6 → ℝ) → (Fin 6 → ℝ))^[n]) x) =
        Real.goldenRatio ^ n • P_parallel x ∧
      P_perp (((Phi : (Fin 6 → ℝ) → (Fin 6 → ℝ))^[n]) x) =
        Real.goldenConj ^ n • P_perp x ∧
      endogenousResidualScale n = Real.goldenRatio ^ (-(n : ℤ)) ∧
      endogenousResidualScale n = |Real.goldenConj| ^ n ∧
      0 < endogenousResidualScale 1 ∧
      endogenousResidualScale 1 < 1 := by
  rcases hsplit with ⟨_, _, _, _, hcomm_parallel, hcomm_perp, _, _⟩
  have hspectral_parallel :
      P_parallel.comp Phi = Real.goldenRatio • P_parallel :=
    hcomm_parallel.trans hPhi_parallel
  have hspectral_perp :
      P_perp.comp Phi = contractingEigenvalue • P_perp :=
    hcomm_perp.trans hPhi_perp
  have hperp := spectral_readout_iterate
    Phi P_perp contractingEigenvalue hspectral_perp n x
  rw [contracting_eigenvalue_eq_goldenConj] at hperp
  refine ⟨spectral_readout_iterate Phi P_parallel Real.goldenRatio
    hspectral_parallel n x, hperp, endogenousResidualScale_eq_zpow n, ?_, ?_, ?_⟩
  · rw [endogenousResidualScale, contracting_eigenvalue_eq_goldenConj]
  · rw [endogenousResidualScale, pow_one, contracting_eigenvalue_eq_goldenConj,
      abs_goldenConj_eq_inv_goldenRatio]
    exact inv_pos.mpr Real.goldenRatio_pos
  · rw [endogenousResidualScale, pow_one, contracting_eigenvalue_eq_goldenConj,
      abs_goldenConj_eq_inv_goldenRatio]
    exact inv_lt_one_of_one_lt₀ Real.one_lt_goldenRatio

#print axioms golden_visible_hidden_hyperbolic_transport

end D5.S3.Observer.HyperbolicTransport.GoldenHyperbolicInflation
