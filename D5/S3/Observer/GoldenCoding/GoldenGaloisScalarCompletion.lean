noncomputable section

namespace D5.S3.Observer.GoldenCoding.GoldenGaloisScalarCompletion

open scoped QuadraticAlgebra

/-- In the canonical rational quadratic algebra generated by a square root of five,
conjugation fixes exactly the rational scalars. Neither golden conjugate is fixed,
while their sum, product, and squared difference are the displayed rational invariants. -/
theorem golden_galois_scalar_completion :
    let K := QuadraticAlgebra ℚ 5 0
    let phi : K := ⟨1 / 2, 1 / 2⟩
    let phiPrime : K := ⟨1 / 2, -(1 / 2)⟩
    (∀ c : K, star c = c ↔ ∃ q : ℚ, c = algebraMap ℚ K q) ∧
      star phi ≠ phi ∧
      star phiPrime ≠ phiPrime ∧
      phi + phiPrime = 1 ∧
      phi * phiPrime = -1 ∧
      (phi - phiPrime) ^ 2 = 5 := by
  dsimp only
  constructor
  · intro c
    constructor
    · intro h
      have him := congrArg QuadraticAlgebra.im h
      simp only [QuadraticAlgebra.im_star] at him
      have himZero : c.im = 0 := by linarith
      refine ⟨c.re, ?_⟩
      ext <;> simp [himZero]
    · rintro ⟨q, rfl⟩
      ext <;> simp
  · constructor
    · intro h
      have him := congrArg QuadraticAlgebra.im h
      norm_num at him
    · constructor
      · intro h
        have him := congrArg QuadraticAlgebra.im h
        norm_num at him
      · constructor
        · ext <;> norm_num
        · constructor
          · ext <;> norm_num
          · ext <;> norm_num [pow_two]

#print axioms golden_galois_scalar_completion

end D5.S3.Observer.GoldenCoding.GoldenGaloisScalarCompletion
