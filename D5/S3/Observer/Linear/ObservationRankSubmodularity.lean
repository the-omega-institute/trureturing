import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

namespace D5.S3.Observer.Linear.ObservationRankSubmodularity

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-- The finrank of the span generated by a finite selection of observation
subspaces is submodular. Equivalently, adding one observation has diminishing
rank returns as the selected set grows. -/
theorem observation_rank_submodularity
    {K V ι : Type*} [DivisionRing K] [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] [DecidableEq ι]
    (U : ι -> Submodule K V) :
    let rank := fun A : Finset ι =>
      Module.finrank K (A.sup U : Submodule K V)
    (∀ A B, rank (A ∪ B) + rank (A ∩ B) ≤ rank A + rank B) ∧
      (∀ A B x, A ⊆ B ->
        rank (B ∪ {x}) - rank B ≤ rank (A ∪ {x}) - rank A) := by
  dsimp only
  have hSubmodular : ∀ A B : Finset ι,
      Module.finrank K ((A ∪ B).sup U : Submodule K V) +
          Module.finrank K ((A ∩ B).sup U : Submodule K V) ≤
        Module.finrank K (A.sup U : Submodule K V) +
          Module.finrank K (B.sup U : Submodule K V) := by
    intro A B
    have hIntersection :
        (A ∩ B).sup U ≤
          (A.sup U : Submodule K V) ⊓ (B.sup U : Submodule K V) := by
      apply le_inf
      · exact Finset.sup_mono Finset.inter_subset_left
      · exact Finset.sup_mono Finset.inter_subset_right
    calc
      Module.finrank K ((A ∪ B).sup U : Submodule K V) +
          Module.finrank K ((A ∩ B).sup U : Submodule K V) =
          Module.finrank K ((A.sup U : Submodule K V) ⊔
            (B.sup U : Submodule K V) : Submodule K V) +
            Module.finrank K ((A ∩ B).sup U : Submodule K V) := by
        rw [Finset.sup_union]
      _ ≤ Module.finrank K ((A.sup U : Submodule K V) ⊔
            (B.sup U : Submodule K V) : Submodule K V) +
          Module.finrank K ((A.sup U : Submodule K V) ⊓
            (B.sup U : Submodule K V) : Submodule K V) :=
        Nat.add_le_add_left (Submodule.finrank_mono hIntersection) _
      _ = Module.finrank K (A.sup U : Submodule K V) +
          Module.finrank K (B.sup U : Submodule K V) :=
        Submodule.finrank_sup_add_finrank_inf_eq
          (A.sup U : Submodule K V) (B.sup U : Submodule K V)
  refine ⟨hSubmodular, ?_⟩
  intro A B x hAB
  by_cases hx : x ∈ B
  · have hBx : B ∪ {x} = B := by
      apply Finset.Subset.antisymm
      · exact Finset.union_subset (fun _ hy => hy) (by simpa using hx)
      · exact Finset.subset_union_left
    rw [hBx]
    simp
  · have hUnion : (A ∪ {x}) ∪ B = B ∪ {x} := by
      ext y
      simp only [Finset.mem_union, Finset.mem_singleton]
      constructor
      · rintro ((hyA | hyx) | hyB)
        · exact Or.inl (hAB hyA)
        · exact Or.inr hyx
        · exact Or.inl hyB
      · rintro (hyB | hyx)
        · exact Or.inr hyB
        · exact Or.inl (Or.inr hyx)
    have hIntersection : (A ∪ {x}) ∩ B = A := by
      ext y
      simp only [Finset.mem_inter, Finset.mem_union, Finset.mem_singleton]
      constructor
      · rintro ⟨hyA | hyx, hyB⟩
        · exact hyA
        · subst y
          exact (hx hyB).elim
      · intro hyA
        exact ⟨Or.inl hyA, hAB hyA⟩
    have h := hSubmodular (A ∪ {x}) B
    rw [hUnion, hIntersection] at h
    omega

#print axioms observation_rank_submodularity

end D5.S3.Observer.Linear.ObservationRankSubmodularity
