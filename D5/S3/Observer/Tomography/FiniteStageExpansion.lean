import Mathlib.Analysis.InnerProductSpace.Projection.Submodule

/- Library-search audit trail (2026-08-16):
   * Repository searches for finite-stage orthogonal shell expansions and residual recurrences
     found no equal-or-stronger D5 declaration.
   * Pinned-Mathlib search found the exact one-step result
     `Submodule.sup_orthogonal_inf_of_hasOrthogonalProjection`, imported and applied below.
   * Loogle exact-name search returned that same one-step result. Searches for a finite iterated
     expansion returned no exact theorem, so the finite accumulation is proved by induction.
   * LeanSearch was reachable only through its public page during this run; no exact finite-stage
     declaration was returned by the available query interface. -/

namespace D5.S3.Observer.Tomography.FiniteStageExpansion

noncomputable section

universe u

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The subspace generated by the first `n` extracted shells. -/
def finiteShellSpan (E : ℕ → ClosedSubmodule ℝ H) : ℕ → Submodule ℝ H
  | 0 => ⊥
  | n + 1 => finiteShellSpan E n ⊔ (E (n + 1)).toSubmodule

/-- A recursively enlarged closed subspace is the orthogonal sum of its initial stage and
the shells extracted so far. The ambient space additionally splits off the current residual,
and that residual splits into the next shell and the next residual. -/
theorem finite_stage_expansion
    (S E : ℕ → ClosedSubmodule ℝ H)
    (hstep : ∀ k, (S (k + 1)).toSubmodule =
      (S k).toSubmodule ⊔ (E (k + 1)).toSubmodule)
    (hshell : ∀ k, (E (k + 1)).toSubmodule ≤ (S k).toSubmoduleᗮ)
    (n : ℕ) :
    (S n).toSubmodule = (S 0).toSubmodule ⊔ finiteShellSpan E n ∧
      (⊤ : Submodule ℝ H) =
        (S 0).toSubmodule ⊔ finiteShellSpan E n ⊔ (S n).toSubmoduleᗮ ∧
      (S n).toSubmoduleᗮ =
        (E (n + 1)).toSubmodule ⊔ (S (n + 1)).toSubmoduleᗮ := by
  have hfinite : ∀ m, (S m).toSubmodule =
      (S 0).toSubmodule ⊔ finiteShellSpan E m := by
    intro m
    induction m with
    | zero => simp [finiteShellSpan]
    | succ m ih =>
        calc
          (S (m + 1)).toSubmodule =
              (S m).toSubmodule ⊔ (E (m + 1)).toSubmodule := hstep m
          _ = ((S 0).toSubmodule ⊔ finiteShellSpan E m) ⊔
              (E (m + 1)).toSubmodule := by rw [ih]
          _ = (S 0).toSubmodule ⊔ finiteShellSpan E (m + 1) := by
            simp only [finiteShellSpan, sup_assoc]
  have hambient :
      (⊤ : Submodule ℝ H) =
        (S 0).toSubmodule ⊔ finiteShellSpan E n ⊔ (S n).toSubmoduleᗮ := by
    calc
      (⊤ : Submodule ℝ H) = (S n).toSubmodule ⊔ (S n).toSubmoduleᗮ :=
        Submodule.sup_orthogonal_of_hasOrthogonalProjection.symm
      _ = (S 0).toSubmodule ⊔ finiteShellSpan E n ⊔ (S n).toSubmoduleᗮ := by
        rw [hfinite n]
  have hnextOrthogonal :
      (S (n + 1)).toSubmoduleᗮ =
        (S n).toSubmoduleᗮ ⊓ (E (n + 1)).toSubmoduleᗮ := by
    rw [hstep n]
    exact (Submodule.inf_orthogonal (S n).toSubmodule (E (n + 1)).toSubmodule).symm
  have hsplit :=
    Submodule.sup_orthogonal_inf_of_hasOrthogonalProjection (hshell n)
  have hresidual :
      (S n).toSubmoduleᗮ =
        (E (n + 1)).toSubmodule ⊔ (S (n + 1)).toSubmoduleᗮ := by
    calc
      (S n).toSubmoduleᗮ =
          (E (n + 1)).toSubmodule ⊔
            (E (n + 1)).toSubmoduleᗮ ⊓ (S n).toSubmoduleᗮ :=
        hsplit.symm
      _ = (E (n + 1)).toSubmodule ⊔
          (S n).toSubmoduleᗮ ⊓ (E (n + 1)).toSubmoduleᗮ := by
        rw [inf_comm]
      _ = (E (n + 1)).toSubmodule ⊔ (S (n + 1)).toSubmoduleᗮ := by
        rw [← hnextOrthogonal]
  exact ⟨hfinite n, hambient, hresidual⟩

/-- The hypotheses are jointly satisfiable in the real Hilbert space. -/
example :
    let S : ℕ → ClosedSubmodule ℝ ℝ := fun _ => ⊥
    let E : ℕ → ClosedSubmodule ℝ ℝ := fun _ => ⊥
    (S 1).toSubmodule = (S 0).toSubmodule ⊔ finiteShellSpan E 1 ∧
      (⊤ : Submodule ℝ ℝ) =
        (S 0).toSubmodule ⊔ finiteShellSpan E 1 ⊔ (S 1).toSubmoduleᗮ ∧
      (S 1).toSubmoduleᗮ = (E 2).toSubmodule ⊔ (S 2).toSubmoduleᗮ := by
  dsimp
  apply finite_stage_expansion (S := fun _ => ⊥) (E := fun _ => ⊥)
  · intro k
    simp
  · intro k
    simp

#print axioms finite_stage_expansion

end

end D5.S3.Observer.Tomography.FiniteStageExpansion
