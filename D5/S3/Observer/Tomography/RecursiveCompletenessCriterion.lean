import D5.S3.Observer.Tomography.OrthogonalResidualRecurrence
import Mathlib.Analysis.InnerProductSpace.l2Space

/- Library-search audit trail (2026-08-21):
   * Repository search found the canonical independently constructed accumulated and residual
     towers in `OrthogonalResidualRecurrence`, plus the supporting finite-stage expansion, but no
     equal-or-stronger infinite completeness criterion or existing atom receipt.
   * Pinned Mathlib search found and this proof directly applies
     `ClosedSubmodule.iInf_orthogonal`, `Submodule.sup_orthogonal_of_hasOrthogonalProjection`,
     `OrthogonalFamily.of_pairwise`, and `IsHilbertSum.mkInternal`.
   * Searches for an exact packaged infinite completeness theorem returned no hit. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Observer.Tomography.RecursiveCompletenessCriterion

noncomputable section

universe u

open D5.S3.Observer.Tomography.OrthogonalResidualRecurrence

variable {H : Type u} [NormedAddCommGroup H] [InnerProductSpace ℝ H] [CompleteSpace H]

/-- The closed span accumulated over all finite recursive stages. -/
def terminalAccumulated
    (M : ClosedSubmodule ℝ H) (E : ℕ → ClosedSubmodule ℝ H) :
    ClosedSubmodule ℝ H :=
  ⨆ n, accumulatedSubspace M E n

/-- The terminal sector surviving every recursively constructed residual stage. -/
def terminalResidual
    (M : ClosedSubmodule ℝ H) (E : ℕ → ClosedSubmodule ℝ H) :
    ClosedSubmodule ℝ H :=
  ⨅ n, recursiveResidual M E n

/-- The closed expansion generated by the initial subspace and all selected shells. -/
def shellExpansion
    (M : ClosedSubmodule ℝ H) (E : ℕ → ClosedSubmodule ℝ H) :
    ClosedSubmodule ℝ H :=
  M ⊔ ⨆ n, E (n + 1)

/-- The initial subspace followed by the selected shells, indexed as one Hilbert family. -/
def knownShellFamily
    (M : ClosedSubmodule ℝ H) (E : ℕ → ClosedSubmodule ℝ H) :
    Option ℕ → ClosedSubmodule ℝ H
  | none => M
  | some n => E (n + 1)

/-- The terminal residual followed by the initial subspace and all selected shells. -/
def fullShellFamily
    (M : ClosedSubmodule ℝ H) (E : ℕ → ClosedSubmodule ℝ H) :
    Option (Option ℕ) → ClosedSubmodule ℝ H
  | none => terminalResidual M E
  | some i => knownShellFamily M E i

omit [CompleteSpace H] in
private lemma terminal_accumulated_eq_shell_expansion
    (M : ClosedSubmodule ℝ H) (E : ℕ → ClosedSubmodule ℝ H) :
    terminalAccumulated M E = shellExpansion M E := by
  change (⨆ n, accumulatedSubspace M E n) = M ⊔ ⨆ n, E (n + 1)
  apply le_antisymm
  · apply iSup_le
    intro n
    induction n with
    | zero =>
        exact le_sup_left
    | succ n ih =>
        rw [accumulatedSubspace]
        apply sup_le
        · exact ih
        · exact le_sup_of_le_right (le_iSup (fun k : ℕ => E (k + 1)) n)
  · apply sup_le
    · exact le_iSup (accumulatedSubspace M E) 0
    · apply iSup_le
      intro n
      have hshell : E (n + 1) ≤ accumulatedSubspace M E (n + 1) := by
        rw [accumulatedSubspace]
        exact le_sup_right
      exact hshell.trans (le_iSup (accumulatedSubspace M E) (n + 1))

private lemma closed_orthogonal_eq_bot_iff (K : ClosedSubmodule ℝ H) :
    Kᗮ = ⊥ ↔ K = ⊤ := by
  constructor
  · intro h
    have horthogonal := congrArg ClosedSubmodule.orthogonal h
    simpa using horthogonal
  · rintro rfl
    exact ClosedSubmodule.top_orthogonal_eq_bot

/-- The terminal residual vanishes exactly when the accumulated and shell-generated spaces are
complete. In that case the initial space and shells form the full Hilbert sum. Otherwise the
terminal residual completes the Hilbert sum and is orthogonal to every named component. -/
theorem recursive_completeness_criterion
    (M : ClosedSubmodule ℝ H)
    (E : ℕ → ClosedSubmodule ℝ H)
    (hchoose : ∀ n,
      (E (n + 1)).toSubmodule ≤ (recursiveResidual M E n).toSubmodule) :
    (terminalResidual M E = ⊥ ↔ terminalAccumulated M E = ⊤) ∧
      (terminalAccumulated M E = ⊤ ↔ shellExpansion M E = ⊤) ∧
      (terminalResidual M E = ⊥ →
        IsHilbertSum ℝ (fun i => (knownShellFamily M E i).toSubmodule)
          (fun i => (knownShellFamily M E i).toSubmodule.subtypeₗᵢ)) ∧
      (terminalResidual M E ≠ ⊥ →
        IsHilbertSum ℝ (fun i => (fullShellFamily M E i).toSubmodule)
            (fun i => (fullShellFamily M E i).toSubmodule.subtypeₗᵢ) ∧
        ∀ x, x ∈ terminalResidual M E →
          x ∈ (Mᗮ : ClosedSubmodule ℝ H) ∧ ∀ n, x ∈ (E (n + 1))ᗮ) := by
  have hfinite : ∀ n,
      recursiveResidual M E n = (accumulatedSubspace M E n)ᗮ := by
    intro n
    cases n with
    | zero => rfl
    | succ n => exact (orthogonal_residual_recurrence M E hchoose n).1
  have hterminal : terminalResidual M E = (terminalAccumulated M E)ᗮ := by
    rw [terminalResidual, terminalAccumulated]
    simp_rw [hfinite]
    exact ClosedSubmodule.iInf_orthogonal _
  have hexpansion := terminal_accumulated_eq_shell_expansion M E
  letI knownCompleteSpace (i : Option ℕ) :
      CompleteSpace (knownShellFamily M E i).toSubmodule :=
    inferInstanceAs (CompleteSpace (knownShellFamily M E i))
  letI fullCompleteSpace (i : Option (Option ℕ)) :
      CompleteSpace (fullShellFamily M E i).toSubmodule :=
    inferInstanceAs (CompleteSpace (fullShellFamily M E i))
  have hshellOrtho : ∀ n,
      (accumulatedSubspace M E n).toSubmodule ⟂ (E (n + 1)).toSubmodule := by
    intro n
    apply (Submodule.isOrtho_orthogonal_right
      (accumulatedSubspace M E n).toSubmodule).mono_right
    have hle := hchoose n
    rw [hfinite n] at hle
    exact hle
  have hknownOrtho :
      (shellExpansion M E).toSubmodule ⟂ (terminalResidual M E).toSubmodule := by
    rw [← hexpansion, hterminal]
    exact Submodule.isOrtho_orthogonal_right _
  have hambient :
      (⊤ : Submodule ℝ H) =
        (shellExpansion M E).toSubmodule ⊔ (terminalResidual M E).toSubmodule := by
    rw [← hexpansion, hterminal]
    exact Submodule.sup_orthogonal_of_hasOrthogonalProjection.symm
  have hAccumulatedMonotone : Monotone (accumulatedSubspace M E) := by
    apply monotone_nat_of_le_succ
    intro n
    rw [accumulatedSubspace]
    exact le_sup_left
  have hMle : ∀ n, M ≤ accumulatedSubspace M E n := by
    intro n
    exact (show M ≤ accumulatedSubspace M E 0 from le_rfl).trans
      (hAccumulatedMonotone (Nat.zero_le n))
  have hshellLe : ∀ n, E (n + 1) ≤ accumulatedSubspace M E (n + 1) := by
    intro n
    rw [accumulatedSubspace]
    exact le_sup_right
  have hknownFamilyOrtho :
      OrthogonalFamily ℝ (fun i => (knownShellFamily M E i).toSubmodule)
        (fun i => (knownShellFamily M E i).toSubmodule.subtypeₗᵢ) := by
    apply OrthogonalFamily.of_pairwise
    intro i j hij
    cases i with
    | none =>
        cases j with
        | none => exact False.elim (hij rfl)
        | some j =>
            exact (hshellOrtho j).mono_left (hMle j)
    | some i =>
        cases j with
        | none =>
            exact ((hshellOrtho i).mono_left (hMle i)).symm
        | some j =>
            have hne : i ≠ j := by
              intro h
              apply hij
              simp [h]
            rcases lt_or_gt_of_ne hne with hijlt | hjilt
            · have hle : E (i + 1) ≤ accumulatedSubspace M E j :=
                (hshellLe i).trans
                  (hAccumulatedMonotone (Nat.succ_le_of_lt hijlt))
              exact (hshellOrtho j).mono_left hle
            · have hle : E (j + 1) ≤ accumulatedSubspace M E i :=
                (hshellLe j).trans
                  (hAccumulatedMonotone (Nat.succ_le_of_lt hjilt))
              exact ((hshellOrtho i).mono_left hle).symm
  have hknownLeExpansion : ∀ i, knownShellFamily M E i ≤ shellExpansion M E := by
    intro i
    cases i with
    | none => exact le_sup_left
    | some n => exact le_sup_of_le_right (le_iSup (fun k => E (k + 1)) n)
  have hknownTotal (hTop : shellExpansion M E = ⊤) :
      ⊤ ≤ (⨆ i, (knownShellFamily M E i).toSubmodule).topologicalClosure := by
    have hTopSubmodule : (shellExpansion M E).toSubmodule = (⊤ : Submodule ℝ H) :=
      congrArg ClosedSubmodule.toSubmodule hTop
    rw [← hTopSubmodule]
    change shellExpansion M E ≤
      (⨆ i, (knownShellFamily M E i).toSubmodule).closure
    rw [shellExpansion]
    apply sup_le
    · exact (le_iSup (fun i => (knownShellFamily M E i).toSubmodule) none).trans
        (Submodule.le_topologicalClosure _)
    · apply iSup_le
      intro n
      exact (le_iSup (fun i => (knownShellFamily M E i).toSubmodule) (some n)).trans
        (Submodule.le_topologicalClosure _)
  have hfullFamilyOrtho :
      OrthogonalFamily ℝ (fun i => (fullShellFamily M E i).toSubmodule)
        (fun i => (fullShellFamily M E i).toSubmodule.subtypeₗᵢ) := by
    apply OrthogonalFamily.of_pairwise
    intro i j hij
    cases i with
    | none =>
        cases j with
        | none => exact False.elim (hij rfl)
        | some j =>
            exact (hknownOrtho.mono_left (hknownLeExpansion j)).symm
    | some i =>
        cases j with
        | none => exact hknownOrtho.mono_left (hknownLeExpansion i)
        | some j =>
            apply hknownFamilyOrtho.isOrtho
            intro h
            apply hij
            simp [h]
  have hfullTotal :
      ⊤ ≤ (⨆ i, (fullShellFamily M E i).toSubmodule).topologicalClosure := by
    rw [hambient]
    apply sup_le
    · change shellExpansion M E ≤
        (⨆ i, (fullShellFamily M E i).toSubmodule).closure
      rw [shellExpansion]
      apply sup_le
      · exact (le_iSup (fun i => (fullShellFamily M E i).toSubmodule) (some none)).trans
          (Submodule.le_topologicalClosure _)
      · apply iSup_le
        intro n
        exact (le_iSup (fun i => (fullShellFamily M E i).toSubmodule) (some (some n))).trans
          (Submodule.le_topologicalClosure _)
    · exact (le_iSup (fun i => (fullShellFamily M E i).toSubmodule) none).trans
        (Submodule.le_topologicalClosure _)
  have hinvisible : ∀ x, x ∈ terminalResidual M E →
      x ∈ Mᗮ ∧ ∀ n, x ∈ (E (n + 1))ᗮ := by
    intro x hx
    have hxall : ∀ n, x ∈ recursiveResidual M E n := by
      simpa only [terminalResidual, ClosedSubmodule.mem_iInf] using hx
    constructor
    · simpa only [recursiveResidual] using hxall 0
    · intro n
      have hxnext := hxall (n + 1)
      change x ∈ recursiveResidual M E n ⊓ (E (n + 1))ᗮ at hxnext
      exact hxnext.2
  constructor
  · rw [hterminal]
    exact closed_orthogonal_eq_bot_iff _
  constructor
  · exact ⟨fun h => hexpansion ▸ h, fun h => hexpansion.trans h⟩
  constructor
  · intro hcomplete
    have htrivial := hcomplete
    rw [hterminal] at htrivial
    have hAccumulated : terminalAccumulated M E = ⊤ :=
      (closed_orthogonal_eq_bot_iff _).mp htrivial
    have hTop : shellExpansion M E = ⊤ := hexpansion.symm.trans hAccumulated
    exact IsHilbertSum.mkInternal
      (fun i => (knownShellFamily M E i).toSubmodule)
      hknownFamilyOrtho (hknownTotal hTop)
  · intro hincomplete
    exact ⟨IsHilbertSum.mkInternal
      (fun i => (fullShellFamily M E i).toSubmodule)
      hfullFamilyOrtho hfullTotal, hinvisible⟩

/-- The domain and shell-selection hypothesis are jointly inhabited. -/
example :
    ∃ (M : ClosedSubmodule ℝ ℝ) (E : ℕ → ClosedSubmodule ℝ ℝ),
      ∀ n, (E (n + 1)).toSubmodule ≤ (recursiveResidual M E n).toSubmodule := by
  refine ⟨⊥, fun _ => ⊥, ?_⟩
  intro n
  exact bot_le

#print axioms recursive_completeness_criterion

end

end D5.S3.Observer.Tomography.RecursiveCompletenessCriterion
