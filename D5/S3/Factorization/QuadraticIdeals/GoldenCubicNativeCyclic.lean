/- GID: D5/S3/Factorization/QuadraticIdeals/GoldenCubicNativeCyclic
   generality: I
   mirror-B: D5/B/S3/Factorization/QuadraticIdeals/GoldenCubicNativeCyclic
   mirror-E: none(waiver:algebraically-proved)
   anchors: []
   utility: none
   digest: A canonical cyclic cubic splitting field exists for every native Lucas block. -/

import D5.S3.Factorization.QuadraticIdeals.GoldenCubicThueEisenstein
import D5.S1.Scale.GoldenCubicBlockCongruences
import Mathlib.RingTheory.Polynomial.GaussLemma

/-!
# The native block's cyclic cubic

The Lucas block supplies a single irreducible depressed cubic without a
square-times-cube hypothesis. Its roots lie in the field generated by any
one root, by the explicit quadratic factorization.
-/

set_option autoImplicit false
namespace D5.S3.Factorization.QuadraticIdeals.GoldenCubicNativeCyclic
open Polynomial D5.S1.Scale GoldenCubicThueEisenstein
open scoped IntermediateField

def cubic {R : Type*} [CommRing R] (l : R) : Cubic R :=
  ⟨1, 0, -3*(l^2+3), 2*(l^2+3)*l⟩

def shiftedCubic {R : Type*} [CommRing R] (l : R) : Cubic R :=
  ⟨1, 3, 3-3*(l^2+3), 1-3*(l^2+3)+2*(l^2+3)*l⟩

theorem discr_cubic {R : Type*} [CommRing R] (l : R) :
    (cubic l).discr = (18*(l^2+3))^2 := by
  simp [cubic, Cubic.discr]
  ring

theorem shifted_eq {R : Type*} [CommRing R] (l : R) :
    (shiftedCubic l).toPoly = (cubic l).toPoly.comp (X+C 1) := by
  simp [shiftedCubic, cubic, Cubic.toPoly, add_comp, mul_comp,
    pow_comp, X_comp, neg_comp, C_comp, map_add, map_sub, map_mul, map_pow, map_neg,
    map_ofNat, map_one, ofNat_comp]
  ring

theorem shifted_eisenstein (l : ℤ) (hl : l % 9 = 4) :
    EisensteinCoeffs 3 (shiftedCubic l) := by
  let b : ℤ := l^2+3
  have he : (9:ℤ) ∣ (shiftedCubic l).d - 6 := by
    let k : ℤ := l/9
    have hk : l = 4+9*k := by dsimp [k]; omega
    change (9:ℤ) ∣ 1-3*(l^2+3)+2*(l^2+3)*l-6
    rw [hk]
    refine ⟨10 + 78*k + 189*k^2 + 162*k^3, ?_⟩
    ring
  obtain ⟨m,hm⟩ := he
  refine ⟨rfl, by change (3:ℤ) ∣ 3; exact dvd_rfl,
    ⟨1-b, by change 3-3*b=3*(1-b); ring⟩, ⟨2+3*m, by omega⟩, ?_⟩
  intro h
  norm_num at h
  omega

theorem rational_irreducible (l : ℤ) (hl : l % 9 = 4) :
    Irreducible (cubic (l:ℚ)).toPoly := by
  have hs := (shifted_eisenstein l hl).isEisensteinAt (by rw [Int.isUnit_iff]; decide)
  have hm : (shiftedCubic l).toPoly.Monic := Cubic.monic_of_a_eq_one rfl
  have hprime : (Ideal.span ({(3:ℤ)} : Set ℤ)).IsPrime :=
    (Ideal.span_singleton_prime (by decide)).2 (Int.prime_iff_natAbs_prime.mpr Nat.prime_three)
  have hf : 0 < (shiftedCubic l).toPoly.natDegree := by
    rw [Cubic.natDegree_of_a_ne_zero (show (shiftedCubic l).a ≠ 0 by simp [shiftedCubic])]
    decide
  have hi := (Polynomial.IsPrimitive.Int.irreducible_iff_irreducible_map_cast hm.isPrimitive).mp
    (hs.irreducible hprime hm.isPrimitive hf)
  have hc :
      (shiftedCubic l).toPoly.map (Int.castRingHom ℚ) =
      (cubic (l:ℚ)).toPoly.comp (X+C 1) := by
    rw [← shifted_eq]
    simp [shiftedCubic, Cubic.toPoly, Polynomial.C_ofNat]
  rw [hc] at hi
  let e : ℚ[X] ≃ₐ[ℚ] ℚ[X] :=
    algEquivOfCompEqX (X+C 1) (X+C (-1))
      (by simp [add_comp]) (by simp [add_comp, add_assoc])
  apply (MulEquiv.irreducible_iff (f := e.toMulEquiv)).mp
  change Irreducible (aeval (X+C (1:ℚ)) (cubic (l:ℚ)).toPoly)
  rwa [← comp_eq_aeval]

theorem native_lucas_mod (j : ℕ) (hj : 1 ≤ j) :
    goldenLucas (3^j) % 9 = 4 ∧ goldenLucas (3^j) % 2 = 0 := by
  let l := goldenLucas (3^j)
  have h := (golden_cubic_lucas_block j hj).1
  have hm : l%72=4 := by
    simpa using (ZMod.intCast_eq_intCast_iff' l 4 72).mp h
  omega

theorem native_polynomial_certificate (j : ℕ) (hj : 1 ≤ j) :
    let l := goldenLucas (3^j)
    Irreducible (cubic (l:ℚ)).toPoly ∧
      ((cubic l).toPoly.comp (X+C 1)).IsEisensteinAt (Ideal.span ({3} : Set ℤ)) ∧
      (cubic l).discr = (18*(l^2+3))^2 := by
  dsimp
  refine ⟨rational_irreducible _ (native_lucas_mod j hj).1, ?_, discr_cubic _⟩
  rw [← shifted_eq]
  exact (shifted_eisenstein _ (native_lucas_mod j hj).1).isEisensteinAt
    (by rw [Int.isUnit_iff]; decide)

def equation {R : Type*} [CommRing R] (l x : R) : R :=
  x^3 - 3*(l^2+3)*x + 2*(l^2+3)*l

theorem root_orbit {F : Type*} [Field F] [CharZero F] (l r x : F)
    (hb : l^2+3 ≠ 0) (hr : equation l r = 0) (hx : equation l x = 0) :
    x = r ∨ x = (-r+6*(l^2+3)/(r^2-(l^2+3)))/2 ∨
      x = (-r-6*(l^2+3)/(r^2-(l^2+3)))/2 := by
  let b := l^2+3
  change r^3-3*b*r+2*b*l=0 at hr
  change x^3-3*b*x+2*b*l=0 at hx
  have hid : (12*b-3*r^2)*(r^2-b)^2 = (6*b)^2 := by
    have he : r^3-3*b*r= -(2*b*l) := by linear_combination hr
    calc
      _ = 12*b^3 - 3*(r^3-3*b*r)^2 := by ring
      _ = _ := by rw [he]; dsimp [b]; ring
  have hne : r^2-b ≠ 0 := by
    intro hz
    rw [hz, zero_pow (by decide : 2 ≠ 0), mul_zero] at hid
    exact (pow_ne_zero 2 (mul_ne_zero (by norm_num) hb)) hid.symm
  let d := 6*b/(r^2-b)
  have hd : d^2=12*b-3*r^2 := by
    dsimp [d]
    rw [div_pow, div_eq_iff (pow_ne_zero _ hne)]
    exact hid.symm
  have hfac : (x-r)*(x-(-r+d)/2)*(x-(-r-d)/2)=0 := by
    linear_combination hx - hr - ((x-r)/4)*hd
  simpa only [mul_eq_zero, sub_eq_zero, or_assoc] using hfac

theorem field_structure (l : ℤ) (hmod : l % 9 = 4) :
    let p := (cubic (l:ℚ)).toPoly
    Module.finrank ℚ p.SplittingField = 3 ∧ IsCyclic p.Gal ∧
      ∃ x : p.SplittingField, equation (l:p.SplittingField) x = 0 ∧
        ℚ⟮x⟯ = ⊤ := by
  classical
  let p := (cubic (l:ℚ)).toPoly
  let K := p.SplittingField
  change Module.finrank ℚ K = 3 ∧ IsCyclic p.Gal ∧
    ∃ x : K, equation (l:K) x = 0 ∧ ℚ⟮x⟯ = ⊤
  have hirr : Irreducible p := rational_irreducible l hmod
  have hdeg : p.natDegree = 3 := Cubic.natDegree_of_a_ne_zero (by simp [cubic])
  have hdm : (p.map (algebraMap ℚ K)).degree ≠ 0 := by
    rw [degree_map, degree_eq_natDegree hirr.ne_zero, hdeg]
    decide
  obtain ⟨r,hr⟩ := (SplittingField.splits p).exists_eval_eq_zero hdm
  have hrc : aeval r p = 0 := by rwa [← eval_map_algebraMap]
  have heval (x : K) : aeval x p = equation (l:K) x := by
    simp [p, cubic, equation, Cubic.toPoly] <;> ring
  have hre : equation (l:K) r = 0 := by rw [← heval]; exact hrc
  have hlt : (l:K)^2+3 ≠ 0 := by
    exact_mod_cast (show l^2+3 ≠ 0 by positivity)
  have htop : IntermediateField.adjoin ℚ (p.rootSet K) = ⊤ :=
    (isSplittingField_iff_intermediateField.mp
      (Polynomial.IsSplittingField.splittingField p)).2
  have hs : ℚ⟮r⟯ = (⊤ : IntermediateField ℚ K) := by
    apply top_unique
    rw [← htop]
    apply IntermediateField.adjoin_le_iff.mpr
    intro x hx
    have hxzero : equation (l:K) x = 0 := by
      rw [← heval]
      exact (Polynomial.mem_rootSet.mp hx).2
    have hmem := IntermediateField.mem_adjoin_simple_self ℚ r
    have hlmem : (l:K) ∈ ℚ⟮r⟯ := by
      rw [← map_intCast (algebraMap ℚ K)]
      exact (ℚ⟮r⟯ : IntermediateField ℚ K).algebraMap_mem (l:ℚ)
    have hbmem : (l:K)^2+3 ∈ ℚ⟮r⟯ := add_mem (pow_mem hlmem _) (by norm_num)
    have hquot : 6*((l:K)^2+3)/(r^2-((l:K)^2+3)) ∈ ℚ⟮r⟯ :=
      div_mem (mul_mem (by norm_num) hbmem) (sub_mem (pow_mem hmem _) hbmem)
    rcases root_orbit (l:K) r x hlt hre hxzero with h | h | h
    · rwa [h]
    · rw [h]
      exact div_mem (add_mem (neg_mem hmem) hquot) (by norm_num)
    · rw [h]
      exact div_mem (sub_mem (neg_mem hmem) hquot) (by norm_num)
  have hm : minpoly ℚ r = p :=
    (minpoly.eq_of_irreducible_of_monic hirr hrc (Cubic.monic_of_a_eq_one rfl)).symm
  have hfin : Module.finrank ℚ K = 3 := by
    rw [← IntermediateField.finrank_top', ← hs,
      IntermediateField.adjoin.finrank (IsIntegral.of_finite ℚ r), hm, hdeg]
  refine ⟨hfin, ?_, r, hre, hs⟩
  let _ : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
  apply isCyclic_of_prime_card (p := 3)
  rwa [Polynomial.Gal.card_of_separable hirr.separable]

theorem native_cyclic_field (j : ℕ) (hj : 1 ≤ j) :
    let p := (cubic (goldenLucas (3^j):ℚ)).toPoly
    Module.finrank ℚ p.SplittingField = 3 ∧ IsCyclic p.Gal :=
  let h := field_structure (goldenLucas (3^j)) (native_lucas_mod j hj).1
  ⟨h.1, h.2.1⟩

end D5.S3.Factorization.QuadraticIdeals.GoldenCubicNativeCyclic
