import Mathlib.Algebra.QuadraticAlgebra.Basic
import Mathlib.RingTheory.Coprime.Lemmas
import Mathlib.Data.ZMod.QuotientRing
import Mathlib.Tactic

/- Library search: pinned Mathlib has `QuadraticAlgebra.mk_eq_add_smul_omega`,
   `Int.quotientSpanNatEquivZMod`, `Ideal.quotEquivOfEq`, and
   `RingHom.quotientKerEquivOfSurjective`, but no odd-parameter scalar
   contraction or quotient theorem for this Eisenstein factor. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Factorization.QuadraticIdeals.EisensteinOddQuotient

abbrev EisensteinOrder := QuadraticAlgebra ℤ (-1) (-1)

def orientedFactor (b : ℕ) : EisensteinOrder := ⟨-2, b⟩

def blockNorm (b : ℕ) : ℕ := b ^ 2 + 2 * b + 4

def orientedIdeal (b : ℕ) : Ideal EisensteinOrder := Ideal.span {orientedFactor b}

abbrev OrientedQuotient (b : ℕ) := EisensteinOrder ⧸ orientedIdeal b

def scalarMap (b : ℕ) : ℤ →+* OrientedQuotient b :=
  (Ideal.Quotient.mk (orientedIdeal b)).comp (algebraMap ℤ EisensteinOrder)

/-- For an odd parameter, the oriented factor has exactly its norm ideal as
its scalar contraction, and the quotient is generated by scalar classes. -/
theorem eisenstein_odd_scalar_quotient (b : ℕ) (hb : Odd b) :
    (∀ n : ℤ, orientedFactor b ∣ (QuadraticAlgebra.C n : EisensteinOrder) ↔
      (blockNorm b : ℤ) ∣ n) ∧
    ∃ e : ZMod (blockNorm b) ≃+* OrientedQuotient b,
      ∀ n : ℤ, e (n : ZMod (blockNorm b)) = scalarMap b n := by
  have hcontract (n : ℤ) :
      orientedFactor b ∣ (QuadraticAlgebra.C n : EisensteinOrder) ↔
        (blockNorm b : ℤ) ∣ n := by
    constructor
    · rintro ⟨z, hz⟩
      have him : (b : ℤ) * z.re = ((b : ℤ) + 2) * z.im := by
        have h := congrArg QuadraticAlgebra.im hz
        simp only [QuadraticAlgebra.im_C, QuadraticAlgebra.im_mul, orientedFactor] at h
        nlinarith
      have hreal : n = -2 * z.re - (b : ℤ) * z.im := by
        have h := congrArg QuadraticAlgebra.re hz
        simp only [QuadraticAlgebra.re_C, QuadraticAlgebra.re_mul, orientedFactor] at h
        nlinarith
      have hcop : IsCoprime (b : ℤ) ((b : ℤ) + 2) := by
        simpa [add_comm] using
          (hb.coprime_two_right.cast (R := ℤ)).add_mul_right_right 1
      have hdiv : (b : ℤ) ∣ z.im := by
        apply hcop.dvd_of_dvd_mul_left
        rw [← him]
        exact ⟨z.re, rfl⟩
      obtain ⟨t, ht⟩ := hdiv
      have hbne : (b : ℤ) ≠ 0 := by
        obtain ⟨k, hk⟩ := hb
        omega
      have hre : z.re = ((b : ℤ) + 2) * t := by
        rw [ht] at him
        have heq : (b : ℤ) * (z.re - ((b : ℤ) + 2) * t) = 0 := by nlinarith [him]
        exact sub_eq_zero.mp ((mul_eq_zero.mp heq).resolve_left hbne)
      refine ⟨-t, ?_⟩
      rw [hreal, hre, ht]
      simp only [blockNorm, Nat.cast_add, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
      ring
    · rintro ⟨t, rfl⟩
      refine ⟨⟨-((b : ℤ) + 2) * t, -(b : ℤ) * t⟩, ?_⟩
      apply QuadraticAlgebra.ext
      · simp only [QuadraticAlgebra.re_C, QuadraticAlgebra.re_mul, orientedFactor,
          blockNorm, Nat.cast_add, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
        ring
      · simp only [QuadraticAlgebra.im_C, QuadraticAlgebra.im_mul, orientedFactor]
        ring
  have hker : RingHom.ker (scalarMap b) = Ideal.span {(blockNorm b : ℤ)} := by
    ext n
    change scalarMap b n = 0 ↔ n ∈ Ideal.span {(blockNorm b : ℤ)}
    change Ideal.Quotient.mk (Ideal.span {orientedFactor b}) (QuadraticAlgebra.C n) = 0 ↔
      n ∈ Ideal.span {(blockNorm b : ℤ)}
    rw [Ideal.Quotient.eq_zero_iff_mem, Ideal.mem_span_singleton,
      Ideal.mem_span_singleton]
    exact hcontract n
  have hsurj : Function.Surjective (scalarMap b) := by
    let q : EisensteinOrder →+* OrientedQuotient b := Ideal.Quotient.mk (orientedIdeal b)
    let w : EisensteinOrder := QuadraticAlgebra.omega
    have hcop2 : IsCoprime (b : ℤ) (2 : ℤ) := hb.coprime_two_right.cast
    have hcop4 : IsCoprime (b : ℤ) (4 : ℤ) := by
      simpa using (hcop2.pow_right (n := 2))
    have hcopB : IsCoprime (b : ℤ) (blockNorm b : ℤ) := by
      have hval : (blockNorm b : ℤ) = 4 + ((b : ℤ) + 2) * (b : ℤ) := by
        simp only [blockNorm, Nat.cast_add, Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat]
        ring
      rw [hval]
      exact hcop4.add_mul_right_right ((b : ℤ) + 2)
    obtain ⟨u, v, huv⟩ := hcopB
    have hB : scalarMap b (blockNorm b : ℤ) = 0 := by
      apply RingHom.mem_ker.mp
      rw [hker]
      exact Ideal.mem_span_singleton.mpr dvd_rfl
    have heta : q (orientedFactor b) = 0 := by
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
    have hetaEq : orientedFactor b = (QuadraticAlgebra.C (-2) : EisensteinOrder) +
        (QuadraticAlgebra.C (b : ℤ) : EisensteinOrder) * w := by
      simpa only [orientedFactor, w, QuadraticAlgebra.C_eq_algebraMap, Algebra.smul_def] using
        (QuadraticAlgebra.mk_eq_add_smul_omega (-2) (b : ℤ) :
          (⟨-2, (b : ℤ)⟩ : EisensteinOrder) = _)
    have hbw : scalarMap b (b : ℤ) * q w = scalarMap b 2 := by
      rw [hetaEq] at heta
      simp only [map_add, map_mul] at heta
      change scalarMap b (-2) + scalarMap b (b : ℤ) * q w = 0 at heta
      rw [map_neg] at heta
      linear_combination heta
    have hunit : scalarMap b u * scalarMap b (b : ℤ) = 1 := by
      have h := congrArg (scalarMap b) huv
      simpa [map_add, map_mul, hB] using h
    have hw : q w = scalarMap b (u * 2) := by
      calc
        q w = (scalarMap b u * scalarMap b (b : ℤ)) * q w := by rw [hunit]; ring
        _ = scalarMap b u * (scalarMap b (b : ℤ) * q w) := by ring
        _ = scalarMap b u * scalarMap b 2 := by rw [hbw]
        _ = scalarMap b (u * 2) := (map_mul (scalarMap b) u 2).symm
    intro x
    obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hz : z = (QuadraticAlgebra.C z.re : EisensteinOrder) +
        (QuadraticAlgebra.C z.im : EisensteinOrder) * w := by
      apply QuadraticAlgebra.ext
      · simp [w, QuadraticAlgebra.re_mul]
      · simp [w, QuadraticAlgebra.im_mul]
    refine ⟨z.re + z.im * (u * 2), ?_⟩
    rw [map_add, map_mul]
    change q (QuadraticAlgebra.C z.re) + q (QuadraticAlgebra.C z.im) *
      scalarMap b (u * 2) = q z
    rw [← hw, ← map_mul, ← map_add, ← hz]
  let e : ZMod (blockNorm b) ≃+* OrientedQuotient b :=
    (Int.quotientSpanNatEquivZMod (blockNorm b)).symm.trans
      ((Ideal.quotEquivOfEq hker.symm).trans
        (RingHom.quotientKerEquivOfSurjective hsurj))
  refine ⟨hcontract, e, ?_⟩
  intro n
  simp [e, scalarMap]

#print axioms eisenstein_odd_scalar_quotient

end D5.S3.Factorization.QuadraticIdeals.EisensteinOddQuotient
