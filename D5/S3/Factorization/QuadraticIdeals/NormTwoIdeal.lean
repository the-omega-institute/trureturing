/- GID: D5/S3/Factorization/QuadraticIdeals/NormTwoIdeal
   generality: I
   mirror-B: D5/B/S3/Factorization/QuadraticIdeals/NormTwoIdeal
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: The standard ideal in the minus-five quadratic order has quotient norm two. -/

import Mathlib.Algebra.Field.ZMod
import Mathlib.NumberTheory.Zsqrtd.Basic
import Mathlib.RingTheory.Ideal.Quotient.Operations

/- Library-search audit trail (2026-08-24):
   * Repository searches for `Zsqrtd (-5)`, the two-generator ideal, and a quotient
     equivalence with `ZMod 2` found no existing declaration.
   * `Zsqrtd.lift` is the pinned-Mathlib universal property used to evaluate the
     adjoined square root at one modulo two.
   * `Ideal.mem_span_pair` identifies the source two-generator ideal, while
     `ZMod.intCast_zmod_eq_zero_iff_dvd` identifies the evaluation kernel.
   * `RingHom.quotientKerEquivOfSurjective` and `Ideal.quotEquivOfEq` provide the
     canonical first-isomorphism equivalence; `Nat.card_congr` and `Nat.card_zmod`
     provide the quotient-cardinality computation. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Factorization.QuadraticIdeals.NormTwoIdeal

abbrev QuadraticOrder := Zsqrtd (-5)

/-- The source ideal generated by `2` and `1 + sqrt(-5)`. -/
def normTwoIdeal : Ideal QuadraticOrder :=
  Ideal.span ({(2 : QuadraticOrder), 1 + Zsqrtd.sqrtd} : Set QuadraticOrder)

/-- Evaluation at `sqrt(-5) = 1` in characteristic two. -/
def residueHom : QuadraticOrder →+* ZMod 2 :=
  Zsqrtd.lift ⟨1, by decide⟩

private theorem residue_hom_surjective : Function.Surjective residueHom := by
  intro value
  obtain ⟨integer, rfl⟩ := ZMod.intCast_surjective value
  exact ⟨(integer : QuadraticOrder), by simp [residueHom]⟩

private theorem residue_hom_ker : RingHom.ker residueHom = normTwoIdeal := by
  apply le_antisymm
  · intro value value_mem
    rw [RingHom.mem_ker] at value_mem
    simp only [residueHom, Zsqrtd.lift_apply_apply, mul_one, ← Int.cast_add] at value_mem
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at value_mem
    obtain ⟨coefficient, coefficient_spec⟩ := value_mem
    rw [normTwoIdeal, Ideal.mem_span_pair]
    refine ⟨(coefficient - value.im : ℤ), (value.im : ℤ), ?_⟩
    ext
    · simp
      omega
    · simp
  · rw [normTwoIdeal, Ideal.span_le]
    intro generator generator_mem
    rcases generator_mem with (rfl | generator_mem)
    · norm_num [RingHom.mem_ker, residueHom, Zsqrtd.lift_apply_apply]
      exact CharP.cast_eq_zero (ZMod 2) 2
    · have : generator = 1 + Zsqrtd.sqrtd := by simpa using generator_mem
      subst generator
      norm_num [RingHom.mem_ker, residueHom, Zsqrtd.lift_apply_apply]
      exact CharP.cast_eq_zero (ZMod 2) 2

/-- The canonical quotient equivalence induced by evaluation modulo two. -/
noncomputable def quotientEquivZModTwo :
    (QuadraticOrder ⧸ normTwoIdeal) ≃+* ZMod 2 :=
  (Ideal.quotEquivOfEq residue_hom_ker.symm).trans
    (RingHom.quotientKerEquivOfSurjective residue_hom_surjective)

/-- In the exact quadratic-order quotient, both source generators vanish, the
canonical equivalence computes by evaluation, and the quotient has cardinality two. -/
theorem ideal_norm_two :
    Ideal.Quotient.mk normTwoIdeal (2 : QuadraticOrder) = 0 ∧
      Ideal.Quotient.mk normTwoIdeal (1 + Zsqrtd.sqrtd) = 0 ∧
      (∀ value : QuadraticOrder,
        quotientEquivZModTwo (Ideal.Quotient.mk normTwoIdeal value) = residueHom value) ∧
      Nat.card (QuadraticOrder ⧸ normTwoIdeal) = 2 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [Ideal.Quotient.eq_zero_iff_mem, normTwoIdeal]
    exact Ideal.subset_span (by simp)
  · rw [Ideal.Quotient.eq_zero_iff_mem, normTwoIdeal]
    exact Ideal.subset_span (by simp)
  · intro value
    simp [quotientEquivZModTwo]
  · calc
      Nat.card (QuadraticOrder ⧸ normTwoIdeal) = Nat.card (ZMod 2) :=
        Nat.card_congr quotientEquivZModTwo.toEquiv
      _ = 2 := Nat.card_zmod 2

/-- The source quotient carrier is inhabited by the zero coset. -/
example : QuadraticOrder ⧸ normTwoIdeal := 0

#print axioms ideal_norm_two

end D5.S3.Factorization.QuadraticIdeals.NormTwoIdeal
