namespace D5.S3.Factorization.Galois.QuadraticCompositeRank

/-- The actual subfield of the complex numbers generated by the positive radicals. -/
def primeRadicalField (S : Finset ℕ) : IntermediateField ℚ ℂ :=
  IntermediateField.adjoin ℚ
    ((fun p : ℕ => (Real.sqrt (p : ℝ) : ℂ)) '' (S : Set ℕ))

private theorem quadratic_square_descent {K : Type*} [Field K]
    (h2 : (2 : K) ≠ 0) (d a : K) (hd : d ≠ 0) :
    IsSquare (algebraMap K (QuadraticAlgebra K d 0) a) ↔
      IsSquare a ∨ IsSquare (a * d) := by
  constructor
  · rintro ⟨z, hz⟩
    have hre : a = z.re * z.re + d * z.im * z.im := by
      simpa using congrArg QuadraticAlgebra.re hz
    have him : 0 = z.re * z.im + z.im * z.re := by
      simpa using congrArg QuadraticAlgebra.im hz
    have hcross : 2 * (z.re * z.im) = 0 := by
      calc
        2 * (z.re * z.im) = z.re * z.im + z.im * z.re := by ring
        _ = 0 := him.symm
    rcases mul_eq_zero.mp ((mul_eq_zero.mp hcross).resolve_left h2) with hx | hy
    · right
      refine ⟨d * z.im, ?_⟩
      rw [hre, hx]
      ring
    · exact Or.inl ⟨z.re, by simpa [hy] using hre⟩
  · rintro (⟨c, hc⟩ | ⟨c, hc⟩)
    · exact ⟨algebraMap K (QuadraticAlgebra K d 0) c, by rw [hc, map_mul]⟩
    · refine ⟨⟨0, c / d⟩, ?_⟩
      apply QuadraticAlgebra.ext
      · change a = 0 * 0 + d * (c / d) * (c / d)
        calc
          a = (a * d) / d := (mul_div_cancel_right₀ a hd).symm
          _ = 0 * 0 + d * (c / d) * (c / d) := by rw [hc]; field_simp; ring
      · change (0 : K) = 0 * (c / d) + (c / d) * 0 + 0 * (c / d) * (c / d)
        ring

theorem prime_mul_subset_not_square (S : Finset ℕ)
    (hS : ∀ q ∈ S, Nat.Prime q) (p : ℕ) (hp : Nat.Prime p) (hpS : p ∉ S)
    (T : Finset ℕ) (hTS : T ⊆ S) :
    ¬ IsSquare ((p : ℚ) * ∏ q ∈ T, (q : ℚ)) := by
  intro hs
  have hnat : IsSquare (p * ∏ q ∈ T, q) :=
    Rat.isSquare_natCast_iff.mp (by simpa only [Nat.cast_mul, Nat.cast_prod] using hs)
  obtain ⟨n, hn⟩ := hnat
  have hpn : p ∣ n := (hp.dvd_mul.mp (hn ▸ dvd_mul_right p (∏ q ∈ T, q))).elim id id
  obtain ⟨k, hk⟩ := hpn
  have hprod : (∏ q ∈ T, q) = p * (k * k) := by
    apply mul_left_cancel₀ hp.ne_zero
    calc
      p * (∏ q ∈ T, q) = n * n := hn
      _ = p * (p * (k * k)) := by rw [hk]; ring
  have hnot : ¬ p ∣ ∏ q ∈ T, q := hp.prime.not_dvd_finsetProd (fun q hq hdvd => by
    have heq : p = q := (Nat.prime_dvd_prime_iff_eq hp (hS q (hTS hq))).mp hdvd
    exact hpS (heq ▸ hTS hq))
  exact hnot ⟨k * k, hprod⟩

private theorem primeRadical_mono {S T : Finset ℕ} (hST : S ⊆ T) :
    primeRadicalField S ≤ primeRadicalField T := by
  apply IntermediateField.adjoin_le_iff.mpr
  rintro _ ⟨p, hp, rfl⟩
  exact IntermediateField.subset_adjoin ℚ _ ⟨p, hST hp, rfl⟩

/-- The equivalence is constructed from the actual embedding into complex numbers;
its range is proved equal to the enlarged adjoin, rather than supplied as data. -/
private def primeRadicalStepEquiv (S : Finset ℕ) (p : ℕ)
    (hns : ∀ x : primeRadicalField S,
      x ^ 2 ≠ algebraMap ℚ (primeRadicalField S) (p : ℚ)) :
    QuadraticAlgebra (primeRadicalField S)
      (algebraMap ℚ (primeRadicalField S) (p : ℚ)) 0 ≃ₐ[ℚ]
        primeRadicalField (insert p S) := by
  let K := primeRadicalField S
  let d : K := algebraMap ℚ K (p : ℚ)
  let Q := QuadraticAlgebra K d 0
  letI : Fact (∀ x : K, x ^ 2 ≠ d + 0 * x) := ⟨by simpa [d, K] using hns⟩
  let β : ℂ := (Real.sqrt (p : ℝ) : ℂ)
  have hβ : β * β = d • (1 : ℂ) + (0 : K) • β := by
    change ((Real.sqrt (p : ℝ) : ℂ) * (Real.sqrt (p : ℝ) : ℂ)) =
      (algebraMap ℚ ℂ (p : ℚ)) * 1 + 0 * β
    simpa only [Complex.ofReal_pow, Complex.ofReal_mul, Complex.ofReal_natCast, pow_two,
      map_natCast, mul_one, zero_mul, add_zero] using
      congrArg Complex.ofReal (Real.sq_sqrt (Nat.cast_nonneg p))
  let fK : Q →ₐ[K] ℂ := QuadraticAlgebra.lift ⟨β, hβ⟩
  let f : Q →ₐ[ℚ] ℂ := fK.restrictScalars ℚ
  have hf (z : Q) : f z = (z.re : ℂ) + (z.im : ℂ) * β := by
    change z.re • (1 : ℂ) + z.im • β = _
    simp [Algebra.smul_def]
  have hrange : f.fieldRange = primeRadicalField (insert p S) := by
    apply le_antisymm
    · rintro _ ⟨z, rfl⟩
      change f z ∈ primeRadicalField (insert p S)
      rw [hf]
      apply (primeRadicalField (insert p S)).add_mem
      · exact primeRadical_mono (Finset.subset_insert p S) z.re.property
      · apply (primeRadicalField (insert p S)).mul_mem
        · exact primeRadical_mono (Finset.subset_insert p S) z.im.property
        · exact IntermediateField.subset_adjoin ℚ _ ⟨p, Finset.mem_insert_self p S, rfl⟩
    · apply IntermediateField.adjoin_le_iff.mpr
      rintro _ ⟨q, hq, rfl⟩
      rcases Finset.mem_insert.mp hq with rfl | hq
      · refine ⟨QuadraticAlgebra.omega, ?_⟩
        simp [hf, β]
      · let x : K := ⟨(Real.sqrt (q : ℝ) : ℂ),
          IntermediateField.subset_adjoin ℚ _ ⟨q, hq, rfl⟩⟩
        refine ⟨algebraMap K Q x, ?_⟩
        exact fK.commutes x
  exact f.equivFieldRange.trans (IntermediateField.equivOfEq hrange)

private theorem square_transport {A B : Type*} [CommRing A] [CommRing B]
    [Algebra ℚ A] [Algebra ℚ B] (e : A ≃ₐ[ℚ] B) (a : ℚ) :
    IsSquare (algebraMap ℚ B a) ↔ IsSquare (algebraMap ℚ A a) := by
  constructor
  · rintro ⟨x, hx⟩
    exact ⟨e.symm x, by simpa only [map_mul, AlgEquiv.commutes] using congrArg e.symm hx⟩
  · rintro ⟨x, hx⟩
    exact ⟨e x, by simpa only [map_mul, AlgEquiv.commutes] using congrArg e hx⟩

private theorem primeRadicalInduction (S : Finset ℕ) (hS : ∀ p ∈ S, Nat.Prime p) :
    (∀ a : ℚ, IsSquare (algebraMap ℚ (primeRadicalField S) a) ↔
      ∃ T : Finset ℕ, T ⊆ S ∧ IsSquare (a * ∏ p ∈ T, (p : ℚ))) ∧
    Module.Finite ℚ (primeRadicalField S) ∧
    Module.finrank ℚ (primeRadicalField S) = 2 ^ S.card := by
  classical
  induction S using Finset.induction_on with
  | empty =>
      have hempty : primeRadicalField ∅ = ⊥ := by
        simp [primeRadicalField]
      let e : primeRadicalField ∅ ≃ₐ[ℚ] ℚ :=
        (IntermediateField.equivOfEq hempty).trans (IntermediateField.botEquiv ℚ ℂ)
      refine ⟨?_, Module.Finite.equiv e.symm.toLinearEquiv, ?_⟩
      · intro a
        rw [← square_transport e a]
        simp
      · simpa using e.toLinearEquiv.finrank_eq
  | @insert p S hpS ih =>
      have hp : Nat.Prime p := hS p (Finset.mem_insert_self p S)
      have hS' : ∀ q ∈ S, Nat.Prime q := fun q hq => hS q (Finset.mem_insert_of_mem hq)
      obtain ⟨ihKernel, ihFinite, ihDegree⟩ := ih hS'
      letI : Module.Finite ℚ (primeRadicalField S) := ihFinite
      have hns : ∀ x : primeRadicalField S,
          x ^ 2 ≠ algebraMap ℚ (primeRadicalField S) (p : ℚ) := by
        intro x hx
        have hs : IsSquare (algebraMap ℚ (primeRadicalField S) (p : ℚ)) :=
          ⟨x, by simpa only [pow_two] using hx.symm⟩
        obtain ⟨T, hTS, hT⟩ := (ihKernel (p : ℚ)).mp hs
        exact prime_mul_subset_not_square S hS' p hp hpS T hTS hT
      let Q := QuadraticAlgebra (primeRadicalField S)
        (algebraMap ℚ (primeRadicalField S) (p : ℚ)) 0
      let e : Q ≃ₐ[ℚ] primeRadicalField (insert p S) := primeRadicalStepEquiv S p hns
      letI : Module.Finite ℚ Q := Module.Finite.trans (primeRadicalField S) Q
      have hstep (a : ℚ) :
          IsSquare (algebraMap ℚ (primeRadicalField (insert p S)) a) ↔
            IsSquare (algebraMap ℚ (primeRadicalField S) a) ∨
              IsSquare (algebraMap ℚ (primeRadicalField S) (a * p)) := by
        rw [square_transport e a]
        change IsSquare (algebraMap (primeRadicalField S) Q
          (algebraMap ℚ (primeRadicalField S) a)) ↔ _
        rw [quadratic_square_descent (by norm_num)
          (algebraMap ℚ (primeRadicalField S) (p : ℚ))
          (algebraMap ℚ (primeRadicalField S) a)
          (by simpa only [map_natCast, ne_eq, Nat.cast_eq_zero] using hp.ne_zero)]
        rw [map_mul]
      refine ⟨?_, Module.Finite.equiv e.toLinearEquiv, ?_⟩
      · intro a
        rw [hstep, ihKernel a, ihKernel (a * p)]
        constructor
        · rintro (⟨T, hTS, hT⟩ | ⟨T, hTS, hT⟩)
          · exact ⟨T, hTS.trans (Finset.subset_insert p S), hT⟩
          · have hpT : p ∉ T := fun h => hpS (hTS h)
            refine ⟨insert p T, Finset.insert_subset_insert p hTS, ?_⟩
            simpa only [Finset.prod_insert hpT, mul_assoc] using hT
        · rintro ⟨T, hTS, hT⟩
          by_cases hpT : p ∈ T
          · right
            refine ⟨T.erase p, ?_, ?_⟩
            · intro q hq
              rcases Finset.mem_insert.mp (hTS (Finset.mem_of_mem_erase hq)) with hqp | hqS
              · exact False.elim ((Finset.ne_of_mem_erase hq) hqp)
              · exact hqS
            · have hprod : (∏ q ∈ T, (q : ℚ)) = p * ∏ q ∈ T.erase p, (q : ℚ) := by
                exact (Finset.mul_prod_erase T (fun q => (q : ℚ)) hpT).symm
              simpa only [hprod, mul_assoc] using hT
          · left
            refine ⟨T, ?_, hT⟩
            intro q hq
            rcases Finset.mem_insert.mp (hTS hq) with hqp | hqS
            · exact False.elim (hpT (hqp ▸ hq))
            · exact hqS
      · calc
          Module.finrank ℚ (primeRadicalField (insert p S)) = Module.finrank ℚ Q :=
            e.toLinearEquiv.finrank_eq.symm
          _ = Module.finrank ℚ (primeRadicalField S) *
              Module.finrank (primeRadicalField S) Q :=
            (Module.finrank_mul_finrank ℚ (primeRadicalField S) Q).symm
          _ = 2 ^ (insert p S).card := by
            rw [ihDegree, QuadraticAlgebra.finrank_eq_two, Finset.card_insert_of_notMem hpS,
              pow_succ]

/-- The full rational square kernel, including the empty support and zero scalar. -/
theorem prime_radical_square_kernel (S : Finset ℕ) (hS : ∀ p ∈ S, Nat.Prime p)
    (a : ℚ) :
    IsSquare (algebraMap ℚ (primeRadicalField S) a) ↔
      ∃ T : Finset ℕ, T ⊆ S ∧ IsSquare (a * ∏ p ∈ T, (p : ℚ)) :=
  (primeRadicalInduction S hS).1 a

/-- The actual prime-radical adjoin has the full degree, with no independence premise. -/
theorem prime_radical_degree (S : Finset ℕ) (hS : ∀ p ∈ S, Nat.Prime p) :
    Module.Finite ℚ (primeRadicalField S) ∧
      Module.finrank ℚ (primeRadicalField S) = 2 ^ S.card :=
  (primeRadicalInduction S hS).2

