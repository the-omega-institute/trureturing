/- GID: D5/S3/Factorization/Galois/FernandesTwoGeneration
   generality: I
   mirror-B: D5/B/S3/Factorization/Galois/FernandesTwoGeneration
   mirror-E: none(waiver:pure-group-theory)
   anchors: []
   utility: kind=none
   digest: Two generators for the equal-sign subgroup at second degree two. -/

import Mathlib.GroupTheory.Perm.Fin
import Mathlib.Algebra.Group.Subgroup.Ker

/-!
The equal-sign subgroup of a pair of symmetric groups is generated by two elements
whenever the second degree is two and the first is at least two. The projection onto
the first factor is injective on that subgroup, because the sign of a permutation of
two letters determines it, so a full cycle paired with a sign-matching involution and
an adjacent transposition already generate. This settles the two-generation question
for the whole family with second degree two; it does not establish the general
conjecture for arbitrary degrees.
-/

set_option autoImplicit false

namespace D5.S3.Factorization.Galois.FernandesTwoGeneration

open Equiv Equiv.Perm

/-- The kernel of the ratio of the two permutation signs. -/
def Gamma (m n : ℕ) : Subgroup (Perm (Fin m) × Perm (Fin n)) :=
  ((sign.comp (MonoidHom.fst (Perm (Fin m)) (Perm (Fin n)))) *
    (sign.comp (MonoidHom.snd (Perm (Fin m)) (Perm (Fin n))))⁻¹).ker

local notation "Γ" => Gamma

/-- With second degree two, projection onto the first permutation admits two generators. -/
theorem fernandes_two_generation_n_two {m : ℕ} (hm : 2 ≤ m) :
    ∃ g₁ g₂ : Γ m 2, Subgroup.closure {g₁, g₂} = ⊤ := by
  have sign_two_injective : Function.Injective (sign : Perm (Fin 2) → ℤˣ) := by
    decide +kernel
  classical
  let : NeZero m := ⟨by omega⟩
  let c : Perm (Fin m) := finRotate m
  have hc : c 0 ≠ 0 := by
    have h := support_finRotate_of_le hm
    have h0 : (0 : Fin m) ∈ c.support := by simp [c, h]
    exact mem_support.mp h0
  obtain ⟨q, hq⟩ := sign_surjective (Fin 2) (sign c)
  let a : Γ m 2 := ⟨(c, q), by
    change sign c * (sign q)⁻¹ = 1
    rw [hq, mul_inv_cancel]⟩
  let b : Γ m 2 := ⟨(swap 0 (c 0), swap 0 1), by
    change sign (swap 0 (c 0)) * (sign (swap (0 : Fin 2) 1))⁻¹ = 1
    rw [sign_swap hc.symm, sign_swap (by decide : (0 : Fin 2) ≠ 1), mul_inv_cancel]⟩
  let f : Γ m 2 →* Perm (Fin m) :=
    (MonoidHom.fst _ _).comp (Γ m 2).subtype
  have parity (x : Γ m 2) : sign x.val.1 = sign x.val.2 := by
    have h := x.property
    change sign x.val.1 * (sign x.val.2)⁻¹ = 1 at h
    exact mul_inv_eq_one.mp h
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    apply Prod.ext h
    apply sign_two_injective
    exact (parity x).symm.trans ((congrArg sign h).trans (parity y))
  have hmap : (Subgroup.closure {a, b}).map f = ⊤ := by
    rw [MonoidHom.map_closure]
    rw [Set.image_pair]
    exact closure_cycle_adjacent_swap (isCycle_finRotate_of_le hm)
      (support_finRotate_of_le hm) 0
  refine ⟨a, b, Subgroup.map_injective hf ?_⟩
  exact hmap.trans (top_unique (hmap ▸ Subgroup.map_mono le_top)).symm


end D5.S3.Factorization.Galois.FernandesTwoGeneration
