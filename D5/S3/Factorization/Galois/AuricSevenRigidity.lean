import Mathlib.LinearAlgebra.BilinearMap
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.FiniteDimensional.Defs
import Mathlib.LinearAlgebra.Prod
import Mathlib.Algebra.Algebra.Operations
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# The zero-product tensor endpoint

The source proof of the degree-seven rigidity lemma ends with three actual
zero-product tensors.  This module records and proves that endpoint-facing
algebraic step for a field extension: if those tensors have the displayed
coordinates, the span generated by the second factor is the image of the
first span under multiplication by a nonzero element of the original field.

The preceding contraction and adjugate classification is deliberately not
encoded here; it remains an obligation of the full Lemma 40.3 formalization.
-/

namespace D5.S3.Factorization.Galois.AuricSevenRigidity

open Set

theorem zero_product_tensor_homothety
    {F D : Type*} [Field F] [Field D] [Algebra F D]
    (u₁ u₂ u₃ p q s : D)
    (hu₁ : u₁ ≠ 0) (hs : s ≠ 0)
    (h₁ : u₁ * p = u₃ * s)
    (h₂ : u₁ * q = -(u₂ * s)) :
    Submodule.span F {p, q, s} =
      Submodule.map (LinearMap.mulLeft F (s / u₁))
        (Submodule.span F {u₁, u₂, u₃}) := by
  have hp : (s / u₁) * u₃ = p := by
    field_simp [hu₁]
    simpa [mul_comm, mul_left_comm, mul_assoc] using h₁.symm
  have hq : (s / u₁) * (-u₂) = q := by
    field_simp [hu₁]
    simpa [mul_comm, mul_left_comm, mul_assoc] using h₂.symm
  have hs' : (s / u₁) * u₁ = s := by
    field_simp [hu₁]
  apply le_antisymm
  · apply Submodule.span_le.2
    intro x hx
    simp only [mem_insert_iff, mem_singleton_iff] at hx
    rcases hx with hxp | hxq | hxs
    · exact Submodule.mem_map.2
        ⟨u₃, Submodule.subset_span (by simp), hxp ▸ hp⟩
    · exact Submodule.mem_map.2
        ⟨-u₂, Submodule.neg_mem _ (Submodule.subset_span (by simp)), hxq ▸ hq⟩
    · exact Submodule.mem_map.2
        ⟨u₁, Submodule.subset_span (by simp), hxs ▸ hs'⟩
  · apply Submodule.map_le_iff_le_comap.2
    apply Submodule.span_le.2
    intro x hx
    simp only [mem_insert_iff, mem_singleton_iff] at hx
    change (s / u₁) * x ∈ Submodule.span F ({p, q, s} : Set D)
    rcases hx with hx1 | hx2 | hx3
    · rw [hx1, hs']
      exact Submodule.subset_span (by simp)
    · have hqpos : (s / u₁) * u₂ = -q := by
        calc
          (s / u₁) * u₂ = -((s / u₁) * (-u₂)) := by ring
          _ = -q := by rw [hq]
      rw [hx2, hqpos]
      exact Submodule.neg_mem _ (Submodule.subset_span (by simp))
    · rw [hx3, hp]
      exact Submodule.subset_span (by simp)

theorem zero_product_tensor_homothety_nonzero
    {F D : Type*} [Field F] [Field D] [Algebra F D]
    (u₁ u₂ u₃ p q s : D)
    (hu₁ : u₁ ≠ 0) (hs : s ≠ 0)
    (h₁ : u₁ * p = u₃ * s)
    (h₂ : u₁ * q = -(u₂ * s)) :
    ∃ γ : D, γ ≠ 0 ∧
      Submodule.span F {p, q, s} =
        Submodule.map (LinearMap.mulLeft F γ)
          (Submodule.span F {u₁, u₂, u₃}) := by
  refine ⟨s / u₁, div_ne_zero hs hu₁, ?_⟩
  exact zero_product_tensor_homothety u₁ u₂ u₃ p q s hu₁ hs h₁ h₂

end D5.S3.Factorization.Galois.AuricSevenRigidity
