/- GID: D5/S3/Factorization/Galois/NormalCorePower
   generality: G
   mirror-B: D5/B/S3/Factorization/Galois/NormalCorePower
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Power-generated normal subgroups and their containment in finite-index normal cores. -/
import Mathlib.GroupTheory.Index
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Algebra.Group.Conj

set_option autoImplicit false

/-!
Algebraic reduction for Nikolov–Segal strong completeness (2007).
The power subgroup is generated by powers; the ambient group may be noncommutative.
No topological property of the abstract normal-core quotient is asserted.
-/
namespace D5.S3.Factorization.Galois.NormalCorePower

variable {G : Type*} [Group G]

/-- The algebraic subgroup generated by all `m`th powers. -/
def powerSubgroup (G : Type*) [Group G] (m : ℕ) : Subgroup G :=
  Subgroup.closure (Set.range (fun g : G => g ^ m))

theorem pow_mem_powerSubgroup (m : ℕ) (g : G) : g ^ m ∈ powerSubgroup G m :=
  Subgroup.subset_closure ⟨g, rfl⟩

instance powerSubgroup_normal (m : ℕ) : (powerSubgroup G m).Normal := by
  constructor
  intro x hx g
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    obtain ⟨a, rfl⟩ := hx
    rw [← conj_pow]
    exact pow_mem_powerSubgroup m _
  | one => simp
  | mul x y _ _ ihx ihy =>
    rw [← conj_mul]
    exact (powerSubgroup G m).mul_mem ihx ihy
  | inv x _ ihx =>
    rw [← conj_inv]
    exact (powerSubgroup G m).inv_mem ihx

/-- A normal quotient is annihilated by `m` precisely when it kills the power subgroup. -/
theorem powerSubgroup_le_iff (m : ℕ) (N : Subgroup G) [N.Normal] :
    powerSubgroup G m ≤ N ↔ ∀ q : G ⧸ N, q ^ m = 1 := by
  constructor
  · intro h q
    refine QuotientGroup.induction_on q ?_
    intro g
    rw [← QuotientGroup.mk_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (h (pow_mem_powerSubgroup m g))
  · intro h
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨g, rfl⟩
    exact (QuotientGroup.eq_one_iff _).mp
      (by simpa using h (QuotientGroup.mk' N g))

/-- Lagrange in the finite abstract quotient by the normal core. -/
theorem pow_normalCore_index_mem (H : Subgroup G) [H.FiniteIndex] (g : G) :
    g ^ H.normalCore.index ∈ H.normalCore := by
  apply (QuotientGroup.eq_one_iff _).mp
  change (QuotientGroup.mk' H.normalCore) (g ^ H.normalCore.index) = 1
  rw [map_pow]
  exact pow_card_eq_one'

theorem powerSubgroup_le_normalCore (H : Subgroup G) [H.FiniteIndex] :
    powerSubgroup G H.normalCore.index ≤ H.normalCore := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨g, rfl⟩
  exact pow_normalCore_index_mem H g

end D5.S3.Factorization.Galois.NormalCorePower
