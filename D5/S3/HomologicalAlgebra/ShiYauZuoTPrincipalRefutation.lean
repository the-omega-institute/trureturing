/-! Shi–Yau–Zuo, On T-maps and ideals of antiderivatives of hypersurface singularities,
Izvestiya: Mathematics 88 (2024), Conjecture 4.79, DOI 10.4213/im9488e. -/

set_option autoImplicit false

namespace D5.S3.HomologicalAlgebra.ShiYauZuoTPrincipalRefutation

/-- Definition 4.1. The ideal generated by the values of the component maps at f. -/
def valueIdeal {F A : Type} [Field F] [CommRing A] [Algebra F A] {n : ℕ}
    (components : Fin n → A →ₗ[F] A) (f : A) : Ideal A :=
  Ideal.span (Set.range fun j => components j f)

/-- Definitions 4.1 and 4.3. The linear maps are part of the T-map data. -/
structure TMap (F A : Type) [Field F] [CommRing A] [Algebra F A] where
  count : ℕ
  components : Fin count → A →ₗ[F] A
  mul_le : ∀ a f : A, valueIdeal components (a * f) ≤ valueIdeal components f

/-- Definition 4.6. The ideal sum of the Q(f) for f in J. -/
def imageIdeal {F A : Type} [Field F] [CommRing A] [Algebra F A]
    (Q : TMap F A) (J : Ideal A) : Ideal A :=
  ⨆ f : J, valueIdeal Q.components f

/-- Definition 4.8. The ideal of f with Q(f) contained in I. -/
def delta {F A : Type} [Field F] [CommRing A] [Algebra F A]
    (Q : TMap F A) (I : Ideal A) : Ideal A where
  carrier := {f | valueIdeal Q.components f ≤ I}
  zero_mem' := Ideal.span_le.mpr (by
    rintro _ ⟨j, rfl⟩
    change Q.components j 0 ∈ I
    rw [map_zero]
    exact I.zero_mem)
  add_mem' := by
    intro f g hf hg
    apply Ideal.span_le.mpr
    rintro _ ⟨j, rfl⟩
    change Q.components j (f + g) ∈ I
    rw [map_add]
    exact I.add_mem (hf (Ideal.subset_span ⟨j, rfl⟩)) (hg (Ideal.subset_span ⟨j, rfl⟩))
  smul_mem' := fun a f hf => le_trans (Q.mul_le a f) hf

/-- T-principality, as defined immediately after Example 4.5. -/
def TPrincipal {F A : Type} [Field F] [CommRing A] [Algebra F A]
    (Q : TMap F A) (I : Ideal A) : Prop :=
  ∃ f : A, I = valueIdeal Q.components f

/-- Definition 4.66. -/
def TFull {F A : Type} [Field F] [CommRing A] [Algebra F A]
    (Q : TMap F A) (I : Ideal A) : Prop :=
  imageIdeal Q (delta Q I) = I

/-- Definition 4.68. The generic linear combination of a finite generating tuple. -/
noncomputable def genericElement {A : Type} [CommRing A] {r : ℕ}
    (g : Fin r → A) : MvPolynomial (Fin r) A :=
  ∑ i : Fin r, MvPolynomial.C (g i) * MvPolynomial.X i

/-- Definition 4.68. Each component acts on coefficients and keeps the monomials. -/
noncomputable def genericImage {F A : Type} [Field F] [CommRing A] [Algebra F A]
    {r : ℕ} (Q : TMap F A) (g : Fin r → A) : Ideal (MvPolynomial (Fin r) A) := by
  classical
  exact Ideal.span (Set.range fun j =>
    (AddMonoidAlgebra.coeff (genericElement g)).sum fun d a =>
      MvPolynomial.monomial d (Q.components j a))

/-- Definition 4.68, using the colon test for a finite generating tuple.
Proposition 4.69 states independence of the generating tuple. -/
def TDependent {F A : Type} [Field F] [CommRing A] [Algebra F A] [IsLocalRing A]
    (Q : TMap F A) (J : Ideal A) : Prop :=
  ∃ (r : ℕ) (g : Fin r → A), Ideal.span (Set.range g) = J ∧
    ¬ ((genericImage Q g).colon
      (↑(Ideal.map (MvPolynomial.C : A →+* MvPolynomial (Fin r) A) (imageIdeal Q J)) :
        Set (MvPolynomial (Fin r) A)) ≤
        Ideal.map MvPolynomial.C (IsLocalRing.maximalIdeal A))

/-- Shi–Yau–Zuo, Conjecture 4.79. -/
def claim : Prop :=
  ∀ (F : Type) [Field F] (A : Type) [CommRing A] [Algebra F A]
    [IsLocalRing A] [IsNoetherianRing A],
    Nonempty (IsLocalRing.ResidueField A ≃ₐ[F] F) →
      ∀ (Q : TMap F A) (I : Ideal A),
        TPrincipal Q I ↔ TFull Q I ∧ TDependent Q (delta Q I)


open TrivSqZeroExt

private abbrev K := ZMod 2
private abbrev E := Fin 3 → K
private abbrev A₂ := TrivSqZeroExt K E

private instance : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

private abbrev scalar : A₂ →ₐ[K] K := fstHom K K E

private theorem scalar_surjective : Function.Surjective scalar :=
  fun c => ⟨inl c, rfl⟩

private instance : IsLocalHom scalar.toRingHom :=
  ⟨fun _ hx => isUnit_iff_isUnit_fst.mpr hx⟩

private instance : IsLocalRing A₂ := scalar.toRingHom.domain_isLocalRing

private instance : Finite A₂ := inferInstanceAs (Finite (K × E))

private abbrev I : Ideal A₂ := kerIdeal K E

private theorem ideal_eq_maximal : I = IsLocalRing.maximalIdeal A₂ :=
  IsLocalRing.ker_eq_maximalIdeal scalar.toRingHom scalar_surjective

private noncomputable def residueEquiv : IsLocalRing.ResidueField A₂ ≃ₐ[K] K :=
  (Ideal.quotientEquivAlgOfEq K ideal_eq_maximal.symm).trans
    (Ideal.quotientKerAlgEquivOfSurjective scalar_surjective)

private theorem mem_ideal (x : A₂) : x ∈ I ↔ x.fst = 0 := Iff.rfl

private def axis (i : Fin 3) : A₂ := inr (Pi.single i 1 : E)

private theorem axis_mem_ideal (i : Fin 3) : axis i ∈ I := rfl

private theorem span_axes : Ideal.span (Set.range axis) = I := by
  refine le_antisymm (Ideal.span_le.mpr ?_) ?_
  · rintro _ ⟨i, rfl⟩
    exact axis_mem_ideal i
  · intro x hx
    rw [mem_kerIdeal_iff_inr] at hx
    have hexpand : x = ∑ i : Fin 3, x.snd i • axis i := by
      conv_lhs => rw [hx]
      simp only [axis, ← inr_smul, ← inr_sum, ← Pi.single_smul, smul_eq_mul, mul_one]
      rw [LinearMap.sum_single_apply]
    rw [hexpand]
    refine Submodule.sum_mem _ fun i _ => ?_
    rw [Algebra.smul_def]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The active coordinate forms are u, v, and u + v, with values on their
respective coordinate axes. The third form is u − v over the binary field. -/
private def form : Fin 3 → E →ₗ[K] K :=
  let coordinate := LinearMap.proj (R := K) (φ := fun _ : Fin 3 => K)
  ![coordinate 0, coordinate 1, coordinate 0 + coordinate 1]

private def components (i : Fin 3) : A₂ →ₗ[K] A₂ :=
  (inlAlgHom K K E).toLinearMap.comp scalar.toLinearMap +
    (inrHom K E).comp ((LinearMap.single K (fun _ : Fin 3 => K) i).comp
      ((form i).comp (sndHom K E)))

private theorem components_apply (i : Fin 3) (x : A₂) :
    components i x = inl x.fst + inr (Pi.single i (form i x.snd)) := rfl

private theorem fst_components (i : Fin 3) (x : A₂) :
    (components i x).fst = x.fst := by
  simp [components_apply]

private theorem component_mem (i : Fin 3) (x : A₂) :
    components i x ∈ valueIdeal components x :=
  Ideal.subset_span ⟨i, rfl⟩

private theorem value_eq_top {x : A₂} (hx : x.fst ≠ 0) :
    valueIdeal components x = ⊤ := by
  have hu : IsUnit (components 0 x) :=
    isUnit_iff_isUnit_fst.mpr (isUnit_iff_ne_zero.mpr (by simpa [fst_components] using hx))
  have hspan : Ideal.span {components 0 x} ≤ valueIdeal components x :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (component_mem 0 x))
  rwa [Ideal.span_singleton_eq_top.mpr hu, top_le_iff] at hspan

private theorem mul_eq_smul_of_mem {x : A₂} (hx : x ∈ I) (a : A₂) :
    a * x = a.fst • x := by
  have hprod : (inr a.snd : A₂) * x ∈ I * I :=
    Ideal.mul_mem_mul (show (inr a.snd : A₂) ∈ I from rfl) hx
  have hzero : (inr a.snd : A₂) * x = 0 := by
    rwa [← pow_two, kerIdeal_sq, Submodule.mem_bot] at hprod
  calc
    a * x = (inl a.fst + inr a.snd) * x := by rw [inl_fst_add_inr_snd_eq]
    _ = inl a.fst * x := by rw [add_mul, hzero, add_zero]
    _ = a.fst • x := inl_mul_eq_smul _ _

private def binaryTMap : TMap K A₂ where
  count := 3
  components := components
  mul_le := by
    intro a x
    by_cases hx : x ∈ I
    · refine Ideal.span_le.mpr ?_
      rintro _ ⟨i, rfl⟩
      change components i (a * x) ∈ valueIdeal components x
      rw [mul_eq_smul_of_mem hx, map_smul, Algebra.smul_def]
      exact Ideal.mul_mem_left _ _ (component_mem i x)
    · rw [value_eq_top (mt (mem_ideal x).mpr hx)]
      exact le_top

private theorem delta_eq_ideal : delta binaryTMap I = I := by
  ext x
  change valueIdeal components x ≤ I ↔ x ∈ I
  constructor
  · intro h
    have h₀ := (mem_ideal _).mp (h (component_mem 0 x))
    exact (mem_ideal x).mpr (by simpa [fst_components] using h₀)
  · intro hx
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    exact (mem_ideal _).mpr (by simpa [fst_components] using (mem_ideal x).mp hx)

private theorem image_eq_ideal : imageIdeal binaryTMap I = I := by
  refine le_antisymm (iSup_le fun x => ?_) ?_
  · have hx := x.property
    change x.val ∈ delta binaryTMap I
    rwa [delta_eq_ideal]
  · refine span_axes.symm.le.trans ?_
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    have himage : ∃ j : Fin 3, components i (axis j) = axis i := by
      fin_cases i
      · exact ⟨0, by simp [components_apply, form, axis]⟩
      · exact ⟨1, by simp [components_apply, form, axis]⟩
      · exact ⟨0, by simp [components_apply, form, axis]⟩
    obtain ⟨j, hj⟩ := himage
    rw [← hj]
    exact le_iSup (fun x : I => valueIdeal binaryTMap.components x)
      ⟨axis j, axis_mem_ideal j⟩ (component_mem i (axis j))

private theorem binary_full : TFull binaryTMap I := by
  rw [TFull, delta_eq_ideal, image_eq_ideal]



private theorem binary_not_principal : ¬ TPrincipal binaryTMap I := by
  rintro ⟨x, hx⟩
  by_cases hxI : x ∈ I
  · have hz : x.fst = 0 := (mem_ideal x).mp hxI
    have hforms : ∀ u v : K, v = 0 ∨ u = 0 ∨ u + v = 0 := by decide
    have hvanishes : ∃ i : Fin 3, form i x.snd = 0 := by
      rcases hforms (x.snd 0) (x.snd 1) with hv | hu | huv
      · exact ⟨1, by simpa [form] using hv⟩
      · exact ⟨0, by simpa [form] using hu⟩
      · exact ⟨2, by simpa [form] using huv⟩
    obtain ⟨i, hi⟩ := hvanishes
    let missing : Ideal A₂ :=
      { carrier := {y | y ∈ I ∧ y.snd i = 0}
        zero_mem' := ⟨I.zero_mem, rfl⟩
        add_mem' := by
          rintro y z ⟨hy, hyi⟩ ⟨hz, hzi⟩
          exact ⟨I.add_mem hy hz, by simp [Pi.add_apply, hyi, hzi]⟩
        smul_mem' := by
          rintro a y ⟨hy, hyi⟩
          refine ⟨I.mul_mem_left a hy, ?_⟩
          change (a * y).snd i = 0
          rw [mul_eq_smul_of_mem hy]
          simp [Pi.smul_apply, hyi] }
    have hle : valueIdeal components x ≤ missing := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨j, rfl⟩
      change components j x ∈ I ∧ (components j x).snd i = 0
      refine ⟨(mem_ideal _).mpr ((fst_components j x).trans hz), ?_⟩
      by_cases hji : j = i
      · subst j
        simp [components_apply, hi]
      · simp [components_apply, Ne.symm hji]
    have haxis := hle (show axis i ∈ valueIdeal components x from hx ▸ axis_mem_ideal i)
    have hzero : (axis i).snd i = 0 := haxis.2
    simp [axis] at hzero
  · have htop : I = ⊤ := hx.trans (value_eq_top (mt (mem_ideal x).mpr hxI))
    have hone : (1 : A₂) ∈ I := by rw [htop]; trivial
    exact one_ne_zero ((mem_ideal 1).mp hone)

/-- On the generic element, coefficientwise extension applies the linear map
to each generator coefficient while leaving its variable fixed. -/
private theorem generic_coefficients {F A : Type} [Field F] [CommRing A] [Algebra F A]
    {r : ℕ} (g : Fin r → A) (L : A →ₗ[F] A) :
    ((AddMonoidAlgebra.coeff (genericElement g)).sum
        fun d a => MvPolynomial.monomial d (L a)) =
      ∑ i : Fin r, MvPolynomial.C (L (g i)) * MvPolynomial.X i := by
  classical
  let lift : MvPolynomial (Fin r) A →+ MvPolynomial (Fin r) A :=
    { toFun := fun p => (AddMonoidAlgebra.coeff p).sum fun d a => MvPolynomial.monomial d (L a)
      map_zero' := by change (0 : ((Fin r →₀ ℕ) →₀ A)).sum _ = _; simp
      map_add' := by
        intro p q
        change ((AddMonoidAlgebra.coeff p) + (AddMonoidAlgebra.coeff q)).sum _ = _
        exact Finsupp.sum_add_index' (by simp) (by simp) }
  change lift (genericElement g) = _
  rw [genericElement, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  simp only [MvPolynomial.C_mul_X_eq_monomial]
  change (Finsupp.single (Finsupp.single i 1) (g i)).sum
      (fun d a => MvPolynomial.monomial d (L a)) = _
  rw [Finsupp.sum_single_index (by simp)]

open MvPolynomial

private abbrev S := MvPolynomial (Fin 3) A₂

private noncomputable def U : S := X 0
private noncomputable def V : S := X 1
private noncomputable def P : S := U * V * (U + V)

private noncomputable def factor : Fin 3 → S := ![U, V, U + V]

private theorem generic_axis_mem (i : Fin 3) :
    C (axis i) * factor i ∈ genericImage binaryTMap axis := by
  apply Ideal.subset_span
  refine ⟨i, ?_⟩
  change ((AddMonoidAlgebra.coeff (genericElement axis)).sum
    fun d a => monomial d (components i a)) = _
  rw [generic_coefficients]
  change (∑ j : Fin 3, C (components i (axis j)) * X j) = _
  fin_cases i <;>
    simp [Fin.sum_univ_three, components_apply, form, axis, Pi.single_apply,
      factor, U, V, mul_add]

private theorem P_mul_axis_mem (i : Fin 3) :
    P * C (axis i) ∈ genericImage binaryTMap axis := by
  have h := generic_axis_mem i
  fin_cases i
  · change C (axis 0) * U ∈ _ at h
    change P * C (axis 0) ∈ _
    rw [show P * C (axis 0) = (V * (U + V)) * (C (axis 0) * U) by unfold P; ac_rfl]
    exact Ideal.mul_mem_left _ _ h
  · change C (axis 1) * V ∈ _ at h
    change P * C (axis 1) ∈ _
    rw [show P * C (axis 1) = (U * (U + V)) * (C (axis 1) * V) by unfold P; ac_rfl]
    exact Ideal.mul_mem_left _ _ h
  · change C (axis 2) * (U + V) ∈ _ at h
    change P * C (axis 2) ∈ _
    rw [show P * C (axis 2) = (U * V) * (C (axis 2) * (U + V)) by unfold P; ac_rfl]
    exact Ideal.mul_mem_left _ _ h

private theorem P_in_colon :
    P ∈ (genericImage binaryTMap axis).colon
      (↑(Ideal.map (C : A₂ →+* S) (imageIdeal binaryTMap I)) : Set S) := by
  rw [image_eq_ideal, ← span_axes, Ideal.map_span, ← Set.range_comp, Ideal.colon_span]
  exact Submodule.mem_colon.mpr (by
    rintro _ ⟨i, rfl⟩
    exact P_mul_axis_mem i)

private theorem P_outside_maximal_extension :
    P ∉ Ideal.map (C : A₂ →+* S) (IsLocalRing.maximalIdeal A₂) := by
  let project : S →+* MvPolynomial (Fin 3) K := MvPolynomial.map scalar.toRingHom
  have hker : Ideal.map (C : A₂ →+* S) (IsLocalRing.maximalIdeal A₂) ≤ RingHom.ker project := by
    rw [← ideal_eq_maximal, Ideal.map_le_iff_le_comap]
    intro x hx
    change project (C x) = 0
    simp [project, show scalar x = 0 from (mem_ideal x).mp hx]
  intro hmem
  have hzero : project P = 0 := hker hmem
  have hsum : (X 0 + X 1 : MvPolynomial (Fin 3) K) ≠ 0 := by
    intro h
    have he := congrArg (MvPolynomial.eval ![1, 0, 0]) h
    simp at he
  have hnonzero : project P ≠ 0 := by
    simpa [project, P, U, V] using
      mul_ne_zero (mul_ne_zero (X_ne_zero (R := K) (0 : Fin 3)) (X_ne_zero (1 : Fin 3))) hsum
  exact hnonzero hzero

private theorem binary_dependent : TDependent binaryTMap (delta binaryTMap I) := by
  rw [delta_eq_ideal]
  exact ⟨3, axis, span_axes, fun hinclusion =>
    P_outside_maximal_extension (hinclusion P_in_colon)⟩

/-- The square-zero algebra over the binary field refutes Conjecture 4.79. -/
theorem result : Not claim := by
  intro h
  exact binary_not_principal ((h K A₂ ⟨residueEquiv⟩ binaryTMap I).mpr
    ⟨binary_full, binary_dependent⟩)

end D5.S3.HomologicalAlgebra.ShiYauZuoTPrincipalRefutation
