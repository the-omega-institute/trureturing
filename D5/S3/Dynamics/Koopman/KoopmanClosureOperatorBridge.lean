import D5.S3.Dynamics.Koopman.DiscreteKoopmanOperator
import Mathlib.Tactic

/-!
# Koopman closure and operator bridge

The repository's existing `koopmanGenerators` were defined as observables of
the form `g composed with tau^[n]`.  The first-class discrete Koopman operator
makes this exactly `koopmanIterate tau n g`.

This module proves equality of the two generator sets and rewrites the
existing generated star algebra directly in operator-iterate language.  No
new closure is introduced.
-/

/- Library-search audit trail (2026-09-01):
   * `ObservableAlgebraClosureDuality` owns `fiberStarAlgebra`,
     `koopmanGenerators`, and `koopmanClosure`.
   * `DiscreteKoopmanOperator` owns `koopmanIterate`.
   * This file is a compatibility bridge and introduces no parallel generated
     algebra. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Dynamics.Koopman.KoopmanClosureOperatorBridge

open D5.S3.QuantumStates.ObservableAlgebraClosureDuality
open D5.S3.Dynamics.Koopman.DiscreteKoopmanOperator

noncomputable section

universe u

variable {State : Type u}

/-- Existing Koopman generators expressed through the first-class finite
iterate. -/
def operatorKoopmanGenerators
    (relation : State → State → Prop) (update : State → State) :
    Set (State → ℂ) :=
  {observable | ∃ depth sourceObservable,
    sourceObservable ∈ fiberStarAlgebra relation ∧
      observable = koopmanIterate update depth sourceObservable}

/-- The existing and operator-based generator sets are identical. -/
theorem operatorKoopmanGenerators_eq_existing
    (relation : State → State → Prop) (update : State → State) :
    operatorKoopmanGenerators relation update =
      koopmanGenerators relation update := by
  ext observable
  rfl

/-- The existing Koopman closure is the star algebra generated by finite
iterates of the first-class operator. -/
theorem koopmanClosure_eq_adjoin_operatorIterates
    (relation : State → State → Prop) (update : State → State) :
    koopmanClosure relation update =
      StarAlgebra.adjoin ℂ (operatorKoopmanGenerators relation update) := by
  rw [operatorKoopmanGenerators_eq_existing]
  rfl

/-- Every source-fiber observable enters the operator generator set at depth
zero. -/
theorem sourceObservable_mem_operatorKoopmanGenerators
    (relation : State → State → Prop) (update : State → State)
    {observable : State → ℂ}
    (hObservable : observable ∈ fiberStarAlgebra relation) :
    observable ∈ operatorKoopmanGenerators relation update := by
  refine ⟨0, observable, hObservable, ?_⟩
  simp [koopmanIterate]

/-- Applying one further Koopman pullback advances the generator depth. -/
theorem koopmanIterate_succ_mem_operatorKoopmanGenerators
    (relation : State → State → Prop) (update : State → State)
    (depth : ℕ) {observable : State → ℂ}
    (hObservable : observable ∈ fiberStarAlgebra relation) :
    koopmanIterate update (depth + 1) observable ∈
      operatorKoopmanGenerators relation update := by
  exact ⟨depth + 1, observable, hObservable, rfl⟩

example :
    (1 : Unit → ℂ) ∈
      operatorKoopmanGenerators (fun _ _ => True) id := by
  apply sourceObservable_mem_operatorKoopmanGenerators
  intro first second _
  rfl

#print axioms operatorKoopmanGenerators_eq_existing
#print axioms koopmanClosure_eq_adjoin_operatorIterates
#print axioms sourceObservable_mem_operatorKoopmanGenerators
#print axioms koopmanIterate_succ_mem_operatorKoopmanGenerators

end

end D5.S3.Dynamics.Koopman.KoopmanClosureOperatorBridge
