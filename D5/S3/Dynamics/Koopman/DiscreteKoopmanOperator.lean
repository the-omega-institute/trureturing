import D5.S3.QuantumStates.ObservableAlgebraClosureDuality
import Mathlib.Tactic

/-!
# Discrete Koopman operator

Every state update `tau : X -> X` acts contravariantly on complex observables
by pullback

`U_tau f = f composed with tau`.

This pullback is complex-linear, preserves constants and pointwise products,
and reverses composition order.  Koopman iterates are pullbacks along finite
state iterates.  Eigenfunctions multiply, with eigenvalues multiplying.

The repository already contains algebras generated by iterated pullbacks.  The
present module supplies the first-class linear operator underlying those
closures.  It does not assume topology, a measure, boundedness on a Banach
space, spectral completeness, or Pollicott-Ruelle resonance theory.
-/

/- Library-search audit trail (2026-09-01):
   * `ObservableAlgebraClosureDuality` and
     `LeastInvariantObservableAlgebra` own generated pullback algebras and
     stable-fiber characterizations, but no named linear Koopman operator.
   * Repository search found no first-class `LinearMap` for discrete pullback
     with the composition and eigenfunction laws below.
   * Pinned Mathlib supplies function modules, linear maps, and function
     iteration. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Dynamics.Koopman.DiscreteKoopmanOperator

noncomputable section

universe u

variable {State : Type u}

/-- Complex-linear pullback along a discrete state update. -/
def discreteKoopmanOperator (update : State → State) :
    (State → ℂ) →ₗ[ℂ] (State → ℂ) where
  toFun observable := observable ∘ update
  map_add' first second := rfl
  map_smul' scalar observable := rfl

/-- Pullback along the identity update is the identity linear map. -/
theorem discreteKoopmanOperator_id :
    discreteKoopmanOperator (id : State → State) = LinearMap.id := by
  ext observable state
  rfl

/-- Koopman pullback reverses update composition order. -/
theorem discreteKoopmanOperator_comp
    (first second : State → State) :
    (discreteKoopmanOperator first).comp
        (discreteKoopmanOperator second) =
      discreteKoopmanOperator (second ∘ first) := by
  ext observable state
  rfl

/-- Pullback preserves the constant unit observable. -/
theorem discreteKoopmanOperator_one
    (update : State → State) :
    discreteKoopmanOperator update (1 : State → ℂ) = 1 := by
  rfl

/-- Pullback preserves pointwise products of observables. -/
theorem discreteKoopmanOperator_mul
    (update : State → State) (first second : State → ℂ) :
    discreteKoopmanOperator update (first * second) =
      discreteKoopmanOperator update first *
        discreteKoopmanOperator update second := by
  rfl

/-- Pullback after a finite state iterate. -/
def koopmanIterate
    (update : State → State) (depth : ℕ)
    (observable : State → ℂ) : State → ℂ :=
  observable ∘ update^[depth]

/-- Zero Koopman depth leaves the observable unchanged. -/
theorem koopmanIterate_zero
    (update : State → State) (observable : State → ℂ) :
    koopmanIterate update 0 observable = observable := by
  rfl

/-- One more Koopman depth applies one pullback to the previous iterate. -/
theorem koopmanIterate_succ
    (update : State → State) (depth : ℕ)
    (observable : State → ℂ) :
    koopmanIterate update (depth + 1) observable =
      discreteKoopmanOperator update
        (koopmanIterate update depth observable) := by
  funext state
  simp [koopmanIterate, Function.iterate_succ_apply]

/-- Koopman eigenfunction equation. -/
def IsKoopmanEigenfunction
    (update : State → State) (observable : State → ℂ)
    (eigenvalue : ℂ) : Prop :=
  discreteKoopmanOperator update observable =
    eigenvalue • observable

/-- The constant unit observable is a Koopman eigenfunction with eigenvalue
one. -/
theorem one_isKoopmanEigenfunction
    (update : State → State) :
    IsKoopmanEigenfunction update (1 : State → ℂ) 1 := by
  rfl

/-- Pointwise products of Koopman eigenfunctions multiply their eigenvalues. -/
theorem isKoopmanEigenfunction_mul
    (update : State → State)
    {first second : State → ℂ} {firstEigenvalue secondEigenvalue : ℂ}
    (hFirst : IsKoopmanEigenfunction update first firstEigenvalue)
    (hSecond : IsKoopmanEigenfunction update second secondEigenvalue) :
    IsKoopmanEigenfunction update (first * second)
      (firstEigenvalue * secondEigenvalue) := by
  unfold IsKoopmanEigenfunction at hFirst hSecond ⊢
  funext state
  have hFirstState := congrFun hFirst state
  have hSecondState := congrFun hSecond state
  change first (update state) * second (update state) =
    (firstEigenvalue * secondEigenvalue) *
      (first state * second state)
  change first (update state) = firstEigenvalue * first state at hFirstState
  change second (update state) = secondEigenvalue * second state at hSecondState
  rw [hFirstState, hSecondState]
  ring

/-- Finite Koopman iterates of an eigenfunction multiply by the corresponding
eigenvalue power. -/
theorem koopmanIterate_eigenfunction
    (update : State → State)
    {observable : State → ℂ} {eigenvalue : ℂ}
    (hEigen : IsKoopmanEigenfunction update observable eigenvalue)
    (depth : ℕ) :
    koopmanIterate update depth observable =
      eigenvalue ^ depth • observable := by
  induction depth with
  | zero =>
      simp [koopmanIterate_zero]
  | succ depth inductionHypothesis =>
      rw [show depth + 1 = Nat.succ depth by omega,
        Nat.succ_eq_add_one, koopmanIterate_succ,
        inductionHypothesis]
      unfold IsKoopmanEigenfunction at hEigen
      funext state
      change eigenvalue ^ depth * observable (update state) =
        eigenvalue ^ (depth + 1) * observable state
      have hState := congrFun hEigen state
      change observable (update state) = eigenvalue * observable state at hState
      rw [hState, pow_succ]
      ring

example :
    IsKoopmanEigenfunction (id : Unit → Unit) (1 : Unit → ℂ) 1 :=
  one_isKoopmanEigenfunction _

#print axioms discreteKoopmanOperator_id
#print axioms discreteKoopmanOperator_comp
#print axioms discreteKoopmanOperator_one
#print axioms discreteKoopmanOperator_mul
#print axioms koopmanIterate_succ
#print axioms one_isKoopmanEigenfunction
#print axioms isKoopmanEigenfunction_mul
#print axioms koopmanIterate_eigenfunction

end

end D5.S3.Dynamics.Koopman.DiscreteKoopmanOperator
