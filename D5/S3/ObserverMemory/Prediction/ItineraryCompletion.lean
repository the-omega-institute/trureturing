namespace D5.S3.ObserverMemory.Prediction.ItineraryCompletion

open D5.S3.ObserverMemory.Prediction.ConditionalEntropyStability

/-- The complete future readout generated by a state. -/
def completeItinerary {Y O : Type*} (tau : Y -> Y) (q : Y -> O)
    (y : Y) : Nat -> O :=
  fun n => q ((tau^[n]) y)

/-- The realized complete itineraries. -/
abbrev ItineraryRange {Y O : Type*} (tau : Y -> Y) (q : Y -> O) :=
  Set.range (completeItinerary tau q)

/-- The realized readout words through a fixed finite depth. -/
abbrev FiniteItineraryRange {Y O : Type*} (tau : Y -> Y) (q : Y -> O)
    (m : Nat) :=
  Set.range (futureReadoutWord tau q m)

/-- Restrict a word at depth `n` to a word at an earlier depth `m`. -/
def restrictWord {O : Type*} {m n : Nat} (h : m <= n)
    (word : Fin (n + 1) -> O) : Fin (m + 1) -> O :=
  fun k => word ⟨k, lt_of_lt_of_le k.isLt (Nat.succ_le_succ h)⟩

/-- The inverse limit of the realized finite words: every coordinate is
realized and all coordinates agree under restriction. -/
structure CompatibleItineraryFamily {Y O : Type*}
    (tau : Y -> Y) (q : Y -> O) where
  word : (m : Nat) -> Fin (m + 1) -> O
  realized : forall m, word m ∈ FiniteItineraryRange tau q m
  compatible : forall {m n} (h : m <= n),
    restrictWord h (word n) = word m

@[ext]
theorem CompatibleItineraryFamily.ext {Y O : Type*}
    {tau : Y -> Y} {q : Y -> O}
    (a b : CompatibleItineraryFamily tau q)
    (h : a.word = b.word) : a = b := by
  cases a
  cases b
  cases h
  rfl

/-- A distinguishing time for two states, or zero if none exists. -/
noncomputable def distinguishingTime {Y O : Type*}
    (tau : Y -> Y) (q : Y -> O) (y y' : Y) : Nat := by
  classical
  exact if h : exists n, completeItinerary tau q y n ≠
    completeItinerary tau q y' n then Classical.choose h else 0

private theorem distinguishing_time_spec {Y O : Type*}
    (tau : Y -> Y) (q : Y -> O) (y y' : Y)
    (h : exists n, completeItinerary tau q y n ≠
      completeItinerary tau q y' n) :
    completeItinerary tau q y (distinguishingTime tau q y y') ≠
      completeItinerary tau q y' (distinguishingTime tau q y y') := by
  rw [distinguishingTime, dif_pos h]
  exact Classical.choose_spec h

/-- The largest chosen distinguishing time among the finitely many state
pairs. -/
noncomputable def completionDepth {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) : Nat :=
  Finset.univ.sup fun pair : Y × Y =>
    distinguishingTime tau q pair.1 pair.2

/-- Agreement through the completion depth determines the entire future. -/
theorem completion_depth_determines_itinerary {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) (y y' : Y)
    (hprefix : futureReadoutWord tau q (completionDepth tau q) y =
      futureReadoutWord tau q (completionDepth tau q) y') :
    completeItinerary tau q y = completeItinerary tau q y' := by
  classical
  by_contra hne
  have hexists : exists n, completeItinerary tau q y n ≠
      completeItinerary tau q y' n := by
    by_contra hall
    push Not at hall
    exact hne (funext hall)
  let k := distinguishingTime tau q y y'
  have hkle : k <= completionDepth tau q := by
    exact Finset.le_sup (s := Finset.univ)
      (f := fun pair : Y × Y => distinguishingTime tau q pair.1 pair.2)
      (Finset.mem_univ (y, y'))
  have hcoordinate := congrFun hprefix ⟨k, Nat.lt_succ_of_le hkle⟩
  have hdifferent := distinguishing_time_spec tau q y y' hexists
  exact hdifferent (by
    simpa [k, futureReadoutWord, completeItinerary] using hcoordinate)

/-- Truncate a complete itinerary at a finite depth. -/
def truncateItinerary {O : Type*} (m : Nat) (itinerary : Nat -> O) :
    Fin (m + 1) -> O :=
  fun k => itinerary k

/-- Projection of a realized itinerary to one finite coordinate. -/
def coordinateProjection {Y O : Type*} (tau : Y -> Y) (q : Y -> O)
    (m : Nat) : ItineraryRange tau q -> FiniteItineraryRange tau q m :=
  fun itinerary =>
    ⟨truncateItinerary m itinerary.1, by
      rcases itinerary.2 with ⟨y, hy⟩
      refine ⟨y, ?_⟩
      funext k
      simpa [futureReadoutWord, completeItinerary, truncateItinerary] using
        congrFun hy k⟩

private theorem completion_coordinate_bijective {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) :
    Function.Bijective
      (coordinateProjection tau q (completionDepth tau q)) := by
  constructor
  · intro first second heq
    rcases first.2 with ⟨y, hy⟩
    rcases second.2 with ⟨y', hy'⟩
    apply Subtype.ext
    have htrunc := congrArg Subtype.val heq
    have hprefix : futureReadoutWord tau q (completionDepth tau q) y =
        futureReadoutWord tau q (completionDepth tau q) y' := by
      calc
        futureReadoutWord tau q (completionDepth tau q) y =
            truncateItinerary (completionDepth tau q) first.1 := by
          funext k
          simpa [futureReadoutWord, completeItinerary, truncateItinerary] using
            congrFun hy k
        _ = truncateItinerary (completionDepth tau q) second.1 := htrunc
        _ = futureReadoutWord tau q (completionDepth tau q) y' := by
          funext k
          simpa [futureReadoutWord, completeItinerary, truncateItinerary] using
            (congrFun hy' k).symm
    exact hy.symm.trans
      ((completion_depth_determines_itinerary tau q y y' hprefix).trans hy')
  · intro word
    rcases word.2 with ⟨y, hy⟩
    let itinerary : ItineraryRange tau q :=
      ⟨completeItinerary tau q y, ⟨y, rfl⟩⟩
    refine ⟨itinerary, ?_⟩
    apply Subtype.ext
    change truncateItinerary (completionDepth tau q)
      (completeItinerary tau q y) = word.1
    calc
      truncateItinerary (completionDepth tau q)
          (completeItinerary tau q y) =
          futureReadoutWord tau q (completionDepth tau q) y := rfl
      _ = word.1 := hy

/-- At the completion depth, coordinate projection is an equivalence. -/
noncomputable def completionCoordinateEquiv {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) :
    ItineraryRange tau q ≃
      FiniteItineraryRange tau q (completionDepth tau q) :=
  Equiv.ofBijective (coordinateProjection tau q (completionDepth tau q))
    (completion_coordinate_bijective tau q)

/-- Send a complete itinerary to all of its compatible finite prefixes. -/
def itineraryToLimit {Y O : Type*} (tau : Y -> Y) (q : Y -> O) :
    ItineraryRange tau q -> CompatibleItineraryFamily tau q :=
  fun itinerary =>
    { word := fun m => truncateItinerary m itinerary.1
      realized := by
        intro m
        rcases itinerary.2 with ⟨y, hy⟩
        refine ⟨y, ?_⟩
        funext k
        simpa [futureReadoutWord, completeItinerary, truncateItinerary] using
          congrFun hy k
      compatible := by
        intro m n h
        rfl }

private theorem itinerary_to_limit_bijective {Y O : Type*}
    (finiteStates : Fintype Y) (tau : Y -> Y) (q : Y -> O) :
    Function.Bijective (itineraryToLimit tau q) := by
  letI : Fintype Y := finiteStates
  constructor
  · intro first second heq
    apply Subtype.ext
    funext n
    have hprefix := congrArg
      (fun family : CompatibleItineraryFamily tau q => family.word n) heq
    exact congrFun hprefix ⟨n, Nat.lt_succ_self n⟩
  · intro family
    let depth := completionDepth tau q
    let stableWord : FiniteItineraryRange tau q depth :=
      ⟨family.word depth, family.realized depth⟩
    let itinerary : ItineraryRange tau q :=
      (completionCoordinateEquiv tau q).symm stableWord
    have hstable : truncateItinerary depth itinerary.1 = family.word depth := by
      have heq := (completionCoordinateEquiv tau q).apply_symm_apply stableWord
      exact congrArg Subtype.val heq
    refine ⟨itinerary, ?_⟩
    apply CompatibleItineraryFamily.ext
    funext m
    funext k
    rcases le_total m depth with hmd | hdm
    · let lifted : Fin (depth + 1) :=
        ⟨k, lt_of_lt_of_le k.isLt (Nat.succ_le_succ hmd)⟩
      calc
        (itineraryToLimit tau q itinerary).word m k =
            family.word depth lifted := by
              exact congrFun hstable lifted
        _ = family.word m k := by
          exact congrFun (family.compatible hmd) k
    · rcases family.realized m with ⟨y, hy⟩
      rcases itinerary.2 with ⟨stableState, hstableState⟩
      have hdepthWords :
          futureReadoutWord tau q depth y =
            futureReadoutWord tau q depth stableState := by
        calc
          futureReadoutWord tau q depth y =
              restrictWord hdm (futureReadoutWord tau q m y) := by rfl
          _ = restrictWord hdm (family.word m) := by rw [hy]
          _ = family.word depth := family.compatible hdm
          _ = truncateItinerary depth itinerary.1 := hstable.symm
          _ = futureReadoutWord tau q depth stableState := by
            funext j
            simpa [truncateItinerary, futureReadoutWord, completeItinerary] using
              (congrFun hstableState j).symm
      have hall := completion_depth_determines_itinerary
        tau q y stableState hdepthWords
      calc
        (itineraryToLimit tau q itinerary).word m k = itinerary.1 k := rfl
        _ = completeItinerary tau q y k := by
          exact (congrFun (hall.trans hstableState) k).symm
        _ = futureReadoutWord tau q m y k := rfl
        _ = family.word m k := congrFun hy k

/-- Realized itineraries are equivalent to the inverse limit of their finite
prefix ranges. -/
noncomputable def itineraryLimitEquiv {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) :
    ItineraryRange tau q ≃ CompatibleItineraryFamily tau q :=
  Equiv.ofBijective (itineraryToLimit tau q)
    (itinerary_to_limit_bijective (inferInstance : Fintype Y) tau q)

/-- The shift update on realized complete itineraries. -/
def itineraryUpdate {Y O : Type*} (tau : Y -> Y) (q : Y -> O) :
    ItineraryRange tau q -> ItineraryRange tau q :=
  fun itinerary =>
    ⟨fun n => itinerary.1 (n + 1), by
      rcases itinerary.2 with ⟨y, hy⟩
      refine ⟨tau y, ?_⟩
      funext n
      simpa [completeItinerary, Function.iterate_succ_apply] using
        congrFun hy n.succ⟩

/-- The quotient update transported through the canonical kernel-range
equivalence. -/
noncomputable def quotientUpdate {Y O : Type*} (tau : Y -> Y) (q : Y -> O) :
    Quotient (Setoid.ker (completeItinerary tau q)) ->
      Quotient (Setoid.ker (completeItinerary tau q)) :=
  fun state =>
    (Setoid.quotientKerEquivRange (completeItinerary tau q)).symm
      (itineraryUpdate tau q
        (Setoid.quotientKerEquivRange (completeItinerary tau q) state))

/-- The inverse-limit update transported through the itinerary-limit
equivalence. -/
noncomputable def limitUpdate {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) :
    CompatibleItineraryFamily tau q -> CompatibleItineraryFamily tau q :=
  fun family => itineraryLimitEquiv tau q
    (itineraryUpdate tau q ((itineraryLimitEquiv tau q).symm family))

private theorem quotient_equiv_intertwines {Y O : Type*}
    (tau : Y -> Y) (q : Y -> O) :
    Function.Semiconj
      (Setoid.quotientKerEquivRange (completeItinerary tau q))
      (quotientUpdate tau q) (itineraryUpdate tau q) := by
  intro state
  simp [quotientUpdate]

private theorem limit_equiv_intertwines {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) :
    Function.Semiconj (itineraryLimitEquiv tau q)
      (itineraryUpdate tau q) (limitUpdate tau q) := by
  intro itinerary
  simp [limitUpdate]

/-- The kernel quotient, realized complete itineraries, and compatible finite
prefix limit are dynamically equivalent. At one finite depth, coordinate
projection is already bijective, so the infinite completion terminates there. -/
theorem itinerary_completion {Y O : Type*} [Fintype Y]
    (tau : Y -> Y) (q : Y -> O) :
    (exists e : Quotient (Setoid.ker (completeItinerary tau q)) ≃
        ItineraryRange tau q,
      Function.Semiconj e (quotientUpdate tau q) (itineraryUpdate tau q)) /\
    (exists e : ItineraryRange tau q ≃ CompatibleItineraryFamily tau q,
      Function.Semiconj e (itineraryUpdate tau q) (limitUpdate tau q)) /\
    (exists m, exists e : ItineraryRange tau q ≃ FiniteItineraryRange tau q m,
      e.toFun = coordinateProjection tau q m /\
        Function.Bijective (coordinateProjection tau q m)) := by
  refine ⟨⟨Setoid.quotientKerEquivRange (completeItinerary tau q),
      quotient_equiv_intertwines tau q⟩,
    ⟨itineraryLimitEquiv tau q, limit_equiv_intertwines tau q⟩,
    completionDepth tau q, completionCoordinateEquiv tau q, rfl, ?_⟩
  exact completion_coordinate_bijective tau q

end D5.S3.ObserverMemory.Prediction.ItineraryCompletion
