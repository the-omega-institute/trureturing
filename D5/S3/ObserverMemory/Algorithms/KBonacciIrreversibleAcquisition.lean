/- GID: D5/S3/ObserverMemory/Algorithms/KBonacciIrreversibleAcquisition
   generality: I
   mirror-B: D5/B/S3/ObserverMemory/Algorithms/KBonacciIrreversibleAcquisition
   mirror-E: none(waiver:symbolic-proof-no-numeric-artifact)
   anchors: []
   utility: none
   digest: Complete actual-history first-zero acquisition classification and uniform cost. -/

import D5.S3.ObserverMemory.Algorithms.KBonacciAcquisition.FirstZeroRecursion

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ObserverMemory.Algorithms.KBonacciIrreversibleAcquisition

open D5.S0.Tower.DBonacci.Names
open D5.S3.ObserverMemory.Prediction.ControlledBehaviorUniversality
open scoped BigOperators
open D5.S3.ObserverMemory.Algorithms.KBonacciAcquisition.LiteralModel
open D5.S3.ObserverMemory.Algorithms.KBonacciAcquisition.EndpointCells
open D5.S3.ObserverMemory.Algorithms.KBonacciAcquisition.PhaseRecovery
open D5.S3.ObserverMemory.Algorithms.KBonacciAcquisition.FirstZeroRecursion

/- This model uses the original KBonacci recurrence, its fixed mod-two scalar,
legal-run language and endpoint alphabet. Its all-order results do not provide
a theorem for an arbitrary recurrence, scalar readout or controlled machine. -/

/-- The complete source prior, with every live joint record and bottom. -/
def SourceRecord (k m : ℕ) : Option (LiveRecord k) → Prop
  | none => True
  | some q => q.tail < k ∧ Nat.gcd m (k+1) ∣ q.phase.val

/-- Chronological actual complete-block history, with no intermediate readout. -/
def historyRecordFrom {k m : ℕ} {localAlphabet : Bool}
    (history : List (AllowedBlock k m localAlphabet)) (q : Option (LiveRecord k)) :=
  history.foldl (fun current action => runBits k action.val current) q

/-- The record generated by one actual history from the empty word. -/
def historyRecord {k m : ℕ} {localAlphabet : Bool}
    (history : List (AllowedBlock k m localAlphabet)) : Option (LiveRecord k) :=
  historyRecordFrom history (some ⟨0,0,0⟩)

/-- Free initial endpoint output selects one deterministic actual tree. -/
def RecordAcquiredAt {k m : ℕ} (localAlphabet : Bool) {Y : Type*}
    (f : Option (LiveRecord k) → Y) (n : ℕ) : Prop :=
  ∃ controller : Option (ZMod 2) → AcquisitionTree k m localAlphabet Y n,
    ∀ q, SourceRecord k m q → (controller (endpointReading q)).result q = f q

/-- Uniformly finite initial-record acquisition. -/
def RecordAcquired {k m : ℕ} (localAlphabet : Bool) {Y : Type*}
    (f : Option (LiveRecord k) → Y) : Prop := ∃ n, RecordAcquiredAt (m := m) localAlphabet f n

/-- The target is evaluated on the INITIAL actual block history. -/
def HistoryAcquired {k m : ℕ} (localAlphabet : Bool) {Y : Type*}
    (F : List (AllowedBlock k m localAlphabet) → Y) : Prop :=
  ∃ n, ∃ controller : Option (ZMod 2) → AcquisitionTree k m localAlphabet Y n,
    ∀ history, (controller (endpointReading (historyRecord history))).result (historyRecord history) = F history

/-- A target on the actual prior extends to ambient records using its
initial bottom label only outside the source domain. This extension never
identifies a live rejection label with the label of an initially rejected source. -/
noncomputable def actualSourceTarget {k m : ℕ} {Y : Type*}
    (target : {q : Option (LiveRecord k) // SourceRecord k m q} → Y)
    (q : Option (LiveRecord k)) : Y := by
  classical
  exact if h : SourceRecord k m q then target ⟨q,h⟩ else target ⟨none,trivial⟩

/-- Complete original first-zero classification on the same actual history
prior. Both alphabets, arbitrary labels, free initial output, all archived
prefixes and the source's uniform cost are in the same statement. -/
theorem whole_first_zero_acquisition (k m : ℕ) (hk : 2 ≤ k) (hm : 1 ≤ m)
    (localAlphabet : Bool) {Y : Type*}
    (target : {q : Option (LiveRecord k) // SourceRecord k m q} → Y) :
    let f := actualSourceTarget target
    (∀ q, SourceRecord k m q ↔ ∃ history : List (AllowedBlock k m localAlphabet), historyRecord history = q) ∧
    (RecordAcquired (m := m) localAlphabet f ↔
      FirstZeroCriterion k m hm f 0 0 k {phase | Nat.gcd m (k+1) ∣ phase.val} ∧
      FirstZeroCriterion k m hm f 1 0 k {phase | Nat.gcd m (k+1) ∣ phase.val}) ∧
    (RecordAcquired (m := m) localAlphabet f →
      ∃ controller : Option (ZMod 2) → AcquisitionTree k m localAlphabet Y (prefixBudget k m k),
        (∀ q, SourceRecord k m q → (controller (endpointReading q)).result q = f q) ∧
        (controller none).result none = f none ∧ (controller none).archive none = [] ∧
        ∀ q, ((controller (endpointReading q)).archive q).length ≤ prefixBudget k m k) ∧
    (2 ≤ m → prefixBudget k m k = (k-1)/m + (k+1)/Nat.gcd m (k+1)) ∧
    (∀ F : List (AllowedBlock k m localAlphabet) → Y,
      HistoryAcquired localAlphabet F ↔ ∃ target : Option (LiveRecord k) → Y,
        (∀ history, target (historyRecord history) = F history) ∧ RecordAcquired (m := m) localAlphabet target) ∧
    (∀ (t : ℕ) (v : ZMod 2) (b : ℕ → ZMod 2),
      {pair | ∃ phase s, SourceRecord k m (some ⟨v,phase,s⟩) ∧
        OnesArchive k m t v phase s b ∧
        pair = (some ⟨v,phase,s⟩, allOneOrbit k m t (some ⟨v,phase,s⟩))} =
      prefixRecords k m t (k-t*m) v (v+∑ i ∈ Finset.range t,b i)
        {phase | Nat.gcd m (k+1) ∣ phase.val ∧ ∀ i, i<t → allOneIncrement k m i phase=b i}) := by
  classical
  dsimp only
  let f := actualSourceTarget target
  have actual : ∀ q, SourceRecord k m q ↔ ∃ history : List (AllowedBlock k m localAlphabet),
      historyRecord history = q := by
    intro q
    have appendRun : ∀ (left right : List Bool) (current : Option (LiveRecord k)),
        runWord (bitUpdate k) (left ++ right) current =
          runWord (bitUpdate k) right (runWord (bitUpdate k) left current) := by
      intro left
      induction left with
      | nil => intro right current; rfl
      | cons bit left ih =>
          intro right current
          simpa only [List.cons_append, runWord] using ih right (bitUpdate k bit current)
    have expanded : ∀ (history : List (AllowedBlock k m localAlphabet)) current,
        historyRecordFrom history current =
          runWord (bitUpdate k) (history.flatMap (fun action => List.ofFn action.val)) current := by
      intro history
      induction history with
      | nil => intro current; rfl
      | cons action history ih =>
          intro current
          change historyRecordFrom history (runBits k action.val current) = _
          rw [ih, List.flatMap_cons, appendRun]
          rfl
    have lengthBits : ∀ history : List (AllowedBlock k m localAlphabet),
        (history.flatMap (fun action => List.ofFn action.val)).length = history.length * m := by
      intro history
      induction history with
      | nil => simp
      | cons action history ih =>
          simp only [List.flatMap_cons, List.length_append, List.length_ofFn,
            List.length_cons, ih, Nat.add_mul, Nat.one_mul]
          omega
    have valid : ∀ history : List (AllowedBlock k m localAlphabet),
        SourceRecord k m (historyRecordFrom history (some ⟨0, 0, 0⟩)) := by
      intro history
      let bits := history.flatMap (fun action => List.ofFn action.val)
      let word : Fin bits.length → Bool := fun i => bits[i]
      have wordBits : List.ofFn word = bits := by
        exact List.ofFn_getElem
      rw [expanded]
      change SourceRecord k m (runWord (bitUpdate k) bits (some ⟨0, 0, 0⟩))
      rw [← wordBits]
      change SourceRecord k m (runBits k word (some ⟨0, 0, 0⟩))
      have model := literal_block_execution k hk bits.length word 0 0 0 (by omega)
      rw [model.1]
      by_cases scan : runAdmissible (k - 1) (k - 1 - 0) bits.length word = true
      · rw [if_pos scan]
        refine ⟨model.2 scan, ?_⟩
        change Nat.gcd m (k + 1) ∣ (0 + (bits.length : ZMod (k + 1))).val
        rw [zero_add, ZMod.val_natCast]
        apply (Nat.dvd_mod_iff (Nat.gcd_dvd_right m (k + 1))).mpr
        rw [show bits.length = history.length * m from lengthBits history]
        exact dvd_mul_of_dvd_right (Nat.gcd_dvd_left m (k + 1)) history.length
      · rw [if_neg scan]
        trivial
    have liveHistory : ∀ (v : ZMod 2) (phase : ZMod (k + 1)) (s : ℕ),
        s < k → Nat.gcd m (k + 1) ∣ phase.val →
        ∃ history : List (AllowedBlock k m localAlphabet),
          historyRecordFrom history (some ⟨0, 0, 0⟩) = some ⟨v, phase, s⟩ := by
      intro v phase s hs hp
      obtain ⟨N, word, divisible, _, realized, _, _, each⟩ :=
        joint_history_realization k m hk hm v phase s hs hp
      let r := N / m
      have lengthEq : r * m = N := Nat.div_mul_cancel divisible
      let blocks : Fin r → AllowedBlock k m localAlphabet := fun j =>
        ⟨(fun i : Fin m => word ⟨j.val * m + i.val, by
            rw [← lengthEq]; nlinarith [j.isLt, i.isLt]⟩),
          fun _ => each j.val (by rw [← lengthEq]; nlinarith [j.isLt])⟩
      let history := List.ofFn blocks
      have split := List.ofFn_mul (fun i : Fin (r * m) => word (Fin.cast lengthEq i))
      have casted : List.ofFn (fun i : Fin (r * m) => word (Fin.cast lengthEq i)) =
          List.ofFn word := by
        calc
          _ = List.ofFn (fun i : Fin N => word (Fin.cast lengthEq (Fin.cast lengthEq.symm i))) :=
            List.ofFn_congr lengthEq _
          _ = _ := by
            apply congrArg List.ofFn
            funext i
            apply congrArg word
            apply Fin.ext
            rfl
      have flatten : history.flatMap (fun action => List.ofFn action.val) = List.ofFn word := by
        rw [← casted, split]
        change (List.ofFn blocks).flatMap (fun action => List.ofFn action.val) = _
        rw [List.flatMap, List.map_ofFn]
        apply congrArg List.flatten
        apply congrArg List.ofFn
        funext j
        apply congrArg List.ofFn
        funext i
        dsimp [blocks]
      refine ⟨history, ?_⟩
      rw [expanded, flatten]
      exact realized
    constructor
    · intro prior
      cases q with
      | some record => exact liveHistory record.value record.phase record.tail prior.1 prior.2
      | none =>
          obtain ⟨history, reaches⟩ := liveHistory 0 0 (k - 1) (by omega) (by simp)
          obtain ⟨width, widthEq⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : m ≠ 0)
          have leadingLegal : DBonacciAdmissible k m (isolatedProbe m 0) := by
            obtain ⟨order, orderEq⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : k ≠ 0)
            rw [widthEq, orderEq]
            have head : isolatedProbe (width + 1) 0 0 = true := by simp [isolatedProbe]
            have tail : Fin.tail (isolatedProbe (width + 1) 0) = (fun _ => false) := by
              funext i; simp [isolatedProbe, Fin.tail]
            cases order with
            | zero => omega
            | succ order =>
                simpa only [DBonacciAdmissible, runAdmissible, head, ↓reduceIte, tail]
                  using D5.S0.Tower.DBonacci.Values.runAdmissible_all_false (order + 1) order width
          let action : AllowedBlock k m localAlphabet := ⟨isolatedProbe m 0, fun _ => leadingLegal⟩
          have absorbed : ∀ bits : List Bool, runWord (bitUpdate k) bits none = none := by
            intro bits
            induction bits with
            | nil => rfl
            | cons bit bits ih => simpa only [runWord, bitUpdate] using ih
          have rejects : runBits k action.val (some ⟨0, 0, k - 1⟩) = none := by
            change runBits k (isolatedProbe m 0) _ = _
            rw [widthEq]
            simp only [runBits, List.ofFn_succ, runWord]
            have head : isolatedProbe (width + 1) 0 0 = true := by simp [isolatedProbe]
            simp only [bitUpdate, head, ↓reduceIte, if_neg (by omega : ¬ k - 1 + 1 < k)]
            exact absorbed _
          refine ⟨history ++ [action], ?_⟩
          simp only [historyRecord, historyRecordFrom, List.foldl_append, List.foldl_cons, List.foldl_nil]
          change runBits k action.val (historyRecordFrom history (some ⟨0, 0, 0⟩)) = none
          rw [reaches, rejects]
    · rintro ⟨history, rfl⟩
      exact valid history

  let P : Set (ZMod (k+1)) := {phase | Nat.gcd m (k+1) ∣ phase.val}
  have pNonempty : P.Nonempty := ⟨0,by simp [P]⟩
  have positive : 0 < k := by omega
  have balance : k+0*m = k := by omega
  let root := fun v => prefixCell k m 0 k v v P positive pNonempty
  have rootMember : ∀ v phase s, phase ∈ P → s<k →
      (some ⟨v,phase,s⟩,some ⟨v,phase,s⟩) ∈ (root v).val := by
    intro v phase s hp hs
    exact ⟨phase,hp,s,hs,by simp⟩
  have values : ∀ v : ZMod 2, v=0 ∨ v=1 := by
    intro v
    have range := ZMod.val_lt v
    have split : v.val=0 ∨ v.val=1 := by omega
    rcases split with zero | one
    · exact Or.inl (ZMod.val_injective 2 (by simpa using zero))
    · exact Or.inr (ZMod.val_injective 2 (by change v.val = 1; exact one))
  have necessity : RecordAcquired (m := m) localAlphabet f →
      ∀ v, FirstZeroCriterion k m hm f v 0 k P := by
    rintro ⟨n,controller,correct⟩ v
    apply first_zero_necessity k m hk hm localAlphabet f v k 0 balance positive v P pNonempty n
    apply (native_controller_exact k m localAlphabet f n (root v)).mp
    refine ⟨controller (some v),?_,?_⟩
    · rintro pair ⟨phase,hp,s,hs,equal⟩
      cases equal
      simpa only [Nat.zero_mul,Nat.cast_zero,add_zero,endpointReading]
        using correct (some ⟨v,phase,s⟩) ⟨hs,hp⟩
    · have horizon : ∀ {n} (tree : AcquisitionTree k m localAlphabet Y n) q,
          (tree.archive q).length ≤ n := by
        intro n tree
        induction tree with
        | stop label => intro q; simp [AcquisitionTree.archive]
        | @step n action next ih =>
            intro q
            exact Nat.succ_le_succ (ih (endpointReading (runBits k action.val q)) (runBits k action.val q))
      exact horizon _
  have construct : (∀ v, FirstZeroCriterion k m hm f v 0 k P) →
      ∃ controller : Option (ZMod 2) → AcquisitionTree k m localAlphabet Y (prefixBudget k m k),
        (∀ q, SourceRecord k m q → (controller (endpointReading q)).result q = f q) ∧
        (controller none).result none = f none ∧ (controller none).archive none = [] ∧
        ∀ q, ((controller (endpointReading q)).archive q).length ≤ prefixBudget k m k := by
    intro criteria
    have trees : ∀ v, ∃ tree : AcquisitionTree k m localAlphabet Y (prefixBudget k m k),
        (∀ pair ∈ (root v).val, tree.result pair.2 = f pair.1) ∧
        ∀ q, (tree.archive q).length ≤ prefixBudget k m k := by
      intro v
      apply (native_controller_exact k m localAlphabet f (prefixBudget k m k) (root v)).mpr
      exact first_zero_sufficiency k m hk hm localAlphabet f v k 0 balance positive v P
        pNonempty (fun _ hp => hp) (criteria v)
    choose tree correct horizon using trees
    let controller := fun reply => match reply with
      | none => AcquisitionTree.stop (f none)
      | some v => tree v
    refine ⟨controller,?_,rfl,rfl,?_⟩
    · intro q source
      cases q with
      | none => rfl
      | some record =>
          exact correct record.value (some record,some record)
            (rootMember record.value record.phase record.tail source.2 source.1)
    · intro q
      cases q with
      | none => exact Nat.zero_le _
      | some record => exact horizon record.value _
  refine ⟨actual,?_,?_,?_,?_,?_⟩
  · constructor
    · intro acquired; exact ⟨necessity acquired 0,necessity acquired 1⟩
    · intro criteria
      have all : ∀ v, FirstZeroCriterion k m hm f v 0 k P := by
        intro v
        rcases values v with rfl | rfl
        · exact criteria.1
        · exact criteria.2
      obtain ⟨controller,correct,rest⟩ := construct all
      exact ⟨prefixBudget k m k,controller,correct⟩
  · intro acquired
    exact construct (necessity acquired)
  · intro many
    by_cases singleton : (k+1)/Nat.gcd m (k+1)=1
    · have gEq : Nat.gcd m (k+1)=k+1 := by
        have product := Nat.div_mul_cancel (Nat.gcd_dvd_right m (k+1))
        rw [singleton,one_mul] at product
        exact product
      have big : k+1 ≤ m := by
        rw [← gEq]; exact Nat.le_of_dvd (by omega) (Nat.gcd_dvd_left m (k+1))
      have small : k - 1 < m := by omega
      simp [prefixBudget,phaseCost,singleton,Nat.div_eq_of_lt small]
    · simp [prefixBudget,phaseCost,singleton,many]
      have pos : 0 < (k+1)/Nat.gcd m (k+1) := Nat.div_gcd_pos_of_pos_right m (by omega)
      omega
  · intro F
    constructor
    · rintro ⟨n,controller,correct⟩
      let target := fun q => (controller (endpointReading q)).result q
      exact ⟨target,correct,n,controller,fun _ _ => rfl⟩
    · rintro ⟨target,factors,n,controller,correct⟩
      refine ⟨n,controller,?_⟩
      intro history
      exact (correct (historyRecord history) ((actual _).mpr ⟨history,rfl⟩)).trans (factors history)
  · intro t v b
    ext pair
    constructor
    · rintro ⟨phase,s,source,archive,equal⟩
      have facts := all_one_archive_exact k m hk hm t v phase s source.1 b
      obtain ⟨safe,matching⟩ := facts.1.mp archive
      refine ⟨phase,⟨source.2,matching⟩,s,by omega,?_⟩
      rw [equal,facts.2.1 archive]
    · rintro ⟨phase,⟨hp,matching⟩,s,hs,equal⟩
      have safe : s+t*m<k := by omega
      have facts := all_one_archive_exact k m hk hm t v phase s (by omega) b
      have archive := facts.1.mpr ⟨safe,matching⟩
      refine ⟨phase,s,⟨by change s < k; omega,hp⟩,archive,?_⟩
      rw [facts.2.1 archive]
      exact equal

#print axioms whole_first_zero_acquisition


end D5.S3.ObserverMemory.Algorithms.KBonacciIrreversibleAcquisition
