import D5.S3.ConceptDynamics.Experiment.PassivePolicyNormalization
import D5.S3.ObserverMemory.Algorithms.SharedControlBitStorageBound
import D5.S3.ObserverMemory.Prediction.ActionGraphCommunicationBound
import Mathlib.LinearAlgebra.Projection

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ObserverMemory.Algorithms.InitializedControlProtocol

attribute [local instance] Classical.propDecidable

open D5.S3.ConceptDynamics.Experiment.PassivePolicyNormalization
open D5.S3.ObserverMemory.Algorithms.SharedControlBitStorageBound
open D5.S3.ObserverMemory.Prediction.ControlledBehaviorUniversality
open D5.S3.ObserverMemory.Prediction.ActionGraphCommunicationBound

universe u v w x

/-- A question is tagged by its sender and reads only that sender's old state. -/
abbrev Question (MA : Type u) (MB : Type v) := (MA → Bool) ⊕ (MB → Bool)

/-- Query labels are evaluator data; only their Boolean responses are public. -/
abbrev Trace (MA : Type u) (MB : Type v) := Hist (fun _ : Question MA MB => Bool)

/-- The public transcript has exactly one bit for each paid question. -/
def bits {MA : Type u} {MB : Type v} (t : Trace MA MB) : List Bool :=
  t.map (fun e => e.2)

/-- The bit returned by the tagged sender. -/
def answer {MA : Type u} {MB : Type v} :
    (q : Question MA MB) → MA × MB → Bool
  | .inl f, m => f m.1
  | .inr f, m => f m.2

/-- A public prefix determines a sender-local question or a public leaf.
The two leaf outputs retain access to their own old states until commit. -/
structure EndpointProtocol (MA : Type u) (MB : Type v)
    (OA : Type w) (OB : Type x) where
  node : List Bool → Question MA MB ⊕ Unit
  outA : MA → List Bool → OA
  outB : MB → List Bool → OB

/-- Labels are reconstructed from public responses, never an additional channel. -/
def EndpointProtocol.policy {MA : Type u} {MB : Type v} {OA : Type w} {OB : Type x}
    (p : EndpointProtocol MA MB OA OB) (h : Trace MA MB) : Question MA MB ⊕ Unit :=
  p.node (bits h)

/-- Count right-to-left bits on this very execution. -/
def rightCount {MA : Type u} {MB : Type v} (t : Trace MA MB) : Nat :=
  (t.map (fun e => match e.1 with | .inl _ => 0 | .inr _ => 1)).sum

/-- Count left-to-right bits on this very execution. -/
def leftCount {MA : Type u} {MB : Type v} (t : Trace MA MB) : Nat :=
  (t.map (fun e => match e.1 with | .inl _ => 1 | .inr _ => 0)).sum

/-- The original full data and control source. -/
abbrev Source (d : Nat) := (Fin d → ZMod 2) × ZMod 2

/-- Every original basis translation and every original control rewrite. -/
inductive Action (d : Nat) where
  | dataTranslation : Fin d → Action d
  | controlTranslation : Action d
  | rewrite : Fin d → Action d
  deriving DecidableEq, Fintype

/-- Source interpretation directly reuses the established control rewrite. -/
def Action.apply {d : Nat} : Action d → Source d → Source d
  | .dataTranslation i, z => z + (Pi.single i 1, 0)
  | .controlTranslation, z => z + (0, 1)
  | .rewrite i, z => controlRewrite i z

/-- Persistent endpoints and public roots before imposing source correctness. -/
structure ControllerData (d : Nat) (A B : Submodule (ZMod 2) (Source d))
    (MA : Type u) (MB : Type v) (Root : Type w) where
  readA : MA → A
  readB : MB → B
  initA : A → MA
  initB : B → MB
  read_initA : ∀ a, readA (initA a) = a
  read_initB : ∀ b, readB (initB b) = b
  rootA : Action d → MA → Root
  rootB : Action d → MB → Root
  protocol : Action d → Root → EndpointProtocol MA MB MA MB

/-- A successful actual execution uses an agreed root chosen from the left state. -/
def ControllerData.Exec {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {MA : Type u} {MB : Type v} {Root : Type w}
    (C : ControllerData d A B MA MB Root) (f : Action d) (m : MA × MB)
    (t : Trace MA MB) : Prop :=
  ∃ n, execute answer (C.protocol f (C.rootA f m.1)).policy n [] m = some (t, ())

/-- Both components are local leaf updates applied to the same public bit string. -/
def ControllerData.commit {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {MA : Type u} {MB : Type v} {Root : Type w}
    (C : ControllerData d A B MA MB Root) (f : Action d) (m : MA × MB)
    (t : Trace MA MB) : MA × MB :=
  let p := C.protocol f (C.rootA f m.1)
  (p.outA m.1 (bits t), p.outB m.2 (bits t))

/-- Operational support is generated by the full local initialization product
and successful protocol executions, rather than a stipulated nominal carrier. -/
inductive ControllerData.Reachable {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {MA : Type u} {MB : Type v} {Root : Type w}
    (C : ControllerData d A B MA MB Root) : MA × MB → Prop
  | initial (a : A) (b : B) : C.Reachable (C.initA a, C.initB b)
  | next {m : MA × MB} (hm : C.Reachable m) (f : Action d)
      (t : Trace MA MB) (ht : C.Exec f m t) : C.Reachable (C.commit f m t)

/-- Compliance quantifies arbitrary local types and requires termination only
on operational support. The specification is a readout law, never an executor. -/
structure Controller {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    (split : IsCompl A B) (MA : Type u) (MB : Type v) (Root : Type w)
    extends ControllerData d A B MA MB Root where
  root_agree : ∀ m, toControllerData.Reachable m → ∀ f, rootA f m.1 = rootB f m.2
  terminates : ∀ m, toControllerData.Reachable m → ∀ f, ∃ t, toControllerData.Exec f m t
  actualA : ∀ a : MA, ∃ b : MB, toControllerData.Reachable (a, b)
  actualB : ∀ b : MB, ∃ a : MA, toControllerData.Reachable (a, b)
  correct : ∀ m, toControllerData.Reachable m → ∀ f t, toControllerData.Exec f m t →
    let z := (readA m.1 : Source d) + (readB m.2 : Source d)
    readA (toControllerData.commit f m t).1 = A.projectionOnto B split (f.apply z) ∧
    readB (toControllerData.commit f m t).2 = B.projectionOnto A split.symm (f.apply z)
  free_translation : ∀ m, toControllerData.Reachable m → ∀ t,
    (∀ i, toControllerData.Exec (.dataTranslation i) m t → t = []) ∧
    (toControllerData.Exec .controlTranslation m t → t = [])

/-- The operational joint carrier, including only actual reachable pairs. -/
abbrev Controller.State {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {split : IsCompl A B} {MA : Type u} {MB : Type v} {Root : Type w}
    (C : Controller split MA MB Root) := {m : MA × MB // C.toControllerData.Reachable m}

/-- Finite termination evidence selects the evaluator's actual transcript.
Fuel is a mathematical termination witness, not an endpoint runtime input. -/
noncomputable def Controller.trace {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {split : IsCompl A B} {MA : Type u} {MB : Type v} {Root : Type w}
    (C : Controller split MA MB Root) (f : Action d) (m : C.State) : Trace MA MB :=
  Classical.choose (C.terminates m.val m.property f)

/-- The protocol-realized action on actual support. -/
noncomputable def Controller.step {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {split : IsCompl A B} {MA : Type u} {MB : Type v} {Root : Type w}
    (C : Controller split MA MB Root) (f : Action d) (m : C.State) : C.State :=
  ⟨C.toControllerData.commit f m.val (C.trace f m),
    .next m.property f (C.trace f m) (Classical.choose_spec (C.terminates m.val m.property f))⟩

/-- Every sent bit is charged; neither root choice nor timing supplies bits. -/
noncomputable def Controller.cost {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {split : IsCompl A B} {MA : Type u} {MB : Type v} {Root : Type w}
    (C : Controller split MA MB Root) (m : C.State) (f : Action d) : Nat :=
  (C.trace f m).length

/-- The locally prepared actual state for any original summary pair. -/
def Controller.initial {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {split : IsCompl A B} {MA : Type u} {MB : Type v} {Root : Type w}
    (C : Controller split MA MB Root) (a : A) (b : B) : C.State :=
  ⟨(C.initA a, C.initB b), .initial a b⟩

/-- Mathematical current-source readout; it is never a protocol input. -/
def Controller.readout {d : Nat} {A B : Submodule (ZMod 2) (Source d)}
    {split : IsCompl A B} {MA : Type u} {MB : Type v} {Root : Type w}
    (C : Controller split MA MB Root) (m : C.State) : Source d :=
  (C.readA m.val.1 : Source d) + (C.readB m.val.2 : Source d)

/-- Successful histories are publicly labelled at every prefix and end at a leaf. -/
def PublicTrace {MA : Type u} {MB : Type v} {OA : Type w} {OB : Type x}
    (p : EndpointProtocol MA MB OA OB) : List Bool → Trace MA MB → Prop
  | h, [] => p.node h = .inr ()
  | h, e :: t => p.node h = .inl e.1 ∧ PublicTrace p (h ++ [e.2]) t


end D5.S3.ObserverMemory.Algorithms.InitializedControlProtocol
