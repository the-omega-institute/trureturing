/-- An infinite compatible family in the inverse system generated by a self-map. -/
def BackwardOrbit {Y : Type*} (F : Y -> Y) :=
  {orbit : Nat -> Y // forall n : Nat, F (orbit (n + 1)) = orbit n}

/-- Advancing from a later coordinate by the corresponding iterate recovers an earlier one. -/
theorem backward_iterate_apply
    {Y : Type*} {F : Y -> Y} (orbit : BackwardOrbit F) (n k : Nat) :
    (F^[k]) (orbit.1 (n + k)) = orbit.1 n := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hstep : F (orbit.1 (n + k + 1)) = orbit.1 (n + k) := orbit.2 (n + k)
      rw [Function.iterate_succ_apply]
      rw [show n + k.succ = n + k + 1 by omega, hstep]
      exact ih

/-- Every coordinate of an infinite backward trajectory on a finite carrier is periodic. -/
theorem backward_orbit_coordinate_periodic
    {Y : Type*} [Finite Y] {F : Y -> Y} (orbit : BackwardOrbit F) (n : Nat) :
    orbit.1 n ∈ Function.periodicPts F := by
  letI := Fintype.ofFinite Y
  obtain ⟨i, j, hij, horbit⟩ :=
    Fintype.exists_ne_map_eq_of_card_lt
      (fun k : Fin (Fintype.card Y + 1) => orbit.1 (n + k.val))
      (by simp)
  rcases lt_or_gt_of_ne hij with hij_lt | hji_lt
  · have hperiod :
        Function.IsPeriodicPt F (j.val - i.val) (orbit.1 (n + i.val)) := by
      change (F^[j.val - i.val]) (orbit.1 (n + i.val)) = orbit.1 (n + i.val)
      calc
        (F^[j.val - i.val]) (orbit.1 (n + i.val)) =
            (F^[j.val - i.val]) (orbit.1 (n + j.val)) :=
          congrArg (F^[j.val - i.val]) horbit
        _ = orbit.1 (n + i.val) := by
          have htail := backward_iterate_apply orbit (n + i.val) (j.val - i.val)
          rw [show n + i.val + (j.val - i.val) = n + j.val by omega] at htail
          exact htail
    have hperiod_at_n := hperiod.apply_iterate i.val
    rw [backward_iterate_apply orbit n i.val] at hperiod_at_n
    exact Function.mk_mem_periodicPts (by omega) hperiod_at_n
  · have hperiod :
        Function.IsPeriodicPt F (i.val - j.val) (orbit.1 (n + j.val)) := by
      change (F^[i.val - j.val]) (orbit.1 (n + j.val)) = orbit.1 (n + j.val)
      calc
        (F^[i.val - j.val]) (orbit.1 (n + j.val)) =
            (F^[i.val - j.val]) (orbit.1 (n + i.val)) :=
          congrArg (F^[i.val - j.val]) horbit.symm
        _ = orbit.1 (n + j.val) := by
          have htail := backward_iterate_apply orbit (n + j.val) (i.val - j.val)
          rw [show n + j.val + (i.val - j.val) = n + i.val by omega] at htail
          exact htail
    have hperiod_at_n := hperiod.apply_iterate j.val
    rw [backward_iterate_apply orbit n j.val] at hperiod_at_n
    exact Function.mk_mem_periodicPts (by omega) hperiod_at_n

/-- Evaluation at coordinate zero canonically identifies the inverse limit of a finite self-map
with its periodic core. In particular, the two types have the same finite cardinality. -/
theorem backward_orbit_eval_zero_bijective
    {Y : Type*} [Finite Y] (F : Y -> Y) :
    Function.Bijective
      (fun orbit : BackwardOrbit F =>
        (⟨orbit.1 0, backward_orbit_coordinate_periodic orbit 0⟩ :
          {point : Y // point ∈ Function.periodicPts F})) := by
  classical
  letI := Fintype.ofFinite Y
  let periodicCore := {point : Y // point ∈ Function.periodicPts F}
  let shift : periodicCore -> periodicCore := fun point =>
    ⟨F point.1, (Function.bijOn_periodicPts F).mapsTo point.2⟩
  have hshift : Function.Bijective shift := by
    constructor
    · intro a b hab
      apply Subtype.ext
      exact (Function.bijOn_periodicPts F).injOn a.2 b.2 (congrArg Subtype.val hab)
    · intro b
      obtain ⟨a, ha, hab⟩ := (Function.bijOn_periodicPts F).surjOn b.2
      exact ⟨⟨a, ha⟩, Subtype.ext hab⟩
  let cycleEquiv : periodicCore ≃ periodicCore := Equiv.ofBijective shift hshift
  constructor
  · intro a b hab
    apply Subtype.ext
    funext n
    induction n with
    | zero => exact congrArg Subtype.val hab
    | succ n ih =>
        have ha_mem := backward_orbit_coordinate_periodic a n.succ
        have hb_mem := backward_orbit_coordinate_periodic b n.succ
        rw [Function.mem_periodicPts] at ha_mem hb_mem
        obtain ⟨pa, hpa, ha⟩ := ha_mem
        obtain ⟨pb, hpb, hb⟩ := hb_mem
        exact ha.eq_of_apply_eq hb hpa hpb (by rw [a.2 n, b.2 n, ih])
  · intro point
    let orbit : Nat -> Y := fun n => (((cycleEquiv.symm)^[n]) point).1
    have horbit : forall n : Nat, F (orbit (n + 1)) = orbit n := by
      intro n
      have hstep :
          cycleEquiv (((cycleEquiv.symm)^[n + 1]) point) =
            ((cycleEquiv.symm)^[n]) point := by
        rw [Function.iterate_succ_apply', cycleEquiv.apply_symm_apply]
      exact congrArg Subtype.val hstep
    refine ⟨⟨orbit, horbit⟩, ?_⟩
    apply Subtype.ext
    simp [orbit]

#print axioms backward_orbit_eval_zero_bijective

