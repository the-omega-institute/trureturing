import D5.S3.ObserverMemory.Prediction.ControlledBehaviorUniversality

/- Library-search audit trail (2026-08-28):
   * Exact family hits `runWord`, `controlledBehavior`, `ControlledCompletion`,
     `completionProjection`, `completionRangeEquiv`, and `completionUpdate` are
     imported and reused as the canonical controlled-behavior primitives.
   * Body-shape searches for a transported range update, a behavior word
     update, and append laws found no existing D5 declaration.
   * The generic `controlAction` family assumes a monoid action already exists;
     it does not construct the free word action generated by arbitrary
     input-indexed updates. No full-statement pinned-Mathlib hit was found. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ObserverMemory.RefinementClosure.BehaviorUpdateWordAction

open D5.S3.ObserverMemory.Prediction.ControlledBehaviorUniversality

/-- The one-input update on the exact realized behavior range, transported
through the canonical quotient-to-range equivalence. -/
noncomputable def behaviorUpdate {U Y O : Type*}
    (update : U -> Y -> Y) (readout : Y -> O) (u : U) :
    Set.range (controlledBehavior update readout) ->
      Set.range (controlledBehavior update readout) :=
  fun behavior =>
    completionRangeEquiv update readout
      (completionUpdate update readout u
        ((completionRangeEquiv update readout).symm behavior))

private theorem completion_range_equiv_projection {U Y O : Type*}
    (update : U -> Y -> Y) (readout : Y -> O) (y : Y) :
    completionRangeEquiv update readout
        (completionProjection update readout y) =
      Set.rangeFactorization (controlledBehavior update readout) y := by
  apply Subtype.ext
  rfl

private theorem behavior_update_projection {U Y O : Type*}
    (update : U -> Y -> Y) (readout : Y -> O) (u : U) (y : Y) :
    behaviorUpdate update readout u
        (Set.rangeFactorization (controlledBehavior update readout) y) =
      Set.rangeFactorization (controlledBehavior update readout) (update u y) := by
  have inverseProjection :
      (completionRangeEquiv update readout).symm
          (Set.rangeFactorization (controlledBehavior update readout) y) =
        completionProjection update readout y := by
    apply (completionRangeEquiv update readout).injective
    rw [(completionRangeEquiv update readout).apply_symm_apply]
    exact completion_range_equiv_projection update readout y
  rw [behaviorUpdate, inverseProjection]
  exact completion_range_equiv_projection update readout (update u y)

/-- Apply a finite input word to an exact realized behavior, from left to
right, using the canonical one-input range update. -/
noncomputable def behaviorWordUpdate {U Y O : Type*}
    (update : U -> Y -> Y) (readout : Y -> O) :
    List U -> Set.range (controlledBehavior update readout) ->
      Set.range (controlledBehavior update readout)
  | [], behavior => behavior
  | u :: word, behavior =>
      behaviorWordUpdate update readout word
        (behaviorUpdate update readout u behavior)

/-- A one-input behavior update is representative-independent. On the exact
realized behavior range it has the canonical computation rule, while finite
words act with the identity and concatenation laws and agree with `runWord`. -/
theorem behavior_update_well_defined
    {U Y O : Type*} (update : U -> Y -> Y) (readout : Y -> O) :
    (forall u y y',
      controlledBehavior update readout y =
        controlledBehavior update readout y' ->
      controlledBehavior update readout (update u y) =
        controlledBehavior update readout (update u y')) /\
    (forall u y,
      behaviorUpdate update readout u
          (Set.rangeFactorization (controlledBehavior update readout) y) =
        Set.rangeFactorization (controlledBehavior update readout) (update u y)) /\
    (forall behavior,
      behaviorWordUpdate update readout [] behavior = behavior) /\
    (forall first second behavior,
      behaviorWordUpdate update readout (first ++ second) behavior =
        behaviorWordUpdate update readout second
          (behaviorWordUpdate update readout first behavior)) /\
    (forall word y,
      behaviorWordUpdate update readout word
          (Set.rangeFactorization (controlledBehavior update readout) y) =
        Set.rangeFactorization (controlledBehavior update readout)
          (runWord update word y)) := by
  constructor
  · intro u y y' sameBehavior
    funext word
    simpa [controlledBehavior, runWord] using congrFun sameBehavior (u :: word)
  constructor
  · intro u y
    exact behavior_update_projection update readout u y
  constructor
  · intro behavior
    rfl
  constructor
  · intro first
    induction first with
    | nil =>
        intro second behavior
        rfl
    | cons u word inductionHypothesis =>
        intro second behavior
        simpa only [List.cons_append, behaviorWordUpdate] using
          inductionHypothesis second (behaviorUpdate update readout u behavior)
  · intro word
    induction word with
    | nil =>
        intro y
        rfl
    | cons u word inductionHypothesis =>
        intro y
        rw [behaviorWordUpdate, behavior_update_projection]
        exact inductionHypothesis (update u y)

example : Set.range
    (controlledBehavior (fun _ : Unit => fun state : Unit => state)
      (fun _ : Unit => ())) :=
  Set.rangeFactorization
    (controlledBehavior (fun _ : Unit => fun state : Unit => state)
      (fun _ : Unit => ())) ()

#print axioms behavior_update_well_defined

end D5.S3.ObserverMemory.RefinementClosure.BehaviorUpdateWordAction
