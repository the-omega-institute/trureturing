namespace D5.S3.ObserverMemory.Dynamics.InfiniteObservabilityOrthogonalDuality

open scoped InnerProductSpace

set_option autoImplicit false
set_option relaxedAutoImplicit false

/-- The intersection of all future readout kernels is exactly the orthogonal
complement of the span generated by every adjoint-observable iterate. -/
theorem infinite_unobservable_eq_observable_orthogonal
    {𝕜 V Y : Type*} [RCLike 𝕜]
    [NormedAddCommGroup V] [InnerProductSpace 𝕜 V]
    [FiniteDimensional 𝕜 V]
    [NormedAddCommGroup Y] [InnerProductSpace 𝕜 Y]
    [FiniteDimensional 𝕜 Y]
    (T : V →ₗ[𝕜] V) (C : V →ₗ[𝕜] Y) :
    (⨅ k : ℕ, LinearMap.ker (C.comp (T ^ k))) =
      (Submodule.span 𝕜
        {v | ∃ k : ℕ, ∃ y : Y,
          v = (T.adjoint ^ k) (C.adjoint y)})ᗮ := by
  have hadjointPower (k : ℕ) : (T ^ k).adjoint = T.adjoint ^ k := by
    change star (T ^ k) = star T ^ k
    exact star_pow T k
  ext x
  rw [Submodule.mem_iInf, Submodule.mem_orthogonal']
  constructor
  · intro hx v hv
    refine Submodule.span_induction
      (p := fun (v : V) _ => inner 𝕜 x v = 0)
      ?_ ?_ ?_ ?_ hv
    · intro v hv
      rcases hv with ⟨k, y, rfl⟩
      have hkernel := hx k
      rw [LinearMap.mem_ker] at hkernel
      have hreadout : C ((T ^ k) x) = 0 := by
        simpa only [LinearMap.comp_apply] using hkernel
      calc
        ⟪x, (T.adjoint ^ k) (C.adjoint y)⟫_𝕜 =
            ⟪(T ^ k) x, C.adjoint y⟫_𝕜 := by
              simpa only [hadjointPower k] using
                (LinearMap.adjoint_inner_right (T ^ k) x (C.adjoint y))
        _ = ⟪C ((T ^ k) x), y⟫_𝕜 :=
          LinearMap.adjoint_inner_right C ((T ^ k) x) y
        _ = 0 := by simp only [hreadout, inner_zero_left]
    · simp
    · intro u v _ _ hu hv
      simp only [inner_add_right, hu, hv, add_zero]
    · intro a v _ hv
      simp only [inner_smul_right, hv, mul_zero]
  · intro hx k
    rw [LinearMap.mem_ker, LinearMap.comp_apply]
    apply ext_inner_right 𝕜
    intro y
    have horthogonal := hx
      ((T.adjoint ^ k) (C.adjoint y))
      (Submodule.subset_span ⟨k, y, rfl⟩)
    calc
      ⟪C ((T ^ k) x), y⟫_𝕜 =
          ⟪(T ^ k) x, C.adjoint y⟫_𝕜 :=
        (LinearMap.adjoint_inner_right C ((T ^ k) x) y).symm
      _ = ⟪x, (T.adjoint ^ k) (C.adjoint y)⟫_𝕜 := by
        simpa only [hadjointPower k] using
          (LinearMap.adjoint_inner_right (T ^ k) x (C.adjoint y)).symm
      _ = 0 := horthogonal
      _ = ⟪(0 : Y), y⟫_𝕜 := by simp

#print axioms infinite_unobservable_eq_observable_orthogonal

end D5.S3.ObserverMemory.Dynamics.InfiniteObservabilityOrthogonalDuality
