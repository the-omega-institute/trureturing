/- GID: D5/S3/ConceptDynamics/Closure/RelationalAutomatonClosure
   generality: G
   mirror-B: none
   mirror-E: none(waiver:initial-interface)
   anchors: []
   digest: Relation records, six-rule audit projection, admissible traces, and least fixed-point closure.
-/

import Mathlib.Order.Closure
import Mathlib.Order.FixedPoints
import D5.S3.ConceptDynamics.Closure.DefinitionClosureOperator
import D5.S0.Diagonal.Lawvere.TheoryIsConsequenceFixedPoint

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.Closure.RelationalAutomatonClosure

universe u v w

/-- A finite relational record stores the active state, relation edges, phase data,
and the finite history used to justify the next transition.

The fields are deliberately structural. Physical semantics, Hilbert coordinates,
and a concrete edge type are supplied by later contracts. -/
structure RelationRecord (State : Type u) (Edge : Type v) (Phase : Type w) where
  state : State
  edges : Set Edge
  phase : Phase
  history : List Edge

/-- The six closure interfaces used by the relational quantum automaton. -/
inductive ClosureRule
  | identity
  | binarySplit
  | orientedTernary
  | successor
  | completeReadout
  | independentComposition
  deriving DecidableEq, Repr

/-- A finite audit reports whether a rule has not yet been reached, is witnessed,
or has a local counterexample. -/
inductive AuditStatus
  | wait
  | pass
  | fail
  deriving DecidableEq, Repr

/-- Rule evidence is intentionally separated from the status displayed by a
visualizer. A PASS status must carry the corresponding finite evidence. -/
structure AuditProjection (Record : Type u) where
  status : ClosureRule → Record → AuditStatus
  evidence : ClosureRule → Record → Prop
  sound : ∀ rule record, status rule record = AuditStatus.pass → evidence rule record

/-- The canonical relation-level closure carrier is Mathlib's closure operator
on families of records. The carrier includes monotonicity, extensivity, and
idempotence; no second closure operation is introduced here. -/
abbrev RelationalClosureOperator (Record : Type u) :=
  ClosureOperator (Set Record)

/-- One recorded automaton transition. The universal validity of a transition is
not assumed here. It is checked through the generated closed family and audit
projection below. -/
structure RelationTransition (Record : Type u) where
  source : Record
  target : Record
  rule : ClosureRule

/-- An automaton packages a seed family, its relation closure, and the finite
audit projection. -/
structure RelationalAutomaton (Record : Type u) where
  seed : Set Record
  closure : RelationalClosureOperator Record
  audit : AuditProjection Record

/-- The least closed family generated by the automaton seed. -/
def generatedRecords {Record : Type u}
    (automaton : RelationalAutomaton Record) : Set Record :=
  automaton.closure automaton.seed

@[simp]
theorem generatedRecords_apply {Record : Type u}
    (automaton : RelationalAutomaton Record) :
    generatedRecords automaton = automaton.closure automaton.seed := rfl

/-- Every seed record is retained by relation closure. -/
theorem seed_subset_generatedRecords {Record : Type u}
    (automaton : RelationalAutomaton Record) :
    automaton.seed ⊆ generatedRecords automaton :=
  automaton.closure.le_closure automaton.seed

/-- The generated family is a fixed point of the relation closure. -/
theorem generatedRecords_is_fixedPoint {Record : Type u}
    (automaton : RelationalAutomaton Record) :
    generatedRecords automaton ∈ Function.fixedPoints automaton.closure :=
  automaton.closure.idempotent automaton.seed

/-- The generated family is the least fixed point above the seed family.

This is the closure interface used by the automaton: new records may be added
only through the closure operator, and every other closed family containing the
seed contains the generated family. -/
theorem generatedRecords_isLeast_fixedPoint_above {Record : Type u}
    (automaton : RelationalAutomaton Record) :
    IsLeast
      {T : Set Record |
        automaton.seed ⊆ T ∧ T ∈ Function.fixedPoints automaton.closure}
      (generatedRecords automaton) := by
  constructor
  · exact ⟨seed_subset_generatedRecords automaton,
      generatedRecords_is_fixedPoint automaton⟩
  · intro T hT
    exact automaton.closure.closure_min hT.1
      (automaton.closure.isClosed_iff.2 hT.2)

/-- The displayed status of a rule at a record. -/
def auditStatus {Record : Type u}
    (automaton : RelationalAutomaton Record)
    (rule : ClosureRule) (record : Record) : AuditStatus :=
  automaton.audit.status rule record

/-- The finite evidence attached to a rule at a record. -/
def auditEvidence {Record : Type u}
    (automaton : RelationalAutomaton Record)
    (rule : ClosureRule) (record : Record) : Prop :=
  automaton.audit.evidence rule record

/-- A PASS status is sound with respect to the audit evidence supplied by the
automaton. This theorem only connects the displayed status to the supplied
evidence; it does not prove the evidence itself. -/
theorem audit_pass_implies_evidence {Record : Type u}
    (automaton : RelationalAutomaton Record)
    (rule : ClosureRule) (record : Record)
    (hpass : auditStatus automaton rule record = AuditStatus.pass) :
    auditEvidence automaton rule record :=
  automaton.audit.sound rule record hpass

/-- A transition is admissible when both records belong to the generated closed
family and the target carries a PASS status for the rule that produced it. -/
def transitionAdmissible {Record : Type u}
    (automaton : RelationalAutomaton Record)
    (transition : RelationTransition Record) : Prop :=
  transition.source ∈ generatedRecords automaton ∧
    transition.target ∈ generatedRecords automaton ∧
    auditStatus automaton transition.rule transition.target = AuditStatus.pass

/-- A finite trace is admissible when every recorded transition is admissible.
This is the interface used by a browser trace or an executable certificate. -/
def traceAdmissible {Record : Type u}
    (automaton : RelationalAutomaton Record)
    (trace : List (RelationTransition Record)) : Prop :=
  ∀ transition, transition ∈ trace → transitionAdmissible automaton transition

/-- A rule order is the earliest finite stage at which the visualizer may audit
the corresponding rule. This order is an interface, not a theorem about the
physical time of a system. -/
def ruleOrder : ClosureRule → Nat
  | ClosureRule.identity => 0
  | ClosureRule.binarySplit => 1
  | ClosureRule.orientedTernary => 2
  | ClosureRule.successor => 3
  | ClosureRule.completeReadout => 0
  | ClosureRule.independentComposition => 3

/-- A rule is reachable at an automaton order when its declared prerequisite
stage has been reached. -/
def ruleReachable (order : Nat) (rule : ClosureRule) : Prop :=
  ruleOrder rule ≤ order

/-- The audit status can be projected onto the generated closed family without
changing the underlying relation closure. -/
def generatedAudit {Record : Type u}
    (automaton : RelationalAutomaton Record) :
    Record → ClosureRule → AuditStatus :=
  fun record rule => auditStatus automaton rule record

#print axioms generatedRecords_isLeast_fixedPoint_above

end D5.S3.ConceptDynamics.Closure.RelationalAutomatonClosure
