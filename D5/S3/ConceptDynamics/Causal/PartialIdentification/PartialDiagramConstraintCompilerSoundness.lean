import D5.S3.ConceptDynamics.Causal.FiniteLinearCausalIdentification
import D5.S3.ConceptDynamics.Causal.PartialIdentification.PartialGraphInformationOrder
import Mathlib.Tactic

/- Library-search audit trail (2026-09-04):
   * `PartialGraphInformationOrder` proves that stronger partial diagrams admit
     fewer compatible complete graphs, but it does not compile compatibility
     into finite rational constraints.
   * `FiniteLinearCausalIdentification` supplies layered finite LP semantics
     and replayable primal-dual endpoint certificates, but it does not construct
     rows from required edges, forbidden edges, or query-order admissibility.
   * Repository searches found no exact support-polytope compiler whose
     feasible points are precisely normalized nonnegative mixtures supported on
     admissible graph completions.
   * The compiler below gives both soundness and completeness. Its semantics is
     a latent-completion mixture. A single unknown global graph instead requires
     the completion-union semantics of `PartialGraphCompletionRange`. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.Causal.PartialIdentification.PartialDiagramConstraintCompilerSoundness

open scoped BigOperators
open D5.S3.ConceptDynamics.Causal.FiniteLinearCausalIdentification
open D5.S3.ConceptDynamics.Causal.PartialIdentification.PartialGraphInformationOrder

/-- Finite candidate completions carry a directed-edge table and an additional
query-order admissibility predicate. The latter is where a query-implied causal
order certificate enters the support compiler. -/
structure CompletionSemantics (Node Completion : Type*) where
  edge : Completion → Node → Node → Bool
  queryOrderCompatible : Completion → Prop

/-- The directed graph relation represented by one finite completion. -/
def completionRelation
    {Node Completion : Type*}
    (semantics : CompletionSemantics Node Completion)
    (completion : Completion) : Node → Node → Prop :=
  fun source target => semantics.edge completion source target = true

/-- A completion is admissible exactly when it satisfies all required and
forbidden edge assertions and the query-implied order side condition. -/
def AdmissibleCompletion
    {Node Completion : Type*}
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (completion : Completion) : Prop :=
  Compatible diagram (completionRelation semantics completion) ∧
    semantics.queryOrderCompatible completion

/-- A required-edge row is active when the nominated completion omits an edge
that the partial diagram requires. -/
def RequiredViolation
    {Node Completion : Type*}
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (completion : Completion)
    (source target : Node) : Prop :=
  diagram.requiredEdge source target ∧
    semantics.edge completion source target = false

/-- A forbidden-edge row is active when the nominated completion contains an
edge that the partial diagram forbids. -/
def ForbiddenViolation
    {Node Completion : Type*}
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (completion : Completion)
    (source target : Node) : Prop :=
  diagram.forbiddenEdge source target ∧
    semantics.edge completion source target = true

/-- Finite rows generated by the support compiler. Two rows encode equality of
total mass to one, and each inadmissibility witness receives a coordinate row
that forces the offending completion mass to zero. -/
inductive DiagramConstraint (Node Completion : Type*)
  | nonnegative (completion : Completion)
  | totalUpper
  | totalLower
  | requiredViolation
      (completion : Completion) (source target : Node)
  | forbiddenViolation
      (completion : Completion) (source target : Node)
  | queryOrderViolation (completion : Completion)
deriving DecidableEq, Fintype

/-- Rational coefficient matrix of the partial-diagram support compiler. -/
noncomputable def diagramRow
    {Node Completion : Type*} [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion) :
    DiagramConstraint Node Completion → Completion → ℚ := by
  classical
  intro constraint candidate
  cases constraint with
  | nonnegative protected =>
      exact if candidate = protected then -1 else 0
  | totalUpper =>
      exact 1
  | totalLower =>
      exact -1
  | requiredViolation protected source target =>
      exact if RequiredViolation diagram semantics protected source target then
        if candidate = protected then 1 else 0
      else 0
  | forbiddenViolation protected source target =>
      exact if ForbiddenViolation diagram semantics protected source target then
        if candidate = protected then 1 else 0
      else 0
  | queryOrderViolation protected =>
      exact if ¬semantics.queryOrderCompatible protected then
        if candidate = protected then 1 else 0
      else 0

/-- Right-hand side of every generated support constraint. -/
def diagramRhs
    {Node Completion : Type*} :
    DiagramConstraint Node Completion → ℚ
  | .nonnegative _ => 0
  | .totalUpper => 1
  | .totalLower => -1
  | .requiredViolation _ _ _ => 0
  | .forbiddenViolation _ _ _ => 0
  | .queryOrderViolation _ => 0

@[simp] theorem nonnegativeRow_eval
    {Node Completion : Type*}
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ)
    (protected : Completion) :
    (∑ candidate,
      diagramRow diagram semantics (.nonnegative protected) candidate *
        mass candidate) = -mass protected := by
  classical
  simp [diagramRow]

@[simp] theorem totalUpperRow_eval
    {Node Completion : Type*}
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ) :
    (∑ candidate,
      diagramRow diagram semantics
        (DiagramConstraint.totalUpper : DiagramConstraint Node Completion)
        candidate * mass candidate) =
      ∑ candidate, mass candidate := by
  classical
  apply Finset.sum_congr rfl
  intro candidate _
  simp [diagramRow]

@[simp] theorem totalLowerRow_eval
    {Node Completion : Type*}
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ) :
    (∑ candidate,
      diagramRow diagram semantics
        (DiagramConstraint.totalLower : DiagramConstraint Node Completion)
        candidate * mass candidate) =
      -(∑ candidate, mass candidate) := by
  classical
  calc
    (∑ candidate,
      diagramRow diagram semantics
        (DiagramConstraint.totalLower : DiagramConstraint Node Completion)
        candidate * mass candidate) =
        ∑ candidate, -mass candidate := by
      apply Finset.sum_congr rfl
      intro candidate _
      simp [diagramRow]
    _ = -(∑ candidate, mass candidate) := by
      rw [Finset.sum_neg_distrib]

@[simp] theorem requiredViolationRow_eval
    {Node Completion : Type*}
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ)
    (protected : Completion) (source target : Node) :
    (∑ candidate,
      diagramRow diagram semantics
        (.requiredViolation protected source target) candidate *
        mass candidate) =
      if RequiredViolation diagram semantics protected source target then
        mass protected
      else 0 := by
  classical
  by_cases violation :
      RequiredViolation diagram semantics protected source target
  · simp [diagramRow, violation]
  · simp [diagramRow, violation]

@[simp] theorem forbiddenViolationRow_eval
    {Node Completion : Type*}
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ)
    (protected : Completion) (source target : Node) :
    (∑ candidate,
      diagramRow diagram semantics
        (.forbiddenViolation protected source target) candidate *
        mass candidate) =
      if ForbiddenViolation diagram semantics protected source target then
        mass protected
      else 0 := by
  classical
  by_cases violation :
      ForbiddenViolation diagram semantics protected source target
  · simp [diagramRow, violation]
  · simp [diagramRow, violation]

@[simp] theorem queryOrderViolationRow_eval
    {Node Completion : Type*}
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ)
    (protected : Completion) :
    (∑ candidate,
      diagramRow diagram semantics
        (.queryOrderViolation protected) candidate * mass candidate) =
      if ¬semantics.queryOrderCompatible protected then mass protected
      else 0 := by
  classical
  by_cases violation : ¬semantics.queryOrderCompatible protected
  · simp [diagramRow, violation]
  · simp [diagramRow, violation]

/-- The generated finite causal LP. Every row is structural because the rows
encode probability-law and admissible-completion semantics. -/
noncomputable def diagramSupportProblem
    {Node Completion : Type*}
    [Fintype Node] [DecidableEq Node]
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (queryCoefficient : Completion → ℚ) :
    FiniteLinearCausalProblem
      Completion (DiagramConstraint Node Completion) where
  layer := fun _ => .structural
  row := diagramRow diagram semantics
  rhs := diagramRhs
  queryCoefficient := queryCoefficient

/-- Semantic form of a feasible support vector. -/
structure CompatibleCompletionMixture
    {Node Completion : Type*} [Fintype Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ) : Prop where
  nonnegative : ∀ completion, 0 ≤ mass completion
  total : (∑ completion, mass completion) = 1
  supportAdmissible : ∀ completion,
    mass completion ≠ 0 →
      AdmissibleCompletion diagram semantics completion

/-- Any nonadmissible completion has zero mass in a compatible mixture. -/
theorem mass_eq_zero_of_not_admissible
    {Node Completion : Type*} [Fintype Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (mass : Completion → ℚ)
    (mixture : CompatibleCompletionMixture diagram semantics mass)
    (completion : Completion)
    (not_admissible :
      ¬AdmissibleCompletion diagram semantics completion) :
    mass completion = 0 := by
  by_contra nonzero
  exact not_admissible (mixture.supportAdmissible completion nonzero)

/-- Exact compiler theorem. The generated rational LP is feasible exactly for
normalized nonnegative mass vectors whose support consists entirely of graph
completions satisfying the partial diagram and query-order condition. -/
theorem feasible_iff_compatible_completion_mixture
    {Node Completion : Type*}
    [Fintype Node] [DecidableEq Node]
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (queryCoefficient : Completion → ℚ)
    (mass : Completion → ℚ) :
    Feasible (diagramSupportProblem diagram semantics queryCoefficient) mass ↔
      CompatibleCompletionMixture diagram semantics mass := by
  classical
  constructor
  · intro feasible
    have nonnegative : ∀ completion, 0 ≤ mass completion := by
      intro completion
      have row_bound :=
        feasible (DiagramConstraint.nonnegative completion)
      have neg_bound : -mass completion ≤ 0 := by
        simpa [Feasible, diagramSupportProblem, diagramRhs] using row_bound
      linarith
    refine
      { nonnegative := nonnegative
        total := ?_
        supportAdmissible := ?_ }
    · have upper_bound :=
        feasible
          (DiagramConstraint.totalUpper :
            DiagramConstraint Node Completion)
      have lower_bound :=
        feasible
          (DiagramConstraint.totalLower :
            DiagramConstraint Node Completion)
      have upper : (∑ completion, mass completion) ≤ 1 := by
        simpa [Feasible, diagramSupportProblem, diagramRhs] using upper_bound
      have lower : -(∑ completion, mass completion) ≤ -1 := by
        simpa [Feasible, diagramSupportProblem, diagramRhs] using lower_bound
      linarith
    · intro completion nonzero
      constructor
      · constructor
        · intro source target required
          cases edge_value : semantics.edge completion source target with
          | false =>
              have violation :
                  RequiredViolation diagram semantics
                    completion source target :=
                ⟨required, edge_value⟩
              have row_bound :=
                feasible
                  (DiagramConstraint.requiredViolation
                    completion source target)
              have mass_nonpositive : mass completion ≤ 0 := by
                simpa [Feasible, diagramSupportProblem, diagramRhs, violation]
                  using row_bound
              have mass_zero : mass completion = 0 :=
                le_antisymm mass_nonpositive (nonnegative completion)
              exact (nonzero mass_zero).elim
          | true =>
              exact edge_value
        · intro source target forbidden edge_present
          have violation :
              ForbiddenViolation diagram semantics
                completion source target :=
            ⟨forbidden, edge_present⟩
          have row_bound :=
            feasible
              (DiagramConstraint.forbiddenViolation
                completion source target)
          have mass_nonpositive : mass completion ≤ 0 := by
            simpa [Feasible, diagramSupportProblem, diagramRhs, violation]
              using row_bound
          have mass_zero : mass completion = 0 :=
            le_antisymm mass_nonpositive (nonnegative completion)
          exact nonzero mass_zero
      · by_contra order_failure
        have row_bound :=
          feasible (DiagramConstraint.queryOrderViolation completion)
        have mass_nonpositive : mass completion ≤ 0 := by
          simpa [Feasible, diagramSupportProblem, diagramRhs, order_failure]
            using row_bound
        have mass_zero : mass completion = 0 :=
          le_antisymm mass_nonpositive (nonnegative completion)
        exact nonzero mass_zero
  · intro mixture
    unfold Feasible
    intro constraint
    cases constraint with
    | nonnegative completion =>
        have nonnegative := mixture.nonnegative completion
        simpa [diagramSupportProblem, diagramRhs] using
          (neg_nonpos.mpr nonnegative)
    | totalUpper =>
        simp [diagramSupportProblem, diagramRhs, mixture.total]
    | totalLower =>
        simp [diagramSupportProblem, diagramRhs, mixture.total]
    | requiredViolation completion source target =>
        by_cases violation :
            RequiredViolation diagram semantics completion source target
        · have not_admissible :
              ¬AdmissibleCompletion diagram semantics completion := by
            intro admissible
            have edge_present :=
              admissible.1.1 source target violation.1
            rw [violation.2] at edge_present
            cases edge_present
          have mass_zero := mass_eq_zero_of_not_admissible
            diagram semantics mass mixture completion not_admissible
          simp [diagramSupportProblem, diagramRhs, violation, mass_zero]
        · simp [diagramSupportProblem, diagramRhs, violation]
    | forbiddenViolation completion source target =>
        by_cases violation :
            ForbiddenViolation diagram semantics completion source target
        · have not_admissible :
              ¬AdmissibleCompletion diagram semantics completion := by
            intro admissible
            exact admissible.1.2 source target violation.1 violation.2
          have mass_zero := mass_eq_zero_of_not_admissible
            diagram semantics mass mixture completion not_admissible
          simp [diagramSupportProblem, diagramRhs, violation, mass_zero]
        · simp [diagramSupportProblem, diagramRhs, violation]
    | queryOrderViolation completion =>
        by_cases violation : ¬semantics.queryOrderCompatible completion
        · have not_admissible :
              ¬AdmissibleCompletion diagram semantics completion := by
            intro admissible
            exact violation admissible.2
          have mass_zero := mass_eq_zero_of_not_admissible
            diagram semantics mass mixture completion not_admissible
          simp [diagramSupportProblem, diagramRhs, violation, mass_zero]
        · simp [diagramSupportProblem, diagramRhs, violation]

/-- Unit mass concentrated on one finite completion. -/
def pointMass
    {Completion : Type*} [DecidableEq Completion]
    (chosen : Completion) : Completion → ℚ :=
  fun completion => if completion = chosen then 1 else 0

/-- A point mass is feasible exactly when its chosen completion satisfies every
partial-diagram and query-order condition. -/
theorem pointMass_feasible_iff_admissible
    {Node Completion : Type*}
    [Fintype Node] [DecidableEq Node]
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (queryCoefficient : Completion → ℚ)
    (chosen : Completion) :
    Feasible (diagramSupportProblem diagram semantics queryCoefficient)
        (pointMass chosen) ↔
      AdmissibleCompletion diagram semantics chosen := by
  classical
  constructor
  · intro feasible
    have mixture :=
      (feasible_iff_compatible_completion_mixture
        diagram semantics queryCoefficient (pointMass chosen)).mp feasible
    exact mixture.supportAdmissible chosen (by simp [pointMass])
  · intro admissible
    apply (feasible_iff_compatible_completion_mixture
      diagram semantics queryCoefficient (pointMass chosen)).mpr
    refine
      { nonnegative := ?_
        total := ?_
        supportAdmissible := ?_ }
    · intro completion
      by_cases same : completion = chosen <;>
        simp [pointMass, same]
    · simp [pointMass]
    · intro completion nonzero
      by_cases same : completion = chosen
      · subst completion
        exact admissible
      · simp [pointMass, same] at nonzero

/-- The compiled support polytope is inhabited exactly when at least one finite
candidate completion is admissible. -/
theorem compiled_problem_nonempty_iff_exists_admissible
    {Node Completion : Type*}
    [Fintype Node] [DecidableEq Node]
    [Fintype Completion] [DecidableEq Completion]
    (diagram : PartialCausalDiagram Node)
    (semantics : CompletionSemantics Node Completion)
    (queryCoefficient : Completion → ℚ) :
    (∃ mass : Completion → ℚ,
        Feasible (diagramSupportProblem diagram semantics queryCoefficient)
          mass) ↔
      ∃ completion,
        AdmissibleCompletion diagram semantics completion := by
  classical
  constructor
  · rintro ⟨mass, feasible⟩
    have mixture :=
      (feasible_iff_compatible_completion_mixture
        diagram semantics queryCoefficient mass).mp feasible
    have exists_nonzero : ∃ completion, mass completion ≠ 0 := by
      by_contra no_nonzero
      have all_zero : ∀ completion, mass completion = 0 := by
        intro completion
        by_contra nonzero
        exact no_nonzero ⟨completion, nonzero⟩
      have total_zero : (∑ completion, mass completion) = 0 := by
        simp [all_zero]
      linarith [mixture.total]
    obtain ⟨completion, nonzero⟩ := exists_nonzero
    exact ⟨completion, mixture.supportAdmissible completion nonzero⟩
  · rintro ⟨completion, admissible⟩
    exact ⟨pointMass completion,
      (pointMass_feasible_iff_admissible
        diagram semantics queryCoefficient completion).mpr admissible⟩

/-- Stronger partial diagrams produce a subset of the feasible support
polytope, provided the completion edge tables and query-order condition are held
fixed. -/
theorem feasible_antitone_under_refinement
    {Node Completion : Type*}
    [Fintype Node] [DecidableEq Node]
    [Fintype Completion] [DecidableEq Completion]
    (stronger weaker : PartialCausalDiagram Node)
    (refinement : Refines stronger weaker)
    (semantics : CompletionSemantics Node Completion)
    (queryCoefficient : Completion → ℚ)
    (mass : Completion → ℚ)
    (feasible_stronger :
      Feasible (diagramSupportProblem stronger semantics queryCoefficient)
        mass) :
    Feasible (diagramSupportProblem weaker semantics queryCoefficient) mass := by
  apply (feasible_iff_compatible_completion_mixture
    weaker semantics queryCoefficient mass).mpr
  have stronger_mixture :=
    (feasible_iff_compatible_completion_mixture
      stronger semantics queryCoefficient mass).mp feasible_stronger
  refine
    { nonnegative := stronger_mixture.nonnegative
      total := stronger_mixture.total
      supportAdmissible := ?_ }
  intro completion nonzero
  have admissible :=
    stronger_mixture.supportAdmissible completion nonzero
  exact
    ⟨compatible_antitone stronger weaker refinement
        (completionRelation semantics completion) admissible.1,
      admissible.2⟩

/-- A rational lower certificate proved for a weaker partial diagram remains a
valid lower bound after adding graph information. -/
theorem lower_bound_survives_refinement
    {Node Completion : Type*}
    [Fintype Node] [DecidableEq Node]
    [Fintype Completion] [DecidableEq Completion]
    (stronger weaker : PartialCausalDiagram Node)
    (refinement : Refines stronger weaker)
    (semantics : CompletionSemantics Node Completion)
    (queryCoefficient : Completion → ℚ)
    (lower : ℚ)
    (certificate :
      LowerCertificate
        (diagramSupportProblem weaker semantics queryCoefficient) lower)
    (mass : Completion → ℚ)
    (feasible_stronger :
      Feasible (diagramSupportProblem stronger semantics queryCoefficient)
        mass) :
    lower ≤ Query
      (diagramSupportProblem stronger semantics queryCoefficient) mass := by
  have feasible_weaker := feasible_antitone_under_refinement
    stronger weaker refinement semantics queryCoefficient mass feasible_stronger
  have bound := query_lower_bound_of_certificate
    (diagramSupportProblem weaker semantics queryCoefficient)
    lower certificate mass feasible_weaker
  simpa [Query, diagramSupportProblem] using bound

/-- A rational upper certificate proved for a weaker partial diagram remains a
valid upper bound after adding graph information. -/
theorem upper_bound_survives_refinement
    {Node Completion : Type*}
    [Fintype Node] [DecidableEq Node]
    [Fintype Completion] [DecidableEq Completion]
    (stronger weaker : PartialCausalDiagram Node)
    (refinement : Refines stronger weaker)
    (semantics : CompletionSemantics Node Completion)
    (queryCoefficient : Completion → ℚ)
    (upper : ℚ)
    (certificate :
      UpperCertificate
        (diagramSupportProblem weaker semantics queryCoefficient) upper)
    (mass : Completion → ℚ)
    (feasible_stronger :
      Feasible (diagramSupportProblem stronger semantics queryCoefficient)
        mass) :
    Query (diagramSupportProblem stronger semantics queryCoefficient) mass ≤
      upper := by
  have feasible_weaker := feasible_antitone_under_refinement
    stronger weaker refinement semantics queryCoefficient mass feasible_stronger
  have bound := query_upper_bound_of_certificate
    (diagramSupportProblem weaker semantics queryCoefficient)
    upper certificate mass feasible_weaker
  simpa [Query, diagramSupportProblem] using bound

