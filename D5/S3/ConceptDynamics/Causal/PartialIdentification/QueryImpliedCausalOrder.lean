/- GID: D5/S3/ConceptDynamics/Causal/PartialIdentification/QueryImpliedCausalOrder
   generality: G
   mirror-B: D5/B/S3/ConceptDynamics/Causal/PartialIdentification/QueryImpliedCausalOrder
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Counterfactual intervention atoms generate strict causal-order obligations and reject reciprocal cycles. -/

import D5.S3.ConceptDynamics.Causal.StructuralEvaluationSemantics
import Mathlib.Data.Finset.Basic
import Mathlib.Data.List.Basic

/- Library-search audit trail (2026-09-03):
   * `StructuralEvaluationSemantics` already defines the list-level `Before`
     relation used by finite parent-ordered structural models.
   * Repository searches found no syntax-to-order layer for counterfactual
     queries and no theorem rejecting reciprocal intervention requirements.
   * This module formalizes the compiler obligation only. It does not assume
     that an arbitrary query is well ordered or that any chosen total extension
     yields a complete sharp LP without a separate soundness proof. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.Causal.PartialIdentification.QueryImpliedCausalOrder

/-- One counterfactual event names an outcome coordinate and the coordinates
whose structural mechanisms are replaced by intervention. -/
structure CounterfactualAtom (Node : Type*) where
  outcome : Node
  intervention : Finset Node

/-- A finite conjunction of counterfactual event atoms. -/
abbrev CounterfactualQuery (Node : Type*) := List (CounterfactualAtom Node)

/-- A nontrivial intervention coordinate in an atom must precede that atom's
outcome coordinate in a recursive causal interpretation. -/
def AtomRequiresBefore
    {Node : Type*} [DecidableEq Node]
    (atom : CounterfactualAtom Node)
    (source target : Node) : Prop :=
  source ∈ atom.intervention /\
    source != atom.outcome /\
    target = atom.outcome

/-- Query-level precedence is the union of the obligations generated by all
counterfactual atoms. -/
def QueryRequiresBefore
    {Node : Type*} [DecidableEq Node]
    (query : CounterfactualQuery Node)
    (source target : Node) : Prop :=
  exists atom,
    atom ∈ query /\ AtomRequiresBefore atom source target

/-- A strict causal order exposes exactly the properties needed by the query
compiler: asymmetry rules out reciprocal ancestry and transitivity composes
multi-step precedence. -/
structure StrictCausalOrder (Node : Type*) where
  before : Node -> Node -> Prop
  asymmetric : forall {left right},
    before left right -> not (before right left)
  transitive : forall {left middle right},
    before left middle -> before middle right -> before left right

/-- An order certificate respects every precedence obligation extracted from a
counterfactual query. -/
def RespectsQuery
    {Node : Type*} [DecidableEq Node]
    (order : StrictCausalOrder Node)
    (query : CounterfactualQuery Node) : Prop :=
  forall {source target},
    QueryRequiresBefore query source target -> order.before source target

/-- Every nontrivial intervention named in a certified query precedes the
corresponding counterfactual outcome. -/
theorem intervention_precedes_outcome
    {Node : Type*} [DecidableEq Node]
    (order : StrictCausalOrder Node)
    (query : CounterfactualQuery Node)
    (respects : RespectsQuery order query)
    (atom : CounterfactualAtom Node)
    (atom_in_query : atom ∈ query)
    (source : Node)
    (source_intervened : source ∈ atom.intervention)
    (source_ne_outcome : source != atom.outcome) :
    order.before source atom.outcome := by
  apply respects
  exact ⟨atom, atom_in_query,
    source_intervened, source_ne_outcome, rfl⟩

/-- Reciprocal query-implied precedence constraints cannot be embedded into a
strict recursive causal order. This is the abstract obstruction behind cyclic
counterfactual patterns such as one atom requiring X before Y and another
requiring Y before X. -/
theorem reciprocal_query_requirements_inconsistent
    {Node : Type*} [DecidableEq Node]
    (order : StrictCausalOrder Node)
    (query : CounterfactualQuery Node)
    (respects : RespectsQuery order query)
    (left right : Node)
    (left_before_right : QueryRequiresBefore query left right)
    (right_before_left : QueryRequiresBefore query right left) :
    False := by
  exact (order.asymmetric
    (respects left_before_right)) (respects right_before_left)

/-- Adapter to the canonical list-order semantics already used by finite
structural models in this causal lane. -/
def ListOrderRespectsQuery
    {n : Nat}
    (order : List (Fin n))
    (query : CounterfactualQuery (Fin n)) : Prop :=
  forall {source target},
    QueryRequiresBefore query source target ->
      D5.S3.ConceptDynamics.Causal.StructuralEvaluationSemantics.Before
        order source target

/-- A list-order certificate discharges every query-implied structural-before
obligation in the existing finite SCM semantics. -/
theorem query_requirement_has_structural_before
    {n : Nat}
    (order : List (Fin n))
    (query : CounterfactualQuery (Fin n))
    (respects : ListOrderRespectsQuery order query)
    (source target : Fin n)
    (required : QueryRequiresBefore query source target) :
    D5.S3.ConceptDynamics.Causal.StructuralEvaluationSemantics.Before
      order source target := by
  exact respects required

#print axioms intervention_precedes_outcome
#print axioms reciprocal_query_requirements_inconsistent
#print axioms query_requirement_has_structural_before

end D5.S3.ConceptDynamics.Causal.PartialIdentification.QueryImpliedCausalOrder
