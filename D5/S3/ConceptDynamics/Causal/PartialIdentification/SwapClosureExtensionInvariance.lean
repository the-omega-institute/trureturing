   anchors: []
   digest: A finite chain of adjacent parent-independent swaps preserves structural evaluation, response profiles, and every query readout. -/

import D5.S3.ConceptDynamics.Causal.PartialIdentification.AdjacentIncomparableSwapInvariance

/- Library-search audit trail (2026-09-03):
   * `AdjacentIncomparableSwapInvariance` proves preservation for one local
     swap, the elementary generator relating compatible total orders.
   * Repository searches found no transitive closure carrying this local
     equality to a complete order-to-order response-profile theorem.
   * This module deliberately separates analytic/compiler invariance from the
     remaining combinatorial connectivity obligation: proving that two chosen
     linear extensions are connected by such swaps. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.Causal.PartialIdentification.SwapClosureExtensionInvariance

open D5.S3.ConceptDynamics.Causal.PartialIdentification.AdjacentIncomparableSwapInvariance

/-- One admissible local move exchanges two neighboring distinct nodes whose
local equations do not read one another. -/
def AdjacentParentIndependentSwap
    {Node X : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X)
    (before after : List Node) : Prop :=
  exists prefix left right suffix,
    left ≠ right /\
      right ∉ system.parents left /\
      left ∉ system.parents right /\
      before = prefix ++ left :: right :: suffix /\
      after = prefix ++ right :: left :: suffix

/-- The finite reflexive-transitive closure generated by admissible adjacent
swaps. Keeping the chain as proof data makes every global invariance theorem
replay the exact local moves. -/
inductive SwapChain
    {Node X : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X) :
    List Node -> List Node -> Prop
  | refl (order : List Node) : SwapChain system order order
  | step {first second final : List Node} :
      AdjacentParentIndependentSwap system first second ->
      SwapChain system second final ->
      SwapChain system first final

/-- One admissible adjacent swap preserves the final parent-local structural
state for every initialization. -/
theorem evaluation_invariant_of_one_swap
    {Node X : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X)
    {before after : List Node}
    (swap : AdjacentParentIndependentSwap system before after)
    (state : Node -> X) :
    evaluateOrder (localEvaluateNode system) before state =
      evaluateOrder (localEvaluateNode system) after state := by
  rcases swap with
    ⟨prefix, left, right, suffix,
      left_ne_right,
      right_not_parent_of_left,
      left_not_parent_of_right,
      rfl, rfl⟩
  exact parent_local_evaluation_invariant_under_adjacent_swap
    system left right left_ne_right
    right_not_parent_of_left left_not_parent_of_right
    prefix suffix state

/-- Every finite chain of admissible adjacent swaps preserves structural
evaluation. This is the global semantic theorem once swap connectivity has
been supplied for the two total orders under comparison. -/
theorem evaluation_invariant_of_swap_chain
    {Node X : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X)
    {before after : List Node}
    (chain : SwapChain system before after)
    (state : Node -> X) :
    evaluateOrder (localEvaluateNode system) before state =
      evaluateOrder (localEvaluateNode system) after state := by
  induction chain with
  | refl order => rfl
  | @step first second final oneSwap tailChain inductionHypothesis =>
      exact (evaluation_invariant_of_one_swap
        system oneSwap state).trans inductionHypothesis

/-- Structural response profiles indexed by an exogenous state. -/
def responseProfile
    {Node X U : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X)
    (initial : U -> Node -> X)
    (order : List Node)
    (u : U) : Node -> X :=
  evaluateOrder (localEvaluateNode system) order (initial u)

/-- Swap-connected total orders induce exactly the same structural response
for every exogenous state. -/
theorem responseProfile_invariant_of_swap_chain
    {Node X U : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X)
    (initial : U -> Node -> X)
    {before after : List Node}
    (chain : SwapChain system before after) :
    responseProfile system initial before =
      responseProfile system initial after := by
  funext u
  exact evaluation_invariant_of_swap_chain
    system chain (initial u)

/-- Every query readout of a swap-connected structural response profile is
identical pointwise in the exogenous state. -/
theorem query_readout_invariant_of_swap_chain
    {Node X U QueryValue : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X)
    (initial : U -> Node -> X)
    (readout : (Node -> X) -> QueryValue)
    {before after : List Node}
    (chain : SwapChain system before after)
    (u : U) :
    readout (responseProfile system initial before u) =
      readout (responseProfile system initial after u) := by
  exact congrArg readout
    (evaluation_invariant_of_swap_chain
      system chain (initial u))

/-- The remaining global causal-order theorem is isolated as a pure
connectivity obligation. Any procedure proving that all compatible extensions
lie in one `SwapChain` component immediately yields response and query
invariance by the preceding theorems. -/
theorem extension_invariance_from_swap_connectivity
    {Node X U QueryValue : Type*} [DecidableEq Node]
    (system : ParentLocalSystem Node X)
    (initial : U -> Node -> X)
    (readout : (Node -> X) -> QueryValue)
    (compatible : List Node -> Prop)
    (connected : forall first second,
      compatible first -> compatible second ->
        SwapChain system first second)
    (first second : List Node)
    (first_compatible : compatible first)
    (second_compatible : compatible second) :
    (fun u => readout (responseProfile system initial first u)) =
      fun u => readout (responseProfile system initial second u) := by
  funext u
  exact query_readout_invariant_of_swap_chain
    system initial readout
    (connected first second first_compatible second_compatible) u

#print axioms evaluation_invariant_of_one_swap
#print axioms evaluation_invariant_of_swap_chain
#print axioms responseProfile_invariant_of_swap_chain
#print axioms extension_invariance_from_swap_connectivity

end D5.S3.ConceptDynamics.Causal.PartialIdentification.SwapClosureExtensionInvariance
