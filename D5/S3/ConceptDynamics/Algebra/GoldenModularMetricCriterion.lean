/-- For the complex two-mode flow generated by the golden modular matrix,
zero horizontal drift, unit-modulus spectrum, preservation of a positive
Hermitian metric, and vanishing normalized trace defect are equivalent.
At nonzero drift the completed reading still has its canonical reflected
zero, but no positive invariant metric can be preserved. -/
theorem golden_modular_metric_criterion (delta gamma : Real) :
    let period : Real := 2 * Real.log Real.goldenRatio
    let exponent : Complex :=
      ((delta : Complex) + Complex.I * (gamma : Complex)) * (period : Complex)
    let forward : Complex := Complex.exp exponent
    let backward : Complex := Complex.exp (-exponent)
    let monodromy : Matrix (Fin 2) (Fin 2) Complex := diagonal ![forward, backward]
    let rho : Complex := (1 / 2 : Complex) + delta + Complex.I * gamma
    let unitaryDefect : Real :=
      (1 / 2) * (Matrix.trace (monodromyᴴ * monodromy)).re - 1
    List.TFAE [
        delta = 0,
        ∀ lambda ∈ spectrum Complex monodromy, ‖lambda‖ = 1,
        ∃ H : Matrix (Fin 2) (Fin 2) Complex,
          H.PosDef ∧ monodromyᴴ * H * monodromy = H,
        unitaryDefect = 0] ∧
      (delta ≠ 0 →
        (xiReading rho = 0 → xiReading (criticalLineMirror rho) = 0) ∧
        ¬∃ H : Matrix (Fin 2) (Fin 2) Complex,
          H.PosDef ∧ monodromyᴴ * H * monodromy = H) := by
  dsimp only
  let period : Real := 2 * Real.log Real.goldenRatio
  let exponent : Complex :=
    ((delta : Complex) + Complex.I * (gamma : Complex)) * (period : Complex)
  let forward : Complex := Complex.exp exponent
  let backward : Complex := Complex.exp (-exponent)
  let monodromy : Matrix (Fin 2) (Fin 2) Complex := diagonal ![forward, backward]
  let rho : Complex := (1 / 2 : Complex) + delta + Complex.I * gamma
  let unitaryDefect : Real :=
    (1 / 2) * (Matrix.trace (monodromyᴴ * monodromy)).re - 1
  change
    List.TFAE [
        delta = 0,
        ∀ lambda ∈ spectrum Complex monodromy, ‖lambda‖ = 1,
        ∃ H : Matrix (Fin 2) (Fin 2) Complex,
          H.PosDef ∧ monodromyᴴ * H * monodromy = H,
        unitaryDefect = 0] ∧
      (delta ≠ 0 →
        (xiReading rho = 0 → xiReading (criticalLineMirror rho) = 0) ∧
        ¬∃ H : Matrix (Fin 2) (Fin 2) Complex,
          H.PosDef ∧ monodromyᴴ * H * monodromy = H)
  have hperiod : 0 < period := by
    dsimp [period]
    exact mul_pos (by norm_num) (Real.log_pos Real.one_lt_goldenRatio)
  have hthree : List.TFAE [
      delta = 0,
      ∀ lambda ∈ spectrum Complex monodromy, ‖lambda‖ = 1,
      ∃ H : Matrix (Fin 2) (Fin 2) Complex,
        H.PosDef ∧ monodromyᴴ * H * monodromy = H] := by
    simpa [exponent, forward, backward, monodromy] using
      positive_invariant_metric_selection delta gamma period hperiod
  have hforwardNorm : ‖forward‖ = Real.exp (delta * period) := by
    dsimp [forward]
    rw [Complex.norm_exp]
    simp [exponent]
  have hbackwardNorm : ‖backward‖ = Real.exp (-(delta * period)) := by
    dsimp [backward]
    rw [Complex.norm_exp]
    simp [exponent]
  have htrace :
      (Matrix.trace (monodromyᴴ * monodromy)).re =
        ‖forward‖ ^ 2 + ‖backward‖ ^ 2 := by
    simp [monodromy, Fin.sum_univ_two, Complex.sq_norm, Complex.normSq_apply]
  have hdefect :
      unitaryDefect =
        (1 / 2) *
          (Real.exp (delta * period) ^ 2 +
            Real.exp (-(delta * period)) ^ 2) - 1 := by
    dsimp [unitaryDefect]
    rw [htrace, hforwardNorm, hbackwardNorm]
  constructor
  · tfae_have 1 → 2 := (hthree.out 0 1).mp
    tfae_have 2 → 1 := (hthree.out 1 0).mp
    tfae_have 1 → 3 := (hthree.out 0 2).mp
    tfae_have 3 → 1 := (hthree.out 2 0).mp
    tfae_have 1 → 4 := by
      intro hdelta
      rw [hdefect, hdelta]
      norm_num
    tfae_have 4 → 1 := by
      intro hzero
      rw [hdefect] at hzero
      let x := Real.exp (delta * period)
      let y := Real.exp (-(delta * period))
      have hx : 0 < x := Real.exp_pos _
      have hy : 0 < y := Real.exp_pos _
      have hxy : x * y = 1 := by
        dsimp [x, y]
        rw [← Real.exp_add]
        ring_nf
        exact Real.exp_zero
      have hsum : x ^ 2 + y ^ 2 = 2 := by
        dsimp [x, y]
        nlinarith
      have hxeqy : x = y := by
        nlinarith [sq_nonneg (x - y)]
      have hxone : x = 1 := by
        nlinarith
      have hproduct : delta * period = 0 := by
        exact (Real.exp_eq_one_iff _).mp (by simpa [x] using hxone)
      exact (mul_eq_zero.mp hproduct).resolve_right (ne_of_gt hperiod)
    tfae_finish
  · intro hdelta
    constructor
    · intro hzero
      simpa [criticalLineMirror, hzero] using xi_reading_one_sub_conj rho
    · intro hmetric
      apply hdelta
      exact (hthree.out 2 0).mp hmetric

#print axioms golden_modular_metric_criterion

end D5.S3.ConceptDynamics.Algebra.GoldenModularMetricCriterion
