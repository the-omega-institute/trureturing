namespace D5.S3.ConceptDynamics.Topology.ProofTopologyCore

open Set TopologicalSpace Filter

universe u v w

/-- A nonempty directed path generated by a direct edge relation. -/
inductive StrictPath {V : Type u} (edge : V -> V -> Prop) : V -> V -> Prop
  | single {source target : V} : edge source target -> StrictPath edge source target
  | tail {source middle target : V} :
      StrictPath edge source middle -> edge middle target -> StrictPath edge source target

namespace StrictPath

/-- Concatenation preserves nonempty directed paths. -/
theorem trans {V : Type u} {edge : V -> V -> Prop} {first middle last : V} :
    StrictPath edge first middle -> StrictPath edge middle last ->
      StrictPath edge first last
  | left, .single right => .tail left right
  | left, .tail prefix finalEdge => .tail (trans left prefix) finalEdge

/-- An edge-preserving map sends every directed path to a directed path. -/
theorem map {V : Type u} {W : Type v}
    {edgeV : V -> V -> Prop} {edgeW : W -> W -> Prop}
    (f : V -> W)
    (preserves : forall {source target}, edgeV source target ->
      edgeW (f source) (f target))
    {source target : V} (path : StrictPath edgeV source target) :
    StrictPath edgeW (f source) (f target) := by
  induction path with
  | single direct => exact .single (preserves direct)
  | tail prefix direct ih => exact .tail ih (preserves direct)

/-- A set-valued label monotone on direct edges is monotone on every path. -/
theorem labels_mono {V : Type u} {Label : Type v}
    {edge : V -> V -> Prop} (labels : V -> Set Label)
    (local : forall {source target}, edge source target ->
      labels source ⊆ labels target)
    {source target : V} (path : StrictPath edge source target) :
    labels source ⊆ labels target := by
  induction path with
  | single direct => exact local direct
  | tail prefix direct ih => exact ih.trans (local direct)

/-- A strictly increasing natural depth on edges increases along every path. -/
theorem depth_lt {V : Type u} {edge : V -> V -> Prop}
    (depth : V -> Nat)
    (local : forall {source target}, edge source target ->
      depth source < depth target)
    {source target : V} (path : StrictPath edge source target) :
    depth source < depth target := by
  induction path with
  | single direct => exact local direct
  | tail prefix direct ih => exact lt_trans ih (local direct)

end StrictPath

/-- Reflexive reachability is equality or a nonempty directed path. -/
def Reachable {V : Type u} (edge : V -> V -> Prop) (source target : V) : Prop :=
  source = target ∨ StrictPath edge source target

namespace Reachable

/-- Every vertex reaches itself. -/
theorem refl {V : Type u} {edge : V -> V -> Prop} (vertex : V) :
    Reachable edge vertex vertex :=
  Or.inl rfl

/-- Every direct edge is a reachability witness. -/
theorem of_edge {V : Type u} {edge : V -> V -> Prop} {source target : V}
    (direct : edge source target) : Reachable edge source target :=
  Or.inr (.single direct)

/-- Reachability is transitive. -/
theorem trans {V : Type u} {edge : V -> V -> Prop} {first middle last : V}
    (left : Reachable edge first middle) (right : Reachable edge middle last) :
    Reachable edge first last := by
  rcases left with left | left
  · subst middle
    exact right
  rcases right with right | right
  · subst last
    exact Or.inr left
  · exact Or.inr (left.trans right)

/-- Edge-preserving maps preserve reflexive reachability. -/
theorem map {V : Type u} {W : Type v}
    {edgeV : V -> V -> Prop} {edgeW : W -> W -> Prop}
    (f : V -> W)
    (preserves : forall {source target}, edgeV source target ->
      edgeW (f source) (f target))
    {source target : V} (reachable : Reachable edgeV source target) :
    Reachable edgeW (f source) (f target) := by
  rcases reachable with equality | path
  · exact Or.inl (congrArg f equality)
  · exact Or.inr (path.map f preserves)

/-- Edge-local label inclusion propagates to all reachable pairs. -/
theorem labels_mono {V : Type u} {Label : Type v}
    {edge : V -> V -> Prop} (labels : V -> Set Label)
    (local : forall {source target}, edge source target ->
      labels source ⊆ labels target)
    {source target : V} (reachable : Reachable edge source target) :
    labels source ⊆ labels target := by
  rcases reachable with equality | path
  · subst target
    exact Subset.rfl
  · exact path.labels_mono labels local

/-- Edge-local strict depth growth becomes reachability monotonicity. -/
theorem depth_le {V : Type u} {edge : V -> V -> Prop}
    (depth : V -> Nat)
    (local : forall {source target}, edge source target ->
      depth source < depth target)
    {source target : V} (reachable : Reachable edge source target) :
    depth source ≤ depth target := by
  rcases reachable with equality | path
  · subst target
    exact le_rfl
  · exact Nat.le_of_lt (path.depth_lt depth local)

end Reachable

/-- A direct dependency relation is acyclic when it has no nonempty loop. -/
def AcyclicEdge {V : Type u} (edge : V -> V -> Prop) : Prop :=
  forall vertex, ¬StrictPath edge vertex vertex

/-- A dependency graph is a carrier, a direct edge relation, and acyclicity. -/
structure DependencyGraph (V : Type u) where
  edge : V -> V -> Prop
  acyclic : AcyclicEdge edge

/-- The thin reachability order associated with an acyclic dependency graph. -/
def DependencyOrder {V : Type u} (_graph : DependencyGraph V) := V

namespace DependencyOrder

variable {V : Type u} (graph : DependencyGraph V)

instance : PartialOrder (DependencyOrder graph) where
  le source target := Reachable graph.edge source target
  le_refl := Reachable.refl
  le_trans _ _ _ := Reachable.trans
  le_antisymm source target forward backward := by
    rcases forward with equality | forwardPath
    · exact equality
    rcases backward with equality | backwardPath
    · exact equality.symm
    · exact (graph.acyclic source (forwardPath.trans backwardPath)).elim

@[simp]
theorem le_iff_reachable (source target : DependencyOrder graph) :
    source ≤ target ↔ Reachable graph.edge source target :=
  Iff.rfl

instance : TopologicalSpace (DependencyOrder graph) :=
  Topology.upperSet (DependencyOrder graph)

instance : Topology.IsUpperSet (DependencyOrder graph) :=
  ⟨rfl⟩

/-- The closure of a node is exactly its prerequisite ideal. -/
theorem closure_singleton_eq_prerequisites
    (node : DependencyOrder graph) :
    closure ({node} : Set (DependencyOrder graph)) = Set.Iic node := by
  exact Topology.IsUpperSet.closure_singleton

/-- The least neighbourhood of a node is its downstream impact filter. -/
theorem neighbourhood_eq_impact_filter
    (node : DependencyOrder graph) :
    𝓝 node = Filter.principal (Set.Ici node) := by
  exact Topology.IsUpperSet.nhds_eq_principal_Ici node

/-- Earlier nodes have smaller prerequisite ideals. -/
theorem prerequisite_ideal_mono {earlier later : DependencyOrder graph}
    (dependency : earlier ≤ later) :
    Set.Iic earlier ⊆ Set.Iic later := by
  intro node nodeEarlier
  exact nodeEarlier.trans dependency

/-- Later nodes have smaller downstream impact filters. -/
theorem impact_filter_antitone {earlier later : DependencyOrder graph}
    (dependency : earlier ≤ later) :
    Set.Ici later ⊆ Set.Ici earlier := by
  intro node laterNode
  exact dependency.trans laterNode

end DependencyOrder

/-- A natural-valued depth is strict on direct dependency edges. -/
def EdgeStrictDepth {V : Type u} (edge : V -> V -> Prop)
    (depth : V -> Nat) : Prop :=
  forall {source target}, edge source target -> depth source < depth target

/-- Direct strictness implies strict growth on every nonempty dependency path. -/
theorem strictPath_depth_lt {V : Type u} {edge : V -> V -> Prop}
    {depth : V -> Nat} (strict : EdgeStrictDepth edge depth)
    {source target : V} (path : StrictPath edge source target) :
    depth source < depth target :=
  path.depth_lt depth strict

/-- Direct strictness implies weak monotonicity on reflexive reachability. -/
theorem reachable_depth_le {V : Type u} {edge : V -> V -> Prop}
    {depth : V -> Nat} (strict : EdgeStrictDepth edge depth)
    {source target : V} (reachable : Reachable edge source target) :
    depth source ≤ depth target :=
  reachable.depth_le depth strict

/-- Depth sublevels form a closed filtration in the upper-set Alexandrov convention. -/
theorem depth_sublevel_closed {V : Type u} (graph : DependencyGraph V)
    (depth : V -> Nat) (strict : EdgeStrictDepth graph.edge depth)
    (level : Nat) :
    IsClosed {node : DependencyOrder graph | depth node ≤ level} := by
  rw [Topology.IsUpperSet.isClosed_iff_isLower]
  intro earlier later dependency laterBound
  exact (reachable_depth_le strict dependency).trans laterBound

/-- Complements of depth sublevels are open upper sets. -/
theorem depth_superlevel_open {V : Type u} (graph : DependencyGraph V)
    (depth : V -> Nat) (strict : EdgeStrictDepth graph.edge depth)
    (level : Nat) :
    IsOpen {node : DependencyOrder graph | level < depth node} := by
  rw [Topology.IsUpperSet.isOpen_iff_isUpperSet]
  intro earlier later dependency earlierDeep
  exact lt_of_lt_of_le earlierDeep (reachable_depth_le strict dependency)

/-- A list carrying the vertices of one directed root-to-target path. -/
inductive DirectedPath {V : Type u} (edge : V -> V -> Prop) :
    V -> V -> List V -> Prop
  | singleton (vertex : V) : DirectedPath edge vertex vertex [vertex]
  | prepend {source next target : V} {vertices : List V} :
      edge source next -> DirectedPath edge next target vertices ->
        DirectedPath edge source target (source :: vertices)

namespace DirectedPath

/-- Relation inclusion preserves the exact path vertex list. -/
theorem mono {V : Type u} {edge edge' : V -> V -> Prop}
    (include : forall {source target}, edge source target -> edge' source target)
    {source target : V} {vertices : List V}
    (path : DirectedPath edge source target vertices) :
    DirectedPath edge' source target vertices := by
  induction path with
  | singleton vertex => exact .singleton vertex
  | prepend direct rest ih => exact .prepend (include direct) ih

end DirectedPath

/-- Delete a vertex by retaining only edges whose two endpoints avoid it. -/
def deleteVertex {V : Type u} (edge : V -> V -> Prop) (deleted : V) :
    V -> V -> Prop :=
  fun source target => source ≠ deleted ∧ target ≠ deleted ∧ edge source target

/-- A path in a vertex-deleted graph cannot contain the deleted vertex. -/
theorem deleted_path_avoids {V : Type u} {edge : V -> V -> Prop}
    {deleted source target : V} {vertices : List V}
    (path : DirectedPath (deleteVertex edge deleted) source target vertices)
    (source_ne : source ≠ deleted) :
    deleted ∉ vertices := by
  induction path with
  | singleton vertex =>
      simpa using source_ne.symm
  | prepend direct rest ih =>
      simp only [List.mem_cons, not_or]
      exact ⟨direct.1.symm, ih direct.2.1⟩

/-- A node dominates a target when every root-to-target path contains it. -/
def Dominates {V : Type u} (root : V) (edge : V -> V -> Prop)
    (dominator target : V) : Prop :=
  forall vertices, DirectedPath edge root target vertices -> dominator ∈ vertices

/-- Deleting a dominator cuts every root-to-target path. -/
theorem unreachable_after_delete_of_dominates
    {V : Type u} {edge : V -> V -> Prop} {root dominator target : V}
    (dominates : Dominates root edge dominator target)
    (root_ne : root ≠ dominator) :
    ¬∃ vertices, DirectedPath (deleteVertex edge dominator) root target vertices := by
  rintro ⟨vertices, deletedPath⟩
  have originalPath : DirectedPath edge root target vertices :=
    deletedPath.mono (fun _ _ direct => direct.2.2)
  exact (deleted_path_avoids deletedPath root_ne)
    (dominates vertices originalPath)

/-- A map is conservative for direct edges when it preserves every direct edge. -/
def EdgePreserving {V : Type u} {W : Type v}
    (edgeV : V -> V -> Prop) (edgeW : W -> W -> Prop)
    (map : V -> W) : Prop :=
  forall {source target}, edgeV source target -> edgeW (map source) (map target)

/-- Conservative direct-edge maps preserve the whole reachability relation. -/
theorem conservative_map_preserves_reachability
    {V : Type u} {W : Type v}
    {edgeV : V -> V -> Prop} {edgeW : W -> W -> Prop}
    {map : V -> W} (preserves : EdgePreserving edgeV edgeW map)
    {source target : V} (reachable : Reachable edgeV source target) :
    Reachable edgeW (map source) (map target) :=
  reachable.map map preserves

/-- Finite approximations of a release are finite subsets of that release. -/
def FiniteApproximation {V : Type u} (release : Set V) :=
  {vertices : Finset V // (vertices : Set V) ⊆ release}

/-- Every released vertex already appears in a singleton finite approximation. -/
theorem finiteApproximation_contains
    {V : Type u} [DecidableEq V] {release : Set V} {vertex : V}
    (released : vertex ∈ release) :
    ∃ approximation : FiniteApproximation release,
      vertex ∈ approximation.1 := by
  refine ⟨⟨{vertex}, ?_⟩, by simp⟩
  intro x hx
  simp only [Finset.mem_coe, Finset.mem_singleton] at hx
  simpa [hx] using released

/-- Two finite approximations have a common finite upper bound given by union. -/
theorem finiteApproximations_directed
    {V : Type u} [DecidableEq V] {release : Set V}
    (left right : FiniteApproximation release) :
    ∃ upper : FiniteApproximation release,
      (left.1 : Set V) ⊆ upper.1 ∧ (right.1 : Set V) ⊆ upper.1 := by
  refine ⟨⟨left.1 ∪ right.1, ?_⟩, ?_, ?_⟩
  · intro vertex membership
    simp only [Finset.mem_coe, Finset.mem_union] at membership
    exact membership.elim left.2 right.2
  · intro vertex membership
    exact Finset.mem_union_left right.1 membership
  · intro vertex membership
    exact Finset.mem_union_right left.1 membership

/-- A directed family of releases is nonempty and has an upper member for every pair. -/
def DirectedReleaseFamily {V : Type u} (family : Set (Set V)) : Prop :=
  family.Nonempty ∧
    forall left ∈ family, forall right ∈ family,
      ∃ upper ∈ family, left ⊆ upper ∧ right ⊆ upper

/-- Every finite subset of a directed union is already contained in one family member. -/
theorem finite_subset_of_directed_sUnion
    {V : Type u} [DecidableEq V] {family : Set (Set V)}
    (directed : DirectedReleaseFamily family)
    (seed : Finset V) (contained : (seed : Set V) ⊆ ⋃₀ family) :
    ∃ release ∈ family, (seed : Set V) ⊆ release := by
  classical
  induction seed using Finset.induction_on with
  | empty =>
      rcases directed.1 with ⟨release, releaseInFamily⟩
      exact ⟨release, releaseInFamily, by simp⟩
  | @insert vertex rest vertexFresh ih =>
      have restContained : (rest : Set V) ⊆ ⋃₀ family := by
        intro x hx
        exact contained (by simp [hx])
      rcases ih restContained with ⟨restRelease, restInFamily, restSubset⟩
      have vertexInUnion : vertex ∈ ⋃₀ family :=
        contained (by simp)
      rcases Set.mem_sUnion.1 vertexInUnion with
        ⟨vertexRelease, vertexInFamily, vertexInRelease⟩
      rcases directed.2 restRelease restInFamily vertexRelease vertexInFamily with
        ⟨upper, upperInFamily, restUpper, vertexUpper⟩
      refine ⟨upper, upperInFamily, ?_⟩
      intro x hx
      simp only [Finset.mem_coe, Finset.mem_insert] at hx
      rcases hx with rfl | hx
      · exact vertexUpper vertexInRelease
      · exact restUpper (restSubset hx)

/-- A Scott-open property on the powerset release order. -/
def PowersetScottOpen {V : Type u} (openSet : Set (Set V)) : Prop :=
  IsUpperSet openSet ∧
    forall family : Set (Set V), DirectedReleaseFamily family ->
      ⋃₀ family ∈ openSet -> ∃ release ∈ family, release ∈ openSet

/-- Requiring a fixed finite certificate set is a Scott-open release property. -/
theorem finiteSupport_scottOpen
    {V : Type u} [DecidableEq V] (seed : Finset V) :
    PowersetScottOpen {release : Set V | (seed : Set V) ⊆ release} := by
  constructor
  · intro smaller larger inclusion seedInSmaller
    exact seedInSmaller.trans inclusion
  · intro family directed unionContainsSeed
    rcases finite_subset_of_directed_sUnion directed seed unionContainsSeed with
      ⟨release, releaseInFamily, seedInRelease⟩
    exact ⟨release, releaseInFamily, seedInRelease⟩

/-- An order simplex is an indexed strictly increasing chain. -/
def IsOrderSimplex {Index : Type u} {Vertex : Type v}
    [Preorder Index] [Preorder Vertex] (vertices : Index -> Vertex) : Prop :=
  StrictMono vertices

/-- Order embeddings preserve all order simplices. -/
theorem orderEmbedding_preserves_simplex
    {Index : Type u} {Vertex : Type v} {Target : Type w}
    [Preorder Index] [Preorder Vertex] [Preorder Target]
    (embedding : Vertex ↪o Target) (vertices : Index -> Vertex)
    (simplex : IsOrderSimplex vertices) :
    IsOrderSimplex (embedding ∘ vertices) := by
  intro first second earlier
  exact embedding.lt_iff.mpr (simplex earlier)

/-- Abstract local certificates over an index family. -/
structure CertificateSystem (Index : Type u) where
  Global : Type v
  Local : Index -> Type w
  restrict : forall index, Global -> Local index

namespace CertificateSystem

variable {Index : Type u} (system : CertificateSystem Index)

/-- The complete local readout of one global certificate. -/
def jointRestriction : system.Global -> forall index, system.Local index :=
  fun global index => system.restrict index global

/-- A family covers global certificates when all local restrictions are jointly faithful. -/
def Covers : Prop :=
  Function.Injective system.jointRestriction

/-- A local family is realizable when it is the restriction of a global certificate. -/
def Realizable (local : forall index, system.Local index) : Prop :=
  ∃ global, forall index, system.restrict index global = local index

/-- Coverage supplies uniqueness, while realizability supplies existence, of a gluing. -/
theorem unique_gluing_of_cover
    (covers : system.Covers)
    {local : forall index, system.Local index}
    (realizable : system.Realizable local) :
    ∃! global, forall index, system.restrict index global = local index := by
  rcases realizable with ⟨global, localEq⟩
  refine ⟨global, localEq, ?_⟩
  intro candidate candidateEq
  apply covers
  funext index
  exact (candidateEq index).trans (localEq index).symm

end CertificateSystem

