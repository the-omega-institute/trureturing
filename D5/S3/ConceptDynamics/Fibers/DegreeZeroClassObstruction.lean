import D5.S3.Factorization.QuadraticIdeals.NormTwoIdealLocalGlobalGap
import Mathlib.RingTheory.ClassGroup.Basic
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped nonZeroDivisors

namespace D5.S3.ConceptDynamics.Fibers.DegreeZeroClassObstruction

open D5.S3.Factorization.QuadraticIdeals.NormTwoIdeal
open D5.S3.Factorization.QuadraticIdeals.NormTwoIdealLocalGlobalGap

-- Lean 4.33's stricter type check breaks mathlib's `Fintype` deriving handler.
set_option backward.isDefEq.respectTransparency.types false in
/-- The two prime coordinates retained by the ideal-class downgrade. -/
inductive IdealClassPlace
  | normTwoPrime
  | classNeutralPrime
  deriving DecidableEq, Fintype

/-- A finitely supported integer family on the downgraded local coordinates. -/
abbrev LocalValuationData := IdealClassPlace →₀ ℤ

/-- The unweighted degree of a finite local integer family. -/
def localDegree (ell : LocalValuationData) : ℤ :=
  ell.sum fun _ n => n

/-- The explicit family with coefficient `1` at the nonprincipal prime class and
coefficient `-1` at the class-neutral degree-balancing coordinate. -/
noncomputable def degreeZeroClassObstruction : LocalValuationData :=
  Finsupp.single .normTwoPrime 1 - Finsupp.single .classNeutralPrime 1

/-- The principal ideal generated by `sqrt(-5)`, used as the class-neutral prime. -/
def classNeutralPrimeIdeal : Ideal QuadraticOrder :=
  Ideal.span ({Zsqrtd.sqrtd} : Set QuadraticOrder)

/-- Evaluation at `sqrt(-5) = 0` in characteristic five. -/
def classNeutralResidueHom : QuadraticOrder →+* ZMod 5 :=
  Zsqrtd.lift ⟨0, by decide⟩

private theorem class_neutral_residue_hom_ker :
    RingHom.ker classNeutralResidueHom = classNeutralPrimeIdeal := by
  apply le_antisymm
  · intro value value_mem
    rw [RingHom.mem_ker] at value_mem
    simp only [classNeutralResidueHom, Zsqrtd.lift_apply_apply, mul_zero,
      add_zero] at value_mem
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at value_mem
    obtain ⟨coefficient, coefficient_spec⟩ := value_mem
    rw [classNeutralPrimeIdeal, Ideal.mem_span_singleton']
    refine ⟨⟨value.im, -coefficient⟩, ?_⟩
    ext <;> simp
    omega
  · rw [classNeutralPrimeIdeal, Ideal.span_le]
    intro generator generator_mem
    have : generator = Zsqrtd.sqrtd := by simpa using generator_mem
    subst generator
    norm_num [RingHom.mem_ker, classNeutralResidueHom,
      Zsqrtd.lift_apply_apply]

/-- Both retained coordinates are genuine prime ideals, and the balancing prime
is principal. Primality types the coordinates; it does not prove the obstruction. -/
theorem local_coordinates_are_prime :
    normTwoIdeal.IsPrime ∧ classNeutralPrimeIdeal.IsPrime ∧
      classNeutralPrimeIdeal.IsPrincipal := by
  letI : Fact (Nat.Prime 5) := ⟨by norm_num⟩
  have quotient_is_field : IsField (QuadraticOrder ⧸ normTwoIdeal) :=
    quotientEquivZModTwo.toMulEquiv.isField (Field.toIsField (ZMod 2))
  have norm_two_is_prime : normTwoIdeal.IsPrime :=
    ((Ideal.Quotient.maximal_ideal_iff_isField_quotient normTwoIdeal).2
      quotient_is_field).isPrime
  refine ⟨norm_two_is_prime, ?_, ⟨Zsqrtd.sqrtd, rfl⟩⟩
  rw [← class_neutral_residue_hom_ker]
  exact RingHom.ker_isPrime classNeutralResidueHom

#print axioms local_coordinates_are_prime

/-- The prime ideal represented by each downgraded local coordinate. -/
def idealClassPlacePrime : IdealClassPlace → PrimeSpectrum QuadraticOrder
  | .normTwoPrime => ⟨normTwoIdeal, local_coordinates_are_prime.1⟩
  | .classNeutralPrime =>
      ⟨classNeutralPrimeIdeal, local_coordinates_are_prime.2.1⟩

private theorem norm_two_ideal_sq :
    normTwoIdeal * normTwoIdeal =
      Ideal.span ({(2 : QuadraticOrder)} : Set QuadraticOrder) := by
  rw [normTwoIdeal, Ideal.span_pair_mul_span_pair]
  apply le_antisymm
  · rw [Ideal.span_le]
    intro x hx
    rcases hx with (rfl | rfl | rfl | hx)
    · rw [show (2 : QuadraticOrder) * 2 = 2 * 2 by rfl]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton 2))
    · rw [show (2 : QuadraticOrder) * (1 + Zsqrtd.sqrtd) =
          (1 + Zsqrtd.sqrtd) * 2 by ring]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton 2))
    · exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton 2))
    · have hx' : x = (1 + Zsqrtd.sqrtd) * (1 + Zsqrtd.sqrtd) := by
        simpa using hx
      rw [hx']
      have factorization :
          (1 + Zsqrtd.sqrtd : QuadraticOrder) * (1 + Zsqrtd.sqrtd) =
            (-2 + Zsqrtd.sqrtd) * 2 := by
        ext <;> norm_num
      rw [factorization]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton 2))
  · rw [Ideal.span_singleton_le_iff_mem]
    let target : Ideal QuadraticOrder :=
      Ideal.span ({(2 : QuadraticOrder) * 2,
        2 * (1 + Zsqrtd.sqrtd),
        (1 + Zsqrtd.sqrtd) * 2,
        (1 + Zsqrtd.sqrtd) * (1 + Zsqrtd.sqrtd)} : Set QuadraticOrder)
    have four_mem : (4 : QuadraticOrder) ∈ target := by
      exact Ideal.subset_span (by left; norm_num)
    have two_root_mem : (2 * (1 + Zsqrtd.sqrtd) : QuadraticOrder) ∈ target := by
      exact Ideal.subset_span (by right; left; rfl)
    have root_sq_mem :
        ((1 + Zsqrtd.sqrtd) * (1 + Zsqrtd.sqrtd) : QuadraticOrder) ∈ target := by
      exact Ideal.subset_span (by right; right; right; rfl)
    have identity :
        ((2 * (1 + Zsqrtd.sqrtd) -
          (1 + Zsqrtd.sqrtd) * (1 + Zsqrtd.sqrtd)) - 4 : QuadraticOrder) = 2 := by
      ext <;> norm_num
    rw [← identity]
    exact Ideal.sub_mem target (Ideal.sub_mem target two_root_mem root_sq_mem) four_mem

private instance quadraticOrderNoZeroDivisors : NoZeroDivisors QuadraticOrder where
  eq_zero_or_eq_zero_of_mul_eq_zero {a b} hab := by
    have norm_product : Zsqrtd.norm a * Zsqrtd.norm b = 0 := by
      rw [← Zsqrtd.norm_mul, hab, Zsqrtd.norm_zero]
    rcases mul_eq_zero.mp norm_product with ha | hb
    · exact Or.inl ((Zsqrtd.norm_eq_zero_iff (by norm_num) a).mp ha)
    · exact Or.inr ((Zsqrtd.norm_eq_zero_iff (by norm_num) b).mp hb)

private instance quadraticOrderIsDomain : IsDomain QuadraticOrder :=
  NoZeroDivisors.to_isDomain _

private theorem norm_two_fractional_ideal_is_unit :
    IsUnit
      (normTwoIdeal :
        FractionalIdeal QuadraticOrder⁰ (FractionRing QuadraticOrder)) := by
  rw [isUnit_iff_exists_inv]
  refine ⟨(normTwoIdeal :
      FractionalIdeal QuadraticOrder⁰ (FractionRing QuadraticOrder)) *
      FractionalIdeal.spanSingleton QuadraticOrder⁰
        ((algebraMap QuadraticOrder (FractionRing QuadraticOrder)) 2)⁻¹, ?_⟩
  rw [← mul_assoc, ← FractionalIdeal.coeIdeal_mul, norm_two_ideal_sq,
    FractionalIdeal.coeIdeal_span_singleton,
    FractionalIdeal.spanSingleton_mul_spanSingleton, mul_inv_cancel₀,
    FractionalIdeal.spanSingleton_one]
  exact
    (map_ne_zero_iff _
      (IsFractionRing.injective QuadraticOrder (FractionRing QuadraticOrder))).mpr
        (by norm_num)

private noncomputable def normTwoFractionalIdealUnit :
    (FractionalIdeal QuadraticOrder⁰ (FractionRing QuadraticOrder))ˣ :=
  norm_two_fractional_ideal_is_unit.unit

/-- The actual ideal class of the concrete norm-two prime ideal. -/
noncomputable def normTwoIdealClass : ClassGroup QuadraticOrder :=
  ClassGroup.mk (FractionRing QuadraticOrder) normTwoFractionalIdealUnit

/-- The norm-two prime ideal represents a nontrivial class. -/
theorem norm_two_ideal_class_is_nontrivial : normTwoIdealClass ≠ 1 := by
  intro class_trivial
  have unit_value :
      (normTwoFractionalIdealUnit :
        FractionalIdeal QuadraticOrder⁰ (FractionRing QuadraticOrder)) =
          normTwoIdeal := by
    rw [normTwoFractionalIdealUnit]
    exact norm_two_fractional_ideal_is_unit.unit_spec
  obtain ⟨x, _, ideal_principal⟩ :=
    (ClassGroup.mk_eq_one_of_coe_ideal unit_value).mp class_trivial
  exact norm_two_ideal_local_global_gap.2.1 ⟨x, ideal_principal⟩

#print axioms norm_two_ideal_class_is_nontrivial

/-- The class contribution of each downgraded local coordinate. -/
noncomputable def idealClassWeight : IdealClassPlace → ClassGroup QuadraticOrder
  | .normTwoPrime => normTwoIdealClass
  | .classNeutralPrime => 1

/-- The ideal class reconstructed from finite integer coordinate data. -/
noncomputable def idealClassEvaluation
    (ell : LocalValuationData) : ClassGroup QuadraticOrder :=
  ell.prod fun place n => idealClassWeight place ^ n

/-- Class-level global realizability: the reconstructed class must equal the class
of a principal fractional ideal generated by some nonzero global element. This is
the approved path-B downgrade and is necessary for exact valuation realization. -/
def IdealClassGloballyRealizable (ell : LocalValuationData) : Prop :=
  ∃ x : (FractionRing QuadraticOrder)ˣ,
    idealClassEvaluation ell =
      ClassGroup.mk (FractionRing QuadraticOrder)
        (toPrincipalIdeal QuadraticOrder (FractionRing QuadraticOrder) x)

/-- The named witness really has the displayed local coefficients `1` and `-1`. -/
theorem obstruction_data_values :
    degreeZeroClassObstruction .normTwoPrime = 1 ∧
      degreeZeroClassObstruction .classNeutralPrime = -1 := by
  classical
  simp [degreeZeroClassObstruction]

#print axioms obstruction_data_values

private theorem obstruction_degree_zero :
    localDegree degreeZeroClassObstruction = 0 := by
  classical
  rw [localDegree, degreeZeroClassObstruction,
    Finsupp.sum_sub_index (fun _ _ _ => rfl)]
  simp

private theorem obstruction_class_eq_norm_two_class :
    idealClassEvaluation degreeZeroClassObstruction = normTwoIdealClass := by
  rw [idealClassEvaluation, degreeZeroClassObstruction, sub_eq_add_neg]
  rw [Finsupp.prod_add_index' (fun _ => zpow_zero _)
    (fun _ _ _ => zpow_add _ _ _)]
  rw [Finsupp.prod_neg_index (fun _ => zpow_zero _)]
  simp [idealClassWeight]

private theorem principal_element_class_eq_one
    (x : (FractionRing QuadraticOrder)ˣ) :
    ClassGroup.mk (FractionRing QuadraticOrder)
      (toPrincipalIdeal QuadraticOrder (FractionRing QuadraticOrder) x) = 1 := by
  rw [ClassGroup.mk_eq_one_iff]
  exact ⟨⟨(x : FractionRing QuadraticOrder), by
    simp [coe_toPrincipalIdeal, FractionalIdeal.coe_spanSingleton]⟩⟩

/-- The explicit local family has degree zero, but no nonzero global element can
even realize its ideal class, hence it cannot realize all local valuations. -/
theorem degree_zero_class_data_not_globally_realizable :
    localDegree degreeZeroClassObstruction = 0 ∧
      ¬ IdealClassGloballyRealizable degreeZeroClassObstruction := by
  refine ⟨obstruction_degree_zero, ?_⟩
  rintro ⟨x, realization⟩
  apply norm_two_ideal_class_is_nontrivial
  rw [← obstruction_class_eq_norm_two_class, realization,
    principal_element_class_eq_one]

#print axioms degree_zero_class_data_not_globally_realizable

/-- The zero local family is globally realizable by the element `1`. -/
theorem zero_class_data_is_globally_realizable :
    IdealClassGloballyRealizable 0 := by
  refine ⟨1, ?_⟩
  simp [idealClassEvaluation]

#print axioms zero_class_data_is_globally_realizable

/- Degenerate audit: the place type is neither empty nor a singleton. All data are
finitely supported by `Finsupp`; on this two-point type infinite support is impossible.
The zero family has both coefficients zero and is realized by `1`, as proved above. -/
example : Nonempty IdealClassPlace := ⟨.normTwoPrime⟩

example : ¬ Subsingleton IdealClassPlace := by
  intro h
  have places_equal :
      IdealClassPlace.normTwoPrime = IdealClassPlace.classNeutralPrime := h.elim _ _
  cases places_equal

example : degreeZeroClassObstruction.support = Finset.univ := by
  classical
  ext place
  cases place <;> simp [degreeZeroClassObstruction]

example (place : IdealClassPlace) : (0 : LocalValuationData) place = 0 := by
  rfl

example : idealClassWeight .classNeutralPrime = 1 := by
  rfl

/- Primality audit: `local_coordinates_are_prime` is used by `idealClassPlacePrime`
to type both coordinates as genuine finite prime places. Nonrealizability uses the
different layer `norm_two_ideal_class_is_nontrivial`; primality does not prove
nonprincipality. The balancing prime is principal, so its class weight is one.

Assumption audit: all five public theorems are concrete and have no variables,
hypotheses, or instance parameters. The private domain instance is proved from the
negative quadratic norm and is used only to form the fraction field and class group.
Thus there is no theorem hypothesis to weaken and no necessary-hypothesis
counterexample declaration to add. Empty, singleton, zero-data, and support degeneracies
are checked above. -/

end D5.S3.ConceptDynamics.Fibers.DegreeZeroClassObstruction
