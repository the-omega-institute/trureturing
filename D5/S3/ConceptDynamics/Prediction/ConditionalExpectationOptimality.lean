   mirror-B: D5/B/S3/ConceptDynamics/Prediction/ConditionalExpectationOptimality
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Conditional expectation minimizes squared error among concept-based predictors. -/

import Mathlib.MeasureTheory.Function.ConditionalExpectation.CondexpL2
import Mathlib.Tactic

/- Library-search audit trail (2026-08-23):
   * Pinned Mathlib's `condExpL2` is definitionally the orthogonal projection
     onto `lpMeas`, the subspace of functions measurable for a sub-sigma-algebra.
   * The exact minimization core is `Submodule.starProjection_minimal` in
     `Mathlib.Analysis.InnerProductSpace.Projection.Basic`; it is applied below.
   * Repository searches found the adjacent finite-dimensional theorem
     `minimum_mean_square_hedge`, but no theorem exposing conditional
     expectation over a concept-generated sigma-algebra.
   * The finite matrix conditioning module concerns unread projective
     measurements and is not a probability-space conditional expectation. -/

noncomputable section

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.Prediction.ConditionalExpectationOptimality

open MeasureTheory
open scoped ENNReal MeasureTheory

/-- The conditional expectation onto the sigma-algebra generated by a concept
has no larger squared `L2` error than any square-integrable measurable function
of that concept. -/
theorem conditional_expectation_minimizes_mean_square_error
    {X B : Type*} [MeasurableSpace X] [MeasurableSpace B]
    (mu : Measure X) (concept : X -> B) (target : X -> Real)
    (predictor : B -> Real) (hConcept : Measurable concept)
    (hTarget : MemLp target 2 mu) (hPredictorMeas : Measurable predictor)
    (hPredictor : MemLp (predictor ∘ concept) 2 mu) :
    ‖hTarget.toLp target -
        (↑(condExpL2 Real Real hConcept.comap_le (hTarget.toLp target)) :
          Lp Real 2 mu)‖ ^ 2 <=
      ‖hTarget.toLp target - hPredictor.toLp (predictor ∘ concept)‖ ^ 2 := by
  let targetLp : Lp Real 2 mu := hTarget.toLp target
  let predictorLp : Lp Real 2 mu :=
    hPredictor.toLp (predictor ∘ concept)
  have hConceptGenerated :
      @Measurable X B (MeasurableSpace.comap concept inferInstance)
        inferInstance concept := by
    exact comap_measurable concept
  have hPredictorGenerated :
      @Measurable X Real (MeasurableSpace.comap concept inferInstance)
        inferInstance (predictor ∘ concept) :=
    hPredictorMeas.comp hConceptGenerated
  have hPredictorAe :
      AEStronglyMeasurable[MeasurableSpace.comap concept inferInstance]
        (predictorLp : X -> Real) mu := by
    exact hPredictorGenerated.aestronglyMeasurable.congr
      hPredictor.coeFn_toLp.symm
  let measurablePredictor :
      lpMeas Real Real (MeasurableSpace.comap concept inferInstance) 2 mu :=
    ⟨predictorLp, mem_lpMeas_iff_aestronglyMeasurable.mpr hPredictorAe⟩
  have hMinimal :
      ‖targetLp -
          (↑(condExpL2 Real Real hConcept.comap_le targetLp) :
            Lp Real 2 mu)‖ <=
        ‖targetLp - predictorLp‖ := by
    haveI : Fact
        (MeasurableSpace.comap concept inferInstance <=
          (inferInstance : MeasurableSpace X)) :=
      ⟨hConcept.comap_le⟩
    rw [condExpL2]
    change
      ‖targetLp -
          (lpMeas Real Real (MeasurableSpace.comap concept inferInstance) 2 mu).starProjection
            targetLp‖ <=
        ‖targetLp - predictorLp‖
    rw [(lpMeas Real Real
      (MeasurableSpace.comap concept inferInstance) 2 mu).starProjection_minimal targetLp]
    exact ciInf_le
      ⟨0, Set.forall_mem_range.mpr fun _ => norm_nonneg _⟩
      measurablePredictor
  change
    ‖targetLp -
        (↑(condExpL2 Real Real hConcept.comap_le targetLp) :
          Lp Real 2 mu)‖ ^ 2 <=
      ‖targetLp - predictorLp‖ ^ 2
  nlinarith [
    norm_nonneg
      (targetLp -
        (↑(condExpL2 Real Real hConcept.comap_le targetLp) :
          Lp Real 2 mu)),
    norm_nonneg (targetLp - predictorLp)]

#print axioms conditional_expectation_minimizes_mean_square_error

end D5.S3.ConceptDynamics.Prediction.ConditionalExpectationOptimality
