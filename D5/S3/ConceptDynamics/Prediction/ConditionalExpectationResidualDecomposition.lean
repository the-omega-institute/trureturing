/-- Conditional expectation on the sigma-algebra generated by a concept map
gives the unique residual which reconstructs the target and is orthogonal to
every square-integrable variable measurable through that concept. -/
theorem conditional_expectation_residual_orthogonal_decomposition
    {X B : Type*} [ambient : MeasurableSpace X] [MeasurableSpace B]
    (mu : Measure X) (concept : X -> B) (hConcept : Measurable concept)
    (target : Lp Real 2 mu) :
    ∃! residual : Lp Real 2 mu,
      residual = target -
          (↑(condExpL2 Real Real hConcept.comap_le target) : Lp Real 2 mu) ∧
        target =
          (↑(condExpL2 Real Real hConcept.comap_le target) : Lp Real 2 mu) +
            residual ∧
        ∀ observable :
            @lpMeas X Real Real _ _ _
              (MeasurableSpace.comap concept inferInstance) ambient 2 mu,
          inner Real residual (observable : Lp Real 2 mu) = 0 := by
  let generated : Submodule Real (Lp Real 2 mu) :=
    @lpMeas X Real Real _ _ _
      (MeasurableSpace.comap concept inferInstance) ambient 2 mu
  let estimate : Lp Real 2 mu :=
    (↑(condExpL2 Real Real hConcept.comap_le target) : Lp Real 2 mu)
  letI : Fact
      (MeasurableSpace.comap concept inferInstance <= ambient) :=
    ⟨hConcept.comap_le⟩
  have hOrthogonal (observable : generated) :
      inner Real (target - estimate) (observable : Lp Real 2 mu) = 0 := by
    change inner Real (target - generated.starProjection target)
      (observable : Lp Real 2 mu) = 0
    exact generated.starProjection_inner_eq_zero target _ observable.property
  change ∃! residual : Lp Real 2 mu,
    residual = target - estimate ∧
      target = estimate + residual ∧
      ∀ observable : generated,
        inner Real residual (observable : Lp Real 2 mu) = 0
  refine ⟨target - estimate, ?_, ?_⟩
  · refine ⟨rfl, ?_, hOrthogonal⟩
    abel
  · intro residual hResidual
    exact hResidual.1

#print axioms conditional_expectation_residual_orthogonal_decomposition

end D5.S3.ConceptDynamics.Prediction.ConditionalExpectationResidualDecomposition
