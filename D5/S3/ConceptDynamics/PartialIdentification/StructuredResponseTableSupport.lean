/- GID: D5/S3/ConceptDynamics/PartialIdentification/StructuredResponseTableSupport
   generality: G
   mirror-B: D5/B/S3/ConceptDynamics/PartialIdentification/StructuredResponseTableSupport
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: [mathlib/module/Mathlib.Data.Fintype.Card]
   digest: The unrestricted 4^k response-table family cannot be losslessly generated by fewer than 4^k latent states; positive independent row laws have full table support, so automatic compression is possible only after restricting the admissible cross-stratum family. -/

import D5.S3.ConceptDynamics.PartialIdentification.QuaternaryResponseTableCoding
import D5.S3.ConceptDynamics.PartialIdentification.FiniteIndependentSourceGrouping
import Mathlib.Data.Fintype.Card

/- Library audit (2026-09-06): reuse Fintype.card_le_of_surjective and
   Finset.prod_pos. The theorem concerns exact support coverage by a deterministic
   latent-state generator. DFAO state count is not silently identified with this
   latent support count. A finite automaton can provide a compact algorithmic
   description of one structured table without representing every unrestricted
   table as a separate automaton state. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.PartialIdentification.StructuredResponseTableSupport

open scoped BigOperators
open D5.S3.ConceptDynamics.PartialIdentification.MarkovianResponseLawFactorization
open D5.S3.ConceptDynamics.PartialIdentification.FiniteIndependentSourceGrouping
open D5.S3.ConceptDynamics.PartialIdentification.QuaternaryResponseTableCoding

/-- A deterministic latent generator covers every positive-mass atom of a law. -/
def SupportsLaw
    {State Table : Type*}
    (law : FiniteResponseLaw Table) (generator : State → Table) : Prop :=
  ∀ table, law.mass table ≠ 0 → ∃ state, generator state = table

/-- Any deterministic generator that covers every unrestricted k-row Boolean
response table needs at least 4^k latent states. -/
theorem surjective_response_table_generator_requires_four_pow
    {k : Nat} {State : Type*} [Fintype State]
    (generator : State → (Fin k → Bool × Bool))
    (surjective : Function.Surjective generator) :
    4 ^ k ≤ Fintype.card State := by
  rw [← responseTable_card_eq_four_pow]
  exact Fintype.card_le_of_surjective generator surjective

/-- A smaller deterministic latent family necessarily omits at least one
unrestricted response table. This is the exact sense in which support compression
changes the model class unless additional cross-stratum structure is justified. -/
theorem small_generator_not_universal
    {k : Nat} {State : Type*} [Fintype State]
    (generator : State → (Fin k → Bool × Bool))
    (small : Fintype.card State < 4 ^ k) :
    ¬ Function.Surjective generator := by
  intro surjective
  have lower := surjective_response_table_generator_requires_four_pow generator surjective
  omega

/-- Twenty-one deterministic latent atoms cannot cover the three-row unrestricted
table carrier, which already has 4^3 = 64 elements. The number 21 is included to
make the scale distinction with the current golden powers-only DFAO draft explicit;
this theorem makes no claim about DFAO state minimality. -/
theorem twenty_one_latent_states_not_universal_three_rows
    (generator : Fin 21 → (Fin 3 → Bool × Bool)) :
    ¬ Function.Surjective generator := by
  apply small_generator_not_universal generator
  norm_num

/-- If every row law assigns positive mass to all four complete response types,
the elementary independent table law assigns positive mass to every one of the
4^k full tables. -/
theorem independentResponseTable_full_support
    {k : Nat}
    (kernel : Fin k → FiniteResponseLaw (Bool × Bool))
    (positive : ∀ c response, 0 < (kernel c).mass response)
    (table : Fin k → Bool × Bool) :
    0 < (independentSourceLaw kernel).mass table := by
  change 0 < ∏ c, (kernel c).mass (table c)
  exact Finset.prod_pos (fun c _ => positive c (table c))

/-- Consequently, an exact deterministic latent generator for a positive
independent-row table law cannot beat the 4^k support count. -/
theorem positive_independent_table_law_generator_lower_bound
    {k : Nat} {State : Type*} [Fintype State]
    (kernel : Fin k → FiniteResponseLaw (Bool × Bool))
    (positive : ∀ c response, 0 < (kernel c).mass response)
    (generator : State → (Fin k → Bool × Bool))
    (supports : SupportsLaw (independentSourceLaw kernel) generator) :
    4 ^ k ≤ Fintype.card State := by
  apply surjective_response_table_generator_requires_four_pow generator
  intro table
  exact supports table (ne_of_gt (independentResponseTable_full_support kernel positive table))

/-- A latent family with fewer than 4^k states cannot exactly support any
independent-row law whose four row atoms are all strictly positive. -/
theorem positive_independent_table_law_not_supported_by_small_generator
    {k : Nat} {State : Type*} [Fintype State]
    (kernel : Fin k → FiniteResponseLaw (Bool × Bool))
    (positive : ∀ c response, 0 < (kernel c).mass response)
    (generator : State → (Fin k → Bool × Bool))
    (small : Fintype.card State < 4 ^ k) :
    ¬ SupportsLaw (independentSourceLaw kernel) generator := by
  intro supports
  have lower := positive_independent_table_law_generator_lower_bound
    kernel positive generator supports
  omega

#print axioms surjective_response_table_generator_requires_four_pow
#print axioms small_generator_not_universal
#print axioms twenty_one_latent_states_not_universal_three_rows
#print axioms independentResponseTable_full_support
#print axioms positive_independent_table_law_generator_lower_bound
#print axioms positive_independent_table_law_not_supported_by_small_generator

end D5.S3.ConceptDynamics.PartialIdentification.StructuredResponseTableSupport
