namespace PackedAxisBoolBridge

private def limit := 32768
private def pivot : Fin limit := ⟨32767, by decide⟩

private def leftCheck (col : ℕ → List ℕ) (v w : ℕ) : Bool :=
  decide (w < limit) && (col w).contains v &&
    (v == pivot.val || (v &&& w) == v)

private def rightCheck (row : ℕ → List ℕ) (v w : ℕ) : Bool :=
  decide (w < limit) && (row w).contains v

private def valid (row col : ℕ → List ℕ) (v : Fin limit) : Bool :=
  (row v).all (leftCheck col v) &&
  (col v).all (rightCheck row v) &&
  @decide (residualDegree 3 true (decide (v = pivot)) (row v).length)
    (by unfold residualDegree; infer_instance) &&
  @decide (residualDegree 3 true (decide (v = pivot)) (col v).length)
    (by unfold residualDegree; infer_instance) &&
  decide (row v).Nodup &&
  decide (col v).Nodup &&
  decide (v = pivot → pivot.val ∉ row v)

private theorem validated_axis (row col : ℕ → List ℕ) (budget : ℕ)
    (checked : ∀ v, valid row col v = true)
    (cost : 4 * (1 + ∑ v : Fin limit, if v ≠ pivot ∧ weight 15 v % 2 = 1 then
      (row v).countP (fun w => weight 15 w % 2 == 1) else 0) ≤ budget) :
    axisFactorWithin 3 (0 : Fin 16) budget := by
  have hv (v : Fin limit) := checked v
  simp only [valid, Bool.and_eq_true, decide_eq_true_eq] at hv
  have left (v : Fin limit) := List.all_eq_true.mp (hv v).1.1.1.1.1.1
  have right (v : Fin limit) := List.all_eq_true.mp (hv v).1.1.1.1.1.2
  simp only [leftCheck, rightCheck, Bool.and_eq_true, decide_eq_true_eq,
    Bool.or_eq_true, beq_iff_eq, List.contains_iff_mem] at left right
  have factor : MaskedFactorWithRows 3 (0 : Fin 16) budget
      (fun a b => ((maskEquiv 15).symm b).val ∈ row ((maskEquiv 15).symm a).val) := by
    apply ListBridge.list_axis_factor (n := 15) (fun a => row a) (fun b => col b)
      budget pivot (by decide)
    · exact (hv pivot).2 rfl
    · intro a w hw
      exact (left a w hw).1.1
    · intro b w hw
      exact (right b w hw).1
    · intro a
      exact (hv a).1.1.2
    · intro b
      exact (hv b).1.2
    · intro a b
      exact ⟨fun h => (left a b h).1.2, fun h => (right b a h).2⟩
    · intro a
      exact (hv a).1.1.1.1.2
    · intro b
      exact (hv b).1.1.1.2
    · intro a ha w hw
      exact ((left a w hw).2.resolve_left fun h => ha (Fin.ext h))
    · exact cost
  obtain ⟨f, marked, loop, mode, rows, cols, support, charge, _⟩ := factor
  exact ⟨f, marked, loop, mode, rows, cols, support, charge⟩

end PackedAxisBoolBridge

namespace PackedAxisBoolBridge

private def blockPass (row col : ℕ → List ℕ) (block : Fin 512) : Bool :=
  (List.finRange 64).all fun i => valid row col (finProdFinEquiv (block,i))

private def charge (row : ℕ → List ℕ) (v : ℕ) : ℕ :=
  if v ≠ pivot.val ∧ weight 15 v % 2 = 1 then
    (row v).countP (fun w => weight 15 w % 2 == 1) else 0

private theorem sum_blocks (f : ℕ → ℕ) (m n : ℕ) :
    (∑ v : Fin (m * n), f v.val) =
      ∑ b : Fin m, ∑ i : Fin n, f (n * b.val + i.val) := by
  let e : Fin m × Fin n ≃ Fin (m * n) := finProdFinEquiv
  rw [← e.sum_comp (fun v => f v.val), Fintype.sum_prod_type]
  apply sum_congr rfl
  intro b _
  apply sum_congr rfl
  intro i _
  change f (i.val + n * b.val) = f (n * b.val + i.val)
  rw [Nat.add_comm]

private theorem list_range_sum (f : ℕ → ℕ) (n : ℕ) :
    ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp
  | succ n ih => simp [List.range_succ, sum_range_succ, ih]

private theorem block_sum (f : ℕ → ℕ) :
    (∑ v : Fin limit, f v.val) =
      ((List.range 512).map fun b => ((List.range 64).map fun i => f (64 * b + i)).sum).sum := by
  change (∑ v : Fin (512 * 64), f v.val) = _
  rw [sum_blocks]
  simp only [list_range_sum]
  rw [Fin.sum_univ_eq_sum_range (fun b => ∑ i : Fin 64, f (64 * b + i.val))]
  apply sum_congr rfl
  intro b _
  exact Fin.sum_univ_eq_sum_range (fun i => f (64 * b + i)) 64

private theorem of_checked_blocks (row col : ℕ → List ℕ) (budget : ℕ)
    (checked : (List.finRange 512).all (blockPass row col) = true)
    (cost : 4 * (1 + ((List.range 512).map fun b =>
      ((List.range 64).map fun i => charge row (64 * b + i)).sum).sum) ≤ budget) :
    axisFactorWithin 3 (0 : Fin 16) budget := by
  apply validated_axis row col budget
  · intro v
    let e : Fin 512 × Fin 64 ≃ Fin limit := finProdFinEquiv
    obtain ⟨⟨b,i⟩, rfl⟩ := e.surjective v
    have hb := List.all_eq_true.mp checked b (List.mem_finRange b)
    exact List.all_eq_true.mp hb i (List.mem_finRange i)
  · have sumEq : (∑ v : Fin limit, if v ≠ pivot ∧ weight 15 v % 2 = 1 then
        (row v).countP (fun w => weight 15 w % 2 == 1) else 0) =
        ∑ v : Fin limit, charge row v := by
      apply sum_congr rfl
      intro v _
      simp only [charge, Fin.val_ne_iff]
    rw [sumEq, block_sum]
    exact cost

end PackedAxisBoolBridge

