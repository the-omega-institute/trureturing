open D5.S3.ConceptDynamics.Attribution.ParitySeedAxisFactor
open D5.S3.ConceptDynamics.Attribution.ParitySeedFactor

private theorem axis_factor_weakens {d k b₁ b₂ : ℕ} (i : Fin d)
    (h : axisFactorWithin k i b₁) (le : b₁ ≤ b₂) : axisFactorWithin k i b₂ := by
  obtain ⟨edge, mode, omitted, permitted, rows, cols, support, cost⟩ := h
  exact ⟨edge, mode, omitted, permitted, rows, cols, support, cost.trans le⟩

/-- With only coordinate zero available, the full inclusion graph has minimum budget 2036. -/
theorem full_budget_iff (budget : ℕ) :
    axisFactorWithin 3 (0 : Fin 16) budget ↔ 2036 ≤ budget :=
  ⟨full_budget_ge 0 budget,
    axis_factor_weakens 0 OmegaAxisOneJump.axis_2036_staged⟩

private abbrev coordinate : Fin 16 := 0

def claim : Prop :=
  axisFactorWithin 3 coordinate 2036 → coverWithin 2036

theorem result : ¬ claim := by
  intro hypothetical
  have feasible := hypothetical ((full_budget_iff 2036).2 (by decide))
  have impossible := cover_budget_ge 2036 feasible
  omega

end D5.S3.ConceptDynamics.Attribution.AxisBudgets.DimensionSixteen
