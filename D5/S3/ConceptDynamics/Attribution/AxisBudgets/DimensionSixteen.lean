private theorem kernelChecked : (List.finRange 512).all (PackedAxisBoolBridge.blockPass row col) = true := by
  apply List.all_eq_true.mpr
  intro b _
  have h := assemble_checks blockPass (fun c => (chunk_certificates c).1) b
  simpa only [blockPass, dite_eq_left b.isLt] using h

private theorem exactCost :
    4 * (1 + ∑ c : Fin 64, chunkCharge row c) ≤ 2036 := by
  have h : (∑ c : Fin 64, chunkCharge row c) = ∑ c : Fin 64, chunkCosts c :=
    sum_congr rfl (fun c _ => (chunk_certificates c).2)
  rw [h]
  decide +kernel

private theorem of_chunk_costs (rows cols : Nat → List Nat) (budget : Nat)
    (checked : (List.finRange 512).all (PackedAxisBoolBridge.blockPass rows cols) = true)
    (cost : 4 * (1 + ∑ c : Fin 64, chunkCharge rows c) ≤ budget) :
    axisFactorWithin 3 (0 : Fin 16) budget := by
  apply PackedAxisBoolBridge.of_checked_blocks rows cols budget checked
  have regrouped := assemble_cost rows
  unfold blockCharge at regrouped
  rw [regrouped]
  exact cost

private theorem axis_2036_staged : axisFactorWithin 3 (0 : Fin 16) 2036 :=
  of_chunk_costs row col 2036 kernelChecked exactCost

