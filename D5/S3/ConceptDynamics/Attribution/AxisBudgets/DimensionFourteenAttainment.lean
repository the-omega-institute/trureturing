private theorem kernelChecked : (List.finRange 128).all (PackedRows.blockPass row col) = true := by
  apply List.all_eq_true.mpr
  intro b _
  have h := assemble_checks blockPass chunk_checks b
  simpa only [blockPass, dite_eq_left b.isLt] using h

private theorem exactCost :
    4 * (1 + ∑ c : Fin 16, chunkCharge row c) ≤ 640 := by
  have h : (∑ c : Fin 16, chunkCharge row c) = ∑ c : Fin 16, chunkCosts c :=
    sum_congr rfl (fun c _ => chunk_costs c)
  rw [h]
  decide +kernel

private theorem of_chunk_costs (rows cols : Nat → List Nat) (budget : Nat)
    (checked : (List.finRange 128).all (PackedRows.blockPass rows cols) = true)
    (cost : 4 * (1 + ∑ c : Fin 16, chunkCharge rows c) ≤ budget) :
    MaskedFactorWithRows 3 (0 : Fin 14) budget
      (fun a b => ((maskEquiv 13).symm b).val ∈ rows ((maskEquiv 13).symm a).val) := by
  apply PackedRows.of_checked_blocks rows cols budget checked
  have regrouped := assemble_cost rows
  unfold blockCharge at regrouped
  rw [regrouped]
  exact cost

private theorem axis_640_with_rows : MaskedFactorWithRows 3 (0 : Fin 14) 640
    (fun a b => ((maskEquiv 13).symm b).val ∈ row ((maskEquiv 13).symm a).val) :=
  of_chunk_costs row col 640 kernelChecked exactCost

private theorem weight_or_single_le (n a j : ℕ) :
    weight n (a ||| (1 <<< j)) ≤ weight n a + 1 := by
  let s : Finset (Fin n) := univ.filter (fun i => i.val = j)
  have hs : s.card ≤ 1 := by
    apply card_le_one_iff.mpr
    intro x y hx hy
    exact Fin.ext ((mem_filter.mp hx).2.trans (mem_filter.mp hy).2.symm)
  have sub : decode n (a ||| (1 <<< j)) ⊆ decode n a ∪ s := by
    intro i hi
    simp only [decode, mem_filter, mem_univ, true_and, Nat.one_shiftLeft,
      Nat.testBit_or, Bool.or_eq_true, Nat.testBit_two_pow, decide_eq_true_eq] at hi
    rcases hi with ha | hj
    · exact mem_union_left _ (mem_filter.mpr ⟨mem_univ _, ha⟩)
    · exact mem_union_right _ (mem_filter.mpr ⟨mem_univ _, hj.symm⟩)
  rw [← decode_card, ← decode_card]
  exact (card_le_card sub).trans ((card_union_le _ _).trans (Nat.add_le_add_left hs _))

private theorem skip_whitelist (a b : Fin 8192) (ordinary : a.val ≠ 8191)
    (edge : b.val ∈ row a.val) (skips : weight 13 a.val + 1 < weight 13 b.val) :
    (a.val = 15 ∧ b.val = 63) ∨ (a.val = 255 ∧ b.val = 1023) := by
  unfold row at edge
  split at edge
  · rename_i ht
    change (a.val == 8191) = true at ht
    exact (ordinary (beq_iff_eq.mp ht)).elim
  · obtain ⟨code, _, hc⟩ := List.mem_filterMap.mp edge
    split at hc
    · rename_i h
      have he := Option.some.inj hc
      rw [he] at skips
      omega
    · split at hc
      · rename_i h
        have he := Option.some.inj hc
        have bound := weight_or_single_le 13 a.val (code - 1)
        rw [he] at bound
        omega
      · split at hc
        · have he := Option.some.inj hc
          change (if a.val == 15 then 63 else if a.val == 255 then 1023 else 8192) =
            b.val at he
          by_cases ha : a.val = 15
          · exact Or.inl ⟨ha, by simpa [ha] using he.symm⟩
          · by_cases hb : a.val = 255
            · exact Or.inr ⟨hb, by simpa [ha, hb] using he.symm⟩
            · simp [ha, hb] at he
              omega
        · contradiction

def AttainsTwoJumpsAt640 : Prop :=
  ∃ (f : AxisSubset 14 (0 : Fin 14) → AxisSubset 14 0 → Bool) (selected : Bool),
    f (axisTop 0) (axisTop 0) = false ∧ (selected = false → 3 ≤ 3) ∧
    (∀ A, residualDegree 3 selected (decide (A = axisTop 0)) (∑ B, (f A B).toNat)) ∧
    (∀ B, residualDegree 3 selected (decide (B = axisTop 0)) (∑ A, (f A B).toNat)) ∧
    (∀ A B, A ≠ axisTop 0 → f A B = true → A.val ⊆ B.val) ∧
    axisCost 0 f ≤ 640 ∧ (rankJumps (fun A => A.val.card) (axisTop 0) f).card = 2

set_option linter.constructorNameAsVariable false in
private theorem two_jumps_attainable_at_640 : AttainsTwoJumpsAt640 := by
  obtain ⟨f, selected, loop, mode, rows, cols, support, cost, read⟩ := axis_640_with_rows
  let E := maskEquiv 13
  have ht : E ⟨8191, by decide⟩ = axisTop 0 := mask_top 13 _ (by decide)
  let skips : Finset (AxisSubset 14 (0 : Fin 14) × AxisSubset 14 0) :=
    {(E ⟨15, by decide⟩, E ⟨63, by decide⟩), (E ⟨255, by decide⟩, E ⟨1023, by decide⟩)}
  have subset : rankJumps (fun A => A.val.card) (axisTop 0) f ⊆ skips := by
    rintro ⟨A, B⟩ h
    obtain ⟨a, rfl⟩ := E.surjective A
    obtain ⟨b, rfl⟩ := E.surjective B
    rw [rankJumps, mem_filter] at h
    obtain ⟨ordinary, span, on⟩ := h.2
    have oa : a.val ≠ 8191 := by
      intro ha
      have eq : a = (⟨8191, by decide⟩ : Fin (2 ^ 13)) := Fin.ext ha
      apply ordinary
      rw [eq]
      exact ht
    have e := (read (E a) (E b)).mp on
    simp only [E, Equiv.symm_apply_apply] at e
    have l : weight 13 a.val + 1 < weight 13 b.val := by
      simpa only [E, mask_rank] using span
    rcases skip_whitelist a b oa e l with ⟨ha,hb⟩ | ⟨ha,hb⟩
    · exact mem_insert.mpr (Or.inl (Prod.ext (congrArg E (Fin.ext ha)) (congrArg E (Fin.ext hb))))
    · exact mem_insert_of_mem (mem_singleton.mpr (Prod.ext
        (congrArg E (Fin.ext ha)) (congrArg E (Fin.ext hb))))
  have upper : (rankJumps (fun A => A.val.card) (axisTop 0) f).card ≤ 2 := by
    have h : skips.card ≤ 2 := by
      unfold skips
      exact (card_insert_le _ _).trans (by rw [card_singleton])
    exact (card_le_card subset).trans h
  have lower := two_jumps_at_640 0 f selected rows cols support cost
  exact ⟨f, selected, loop, mode, rows, cols, support, cost, le_antisymm upper lower⟩

/-- The claim that budget 640 cannot be attained with exactly two ordinary jumps. -/
def claim : Prop := ¬ AttainsTwoJumpsAt640

/-- A checked Boolean factor refutes the claim at coordinate zero. -/
theorem result : ¬ claim := fun h => h two_jumps_attainable_at_640

end D5.S3.ConceptDynamics.Attribution.AxisBudgets.DimensionFourteenAttainment
