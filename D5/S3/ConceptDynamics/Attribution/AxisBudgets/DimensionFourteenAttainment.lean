namespace PackedRows

private def limit := 8192
private def pivot : Fin limit := ⟨8191, by decide⟩

private def leftCheck (col : ℕ → List ℕ) (v w : ℕ) : Bool :=
  decide (w < limit) && (col w).contains v &&
    (v == pivot.val || (v &&& w) == v)

private def rightCheck (row : ℕ → List ℕ) (v w : ℕ) : Bool :=
  decide (w < limit) && (row w).contains v

private def valid (row col : ℕ → List ℕ) (v : Fin limit) : Bool :=
  (row v).all (leftCheck col v) &&
  (col v).all (rightCheck row v) &&
  @decide (residualDegree 3 true (decide (v = pivot)) (row v).length)
    (by unfold residualDegree; infer_instance) &&
  @decide (residualDegree 3 true (decide (v = pivot)) (col v).length)
    (by unfold residualDegree; infer_instance) &&
  decide (row v).Nodup &&
  decide (col v).Nodup &&
  decide (v = pivot → pivot.val ∉ row v)

private theorem validated_axis (row col : ℕ → List ℕ) (budget : ℕ)
    (checked : ∀ v, valid row col v = true)
    (cost : 4 * (1 + ∑ v : Fin limit, if v ≠ pivot ∧ weight 13 v % 2 = 1 then
      (row v).countP (fun w => weight 13 w % 2 == 1) else 0) ≤ budget) :
    MaskedFactorWithRows 3 (0 : Fin 14) budget
      (fun a b => ((maskEquiv 13).symm b).val ∈ row ((maskEquiv 13).symm a).val) := by
  have hv (v : Fin limit) := checked v
  simp only [valid, Bool.and_eq_true, decide_eq_true_eq] at hv
  have left (v : Fin limit) := List.all_eq_true.mp (hv v).1.1.1.1.1.1
  have right (v : Fin limit) := List.all_eq_true.mp (hv v).1.1.1.1.1.2
  simp only [leftCheck, rightCheck, Bool.and_eq_true, decide_eq_true_eq,
    Bool.or_eq_true, beq_iff_eq, List.contains_iff_mem] at left right
  apply ListBridge.list_axis_factor (n := 13) (fun a => row a) (fun b => col b)
    budget pivot (by decide)
  · exact (hv pivot).2 rfl
  · intro a w hw
    exact (left a w hw).1.1
  · intro b w hw
    exact (right b w hw).1
  · intro a
    exact (hv a).1.1.2
  · intro b
    exact (hv b).1.2
  · intro a b
    exact ⟨fun h => (left a b h).1.2, fun h => (right b a h).2⟩
  · intro a
    exact (hv a).1.1.1.1.2
  · intro b
    exact (hv b).1.1.1.2
  · intro a ha w hw
    exact ((left a w hw).2.resolve_left fun h => ha (Fin.ext h))
  · exact cost

end PackedRows

namespace PackedRows

private def blockPass (row col : ℕ → List ℕ) (block : Fin 128) : Bool :=
  (List.finRange 64).all fun i => valid row col (finProdFinEquiv (block,i))

private def charge (row : ℕ → List ℕ) (v : ℕ) : ℕ :=
  if v ≠ pivot.val ∧ weight 13 v % 2 = 1 then
    (row v).countP (fun w => weight 13 w % 2 == 1) else 0

private theorem block_sum (f : ℕ → ℕ) :
    (∑ v : Fin limit, f v.val) =
      ((List.range 128).map fun b => ((List.range 64).map fun i => f (64 * b + i)).sum).sum := by
  simp only [Fin.sum_univ_eq_sum_range, ← List.sum_toFinset _ List.nodup_range,
    List.toFinset_range]
  change (∑ v ∈ range (128 * 64), f v) = _
  rw [D5.S1.Words.TwoBlockSubstitution.ThueMorseFrequency.sum_blocks]
  apply sum_congr rfl
  intro b _
  rw [Nat.mul_comm b 64]

private theorem of_checked_blocks (row col : ℕ → List ℕ) (budget : ℕ)
    (checked : (List.finRange 128).all (blockPass row col) = true)
    (cost : 4 * (1 + ((List.range 128).map fun b =>
      ((List.range 64).map fun i => charge row (64 * b + i)).sum).sum) ≤ budget) :
    MaskedFactorWithRows 3 (0 : Fin 14) budget
      (fun a b => ((maskEquiv 13).symm b).val ∈ row ((maskEquiv 13).symm a).val) := by
  apply validated_axis row col budget
  · intro v
    let e : Fin 128 × Fin 64 ≃ Fin limit := finProdFinEquiv
    obtain ⟨⟨b,i⟩, rfl⟩ := e.surjective v
    have hb := List.all_eq_true.mp checked b (List.mem_finRange b)
    exact List.all_eq_true.mp hb i (List.mem_finRange i)
  · have sumEq : (∑ v : Fin limit, if v ≠ pivot ∧ weight 13 v % 2 = 1 then
        (row v).countP (fun w => weight 13 w % 2 == 1) else 0) =
        ∑ v : Fin limit, charge row v := by
      apply sum_congr rfl
      intro v _
      simp only [charge, Fin.val_ne_iff]
    rw [sumEq, block_sum]
    exact cost

end PackedRows

