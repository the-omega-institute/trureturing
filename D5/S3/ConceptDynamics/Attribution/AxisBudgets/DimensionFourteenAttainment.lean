private def readCodes (blocks : Nat → Nat) (vertex : Nat) : List Nat :=
  let packed := blocks (vertex / 64)
  let record := packed >>> (15 * (vertex % 64))
  (List.range 3).map fun slot => (record >>> (5 * slot)) &&& 31

private def forwardSkip (v : Nat) : Nat :=
  if v == 15 then 63 else if v == 255 then 1023 else limit

private def backwardSkip (v : Nat) : Nat :=
  if v == 63 then 15 else if v == 1023 then 255 else limit

private def row (vertex : Nat) : List Nat :=
  if vertex == top then [0, 1024]
  else (readCodes rows vertex).filterMap fun value =>
    if value == 0 then some vertex
    else if value ≤ 15 then some (vertex ||| (1 <<< (value - 1)))
    else if value == 16 then some (forwardSkip vertex)
    else none

private def col (vertex : Nat) : List Nat :=
  (readCodes columns vertex).filterMap fun value =>
    if value == 0 then some vertex
    else if value ≤ 15 then some (vertex ^^^ (1 <<< (value - 1)))
    else if value == 16 then some (backwardSkip vertex)
    else if value == 17 then some top
    else none

private def blockPass (b : Nat) : Bool :=
  if h : b < 128 then PackedRows.blockPass row col ⟨b, h⟩ else false

private def chunkPass (test : Nat → Bool) (chunk : Fin 16) : Bool :=
  (List.range 8).all fun i => test (8 * chunk.val + i)

private theorem assemble_checks (test : Nat → Bool)
    (checked : ∀ chunk, chunkPass test chunk = true) :
    ∀ b : Fin 128, test b.val = true := by
  intro b
  let chunk : Fin 16 := ⟨b.val / 8, by omega⟩
  have pos : b.val % 8 ∈ List.range 8 := List.mem_range.mpr (Nat.mod_lt _ (by decide))
  have h := List.all_eq_true.mp (checked chunk) _ pos
  have divmod : 8 * chunk.val + b.val % 8 = b.val := Nat.div_add_mod _ _
  simpa only [divmod] using h

private def blockCharge (row : Nat → List Nat) (b : Nat) : Nat :=
  ((List.range 64).map fun v => PackedRows.charge row (64 * b + v)).sum

private def chunkCharge (row : Nat → List Nat) (c : Fin 16) : Nat :=
  ((List.range 8).map fun i => blockCharge row (8 * c.val + i)).sum

private theorem assemble_cost (row : Nat → List Nat) :
    ((List.range 128).map (blockCharge row)).sum = ∑ c : Fin 16, chunkCharge row c := by
  have chunks : (∑ c : Fin 16, chunkCharge row c) =
      ∑ c ∈ range 16, ((List.range 8).map fun i => blockCharge row (8 * c + i)).sum :=
    Fin.sum_univ_eq_sum_range (fun c => ((List.range 8).map fun i =>
      blockCharge row (8 * c + i)).sum) 16
  rw [← List.sum_toFinset _ List.nodup_range, List.toFinset_range,
    show (128 : Nat) = 16 * 8 by decide,
    D5.S1.Words.TwoBlockSubstitution.ThueMorseFrequency.sum_blocks, chunks]
  apply sum_congr rfl
  intro c _
  rw [← List.sum_toFinset _ List.nodup_range, List.toFinset_range, Nat.mul_comm c 8]

