import D5.S1.Eigenstructure.UnitJordanDrift
import Mathlib.LinearAlgebra.Charpoly.Basic
import Mathlib.RepresentationTheory.Equiv

/- Library-search audit trail (2026-08-26):
   * Repository searches found no theorem combining the two generator minimal
     polynomials, non-conjugacy, and the common pair of trivial graded factors.
   * `UnitJordanDrift.unitJordanStep` is the canonical existing additive action and
     is reused as the function underlying the linear endomorphism below.
   * Pinned Mathlib supplies `minpoly.eq_X_sub_C'` and
     `minpoly.eq_of_linearIndependent`; it has no exact unit-Jordan theorem.
   * Loogle and LeanSearch executables were unavailable in this worker image. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.Representation.UnitJordanRepresentationSeparation

open D5.S1.Eigenstructure.UnitJordanDrift
open Polynomial

/-- The source unit-Jordan generator, bundled linearly without replacing the
canonical additive action. -/
def unitJordanEnd (K : Type*) [Field K] : Module.End K (K × K) where
  toFun := unitJordanStep
  map_add' left right := by
    ext <;> simp [unitJordanStep, add_left_comm, add_comm]
  map_smul' scalar value := by
    ext <;> simp [unitJordanStep, mul_add]

/-- The invertible source generator with inverse unit-Jordan drift. -/
def unitJordanEquiv (K : Type*) [Field K] : (K × K) ≃ₗ[K] (K × K) where
  toFun := unitJordanStep
  invFun value := (value.1 - value.2, value.2)
  left_inv value := by
    rcases value with ⟨x, y⟩
    simp [unitJordanStep]
  right_inv value := by
    rcases value with ⟨x, y⟩
    simp [unitJordanStep]
  map_add' left right := by
    exact (unitJordanEnd K).map_add left right
  map_smul' scalar value := by
    exact (unitJordanEnd K).map_smul scalar value

/-- The representation of the additive integers generated by the source
unit-Jordan action. -/
def unitJordanRepresentation (K : Type*) [Field K] :
    Representation K (Multiplicative ℤ) (K × K) where
  toFun exponent := ((zpowersHom _ (unitJordanEquiv K)) exponent).toLinearMap
  map_one' := by
    apply LinearMap.ext
    intro value
    simp
  map_mul' left right := by
    apply LinearMap.ext
    intro value
    simp [zpow_add]

/-- The identity and unit-Jordan actions have different minimal polynomials and
cannot be intertwined by a linear equivalence.  Nevertheless, the action induced
on the invariant first-coordinate line and on its second-coordinate quotient is
trivial in both cases, so both associated graded actions are `1 + 1`. -/
theorem unit_jordan_representation_separation (K : Type*) [Field K] :
    let identity : Module.End K (K × K) := LinearMap.id
    let jordan := unitJordanEnd K
    let nilpart := jordan - identity
    minpoly K identity = X - C 1 ∧
      nilpart ≠ 0 ∧
      nilpart * nilpart = 0 ∧
      minpoly K jordan = (X - C 1) ^ 2 ∧
      (¬ ∃ e : (K × K) ≃ₗ[K] (K × K),
        e.toLinearMap.comp identity = jordan.comp e.toLinearMap) ∧
      (∀ _ : (Representation.trivial K (Multiplicative ℤ) (K × K)).Equiv
        (unitJordanRepresentation K), False) ∧
      (fun value : K × K =>
          ((identity (value.1, 0)).1, (identity (0, value.2)).2)) = identity ∧
      (fun value : K × K =>
          ((jordan (value.1, 0)).1, (jordan (0, value.2)).2)) = identity := by
  dsimp only
  have identityMinpoly :
      minpoly K (LinearMap.id : Module.End K (K × K)) = X - C 1 := by
    rw [show (LinearMap.id : Module.End K (K × K)) =
        algebraMap K (Module.End K (K × K)) 1 by
      apply LinearMap.ext
      intro value
      simp]
    exact minpoly.eq_X_sub_C_of_algebraMap_inj
      (B := Module.End K (K × K)) (1 : K) (algebraMap K _).injective
  have nilpartNe :
      unitJordanEnd K - (LinearMap.id : Module.End K (K × K)) ≠ 0 := by
    intro nilpartZero
    have atSecond := LinearMap.congr_fun nilpartZero (0, 1)
    have atFirst := congrArg Prod.fst atSecond
    simp [unitJordanEnd, unitJordanStep] at atFirst
  have nilpartSquare :
      (unitJordanEnd K - (LinearMap.id : Module.End K (K × K))) *
          (unitJordanEnd K - (LinearMap.id : Module.End K (K × K))) = 0 := by
    apply LinearMap.ext
    rintro ⟨x, y⟩
    ext <;> simp [unitJordanEnd, unitJordanStep]
  have jordanMinpoly :
      minpoly K (unitJordanEnd K) = (X - C 1) ^ 2 := by
    refine minpoly.eq_of_linearIndependent K (unitJordanEnd K)
      ((monic_X_sub_C 1).pow 2) ?_ 2 ?_ ?_
    · simp only [map_pow, map_sub, aeval_X, map_one]
      simpa [pow_two, show (1 : Module.End K (K × K)) = LinearMap.id by
        apply LinearMap.ext
        intro value
        simp] using nilpartSquare
    · rw [degree_pow, degree_X_sub_C]
      norm_num
    · rw [Fintype.linearIndependent_iff]
      intro coefficient sumZero index
      have coefficientOne : coefficient 1 = 0 := by
        have atFirst := congrArg
          (fun action : Module.End K (K × K) => (action (0, 1)).1) sumZero
        simpa [Fin.sum_univ_two, unitJordanEnd, unitJordanStep] using atFirst
      have coefficientZero : coefficient 0 = 0 := by
        have atSecond := congrArg
          (fun action : Module.End K (K × K) => (action (0, 1)).2) sumZero
        simpa [Fin.sum_univ_two, unitJordanEnd, unitJordanStep, coefficientOne] using atSecond
      fin_cases index
      · exact coefficientZero
      · exact coefficientOne
  have noGeneratorEquivalence :
      ¬ ∃ equivalence : (K × K) ≃ₗ[K] (K × K),
        equivalence.toLinearMap.comp LinearMap.id =
          (unitJordanEnd K).comp equivalence.toLinearMap := by
    rintro ⟨equivalence, intertwines⟩
    have atPreimage := LinearMap.congr_fun intertwines (equivalence.symm (0, 1))
    have atFirst := congrArg Prod.fst atPreimage
    simp [unitJordanEnd, unitJordanStep] at atFirst
  have noRepresentationEquivalence :
      ∀ _ : (Representation.trivial K (Multiplicative ℤ) (K × K)).Equiv
        (unitJordanRepresentation K), False := by
    intro equivalence
    apply noGeneratorEquivalence
    refine ⟨equivalence.toLinearEquiv, ?_⟩
    simpa [unitJordanRepresentation, unitJordanEquiv, unitJordanEnd] using
      equivalence.isIntertwining' (Multiplicative.ofAdd 1)
  refine ⟨identityMinpoly, nilpartNe, nilpartSquare, jordanMinpoly,
    noGeneratorEquivalence, noRepresentationEquivalence, ?_, ?_⟩
  · funext value
    ext <;> simp
  · funext value
    ext <;> simp [unitJordanEnd, unitJordanStep]

#print axioms unit_jordan_representation_separation

end D5.S3.ConceptDynamics.Representation.UnitJordanRepresentationSeparation
