   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Static embedding, feedback witness, and no-feedback boundary cover edge cases. -/
/- Library-search audit trail (2026-08-29): searched `ProbabilityTheory.Kernel`, `PMF`,
   `Finset.prod`, `Fin`, and `List` in D5 and pinned Mathlib. `PMF.bind`, `PMF.map`,
   `PMF.pure_bind`, and `PMF.bind_const` provide the finite sequential law semantics;
   `Fin` indexes both the finite horizon and exact-length histories. `Finset.prod`, `List`,
   and measurable kernels are unnecessary here. Repository searches found no longitudinal
   policy definitions. `SoftInterventionModularity` has homogeneous DAG-node kernels,
   while `ThreeLayerCausalObservationLanguage` has action-indexed law profiles; neither
   exposes the heterogeneous temporal history or sequential sampler required here. -/

import Mathlib.Probability.ProbabilityMassFunction.Constructions
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.LongitudinalCausal.LongitudinalStructuralCausalModel

noncomputable section

universe uL uA uY

/-- The time-indexed history: exactly `t` completed pairs and the current observed state. -/
structure History (t : Nat) (L : Type uL) (A : Type uA) where
  past : Fin t → L × A
  current : L

namespace History

/-- Start a history at its initial observed state, before any action. -/
def start {L : Type uL} {A : Type uA} (state : L) : History 0 L A :=
  ⟨Fin.elim0, state⟩

/-- Append the selected action and expose the next observed state. -/
def extend {t : Nat} {L : Type uL} {A : Type uA}
    (history : History t L A) (action : A) (nextState : L) : History (t + 1) L A :=
  ⟨Fin.lastCases (history.current, action) history.past, nextState⟩

end History

/- Definition 296.1: a stochastic action rule at every time, conditional on history. -/
def dynamicPolicy (T : Nat) (L : Type uL) (A : Type uA) :=
  (time : Fin (T + 1)) → History time.val L A → PMF A

/-- The state-transition mechanisms retained by a policy intervention. -/
def transitionMechanism (T : Nat) (L : Type uL) (A : Type uA) :=
  (time : Fin (T + 1)) → History time.val L A → A → PMF L

/-- A finite-horizon longitudinal structural causal model. -/
structure LongitudinalSCM
    (T : Nat) (L : Type uL) (A : Type uA) (Y : Type uY) where
  initial : PMF L
  behavior : dynamicPolicy T L A
  transition : transitionMechanism T L A
  outcome : History (T + 1) L A → Y

/- Definition 296.2: replace behavior assignment and preserve the transition mechanism. -/
def policyIntervention {T : Nat} {L : Type uL} {A : Type uA} {Y : Type uY}
    (model : LongitudinalSCM T L A Y) (policy : dynamicPolicy T L A) :
    LongitudinalSCM T L A Y :=
  { model with behavior := policy }

/-- Run the first `steps` action-transition pairs of a longitudinal model. -/
private def runSteps {T : Nat} {L : Type uL} {A : Type uA} {Y : Type uY}
    (model : LongitudinalSCM T L A Y) :
    (steps : Nat) → steps ≤ T + 1 → PMF (History steps L A)
  | 0, _ => model.initial.map fun state => History.start (A := A) state
  | steps + 1, bound =>
      let time : Fin (T + 1) := ⟨steps, Nat.lt_of_succ_le bound⟩
      (runSteps model steps (Nat.le_trans (Nat.le_succ steps) bound)).bind fun history =>
        (model.behavior time history).bind fun action =>
          (model.transition time history action).map fun nextState =>
            history.extend action nextState

/- Definition 296.3: the final-result distribution generated by the entire policy. -/
def policyResult {T : Nat} {L : Type uL} {A : Type uA} {Y : Type uY}
    (model : LongitudinalSCM T L A Y) (policy : dynamicPolicy T L A) : PMF Y :=
  (runSteps (policyIntervention model policy) (T + 1) (by rfl)).map model.outcome

/-- Embed a static `do(A = x)` as the constant policy on the one-point time axis. -/
def staticPolicyEmbedding {L : Type uL} {A : Type uA} (action : A) :
    dynamicPolicy 0 L A :=
  fun _ _ => PMF.pure action

/-- The direct one-step result law under the static intervention `do(A = x)`. -/
def staticInterventionResult {L : Type uL} {A : Type uA} {Y : Type uY}
    (model : LongitudinalSCM 0 L A Y) (action : A) : PMF Y :=
  model.initial.bind fun state =>
    (model.transition 0 (History.start (A := A) state) action).map fun nextState =>
      model.outcome ((History.start (A := A) state).extend action nextState)

/-- A static intervention and its constant length-one dynamic policy have the same law. -/
theorem static_intervention_is_length_one
    {L : Type uL} {A : Type uA} {Y : Type uY}
    (model : LongitudinalSCM 0 L A Y) (action : A) :
    policyResult model (staticPolicyEmbedding action) =
      staticInterventionResult model action := by
  simp [policyResult, runSteps, policyIntervention, staticPolicyEmbedding,
    staticInterventionResult, History.start, History.extend, PMF.map_bind, PMF.map_comp,
    Function.comp_def]

#print axioms static_intervention_is_length_one

/-- Both state transitions in the feedback witness copy the selected action. -/
private def feedbackTransition : transitionMechanism 1 Bool Bool :=
  fun _ _ action => PMF.pure action

/-- The second action reads the covariate produced by the first action. -/
private def feedbackPolicy : dynamicPolicy 1 Bool Bool :=
  fun time history => if time = 0 then PMF.pure true else PMF.pure history.current

/-- The static calculation fixes the second action before observing the updated covariate. -/
private def feedbackIgnoringPolicy : dynamicPolicy 1 Bool Bool :=
  fun time _ => if time = 0 then PMF.pure true else PMF.pure false

/-- The two-step structural model used to expose the feedback discrepancy. -/
private def feedbackModel : LongitudinalSCM 1 Bool Bool Bool where
  initial := PMF.pure false
  behavior := feedbackIgnoringPolicy
  transition := feedbackTransition
  outcome := History.current

/-- The distribution returned by the feedback-ignoring static calculation. -/
private def feedbackIgnoringStaticResult : PMF Bool :=
  PMF.pure false

/-- In two steps, action-to-state feedback changes the result law from false to true. -/
theorem feedback_is_necessary :
    let initialHistory : History 0 Bool Bool := History.start false
    let falseHistory := initialHistory.extend false false
    let trueHistory := initialHistory.extend true true
    feedbackTransition 0 initialHistory false = PMF.pure false ∧
      feedbackTransition 0 initialHistory true = PMF.pure true ∧
      feedbackPolicy 1 falseHistory = PMF.pure false ∧
      feedbackPolicy 1 trueHistory = PMF.pure true ∧
      policyResult feedbackModel feedbackPolicy = PMF.pure true ∧
      policyResult feedbackModel feedbackIgnoringPolicy = feedbackIgnoringStaticResult ∧
      policyResult feedbackModel feedbackPolicy ≠ feedbackIgnoringStaticResult := by
  dsimp
  have dynamicLaw : policyResult feedbackModel feedbackPolicy = PMF.pure true := by
    simp [policyResult, runSteps, policyIntervention, feedbackModel, feedbackPolicy,
      feedbackTransition, History.start, History.extend, PMF.pure_map]
  have staticLaw :
      policyResult feedbackModel feedbackIgnoringPolicy = feedbackIgnoringStaticResult := by
    simp [policyResult, runSteps, policyIntervention, feedbackModel, feedbackIgnoringPolicy,
      feedbackTransition, feedbackIgnoringStaticResult, History.start, History.extend,
      PMF.pure_map]
  refine ⟨rfl, rfl, by simp [feedbackPolicy, History.start, History.extend],
    by simp [feedbackPolicy, History.start, History.extend], dynamicLaw, staticLaw, ?_⟩
  intro equalLaws
  have equalMass := congrArg (fun law : PMF Bool => law true) equalLaws
  rw [dynamicLaw] at equalMass
  simp [feedbackIgnoringStaticResult, PMF.pure_apply] at equalMass

#print axioms feedback_is_necessary

/-- Removing the action-to-state link gives a matched model with no feedback. -/
private def noFeedbackModel : LongitudinalSCM 1 Bool Bool Bool where
  initial := PMF.pure false
  behavior := feedbackIgnoringPolicy
  transition := fun _ _ _ => PMF.pure false
  outcome := History.current

/-- Without action-to-state feedback, dynamic and feedback-ignoring policies agree. -/
theorem no_feedback_static_dynamic_agree :
    policyResult noFeedbackModel feedbackPolicy =
      policyResult noFeedbackModel feedbackIgnoringPolicy := by
  simp [policyResult, runSteps, policyIntervention, noFeedbackModel, feedbackPolicy,
    feedbackIgnoringPolicy, History.start, History.extend, PMF.map_comp, Function.comp_def]

#print axioms no_feedback_static_dynamic_agree

/- Degenerate audits: constant policies, `T = 0`, singleton types, trivial maps,
   the matched no-feedback structure above, and an empty action type. -/
example {L : Type uL} {A : Type uA} (action : A) (history : History 0 L A) :
    staticPolicyEmbedding action 0 history = PMF.pure action := by
  rfl

example {t : Nat} {L : Type uL} {A : Type uA} (history : History t L A)
    (action : A) (nextState : L) :
    (history.extend action nextState).current = nextState := by
  rfl

example :
    let model : LongitudinalSCM 0 Unit Unit Unit :=
      { initial := PMF.pure ()
        behavior := staticPolicyEmbedding ()
        transition := fun _ _ _ => PMF.pure ()
        outcome := fun _ => () }
    policyResult model (staticPolicyEmbedding ()) = PMF.pure () := by
  simp [policyResult, runSteps, policyIntervention, staticPolicyEmbedding,
    History.start, History.extend, PMF.pure_map]

example : ¬ Nonempty (dynamicPolicy 0 Unit (Fin 0)) := by
  rintro ⟨policy⟩
  let law : PMF (Fin 0) := policy 0 (History.start (A := Fin 0) ())
  rcases law.support_nonempty with ⟨action, _⟩
  exact Fin.elim0 action

end


end D5.S3.ConceptDynamics.LongitudinalCausal.LongitudinalStructuralCausalModel
