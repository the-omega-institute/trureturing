/- GID: D5/S3/ConceptDynamics/GraphIrregularity/RegularLinkIrregularEleven
   generality: G
   mirror-B: D5/B/S3/ConceptDynamics/GraphIrregularity/RegularLinkIrregularEleven
   mirror-E: none(waiver:formal-unit-only)
   anchors: []
   utility: kind=certified-instance; basis=refutes=gid:D5/S3/ConceptDynamics/GraphIrregularity/RegularLinkIrregularEleven.regularLinkIrregularOnlyFromTwelve; result=D5/S3/ConceptDynamics/GraphIrregularity/RegularLinkIrregularEleven.not_regularLinkIrregularOnlyFromTwelve; claim=D5/S3/ConceptDynamics/GraphIrregularity/RegularLinkIrregularEleven.regularLinkIrregularOnlyFromTwelve
   digest: An explicit six-regular graph on eleven vertices has pairwise non-isomorphic links. -/

import Mathlib.Combinatorics.SimpleGraph.Finite

set_option autoImplicit false

namespace D5.S3.ConceptDynamics.GraphIrregularity.RegularLinkIrregularEleven

/-- One round of degree refinement, with multiplicities retained at both levels. -/
def wlProfile {W : Type*} [Fintype W] [DecidableEq W]
    (H : SimpleGraph W) [DecidableRel H.Adj] : Multiset (Nat × Multiset Nat) :=
  (Finset.univ : Finset W).val.map fun x =>
    (H.degree x, (H.neighborFinset x).val.map (fun y => H.degree y))

/-- The refined profile of a link, computed entirely in the ambient vertex type. -/
def finsetLinkProfile {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) : Multiset (Nat × Multiset Nat) :=
  (G.neighborFinset v).val.map fun x =>
    ((G.neighborFinset v ∩ G.neighborFinset x).card,
      (G.neighborFinset v ∩ G.neighborFinset x).val.map fun y =>
        (G.neighborFinset v ∩ G.neighborFinset y).card)

/-- Isomorphisms preserve the refined profile of every finite graph. -/
theorem wlProfile_eq_of_iso {W W' : Type*}
    [Fintype W] [DecidableEq W] [Fintype W'] [DecidableEq W']
    {H : SimpleGraph W} {H' : SimpleGraph W'}
    [DecidableRel H.Adj] [DecidableRel H'.Adj] (f : H ≃g H') :
    wlProfile H = wlProfile H' := by
  have hn (x : W) :
      (H.neighborFinset x).val.map (fun y => H.degree y) =
        (H'.neighborFinset (f x)).val.map (fun y => H'.degree y) := by
    simp only [SimpleGraph.neighborFinset, Set.toFinset, Finset.map_val, Multiset.map_map]
    rw [← Multiset.map_univ_val_equiv (f.mapNeighborSet x), Multiset.map_map]
    apply Multiset.map_congr rfl
    intro y _
    exact (f.degree_eq y.val).symm
  unfold wlProfile
  rw [← Multiset.map_univ_val_equiv f.toEquiv, Multiset.map_map]
  apply Multiset.map_congr rfl
  intro x _
  exact Prod.ext (f.degree_eq x).symm (hn x)

/-- Link degrees are cardinalities of intersections of ambient neighbor finsets. -/
theorem link_degree_eq {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) (x : G.neighborSet v) :
    (G.induce (G.neighborSet v)).degree x =
      (G.neighborFinset v ∩ G.neighborFinset x.val).card := by
  have h := G.map_neighborFinset_induce x
  rw [← G.neighborFinset_def, Finset.inter_comm] at h
  simpa only [Finset.card_map, SimpleGraph.card_neighborFinset_eq_degree] using
    congrArg Finset.card h

/-- The induced link has exactly the profile computed in the ambient graph. -/
theorem wlProfile_induce_eq_finsetLinkProfile {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (v : V) :
    wlProfile (G.induce (G.neighborSet v)) = finsetLinkProfile G v := by
  have hn (x : G.neighborSet v) :
      ((G.induce (G.neighborSet v)).neighborFinset x).val.map
          (fun y => (G.induce (G.neighborSet v)).degree y) =
        (G.neighborFinset v ∩ G.neighborFinset x.val).val.map
          (fun y => (G.neighborFinset v ∩ G.neighborFinset y).card) := by
    simp_rw [link_degree_eq]
    have h := G.map_neighborFinset_induce x
    rw [← G.neighborFinset_def, Finset.inter_comm] at h
    have hm := congrArg (fun s : Finset V =>
      s.val.map (fun y => (G.neighborFinset v ∩ G.neighborFinset y).card)) h
    simpa only [Finset.map_val, Multiset.map_map, Function.comp_apply,
      Function.Embedding.coe_subtype] using hm
  unfold wlProfile finsetLinkProfile
  simp_rw [hn, link_degree_eq]
  change _ = ((Finset.univ : Finset (G.neighborSet v)).val.map Subtype.val).map _
  simp only [Multiset.map_map, Function.comp_apply]

/-- Each edge is listed once, with its smaller endpoint first. -/
private def witnessEdges : List (Fin 11 × Fin 11) :=
  [(0, 2),
   (0, 4),
   (0, 5),
   (0, 8),
   (0, 9),
   (0, 10),
   (1, 2),
   (1, 3),
   (1, 5),
   (1, 7),
   (1, 8),
   (1, 10),
   (2, 4),
   (2, 5),
   (2, 9),
   (2, 10),
   (3, 6),
   (3, 7),
   (3, 8),
   (3, 9),
   (3, 10),
   (4, 5),
   (4, 6),
   (4, 7),
   (4, 9),
   (5, 6),
   (5, 8),
   (6, 8),
   (6, 9),
   (6, 10),
   (7, 8),
   (7, 9),
   (7, 10)]

/-- The undirected, loopless graph generated by the thirty-three listed edges.
The order-eleven fact is not new: Jannis Harder reported a six-regular
link-irregular graph of order eleven on 14 December 2025, in the discussion
thread attached to David Eppstein's post "Regular link-irregular graphs", and
on 15 December 2025 reported an exhaustive search over all six-regular graphs
on eleven vertices yielding four minimal counterexamples. This witness has the
structure described there and was reported isomorphic to the published one.
See `Library/ConceptDynamics/harder2025linkirregular.md`. -/
def witnessGraph : SimpleGraph (Fin 11) :=
  SimpleGraph.fromRel fun u v => (u, v) ∈ witnessEdges

instance : DecidableRel witnessGraph.Adj := inferInstanceAs
  (DecidableRel (SimpleGraph.fromRel fun u v => (u, v) ∈ witnessEdges).Adj)

/-- The computable link profile of the eleven-vertex witness. -/
def linkProfile (v : Fin 11) : Multiset (Nat × Multiset Nat) :=
  finsetLinkProfile witnessGraph v


/-- Every vertex of the witness has degree six. -/
theorem witness_regular : witnessGraph.IsRegularOfDegree 6 := by
  unfold SimpleGraph.IsRegularOfDegree
  decide

/-- All eleven link profiles are distinct, certified by kernel reduction. -/
theorem witness_profiles_pairwise_ne :
    ∀ u v : Fin 11, u ≠ v → linkProfile u ≠ linkProfile v := by decide +kernel

/-- Distinct vertices have non-isomorphic induced neighborhoods. -/
def LinkIrregular {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] : Prop :=
  ∀ u v : V, u ≠ v →
    IsEmpty (G.induce (G.neighborSet u) ≃g G.induce (G.neighborSet v))

/-- The only-if direction of Bastien and Khormali, Conjecture 17, taken over the
orders on which link-irregularity is not vacuous. On `Fin 0` and `Fin 1` there are
no two distinct vertices, so every graph there is regular and link-irregular and
the sentence fails for a reason unrelated to the conjecture; `2 ≤ n` removes
exactly those two orders and leaves the mathematical content intact. -/
def regularLinkIrregularOnlyFromTwelve : Prop :=
  open scoped Classical in
  ∀ (n : Nat) (G : SimpleGraph (Fin n)) (r : Nat),
    2 ≤ n → G.IsRegularOfDegree r → LinkIrregular G → 12 ≤ n

/-- The explicit six-regular graph on eleven vertices is link-irregular. -/
theorem witness_link_irregular : LinkIrregular witnessGraph := by
  intro u v huv
  refine ⟨fun f => witness_profiles_pairwise_ne u v huv ?_⟩
  exact (wlProfile_induce_eq_finsetLinkProfile witnessGraph u).symm.trans
    ((wlProfile_eq_of_iso f).trans (wlProfile_induce_eq_finsetLinkProfile witnessGraph v))

/-- Eleven vertices refute the asserted lower bound of twelve. -/
theorem not_regularLinkIrregularOnlyFromTwelve :
    Not regularLinkIrregularOnlyFromTwelve := by
  intro h
  apply (by decide : ¬ 12 ≤ 11)
  apply h 11 witnessGraph 6 (by decide)
  · convert witness_regular using 1
  · exact witness_link_irregular

#print axioms wlProfile_eq_of_iso
#print axioms link_degree_eq
#print axioms wlProfile_induce_eq_finsetLinkProfile
#print axioms witness_regular
#print axioms witness_profiles_pairwise_ne
#print axioms witness_link_irregular
#print axioms not_regularLinkIrregularOnlyFromTwelve

end D5.S3.ConceptDynamics.GraphIrregularity.RegularLinkIrregularEleven
