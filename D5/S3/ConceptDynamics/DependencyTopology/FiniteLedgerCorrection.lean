/- GID: D5/S3/ConceptDynamics/DependencyTopology/FiniteLedgerCorrection
   generality: G
   mirror-B: D5/B/S3/ConceptDynamics/DependencyTopology/FiniteLedgerCorrection
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Admissible legal ledgers admit at most two delayed corrections per proposition. -/

import D5.S3.ConceptDynamics.DependencyTopology.LegalLedgerFixedSet
import D5.S3.ConceptDynamics.Termination.FiniteDefectTermination
import D5.S0.History.LedgerLimit
import Mathlib.Topology.Algebra.InfiniteSum.NatInt

/-! Exact delayed corrections, actual finite event support and append-only claim records. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.DependencyTopology.FiniteLedgerCorrection

open LegalLedgerFixedSet
open scoped BigOperators

noncomputable section
attribute [local instance] Classical.propDecidable

universe u v w x

/-- Three ledger states and the extra label allowed on a claim. -/
inductive Label where
  | frozen | refuted | open | unverified
  deriving DecidableEq

variable {P : Type u} {Proof : Type v} {Ax : Type w} {Model : Type x}
variable {k : KernelData P Proof Ax Model}

/-- The actual core readout; unverified is never a ledger state. -/
noncomputable def state (L : LegalLedger k) (p : P) : Label := by
  classical
  exact if p ∈ Frozen L then .frozen else if k.neg p ∈ Frozen L then .refuted else .open

/-- A chain generated by total admissible maps, retaining nodes, edges and witnesses. -/
structure Chain (k : KernelData P Proof Ax Model) where
  ledger : ℕ → LegalLedger k
  step : ℕ → LegalLedger k → LegalLedger k
  admissible : ∀ t, Admissible (step t)
  next : ∀ t, ledger (t + 1) = step t (ledger t)

/-- The source consistency assumption alone, without soundness or certificate existence. -/
def Consistent (k : KernelData P Proof Ax Model) : Prop :=
  ∀ p, ¬ (Proved k p ∧ Proved k (k.neg p))

variable (chain : Chain k)

/-- The exact delayed policy: correct a nonempty subset of the current mismatches. -/
structure Policy (D : Finset P) where
  claim : ℕ → D → Label
  selected : ℕ → Finset D
  mismatch_only : ∀ t p, p ∈ selected t → claim t p ≠ state (chain.ledger t) p.val
  progress : ∀ t, (∃ p, claim t p ≠ state (chain.ledger t) p.val) →
    (selected t).Nonempty
  update : ∀ t p, claim (t + 1) p =
    if p ∈ selected t then state (chain.ledger t) p.val else claim t p

variable {chain} {D : Finset P} (policy : Policy chain D)

def mismatches (t : ℕ) : Set D :=
  {p | policy.claim t p ≠ state (chain.ledger t) p.val}

def changes (p : P) : Set ℕ :=
  {t | state (chain.ledger (t + 1)) p ≠ state (chain.ledger t) p}

def corrections (p : D) : Set ℕ := {t | p ∈ policy.selected t}

def events : Set (ℕ × D) := {e | e.2 ∈ policy.selected e.1}

private theorem nodes_mono {a b : ℕ} (hab : a ≤ b) {p : P}
    (hp : p ∈ Frozen (chain.ledger a)) : p ∈ Frozen (chain.ledger b) := by
  induction b, hab using Nat.le_induction with
  | base => exact hp
  | succ b hab ih =>
    rw [chain.next]
    exact (chain.admissible b (chain.ledger b)).1 p ih

private theorem terminal_persistent (consistent : Consistent k) {p : P} {a b : ℕ}
    (hab : a ≤ b) (ha : state (chain.ledger a) p ≠ .open) :
    state (chain.ledger b) p = state (chain.ledger a) p := by
  classical
  by_cases hp : p ∈ Frozen (chain.ledger a)
  · have hp' := nodes_mono hab hp
    simp [state, hp, hp']
  · have hn : k.neg p ∈ Frozen (chain.ledger a) := by
      by_contra hn
      exact ha (by simp [state, hp, hn])
    have hn' := nodes_mono hab hn
    have hp' : p ∉ Frozen (chain.ledger b) := by
      intro h
      exact consistent p ⟨frozen_proved _ h, frozen_proved _ hn'⟩
    simp [state, hp, hn, hp', hn']

private theorem interval_constant (consistent : Consistent k) {p : P} {a b : ℕ}
    (_hab : a ≤ b) (heq : state (chain.ledger a) p = state (chain.ledger b) p) :
    ∀ t, a ≤ t → t ≤ b → state (chain.ledger t) p = state (chain.ledger a) p := by
  intro t hat htb
  by_cases ha : state (chain.ledger a) p = .open
  · by_contra ht
    have htn : state (chain.ledger t) p ≠ .open := by simpa [ha] using ht
    have := terminal_persistent consistent htb htn
    exact htn (this.symm.trans (heq.symm.trans ha))
  · exact terminal_persistent consistent hat ha

private theorem changes_subsingleton (consistent : Consistent k) (p : P) :
    (changes (chain := chain) p).Subsingleton := by
  have later : ∀ a b, a < b → a ∈ changes (chain := chain) p →
      b ∉ changes (chain := chain) p := by
    intro a b hab ha hb
    have terminal : state (chain.ledger (a + 1)) p ≠ .open := by
      intro h
      by_cases ho : state (chain.ledger a) p = .open
      · exact ha (h.trans ho.symm)
      · exact ha (terminal_persistent consistent (Nat.le_succ a) ho)
    have h₁ := terminal_persistent consistent (show a + 1 ≤ b by omega) terminal
    have h₂ := terminal_persistent consistent (show a + 1 ≤ b + 1 by omega) terminal
    exact hb (h₂.trans h₁.symm)
  intro a ha b hb
  rcases lt_trichotomy a b with h | h | h
  · exact (later a b h ha hb).elim
  · exact h
  · exact (later b a h hb ha).elim

/-- Correcting an old readout and keeping that readout fixed prevents another correction. -/
private theorem corrected_on_constant_interval {p : D} {a b : ℕ} (hab : a < b)
    (ha : p ∈ policy.selected a)
    (stable : ∀ t, a ≤ t → t ≤ b →
      state (chain.ledger t) p.val = state (chain.ledger a) p.val) :
    policy.claim b p = state (chain.ledger a) p.val := by
  have base : policy.claim (a + 1) p = state (chain.ledger a) p.val := by
    rw [policy.update, ite_eq_left ha]
  have all : ∀ t, a + 1 ≤ t → t ≤ b →
      policy.claim t p = state (chain.ledger a) p.val := by
    intro t ht
    induction t, ht using Nat.le_induction with
    | base => exact fun _ => base
    | succ t ht ih =>
      intro htb
      rw [policy.update]
      split_ifs with hsel
      · exact stable t (by omega) (by omega)
      · exact ih (by omega)
  exact all b hab le_rfl

/-- Two actual corrections force an actual intervening core-readout change. -/
private theorem corrections_force_change {p : D} {a b : ℕ}
    (hab : a < b) (ha : p ∈ policy.selected a) (hb : p ∈ policy.selected b) :
    ∃ t, a ≤ t ∧ t < b ∧ t ∈ changes (chain := chain) p.val := by
  by_contra h
  have stable : ∀ t, a ≤ t → t ≤ b →
      state (chain.ledger t) p.val = state (chain.ledger a) p.val := by
    intro t ht
    induction t, ht using Nat.le_induction with
    | base => exact fun _ => rfl
    | succ t ht ih =>
      intro htb
      have hstep : state (chain.ledger (t + 1)) p.val = state (chain.ledger t) p.val := by
        by_contra hc
        exact h ⟨t, ht, by omega, hc⟩
      exact hstep.trans (ih (by omega))
  exact policy.mismatch_only b p hb
    ((corrected_on_constant_interval policy hab ha stable).trans (stable b hab.le le_rfl).symm)

private theorem correction_phase_injective (consistent : Consistent k) (p : D) :
    Set.InjOn (fun t => decide (state (chain.ledger t) p.val = .open))
      (corrections policy p) := by
  classical
  have ordered : ∀ a b, a < b → a ∈ corrections policy p → b ∈ corrections policy p →
      decide (state (chain.ledger a) p.val = .open) ≠
        decide (state (chain.ledger b) p.val = .open) := by
    intro a b hab ha hb he
    have endpoints : state (chain.ledger a) p.val = state (chain.ledger b) p.val := by
      by_cases ho : state (chain.ledger a) p.val = .open
      · have hb' : state (chain.ledger b) p.val = .open := by simpa [ho] using he.symm
        exact ho.trans hb'.symm
      · exact (terminal_persistent consistent hab.le ho).symm
    obtain ⟨t, hat, htb, hc⟩ := corrections_force_change policy hab ha hb
    have stable := interval_constant consistent hab.le endpoints
    exact hc ((stable (t + 1) (by omega) (by omega)).trans
      (stable t hat htb.le).symm)
  intro a ha b hb he
  rcases lt_trichotomy a b with h | h | h
  · exact (ordered a b h ha hb he).elim
  · exact h
  · exact (ordered b a h hb ha he.symm).elim

private theorem finite_corrections (consistent : Consistent k) (p : D) :
    (corrections policy p).Finite :=
  Set.Finite.of_injOn (t := Set.univ) (fun _ _ => Set.mem_univ _)
    (correction_phase_injective policy consistent p) (Set.toFinite _)

private theorem event_injective (consistent : Consistent k) :
    Set.InjOn (fun e : ℕ × D => (e.2, decide (state (chain.ledger e.1) e.2.val = .open)))
      (events policy) := by
  rintro ⟨a,p⟩ ha ⟨b,q⟩ hb he
  obtain rfl : p = q := congrArg Prod.fst he
  exact Prod.ext (correction_phase_injective policy consistent p ha hb
    (congrArg Prod.snd he)) rfl

private theorem mismatch_step (T : ℕ)
    (stable : ∀ t, T ≤ t → ∀ p : D,
      state (chain.ledger t) p.val = state (chain.ledger T) p.val)
    {t : ℕ} (ht : T ≤ t) :
    mismatches policy (t + 1) = mismatches policy t \ ↑(policy.selected t) := by
  classical
  ext p
  simp only [mismatches, Set.mem_ofPred_eq, Set.mem_sdiff, Finset.mem_coe]
  rw [policy.update, stable (t + 1) (by omega), stable t ht]
  split_ifs with hs
  · simp [hs]
  · simp [hs]

private theorem quiet_after_stabilization (T : ℕ)
    (stable : ∀ t, T ≤ t → ∀ p : D,
      state (chain.ledger t) p.val = state (chain.ledger T) p.val) :
    ∃ stop, stop ≤ T + D.card ∧ ∀ t, stop ≤ t → mismatches policy t = ∅ := by
  classical
  have mono : ∀ n, mismatches policy (T + (n + 1)) ⊆ mismatches policy (T + n) := by
    intro n
    rw [show T + (n + 1) = (T + n) + 1 by omega, mismatch_step policy T stable (by omega)]
    exact Set.sdiff_subset
  have strict : ∀ n, mismatches policy (T + n) ≠ ∅ →
      mismatches policy (T + (n + 1)) ≠ mismatches policy (T + n) := by
    intro n hn he
    obtain ⟨p,hp⟩ := policy.progress (T + n) (Set.nonempty_iff_ne_empty.mpr hn)
    have hm := policy.mismatch_only (T + n) p hp
    have hm' : p ∈ mismatches policy (T + (n + 1)) := he.symm ▸ hm
    rw [show T + (n + 1) = (T + n) + 1 by omega,
      mismatch_step policy T stable (by omega)] at hm'
    exact hm'.2 hp
  obtain ⟨n,hn,hempty⟩ :=
    Termination.FiniteDefectTermination.finite_defect_repairs_terminate
      (fun n => mismatches policy (T + n)) strict mono
  have hc : (mismatches policy (T + 0)).ncard ≤ D.card := by
    simpa using Set.ncard_le_ncard (Set.subset_univ (mismatches policy (T + 0)))
  refine ⟨T + n, by omega, ?_⟩
  intro t ht
  induction t, ht using Nat.le_induction with
  | base => exact hempty
  | succ t ht ih =>
    rw [mismatch_step policy T stable (by omega), ih]
    exact Set.empty_sdiff _

private theorem ledger_stabilizes (consistent : Consistent k) :
    ∃ T, ∀ t, T ≤ t → ∀ p : D,
      state (chain.ledger t) p.val = state (chain.ledger T) p.val := by
  classical
  have each : ∀ p : D, ∃ T, ∀ t, T ≤ t →
      state (chain.ledger t) p.val = state (chain.ledger T) p.val := by
    intro p
    have hf := (changes_subsingleton (chain := chain) consistent p.val).finite
    have hf' : (D5.S0.History.LedgerLimit.revisionTimesFrom 0
        (fun t => state (chain.ledger t) p.val)).Finite := by
      simpa [D5.S0.History.LedgerLimit.revisionTimesFrom, changes] using hf
    obtain ⟨s,T,_,hs⟩ := D5.S0.History.LedgerLimit.finite_revisions_have_terminal_value
      0 (fun t => state (chain.ledger t) p.val) hf'
    exact ⟨T, fun t ht => (hs t ht).trans (hs T le_rfl).symm⟩
  choose cutoff hc using each
  let T := Finset.univ.sup cutoff
  have hT (p : D) : cutoff p ≤ T := Finset.le_sup (Finset.mem_univ p)
  exact ⟨T, fun t ht p => (hc p t ((hT p).trans ht)).trans (hc p T (hT p)).symm⟩

/-- One batch contains exactly one old-state claim for each selected proposition. -/
def batch (t : ℕ) : List (D × Label) :=
  (policy.selected t).toList.map fun p => (p, state (chain.ledger t) p.val)

/-- Claim records have increasing sequence positions and only grow at their tail. -/
def claimLog : ℕ → List (D × Label)
  | 0 => (Finset.univ : Finset D).toList.map fun p => (p, policy.claim 0 p)
  | t + 1 => claimLog t ++ batch policy t

/-- The last entry for a proposition, with unverified only as the absent-entry default. -/
def latest (U : List (D × Label)) (p : D) : Label :=
  U.foldl (fun s e => if e.1 = p then e.2 else s) .unverified

private theorem read_batch (l : List D) (f : D → Label) (p : D) (initial : Label) :
    (l.map fun q => (q, f q)).foldl
      (fun s e => if e.1 = p then e.2 else s) initial =
      if p ∈ l then f p else initial := by
  induction l generalizing initial with
  | nil => simp
  | cons q l ih =>
    simp only [List.map_cons, List.foldl_cons]
    rw [ih]
    by_cases hq : q = p
    · subst q; simp
    · simp [hq, Ne.symm hq]

private theorem latest_claim_log (t : ℕ) (p : D) :
    latest (claimLog policy t) p = policy.claim t p := by
  induction t with
  | zero => simp [claimLog, latest, read_batch]
  | succ t ih =>
    change ((claimLog policy t ++ batch policy t).foldl _ _) = _
    rw [List.foldl_append]
    change ((policy.selected t).toList.map _).foldl _ (latest (claimLog policy t) p) = _
    rw [read_batch, ih, policy.update]
    simp

private theorem total_eq_event_card (finiteEvents : (events policy).Finite) :
    (∑' t, (policy.selected t).card) = (events policy).ncard := by
  classical
  let E := finiteEvents.toFinset
  have fiber (t : ℕ) : (E.filter (fun e => e.1 = t)).card =
      (policy.selected t).card := by
    apply Finset.card_bij (fun e _ => e.2)
    · intro e he
      obtain ⟨he,het⟩ := Finset.mem_filter.mp he
      have hmem : e.2 ∈ policy.selected e.1 := finiteEvents.mem_toFinset.mp he
      simpa [het] using hmem
    · intro a ha b hb he
      exact Prod.ext ((Finset.mem_filter.mp ha).2.trans
        (Finset.mem_filter.mp hb).2.symm) he
    · intro p hp
      refine ⟨(t,p), Finset.mem_filter.mpr ⟨?_,rfl⟩,rfl⟩
      exact finiteEvents.mem_toFinset.mpr hp
  have support : ∀ t, t ∉ E.image Prod.fst → (policy.selected t).card = 0 := by
    intro t ht
    apply Finset.card_eq_zero.mpr
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro p hp
    exact ht (Finset.mem_image.mpr ⟨(t,p), finiteEvents.mem_toFinset.mpr hp,rfl⟩)
  rw [tsum_eq_sum support]
  rw [Set.ncard_eq_toFinset_card _ finiteEvents]
  change (∑ t ∈ E.image Prod.fst, (policy.selected t).card) = E.card
  rw [Finset.card_eq_sum_card_image Prod.fst E]
  exact Finset.sum_congr rfl (fun t _ => (fiber t).symm)

/-- Finite-domain quietness, total actual correction bounds, and append-only latest claims. -/
theorem finite_ledger_correction (consistent : Consistent k) :
    (∀ p : D, (changes (chain := chain) p.val).Subsingleton) ∧
    (∀ p : D, (corrections policy p).Finite ∧ (corrections policy p).ncard ≤ 2) ∧
    (events policy).Finite ∧
    (events policy).ncard = (∑' t, (policy.selected t).card) ∧
    (∑' t, (policy.selected t).card) ≤ 2 * D.card ∧
    (∃ T, ∀ t, T ≤ t → ∀ p : D,
      state (chain.ledger t) p.val = state (chain.ledger T) p.val) ∧
    (∀ T, (∀ t, T ≤ t → ∀ p : D,
      state (chain.ledger t) p.val = state (chain.ledger T) p.val) →
      ∃ stop, stop ≤ T + D.card ∧ ∀ t, stop ≤ t → mismatches policy t = ∅) ∧
    (∀ t p, latest (claimLog policy t) p = policy.claim t p) ∧
    (∀ t, claimLog policy (t + 1) = claimLog policy t ++ batch policy t ∧
      (batch policy t).length = (policy.selected t).card ∧
      ((batch policy t).map Prod.fst).Nodup ∧
      ∀ p s, (p,s) ∈ batch policy t ↔
        p ∈ policy.selected t ∧ s = state (chain.ledger t) p.val) := by
  classical
  have finiteEvents : (events policy).Finite :=
    Set.Finite.of_injOn (t := Set.univ) (fun _ _ => Set.mem_univ _)
      (event_injective policy consistent) (Set.toFinite _)
  have bound : (events policy).ncard ≤ 2 * D.card := by
    have h := Set.ncard_le_ncard_of_injOn
      (s := events policy) (t := Set.univ)
      (fun e : ℕ × D => (e.2, decide (state (chain.ledger e.1) e.2.val = .open)))
      (fun _ _ => Set.mem_univ _) (event_injective policy consistent)
    simpa [Set.ncard_univ, Nat.card_prod, Nat.card_eq_fintype_card, Nat.mul_comm] using h
  have count := total_eq_event_card policy finiteEvents
  refine ⟨fun p => changes_subsingleton consistent p.val, ?_, finiteEvents, count.symm,
    count.trans_le bound, ledger_stabilizes consistent, quiet_after_stabilization policy,
    latest_claim_log policy, ?_⟩
  · intro p
    refine ⟨finite_corrections policy consistent p, ?_⟩
    have h := Set.ncard_le_ncard_of_injOn (t := (Set.univ : Set Bool))
      (fun t => decide (state (chain.ledger t) p.val = .open))
      (fun _ _ => Set.mem_univ _) (correction_phase_injective policy consistent p)
    simpa using h
  · intro t
    refine ⟨rfl, by simp [batch], ?_, ?_⟩
    · simpa [batch, List.map_map, Function.comp_def] using (policy.selected t).nodup_toList
    · intro p s
      simp only [batch, List.mem_map, Finset.mem_toList, Prod.mk.injEq]
      constructor
      · rintro ⟨q,hq,rfl,rfl⟩
        exact ⟨hq,rfl⟩
      · rintro ⟨hp,rfl⟩
        exact ⟨p,hp,rfl,rfl⟩

end

end D5.S3.ConceptDynamics.DependencyTopology.FiniteLedgerCorrection
