import Mathlib.Data.List.Basic

/- Library-search audit trail (2026-08-27):
   * Repository searches for commuting squares, intervention sequences, action
     words, `List.foldl`, and compositions found no exact whole theorem.
   * `finite_action_sequence_preserves_rights` is the closest body-shape hit and
     fixes the same heterogeneous left-fold action order, but proves safe-set
     preservation rather than a micro/macro commuting equation.
   * The Boolean `wordAction` and observation-valued `experimentTrace` primitives
     have different carriers and cannot represent this arbitrary action family.
   * Pinned Mathlib provides list induction and `congrArg`; no theorem packages
     this naturality law for two heterogeneous state carriers. No new action-word
     definition is introduced. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.InterventionsExchange.FiniteInterventionSequenceCommutation

/-- If abstraction commutes with every atomic micro/macro intervention pair,
then it commutes with the composite maps generated by every finite action list. -/
theorem finite_intervention_sequences_commute
    {Action Micro Macro : Type*}
    (abstract : Micro -> Macro)
    (micro : Action -> Micro -> Micro)
    (macroAction : Action -> Macro -> Macro)
    (atomicCommutes : forall action state,
      abstract (micro action state) = macroAction action (abstract state)) :
    forall actions : List Action,
      abstract ∘
          (fun state => actions.foldl
            (fun current action => micro action current) state) =
        (fun state => actions.foldl
          (fun current action => macroAction action current) state) ∘ abstract := by
  intro actions
  funext state
  induction actions generalizing state with
  | nil => rfl
  | cons action remaining inductionHypothesis =>
      simp only [List.foldl_cons, Function.comp_apply]
      calc
        abstract
            (remaining.foldl
              (fun current next => micro next current) (micro action state)) =
          remaining.foldl
            (fun current next => macroAction next current)
            (abstract (micro action state)) :=
          inductionHypothesis (micro action state)
        _ = remaining.foldl
            (fun current next => macroAction next current)
            (macroAction action (abstract state)) :=
          congrArg
            (fun initial => remaining.foldl
              (fun current next => macroAction next current) initial)
            (atomicCommutes action state)

#print axioms finite_intervention_sequences_commute

end D5.S3.ConceptDynamics.InterventionsExchange.FiniteInterventionSequenceCommutation
