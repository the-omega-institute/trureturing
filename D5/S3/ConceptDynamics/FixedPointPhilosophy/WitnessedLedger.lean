   digest: Finite accepted witness ledgers are generated by their ancestor primes. -/

import D5.S3.ConceptDynamics.DependencyTopology.DependencyReachabilityOrder
import D5.S3.ConceptDynamics.DagCompletion.WellFoundedFrontier
import D5.S3.ConceptDynamics.Closure.SourceClosureLaws
import Mathlib.Data.Fintype.Card

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.FixedPointPhilosophy.WitnessedLedger

open D5.S3.ConceptDynamics.DependencyTopology.DependencyReachabilityOrder
open D5.S3.ConceptDynamics.DagCompletion.WellFoundedFrontier
open D5.S3.ConceptDynamics.Closure.SourceClosureLaws

universe u v z

/-- A decidable kernel with finite axiom and direct-reference readouts. -/
structure ProofSystem where
  P : Type u
  Proof : Type v
  Ax : Type z
  K : Proof → P → Bool
  ax : Proof → Finset Ax
  refs : Proof → Finset P
  A : Set Ax

/-- Provability means existence of an accepted, permitted proof. -/
def ProofSystem.Thm (system : ProofSystem) : Set system.P :=
  {p | ∃ proof, system.K proof p = true ∧ (↑(system.ax proof) : Set system.Ax) ⊆ system.A}

variable {system : ProofSystem}

/-- The target's stored witness determines its incoming edges. -/
def referenceEdge (N : Set system.P) (w : N → system.Proof) (a b : system.P) : Prop :=
  ∃ hb : b ∈ N, a ∈ system.refs (w ⟨b, hb⟩)

/-- The frozen core may be infinite; all its witnesses remain locally finite. -/
structure WitnessedCore (system : ProofSystem) where
  N : Set system.P
  w : N → system.Proof
  accepted : ∀ p, system.K (w p) p.val = true
  permitted : ∀ p, (↑(system.ax (w p)) : Set system.Ax) ⊆ system.A
  refs_closed : ∀ p, (↑(system.refs (w p)) : Set system.P) ⊆ N
  acyclic : AcyclicEdge (referenceEdge N w)

def WitnessedCore.E (C : WitnessedCore system) : system.P → system.P → Prop :=
  referenceEdge C.N C.w

/-- A full presentation has an arbitrary disjoint registered frontier. -/
structure LedgerPresentation (system : ProofSystem) extends WitnessedCore system where
  O : Set system.P
  frontier_disjoint : Disjoint N O

/-- Source snapshots have finite frozen sets, without any finiteness condition on the frontier. -/
structure LegalLedger (system : ProofSystem) extends LedgerPresentation system where
  finite : N.Finite

/-- Proper ancestry is nonempty-path reachability, not reflexive reachability. -/
def Anc (C : WitnessedCore system) (p : system.P) : Set system.P :=
  {q | StrictReachable C.E q p}

/-- Primality is relative to the actual stored witnesses and an arbitrary closure operator. -/
def Prime (B : ClosureOperator (Set system.P)) (C : WitnessedCore system) : Set system.P :=
  {p | p ∈ C.N ∧ p ∉ B (Anc C p)}

theorem frozen_subset_theorems (C : WitnessedCore system) : C.N ⊆ system.Thm := by
  intro p hp
  exact ⟨C.w ⟨p, hp⟩, C.accepted _, C.permitted _⟩

theorem edge_endpoints (C : WitnessedCore system) {a b : system.P} (h : C.E a b) :
    a ∈ C.N ∧ b ∈ C.N := by
  obtain ⟨hb, href⟩ := h
  exact ⟨C.refs_closed ⟨b, hb⟩ href, hb⟩

theorem ancestors_subset (C : WitnessedCore system) (p : system.P) : Anc C p ⊆ C.N := by
  intro q h
  obtain ⟨b, hqb, _⟩ := Relation.TransGen.head'_iff.mp h
  exact (edge_endpoints C hqb).1

theorem not_own_ancestor (C : WitnessedCore system) (p : system.P) : p ∉ Anc C p :=
  C.acyclic p

/-- Finite acyclicity gives well-foundedness of the actual ancestor relation on frozen nodes. -/
theorem node_ancestors_wellFounded (L : LegalLedger system) :
    WellFounded (fun a b : L.N => a.val ∈ Anc L.toWitnessedCore b.val) := by
  let : Finite L.N := L.finite
  let r := fun a b : L.N => a.val ∈ Anc L.toWitnessedCore b.val
  let : IsTrans L.N r := ⟨fun _ _ _ hab hbc => hab.trans hbc⟩
  let : Std.Irrefl r := ⟨fun p => L.acyclic p.val⟩
  exact Finite.wellFounded_of_trans_of_irrefl r

/-- A minimal node outside the prime closure contradicts the three source closure laws. -/
theorem frozen_subset_bind_prime (B : ClosureOperator (Set system.P))
    (L : LegalLedger system) : L.N ⊆ B (Prime B L.toWitnessedCore) := by
  classical
  by_contra h
  obtain ⟨p, hp, hbad⟩ := Set.not_subset.mp h
  let pending : Set L.N := {p | p.val ∉ B (Prime B L.toWitnessedCore)}
  obtain ⟨q, hq, ready⟩ := exists_ready_of_wellFounded
    (node_ancestors_wellFounded L) (pending := pending) ⟨⟨p, hp⟩, hbad⟩
  have ancestors : Anc L.toWitnessedCore q.val ⊆ B (Prime B L.toWitnessedCore) := by
    intro a ha
    have := ready (prerequisite := ⟨a, ancestors_subset L.toWitnessedCore q.val ha⟩) ha
    exact not_not.mp this
  by_cases prime : q.val ∈ Prime B L.toWitnessedCore
  · exact hq ((source_closure_extensive_and_monotone B
      (Prime B L.toWitnessedCore) (Prime B L.toWitnessedCore)).1 prime)
  have bound : q.val ∈ B (Anc L.toWitnessedCore q.val) := by
    by_contra hn
    exact prime ⟨q.property, hn⟩
  have lifted := (source_closure_extensive_and_monotone B
    (Anc L.toWitnessedCore q.val) (B (Prime B L.toWitnessedCore))).2 ancestors bound
  exact hq (by simpa only [B.idempotent] using lifted)

/-- Core extension preserves every old witness exactly. -/
structure CoreExtends (C D : WitnessedCore system) : Prop where
  nodes : C.N ⊆ D.N
  witness : ∀ p : C.N, D.w ⟨p.val, nodes p.property⟩ = C.w p

theorem CoreExtends.refl (C : WitnessedCore system) : CoreExtends C C :=
  ⟨Set.Subset.rfl, fun _ => rfl⟩

theorem CoreExtends.trans {C D F : WitnessedCore system}
    (h : CoreExtends C D) (k : CoreExtends D F) : CoreExtends C F :=
  ⟨h.nodes.trans k.nodes, fun p => (k.witness ⟨p.val, h.nodes p.property⟩).trans (h.witness p)⟩

theorem CoreExtends.antisymm {C D : WitnessedCore system}
    (h : CoreExtends C D) (k : CoreExtends D C) : C = D := by
  have hn : C.N = D.N := h.nodes.antisymm k.nodes
  cases C with | mk N w accepted permitted refs_closed acyclic =>
    cases D with | mk N' w' accepted' permitted' refs_closed' acyclic' =>
      dsimp at hn
      subst N'
      have hw : w' = w := funext h.witness
      subst w'
      rfl

theorem CoreExtends.edge_iff {C D : WitnessedCore system} (h : CoreExtends C D)
    {a b : system.P} (hb : b ∈ C.N) : D.E a b ↔ C.E a b := by
  constructor
  · rintro ⟨_, href⟩
    exact ⟨hb, by simpa only [h.witness ⟨b, hb⟩] using href⟩
  · rintro ⟨_, href⟩
    exact ⟨h.nodes hb, by simpa only [h.witness ⟨b, hb⟩] using href⟩

/-- The source's edge-preservation clause follows from witness preservation. -/
theorem coreExtends_iff_source (C D : WitnessedCore system) :
    CoreExtends C D ↔ ∃ h : C.N ⊆ D.N,
      (∀ a b, C.E a b → D.E a b) ∧
      (∀ p : C.N, D.w ⟨p.val, h p.property⟩ = C.w p) := by
  constructor
  · intro h
    exact ⟨h.nodes, fun _ _ he => (h.edge_iff (edge_endpoints C he).2).mpr he, h.witness⟩
  · rintro ⟨hn, _, hw⟩
    exact ⟨hn, hw⟩

/-- Any disjoint frontier represents the same core, ancestry and primes. -/
def withFrontier (C : WitnessedCore system) (O : Set system.P) (h : Disjoint C.N O) :
    LedgerPresentation system := { toWitnessedCore := C, O := O, frontier_disjoint := h }

theorem frontier_independent (C : WitnessedCore system) (B : ClosureOperator (Set system.P))
    (O : Set system.P) (h : Disjoint C.N O) :
    (withFrontier C O h).toWitnessedCore = C ∧
      Anc (withFrontier C O h).toWitnessedCore = Anc C ∧
      Prime B (withFrontier C O h).toWitnessedCore = Prime B C := ⟨rfl, rfl, rfl⟩

end D5.S3.ConceptDynamics.FixedPointPhilosophy.WitnessedLedger
