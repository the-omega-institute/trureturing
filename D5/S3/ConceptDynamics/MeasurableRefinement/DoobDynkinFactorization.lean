   digest: Standard-Borel measurable refinement is generated-information inclusion. -/

import D5.S3.ConceptDynamics.ConceptFiberDecomposition
import Mathlib.MeasureTheory.Function.FactorsThrough

/- Library-search audit trail (2026-08-25):
   * Pinned Mathlib's exact Doob-Dynkin theorem is
     `Measurable.exists_eq_measurable_comp` in
     `Mathlib.MeasureTheory.Function.FactorsThrough`; it is applied directly.
   * `MeasurableSpace.measurable_iff_comap_le` is the exact characterization of
     measurability by inclusion of the generated pullback measurable space.
   * Repository search found the canonical `Concept` carrier in
     `ConceptFiberDecomposition` and existing inline uses of
     `MeasurableSpace.comap`, but no measurable-refinement family primitive or
     atom receipt.  The statement therefore exposes the factorization directly. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.MeasurableRefinement.DoobDynkinFactorization

open D5.S3.ConceptDynamics.ConceptFiberDecomposition

/-- For a standard-Borel concept codomain, measurability with respect to the
information generated by another concept gives a measurable factorization.
Consequently, measurable factorization is equivalent to inclusion of the two
generated measurable spaces. -/
theorem measurable_refinement_iff_generated_information_inclusion
    {X B_C B_D : Type*} [MeasurableSpace B_C] [MeasurableSpace B_D]
    [Nonempty B_C] [StandardBorelSpace B_C]
    (C : Concept X B_C) (D : Concept X B_D) :
    (@Measurable X B_C (MeasurableSpace.comap D inferInstance)
          inferInstance C ->
        ∃ p : B_D -> B_C, Measurable p ∧ C = p ∘ D) ∧
      ((∃ p : B_D -> B_C, Measurable p ∧ C = p ∘ D) ↔
        MeasurableSpace.comap C inferInstance <=
          MeasurableSpace.comap D inferInstance) := by
  constructor
  · intro hC
    exact hC.exists_eq_measurable_comp
  constructor
  · rintro ⟨p, hp, rfl⟩
    exact (hp.comp (comap_measurable D)).comap_le
  · intro hInfo
    have hC :
        @Measurable X B_C (MeasurableSpace.comap D inferInstance)
          inferInstance C :=
      Measurable.of_comap_le hInfo
    exact hC.exists_eq_measurable_comp

#print axioms measurable_refinement_iff_generated_information_inclusion

end D5.S3.ConceptDynamics.MeasurableRefinement.DoobDynkinFactorization
