/- GID: D5/S3/ConceptDynamics/DagSemantics/WellFoundedRecursiveClosure
   generality: G
   mirror-B: D5/B/S3/ConceptDynamics/DagSemantics/WellFoundedRecursiveClosure
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Well-founded dependency equations have unique solutions, while a self-loop admits a fixed-point gap. -/

import Mathlib.Order.WellFounded

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ConceptDynamics.DagSemantics.WellFoundedRecursiveClosure

/-- A set solves the local dependency equation when membership is generated by seeds or a predecessor already in the set. -/
def SatisfiesDependencyEquation
    {V : Type*} (edge : V → V → Prop) (seed solution : Set V) : Prop :=
  ∀ node,
    node ∈ solution ↔
      node ∈ seed ∨ ∃ prerequisite, edge prerequisite node ∧ prerequisite ∈ solution

/-- On a well-founded dependency relation, the local dependency equation has at most one solution. -/
theorem dependencyEquation_solution_unique
    {V : Type*} {edge : V → V → Prop} (wellFounded : WellFounded edge)
    {seed first second : Set V}
    (firstSolves : SatisfiesDependencyEquation edge seed first)
    (secondSolves : SatisfiesDependencyEquation edge seed second) :
    first = second := by
  ext node
  induction node using wellFounded.induction with
  | h node inductionHypothesis =>
      rw [firstSolves node, secondSolves node]
      constructor
      · rintro (seedMember | ⟨prerequisite, dependency, prerequisiteInFirst⟩)
        · exact Or.inl seedMember
        · exact Or.inr
            ⟨prerequisite, dependency,
              (inductionHypothesis prerequisite dependency).mp prerequisiteInFirst⟩
      · rintro (seedMember | ⟨prerequisite, dependency, prerequisiteInSecond⟩)
        · exact Or.inl seedMember
        · exact Or.inr
            ⟨prerequisite, dependency,
              (inductionHypothesis prerequisite dependency).mpr prerequisiteInSecond⟩

/-- Distinct solutions certify failure of well-foundedness. -/
theorem nonunique_solution_implies_not_wellFounded
    {V : Type*} {edge : V → V → Prop}
    {seed first second : Set V}
    (firstSolves : SatisfiesDependencyEquation edge seed first)
    (secondSolves : SatisfiesDependencyEquation edge seed second)
    (different : first ≠ second) :
    ¬ WellFounded edge := by
  intro wellFounded
  exact different
    (dependencyEquation_solution_unique wellFounded firstSolves secondSolves)

/-- The one-node self-loop relation. -/
def selfLoop : Unit → Unit → Prop := fun _ _ => True

/-- The empty set solves the unseeded self-loop equation. -/
theorem empty_solves_selfLoop :
    SatisfiesDependencyEquation selfLoop (∅ : Set Unit) ∅ := by
  intro node
  simp [SatisfiesDependencyEquation, selfLoop]

/-- The full set also solves the unseeded self-loop equation. -/
theorem univ_solves_selfLoop :
    SatisfiesDependencyEquation selfLoop (∅ : Set Unit) Set.univ := by
  intro node
  simp [SatisfiesDependencyEquation, selfLoop]

/-- A self-loop therefore admits two distinct recursive closures. -/
theorem selfLoop_has_fixedPoint_gap :
    ∃ first second : Set Unit,
      first ≠ second ∧
      SatisfiesDependencyEquation selfLoop ∅ first ∧
      SatisfiesDependencyEquation selfLoop ∅ second := by
  exact ⟨∅, Set.univ, Set.empty_ne_univ, empty_solves_selfLoop, univ_solves_selfLoop⟩

/-- The self-loop relation is not well-founded. -/
theorem selfLoop_not_wellFounded : ¬ WellFounded selfLoop := by
  exact nonunique_solution_implies_not_wellFounded
    empty_solves_selfLoop univ_solves_selfLoop Set.empty_ne_univ

#print axioms dependencyEquation_solution_unique
#print axioms selfLoop_has_fixedPoint_gap

end D5.S3.ConceptDynamics.DagSemantics.WellFoundedRecursiveClosure
