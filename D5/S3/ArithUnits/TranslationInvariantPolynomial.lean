   digest: Translation invariant polynomials are polynomials in the additive orbit generator. -/

import Mathlib

/-! Translation invariants over fields of prime characteristic. -/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.ArithUnits.TranslationInvariantPolynomial

open Polynomial

private theorem constant_of_translation_invariant
    {p : ℕ} [Fact p.Prime] {K : Type*} [Field K] [CharP K p]
    (a : K) (ha : a ≠ 0) (f : K[X])
    (hinv : f.comp (X + C a) = f) (hdeg : f.natDegree < p) :
    f = C (f.eval 0) := by
  classical
  let e : ZMod p →+* K := ZMod.castHom (dvd_refl p) K
  have hstep (x : K) : f.eval (x + a) = f.eval x := by
    simpa only [eval_comp, eval_add, eval_X, eval_C] using
      congrArg (fun q : K[X] => q.eval x) hinv
  have hn (n : ℕ) : f.eval ((n : K) * a) = f.eval 0 :=
    Function.Periodic.nat_mul_eq (f := fun x : K => f.eval x) (c := a) hstep n
  apply eq_of_natDegree_lt_card_of_eval_eq f (C (f.eval 0))
    (f := fun i : ZMod p => e i * a)
  · intro i j hij
    exact e.injective (mul_right_cancel₀ ha hij)
  · intro i
    have hi : e i = (i.val : K) := by
      rw [← map_natCast e i.val, ZMod.natCast_zmod_val]
    simpa only [hi, eval_C] using hn i.val
  · simpa only [natDegree_C, Nat.max_zero, ZMod.card] using hdeg

/-- The invariant algebra of a nonzero prime-characteristic translation is
 generated by its additive orbit polynomial. -/
theorem exists_comp_of_translation_invariant
    {p : ℕ} [Fact p.Prime] {K : Type*} [Field K] [CharP K p]
    (a : K) (ha : a ≠ 0) (f : K[X])
    (hinv : f.comp (X + C a) = f) :
    ∃ Q : K[X], Q.comp (X ^ p - C (a ^ (p - 1)) * X) = f := by
  classical
  let g : K[X] := X ^ p - C (a ^ (p - 1)) * X
  have hp : p.Prime := Fact.out
  have hsmall : (C (a ^ (p - 1)) * X : K[X]).natDegree < (X ^ p : K[X]).natDegree := by
    rw [natDegree_C_mul_X _ (pow_ne_zero _ ha), natDegree_X_pow]
    exact hp.one_lt
  have hmonic : g.Monic := (monic_X_pow p).sub_of_left (degree_lt_degree hsmall)
  have hgdeg : g.natDegree = p := by
    exact (natDegree_sub_eq_left_of_natDegree_lt hsmall).trans (natDegree_X_pow p)
  have hginv : g.comp (X + C a) = g := by
    dsimp [g]
    rw [sub_comp, pow_comp, X_comp, mul_comp, C_comp, X_comp,
      add_pow_char, ← map_pow]
    have hpow : a ^ p = a ^ (p - 1) * a := by
      rw [← pow_succ, Nat.sub_add_cancel hp.one_le]
    rw [hpow, map_mul]
    ring
  have hall : ∀ n : ℕ, ∀ u : K[X], u.natDegree = n →
      u.comp (X + C a) = u → ∃ Q : K[X], Q.comp g = u := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro u hun huinv
      by_cases hn : n = 0
      · refine ⟨C (u.coeff 0), ?_⟩
        rw [C_comp, ← eq_C_of_natDegree_eq_zero (hun.trans hn)]
      have hrdeg : (u %ₘ g).degree < g.degree := degree_modByMonic_lt u hmonic
      have huniq : u /ₘ g = (u /ₘ g).comp (X + C a) ∧
          u %ₘ g = (u %ₘ g).comp (X + C a) := by
        apply div_modByMonic_unique _ _ hmonic
        constructor
        · have ht := congrArg (fun q : K[X] => q.comp (X + C a)) (modByMonic_add_div u g)
          simpa only [add_comp, mul_comp, hginv, huinv] using ht
        · simpa only [← taylor_apply, degree_taylor] using hrdeg
      have hrnat : (u %ₘ g).natDegree < p := by
        by_cases hr0 : u %ₘ g = 0
        · simpa only [hr0, natDegree_zero] using hp.pos
        · rw [← hgdeg]
          exact natDegree_lt_natDegree hr0 hrdeg
      have hrc : u %ₘ g = C ((u %ₘ g).eval 0) :=
        constant_of_translation_invariant a ha _ huniq.2.symm hrnat
      have hqnat : (u /ₘ g).natDegree < n := by
        rw [natDegree_divByMonic _ hmonic, hun, hgdeg]
        omega
      obtain ⟨Q, hQ⟩ := ih _ hqnat (u /ₘ g) rfl huniq.1.symm
      refine ⟨C ((u %ₘ g).eval 0) + X * Q, ?_⟩
      rw [add_comp, C_comp, mul_comp, X_comp, hQ, ← hrc]
      exact modByMonic_add_div u g
  exact hall f.natDegree f rfl hinv


end D5.S3.ArithUnits.TranslationInvariantPolynomial
