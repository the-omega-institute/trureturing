import D5.S3.QuantumBounds.ReferenceFrameTaxOptimal

/-!
# Paired top eigenspace of finite path averaging

The Dirichlet path-averaging eigenvalues are `cos(k*pi/(N+1))`. Squaring pairs mode `k` with
mode `N+1-k`; at the spectral edge the low mode `k=1` and high mode `k=N` therefore share the top
squared eigenvalue. This module proves the recurrence, the pairing, and that the span generated by
those two modes has dimension exactly two for `N >= 2`.
-/

namespace D5.S3.QuantumBounds.ReferenceFrame.TopEigenspace

open scoped BigOperators

open D5.S3.QuantumBounds.ReferenceFrameTax

/-- Zero-boundary nearest-neighbour averaging. -/
noncomputable def nearestNeighborAverage {N : ℕ} (c : Fin N → ℝ) (m : Fin N) : ℝ :=
  ((if _h : 0 < m.val then
      c ⟨m.val - 1, lt_of_le_of_lt (Nat.sub_le ..) m.isLt⟩ else 0) +
    (if _h : m.val + 1 < N then c ⟨m.val + 1, _h⟩ else 0)) / 2

/-- The frozen quadratic is the squared Euclidean norm of path averaging. -/
theorem nearest_neighbor_quadratic_eq_average_norm_sq {N : ℕ} (c : Fin N → ℝ) :
    nearestNeighborQuadratic c = ∑ m : Fin N, nearestNeighborAverage c m ^ 2 := by
  rfl

/-- Path averaging respects addition. -/
theorem nearest_neighbor_average_add {N : ℕ} (c d : Fin N → ℝ) :
    nearestNeighborAverage (c + d) = nearestNeighborAverage c + nearestNeighborAverage d := by
  funext m
  unfold nearestNeighborAverage
  by_cases hl : 0 < m.val <;> by_cases hr : m.val + 1 < N <;>
    simp [hl, hr] <;> ring

/-- Path averaging respects real scalar multiplication. -/
theorem nearest_neighbor_average_smul {N : ℕ} (a : ℝ) (c : Fin N → ℝ) :
    nearestNeighborAverage (a • c) = a • nearestNeighborAverage c := by
  funext m
  unfold nearestNeighborAverage
  by_cases hl : 0 < m.val <;> by_cases hr : m.val + 1 < N <;>
    simp [hl, hr] <;> ring

/-- Path averaging as a real-linear endomorphism. -/
noncomputable def nearestNeighborMap (N : ℕ) :
    Module.End ℝ (Fin N → ℝ) where
  toFun := nearestNeighborAverage
  map_add' := nearest_neighbor_average_add
  map_smul' := nearest_neighbor_average_smul

/-- The angle of the `k`th sine mode, using one-based mode number `k`. -/
noncomputable def modeAngle (N k : ℕ) : ℝ := (k : ℝ) * Real.pi / (N + 1 : ℝ)

/-- The unnormalized Dirichlet sine mode with one-based mode number `k`. -/
noncomputable def sineMode (N k : ℕ) : Fin N → ℝ :=
  fun i ↦ Real.sin ((i.val + 1) * modeAngle N k)

/-- Every finite Dirichlet sine mode satisfies the path-averaging eigenvector recurrence. -/
theorem sine_mode_eigenvector (N k : ℕ) (m : Fin N) :
    nearestNeighborAverage (sineMode N k) m =
      Real.cos (modeAngle N k) * sineMode N k m := by
  let theta := modeAngle N k
  have htrig (x : ℝ) :
      (Real.sin (x - theta) + Real.sin (x + theta)) / 2 =
        Real.cos theta * Real.sin x := by
    rw [Real.sin_sub, Real.sin_add]
    ring
  have hleft :
      (if _h : 0 < m.val then
          Real.sin (((((m.val - 1 : ℕ) : ℝ) + 1) * theta)) else 0) =
        Real.sin (m.val * theta) := by
    by_cases hl : 0 < m.val
    · simp only [hl, ↓reduceDIte]
      congr 1
      rw [Nat.cast_sub (by omega : 1 ≤ m.val)]
      norm_num
    · have hm0 : m.val = 0 := by omega
      simp [hm0]
  have hright :
      (if _h : m.val + 1 < N then
          Real.sin (((((m.val + 1 : ℕ) : ℝ) + 1) * theta)) else 0) =
        Real.sin ((m.val + 2) * theta) := by
    by_cases hr : m.val + 1 < N
    · simp only [hr, ↓reduceDIte]
      congr 1
      push_cast
      ring
    · have hm : m.val + 1 = N := by omega
      simp only [hr, ↓reduceDIte]
      symm
      have harg : (((m.val : ℝ) + 2) * theta) = (k : ℝ) * Real.pi := by
        dsimp [theta, modeAngle]
        have hmR : (m.val : ℝ) + 1 = N := by exact_mod_cast hm
        rw [show (m.val : ℝ) + 2 = (N : ℝ) + 1 by linarith]
        field_simp
      rw [harg]
      exact Real.sin_nat_mul_pi k
  change
    ((if _h : 0 < m.val then
        Real.sin (((((m.val - 1 : ℕ) : ℝ) + 1) * theta)) else 0) +
      (if _h : m.val + 1 < N then
        Real.sin (((((m.val + 1 : ℕ) : ℝ) + 1) * theta)) else 0)) / 2 =
      Real.cos theta * Real.sin (((m.val : ℝ) + 1) * theta)
  rw [hleft, hright]
  convert htrig (((m.val + 1 : ℕ) : ℝ) * theta) using 1 <;> push_cast <;> ring_nf

/-- Reversing `k` to `N+1-k` negates the path eigenvalue and preserves its square. -/
theorem paired_mode_cos_sq {N : ℕ} (k : Fin N) :
    Real.cos (modeAngle N (k.val + 1)) ^ 2 =
      Real.cos (modeAngle N (N - k.val)) ^ 2 := by
  have hpair : modeAngle N (N - k.val) =
      Real.pi - modeAngle N (k.val + 1) := by
    unfold modeAngle
    rw [Nat.cast_sub (Nat.le_of_lt k.isLt)]
    push_cast
    field_simp
    ring
  rw [hpair, Real.cos_pi_sub]
  ring

/-- The low-edge sine mode `k=1`. -/
noncomputable def lowMode (N : ℕ) : Fin N → ℝ := sineMode N 1

/-- The high-edge sine mode `k=N`. -/
noncomputable def highMode (N : ℕ) : Fin N → ℝ := sineMode N N

/-- The low mode has eigenvalue `cos(pi/(N+1))`. -/
theorem low_mode_eigenvector (N : ℕ) :
    nearestNeighborAverage (lowMode N) =
      Real.cos (Real.pi / (N + 1 : ℝ)) • lowMode N := by
  funext m
  simpa [lowMode, modeAngle] using sine_mode_eigenvector N 1 m

/-- The high mode has the opposite eigenvalue. -/
theorem high_mode_eigenvector (N : ℕ) :
    nearestNeighborAverage (highMode N) =
      (-Real.cos (Real.pi / (N + 1 : ℝ))) • highMode N := by
  have hangle : modeAngle N N = Real.pi - Real.pi / (N + 1 : ℝ) := by
    unfold modeAngle
    field_simp
    ring
  funext m
  rw [show nearestNeighborAverage (highMode N) m =
      Real.cos (modeAngle N N) * highMode N m by
        simpa [highMode] using sine_mode_eigenvector N N m]
  rw [hangle, Real.cos_pi_sub]
  rfl

/-- The paired high mode alternates the signs of the low mode. -/
theorem high_mode_pairing (N : ℕ) (i : Fin N) :
    highMode N i = (-1 : ℝ) ^ i.val * lowMode N i := by
  have harg : ((i.val : ℝ) + 1) * modeAngle N N =
      ((i.val + 1 : ℕ) : ℝ) * Real.pi -
        ((i.val : ℝ) + 1) * modeAngle N 1 := by
    unfold modeAngle
    push_cast
    field_simp
    ring
  change Real.sin (((i.val : ℝ) + 1) * modeAngle N N) =
    (-1 : ℝ) ^ i.val * Real.sin (((i.val : ℝ) + 1) * modeAngle N 1)
  rw [harg, Real.sin_nat_mul_pi_sub, pow_succ]
  ring

/-- The two edge modes as a two-element family. -/
noncomputable def topModeFamily (N : ℕ) : Fin 2 → (Fin N → ℝ) := ![lowMode N, highMode N]

/-- The paired squared-top-mode space. -/
noncomputable def topModeSpace (N : ℕ) : Submodule ℝ (Fin N → ℝ) :=
  Submodule.span ℝ (Set.range (topModeFamily N))

/-- The full eigenspace of squared path averaging at the edge value. -/
noncomputable def squaredTopEigenspace (N : ℕ) : Submodule ℝ (Fin N → ℝ) :=
  Module.End.eigenspace ((nearestNeighborMap N).comp (nearestNeighborMap N))
    (Real.cos (Real.pi / (N + 1 : ℝ)) ^ 2)

/-- The edge value is the sharp quadratic value on the Euclidean unit sphere. -/
theorem nearest_neighbor_quadratic_edge_is_sharp (N : ℕ) (hN : 1 ≤ N) :
    (∀ c : Fin N → ℝ, (∑ i, c i ^ 2) = 1 →
      nearestNeighborQuadratic c ≤ Real.cos (Real.pi / (N + 1 : ℝ)) ^ 2) ∧
    ∃ c : Fin N → ℝ, (∑ i, c i ^ 2) = 1 ∧
      nearestNeighborQuadratic c = Real.cos (Real.pi / (N + 1 : ℝ)) ^ 2 := by
  constructor
  · intro c hc
    simpa [hc] using nearestNeighborQuadratic_le_cos_sq N c
  · exact exists_unit_sine_reference_witness N hN

/-- Membership in the full squared eigenspace is the coordinate-free squared eigenvector law. -/
theorem mem_squared_top_eigenspace_iff (N : ℕ) (c : Fin N → ℝ) :
    c ∈ squaredTopEigenspace N ↔
      nearestNeighborAverage (nearestNeighborAverage c) =
        Real.cos (Real.pi / (N + 1 : ℝ)) ^ 2 • c := by
  exact Module.End.mem_eigenspace_iff

/-- Membership in the paired space is exactly a linear combination of the low and high modes. -/
theorem mem_top_mode_space_iff (N : ℕ) (c : Fin N → ℝ) :
    c ∈ topModeSpace N ↔
      ∃ a b : ℝ, a • lowMode N + b • highMode N = c := by
  have hrange : Set.range (topModeFamily N) = {lowMode N, highMode N} := by
    ext c
    simp [topModeFamily, or_comm]
  rw [topModeSpace, hrange, Submodule.mem_span_pair]

private theorem top_modes_linear_independent (N : ℕ) (hN : 2 ≤ N) :
    LinearIndependent ℝ (topModeFamily N) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have hsum : g 0 • lowMode N + g 1 • highMode N = 0 := by
    simpa [topModeFamily, Fin.sum_univ_two] using hg
  let i0 : Fin N := ⟨0, by omega⟩
  let i1 : Fin N := ⟨1, by omega⟩
  have h0 := congrFun hsum i0
  have h1 := congrFun hsum i1
  rw [Pi.add_apply, Pi.smul_apply, Pi.smul_apply, high_mode_pairing] at h0 h1
  simp only [Pi.zero_apply, i0, i1, lowMode, sineMode, modeAngle, pow_zero,
    pow_one, one_mul, neg_one_mul, smul_eq_mul] at h0 h1
  have htheta_pos : 0 < Real.pi / (N + 1 : ℝ) := by positivity
  have htheta_lt : Real.pi / (N + 1 : ℝ) < Real.pi := by
    apply div_lt_self Real.pi_pos
    exact_mod_cast (show 1 < N + 1 by omega)
  have htwo_theta_lt : 2 * (Real.pi / (N + 1 : ℝ)) < Real.pi := by
    have hden : (2 : ℝ) < (N : ℝ) + 1 := by exact_mod_cast (show 2 < N + 1 by omega)
    calc
      2 * (Real.pi / (N + 1 : ℝ)) = Real.pi * (2 / ((N : ℝ) + 1)) := by ring
      _ < Real.pi * 1 := by
        gcongr
        exact (div_lt_one (by positivity)).2 hden
      _ = Real.pi := by ring
  have hsin0 : Real.sin (Real.pi / (N + 1 : ℝ)) ≠ 0 :=
    (Real.sin_pos_of_pos_of_lt_pi htheta_pos htheta_lt).ne'
  have hsin1 : Real.sin (2 * (Real.pi / (N + 1 : ℝ))) ≠ 0 :=
    (Real.sin_pos_of_pos_of_lt_pi (mul_pos (by norm_num) htheta_pos) htwo_theta_lt).ne'
  have hgadd : g 0 + g 1 = 0 := by
    apply (mul_eq_zero.mp ?_).resolve_right hsin0
    (convert h0 using 1; ring_nf)
  have hgsub : g 0 - g 1 = 0 := by
    apply (mul_eq_zero.mp ?_).resolve_right hsin1
    (convert h1 using 1; ring_nf)
  intro i
  fin_cases i
  · change g 0 = 0
    nlinarith
  · change g 1 = 0
    nlinarith

/-- The low/high paired top-mode space is exactly two-dimensional for `N >= 2`. -/
theorem top_mode_space_finrank (N : ℕ) (hN : 2 ≤ N) :
    Module.finrank ℝ (topModeSpace N) = 2 := by
  unfold topModeSpace
  rw [finrank_span_eq_card (top_modes_linear_independent N hN)]
  norm_num

/-- Every vector in the paired two-dimensional space is an eigenvector of the squared averaging
operator with the top squared eigenvalue. -/
theorem top_mode_space_squared_eigenvector (N : ℕ) (c : Fin N → ℝ)
    (hc : c ∈ topModeSpace N) :
    nearestNeighborAverage (nearestNeighborAverage c) =
      Real.cos (Real.pi / (N + 1 : ℝ)) ^ 2 • c := by
  rw [mem_top_mode_space_iff] at hc
  rcases hc with ⟨a, b, rfl⟩
  let lambda := Real.cos (Real.pi / (N + 1 : ℝ))
  have hlow : nearestNeighborAverage (lowMode N) = lambda • lowMode N := by
    exact low_mode_eigenvector N
  have hhigh : nearestNeighborAverage (highMode N) = (-lambda) • highMode N := by
    exact high_mode_eigenvector N
  calc
    nearestNeighborAverage
        (nearestNeighborAverage (a • lowMode N + b • highMode N)) =
        nearestNeighborAverage
          (a • (lambda • lowMode N) + b • ((-lambda) • highMode N)) := by
            rw [nearest_neighbor_average_add, nearest_neighbor_average_smul,
              nearest_neighbor_average_smul, hlow, hhigh]
    _ = lambda ^ 2 • (a • lowMode N + b • highMode N) := by
      rw [nearest_neighbor_average_add, nearest_neighbor_average_smul,
        nearest_neighbor_average_smul, nearest_neighbor_average_smul,
        nearest_neighbor_average_smul, hlow, hhigh]
      ext i
      simp only [Pi.add_apply, Pi.smul_apply, smul_eq_mul]
      ring

private theorem average_sq_zero {N : ℕ} (c : Fin N → ℝ) (hN : 2 < N) :
    nearestNeighborAverage (nearestNeighborAverage c) ⟨0, by omega⟩ =
      (c ⟨0, by omega⟩ + c ⟨2, hN⟩) / 4 := by
  unfold nearestNeighborAverage
  have hOne : 1 < N := by omega
  simp [hOne, hN]
  ring

private theorem average_sq_one {N : ℕ} (c : Fin N → ℝ) (hN : 3 < N) :
    nearestNeighborAverage (nearestNeighborAverage c) ⟨1, by omega⟩ =
      (2 * c ⟨1, by omega⟩ + c ⟨3, hN⟩) / 4 := by
  unfold nearestNeighborAverage
  have hOne : 1 < N := by omega
  have hTwo : 2 < N := by omega
  simp [hOne, hTwo, hN]
  ring

private theorem average_sq_interior {N m : ℕ} (c : Fin N → ℝ)
    (hm : 2 ≤ m) (hnext : m + 2 < N) :
    nearestNeighborAverage (nearestNeighborAverage c) ⟨m, by omega⟩ =
      (c ⟨m - 2, by omega⟩ + 2 * c ⟨m, by omega⟩ + c ⟨m + 2, hnext⟩) / 4 := by
  unfold nearestNeighborAverage
  have hmpos : 0 < m := by omega
  have hmPredPos : 0 < m - 1 := by omega
  have hmSucc : m - 1 + 1 = m := by omega
  have hmBack : m - 1 - 1 = m - 2 := by omega
  have hmForward : m + 1 - 1 = m := by omega
  have hmN : m < N := by omega
  have hmNext : m + 1 < N := by omega
  simp [hmpos, hmPredPos, hmSucc, hmBack, hmForward, hmN, hmNext, hnext]
  ring

private theorem squared_eigenvector_zero_of_first_two (N : ℕ) (hN : 2 ≤ N)
    (c : Fin N → ℝ)
    (hc : nearestNeighborAverage (nearestNeighborAverage c) =
      Real.cos (Real.pi / (N + 1 : ℝ)) ^ 2 • c)
    (hc0 : c ⟨0, by omega⟩ = 0) (hc1 : c ⟨1, by omega⟩ = 0) : c = 0 := by
  funext i
  have hzero : ∀ n : ℕ, (hn : n < N) → c ⟨n, hn⟩ = 0 := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      by_cases hn0 : n = 0
      · subst n
        simpa using hc0
      by_cases hn1 : n = 1
      · subst n
        simpa using hc1
      have hn2 : 2 ≤ n := by omega
      let m : ℕ := n - 2
      have hmN : m < N := by omega
      have hm_lt : m < n := by omega
      have hm2 : m + 2 = n := by omega
      have hcm : c ⟨m, hmN⟩ = 0 := ih m hm_lt hmN
      have hright : m + 1 < N := by omega
      by_cases hm0 : m = 0
      · have hnEq : n = 2 := by dsimp [m] at hm0; omega
        have hTwoN : 2 < N := by omega
        have hcoord := congrFun hc (⟨0, by omega⟩ : Fin N)
        rw [average_sq_zero c hTwoN] at hcoord
        simp only [Pi.smul_apply, smul_eq_mul, hc0, mul_zero] at hcoord
        have hc2 : c ⟨2, by omega⟩ = 0 := by nlinarith
        have hfin : (⟨n, hn⟩ : Fin N) = ⟨2, by omega⟩ := by
          apply Fin.ext
          exact hnEq
        rw [hfin]
        exact hc2
      by_cases hm1 : m = 1
      · have hnEq : n = 3 := by dsimp [m] at hm1; omega
        have hThreeN : 3 < N := by omega
        have hcoord := congrFun hc (⟨1, by omega⟩ : Fin N)
        rw [average_sq_one c hThreeN] at hcoord
        simp only [Pi.smul_apply, smul_eq_mul, hc1, mul_zero] at hcoord
        have hc3 : c ⟨3, by omega⟩ = 0 := by nlinarith
        have hfin : (⟨n, hn⟩ : Fin N) = ⟨3, by omega⟩ := by
          apply Fin.ext
          exact hnEq
        rw [hfin]
        exact hc3
      have hmTwo : 2 ≤ m := by omega
      have hprevN : m - 2 < N := by omega
      have hprev_lt : m - 2 < n := by omega
      have hcprev : c ⟨m - 2, hprevN⟩ = 0 := ih (m - 2) hprev_lt hprevN
      have hcoord := congrFun hc (⟨m, hmN⟩ : Fin N)
      rw [average_sq_interior c hmTwo (by omega)] at hcoord
      simp only [Pi.smul_apply, smul_eq_mul, hcm, hcprev, mul_zero] at hcoord
      have htarget : c ⟨m + 2, by omega⟩ = 0 := by nlinarith
      have hfin : (⟨n, hn⟩ : Fin N) = ⟨m + 2, by omega⟩ := by
        apply Fin.ext
        exact hm2.symm
      rw [hfin]
      exact htarget
  exact hzero i.val i.isLt

/-- Evaluation of the first two coordinates on the squared top eigenspace. -/
noncomputable def firstTwoCoordinates (N : ℕ) (hN : 2 ≤ N) :
    squaredTopEigenspace N →ₗ[ℝ] (Fin 2 → ℝ) where
  toFun c i := c.1 ⟨i.val, lt_of_lt_of_le i.isLt hN⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

private theorem first_two_coordinates_injective (N : ℕ) (hN : 2 ≤ N) :
    Function.Injective (firstTwoCoordinates N hN) := by
  intro c d hcd
  apply Subtype.ext
  apply sub_eq_zero.mp
  apply squared_eigenvector_zero_of_first_two N hN (c.1 - d.1)
  · exact (mem_squared_top_eigenspace_iff N (c.1 - d.1)).mp
      ((squaredTopEigenspace N).sub_mem c.2 d.2)
  · have h0 := congrFun hcd (0 : Fin 2)
    exact sub_eq_zero.mpr h0
  · have h1 := congrFun hcd (1 : Fin 2)
    exact sub_eq_zero.mpr h1

/-- The full squared top eigenspace has dimension at most two. -/
theorem squared_top_eigenspace_finrank_le_two (N : ℕ) (hN : 2 ≤ N) :
    Module.finrank ℝ (squaredTopEigenspace N) ≤ 2 := by
  calc
    Module.finrank ℝ (squaredTopEigenspace N) ≤ Module.finrank ℝ (Fin 2 → ℝ) :=
      (firstTwoCoordinates N hN).finrank_le_finrank_of_injective
        (first_two_coordinates_injective N hN)
    _ = 2 := by simp

/-- The full squared top eigenspace is exactly the span of the paired low and high sine modes. -/
theorem squared_top_eigenspace_eq_top_mode_space (N : ℕ) (hN : 2 ≤ N) :
    squaredTopEigenspace N = topModeSpace N := by
  symm
  apply Submodule.eq_of_le_of_finrank_le
  · intro c hc
    exact (mem_squared_top_eigenspace_iff N c).mpr
      (top_mode_space_squared_eigenvector N c hc)
  · rw [top_mode_space_finrank N hN]
    exact squared_top_eigenspace_finrank_le_two N hN

/-- Consequently the full squared top eigenspace is two-dimensional. -/
theorem squared_top_eigenspace_finrank (N : ℕ) (hN : 2 ≤ N) :
    Module.finrank ℝ (squaredTopEigenspace N) = 2 := by
  rw [squared_top_eigenspace_eq_top_mode_space N hN, top_mode_space_finrank N hN]

