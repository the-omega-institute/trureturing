import D5.S3.Entropy.Forgetting.CapacityMonotone

namespace D5.S3.Entropy.Forgetting.TrajectoryEntropyTelescoping

open D5.S3.Divergence.ChainRule
open D5.S3.Entropy.ConditionalEntropy
open D5.S3.Entropy.Forgetting.CapacityMonotone
open D5.S3.Entropy.MaxEntropy

/-- The law at time `k` along a trajectory generated by one deterministic update. -/
noncomputable def trajectoryLaw {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ) : ℕ → Y → ℝ
  | 0 => initial
  | k + 1 => pushforward update (trajectoryLaw update initial k)

/-- The graph-supported joint law of the states at times `k + 1` and `k`, in that order. -/
noncomputable def transitionJoint {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ) (k : ℕ) : Y × Y → ℝ :=
  by classical
     exact fun z => if update z.2 = z.1 then trajectoryLaw update initial k z.2 else 0

private theorem trajectory_nonnegative {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ) (hinitial : ∀ y, 0 ≤ initial y) :
    ∀ k y, 0 ≤ trajectoryLaw update initial k y := by
  classical
  intro k
  induction k with
  | zero => exact hinitial
  | succ k ih =>
      intro y
      simp only [trajectoryLaw, pushforward]
      exact Finset.sum_nonneg fun x _ => by
        by_cases h : update x = y <;> simp [h, ih x]

private theorem trajectory_total_mass {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ) (hinitial : ∑ y, initial y = 1) :
    ∀ k, ∑ y, trajectoryLaw update initial k y = 1 := by
  classical
  intro k
  induction k with
  | zero => exact hinitial
  | succ k ih =>
      simp only [trajectoryLaw, pushforward]
      calc
        (∑ y, ∑ x, if update x = y then trajectoryLaw update initial k x else 0) =
            ∑ x, ∑ y, if update x = y then trajectoryLaw update initial k x else 0 :=
          Finset.sum_comm
        _ = ∑ x, trajectoryLaw update initial k x := by
          apply Finset.sum_congr rfl
          intro x _
          simp
        _ = 1 := ih

private theorem transition_marginal {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ) (k : ℕ) :
    marginal (transitionJoint update initial k) = trajectoryLaw update initial (k + 1) := by
  classical
  funext y
  simp only [marginal, transitionJoint, trajectoryLaw, pushforward]

private theorem transition_entropy {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ) (k : ℕ) :
    shannonEntropy (transitionJoint update initial k) =
      shannonEntropy (trajectoryLaw update initial k) := by
  classical
  rw [shannonEntropy, Fintype.sum_prod_type]
  simp only [transitionJoint]
  calc
    (∑ y, ∑ x, Real.negMulLog
        (if update x = y then trajectoryLaw update initial k x else 0)) =
        ∑ x, ∑ y, Real.negMulLog
          (if update x = y then trajectoryLaw update initial k x else 0) := Finset.sum_comm
    _ = ∑ x, Real.negMulLog (trajectoryLaw update initial k x) := by
      apply Finset.sum_congr rfl
      intro x _
      rw [Finset.sum_eq_single (update x)]
      · simp
      · intro y _ hy
        simp [Ne.symm hy]
      · simp
    _ = shannonEntropy (trajectoryLaw update initial k) := rfl

/-- Every deterministic finite trajectory loses exactly its reverse conditional entropy at each
positive step, and these losses telescope over every finite prefix. -/
theorem deterministic_trajectory_entropy_telescoping {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ)
    (hinitial : (∀ y, 0 ≤ initial y) ∧ ∑ y, initial y = 1) :
    (∀ k : ℕ, 1 ≤ k →
      shannonEntropy (trajectoryLaw update initial (k - 1)) -
          shannonEntropy (trajectoryLaw update initial k) =
        conditionalEntropy (transitionJoint update initial (k - 1))) ∧
    (∀ N : ℕ,
      shannonEntropy (trajectoryLaw update initial 0) -
          shannonEntropy (trajectoryLaw update initial N) =
        ∑ k ∈ Finset.range N, conditionalEntropy (transitionJoint update initial k)) := by
  classical
  have hlaw : ∀ k,
      (∀ y, 0 ≤ trajectoryLaw update initial k y) ∧
        ∑ y, trajectoryLaw update initial k y = 1 := fun k =>
    ⟨trajectory_nonnegative update initial hinitial.1 k,
      trajectory_total_mass update initial hinitial.2 k⟩
  have hstep (k : ℕ) :
      shannonEntropy (trajectoryLaw update initial k) -
          shannonEntropy (trajectoryLaw update initial (k + 1)) =
        conditionalEntropy (transitionJoint update initial k) := by
    have hjoint_nonnegative : ∀ z, 0 ≤ transitionJoint update initial k z := by
      intro z
      simp only [transitionJoint]
      split_ifs
      · exact (hlaw k).1 z.2
      · exact le_rfl
    have hchain := entropy_chain_rule (transitionJoint update initial k) hjoint_nonnegative
    rw [transition_marginal, transition_entropy] at hchain
    linarith
  constructor
  · intro k hk
    simpa [Nat.sub_add_cancel hk] using hstep (k - 1)
  · intro N
    induction N with
    | zero => simp
    | succ N ih =>
        calc
          shannonEntropy (trajectoryLaw update initial 0) -
                shannonEntropy (trajectoryLaw update initial (N + 1)) =
              (shannonEntropy (trajectoryLaw update initial 0) -
                shannonEntropy (trajectoryLaw update initial N)) +
              (shannonEntropy (trajectoryLaw update initial N) -
                shannonEntropy (trajectoryLaw update initial (N + 1))) := by ring
          _ = (∑ k ∈ Finset.range N,
                conditionalEntropy (transitionJoint update initial k)) +
              conditionalEntropy (transitionJoint update initial N) := by rw [ih, hstep N]
          _ = ∑ k ∈ Finset.range (N + 1),
                conditionalEntropy (transitionJoint update initial k) := by
              rw [Finset.sum_range_succ]

/-- The normalized uniform Boolean law witnesses that the theorem's hypotheses are inhabited. -/
theorem bool_uniform_trajectory_witness (update : Bool → Bool) :
    let initial : Bool → ℝ := fun _ => 1 / 2
    (∀ k : ℕ, 1 ≤ k →
      shannonEntropy (trajectoryLaw update initial (k - 1)) -
          shannonEntropy (trajectoryLaw update initial k) =
        conditionalEntropy (transitionJoint update initial (k - 1))) ∧
    (∀ N : ℕ,
      shannonEntropy (trajectoryLaw update initial 0) -
          shannonEntropy (trajectoryLaw update initial N) =
        ∑ k ∈ Finset.range N, conditionalEntropy (transitionJoint update initial k)) := by
  dsimp
  apply deterministic_trajectory_entropy_telescoping
  constructor
  · intro y
    norm_num
  · norm_num [Fintype.sum_bool]

end D5.S3.Entropy.Forgetting.TrajectoryEntropyTelescoping
