private theorem trajectory_nonnegative {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ)
    (hinitial : ∀ y, 0 ≤ initial y) :
    ∀ t y, 0 ≤ trajectoryLaw update initial t y := by
  classical
  intro t
  induction t with
  | zero => exact hinitial
  | succ t ih =>
      intro y
      simp only [trajectoryLaw, pushforward]
      exact Finset.sum_nonneg fun x _ => by
        by_cases h : update x = y <;> simp [h, ih x]

private theorem trajectory_total_mass {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ)
    (hinitial : ∑ y, initial y = 1) :
    ∀ t, ∑ y, trajectoryLaw update initial t y = 1 := by
  classical
  intro t
  induction t with
  | zero => exact hinitial
  | succ t ih =>
      simp only [trajectoryLaw, pushforward]
      calc
        (∑ y, ∑ x, if update x = y then trajectoryLaw update initial t x else 0) =
            ∑ x, ∑ y, if update x = y then trajectoryLaw update initial t x else 0 :=
          Finset.sum_comm
        _ = ∑ x, trajectoryLaw update initial t x := by
          apply Finset.sum_congr rfl
          intro x _
          simp
        _ = 1 := ih

/-- A deterministic finite-state step loses exactly the reverse conditional entropy.
The loss is nonnegative, and it vanishes exactly when the update recovers the
previous state injectively on the current law's probability support. -/
theorem deterministic_entropy_step
    {Y : Type*} [Fintype Y]
    (update : Y → Y) (initial : Y → ℝ)
    (hinitial : (∀ y, 0 ≤ initial y) ∧ ∑ y, initial y = 1) :
    ∀ t : ℕ,
      (shannonEntropy (trajectoryLaw update initial t) -
          shannonEntropy (trajectoryLaw update initial (t + 1)) =
        conditionalEntropy (transitionJoint update initial t)) ∧
      0 ≤ conditionalEntropy (transitionJoint update initial t) ∧
      (shannonEntropy (trajectoryLaw update initial t) -
          shannonEntropy (trajectoryLaw update initial (t + 1)) = 0 ↔
        Set.InjOn update {y | trajectoryLaw update initial t y ≠ 0}) := by
  classical
  intro t
  have hstep :=
    (deterministic_trajectory_entropy_telescoping update initial hinitial).1
      (t + 1) (Nat.succ_le_succ (Nat.zero_le t))
  have hidentity :
      shannonEntropy (trajectoryLaw update initial t) -
          shannonEntropy (trajectoryLaw update initial (t + 1)) =
        conditionalEntropy (transitionJoint update initial t) := by
    simpa [Nat.succ_eq_add_one] using hstep
  have hjoint_nonnegative :
      ∀ z, 0 ≤ transitionJoint update initial t z := by
    intro z
    simp only [transitionJoint]
    split_ifs
    · exact trajectory_nonnegative update initial hinitial.1 t z.2
    · exact le_rfl
  have hnonnegative :=
    conditional_entropy_nonneg (transitionJoint update initial t)
      hjoint_nonnegative
  have heq :=
    pushforward_entropy_eq_iff_injective_on_support
      (trajectoryLaw update initial t) update
      ⟨trajectory_nonnegative update initial hinitial.1 t,
        trajectory_total_mass update initial hinitial.2 t⟩
  have hnext :
      trajectoryLaw update initial (t + 1) =
        pushforward update (trajectoryLaw update initial t) := by
    rfl
  rw [← hnext] at heq
  have heq_zero :
      shannonEntropy (trajectoryLaw update initial t) -
          shannonEntropy (trajectoryLaw update initial (t + 1)) = 0 ↔
        shannonEntropy (trajectoryLaw update initial (t + 1)) =
          shannonEntropy (trajectoryLaw update initial t) := by
    constructor <;> intro h <;> linarith
  exact ⟨hidentity, hnonnegative, heq_zero.trans heq⟩

