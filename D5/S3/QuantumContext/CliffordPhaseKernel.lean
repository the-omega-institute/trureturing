import Mathlib.Analysis.SpecialFunctions.Trigonometric.Basic
import Mathlib.Tactic

/- Library-search audit trail (2026-08-17):
   * D5 has no theorem asserting invariance of the frequency-48 cosine kernel.
   * `smart_search.sh cos_add_int_mul_two_pi` found the exact pinned-mathlib periodicity theorem
     `Real.cos_add_int_mul_two_pi`; `Real.cos_neg` supplies invariance under conjugation.
   * A broader natural-language `smart_search.sh` query returned no declaration-name match. -/

namespace D5.S3.QuantumContext.CliffordPhaseKernel

/-- The kernel `2 * cos (48 * theta)` is unchanged by every phase shift through an integer
multiple of `2 * pi / 24`, both before and after the antiunitary sign reversal. Thus the kernel is
constant on the phase orbits generated by these extended Clifford symmetries. -/
theorem clifford_phase_kernel_invariant (theta : ℝ) (shift : ℤ) :
    2 * Real.cos (48 * (theta + (shift : ℝ) * (2 * Real.pi / 24))) =
        2 * Real.cos (48 * theta) ∧
      2 * Real.cos (48 * (-theta + (shift : ℝ) * (2 * Real.pi / 24))) =
        2 * Real.cos (48 * theta) := by
  have hshift (x : ℝ) :
      48 * (x + (shift : ℝ) * (2 * Real.pi / 24)) =
        48 * x + (2 * shift : ℤ) * (2 * Real.pi) := by
    push_cast
    ring
  constructor
  · rw [hshift, Real.cos_add_int_mul_two_pi]
  · rw [hshift, Real.cos_add_int_mul_two_pi, mul_neg, Real.cos_neg]

#print axioms clifford_phase_kernel_invariant

end D5.S3.QuantumContext.CliffordPhaseKernel
