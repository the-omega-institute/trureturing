import D5.S3.PrimeGaps.PrimeGap186PhysicalSourceGeometry

/-!
This module ports the exact six coarse source groups generated by `build_inputs` in
`openai/PrimeGaps186` at commit `61340d0b74163003b32756bb16e91d9209a5e330`.
The upstream groups are `outer_h2`, `outer_h25`, `old_inner_h2`, `old_inner_h25`,
`new_inner_h2`, and `new_inner_h25`. Source-order-three ladder rows are used inside the
`h25` groups, whose effective order is the rational value `5/2`.
-/

namespace D5.S3.PrimeGaps.PrimeGap186PhysicalSourceGroups

open D5.S3.PrimeGaps.PrimeGap186PhysicalSourceGeometry

/-- The exact six coarse source groups of the upstream physical certificate. -/
inductive PhysicalSourceGroup
  | outerH2
  | outerH25
  | oldInnerH2
  | oldInnerH25
  | newInnerH2
  | newInnerH25
  deriving DecidableEq, Repr

instance : Fintype PhysicalSourceGroup where
  elems := { .outerH2, .outerH25, .oldInnerH2, .oldInnerH25, .newInnerH2, .newInnerH25 }
  complete := by intro g; cases g <;> simp

/-- Upstream role/orientation. Only the first two groups are outer. -/
def PhysicalSourceGroup.isOuter : PhysicalSourceGroup → Bool
  | .outerH2 | .outerH25 => true
  | .oldInnerH2 | .oldInnerH25 | .newInnerH2 | .newInnerH25 => false

/-- Effective order passed to `_group` upstream. -/
def PhysicalSourceGroup.effectiveOrder : PhysicalSourceGroup → ℚ
  | .outerH2 | .oldInnerH2 | .newInnerH2 => 2
  | .outerH25 | .oldInnerH25 | .newInnerH25 => 5 / 2

/-- Which source-ladder population feeds a coarse group. Outer groups use the concatenated old and
new source rows; inner groups use one source family each. -/
inductive PhysicalSourcePopulation
  | mixedOuter
  | oldInner
  | newInner
  deriving DecidableEq, Repr

/-- Exact row-population rule from upstream `build_inputs`. -/
def PhysicalSourceGroup.population : PhysicalSourceGroup → PhysicalSourcePopulation
  | .outerH2 | .outerH25 => .mixedOuter
  | .oldInnerH2 | .oldInnerH25 => .oldInner
  | .newInnerH2 | .newInnerH25 => .newInner

/-- Dimension passed to `_group`: forty for outer marginals, thirty-nine for inner marginals. -/
def PhysicalSourceGroup.dimension : PhysicalSourceGroup → ℕ
  | .outerH2 | .outerH25 => 40
  | .oldInnerH2 | .oldInnerH25 | .newInnerH2 | .newInnerH25 => 39

/-- Effective order is always strictly positive. -/
theorem sourceGroup_effectiveOrder_pos (g : PhysicalSourceGroup) :
    0 < g.effectiveOrder := by
  cases g <;> norm_num [PhysicalSourceGroup.effectiveOrder]

/-- Only the two effective orders used by `_group` occur. -/
theorem sourceGroup_effectiveOrder_cases (g : PhysicalSourceGroup) :
    g.effectiveOrder = 2 ∨ g.effectiveOrder = 5 / 2 := by
  cases g <;> simp [PhysicalSourceGroup.effectiveOrder]

/-- Outer groups have dimension forty. -/
theorem dimension_eq_40_of_outer (g : PhysicalSourceGroup) (h : g.isOuter = true) :
    g.dimension = 40 := by
  cases g <;> simp [PhysicalSourceGroup.isOuter, PhysicalSourceGroup.dimension] at h ⊢

/-- Inner groups have dimension thirty-nine. -/
theorem dimension_eq_39_of_inner (g : PhysicalSourceGroup) (h : g.isOuter = false) :
    g.dimension = 39 := by
  cases g <;> simp [PhysicalSourceGroup.isOuter, PhysicalSourceGroup.dimension] at h ⊢

/-- The finite schedule phase created by `_schedule` for every source group. -/
inductive PhysicalSchedulePhase
  | low
  | rankTwo
  | high
  deriving DecidableEq, Repr

instance : Fintype PhysicalSchedulePhase where
  elems := { .low, .rankTwo, .high }
  complete := by intro p; cases p <;> simp

/-- A coarse address before the local bin index is added. -/
structure PhysicalComponentAddress where
  group : PhysicalSourceGroup
  phase : PhysicalSchedulePhase
  deriving DecidableEq, Repr

instance : Fintype PhysicalComponentAddress where
  elems := Finset.univ.biUnion (fun g : PhysicalSourceGroup =>
    Finset.univ.image (fun p : PhysicalSchedulePhase => (⟨g, p⟩ : PhysicalComponentAddress)))
  complete := by
    rintro ⟨g, p⟩
    exact Finset.mem_biUnion.mpr ⟨g, Finset.mem_univ _,
      Finset.mem_image.mpr ⟨p, Finset.mem_univ _, rfl⟩⟩

/-- Six source groups times three schedule phases. -/
set_option maxRecDepth 4096 in
theorem card_physicalComponentAddress :
    Fintype.card PhysicalComponentAddress = 18 := by
  decide

/-- The source construction contains exactly six coarse groups. -/
theorem card_source_groups : Fintype.card PhysicalSourceGroup = 6 := by
  decide

/-- Exactly two coarse source groups are outer. -/
theorem card_outer_source_groups :
    (Finset.univ.filter (fun g : PhysicalSourceGroup => g.isOuter)).card = 2 := by
  decide

/-- Exactly four coarse source groups are inner. -/
theorem card_inner_source_groups :
    (Finset.univ.filter (fun g : PhysicalSourceGroup => !g.isOuter)).card = 4 := by
  decide

#print axioms PhysicalSourceGroup
#print axioms PhysicalSourceGroup.effectiveOrder
#print axioms PhysicalSourceGroup.population
#print axioms PhysicalSourceGroup.dimension
#print axioms sourceGroup_effectiveOrder_pos
#print axioms sourceGroup_effectiveOrder_cases
#print axioms dimension_eq_40_of_outer
#print axioms dimension_eq_39_of_inner
#print axioms PhysicalSchedulePhase
#print axioms card_physicalComponentAddress
#print axioms card_source_groups
#print axioms card_outer_source_groups
#print axioms card_inner_source_groups

end D5.S3.PrimeGaps.PrimeGap186PhysicalSourceGroups
