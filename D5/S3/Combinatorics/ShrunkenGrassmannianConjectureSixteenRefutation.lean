import D5.S3.Combinatorics.ShrunkenGrassmannianThreeCycleDiameter

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.ShrunkenGrassmannianConjectureSixteenRefutation

open D5.S3.Combinatorics.ShrunkenGrassmannianThreeCycleDiameter
  (rotL rotR Step Reach IsVertex ecc diam)
open D5.S3.ConceptDynamics.Completion.CommutingCompletionExchange (normalWord)

/-!
Chervov et al., *CayleyPy-4*, arXiv:2603.22195v1, Conjecture 16 (inverse-closed case): the diameters
of the Schreier coset graphs `S_N / (S_L × S_{N-L})` generated by consecutive `k`-cycles and their
inverses are `⌈L (N - L) / 2⌉` for `k = 3` "from `L ≥ 2`(?)", `L/3 · (N - L)` if `3 ∣ L` and
`⌊(L (N - L) + 2) / 3⌋` otherwise for `k = 4` "from `L ≥ 2`", and
`⌊(L N + 2) / 4⌋ - 2 ⌊L² / 8⌋ - 1_{L ≡ 2 (4)} 1_{N ≡ 2 (4)}` for `k = 5` "for `N, L, N - L` large
enough". The graphs, the central state and both readings of the diameter are those of
`ShrunkenGrassmannianThreeCycleDiameter`. The `k = 4` clause fails at `L = 2`, `N = 5`.
-/

/-- The `k = 4` formula of Conjecture 16. -/
def formulaFour (L N : ℕ) : ℕ :=
  if 3 ∣ L then L / 3 * (N - L) else (L * (N - L) + 2) / 3

/-- The `k = 5` formula of Conjecture 16. -/
def formulaFive (L N : ℕ) : ℕ :=
  (L * N + 2) / 4 - 2 * (L ^ 2 / 8) - (if L % 4 = 2 ∧ N % 4 = 2 then 1 else 0)

/-- Conjecture 16 under a reading `D k L N` of the diameter. -/
def conjSixteen (D : ℕ → ℕ → ℕ → ℕ) : Prop :=
  (∀ L N : ℕ, 2 ≤ L → L ≤ N → 3 < N → D 3 L N = (L * (N - L) + 1) / 2) ∧
  (∀ L N : ℕ, 2 ≤ L → L ≤ N → 4 < N → D 4 L N = formulaFour L N) ∧
  (∃ C : ℕ, ∀ L N : ℕ, C ≤ L → C ≤ N - L → D 5 L N = formulaFive L N)

/-- Conjecture 16 holds under at least one of the two readings of the diameter. -/
def claim : Prop := conjSixteen ecc ∨ conjSixteen diam

/-- Conjecture 16 is false under both readings: at `k = 4`, `L = 2`, `N = 5` the word `11010` is
not within two moves of `00111`, while the formula gives `⌊8 / 3⌋ = 2`. -/
theorem result : ¬ claim := by
  -- the words reached within `m` moves, listed
  let nbrs : ℕ → List Bool → List (List Bool) := fun k z =>
    (List.range (z.length + 1 - k)).flatMap fun i => [rotL k i z, rotR k i z]
  let ball : ℕ → ℕ → List Bool → List (List Bool) := fun k m x =>
    Nat.rec [x] (fun _ b => b ++ b.flatMap (nbrs k)) m
  have hstep : ∀ (k : ℕ) (z y : List Bool), Step k z y → y ∈ nbrs k z := by
    intro k z y ⟨i, hi, hy⟩
    simp only [nbrs, List.mem_flatMap, List.mem_range]
    exact ⟨i, by omega, by rcases hy with rfl | rfl <;> simp⟩
  have hball : ∀ (k m : ℕ) (x y : List Bool), Reach k m x y → y ∈ ball k m x := by
    intro k m
    induction m with
    | zero => intro x y h; rw [show y = x from h]; simp [ball]
    | succ m ih =>
      intro x y h
      show y ∈ ball k m x ++ (ball k m x).flatMap (nbrs k)
      rcases h with h | ⟨z, hz, hzy⟩
      · exact List.mem_append_left _ (ih x y h)
      · exact List.mem_append_right _ (List.mem_flatMap.2 ⟨z, ih x z hz, hstep k z y hzy⟩)
  have hfar : ¬ Reach 4 2 [false, false, true, true, true] [true, true, false, true, false] := by
    intro h
    have := hball 4 2 _ _ h
    revert this
    decide
  have hv : IsVertex 2 5 [true, true, false, true, false] := ⟨rfl, rfl⟩
  have hc : IsVertex 2 5 (normalWord 2 (5 - 2)) := ⟨rfl, rfl⟩
  have hcen : normalWord 2 (5 - 2) = [false, false, true, true, true] := rfl
  have hecc : ecc 4 2 5 ≠ 2 := by
    intro h
    have hne : {m | ∀ y, IsVertex 2 5 y → Reach 4 m (normalWord 2 (5 - 2)) y}.Nonempty := by
      by_contra hem
      rw [Set.not_nonempty_iff_eq_empty] at hem
      simp [ecc, hem] at h
    have hmem := Nat.sInf_mem hne
    rw [show sInf {m | ∀ y, IsVertex 2 5 y → Reach 4 m (normalWord 2 (5 - 2)) y} = 2 from h] at hmem
    exact hfar (hcen ▸ hmem _ hv)
  have hdiam : diam 4 2 5 ≠ 2 := by
    intro h
    have hne : {m | ∀ x y, IsVertex 2 5 x → IsVertex 2 5 y → Reach 4 m x y}.Nonempty := by
      by_contra hem
      rw [Set.not_nonempty_iff_eq_empty] at hem
      simp [diam, hem] at h
    have hmem := Nat.sInf_mem hne
    rw [show sInf {m | ∀ x y, IsVertex 2 5 x → IsVertex 2 5 y → Reach 4 m x y} = 2 from h] at hmem
    exact hfar (hcen ▸ hmem _ _ hc hv)
  have hf : formulaFour 2 5 = 2 := by decide
  rintro (h | h)
  · exact hecc ((h.2.1 2 5 le_rfl (by omega) (by omega)).trans hf)
  · exact hdiam ((h.2.1 2 5 le_rfl (by omega) (by omega)).trans hf)

#print axioms result

end D5.S3.Combinatorics.ShrunkenGrassmannianConjectureSixteenRefutation
