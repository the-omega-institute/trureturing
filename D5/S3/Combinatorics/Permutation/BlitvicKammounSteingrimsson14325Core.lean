   digest: Exact window chains and forced endpoints for actual 14325 packings. -/

import D5.S3.Combinatorics.Permutation.PackingMaximumRefutation
import Mathlib.Tactic.IntervalCases
import Mathlib.GroupTheory.Perm.Fin
import Mathlib.Data.Fintype.Perm
import D5.S3.Combinatorics.Permutation.BlitvicKammounSteingrimsson14325Transfer

/-! All permutations and all window comparisons retain the literal source meaning.
The source length is 5+(j-1)*3, equal to 3j+2 when j≥1.
Escape audits: https://github.com/the-omega-institute/trureturing/issues/28504.
-/

set_option autoImplicit false

namespace D5.S3.Combinatorics.Permutation.BlitvicKammounSteingrimsson14325Core

open PackingMaximumRefutation

/-- Source pattern 14325 with one subtracted from every rank. -/
def pattern : Fin 5 → Fin 5 := ![0, 3, 2, 1, 4]

/-- The complete chain generated by window t. -/
def WindowChain (j : ℕ) (f : ℕ → ℕ) : Prop :=
  ∀ t < j, f (3 * t) < f (3 * t + 3) ∧
    f (3 * t + 3) < f (3 * t + 2) ∧
    f (3 * t + 2) < f (3 * t + 1) ∧
    f (3 * t + 1) < f (3 * t + 4)

private def rank {N : ℕ} (w : Fin N → Fin N) (i : ℕ) : ℕ :=
  if h : i < N then (w ⟨i, h⟩).val else 0

private theorem rank_window (j : ℕ)
    (w : Fin (5 + (j - 1) * 3) → Fin (5 + (j - 1) * 3))
    (t : Fin j) (a : Fin 5) :
    rank w (3 * t.val + a.val) = (w (windowIndex 5 2 j t a)).val := by
  have hb := (windowIndex 5 2 j t a).isLt
  change t.val * 3 + a.val < 5 + (j - 1) * 3 at hb
  have he : 3 * t.val + a.val = t.val * 3 + a.val := by omega
  rw [he]
  simp [rank, hb, windowIndex]

private theorem packing_chain_iff (j : ℕ)
    (w : Fin (5 + (j - 1) * 3) → Fin (5 + (j - 1) * 3)) :
    Packs pattern 2 j w ↔ WindowChain j (rank w) := by
  constructor
  · intro h t ht
    let tt : Fin j := ⟨t, ht⟩
    have h03 := (h tt 0 3).mpr (by decide : pattern 0 < pattern 3)
    have h32 := (h tt 3 2).mpr (by decide : pattern 3 < pattern 2)
    have h21 := (h tt 2 1).mpr (by decide : pattern 2 < pattern 1)
    have h14 := (h tt 1 4).mpr (by decide : pattern 1 < pattern 4)
    have hh0 := rank_window j w tt 0
    have hh1 := rank_window j w tt 1
    have hh2 := rank_window j w tt 2
    have hh3 := rank_window j w tt 3
    have hh4 := rank_window j w tt 4
    norm_num at hh0 hh1 hh2 hh3 hh4
    simp only [Fin.lt_def] at h03 h32 h21 h14
    rw [← hh0, ← hh3] at h03
    rw [← hh3, ← hh2] at h32
    rw [← hh2, ← hh1] at h21
    rw [← hh1, ← hh4] at h14
    exact ⟨h03, h32, h21, h14⟩
  · intro h t a b
    obtain ⟨h03, h32, h21, h14⟩ := h t.val t.isLt
    have hh0 := rank_window j w t 0
    have hh1 := rank_window j w t 1
    have hh2 := rank_window j w t 2
    have hh3 := rank_window j w t 3
    have hh4 := rank_window j w t 4
    norm_num at hh0 hh1 hh2 hh3 hh4
    rw [hh0, hh3] at h03
    rw [hh3, hh2] at h32
    rw [hh2, hh1] at h21
    rw [hh1, hh4] at h14
    fin_cases a <;> fin_cases b <;>
      simp only [pattern, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Fin.lt_def] <;>
      norm_num <;> omega

private theorem chain_bounds (j : ℕ) (hj : 1 ≤ j) (f : ℕ → ℕ)
    (h : WindowChain j f) (x : ℕ) (hx : x ≤ 3 * j + 1) :
    f 0 ≤ f x ∧ f x ≤ f (3 * j + 1) := by
  induction j generalizing x with
  | zero => omega
  | succ j ih =>
    by_cases hz : j = 0
    · subst j
      obtain ⟨ha, hb, hc, hd⟩ := h 0 (by decide)
      norm_num at ha hb hc hd hx ⊢
      interval_cases x <;> omega
    · have hjp : 1 ≤ j := by omega
      have hold : WindowChain j f := fun t ht => h t (by omega)
      obtain ⟨ha, hb, hc, hd⟩ := h j (by omega)
      have hbase := ih hjp hold (3 * j) (by omega)
      by_cases hsmall : x ≤ 3 * j + 1
      · have hh := ih hjp hold x hsmall
        have he : 3 * (j + 1) + 1 = 3 * j + 4 := by omega
        rw [he]
        omega
      · have he : 3 * (j + 1) + 1 = 3 * j + 4 := by omega
        rw [he]
        have cases : x = 3 * j + 2 ∨ x = 3 * j + 3 ∨ x = 3 * j + 4 := by omega
        rcases cases with rfl | rfl | rfl <;> omega

/-- Every source rank lies between the first and last positions. -/
theorem packing_bounds (j : ℕ) (hj : 1 ≤ j)
    (w : Fin (5 + (j - 1) * 3) → Fin (5 + (j - 1) * 3))
    (h : Packs pattern 2 j w) (x : Fin (5 + (j - 1) * 3)) :
    w ⟨0, by omega⟩ ≤ w x ∧ w x ≤ w ⟨3 * j + 1, by omega⟩ := by
  have hc := (packing_chain_iff j w).mp h
  have he : 5 + (j - 1) * 3 = 3 * j + 2 := by omega
  have hb := chain_bounds j hj (rank w) hc x.val (by have := x.isLt; omega)
  have hzero : 0 < 5 + (j - 1) * 3 := by omega
  have hend : 3 * j + 1 < 5 + (j - 1) * 3 := by omega
  change (w ⟨0, hzero⟩).val ≤ (w x).val ∧ (w x).val ≤ (w ⟨3 * j + 1, hend⟩).val
  simpa only [rank, dite_eq_left x.isLt, dite_eq_left hzero, dite_eq_left hend, Fin.eta] using hb

/-- Bijectivity forces the endpoints to be the least and greatest actual ranks. -/
theorem packing_extrema (j : ℕ) (hj : 1 ≤ j)
    (w : Equiv.Perm (Fin (5 + (j - 1) * 3))) (h : Packs pattern 2 j w) :
    (w ⟨0, by omega⟩).val = 0 ∧
      (w ⟨3 * j + 1, by omega⟩).val = 3 * j + 1 := by
  obtain ⟨lo, hlo⟩ := w.surjective ⟨0, by omega⟩
  obtain ⟨hi, hhi⟩ := w.surjective ⟨3 * j + 1, by omega⟩
  have hlow := (packing_bounds j hj w h lo).1
  have hhigh := (packing_bounds j hj w h hi).2
  rw [hlo] at hlow
  rw [hhi] at hhigh
  have hend := (w ⟨3 * j + 1, by omega⟩).isLt
  simp only [Fin.le_def] at hlow hhigh
  constructor <;> omega

/-- The endpoint-deleted grid: indices `3t+2,3t+1,3t` are x, y, z.
Only the column chains and the two horizontal chains are prescribed. -/
def Grid (j : ℕ) (q : Equiv.Perm (Fin (3 * j))) : Prop :=
  (∀ t (ht : t < j),
    q ⟨3 * t + 2, by omega⟩ < q ⟨3 * t + 1, by omega⟩ ∧
    q ⟨3 * t + 1, by omega⟩ < q ⟨3 * t, by omega⟩) ∧
  (∀ t (ht : t + 1 < j),
    q ⟨3 * t + 2, by omega⟩ < q ⟨3 * t + 5, by omega⟩ ∧
    q ⟨3 * t, by omega⟩ < q ⟨3 * t + 3, by omega⟩)

/-- Actual rank assignments to the grid, without a symmetry quotient. -/
def GridPacking (j : ℕ) := {q : Equiv.Perm (Fin (3 * j)) // Grid j q}

private def addEndsFun {N : ℕ} (q : Equiv.Perm (Fin N)) (x : Fin (N + 2)) :
    Fin (N + 2) :=
  if h0 : x.val = 0 then 0
  else if hlast : x.val = N + 1 then ⟨N + 1, by omega⟩
  else ⟨(q ⟨x.val - 1, by omega⟩).val + 1, by have := (q ⟨x.val - 1, by omega⟩).isLt; omega⟩

private theorem addEndsFun_inv {N : ℕ} (q : Equiv.Perm (Fin N))
    (x : Fin (N + 2)) : addEndsFun q.symm (addEndsFun q x) = x := by
  by_cases h0 : x.val = 0
  · have hx : x = 0 := Fin.ext h0
    subst x
    simp [addEndsFun]
  · by_cases hl : x.val = N + 1
    · simp [addEndsFun, h0, hl]
      exact Fin.ext hl.symm
    · have hm : x.val - 1 < N := by omega
      have hq := (q ⟨x.val - 1, hm⟩).isLt
      have hne : (q ⟨x.val - 1, hm⟩).val + 1 ≠ N + 1 := by omega
      simp only [addEndsFun, h0, hl, ↓reduceDIte, Nat.add_eq_zero_iff,
        one_ne_zero, and_false, hne, Nat.add_sub_cancel]
      have he := q.symm_apply_apply ⟨x.val - 1, hm⟩
      apply Fin.ext
      change (q.symm (q ⟨x.val - 1, hm⟩)).val + 1 = x.val
      rw [he]
      simp only [Fin.val_mk]
      omega

private def addEnds {N : ℕ} (q : Equiv.Perm (Fin N)) : Equiv.Perm (Fin (N + 2)) where
  toFun := addEndsFun q
  invFun := addEndsFun q.symm
  left_inv := addEndsFun_inv q
  right_inv := addEndsFun_inv q.symm

private theorem addEnds_middle {N : ℕ} (q : Equiv.Perm (Fin N)) (i : Fin N) :
    (addEnds q ⟨i.val + 1, by omega⟩).val = (q i).val + 1 := by
  have hi := i.isLt
  simp [addEnds, addEndsFun, show i.val ≠ N by omega]

private def removeEndsFun {N : ℕ} (w : Equiv.Perm (Fin (N + 2)))
    (h0 : w 0 = 0) (hl : w ⟨N + 1, by omega⟩ = ⟨N + 1, by omega⟩)
    (x : Fin N) : Fin N :=
  ⟨(w ⟨x.val + 1, by omega⟩).val - 1, by
    have hx := x.isLt
    have hw := (w ⟨x.val + 1, by omega⟩).isLt
    have hn : (w ⟨x.val + 1, by omega⟩).val ≠ N + 1 := by
      intro he
      have := w.injective ((Fin.ext he).trans hl.symm)
      have := congrArg Fin.val this
      simp only [Fin.val_mk] at this
      omega
    omega⟩

private theorem removeEnds_pos {N : ℕ} (w : Equiv.Perm (Fin (N + 2)))
    (h0 : w 0 = 0) (x : Fin N) : 0 < (w ⟨x.val + 1, by omega⟩).val := by
  have hx := x.isLt
  by_contra h
  have he : w ⟨x.val + 1, by omega⟩ = w 0 := by
    rw [h0]
    apply Fin.ext
    simp only [Fin.val_zero]
    omega
  have := congrArg Fin.val (w.injective he)
  simp only [Fin.val_zero] at this
  omega

private noncomputable def removeEnds {N : ℕ} (w : Equiv.Perm (Fin (N + 2)))
    (h0 : w 0 = 0) (hl : w ⟨N + 1, by omega⟩ = ⟨N + 1, by omega⟩) :
    Equiv.Perm (Fin N) :=
  Equiv.ofBijective (removeEndsFun w h0 hl) (by
    apply (Finite.injective_iff_bijective).mp
    intro x y hxy
    have hp := removeEnds_pos w h0 x
    have hq := removeEnds_pos w h0 y
    have he := congrArg Fin.val hxy
    change (w ⟨x.val + 1, by omega⟩).val - 1 =
      (w ⟨y.val + 1, by omega⟩).val - 1 at he
    have hw : w ⟨x.val + 1, by omega⟩ = w ⟨y.val + 1, by omega⟩ :=
      Fin.ext (by omega)
    have hv := congrArg Fin.val (w.injective hw)
    change x.val + 1 = y.val + 1 at hv
    apply Fin.ext
    omega)

private theorem removeEnds_middle {N : ℕ} (w : Equiv.Perm (Fin (N + 2)))
    (h0 : w 0 = 0) (hl : w ⟨N + 1, by omega⟩ = ⟨N + 1, by omega⟩)
    (i : Fin N) : (removeEnds w h0 hl i).val + 1 =
      (w ⟨i.val + 1, by omega⟩).val := by
  have := removeEnds_pos w h0 i
  change (w ⟨i.val + 1, by omega⟩).val - 1 + 1 = _
  omega

private theorem add_removeEnds {N : ℕ} (w : Equiv.Perm (Fin (N + 2)))
    (h0 : w 0 = 0) (hl : w ⟨N + 1, by omega⟩ = ⟨N + 1, by omega⟩) :
    addEnds (removeEnds w h0 hl) = w := by
  ext x
  by_cases hz : x.val = 0
  · have hx : x = 0 := Fin.ext hz
    subst x
    simpa [addEnds, addEndsFun] using congrArg Fin.val h0.symm
  · by_cases ht : x.val = N + 1
    · have hx : x = ⟨N + 1, by omega⟩ := Fin.ext ht
      have hw : w x = ⟨N + 1, by omega⟩ := (congrArg w hx).trans hl
      simpa [addEnds, addEndsFun, hz, ht] using congrArg Fin.val hw.symm
    · have hx : x.val - 1 < N := by have := x.isLt; omega
      have he := removeEnds_middle w h0 hl ⟨x.val - 1, hx⟩
      have hi : (⟨(⟨x.val - 1, hx⟩ : Fin N).val + 1, by omega⟩ : Fin (N + 2)) = x :=
        Fin.ext (by simp only [Fin.val_mk]; omega)
      rw [hi] at he
      simpa [addEnds, addEndsFun, hz, ht] using he

private theorem addEnds_injective {N : ℕ} : Function.Injective (@addEnds N) := by
  intro q r h
  ext i
  have he := congrArg (fun w : Equiv.Perm (Fin (N + 2)) =>
    (w ⟨i.val + 1, by omega⟩).val) h
  rw [addEnds_middle, addEnds_middle] at he
  omega

private theorem addEnds_rank {N : ℕ} (q : Equiv.Perm (Fin N)) (i : ℕ) (hi : i < N) :
    rank (addEnds q) (i + 1) = (q ⟨i, hi⟩).val + 1 := by
  have hb : i + 1 < N + 2 := by omega
  simp only [rank, dif_pos hb]
  exact addEnds_middle q ⟨i, hi⟩

private theorem grid_addEnds_iff (j : ℕ) (q : Equiv.Perm (Fin (3 * j))) :
    WindowChain j (rank (addEnds q)) ↔ Grid j q := by
  have hm (i a : ℕ) (ha : a < 3 * j) (he : i = a + 1) :
      rank (addEnds q) i = (q ⟨a, ha⟩).val + 1 := by
    rw [he]
    exact addEnds_rank q a ha
  constructor
  · intro h
    constructor
    · intro t ht
      obtain ⟨ha, hb, hc, hd⟩ := h t ht
      have h3 := hm (3 * t + 3) (3 * t + 2) (by omega) (by omega)
      have h2 := hm (3 * t + 2) (3 * t + 1) (by omega) (by omega)
      have h1 := hm (3 * t + 1) (3 * t) (by omega) (by omega)
      rw [h3, h2] at hb
      rw [h2, h1] at hc
      simp only [Fin.lt_def]
      exact ⟨by omega, by omega⟩
    · intro t ht
      have he := (h (t + 1) ht).1
      have hd := (h t (by omega)).2.2.2
      have h0 := hm (3 * (t + 1)) (3 * t + 2) (by omega) (by omega)
      have h3 := hm (3 * (t + 1) + 3) (3 * t + 5) (by omega) (by omega)
      have h1 := hm (3 * t + 1) (3 * t) (by omega) (by omega)
      have h4 := hm (3 * t + 4) (3 * t + 3) (by omega) (by omega)
      rw [h0, h3] at he
      rw [h1, h4] at hd
      simp only [Fin.lt_def]
      exact ⟨by omega, by omega⟩
  · rintro ⟨hc, hh⟩ t ht
    obtain ⟨hxy, hyz⟩ := hc t ht
    simp only [Fin.lt_def] at hxy hyz
    have h3 := hm (3 * t + 3) (3 * t + 2) (by omega) (by omega)
    have h2 := hm (3 * t + 2) (3 * t + 1) (by omega) (by omega)
    have h1 := hm (3 * t + 1) (3 * t) (by omega) (by omega)
    refine ⟨?_, ?_, ?_, ?_⟩
    · by_cases ht0 : t = 0
      · subst t
        rw [h3]
        simp [rank, addEnds, addEndsFun]
      · have ha := (hh (t - 1) (by omega)).1
        simp only [Fin.lt_def] at ha
        have h0 := hm (3 * t) (3 * (t - 1) + 2) (by omega) (by omega)
        have hq : (q ⟨3 * (t - 1) + 5, by omega⟩).val =
            (q ⟨3 * t + 2, by omega⟩).val := by
          apply congrArg (fun i : Fin (3 * j) => (q i).val)
          apply Fin.ext
          change 3 * (t - 1) + 5 = 3 * t + 2
          omega
        rw [hq] at ha
        rw [h0, h3]
        omega
    · rw [h3, h2]; omega
    · rw [h2, h1]; omega
    · by_cases hlast : t + 1 < j
      · have ha := (hh t hlast).2
        simp only [Fin.lt_def] at ha
        have h4 := hm (3 * t + 4) (3 * t + 3) (by omega) (by omega)
        rw [h1, h4]
        omega
      · have he : 3 * t + 4 = 3 * j + 1 := by omega
        rw [h1, he]
        have hq := (q ⟨3 * t, by omega⟩).isLt
        simpa [rank, addEnds, addEndsFun] using Nat.add_lt_add_right hq 1

private def sourceTransport (j : ℕ) (hj : 1 ≤ j) :
    Equiv.Perm (Fin (5 + (j - 1) * 3)) ≃ Equiv.Perm (Fin (3 * j + 2)) :=
  (finCongr (by omega : 5 + (j - 1) * 3 = 3 * j + 2)).permCongr

private theorem sourceTransport_rank (j : ℕ) (hj : 1 ≤ j)
    (w : Equiv.Perm (Fin (5 + (j - 1) * 3))) :
    rank (sourceTransport j hj w) = rank w := by
  funext i
  by_cases hi : i < 5 + (j - 1) * 3
  · have hi' : i < 3 * j + 2 := by omega
    simp [rank, hi, hi', sourceTransport, Equiv.permCongr_apply]
  · have hi' : ¬ i < 3 * j + 2 := by omega
    simp [rank, hi, hi']

private theorem normalized_endpoints (j : ℕ) (hj : 1 ≤ j)
    (w : SourcePacking pattern 2 j) :
    sourceTransport j hj w.val 0 = 0 ∧
      sourceTransport j hj w.val ⟨3 * j + 1, by omega⟩ = ⟨3 * j + 1, by omega⟩ := by
  have he := packing_extrema j hj w.val w.property
  constructor
  · apply Fin.ext
    simpa [sourceTransport, Equiv.permCongr_apply] using he.1
  · apply Fin.ext
    simpa [sourceTransport, Equiv.permCongr_apply] using he.2

/-- Delete the two forced endpoint ranks, preserving every literal comparison. -/
noncomputable def packingGridEquiv (j : ℕ) (hj : 1 ≤ j) :
    SourcePacking pattern 2 j ≃ GridPacking j where
  toFun w := by
    let v := sourceTransport j hj w.val
    have he := normalized_endpoints j hj w
    let q := removeEnds v he.1 he.2
    refine ⟨q, (grid_addEnds_iff j q).mp ?_⟩
    rw [show addEnds q = v from add_removeEnds v he.1 he.2]
    rw [show rank v = rank w.val from sourceTransport_rank j hj w.val]
    exact (packing_chain_iff j w.val).mp w.property
  invFun q := by
    let w := (sourceTransport j hj).symm (addEnds q.val)
    refine ⟨w, (packing_chain_iff j w).mpr ?_⟩
    have he := sourceTransport_rank j hj w
    have hw : sourceTransport j hj w = addEnds q.val :=
      (sourceTransport j hj).apply_symm_apply _
    rw [hw] at he
    rw [← he]
    exact (grid_addEnds_iff j q.val).mpr q.property
  left_inv w := by
    apply Subtype.ext
    apply (sourceTransport j hj).injective
    simp only [Equiv.apply_symm_apply]
    exact add_removeEnds _ _ _
  right_inv q := by
    apply Subtype.ext
    apply addEnds_injective
    simp only [Equiv.apply_symm_apply]
    exact add_removeEnds _ _ _

/-- The actual source count is exactly the number of grid rank assignments. -/
theorem count_eq_grid (j : ℕ) (hj : 1 ≤ j) :
    count pattern 2 j = Nat.card (GridPacking j) := by
  exact Nat.card_congr (packingGridEquiv j hj)


/-! Appending a column uses ordinary ordered rank insertion. -/

private noncomputable def appendRank {N : ℕ} (a : Fin (N + 1))
    (q : Equiv.Perm (Fin N)) : Equiv.Perm (Fin (N + 1)) :=
  Equiv.ofBijective (Fin.lastCases a (fun i => a.succAbove (q i))) (by
    apply (Finite.injective_iff_bijective).mp
    intro i k h
    induction i using Fin.lastCases <;> induction k using Fin.lastCases <;>
      simp_all only [Fin.lastCases_last, Fin.lastCases_castSucc,
        Fin.succAbove_ne, Fin.succAbove_right_inj, EmbeddingLike.apply_eq_iff_eq]
    exact (Fin.succAbove_ne a (q _) h.symm).elim)

private theorem appendRank_last {N : ℕ} (a : Fin (N + 1)) (q : Equiv.Perm (Fin N)) :
    appendRank a q (Fin.last N) = a := by simp [appendRank]

private theorem appendRank_old {N : ℕ} (a : Fin (N + 1)) (q : Equiv.Perm (Fin N))
    (i : Fin N) : appendRank a q i.castSucc = a.succAbove (q i) := by
  simp [appendRank]

private theorem appendRank_bijective (N : ℕ) :
    Function.Bijective (fun p : Fin (N + 1) × Equiv.Perm (Fin N) => appendRank p.1 p.2) := by
  rw [Nat.bijective_iff_injective_and_card]
  constructor
  · rintro ⟨a,q⟩ ⟨b,r⟩ h
    have hab : a = b := by simpa only [appendRank_last] using congrArg (fun w => w (Fin.last N)) h
    subst b
    have hqr : q = r := by
      ext i
      have hh := congrArg (fun w => w i.castSucc) h
      exact congrArg Fin.val ((Fin.succAbove_right_inj).mp (by simpa only [appendRank_old] using hh))
    subst r
    rfl
  · rw [Nat.card_prod, Nat.card_perm, Nat.card_perm, Nat.card_eq_fintype_card,
      Fintype.card_fin, Nat.factorial_succ]
    simp

private theorem appendRank_inj {N : ℕ} {a b : Fin (N + 1)}
    {q r : Equiv.Perm (Fin N)} (h : appendRank a q = appendRank b r) :
    a = b ∧ q = r := by
  have hp := (appendRank_bijective N).injective (a₁ := (a,q)) (a₂ := (b,r)) h
  exact ⟨congrArg Prod.fst hp, congrArg Prod.snd hp⟩

private noncomputable def appendEquiv (N : ℕ) :
    (Fin (N + 1) × Equiv.Perm (Fin N)) ≃ Equiv.Perm (Fin (N + 1)) :=
  Equiv.ofBijective _ (appendRank_bijective N)

private noncomputable def appendColumn {N : ℕ} (q : Equiv.Perm (Fin N))
    (a : Fin (N + 3)) (b : Fin (N + 2)) : Equiv.Perm (Fin (N + 3)) :=
  appendRank a (appendRank b (appendRank (Fin.last N) q))

private theorem appendColumn_old {N : ℕ} (q : Equiv.Perm (Fin N))
    (a : Fin (N + 3)) (b : Fin (N + 2)) (i : Fin N) :
    appendColumn q a b i.castSucc.castSucc.castSucc =
      a.succAbove (b.succAbove (q i).castSucc) := by
  simp [appendColumn, appendRank_old, Fin.succAbove_last]

private theorem appendColumn_z {N : ℕ} (q : Equiv.Perm (Fin N))
    (a : Fin (N + 3)) (b : Fin (N + 2)) :
    appendColumn q a b (Fin.last N).castSucc.castSucc =
      a.succAbove (b.succAbove (Fin.last N)) := by
  simp [appendColumn, appendRank_old, appendRank_last]

private theorem appendColumn_y {N : ℕ} (q : Equiv.Perm (Fin N))
    (a : Fin (N + 3)) (b : Fin (N + 2)) :
    appendColumn q a b (Fin.last (N + 1)).castSucc = a.succAbove b := by
  simp [appendColumn, appendRank_old, appendRank_last]

private theorem appendColumn_x {N : ℕ} (q : Equiv.Perm (Fin N))
    (a : Fin (N + 3)) (b : Fin (N + 2)) :
    appendColumn q a b (Fin.last (N + 2)) = a := by
  simp [appendColumn, appendRank_last]


private theorem appendColumn_grid_iff (j : ℕ) (hj : 1 ≤ j)
    (q : Equiv.Perm (Fin (3 * j))) (a : Fin (3 * j + 3)) (b : Fin (3 * j + 2)) :
    Grid (j + 1) (appendColumn q a b) ↔
      Grid j q ∧ (q ⟨3 * (j - 1) + 2, by omega⟩).val < a.val ∧
        a.val ≤ b.val ∧ b.val ≤ 3 * j := by
  let lift : Fin (3 * j) → Fin (3 * j + 3) :=
    fun v => a.succAbove (b.succAbove v.castSucc)
  have old (i : ℕ) (hi : i < 3 * j) :
      appendColumn q a b ⟨i, by omega⟩ = lift (q ⟨i, hi⟩) := by
    exact appendColumn_old q a b ⟨i, hi⟩
  have mono (u v : Fin (3 * j)) : lift u < lift v ↔ u < v := by
    simp only [lift, Fin.succAbove_lt_succAbove_iff, Fin.castSucc_lt_castSucc_iff]
  have ex : appendColumn q a b ⟨3 * j + 2, by omega⟩ = a := appendColumn_x q a b
  have ey : appendColumn q a b ⟨3 * j + 1, by omega⟩ = a.succAbove b := appendColumn_y q a b
  have ez : appendColumn q a b ⟨3 * j, by omega⟩ =
      a.succAbove (b.succAbove (Fin.last (3 * j))) := appendColumn_z q a b
  constructor
  · intro h
    have hc := h.1 j (by omega)
    rw [ex, ey, ez] at hc
    have hab : a.val ≤ b.val := by
      have := (Fin.lt_succAbove_iff_le_castSucc a b).mp hc.1
      exact this
    have hb : b.val ≤ 3 * j := by
      have hh := (Fin.succAbove_lt_succAbove_iff (p := a)).mp hc.2
      have := (Fin.lt_succAbove_iff_le_castSucc b (Fin.last (3 * j))).mp hh
      exact this
    refine ⟨⟨?_, ?_⟩, ?_, hab, hb⟩
    · intro t ht
      have hh := h.1 t (by omega)
      rw [old _ (by omega), old _ (by omega), old _ (by omega)] at hh
      exact ⟨(mono _ _).mp hh.1, (mono _ _).mp hh.2⟩
    · intro t ht
      have hh := h.2 t (by omega)
      rw [old _ (by omega), old _ (by omega), old _ (by omega), old _ (by omega)] at hh
      exact ⟨(mono _ _).mp hh.1, (mono _ _).mp hh.2⟩
    · have hh := (h.2 (j - 1) (by omega)).1
      have he : 3 * (j - 1) + 5 = 3 * j + 2 := by omega
      simp only [he] at hh
      rw [old _ (by omega), ex] at hh
      have hh' := (Fin.succAbove_lt_iff_castSucc_lt a _).mp hh
      simp only [lift, Fin.succAbove, Fin.lt_def, Fin.val_castSucc] at hh'
      split_ifs at hh' <;> simp only [Fin.val_castSucc, Fin.val_succ] at hh' <;> omega
  · rintro ⟨hq, hqa, hab, hb⟩
    constructor
    · intro t ht
      by_cases he : t = j
      · subst t
        rw [ex, ey, ez]
        refine ⟨(Fin.lt_succAbove_iff_le_castSucc a b).mpr hab, ?_⟩
        apply (Fin.succAbove_lt_succAbove_iff (p := a)).mpr
        exact (Fin.lt_succAbove_iff_le_castSucc b (Fin.last (3 * j))).mpr hb
      · have ht' : t < j := by omega
        rw [old _ (by omega), old _ (by omega), old _ (by omega)]
        exact ⟨(mono _ _).mpr (hq.1 t ht').1, (mono _ _).mpr (hq.1 t ht').2⟩
    · intro t ht
      by_cases he : t + 1 = j
      · have ht' : t = j - 1 := by omega
        subst t
        have hi : 3 * (j - 1) + 5 = 3 * j + 2 := by omega
        have hz : 3 * (j - 1) + 3 = 3 * j := by omega
        simp only [hi, hz]
        rw [old _ (by omega), ex, old _ (by omega), ez]
        constructor
        · apply (Fin.succAbove_lt_iff_castSucc_lt a _).mpr
          have hqb : (q ⟨3 * (j - 1) + 2, by omega⟩).val < b.val := by omega
          change (b.succAbove (q ⟨3 * (j - 1) + 2, by omega⟩).castSucc).val < a.val
          rw [Fin.succAbove_of_castSucc_lt b _ (show
            (q ⟨3 * (j - 1) + 2, by omega⟩).castSucc.castSucc < b from hqb)]
          exact hqa
        · exact (Fin.succAbove_lt_succAbove_iff (p := a)).mpr
            ((Fin.succAbove_lt_succAbove_iff (p := b)).mpr (Fin.castSucc_lt_last _))
      · have ht' : t + 1 < j := by omega
        rw [old _ (by omega), old _ (by omega), old _ (by omega), old _ (by omega)]
        exact ⟨(mono _ _).mpr (hq.2 t ht').1, (mono _ _).mpr (hq.2 t ht').2⟩


private theorem grid_last_z (j : ℕ) (w : GridPacking (j + 1)) :
    w.val ⟨3 * j, by omega⟩ = Fin.last (3 * j + 2) := by
  have zm (a b : ℕ) (hab : a ≤ b) (hb : b < j + 1) :
      (w.val ⟨3 * a, by omega⟩).val ≤ (w.val ⟨3 * b, by omega⟩).val := by
    induction hab with
    | refl => rfl
    | @step b hab ih =>
      exact le_trans (ih (by omega)) (le_of_lt (w.property.2 b (by omega)).2)
  have upper (i : Fin (3 * (j + 1))) :
      (w.val i).val ≤ (w.val ⟨3 * j, by omega⟩).val := by
    let t := i.val / 3
    have hit : i.val = 3 * t + i.val % 3 := by omega
    have hrem := Nat.mod_lt i.val (by decide : 0 < 3)
    have ht : t < j + 1 := by have := i.isLt; omega
    have hc := w.property.1 t ht
    have hh := zm t j (by omega) (by omega)
    have he : i.val = 3 * t ∨ i.val = 3 * t + 1 ∨ i.val = 3 * t + 2 := by omega
    rcases he with he | he | he
    · have hi : i = ⟨3 * t, by omega⟩ := Fin.ext he
      simpa only [hi] using hh
    · have hi : i = ⟨3 * t + 1, by omega⟩ := Fin.ext he
      rw [hi]
      exact le_trans (le_of_lt hc.2) hh
    · have hi : i = ⟨3 * t + 2, by omega⟩ := Fin.ext he
      rw [hi]
      exact le_trans (le_of_lt (lt_trans hc.1 hc.2)) hh
  obtain ⟨i, hi⟩ := w.val.surjective (Fin.last (3 * j + 2))
  apply Fin.ext
  have hh := upper i
  rw [hi] at hh
  have hb := (w.val ⟨3 * j, by omega⟩).isLt
  simp only [Fin.val_last] at hh ⊢
  omega

private theorem grid_decompose (j : ℕ) (hj : 1 ≤ j) (w : GridPacking (j + 1)) :
    ∃ (q : Equiv.Perm (Fin (3 * j))) (a : Fin (3 * j + 3)) (b : Fin (3 * j + 2)),
      w.val = appendColumn q a b ∧ Grid j q ∧
        (q ⟨3 * (j - 1) + 2, by omega⟩).val < a.val ∧
        a.val ≤ b.val ∧ b.val ≤ 3 * j := by
  obtain ⟨⟨a,u⟩, hu⟩ := (appendEquiv (3 * j + 2)).surjective w.val
  obtain ⟨⟨b,v⟩, hv⟩ := (appendEquiv (3 * j + 1)).surjective u
  obtain ⟨⟨c,q⟩, hq⟩ := (appendEquiv (3 * j)).surjective v
  change appendRank a u = w.val at hu
  change appendRank b v = u at hv
  change appendRank c q = v at hq
  have htop := grid_last_z j w
  rw [← hu, ← hv, ← hq] at htop
  change appendRank a (appendRank b (appendRank c q))
    (Fin.last (3 * j)).castSucc.castSucc = Fin.last (3 * j + 2) at htop
  rw [appendRank_old, appendRank_old, appendRank_last] at htop
  have hc : c = Fin.last (3 * j) := by
    apply Fin.ext
    have hcv := c.isLt
    have hval := congrArg Fin.val htop
    simp only [Fin.succAbove, Fin.lt_def, Fin.val_castSucc, Fin.val_succ,
      Fin.val_last] at hval
    split_ifs at hval <;>
      simp only [Fin.val_castSucc, Fin.val_succ, Fin.val_last] at * <;> omega
  subst c
  have he : w.val = appendColumn q a b := by
    rw [← hu, ← hv, ← hq]
    rfl
  refine ⟨q, a, b, he, ?_⟩
  exact (appendColumn_grid_iff j hj q a b).mp (he ▸ w.property)


private def state (j : ℕ) (hj : 1 ≤ j) (q : GridPacking j) : ℕ :=
  3 * j - (q.val ⟨3 * (j - 1) + 2, by omega⟩).val

private def Children (j : ℕ) (hj : 1 ≤ j) :=
  Σ q : GridPacking j, Σ r : Fin (state j hj q), Fin (r.val + 1)

private noncomputable def child (j : ℕ) (hj : 1 ≤ j) (v : Children j hj) :
    GridPacking (j + 1) := by
  obtain ⟨q,r,s⟩ := v
  have hr := r.isLt
  simp only [state] at hr
  let a : Fin (3 * j + 3) := ⟨3 * j - r.val, by omega⟩
  let b : Fin (3 * j + 2) := ⟨3 * j - r.val + s.val, by have := s.isLt; omega⟩
  refine ⟨appendColumn q.val a b, (appendColumn_grid_iff j hj q.val a b).mpr ?_⟩
  have hs := s.isLt
  exact ⟨q.property, by dsimp [a]; omega, by dsimp [a,b]; omega, by dsimp [b]; omega⟩

private theorem child_state (j : ℕ) (hj : 1 ≤ j) (v : Children j hj) :
    state (j + 1) (by omega) (child j hj v) = v.2.1.val + 3 := by
  rcases v with ⟨q,r,s⟩
  change 3 * (j + 1) -
    (appendColumn q.val ⟨3 * j - r.val, _⟩
      ⟨3 * j - r.val + s.val, _⟩ (Fin.last (3 * j + 2))).val = r.val + 3
  rw [appendColumn_x]
  have hr := r.isLt
  simp only [state] at hr
  simp only [Fin.val_mk]
  omega

private theorem child_bijective (j : ℕ) (hj : 1 ≤ j) : Function.Bijective (child j hj) := by
  constructor
  · rintro ⟨q,r,s⟩ ⟨q',r',s'⟩ h
    have hh := congrArg Subtype.val h
    change appendRank _ (appendRank _ (appendRank _ q.val)) =
      appendRank _ (appendRank _ (appendRank _ q'.val)) at hh
    obtain ⟨ha, hx⟩ := appendRank_inj hh
    obtain ⟨hb, hy⟩ := appendRank_inj hx
    obtain ⟨_, hz⟩ := appendRank_inj hy
    have hq : q = q' := Subtype.ext hz
    subst q'
    have hr : r = r' := by
      apply Fin.ext
      have hr := r.isLt
      have hr' := r'.isLt
      simp only [state] at hr hr'
      have hav := congrArg Fin.val ha
      change 3 * j - r.val = 3 * j - r'.val at hav
      omega
    subst r'
    have hs : s = s' := by
      apply Fin.ext
      have hbv := congrArg Fin.val hb
      change 3 * j - r.val + s.val = 3 * j - r.val + s'.val at hbv
      omega
    subst s'
    rfl
  · intro w
    obtain ⟨q,a,b,he,hg,hqa,hab,hb⟩ := grid_decompose j hj w
    let qq : GridPacking j := ⟨q,hg⟩
    let r : Fin (state j hj qq) := ⟨3 * j - a.val, by
      simp only [state, qq]
      have hq := (q ⟨3 * (j - 1) + 2, by omega⟩).isLt
      omega⟩
    let s : Fin (r.val + 1) := ⟨b.val - a.val, by dsimp [r]; omega⟩
    refine ⟨⟨qq,r,s⟩, ?_⟩
    apply Subtype.ext
    change appendColumn q _ _ = w.val
    rw [he]
    congr 1
    · apply Fin.ext
      change 3 * j - (3 * j - a.val) = a.val
      omega
    · apply Fin.ext
      change 3 * j - (3 * j - a.val) + (b.val - a.val) = b.val
      omega

private noncomputable def childrenEquiv (j : ℕ) (hj : 1 ≤ j) :
    Children j hj ≃ GridPacking (j + 1) := Equiv.ofBijective _ (child_bijective j hj)


private def singleGrid : GridPacking 1 := by
  refine ⟨Equiv.swap 0 2, ?_⟩
  constructor
  · intro t ht
    have he : t = 0 := by omega
    subst t
    change (Equiv.swap 0 2 : Equiv.Perm (Fin 3)) 2 < Equiv.swap 0 2 1 ∧
      (Equiv.swap 0 2 : Equiv.Perm (Fin 3)) 1 < Equiv.swap 0 2 0
    decide +kernel
  · intro t ht
    omega

private theorem grid_one_unique (q : GridPacking 1) : q = singleGrid := by
  apply Subtype.ext
  ext i
  have he := q.property.1 0 (by decide)
  change (q.val 2).val < (q.val 1).val ∧ (q.val 1).val < (q.val 0).val at he
  have h0 := (q.val 0).isLt
  have h1 := (q.val 1).isLt
  have h2 := (q.val 2).isLt
  have hi := i.isLt
  fin_cases i
  · change (q.val 0).val = 2
    omega
  · change (q.val 1).val = 1
    omega
  · change (q.val 2).val = 0
    omega


open scoped BigOperators Classical
open BlitvicKammounSteingrimsson14325Transfer

private noncomputable instance gridFintype (j : ℕ) : Fintype (GridPacking j) := by
  classical
  unfold GridPacking
  infer_instance

private noncomputable instance childrenFintype (j : ℕ) (hj : 1 ≤ j) :
    Fintype (Children j hj) :=
  inferInstanceAs (Fintype (Σ q : GridPacking j, Σ r : Fin (state j hj q), Fin (r.val + 1)))

private noncomputable def weighted (n j : ℕ) (hj : 1 ≤ j) : ℕ :=
  ∑ q : GridPacking j, row ℕ n (state j hj q)

private theorem weighted_step (n j : ℕ) (hj : 1 ≤ j) :
    weighted n (j + 1) (by omega) = weighted (n + 1) j hj := by
  classical
  rw [weighted, ← (childrenEquiv j hj).sum_comp]
  change (∑ v : Children j hj, row ℕ n (state (j + 1) _ (child j hj v))) = _
  simp only [child_state]
  change (∑ v : (Σ q : GridPacking j, Σ r : Fin (state j hj q), Fin (r.val + 1)),
    row ℕ n (v.2.1.val + 3)) = _
  simp only [Fintype.sum_sigma, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, nsmul_eq_mul]
  unfold weighted
  apply Finset.sum_congr rfl
  intro q hq
  simp only [row, transfer, Nat.cast_id]
  exact Fin.sum_univ_eq_sum_range (fun r => (r + 1) * row ℕ n (r + 3)) (state j hj q)

private theorem weighted_one (n : ℕ) : weighted n 1 (by decide) = row ℕ n 3 := by
  classical
  have hall : (Finset.univ : Finset (GridPacking 1)) = {singleGrid} := by
    ext q
    simp only [Finset.mem_univ, Finset.mem_singleton, true_iff]
    exact grid_one_unique q
  unfold weighted
  rw [hall, Finset.sum_singleton]
  congr 1

private theorem weighted_eval (n j : ℕ) :
    weighted n (j + 1) (by omega) = row ℕ (n + j) 3 := by
  induction j generalizing n with
  | zero => simpa using weighted_one n
  | succ j ih =>
    rw [weighted_step n (j + 1) (by omega), ih]
    congr 1 <;> omega

/-- Universal actual-grid cardinality: the transfer is derived by rank insertion. -/
theorem grid_card_eq_row (j : ℕ) (hj : 1 ≤ j) :
    Nat.card (GridPacking j) = row ℕ (j - 1) 3 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
  have he := weighted_eval 0 n
  simpa only [weighted, row, Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul, mul_one, Nat.card_eq_fintype_card, Nat.zero_add,
    Nat.succ_sub_one, Nat.cast_id, Nat.succ_eq_add_one] using he

private theorem count_eq_row (j : ℕ) (hj : 1 ≤ j) :
    count pattern 2 j = row ℕ (j - 1) 3 := by
  rw [count_eq_grid j hj, grid_card_eq_row j hj]

/-- The full modulo-ten source conclusion, with precisely the dyadic exceptions. -/
theorem count_mod_ten (j : ℕ) (hj : 1 ≤ j) :
    count pattern 2 j % 10 =
      if (∃ k : ℕ, 1 ≤ k ∧ j + 1 = 2 ^ k) then 1 else 6 := by
  rw [count_eq_row j hj, row_mod_ten]
  have he : j - 1 + 2 = j + 1 := by omega
  rw [he]

/-- Exact exceptions for four-divisibility, including zero and equal exponents. -/
theorem count_mod_four_iff (j : ℕ) (hj : 1 ≤ j) :
    (¬ 4 ∣ count pattern 2 j) ↔
      ∃ i p : ℕ, p ≤ i ∧ j + 1 = 2 ^ i + 2 ^ p := by
  rw [count_eq_row j hj, row_mod_four_iff]
  have he : j - 1 + 2 = j + 1 := by omega
  rw [he]

