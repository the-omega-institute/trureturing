/- GID: D5/S3/Combinatorics/Permutation/BlitvicKammounSteingrimsson14325Core
   generality: I
   mirror-B: D5/B/S3/Combinatorics/Permutation/BlitvicKammounSteingrimsson14325Core
   mirror-E: none(waiver:unbounded-symbolic-proof)
   anchors: []
   utility: none
   digest: Exact window chains and forced endpoints for actual 14325 packings. -/

import D5.S3.Combinatorics.Permutation.PackingMaximumRefutation
import Mathlib.Tactic.IntervalCases

/-! All permutations and all window comparisons retain the literal source meaning.
The source length is 5+(j-1)*3, equal to 3j+2 when j≥1.
Escape audits: https://github.com/the-omega-institute/trureturing/issues/28504.
-/

set_option autoImplicit false

namespace D5.S3.Combinatorics.Permutation.BlitvicKammounSteingrimsson14325Core

open PackingMaximumRefutation

/-- Source pattern 14325 with one subtracted from every rank. -/
def pattern : Fin 5 → Fin 5 := ![0, 3, 2, 1, 4]

/-- The complete chain generated by window t. -/
def WindowChain (j : ℕ) (f : ℕ → ℕ) : Prop :=
  ∀ t < j, f (3 * t) < f (3 * t + 3) ∧
    f (3 * t + 3) < f (3 * t + 2) ∧
    f (3 * t + 2) < f (3 * t + 1) ∧
    f (3 * t + 1) < f (3 * t + 4)

private def rank {N : ℕ} (w : Fin N → Fin N) (i : ℕ) : ℕ :=
  if h : i < N then (w ⟨i, h⟩).val else 0

private theorem rank_window (j : ℕ)
    (w : Fin (5 + (j - 1) * 3) → Fin (5 + (j - 1) * 3))
    (t : Fin j) (a : Fin 5) :
    rank w (3 * t.val + a.val) = (w (windowIndex 5 2 j t a)).val := by
  have hb := (windowIndex 5 2 j t a).isLt
  change t.val * 3 + a.val < 5 + (j - 1) * 3 at hb
  have he : 3 * t.val + a.val = t.val * 3 + a.val := by omega
  rw [he]
  simp [rank, hb, windowIndex]

private theorem packing_chain_iff (j : ℕ)
    (w : Fin (5 + (j - 1) * 3) → Fin (5 + (j - 1) * 3)) :
    Packs pattern 2 j w ↔ WindowChain j (rank w) := by
  constructor
  · intro h t ht
    let tt : Fin j := ⟨t, ht⟩
    have h03 := (h tt 0 3).mpr (by decide : pattern 0 < pattern 3)
    have h32 := (h tt 3 2).mpr (by decide : pattern 3 < pattern 2)
    have h21 := (h tt 2 1).mpr (by decide : pattern 2 < pattern 1)
    have h14 := (h tt 1 4).mpr (by decide : pattern 1 < pattern 4)
    have hh0 := rank_window j w tt 0
    have hh1 := rank_window j w tt 1
    have hh2 := rank_window j w tt 2
    have hh3 := rank_window j w tt 3
    have hh4 := rank_window j w tt 4
    norm_num at hh0 hh1 hh2 hh3 hh4
    simp only [Fin.lt_def] at h03 h32 h21 h14
    rw [← hh0, ← hh3] at h03
    rw [← hh3, ← hh2] at h32
    rw [← hh2, ← hh1] at h21
    rw [← hh1, ← hh4] at h14
    exact ⟨h03, h32, h21, h14⟩
  · intro h t a b
    obtain ⟨h03, h32, h21, h14⟩ := h t.val t.isLt
    have hh0 := rank_window j w t 0
    have hh1 := rank_window j w t 1
    have hh2 := rank_window j w t 2
    have hh3 := rank_window j w t 3
    have hh4 := rank_window j w t 4
    norm_num at hh0 hh1 hh2 hh3 hh4
    rw [hh0, hh3] at h03
    rw [hh3, hh2] at h32
    rw [hh2, hh1] at h21
    rw [hh1, hh4] at h14
    fin_cases a <;> fin_cases b <;>
      simp only [pattern, Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.cons_val_three, Matrix.cons_val_four, Fin.lt_def] <;>
      norm_num <;> omega

private theorem chain_bounds (j : ℕ) (hj : 1 ≤ j) (f : ℕ → ℕ)
    (h : WindowChain j f) (x : ℕ) (hx : x ≤ 3 * j + 1) :
    f 0 ≤ f x ∧ f x ≤ f (3 * j + 1) := by
  induction j generalizing x with
  | zero => omega
  | succ j ih =>
    by_cases hz : j = 0
    · subst j
      obtain ⟨ha, hb, hc, hd⟩ := h 0 (by decide)
      norm_num at ha hb hc hd hx ⊢
      interval_cases x <;> omega
    · have hjp : 1 ≤ j := by omega
      have hold : WindowChain j f := fun t ht => h t (by omega)
      obtain ⟨ha, hb, hc, hd⟩ := h j (by omega)
      have hbase := ih hjp hold (3 * j) (by omega)
      by_cases hsmall : x ≤ 3 * j + 1
      · have hh := ih hjp hold x hsmall
        have he : 3 * (j + 1) + 1 = 3 * j + 4 := by omega
        rw [he]
        omega
      · have he : 3 * (j + 1) + 1 = 3 * j + 4 := by omega
        rw [he]
        have cases : x = 3 * j + 2 ∨ x = 3 * j + 3 ∨ x = 3 * j + 4 := by omega
        rcases cases with rfl | rfl | rfl <;> omega

/-- Every source rank lies between the first and last positions. -/
theorem packing_bounds (j : ℕ) (hj : 1 ≤ j)
    (w : Fin (5 + (j - 1) * 3) → Fin (5 + (j - 1) * 3))
    (h : Packs pattern 2 j w) (x : Fin (5 + (j - 1) * 3)) :
    w ⟨0, by omega⟩ ≤ w x ∧ w x ≤ w ⟨3 * j + 1, by omega⟩ := by
  have hc := (packing_chain_iff j w).mp h
  have he : 5 + (j - 1) * 3 = 3 * j + 2 := by omega
  have hb := chain_bounds j hj (rank w) hc x.val (by have := x.isLt; omega)
  have hzero : 0 < 5 + (j - 1) * 3 := by omega
  have hend : 3 * j + 1 < 5 + (j - 1) * 3 := by omega
  change (w ⟨0, hzero⟩).val ≤ (w x).val ∧ (w x).val ≤ (w ⟨3 * j + 1, hend⟩).val
  simpa only [rank, dite_eq_left x.isLt, dite_eq_left hzero, dite_eq_left hend, Fin.eta] using hb

/-- Bijectivity forces the endpoints to be the least and greatest actual ranks. -/
theorem packing_extrema (j : ℕ) (hj : 1 ≤ j)
    (w : Equiv.Perm (Fin (5 + (j - 1) * 3))) (h : Packs pattern 2 j w) :
    (w ⟨0, by omega⟩).val = 0 ∧
      (w ⟨3 * j + 1, by omega⟩).val = 3 * j + 1 := by
  obtain ⟨lo, hlo⟩ := w.surjective ⟨0, by omega⟩
  obtain ⟨hi, hhi⟩ := w.surjective ⟨3 * j + 1, by omega⟩
  have hlow := (packing_bounds j hj w h lo).1
  have hhigh := (packing_bounds j hj w h hi).2
  rw [hlo] at hlow
  rw [hhi] at hhigh
  have hend := (w ⟨3 * j + 1, by omega⟩).isLt
  simp only [Fin.le_def] at hlow hhigh
  constructor <;> omega

end D5.S3.Combinatorics.Permutation.BlitvicKammounSteingrimsson14325Core
