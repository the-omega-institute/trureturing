import Mathlib.Tactic.Ring
import Mathlib.Tactic.IntervalCases
import Mathlib.SetTheory.Cardinal.Finite

namespace D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure


/-- The source uses labels 1,...,mn. Out-of-range coordinates are unused and return zero. -/
def entry {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) (i j : ℕ) : ℕ :=
  if hi : i < m then
    if hj : j < n then (σ (⟨i, hi⟩, ⟨j, hj⟩)).val + 1 else 0
  else 0

/-- Maximum on the main diagonal and minimum on the opposite diagonal. -/
def GoodSquare (a b c d : ℕ) : Prop :=
  (max (max a b) (max c d) = a ∨ max (max a b) (max c d) = d) ∧
  (min (min a b) (min c d) = b ∨ min (min a b) (min c d) = c)

/-- The source's good-on-i,j condition, with zero-based coordinates. -/
def GoodAt {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) (i j : ℕ) : Prop :=
  i + 1 < m ∧ j + 1 < n ∧
  GoodSquare (entry σ i j) (entry σ i (j + 1))
    (entry σ (i + 1) j) (entry σ (i + 1) (j + 1))

/-- Good at every adjacent square; no condition when a dimension is one. -/
def Good {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) : Prop :=
  ∀ i j : ℕ, i + 1 < m → j + 1 < n → GoodAt σ i j

/-- The two disjoint increasing chains for a two-row array, including empty chains. -/
def TwoChains (n : ℕ) (T B : ℕ → ℕ) (k : ℕ) : Prop :=
  k ≤ n ∧
  List.Pairwise (· < ·)
    (List.ofFn (fun j : Fin k => B j.val) ++
      (List.ofFn (fun j : Fin k => T j.val)).reverse) ∧
  List.Pairwise (· < ·)
    ((List.ofFn (fun j : Fin (n - k) => T (k + j.val))).reverse ++
      List.ofFn (fun j : Fin (n - k) => B (k + j.val)))

/-- For (a,b,c;d,e,f;g,h,i): g<d<e<b<a and c<f<e<h<i. -/
def TypeA (A : ℕ → ℕ → ℕ) : Prop :=
  List.Pairwise (· < ·) [A 2 0, A 1 0, A 1 1, A 0 1, A 0 0] ∧
  List.Pairwise (· < ·) [A 0 2, A 1 2, A 1 1, A 2 1, A 2 2]

/-- For (a,b,c;d,e,f;g,h,i): c<b<e<d<a and g<h<e<f<i. -/
def TypeB (A : ℕ → ℕ → ℕ) : Prop :=
  List.Pairwise (· < ·) [A 0 2, A 0 1, A 1 1, A 1 0, A 0 0] ∧
  List.Pairwise (· < ·) [A 2 0, A 2 1, A 1 1, A 1 2, A 2 2]

/-- Complete proposed characterization, including both orientations of every rectangle. -/
def Structure {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) : Prop :=
  m = 1 ∨ n = 1 ∨
  (m = 2 ∧ ∃! k : ℕ, TwoChains n (entry σ 0) (entry σ 1) k) ∨
  (n = 2 ∧ ∃! k : ℕ, TwoChains m (fun j => entry σ j 0) (fun j => entry σ j 1) k) ∨
  (m = 3 ∧ n = 3 ∧ (TypeA (entry σ) ∨ TypeB (entry σ)))

end D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

namespace D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

private theorem square_bounds (a b c d : ℕ) :
    GoodSquare a b c d ↔
      ((b ≤ a ∧ c ≤ a ∧ d ≤ a) ∨ (a ≤ d ∧ b ≤ d ∧ c ≤ d)) ∧
      ((b ≤ a ∧ b ≤ c ∧ b ≤ d) ∨ (c ≤ a ∧ c ≤ b ∧ c ≤ d)) := by
  simp only [GoodSquare, max_def, min_def]
  split_ifs <;> omega

private theorem square_sign (a b c d : ℕ)
    (hac : a ≠ c) (hbd : b ≠ d) (hab : a ≠ b) (hcd : c ≠ d) :
    GoodSquare a b c d ↔
      (c < a ∧ d < b ∧ c < d ∧ b < a) ∨
      (c < a ∧ b < d) ∨
      (a < c ∧ b < d ∧ b < a ∧ c < d) := by
  rw [square_bounds]
  omega

private theorem entry_ne {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n)))
    {i j r s : ℕ} (hi : i < m) (hj : j < n) (hr : r < m) (hs : s < n)
    (h : (i,j) ≠ (r,s)) : entry σ i j ≠ entry σ r s := by
  simp only [entry, dite_eq_left hi, dite_eq_left hj, dite_eq_left hr, dite_eq_left hs]
  intro he
  have hv : σ (⟨i, hi⟩, ⟨j, hj⟩) = σ (⟨r, hr⟩, ⟨s, hs⟩) :=
    Fin.ext (Nat.add_right_cancel he)
  have hh := σ.injective hv
  exact h (congrArg (fun p : Fin m × Fin n => (p.1.val,p.2.val)) hh)

private theorem square_transpose (a b c d : ℕ) :
    GoodSquare a b c d ↔ GoodSquare a c b d := by
  simp only [square_bounds]
  omega

end D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

namespace D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

private def PairGood (n : ℕ) (T B : ℕ → ℕ) : Prop :=
  ∀ j, j + 1 < n → GoodSquare (T j) (T (j+1)) (B j) (B (j+1))

private def SplitOrder (n : ℕ) (T B : ℕ → ℕ) (k : ℕ) : Prop :=
  k ≤ n ∧
  (∀ i j, i < j → j < k → B i < B j ∧ T j < T i) ∧
  (∀ i j, i < k → j < k → B i < T j) ∧
  (∀ i j, k ≤ i → i < j → j < n → T j < T i ∧ B i < B j) ∧
  (∀ i j, k ≤ i → i < n → k ≤ j → j < n → T i < B j)

private theorem chains_iff (n : ℕ) (T B : ℕ → ℕ) (k : ℕ) :
    TwoChains n T B k ↔ SplitOrder n T B k := by
  simp only [TwoChains, SplitOrder, List.pairwise_append, List.pairwise_reverse,
    List.pairwise_ofFn, List.mem_reverse, List.mem_ofFn,
    forall_exists_index, forall_apply_eq_imp_iff]
  constructor
  · rintro ⟨hk, ⟨hB, hT, hBT⟩, hT', hB', hTB⟩
    refine ⟨hk, ?_, ?_, ?_, ?_⟩
    · intro i j hij hj
      exact ⟨hB (i := ⟨i, by omega⟩) (j := ⟨j, hj⟩) hij,
        hT (i := ⟨i, by omega⟩) (j := ⟨j, hj⟩) hij⟩
    · intro i j hi hj
      exact hBT ⟨i,hi⟩ ⟨j,hj⟩
    · intro i j hi hij hj
      have hii : i - k < n - k := by omega
      have hjj : j - k < n - k := by omega
      have hh : (⟨i-k,hii⟩ : Fin (n-k)) < ⟨j-k,hjj⟩ := by simp; omega
      have ht := hT' hh
      have hb := hB' hh
      simpa only [Nat.add_sub_of_le hi, Nat.add_sub_of_le (by omega : k ≤ j)] using And.intro ht hb
    · intro i j hi hin hj hjn
      have hh := hTB ⟨i-k,by omega⟩ ⟨j-k,by omega⟩
      simpa only [Nat.add_sub_of_le hi, Nat.add_sub_of_le hj] using hh
  · rintro ⟨hk,hp,hp',hs,hs'⟩
    refine ⟨hk, ⟨?_, ?_, ?_⟩, ?_, ?_, ?_⟩
    · intro i j hij
      exact (hp i j hij j.isLt).1
    · intro i j hij
      exact (hp i j hij j.isLt).2
    · intro i j
      exact hp' i j i.isLt j.isLt
    · intro i j hij
      exact (hs (k+i) (k+j) (by omega) (by simpa using hij) (by omega)).1
    · intro i j hij
      exact (hs (k+i) (k+j) (by omega) (by simpa using hij) (by omega)).2
    · intro i j
      exact hs' (k+i) (k+j) (by omega) (by omega) (by omega) (by omega)

private theorem pairgood_sign_split (n : ℕ) (T B : ℕ → ℕ)
    (hv : ∀ j, j < n → T j ≠ B j)
    (hh : ∀ j, j+1 < n → T j ≠ T (j+1) ∧ B j ≠ B (j+1))
    (hg : PairGood n T B) :
    ∃ k, k ≤ n ∧ (∀ j, j < k → B j < T j) ∧
      (∀ j, k ≤ j → j < n → T j < B j) := by
  have hstep (j : ℕ) (hj : j+1 < n) (hm : T j < B j) : T (j+1) < B (j+1) := by
    have hs := (square_sign (T j) (T (j+1)) (B j) (B (j+1))
      (hv j (by omega)) (hv (j+1) hj) (hh j hj).1 (hh j hj).2).mp (hg j hj)
    omega
  have hlater (i d : ℕ) (hid : i+d < n) (hi : T i < B i) :
      T (i+d) < B (i+d) := by
    induction d with
    | zero => simpa using hi
    | succ d ih =>
      simpa only [Nat.add_succ] using hstep (i+d) (by omega) (ih (by omega))
  by_cases hx : ∃ j, j < n ∧ T j < B j
  · let k := Nat.find hx
    have hk : k < n ∧ T k < B k := Nat.find_spec hx
    refine ⟨k, by omega, ?_, ?_⟩
    · intro j hj
      have hn := Nat.find_min hx hj
      have hvj := hv j (by omega)
      dsimp [k] at hj
      omega
    · intro j hkj hjn
      have hp := hlater k (j-k) (by omega) hk.2
      simpa only [Nat.add_sub_of_le hkj] using hp
  · refine ⟨n, le_rfl, ?_, ?_⟩
    · intro j hj
      have hvj := hv j hj
      have hn : ¬ T j < B j := fun h => hx ⟨j,hj,h⟩
      omega
    · intro j hj hjn
      omega

private theorem split_of_signs (n : ℕ) (T B : ℕ → ℕ) (k : ℕ)
    (hv : ∀ j, j < n → T j ≠ B j)
    (hh : ∀ j, j+1 < n → T j ≠ T (j+1) ∧ B j ≠ B (j+1))
    (hg : PairGood n T B) (hk : k ≤ n)
    (hp : ∀ j, j < k → B j < T j)
    (hm : ∀ j, k ≤ j → j < n → T j < B j) : SplitOrder n T B k := by
  have hprefix (j : ℕ) (hj : j+1 < k) : B j < B (j+1) ∧ T (j+1) < T j := by
    have hs := (square_sign (T j) (T (j+1)) (B j) (B (j+1))
      (hv j (by omega)) (hv (j+1) (by omega)) (hh j (by omega)).1
      (hh j (by omega)).2).mp (hg j (by omega))
    have h0 := hp j (by omega)
    have h1 := hp (j+1) hj
    omega
  have hsuffix (j : ℕ) (hj : j+1 < n) (hjk : k ≤ j) :
      T (j+1) < T j ∧ B j < B (j+1) := by
    have hs := (square_sign (T j) (T (j+1)) (B j) (B (j+1))
      (hv j (by omega)) (hv (j+1) hj) (hh j hj).1 (hh j hj).2).mp (hg j hj)
    have h0 := hm j hjk (by omega)
    have h1 := hm (j+1) (by omega) hj
    omega
  have hBp : StrictMonoOn B (Set.Iio k) :=
    strictMonoOn_of_lt_succ Set.ordConnected_Iio (by
      intro j _ hj hj'
      exact (hprefix j hj').1)
  have hTp : StrictAntiOn T (Set.Iio k) :=
    strictAntiOn_of_succ_lt Set.ordConnected_Iio (by
      intro j _ hj hj'
      exact (hprefix j hj').2)
  have hBs : StrictMonoOn B (Set.Ico k n) :=
    strictMonoOn_of_lt_succ Set.ordConnected_Ico (by
      intro j _ hj hj'
      exact (hsuffix j hj'.2 hj.1).2)
  have hTs : StrictAntiOn T (Set.Ico k n) :=
    strictAntiOn_of_succ_lt Set.ordConnected_Ico (by
      intro j _ hj hj'
      exact (hsuffix j hj'.2 hj.1).1)
  refine ⟨hk, ?_, ?_, ?_, ?_⟩
  · intro i j hij hj
    exact ⟨hBp (by change i < k; omega) hj hij, hTp (by change i < k; omega) hj hij⟩
  · intro i j hi hj
    by_cases hij : i < j
    · exact lt_trans (hBp hi hj hij) (hp j hj)
    · by_cases hji : j < i
      · exact lt_trans (hp i hi) (hTp hj hi hji)
      · have : i = j := by omega
        simpa [this] using hp j hj
  · intro i j hi hij hj
    exact ⟨hTs ⟨hi,by omega⟩ ⟨by omega,hj⟩ hij,
      hBs ⟨hi,by omega⟩ ⟨by omega,hj⟩ hij⟩
  · intro i j hi hin hj hjn
    by_cases hij : i < j
    · exact lt_trans (hm i hi hin) (hBs ⟨hi,hin⟩ ⟨hj,hjn⟩ hij)
    · by_cases hji : j < i
      · exact lt_trans (hTs ⟨hj,hjn⟩ ⟨hi,hin⟩ hji) (hm j hj hjn)
      · have : i = j := by omega
        simpa [this] using hm j hj hjn

private theorem pairgood_iff_chains (n : ℕ) (T B : ℕ → ℕ)
    (hv : ∀ j, j < n → T j ≠ B j)
    (hh : ∀ j, j+1 < n → T j ≠ T (j+1) ∧ B j ≠ B (j+1)) :
    PairGood n T B ↔ ∃! k, TwoChains n T B k := by
  constructor
  · intro hg
    obtain ⟨k,hk,hp,hm⟩ := pairgood_sign_split n T B hv hh hg
    refine ⟨k, (chains_iff n T B k).mpr (split_of_signs n T B k hv hh hg hk hp hm), ?_⟩
    intro l hl
    have hs := (chains_iff n T B l).mp hl
    by_contra hkl
    rcases lt_or_gt_of_ne hkl with hlt | hgt
    · have h0 := hs.2.2.2.2 l l (by omega) (by omega) (by omega) (by omega)
      have h1 := hp l hlt
      omega
    · have hkn : k < n := lt_of_lt_of_le hgt hs.1
      have h0 := hs.2.2.1 k k hgt hgt
      have h1 := hm k le_rfl (by omega)
      omega
  · rintro ⟨k,hk,_⟩
    have hs := (chains_iff n T B k).mp hk
    intro j hj
    apply (square_sign (T j) (T (j+1)) (B j) (B (j+1))
      (hv j (by omega)) (hv (j+1) hj) (hh j hj).1 (hh j hj).2).mpr
    by_cases h0 : j+1 < k
    · have h1 := hs.2.1 j (j+1) (by omega) h0
      have h2 := hs.2.2.1 j j (by omega) (by omega)
      have h3 := hs.2.2.1 (j+1) (j+1) h0 h0
      exact Or.inl ⟨h2,h3,h1.1,h1.2⟩
    · by_cases h1 : j < k
      · have h2 := hs.2.2.1 j j h1 h1
        have h3 := hs.2.2.2.2 (j+1) (j+1) (by omega) hj (by omega) hj
        exact Or.inr (Or.inl ⟨h2,h3⟩)
      · have h2 := hs.2.2.2.2 j j (by omega) (by omega) (by omega) (by omega)
        have h3 := hs.2.2.2.2 (j+1) (j+1) (by omega) hj (by omega) hj
        have h4 := hs.2.2.2.1 j (j+1) (by omega) (by omega) hj
        exact Or.inr (Or.inr ⟨h2,h3,h4.1,h4.2⟩)

end D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

set_option maxHeartbeats 3000000
set_option maxRecDepth 10000

namespace D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

private theorem three_local_iff (A : ℕ → ℕ → ℕ)
    (hv : ∀ i, i < 2 → ∀ j, j < 3 → A i j ≠ A (i+1) j)
    (hh : ∀ i, i < 3 → ∀ j, j < 2 → A i j ≠ A i (j+1)) :
    (GoodSquare (A 0 0) (A 0 1) (A 1 0) (A 1 1) ∧
      GoodSquare (A 0 1) (A 0 2) (A 1 1) (A 1 2) ∧
      GoodSquare (A 1 0) (A 1 1) (A 2 0) (A 2 1) ∧
      GoodSquare (A 1 1) (A 1 2) (A 2 1) (A 2 2)) ↔
      TypeA A ∨ TypeB A := by
  have h00 := hv 0 (by decide) 0 (by decide)
  have h01 := hv 0 (by decide) 1 (by decide)
  have h02 := hv 0 (by decide) 2 (by decide)
  have h10 := hv 1 (by decide) 0 (by decide)
  have h11 := hv 1 (by decide) 1 (by decide)
  have h12 := hv 1 (by decide) 2 (by decide)
  have h00' := hh 0 (by decide) 0 (by decide)
  have h01' := hh 0 (by decide) 1 (by decide)
  have h10' := hh 1 (by decide) 0 (by decide)
  have h11' := hh 1 (by decide) 1 (by decide)
  have h20' := hh 2 (by decide) 0 (by decide)
  have h21' := hh 2 (by decide) 1 (by decide)
  simp only [Nat.reduceAdd] at *
  rw [square_sign _ _ _ _ h00 h01 h00' h10',
    square_sign _ _ _ _ h01 h02 h01' h11',
    square_sign _ _ _ _ h10 h11 h10' h20',
    square_sign _ _ _ _ h11 h12 h11' h21']
  simp [TypeA, TypeB, List.pairwise_cons]
  omega

private theorem three_first_middle (A : ℕ → ℕ → ℕ) (h : TypeA A ∨ TypeB A) :
    A 1 0 < A 0 0 ∧ A 2 0 < A 1 0 ∧
      (A 0 1 < A 1 1 ∨ A 1 1 < A 2 1) := by
  simp [TypeA, TypeB, List.pairwise_cons] at h
  omega

private theorem no_three_four (A : ℕ → ℕ → ℕ)
    (hv : ∀ i, i < 2 → ∀ j, j < 4 → A i j ≠ A (i+1) j)
    (hh : ∀ i, i < 3 → ∀ j, j < 3 → A i j ≠ A i (j+1))
    (hg : ∀ i, i < 2 → ∀ j, j < 3 →
      GoodSquare (A i j) (A i (j+1)) (A (i+1) j) (A (i+1) (j+1))) : False := by
  have hl := (three_local_iff A (by
    intro i hi j hj; exact hv i hi j (by omega)) (by
    intro i hi j hj; exact hh i hi j (by omega))).mp
      ⟨hg 0 (by decide) 0 (by decide), hg 0 (by decide) 1 (by decide),
       hg 1 (by decide) 0 (by decide), hg 1 (by decide) 1 (by decide)⟩
  let A' := fun i j => A i (j+1)
  have hr := (three_local_iff A' (by
    intro i hi j hj; exact hv i hi (j+1) (by omega)) (by
    intro i hi j hj; exact hh i hi (j+1) (by omega))).mp
      ⟨hg 0 (by decide) 1 (by decide), hg 0 (by decide) 2 (by decide),
       hg 1 (by decide) 1 (by decide), hg 1 (by decide) 2 (by decide)⟩
  have h0 := three_first_middle A hl
  have h1 := three_first_middle A' hr
  dsimp [A'] at h1
  omega

end D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

namespace D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure

def transpose {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) : ((Fin n × Fin m) ≃ Fin (n * m)) :=
  let h : m * n = n * m := by ring
  ((Equiv.prodComm (Fin n) (Fin m)).trans σ).trans (finCongr h)

@[simp] private theorem entry_transpose {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) (i j : ℕ) :
    entry (transpose σ) i j = entry σ j i := by
  unfold entry
  split_ifs <;> rfl

theorem good_transpose {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) :
    Good (transpose σ) ↔ Good σ := by
  constructor
  · intro h i j hi hj
    have hg := (h j i hj hi).2.2
    simp only [entry_transpose] at hg
    exact ⟨hi,hj,(square_transpose _ _ _ _).mp hg⟩
  · intro h i j hi hj
    have hg := (h j i hj hi).2.2
    refine ⟨hi,hj,?_⟩
    simp only [entry_transpose]
    exact (square_transpose _ _ _ _).mp hg

theorem two_good_iff {n : ℕ} (σ : ((Fin 2 × Fin n) ≃ Fin (2 * n))) :
    Good σ ↔ ∃! k, TwoChains n (entry σ 0) (entry σ 1) k := by
  have he := pairgood_iff_chains n (entry σ 0) (entry σ 1) (by
    intro j hj
    exact entry_ne σ (by decide) hj (by decide) hj (by simp)) (by
    intro j hj
    exact ⟨entry_ne σ (by decide) (by omega) (by decide) hj (by intro he; have := congrArg Prod.snd he; omega),
      entry_ne σ (by decide) (by omega) (by decide) hj (by intro he; have := congrArg Prod.snd he; omega)⟩)
  rw [← he]
  constructor
  · intro h j hj
    exact (h 0 j (by decide) hj).2.2
  · intro h i j hi hj
    have : i = 0 := by omega
    subst i
    exact ⟨hi,hj,h j hj⟩

theorem three_good_iff (σ : ((Fin 3 × Fin 3) ≃ Fin (3 * 3))) :
    Good σ ↔ TypeA (entry σ) ∨ TypeB (entry σ) := by
  have he := three_local_iff (entry σ) (by
    intro i hi j hj
    exact entry_ne σ (by omega) hj (by omega) hj (by intro he; have := congrArg Prod.fst he; omega)) (by
    intro i hi j hj
    exact entry_ne σ hi (by omega) hi (by omega) (by intro he; have := congrArg Prod.snd he; omega))
  rw [← he]
  constructor
  · intro h
    exact ⟨(h 0 0 (by decide) (by decide)).2.2,
      (h 0 1 (by decide) (by decide)).2.2,
      (h 1 0 (by decide) (by decide)).2.2,
      (h 1 1 (by decide) (by decide)).2.2⟩
  · rintro ⟨h00,h01,h10,h11⟩ i j hi hj
    refine ⟨hi,hj,?_⟩
    have : i ≤ 1 := by omega
    have : j ≤ 1 := by omega
    interval_cases i <;> interval_cases j <;> assumption

theorem no_good_large {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n)))
    (hm : 3 ≤ m) (hn : 4 ≤ n) : ¬ Good σ := by
  intro hg
  apply no_three_four (entry σ)
  · intro i hi j hj
    exact entry_ne σ (by omega) (by omega) (by omega) (by omega) (by intro he; have := congrArg Prod.fst he; have := congrArg Prod.snd he; omega)
  · intro i hi j hj
    exact entry_ne σ (by omega) (by omega) (by omega) (by omega) (by intro he; have := congrArg Prod.fst he; have := congrArg Prod.snd he; omega)
  · intro i hi j hj
    exact (hg i j (by omega) (by omega)).2.2

theorem good_of_one {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) (h : m = 1 ∨ n = 1) : Good σ := by
  intro i j hi hj
  rcases h with h | h <;> omega

theorem good_iff_structure {m n : ℕ} (σ : ((Fin m × Fin n) ≃ Fin (m * n))) (hm : 0 < m) (hn : 0 < n) :
    Good σ ↔ Structure σ := by
  constructor
  · intro hg
    by_cases hm1 : m = 1
    · exact Or.inl hm1
    right
    by_cases hn1 : n = 1
    · exact Or.inl hn1
    right
    by_cases hm2 : m = 2
    · subst m
      exact Or.inl ⟨rfl,(two_good_iff σ).mp hg⟩
    right
    by_cases hn2 : n = 2
    · subst n
      refine Or.inl ⟨rfl,?_⟩
      simpa only [show entry (transpose σ) 0 = (fun j => entry σ j 0) from funext (entry_transpose σ 0),
        show entry (transpose σ) 1 = (fun j => entry σ j 1) from funext (entry_transpose σ 1)] using (two_good_iff (transpose σ)).mp ((good_transpose σ).mpr hg)
    right
    have hm3 : m = 3 := by
      by_contra hne
      exact no_good_large (transpose σ) (by omega) (by omega) ((good_transpose σ).mpr hg)
    have hn3 : n = 3 := by
      by_contra hne
      exact no_good_large σ (by omega) (by omega) hg
    subst m; subst n
    exact ⟨rfl,rfl,(three_good_iff σ).mp hg⟩
  · intro hs
    rcases hs with hm1 | hn1 | ⟨hm2,h⟩ | ⟨hn2,h⟩ | ⟨hm3,hn3,h⟩
    · exact good_of_one σ (Or.inl hm1)
    · exact good_of_one σ (Or.inr hn1)
    · subst m
      exact (two_good_iff σ).mpr h
    · subst n
      apply (good_transpose σ).mp
      apply (two_good_iff (transpose σ)).mpr
      simpa only [show entry (transpose σ) 0 = (fun j => entry σ j 0) from funext (entry_transpose σ 0),
        show entry (transpose σ) 1 = (fun j => entry σ j 1) from funext (entry_transpose σ 1)] using h
    · subst m; subst n
      exact (three_good_iff σ).mpr h

end D5.S3.Combinatorics.Permutation.OnnGoodPermutationStructure
