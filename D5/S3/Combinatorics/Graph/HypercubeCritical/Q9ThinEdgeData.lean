private def weights : Array (Array Nat) := #[weights0, weights1, weights2, weights3, weights4, weights5, weights6]

/-- The literal support mask of each representative. -/
def supportMask (k : Fin 7) : Nat := supportMasks[k.val]?.getD 0

/-- The mask of the residual vertices after removing the closed neighborhood. -/
def residualMask (k : Fin 7) : Nat := residualMasks[k.val]?.getD 0

/-- Slots zero and one are the vertex and slack weights. The next nine
slots are edge weights indexed by the flipped coordinate. -/
def weight (k : Fin 7) (vertex slot : Nat) : Nat :=
  let packed := ((weights[k.val]?.getD #[])[vertex]?.getD 0)
  (packed >>> (22 * slot)) &&& ((1 <<< 22) - 1)

