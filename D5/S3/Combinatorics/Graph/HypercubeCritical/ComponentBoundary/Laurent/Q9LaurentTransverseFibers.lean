open Q9LaurentCommonTriple (insideFlip)

open private mem_twoStepPaths from
  D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Q9LaurentGainPartition
open private mem_star from
  D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Laurent.Q9LaurentCommonTriple

variable {C : Finset (Q 9)} {b : Bool} {S : Block} {root : Side C b}

/-- Include a selected leaf of a transverse component in the original graph. -/
def liftTransverse (x : Side (transverseSupport S root) b) : Side C b :=
  ⟨x.val, transverseSupport_subset S root x.property.1, x.property.2⟩

/-- In the restricted support, each occupied block fiber is a three-leaf
star with affine height measured using the original Laurent identity. -/
theorem transverseFiber_star_offset {e : Axes} {a : Side C b → Exponent}
    (h : LaurentIdentity a) (hstar : UniqueCommonNeighbor (transverseSupport S root) b e)
    (x : Side (transverseSupport S root) b) :
    ∃ c ∈ transverseSupport S root, ∃ k : Exponent,
      fiber (transverseSupport S root) b e (outside e x.val) = star e c ∧
      ∀ (y : Side (transverseSupport S root) b), outside e y.val = outside e x.val →
        ∃ j : Fin 3, cubeFlip c (e (.inl j)) = y.val ∧
          a (liftTransverse y) = k + axis (e (.inl j)) := by
  classical
  obtain ⟨c, hc, _, hF⟩ := exists_star_over_projection hstar x
  have hx : x.val ∈ star e c := hF ▸ mem_filter.mpr ⟨x.property.1, x.property.2, rfl⟩
  obtain ⟨i, hi⟩ := mem_star.mp hx
  obtain ⟨k, hk⟩ := exists_star_exponent_offset h (transverseSupport_subset S root hc)
    (liftTransverse x) (e (.inl i)) hi
  refine ⟨c, hc, k, hF, ?_⟩
  intro y hy
  have hy' : y.val ∈ star e c := hF ▸ mem_filter.mpr ⟨y.property.1, y.property.2, hy⟩
  obtain ⟨j, hj⟩ := mem_star.mp hy'
  exact ⟨j, hj, hk (liftTransverse y) (e (.inl j)) hj⟩

/-- Each surviving triple has constant parity on the selected side of a
transverse component. At a two-step move its parity changes twice or zero times. -/
theorem blockParity_eq_on_transverseSide {e : Axes}
    (hparts : ∀ x ∈ transverseSide S root, IsTriplePartition (neighborPartition C x.val))
    (hblock : ∀ x ∈ transverseSide S root, commonAxes e ∈ neighborPartition C x.val)
    {y : Side C b} (hy : y ∈ transverseSide S root) :
    cubeParity (inside e y.val) = cubeParity (inside e root.val) := by
  induction mem_transverseSide.mp hy with
  | refl => rfl
  | @tail x z hpath hstep ih =>
    obtain ⟨p, _, _, rfl⟩ := hstep
    have hx := mem_transverseSide.mpr hpath
    obtain ⟨hi, hj, _⟩ := mem_twoStepPaths.mp p.property
    let T := directions C (cubeFlip x.val p.val.1)
    have hT : T ∈ neighborPartition C x.val := mem_image.mpr ⟨p.val.1, hi, rfl⟩
    have hT₁ : p.val.1 ∈ T := (mem_directions C _ _).mpr (by
      rw [BalancedCriticalSpectrum.flip_flip]
      exact x.property.1)
    have hT₂ : p.val.2 ∈ T := hj
    have hsame : p.val.1 ∈ commonAxes e ↔ p.val.2 ∈ commonAxes e := by
      by_cases he : T = commonAxes e
      · rw [← he]
        exact ⟨fun _ => hT₂, fun _ => hT₁⟩
      have hdisj := (hparts x hx).disjoint_blocks hT (hblock x hx) he
      exact ⟨fun h => (disjoint_left.mp hdisj hT₁ h).elim,
        fun h => (disjoint_left.mp hdisj hT₂ h).elim⟩
    have hbit : decide (p.val.1 ∈ commonAxes e) = decide (p.val.2 ∈ commonAxes e) :=
      decide_eq_decide.mpr hsame
    change cubeParity (inside e (cubeFlip (cubeFlip x.val p.val.1) p.val.2)) = _
    rw [insideFlip, insideFlip, hbit, ih hx]
    cases cubeParity (inside e root.val) <;> cases decide (p.val.2 ∈ commonAxes e) <;> decide

/-- A transverse component lies in one slice of the deleted triple. -/
theorem inside_eq_on_transverseSide {e : Axes} (he : commonAxes e = S)
    {y : Side C b} (hy : y ∈ transverseSide S root) :
    inside e y.val = inside e root.val := by
  have step (v : Q 9) (i : Fin 9) (hi : i ∉ S) : inside e (cubeFlip v i) = inside e v := by
    funext j
    have hj : e (.inl j) ≠ i := by
      intro heq
      apply hi
      rw [← he]
      exact mem_image.mpr ⟨j, mem_univ _, heq⟩
    exact Function.update_of_ne hj _ _
  induction mem_transverseSide.mp hy with
  | refl => rfl
  | @tail x z hpath hstep ih =>
    obtain ⟨p, hi, hj, rfl⟩ := hstep
    change inside e (cubeFlip (cubeFlip x.val p.val.1) p.val.2) = _
    rw [step _ _ hj, step _ _ hi]
    exact ih (mem_transverseSide.mpr hpath)


end Q9TriplePartitions
end D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary

namespace D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary
namespace Q9TriplePartitions

open Finset
open D5.S3.Combinatorics.Graph.Hypercube (hypercube)
open BalancedCriticalSpectrum (Q)
local notation "cubeFlip" => BalancedCriticalSpectrum.flip
open BalancedCubeComponentBoundary (directions mem_directions)
open Q9LaurentGainPartition (Side PathAt pathEnd reversePath)
open Q9LaurentCommonTriple (Axes commonAxes outside)
open private mem_twoStepPaths pathEnd_reverse from
  D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Q9LaurentGainPartition
open BalancedCubeGirth (adjacent_exists_flip)
open private outside_flip from
  D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Laurent.Q9LaurentCommonTriple

variable {C : Finset (Q 9)} {b : Bool}

private theorem transverseMove_symm {S : Block} {x y : Side C b} :
    transverseMove S x y → transverseMove S y x := by
  rintro ⟨p, hi, hj, rfl⟩
  exact ⟨reversePath x p, hj, hi, pathEnd_reverse x p⟩

/-- Connected pieces after deleting the common triple. -/
def transverseComponents (S : Block) : Setoid (Side C b) where
  r := Relation.ReflTransGen (transverseMove S)
  iseqv := ⟨fun _ => .refl, fun h => by
    induction h with
    | refl => exact .refl
    | tail _ he ih => exact (Relation.ReflTransGen.single (transverseMove_symm he)).trans ih,
    fun h h' => h.trans h'⟩

theorem transverse_or_same_projection_of_partition {e : Axes} {x : Side C b}
    (hpart : IsTriplePartition (neighborPartition C x.val))
    (hshared : commonAxes e ∈ neighborPartition C x.val)
    (y : Side C b) (v : ↥C)
    (hx : ((hypercube 9).induce (C : Set (Q 9))).Adj ⟨x.val, x.property.1⟩ v)
    (hy : ((hypercube 9).induce (C : Set (Q 9))).Adj v ⟨y.val, y.property.1⟩) :
    (transverseComponents (commonAxes e)).r x y ∨ outside e x.val = outside e y.val := by
  obtain ⟨i, hi⟩ := adjacent_exists_flip hx
  obtain ⟨j, hj⟩ := adjacent_exists_flip hy
  change v.val = cubeFlip x.val i at hi
  change y.val = cubeFlip v.val j at hj
  have hBack : cubeFlip v.val i = x.val := by
    rw [hi, BalancedCriticalSpectrum.flip_flip]
  have hiC : i ∈ directions C x.val := (mem_directions C _ _).mpr (hi ▸ v.property)
  have hiV : i ∈ directions C v.val := (mem_directions C _ _).mpr (hBack.symm ▸ x.property.1)
  have hjV : j ∈ directions C v.val := (mem_directions C _ _).mpr (hj ▸ y.property.1)
  have hV : directions C v.val ∈ neighborPartition C x.val := mem_image.mpr ⟨i, hiC, hi.symm ▸ rfl⟩
  by_cases hij : i = j
  · subst j
    exact Or.inr (congrArg (outside e) (hBack.symm.trans hj.symm))
  by_cases hShared : directions C v.val = commonAxes e
  · right
    rw [hShared] at hiV hjV
    obtain ⟨k, _, hk⟩ := mem_image.mp hiV
    obtain ⟨l, _, hl⟩ := mem_image.mp hjV
    have hL : outside e x.val = outside e v.val := by
      rw [← hBack, ← hk, outside_flip]
    have hR' : outside e y.val = outside e v.val := by rw [hj, ← hl, outside_flip]
    exact hL.trans hR'.symm
  · left
    have hd := hpart.disjoint_blocks hV hshared hShared
    let p : PathAt C x.val := ⟨(i, j), mem_twoStepPaths.mpr ⟨hiC, hi ▸ hjV, hij⟩⟩
    have hend : pathEnd x p = y := by
      apply Subtype.ext
      change cubeFlip (cubeFlip x.val i) j = y.val
      rw [← hi, hj]
    exact .single ⟨p, fun h => disjoint_left.mp hd hiV h,
      fun h => disjoint_left.mp hd hjV h, hend⟩

/-- A two-step move through a center of the shared type fixes the transverse
coordinates. A move through any other type uses two surviving axes. -/
theorem transverse_or_same_projection {e : Axes} {P R : Partition}
    (hP : IsTriplePartition P) (hR : IsTriplePartition R)
    (hSP : commonAxes e ∈ P) (hSR : commonAxes e ∈ R)
    (htypes : ∀ x : Side C b, neighborPartition C x.val = P ∨ neighborPartition C x.val = R)
    (x y : Side C b) (v : ↥C)
    (hx : ((hypercube 9).induce (C : Set (Q 9))).Adj ⟨x.val, x.property.1⟩ v)
    (hy : ((hypercube 9).induce (C : Set (Q 9))).Adj v ⟨y.val, y.property.1⟩) :
    (transverseComponents (commonAxes e)).r x y ∨ outside e x.val = outside e y.val := by
  obtain ⟨hpart, hshared⟩ := row_partition_and_mem_of_two_types hP hR hSP hSR htypes x
  exact transverse_or_same_projection_of_partition (e := e) (x := x) hpart hshared y v hx hy


end Q9TriplePartitions
end D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary
