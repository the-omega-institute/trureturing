open BalancedCriticalSpectrum (Q)
local notation "cubeFlip" => BalancedCriticalSpectrum.flip
open BalancedCubeComponentBoundary (mem_directions)
open private mem_twoStepPaths from
  D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Q9LaurentGainPartition

/-- One affine offset describes the height of all selected leaves at a center.
The chosen support may be the original graph while the leaves come from a slice. -/
theorem exists_star_exponent_offset {C : Finset (Q 9)} {b : Bool} {a : Side C b → Exponent}
    (h : LaurentIdentity a) {c : Q 9} (hc : c ∈ C)
    (x : Side C b) (i : Fin 9) (hx : cubeFlip c i = x.val) :
    ∃ offset : Exponent, ∀ (y : Side C b) (j : Fin 9), cubeFlip c j = y.val →
      a y = offset + axis j := by
  refine ⟨a x - axis i, ?_⟩
  intro y j hy
  by_cases hij : i = j
  · subst j
    have hxy : x = y := Subtype.ext (hx.symm.trans hy)
    rw [← hxy, sub_add_cancel]
  have hback : cubeFlip x.val i = c := by rw [← hx, BalancedCriticalSpectrum.flip_flip]
  let p : PathAt C x.val := ⟨(i, j), mem_twoStepPaths.mpr ⟨
    (mem_directions C _ _).mpr (hback.symm ▸ hc),
    (mem_directions C _ _).mpr (by rw [hback, hy]; exact y.property.1), hij⟩⟩
  have hEnd : pathEnd x p = y := by
    apply Subtype.ext
    change cubeFlip (cubeFlip x.val i) j = y.val
    rw [hback, hy]
  have hgain := (path_exponent_and_gain h x p).2.2
  change a (pathEnd x p) - a x = axis j - axis i at hgain
  rw [hEnd] at hgain
  funext k
  have hk := congrFun hgain k
  simp only [Pi.sub_apply, Pi.add_apply] at hk ⊢
  omega


end Q9LaurentGainPartition
