open Finset
open D5.S3.Combinatorics.Graph.Hypercube (hypercube)
open BalancedCriticalSpectrum (Q)
local notation "cubeFlip" => BalancedCriticalSpectrum.flip
open BalancedCubeComponentBoundary (directions mem_directions)
open Q9IsotropicHuang (parity)
open Q9LaurentGainPartition (Side LaurentIdentity Exponent)
open private cubeParity cubeParity_ne_of_adj from
  D5.S3.Combinatorics.Graph.HypercubeSubQuorum
open BalancedCubeGirth (adjacent_exists_flip)
open private flip_parity from
  D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Q9LaurentGainPartition

/-- Factor the six surviving height coordinates through the projection. -/
theorem exists_projected_exponent {C : Finset (Q 9)} {b : Bool} {e : Axes}
    {a : Side C b → Exponent} (h : LaurentIdentity a)
    (hcommon : UniqueCommonNeighbor C b e) :
    ∃ g : Q 6 → Fin 6 → ℤ,
      ∀ x : Side C b, g (outside e x.val) = fun i => a x (e (.inr i)) := by
  let f (x : Side C b) : Fin 6 → ℤ := fun i => a x (e (.inr i))
  have hfactor : Function.FactorsThrough f (fun x : Side C b => outside e x.val) :=
    fun {_ _} hOut => funext (exponent_eq_outside h hcommon _ _ hOut)
  obtain ⟨g, hg⟩ := (Function.factorsThrough_iff f).mp hfactor
  exact ⟨g, fun x => (congrFun hg x).symm⟩

private theorem insideFlip (e : Axes) (x : Q 9) (i : Fin 9) :
    cubeParity (inside e (cubeFlip x i)) =
      cubeParity (inside e x) + decide (i ∈ commonAxes e) := by
  by_cases hi : i ∈ commonAxes e
  · obtain ⟨j, _, rfl⟩ := mem_image.mp hi
    have he : inside e (cubeFlip x (e (.inl j))) = cubeFlip (inside e x) j := by
      funext k
      by_cases h : k = j
      · subst k
        simp [inside, BalancedCriticalSpectrum.flip]
      · have h' : e (.inl k) ≠ e (.inl j) := fun h' => h (Sum.inl.inj (e.injective h'))
        simp [inside, BalancedCriticalSpectrum.flip, h, h']
    have hpar := cubeParity_ne_of_adj (BalancedCriticalSpectrum.flip_adj (inside e x) j)
    rw [he]
    simp only [hi, decide_true]
    have hflip := Bool.eq_not_of_ne (Ne.symm hpar)
    rw [hflip]
    cases cubeParity (inside e x) <;> decide
  · have he : inside e (cubeFlip x i) = inside e x := by
      funext k
      have h : e (.inl k) ≠ i := fun h => hi (mem_image.mpr ⟨k, mem_univ _, h⟩)
      simp [inside, BalancedCriticalSpectrum.flip, h]
    rw [he]
    simp only [hi, decide_false]
    exact (add_zero _).symm

open scoped Classical in
/-- If every opposite-parity direction triple is either the shared triple or
is disjoint from it, the selected parity has constant inside parity. -/
theorem inside_parity_eq {C : Finset (Q 9)} {b : Bool} {e : Axes}
    (hc : ((hypercube 9).induce (C : Set (Q 9))).Connected)
    (hdir : ∀ v : Side C (!b), directions C v.val = commonAxes e ∨
      Disjoint (directions C v.val) (commonAxes e)) (x y : Side C b) :
    cubeParity (inside e x.val) = cubeParity (inside e y.val) := by
  classical
  let g (v : ↥C) := cubeParity (inside e v.val) +
    decide (parity v.val = !b ∧ directions C v.val = commonAxes e)
  have hgStep {a z : ↥C} (ha : parity a.val = !b) (hz : parity z.val = b)
      (h : ((hypercube 9).induce (C : Set (Q 9))).Adj a z) : g a = g z := by
    obtain ⟨i, hi⟩ := adjacent_exists_flip h
    change z.val = cubeFlip a.val i at hi
    have hmem : i ∈ directions C a.val := (mem_directions C _ _).mpr (hi.symm ▸ z.property)
    have htype : i ∈ commonAxes e ↔ directions C a.val = commonAxes e := by
      rcases hdir ⟨a.val, a.property, ha⟩ with heq | hdis
      · rw [← heq]
        exact ⟨fun _ => rfl, fun _ => hmem⟩
      · constructor
        · exact fun hS => (disjoint_left.mp hdis hmem hS).elim
        · exact fun heq => (disjoint_left.mp hdis hmem (heq ▸ hmem)).elim
    have hbn : b ≠ !b := by cases b <;> decide
    simp only [g, ha, hz, true_and, hbn, false_and, decide_false]
    have hbool : decide (i ∈ commonAxes e) = decide (directions C a.val = commonAxes e) :=
      decide_eq_decide.mpr htype
    rw [hi, insideFlip e, hbool]
    exact (add_zero _).symm
  have hgAdj {a z : ↥C} (h : ((hypercube 9).induce (C : Set (Q 9))).Adj a z) :
      g a = g z := by
    obtain ⟨i, hi⟩ := adjacent_exists_flip h
    change z.val = cubeFlip a.val i at hi
    have hp : parity z.val = !parity a.val := by rw [hi, flip_parity]
    by_cases ha : parity a.val = b
    · exact (hgStep (hp.trans (congrArg Bool.not ha)) ha h.symm).symm
    · have ha' : parity a.val = !b := Bool.eq_not_of_ne ha
      have hz' : parity z.val = b := by simpa [ha'] using hp
      exact hgStep ha' hz' h
  have hw {a z : ↥C} (w : ((hypercube 9).induce (C : Set (Q 9))).Walk a z) :
      g a = g z := by
    induction w with
    | nil => rfl
    | cons h _ ih => exact (hgAdj h).trans ih
  obtain ⟨w⟩ := hc.preconnected (⟨x.val, x.property.1⟩ : ↥C) ⟨y.val, y.property.1⟩
  have hbn : b ≠ !b := by cases b <;> decide
  have heq := hw w
  simp only [g, x.property.2, y.property.2, hbn, false_and, decide_false] at heq
  exact add_right_cancel heq


end Q9LaurentCommonTriple
