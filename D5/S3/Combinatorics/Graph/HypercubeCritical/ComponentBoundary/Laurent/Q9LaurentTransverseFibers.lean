/-! Deleting the shared triple preserves neighbor partitions and retains the transverse star fibers. -/

set_option autoImplicit false

namespace D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary
namespace Q9TriplePartitions

open Finset
open BalancedCriticalSpectrum (Q)
local notation "cubeFlip" => BalancedCriticalSpectrum.flip
open BalancedCubeComponentBoundary (directions mem_directions)
open Q9LaurentGainPartition (Side PathAt pathEnd LaurentIdentity Exponent)
open Q9IsotropicHuang (parity)
open Q9LaurentCommonTriple (Axes commonAxes UniqueCommonNeighbor)
