set_option maxRecDepth 32768 in
set_option maxHeartbeats 3000000 in
-- Closed computations scan 512 vertices per support and three mask directions.
private theorem checks : records.all (fun p => sparseMaskCheck p.1 p.2.1 p.2.2) = true := by
  decide +kernel

/-- Every support in the regular lift list is incompatible with universal
weighted saturation, assuming coherent switching of the actual support. -/
theorem listed_support_not_universal (p : ℕ × Fin 9 × Finset (Fin 9)) (hp : p ∈ records)
    {σ : Q 9 → ℝ} (hs : IsSwitching (support p.1) σ) (b : Bool) :
    ¬ (∀ w : Fin 9 → ℝ, ∃ f ≠ 0, boundary (support p.1) b w *ᵥ f = 0) :=
  not_universal_of_sparseMaskCheck (List.all_eq_true.mp checks p hp) hs b

#print axioms listed_support_not_universal
end D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Q9RegularSparseMaskData
