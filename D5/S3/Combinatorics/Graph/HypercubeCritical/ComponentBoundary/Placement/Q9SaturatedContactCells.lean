/-- Two vertices lie in the same fibre over the coordinates outside `A`. -/
def AgreeOutside (A : Finset (Fin 9)) (root x : Q 9) : Prop :=
  ∀ k ∉ A, x k = root k

private theorem agreeOutside_flip {A : Finset (Fin 9)} {k : Fin 9} (hk : k ∈ A)
    (root x : Q 9) : AgreeOutside A root (flip x k) ↔ AgreeOutside A root x := by
  have hbit (l : Fin 9) (hl : l ∉ A) : flip x k l = x l := by
    have hlk : l ≠ k := fun h => hl (h.symm ▸ hk)
    simp [BalancedCriticalSpectrum.flip, hlk]
  exact ⟨fun h l hl => (hbit l hl).symm.trans (h l hl),
    fun h l hl => (hbit l hl).trans (h l hl)⟩

/-- The multiplier needs weighted covariance only for realized distance-two
masks incident to the direction of the pairing. -/
private theorem multiplier_overlap_zero {C D : Finset (Q 9)}
    {b : Bool} (hdisj : Disjoint C D) (hsep : Separated C D)
    {f g : Vec} (hf : Supported C f) (hfb : OnParity b f)
    (hHf : Supported C (H f)) (hg : Supported D g)
    (a : Q 9 → ℝ) (w : Fin 9 → ℝ) {l : Fin 9}
    (ha : ∀ k, k ≠ l → ({k, l} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2 →
      ∀ x, w k * a (BalancedCriticalSpectrum.flip x k) = a x) :
    (fun x => a x * f x) ⬝ᵥ gamma l (weightedLinear w g) = 0 := by
  classical
  let F : Vec := fun x => a x * f x
  have hF : Supported C F := fun x hx => by simp [F, hf x hx]
  have haHf : Supported C (fun x => a x * H f x) := fun x hx => by simp [hHf x hx]
  have hcomm :
      weightedLinear w F ⬝ᵥ gamma l g = (fun x => a x * H f x) ⬝ᵥ gamma l g := by
    unfold dotProduct
    apply Finset.sum_congr rfl
    intro z _
    rw [← unit_weight f]
    simp only [weighted_sum, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, one_mul,
      Finset.mul_sum, Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro k _
    by_cases hk : k ≠ l ∧ ({k, l} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2
    · calc
        _ = (w k * a (flip z k)) * gamma k f z * gamma l g z := by
          simp only [gamma_apply, F]
          ring
        _ = _ := by rw [ha k hk.1 hk.2 z]
    · by_cases hfz : f (flip z k) = 0
      · simp [gamma_apply, F, hfz]
      · have hgz : g (flip z l) = 0 := by
          by_contra hgz
          have hCz : flip z k ∈ C := by
            by_contra hn
            exact hfz (hf _ hn)
          have hbz : parity (flip z k) = b := by
            by_contra hn
            exact hfz (hfb _ hn)
          have hDz : flip z l ∈ D := by
            by_contra hn
            exact hgz (hg _ hn)
          have hkl : k ≠ l := by
            intro heq
            exact Finset.disjoint_left.mp hdisj hCz (heq.symm ▸ hDz)
          have hdiffer : differingAxes (flip z k) (flip z l) = {k, l} := by
            simpa using differingAxes_foldl_flip [k, l] (by simp [hkl]) (flip z k)
          have hdist : hammingDist (flip z k) (flip z l) = 2 := by
            change (differingAxes (flip z k) (flip z l)).card = 2
            rw [hdiffer, Finset.card_pair hkl]
          have hmask : ({k, l} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2 :=
            mem_minimumDisplacements.mpr ⟨_, hCz, _, hDz, hbz, hdist, hdiffer⟩
          exact hk ⟨hkl, hmask⟩
        simp [gamma_apply, hgz]
  have hrow : weightedLinear w F ⬝ᵥ gamma l g = 0 := by
    rw [hcomm]
    exact gamma_separated hsep l haHf hg
  have hanti : weightedLinear w (gamma l F) = (2 * w l) • F - gamma l (weightedLinear w F) :=
    eq_sub_of_add_eq (weighted_anticommutator w l F)
  change F ⬝ᵥ gamma l (weightedLinear w g) = 0
  rw [← gamma_selfAdjoint, ← weighted_selfAdjoint, hanti, sub_dotProduct,
    smul_dotProduct, dot_disjoint hdisj hF hg, gamma_selfAdjoint, hrow]
  simp

open Classical in
private theorem annihilate_at_unit (D : Finset (Q 9)) (r : Vec)
    (hrD : Cubic D) (hcD : Connected D) (hr : IsSwitching D r) (b : Bool) (j : Fin 9)
    (hdet : ∀ t : ℝ, 0 < t →
      (defect (axisWeight j t) (signedBiadjacency (axisWeight j t) D false)).det = 0)
    (L : Vec →ₗ[ℝ] ℝ)
    (hann : ∀ (t : ℝ), t ≠ 1 → ∀ (g : Vec), Supported D g →
      Supported D (weightedLinear (axisWeight j t) g) → L g = 0) :
    L (parityPart b (switchingVector D r)) = 0 := by
  classical
  have hcard : 0 < D.card := by
    obtain ⟨x⟩ := hcD.nonempty
    exact Finset.card_pos.mpr ⟨x.val, x.property⟩
  have hparCard := regular_parity_card D b (d := 3) (by decide) hrD
  obtain ⟨x, hx⟩ := Finset.card_pos.mp (show 0 < (paritySide D b).card by omega)
  let root : Q 9 := x.val
  have hroot : root ∈ D := x.property
  have hrootParity : parity root = b := (Finset.mem_filter.mp hx).2
  have hbD : IsBalanced D := ⟨r, hr⟩

  let Sphere := ↥(Metric.sphere (0 : Vec) 1)
  letI : CompactSpace Sphere := isCompact_iff_compactSpace.mp (isCompact_sphere (0 : Vec) 1)
  let v (z : ℝ × Sphere) : Vec := z.2.val
  let W (z : ℝ × Sphere) : Vec := weightedLinear (axisWeight j z.1) (v z)
  have hv : Continuous v := continuous_subtype_val.comp continuous_snd
  have hW : Continuous W := by
    have hformula : W = fun z => H (v z) + (z.1 - 1) • gamma j (v z) := by
      funext z
      exact axis_weight j z.1 (v z)
    rw [hformula]
    exact (H.continuous_of_finiteDimensional.comp hv).add
      ((continuous_fst.sub continuous_const).smul
        ((gamma j).continuous_of_finiteDimensional.comp hv))
  have hclosedCoordinates (F : ℝ × Sphere → Vec) (hF : Continuous F) (P : Q 9 → Prop) :
      IsClosed {z : ℝ × Sphere | ∀ x, P x → F z x = 0} := by
    have heq : {z : ℝ × Sphere | ∀ x, P x → F z x = 0} =
        ⋂ x : {x : Q 9 // P x}, {z : ℝ × Sphere | F z x.val = 0} := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_iInter]
      exact ⟨fun h x => h x.val x.property, fun h x hx => h ⟨x, hx⟩⟩
    rw [heq]
    exact isClosed_iInter fun x =>
      isClosed_eq ((continuous_apply x.val).comp hF) continuous_const

  let K : Set (ℝ × Sphere) := {z | Supported D (v z) ∧ OnParity b (v z) ∧
    Supported D (W z) ∧ L (v z) = 0}
  have hK : IsClosed K :=
    (hclosedCoordinates v hv (fun x => x ∉ D)).inter
      ((hclosedCoordinates v hv (fun x => parity x ≠ b)).inter
        ((hclosedCoordinates W hW (fun x => x ∉ D)).inter
          (isClosed_eq (L.continuous_of_finiteDimensional.comp hv) continuous_const)))
  have hprojection : IsClosed (Prod.fst '' K) := isClosedMap_fst_of_compactSpace K hK
  have hinterval : Set.Ioo (1 : ℝ) 2 ⊆ Prod.fst '' K := by
    intro t ht
    have htpos : 0 < t := lt_trans (by norm_num : (0 : ℝ) < 1) ht.1
    have hw (k : Fin 9) : 0 < axisWeight j t k := by
      by_cases hk : k = j <;> simp [axisWeight, hk, htpos]
    obtain ⟨u, hu, huW⟩ := exists_both_parity_supported_of_signed_defect_singular
      D hrD hcD hbD (axisWeight j t) hw (hdet t htpos) b
    have hu0 : u ≠ 0 := by
      intro h
      exact (hu root).2 ⟨hroot, hrootParity⟩ (by simp [h])
    let g : Sphere := ⟨NormedSpace.normalize u,
      mem_sphere_zero_iff_norm.mpr (NormedSpace.norm_normalize hu0)⟩
    have hgZero (y : Q 9) (hy : ¬ (y ∈ D ∧ parity y = b)) : (g : Vec) y = 0 := by
      have huy : u y = 0 := not_not.mp (fun h => hy ((hu y).mp h))
      simp only [g, NormedSpace.normalize, Pi.smul_apply, huy, smul_zero]
    have hgD : Supported D (g : Vec) := fun y hy => hgZero y (fun h => hy h.1)
    have hgb : OnParity b (g : Vec) := fun y hy => hgZero y (fun h => hy h.2)
    have hgW : Supported D (weightedLinear (axisWeight j t) (g : Vec)) := by
      intro y hy
      change weightedLinear (axisWeight j t) (‖u‖⁻¹ • u) y = 0
      rw [map_smul, Pi.smul_apply, huW y hy, smul_zero]
    have hgL : L (g : Vec) = 0 :=
      hann t (ne_of_gt ht.1) (g : Vec) hgD hgW
    exact ⟨(t, g), ⟨hgD, hgb, hgW, hgL⟩, rfl⟩

  have hunit : (1 : ℝ) ∈ closure (Set.Ioo 1 2) := by
    rw [closure_Ioo (show (1 : ℝ) ≠ 2 by norm_num)]
    exact Set.left_mem_Icc.mpr (by norm_num)
  obtain ⟨⟨t, g⟩, hg, ht⟩ := closure_minimal hinterval hprojection hunit
  change t = 1 at ht
  subst t
  obtain ⟨hgD, hgb, hgW, hgL⟩ : Supported D (g : Vec) ∧ OnParity b (g : Vec) ∧
      Supported D (weightedLinear (axisWeight j 1) (g : Vec)) ∧ L (g : Vec) = 0 := hg
  have hg0 : (g : Vec) ≠ 0 := by
    intro h
    have hn : ‖(g : Vec)‖ = 1 := mem_sphere_zero_iff_norm.mp g.property
    rw [h, norm_zero] at hn
    exact zero_ne_one hn
  have hweightOne : axisWeight j (1 : ℝ) = fun _ => 1 := by
    funext k
    simp [axisWeight]
  rw [hweightOne, unit_weight] at hgW
  have hline := unit_line hrD hcD hr hgD hgb hgW root hroot hrootParity
  have hscalar : (g : Vec) root * r root ≠ 0 := by
    intro hzero
    apply hg0
    rw [hline, hzero, zero_smul]
  have hmul := (congrArg L hline).symm.trans hgL
  rw [map_smul, smul_eq_mul] at hmul
  exact (mul_eq_zero.mp hmul).resolve_left hscalar

open Classical in
/-- The signed overlap in directions `i,j` vanishes against every real multiplier
invariant under flips in the other realized distance-two contact directions at `i`. -/
theorem signed_overlap_multiplier_zero (C D : Finset (Q 9)) (s r : Vec)
    (hdisj : Disjoint C D) (hsep : Separated C D) (hrC : Cubic C) (hrD : Cubic D)
    (hcD : Connected D) (hs : IsSwitching C s) (hr : IsSwitching D r)
    (b : Bool) (i j : Fin 9)
    (hdet : ∀ t : ℝ, 0 < t →
      let w : Fin 9 → ℝ := fun k => if k = j then t else 1
      (defect w (signedBiadjacency w D false)).det = 0)
    (P : Q 9 → ℝ)
    (hP : ∀ k, k ≠ i → k ≠ j →
      ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2 →
      ∀ x, P (BalancedCriticalSpectrum.flip x k) = P x) :
    (fun x => P x * parityPart b (switchingVector C s) x) ⬝ᵥ
      gamma i (gamma j (parityPart b (switchingVector D r))) = 0 := by
  classical
  let f := parityPart b (switchingVector C s)
  let g := parityPart b (switchingVector D r)
  let plus (x : Q 9) : ℝ := (P x + P (flip x j)) / 2
  let minus (x : Q 9) : ℝ := (P x - P (flip x j)) / 2
  let Fplus : Vec := fun x => plus x * f x
  let Fminus : Vec := fun x => minus x * f x
  have switch_support (S : Finset (Q 9)) (u : Vec) (c : Bool) :
      Supported S (parityPart c (switchingVector S u)) := by
    intro x hx
    simp [parityPart_apply, switchingVector, hx]
  have hf : Supported C f := switch_support C s b
  have hg : Supported D g := switch_support D r b
  have hfb : OnParity b f := fun x hx => by simp [f, parityPart_apply, hx]
  have hHf : Supported C (H f) := by
    change Supported C (H (parityPart b (switchingVector C s)))
    rw [parity_eigen C s hrC hs b]
    intro x hx
    simp [switch_support C s (!b) x hx]
  have hHg : Supported D (H g) := by
    change Supported D (H (parityPart b (switchingVector D r)))
    rw [parity_eigen D r hrD hr b]
    intro x hx
    simp [switch_support D r (!b) x hx]
  have hFplus : Supported C Fplus := fun x hx => by simp [Fplus, hf x hx]
  have hFminus : Supported C Fminus := fun x hx => by simp [Fminus, hf x hx]

  have hPcomm (k : Fin 9) (hki : k ≠ i) (hkj : k ≠ j)
      (hk : ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2) (x : Q 9) :
      P (flip (flip x k) j) = P (flip x j) := by
    rw [flip_comm x k j, hP k hki hkj hk]
  have hcovPlus (k : Fin 9) (hki : k ≠ i)
      (hk : ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2) (x : Q 9) :
      (1 : ℝ) * plus (flip x k) = plus x := by
    by_cases hkj : k = j
    · subst k
      simp only [one_mul, plus, BalancedCriticalSpectrum.flip_flip]
      ring
    · simp only [one_mul, plus, hP k hki hkj hk x, hPcomm k hki hkj hk x]
  have hcovMinus (k : Fin 9) (hki : k ≠ i)
      (hk : ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2) (x : Q 9) :
      axisWeight j (-1) k * minus (flip x k) = minus x := by
    by_cases hkj : k = j
    · subst k
      simp only [axisWeight, if_true, minus, BalancedCriticalSpectrum.flip_flip]
      ring
    · simp only [axisWeight, if_neg hkj, one_mul, minus,
        hP k hki hkj hk x, hPcomm k hki hkj hk x]

  let L : Vec →ₗ[ℝ] ℝ := (dotProductBilin ℝ ℝ Fplus).comp ((gamma i).comp (gamma j))
  have hann (t : ℝ) (ht : t ≠ 1) (u : Vec) (hu : Supported D u)
      (huW : Supported D (weightedLinear (axisWeight j t) u)) : L u = 0 := by
    have hweight := gamma_separated hsep i hFplus huW
    have hunit : Fplus ⬝ᵥ gamma i (H u) = 0 := by
      rw [← unit_weight u]
      exact multiplier_overlap_zero hdisj hsep hf hfb hHf hu plus (fun _ => 1) hcovPlus
    rw [axis_weight, map_add, map_smul, dotProduct_add, dotProduct_smul,
      hunit, zero_add, smul_eq_mul] at hweight
    change Fplus ⬝ᵥ gamma i (gamma j u) = 0
    exact (mul_eq_zero.mp hweight).resolve_left (sub_ne_zero.mpr ht)
  have hplus : Fplus ⬝ᵥ gamma i (gamma j g) = 0 :=
    annihilate_at_unit D r hrD hcD hr b j hdet L hann

  have hminus : Fminus ⬝ᵥ gamma i (gamma j g) = 0 := by
    have hunit := gamma_separated hsep i hFminus hHg
    have hweight :=
      multiplier_overlap_zero hdisj hsep hf hfb hHf hg minus (axisWeight j (-1)) (l := i) hcovMinus
    rw [axis_weight, map_add, map_smul, dotProduct_add, dotProduct_smul,
      hunit, zero_add, smul_eq_mul] at hweight
    exact (mul_eq_zero.mp hweight).resolve_left (by norm_num)

  have hsplit : (fun x => P x * f x) = Fplus + Fminus := by
    funext x
    change P x * f x = (P x + P (flip x j)) / 2 * f x + (P x - P (flip x j)) / 2 * f x
    ring
  change (fun x => P x * f x) ⬝ᵥ gamma i (gamma j g) = 0
  rw [hsplit, add_dotProduct, hplus, hminus, add_zero]

open Classical in
/-- Each fibre over the coordinates outside the contact neighbours of `i`
other than `j` has zero signed overlap. These fibres are the orbits of the
commuting flips in those neighbours. -/
theorem signed_overlap_endpoint_fibre_zero (C D : Finset (Q 9)) (s r : Vec)
    (hdisj : Disjoint C D) (hsep : Separated C D) (hrC : Cubic C) (hrD : Cubic D)
    (hcD : Connected D) (hs : IsSwitching C s) (hr : IsSwitching D r)
    (b : Bool) (i j : Fin 9)
    (hdet : ∀ t : ℝ, 0 < t →
      let w : Fin 9 → ℝ := fun k => if k = j then t else 1
      (defect w (signedBiadjacency w D false)).det = 0)
    (root : Q 9) :
    let A := Finset.univ.filter fun k : Fin 9 =>
      k ≠ i ∧ k ≠ j ∧ ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2
    (∑ x : Q 9, if AgreeOutside A root x then
      parityPart b (switchingVector C s) x *
        gamma i (gamma j (parityPart b (switchingVector D r))) x else 0) = 0 := by
  classical
  intro A
  let f := parityPart b (switchingVector C s)
  let g := parityPart b (switchingVector D r)
  let P : Q 9 → ℝ := fun x => if AgreeOutside A root x then 1 else 0
  have hP (k : Fin 9) (hki : k ≠ i) (hkj : k ≠ j)
      (hk : ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2) (x : Q 9) :
      P (flip x k) = P x := by
    have hA : k ∈ A := Finset.mem_filter.mpr ⟨Finset.mem_univ k, hki, hkj, hk⟩
    simp only [P, agreeOutside_flip hA root x]
  change (∑ x, if AgreeOutside A root x then f x * gamma i (gamma j g) x else 0) = 0
  calc
    _ = (fun x => P x * f x) ⬝ᵥ gamma i (gamma j g) := by
      unfold dotProduct
      apply Finset.sum_congr rfl
      intro x _
      by_cases hx : AgreeOutside A root x <;> simp [P, hx]
    _ = 0 := signed_overlap_multiplier_zero C D s r hdisj hsep hrC hrD hcD hs hr b i j hdet P hP

open Classical in
/-- Each signed two-bit contact cell cancels within any fibre of the inactive
coordinates. Only the chosen parity is used in the missing-mask hypothesis. -/
theorem signed_overlap_fibre_cell_zero (C D : Finset (Q 9)) (s r : Vec)
    (hdisj : Disjoint C D) (hsep : Separated C D) (hrC : Cubic C) (hrD : Cubic D)
    (hcD : Connected D) (hs : IsSwitching C s) (hr : IsSwitching D r)
    (b : Bool) (A : Finset (Fin 9))
    (hmasks : ∀ M ∈ minimumDisplacements C D b 2, M ⊆ A)
    (i j : Fin 9) (hi : i ∈ A) (hj : j ∈ A) (hij : i ≠ j)
    (hdet : ∀ t : ℝ, 0 < t →
      let w : Fin 9 → ℝ := fun k => if k = j then t else 1
      (defect w (signedBiadjacency w D false)).det = 0)
    (root : Q 9) (p q : Bool) :
    (∑ x : Q 9, if x i = p ∧ x j = q ∧ AgreeOutside A root x then
      parityPart b (switchingVector C s) x *
        gamma i (gamma j (parityPart b (switchingVector D r))) x else 0) = 0 := by
  let P : Q 9 → ℝ := fun x => if x i = p ∧ x j = q ∧ AgreeOutside A root x then 1 else 0
  have hP (k : Fin 9) (hki : k ≠ i) (hkj : k ≠ j)
      (hk : ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2) (x : Q 9) :
      P (BalancedCriticalSpectrum.flip x k) = P x := by
    have hkA : k ∈ A := hmasks _ hk (by simp)
    simp only [P, agreeOutside_flip hkA root x]
    simp [BalancedCriticalSpectrum.flip, Ne.symm hki, Ne.symm hkj]
  have hz := signed_overlap_multiplier_zero C D s r hdisj hsep hrC hrD hcD hs hr
    b i j hdet P hP
  unfold dotProduct at hz
  convert hz using 1
  apply Finset.sum_congr rfl
  intro x _
  by_cases hx : x i = p ∧ x j = q ∧ AgreeOutside A root x <;> simp [P, hx]

open Classical in
/-- Each unit-weight signed two-bit cell cancels on either parity when the
`false`-parity signed defect of `D` is singular for every positive weight on `j`. -/
theorem signed_overlap_cell_zero (C D : Finset (Q 9)) (s r : Vec)
    (hdisj : Disjoint C D) (hsep : Separated C D) (hrC : Cubic C) (hrD : Cubic D)
    (hcD : Connected D) (hs : IsSwitching C s) (hr : IsSwitching D r)
    (b : Bool) (i j : Fin 9) (hij : i ≠ j)
    (hdet : ∀ t : ℝ, 0 < t →
      let w : Fin 9 → ℝ := fun k => if k = j then t else 1
      (defect w (signedBiadjacency w D false)).det = 0)
    (p q : Bool) :
    (∑ x : Q 9, if x i = p ∧ x j = q then
      parityPart b (switchingVector C s) x *
        gamma i (gamma j (parityPart b (switchingVector D r))) x else 0) = 0 := by
  simpa [AgreeOutside] using signed_overlap_fibre_cell_zero C D s r hdisj hsep hrC hrD hcD hs hr
    b Finset.univ (fun M _ => Finset.subset_univ M) i j
    (Finset.mem_univ i) (Finset.mem_univ j) hij hdet (fun _ => false) p q

section

open BalancedCriticalSpectrum (flip_adj)
open private parity_flip from
  D5.S3.Combinatorics.Graph.HypercubeCritical.ComponentBoundary.Placement.Q9MinimumDistanceOperator

open Classical in
private theorem contact_card_even_of_sum_zero (C D : Finset (Q 9)) (s r : Vec)
    (hs : IsSwitching C s) (hr : IsSwitching D r)
    (b : Bool) (i j : Fin 9) (P : Q 9 → Prop) [DecidablePred P]
    (hzero : (∑ x : Q 9, if P x then
      parityPart b (switchingVector C s) x *
        gamma i (gamma j (parityPart b (switchingVector D r))) x else 0) = 0) :
    Even ((C.filter fun x => parity x = b ∧ P x ∧ flip (flip x i) j ∈ D).card) := by
  let cell := C.filter fun x => parity x = b ∧ P x ∧ flip (flip x i) j ∈ D
  let contrib (x : Q 9) : ℝ := if P x then
    parityPart b (switchingVector C s) x *
      gamma i (gamma j (parityPart b (switchingVector D r))) x else 0
  have hsign (x : Q 9) (hx : x ∈ cell) : contrib x = 1 ∨ contrib x = -1 := by
    obtain ⟨hxC, hxb, hxP, hxD⟩ := Finset.mem_filter.mp hx
    have hyb : parity (flip (flip x i) j) = b := by
      rw [parity_flip (flip x i) j, parity_flip x i, Bool.not_not, hxb]
    apply (abs_eq (show (0 : ℝ) ≤ 1 from zero_le_one)).mp
    simp only [contrib, if_pos hxP, gamma_apply, parityPart_apply,
      switchingVector, if_pos hxb, if_pos hyb, if_pos hxC, if_pos hxD, abs_mul,
      SupportedEigenSaturation.matrix_abs_of_adj (flip_adj x i),
      SupportedEigenSaturation.matrix_abs_of_adj (flip_adj (flip x i) j), one_mul]
    rcases hs.1 x hxC with h | h <;>
      rcases hr.1 (flip (flip x i) j) hxD with h' | h' <;> simp [h, h']
  have houtside (x : Q 9) (hx : x ∉ cell) : contrib x = 0 := by
    by_cases hbits : P x
    · by_cases hxC : x ∈ C
      · by_cases hxb : parity x = b
        · have hxD : flip (flip x i) j ∉ D :=
            fun hy => hx (Finset.mem_filter.mpr ⟨hxC, hxb, hbits, hy⟩)
          simp [contrib, hbits, gamma_apply, parityPart_apply, switchingVector, hxD]
        · simp [contrib, parityPart_apply, hxb]
      · simp [contrib, parityPart_apply, switchingVector, hxC]
    · simp [contrib, hbits]
  have hcell : (∑ x ∈ cell, contrib x) = 0 := by
    calc
      _ = ∑ x, contrib x :=
        Finset.sum_subset (Finset.subset_univ cell) (fun x _ hx => houtside x hx)
      _ = 0 := hzero
  let pos := cell.filter fun x => contrib x = 1
  let neg := cell.filter fun x => contrib x ≠ 1
  have hpos : (∑ x ∈ pos, contrib x) = (pos.card : ℝ) := by
    calc
      _ = ∑ _x ∈ pos, (1 : ℝ) :=
        Finset.sum_congr rfl (fun _ hx => (Finset.mem_filter.mp hx).2)
      _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul, mul_one]
  have hneg : (∑ x ∈ neg, contrib x) = -(neg.card : ℝ) := by
    calc
      _ = ∑ _x ∈ neg, (-1 : ℝ) := by
        apply Finset.sum_congr rfl
        intro x hx
        obtain ⟨hxcell, hxneg⟩ := Finset.mem_filter.mp hx
        exact (hsign x hxcell).resolve_left hxneg
      _ = _ := by simp only [Finset.sum_const, nsmul_eq_mul, mul_neg, mul_one]
  have hsum : (pos.card : ℝ) + -(neg.card : ℝ) = 0 := by
    rw [← hpos, ← hneg]
    exact (Finset.sum_filter_add_sum_filter_not cell (fun x => contrib x = 1) contrib).trans hcell
  have hcards : pos.card = neg.card := by
    have heq : (pos.card : ℝ) = (neg.card : ℝ) :=
      sub_eq_zero.mp (by simpa only [sub_eq_add_neg] using hsum)
    exact_mod_cast heq
  have hsplit : pos.card + neg.card = cell.card :=
    Finset.card_filter_add_card_filter_not (s := cell) (fun x => contrib x = 1)
  change Even cell.card
  exact ⟨pos.card, by rw [← hsplit, ← hcards]⟩

open Classical in
/-- The fixed-parity, fixed-two-bit distance-two contact cell has even size. -/
theorem signed_overlap_cell_card_even (C D : Finset (Q 9)) (s r : Vec)
    (hdisj : Disjoint C D) (hsep : Separated C D) (hrC : Cubic C) (hrD : Cubic D)
    (hcD : Connected D) (hs : IsSwitching C s) (hr : IsSwitching D r)
    (b : Bool) (i j : Fin 9) (hij : i ≠ j)
    (hdet : ∀ t : ℝ, 0 < t →
      let w : Fin 9 → ℝ := fun k => if k = j then t else 1
      (defect w (signedBiadjacency w D false)).det = 0)
    (p q : Bool) :
    Even ((C.filter fun x => parity x = b ∧ x i = p ∧ x j = q ∧
      flip (flip x i) j ∈ D).card) := by
  simpa only [and_assoc] using
    contact_card_even_of_sum_zero C D s r hs hr b i j (fun x => x i = p ∧ x j = q)
      (signed_overlap_cell_zero C D s r hdisj hsep hrC hrD hcD hs hr b i j hij hdet p q)

open Classical in
/-- On a fixed parity, each orbit of the other neighbours of the first contact
axis contains an even number of distance-two contacts of this mask. -/
theorem signed_overlap_endpoint_fibre_card_even (C D : Finset (Q 9)) (s r : Vec)
    (hdisj : Disjoint C D) (hsep : Separated C D) (hrC : Cubic C) (hrD : Cubic D)
    (hcD : Connected D) (hs : IsSwitching C s) (hr : IsSwitching D r)
    (b : Bool) (i j : Fin 9)
    (hdet : ∀ t : ℝ, 0 < t →
      let w : Fin 9 → ℝ := fun k => if k = j then t else 1
      (defect w (signedBiadjacency w D false)).det = 0)
    (root : Q 9) :
    let A := Finset.univ.filter fun k : Fin 9 =>
      k ≠ i ∧ k ≠ j ∧ ({k, i} : Finset (Fin 9)) ∈ minimumDisplacements C D b 2
    Even ((C.filter fun x => parity x = b ∧ AgreeOutside A root x ∧
      flip (flip x i) j ∈ D).card) := by
  intro A
  exact contact_card_even_of_sum_zero C D s r hs hr b i j (AgreeOutside A root)
    (signed_overlap_endpoint_fibre_zero C D s r hdisj hsep hrC hrD hcD hs hr b i j hdet root)

end

