private theorem checked :
    models.all (fun g => (embeddings g [0] 0).all (fun p => 52 ≤ oppositeSize p)) = true := by
  simp [models, List.all_append, checked0, checked1, checked2, checked3,
    checked4, checked5, checked6]

/-- The parity reconstruction has at least 52 vertices for every
admissible placement of a listed model. -/
private theorem checked_placement {model : Model} (hm : model ∈ models)
    {placement : List Nat} (hp : Admissible model [0] 0 placement) :
    52 ≤ oppositeSize placement := by
  have hall := List.all_eq_true.mp checked model hm
  exact decide_eq_true_eq.mp (List.all_eq_true.mp hall placement ((mem_embeddings _ _ _ _).mpr hp))

