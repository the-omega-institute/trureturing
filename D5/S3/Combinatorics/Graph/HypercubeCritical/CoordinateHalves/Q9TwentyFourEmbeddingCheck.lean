private def hamming (p q : Nat) : Nat :=
  let x := p ^^^ q
  let y := (x &&& 0x55) + ((x >>> 1) &&& 0x55)
  let z := (y &&& 0x33) + ((y >>> 2) &&& 0x33)
  (z &&& 0xf) + (z >>> 4)

private def respectsDistances (row point : Nat) (placed : List Nat) : Bool :=
  placed.zipIdx.all fun (other, index) =>
    let d := (row >>> (4 * index)) &&& 15
    let h := hamming point other
    0 < h && h ≤ d && (h == 1) == (d == 1) && h % 2 == d % 2

private def embeddings : Model → List Nat → Nat → List (List Nat)
  | [], placed, _ => [placed]
  | (parent, row) :: rest, placed, axes =>
    (List.range (min (axes + 1) 8)).flatMap fun axis =>
      let point := placed[parent]! ^^^ (1 <<< axis)
      if respectsDistances row point placed then
        embeddings rest (placed ++ [point]) (max axes (axis + 1))
      else []

/-- An ordering of the vertices, starting at the origin, is admissible when
each vertex lies one bit from its earlier parent and the axis labels are used
in order of first occurrence. -/
private def Admissible : Model → List Nat → Nat → List Nat → Prop
  | [], placed, _, placement => placement = placed
  | (parent, row) :: rest, placed, axes, placement =>
    ∃ axis < min (axes + 1) 8,
      let point := placed[parent]! ^^^ (1 <<< axis)
      respectsDistances row point placed = true ∧
        Admissible rest (placed ++ [point]) (max axes (axis + 1)) placement

private theorem mem_embeddings (model : Model) (placed : List Nat) (axes : Nat)
    (placement : List Nat) :
    placement ∈ embeddings model placed axes ↔ Admissible model placed axes placement := by
  induction model generalizing placed axes with
  | nil => simp [embeddings, Admissible]
  | cons step rest ih =>
    obtain ⟨parent, row⟩ := step
    simp only [embeddings, Admissible, List.mem_flatMap, List.mem_range]
    constructor
    · rintro ⟨axis, haxis, h⟩
      split at h
      · rename_i hv
        exact ⟨axis, haxis, hv, (ih _ _).mp h⟩
      · simp at h
    · rintro ⟨axis, haxis, hv, h⟩
      exact ⟨axis, haxis, by simpa only [hv, ite_true] using (ih _ _).mpr h⟩

private def closedNeighborhood (point : Nat) : Nat :=
  (List.range 8).foldl (fun mask axis => mask ||| (1 <<< (point ^^^ (1 <<< axis))))
    (1 <<< point)

private def oppositeSize (placed : List Nat) : Nat :=
  let occupied := placed.foldl (fun mask point => mask ^^^ closedNeighborhood point) 0
  (List.range 256).countP (fun point => occupied.testBit point)

