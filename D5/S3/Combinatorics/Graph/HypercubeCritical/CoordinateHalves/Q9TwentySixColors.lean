private def relabelsColor (graph : Graph) (group witness : Nat) : Bool :=
  let index := witness >>> 56
  let (graphIndex, parity) := models[index]!
  let rep := representatives[graphIndex]!
  let vertices := List.range 14
  let reverse := group.testBit 0 != parity.testBit (labels witness 0)
  index < models.size &&
    vertices.all (fun i => labels witness i < 14) &&
    (vertices.map (labels witness)).eraseDups.length == 14 &&
    vertices.all (fun i =>
      let row := graph[i]!
      let repRow := rep >>> (14 * labels witness i)
      vertices.all fun j => row.testBit j == repRow.testBit (labels witness j)) &&
    vertices.all (fun i => group.testBit i == (parity.testBit (labels witness i) ^^ reverse))

private def checkCase (index : Nat) : Bool :=
  let graph := decode representatives[index]!
  let cert := coloredCases[index]!
  let edges := graphEdgesOfOrder 14 graph
  cert.cycles.all (validCycleOfOrder 14 graph) &&
    eligibleGroups.all fun group =>
      !admissible edges cert.cycles group ||
        match List.lookup group cert.witnesses with
        | none => false
        | some word => relabelsColor graph group word

