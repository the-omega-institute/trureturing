namespace D5.S3.Combinatorics.Graph.HypercubeCritical.CoordinateHalves.Q9TwentySixColors

open private Graph adjacent labels from D5.S3.Combinatorics.Graph.HypercubeCritical.CoordinateHalves.Q9TwentyFourGraphSearch
open private decode representatives from D5.S3.Combinatorics.Graph.HypercubeCritical.CoordinateHalves.Q9TwentySixGraphSearch
open private graphEdgesOfOrder validCycleOfOrder cycleEdges crosses from
  D5.S3.Combinatorics.Graph.HypercubeCritical.CoordinateHalves.Q9TwentyFourColors

private def admissible (edges : List (Nat × Nat)) (cycles : List (List Nat))
    (group : Nat) : Bool :=
  let size := (List.range 14).countP group.testBit
  (size == 3 || size == 5 || (size == 7 && group.testBit 0)) &&
    edges.countP (fun (u, v) => crosses group u v) == 9 &&
    cycles.all fun cycle =>
      let direct := (cycleEdges cycle).countP (fun (u, v) => crosses group u v)
      8 ≤ 2 * cycle.length - direct

private def maskOfVertices (vertices : List Nat) : Nat :=
  vertices.foldr (fun i mask => (1 <<< i) ||| mask) 0

private theorem testBit_maskOfVertices (vertices : List Nat) (i : Nat) :
    (maskOfVertices vertices).testBit i = true ↔ i ∈ vertices := by
  induction vertices with
  | nil => simp [maskOfVertices]
  | cons j tail ih =>
    change ((1 <<< j) ||| maskOfVertices tail).testBit i = true ↔ i ∈ j :: tail
    rw [Nat.testBit_or, Bool.or_eq_true_iff, ih, Nat.shiftLeft_eq, Nat.one_mul,
      Nat.testBit_two_pow, List.mem_cons]
    simp [eq_comm]

private def masksOfSize (size : Nat) : List Nat :=
  ((List.range 14).sublistsLen size).map maskOfVertices

private theorem mem_masksOfSize {size group : Nat} (hgroup : group < 2 ^ 14)
    (hsize : (List.range 14).countP group.testBit = size) : group ∈ masksOfSize size := by
  let selected := (List.range 14).filter group.testBit
  have hn : selected.length = size := (List.countP_eq_length_filter ..).symm.trans hsize
  have he : maskOfVertices selected = group := by
    apply Nat.eq_of_testBit_eq
    intro i
    apply Bool.eq_iff_iff.mpr
    rw [testBit_maskOfVertices]
    simp only [selected, List.mem_filter, List.mem_range]
    by_cases hi : i < 14
    · simp [hi]
    · have hlt : group < 2 ^ i := hgroup.trans_le (Nat.pow_le_pow_right (by decide) (by omega))
      simp [hi, Nat.testBit_lt_two_pow hlt]
  exact List.mem_map.mpr ⟨selected, List.mem_sublistsLen.mpr ⟨List.filter_sublist, hn⟩, he⟩

private def eligibleGroups : List Nat :=
  masksOfSize 3 ++ masksOfSize 5 ++ (masksOfSize 7).filter (fun group => group.testBit 0)

private theorem mem_eligibleGroups {edges : List (Nat × Nat)} {cycles : List (List Nat)}
    {group : Nat} (hgroup : group < 2 ^ 14) (h : admissible edges cycles group = true) :
    group ∈ eligibleGroups := by
  simp only [admissible, Bool.and_eq_true_iff, Bool.or_eq_true_iff, beq_iff_eq] at h
  rcases h.1.1 with (h3 | h5) | ⟨h7, hb⟩
  · exact List.mem_append_left _ (List.mem_append_left _ (mem_masksOfSize hgroup h3))
  · exact List.mem_append_left _ (List.mem_append_right _ (mem_masksOfSize hgroup h5))
  · exact List.mem_append_right _ (List.mem_filter.mpr ⟨mem_masksOfSize hgroup h7, hb⟩)


