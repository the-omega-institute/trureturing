private def coloredCases : Array ColorCase := #[
  case0, case1, case2, case3, case4, case5, case6, case7,
  case8, case9, case10, case11, case12, case13, case14, case15,
  case16, case17, case18, case19, case20, case21]

private def vertices : List Nat := List.range 12

private def cycleEdges (cycle : List Nat) : List (Nat × Nat) :=
  cycle.zip (cycle.drop 1 ++ [cycle.head!])

private def validCycle (graph : Graph) (cycle : List Nat) : Bool :=
  4 ≤ cycle.length && cycle.length ≤ 6 &&
    cycle.eraseDups.length == cycle.length &&
    cycle.all (· < 12) && (cycleEdges cycle).all (fun (u, v) => adjacent graph u v)

private def crosses (group u v : Nat) : Bool := group.testBit u != group.testBit v

private def graphEdges (graph : Graph) : List (Nat × Nat) :=
  vertices.flatMap fun u =>
    (vertices.filter fun v => u < v && adjacent graph u v).map fun v => (u, v)

private def admissible (edges : List (Nat × Nat)) (cycles : List (List Nat))
    (group : Nat) : Bool :=
  let size := vertices.countP group.testBit
  (size == 2 || size == 4 || (size == 6 && group.testBit 0)) &&
    edges.countP (fun (u, v) => crosses group u v) == 6 &&
    cycles.all fun cycle =>
      let direct := (cycleEdges cycle).countP (fun (u, v) => crosses group u v)
      8 ≤ 2 * cycle.length - direct

private def relabelsColor (graph : Graph) (group witness : Nat) : Bool :=
  let index := witness >>> 48
  let (code, color) := models[index]!
  let model := decode code
  index < models.size &&
    vertices.all (fun v => labels witness v < 12) &&
    (vertices.map (labels witness)).eraseDups.length == 12 &&
    vertices.all (fun u => vertices.all fun v =>
      adjacent graph u v == adjacent model (labels witness u) (labels witness v)) &&
    let reverse := group.testBit 0 != color.testBit (labels witness 0)
    vertices.all (fun u => group.testBit u == (color.testBit (labels witness u) ^^ reverse))

private def checkCase (index : Nat) : Bool :=
  let graph := decode representatives[index]!
  let cert := coloredCases[index]!
  let edges := graphEdges graph
  cert.cycles.all (validCycle graph) &&
    (List.range 4096).all fun group =>
      !admissible edges cert.cycles group ||
        match List.lookup group cert.witnesses with
        | none => false
        | some witness => relabelsColor graph group witness

set_option maxRecDepth 8192 in
set_option maxHeartbeats 120000000 in
-- Validate the cycles and check the surviving parity relabelings.
private theorem checked (index : Fin 22) : checkCase index.val = true := by
  fin_cases index <;> decide +kernel

#print axioms checked

