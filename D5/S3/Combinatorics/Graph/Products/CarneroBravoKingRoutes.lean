abbrev Original := ↥oldLabels
abbrev Edge := Fin routeData.size

def route (e : Edge) : RouteLiteral := routeData[e.val]

theorem original_card : Fintype.card Original = 141 := by decide
theorem edge_card : Fintype.card Edge = 178 := by decide

theorem endpoint_labels (e : Edge) :
    (route e).left ∈ oldLabels ∧ (route e).right ∈ oldLabels := by
  have h : ∀ e : Edge, (route e).left ∈ oldLabels ∧ (route e).right ∈ oldLabels := by decide
  exact h e

theorem positive_k (e : Edge) : 0 < (route e).k := by
  have h : ∀ e : Edge, 0 < (route e).k := by decide
  exact h e

theorem distinct_endpoints (e : Edge) : (route e).left ≠ (route e).right := by
  have h : ∀ e : Edge, (route e).left ≠ (route e).right := by decide
  exact h e

def subdivision : Data Original Edge where
  left e := ⟨(route e).left, (endpoint_labels e).1⟩
  right e := ⟨(route e).right, (endpoint_labels e).2⟩
  k e := (route e).k
  positive := positive_k
  different e h := distinct_endpoints e (congrArg Subtype.val h)

abbrev Vertex := subdivision.Vertex
abbrev RoutedGraph := subdivision.graph

def originalVertices : List Original :=
  (List.range 166).filterMap fun n => if h : n ∈ oldLabels then some ⟨n, h⟩ else none

theorem mem_originalVertices (a : Original) : a ∈ originalVertices := by
  have hb : ∀ a : Original, a.val < 166 := by decide
  apply List.mem_filterMap.mpr
  exact ⟨a.val, List.mem_range.mpr (hb a), by simp [a.property]⟩

abbrev edgeIndices : List Edge := List.finRange routeData.size

theorem mem_edgeIndices (e : Edge) : e ∈ edgeIndices := by simp [edgeIndices]

/-- The original Nat labels and original coordinate table are complete. -/
theorem old_coordinate_table_complete :
    ∀ a : Original, (oldCoordinates.lookup a.val).isSome = true := by decide

def oldCoordinate (a : Original) : Point :=
  (oldCoordinates.lookup a.val).get (old_coordinate_table_complete a)

def coordinate : Vertex → Point
  | .inl a => oldCoordinate a
  | .inr ⟨e, i⟩ => Poly.sample (route e).corners (i.val + 1)

/-- Endpoint matching and lengths are derived from the actual 178 polylines.
Only 1,283 corners are literal; no expanded 93,999-point certificate is imported. -/
theorem polyline_facts : ∀ e : Edge,
    (route e).corners ≠ [] ∧ Poly.axisAligned (route e).corners ∧
    Poly.length (route e).corners = 3 * subdivision.k e + 1 ∧
    Poly.sample (route e).corners 0 = oldCoordinate (subdivision.left e) ∧
    Poly.sample (route e).corners (3 * subdivision.k e + 1) =
      oldCoordinate (subdivision.right e) := by decide

theorem expanded_route_length (e : Edge) :
    (Poly.expand (route e).corners).length = 3 * subdivision.k e + 2 := by
  rw [IntegerPolyline.length_expand _ (polyline_facts e).1,
    (polyline_facts e).2.2.1]

theorem path_coordinate (e : Edge) (i : Fin (3 * subdivision.k e + 2)) :
    coordinate (subdivision.pathVertex e i) = Poly.sample (route e).corners i.val := by
  have hf := polyline_facts e
  by_cases h0 : i.val = 0
  · simpa only [Data.pathVertex, h0, ↓reduceDIte, coordinate] using hf.2.2.2.1.symm
  · by_cases hL : i.val = 3 * subdivision.k e + 1
    · have hn : 3 * subdivision.k e + 1 ≠ 0 := by omega
      simpa only [Data.pathVertex, hL, hn, ↓reduceDIte, coordinate] using hf.2.2.2.2.symm
    · let j : Fin (3 * subdivision.k e) := ⟨i.val - 1, by have := i.isLt; omega⟩
      have hi : i = ⟨j.val + 1, by have := j.isLt; omega⟩ := by
        apply Fin.ext
        dsimp [j]
        omega
      rw [hi, subdivision.pathVertex_inner]
      rfl

/-- The source-defined finite path really is the verifier's lattice enumeration,
including every detour, every corner, and the zero-length-segment convention. -/
theorem path_coordinate_verifier (e : Edge) (i : Fin (3 * subdivision.k e + 2)) :
    coordinate (subdivision.pathVertex e i) =
      (IntegerPolyline.verifierExpand (route e).corners)[i.val]'(by
        rw [← IntegerPolyline.expand_eq_verifier _ (polyline_facts e).2.1,
          expanded_route_length]
        exact i.isLt) := by
  rw [path_coordinate, IntegerPolyline.sample_eq_getD]
  have hex := IntegerPolyline.expand_eq_verifier _ (polyline_facts e).2.1
  have hi : i.val < (IntegerPolyline.verifierExpand (route e).corners).length := by
    rw [← hex, expanded_route_length]
    exact i.isLt
  simp only [hex, List.getElem?_eq_getElem hi, Option.getD_some]

/-- Equality of unordered endpoint inventories with the construction's literal
178 edges, and no duplicate endpoint pair among distinct route indices. -/
theorem endpoint_inventory :
    (Finset.univ.image (fun e : Edge => s((route e).left, (route e).right))) =
      constructionEdges := by decide

theorem endpoint_pair_injective :
    Function.Injective (fun e : Edge => s((route e).left, (route e).right)) := by decide

theorem construction_no_diagonals :
    ∀ z ∈ constructionEdges, ¬ z.IsDiag := by decide

def baseGraph : SimpleGraph Original where
  Adj a b := s(a.val, b.val) ∈ constructionEdges
  symm.symm a b h := by
    change s(b.val, a.val) ∈ constructionEdges
    rw [Sym2.eq_swap]
    exact h
  loopless.irrefl a h := construction_no_diagonals _ h (by simp)

instance : DecidableRel baseGraph.Adj := fun a b =>
  inferInstanceAs (Decidable (s(a.val, b.val) ∈ constructionEdges))

/-- Exact relation between the simple original graph and the subdivision data.
Together with `pathVertex_injective`, `arc_iff_slot`, and `endpoint_pair_injective`,
this exposes the endpoint and fresh-index conventions for later triple-subdivision
identification. There is no graph-to-homology premise or assertion here. -/
theorem baseGraph_iff_endpoints (a b : Original) :
    baseGraph.Adj a b ↔ ∃ e : Edge,
      (a = subdivision.left e ∧ b = subdivision.right e) ∨
      (a = subdivision.right e ∧ b = subdivision.left e) := by
  change s(a.val, b.val) ∈ constructionEdges ↔ _
  rw [← endpoint_inventory, Finset.mem_image]
  simp only [Finset.mem_univ, true_and, Sym2.eq_iff, Subtype.ext_iff]
  constructor
  · rintro ⟨e, h⟩
    exact ⟨e, by simpa only [subdivision, eq_comm, and_comm] using h⟩
  · rintro ⟨e, h⟩
    exact ⟨e, by simpa only [subdivision, eq_comm, and_comm] using h⟩

/-- This is the actual large kernel-evaluable success obligation. Ordinary
`decide` supplies a reducible proof term; no native evaluator, compiler result,
Python output, assumed certificate, or new axiom supplies mathematical truth.
The concrete reduction is required in addition to the generic soundness proof. -/
theorem routing_check_success :
    routingCheck RoutedGraph (subdivision.vertices originalVertices edgeIndices)
      (subdivision.edgePairs edgeIndices) coordinate = true := by
  decide +kernel

theorem exact_square_routing :
    Function.Injective coordinate ∧
      ∀ v w : Vertex, RoutedGraph.Adj v w ↔ squareAdj (coordinate v) (coordinate w) :=
  routingCheck_sound RoutedGraph (subdivision.vertices originalVertices edgeIndices)
    (subdivision.edgePairs edgeIndices) coordinate
    (subdivision.mem_vertices originalVertices edgeIndices mem_originalVertices mem_edgeIndices)
    (subdivision.adj_iff_edgePairs edgeIndices mem_edgeIndices) routing_check_success

/-- Literal T is one-based. Its maximum coordinates equal the rectangle sizes;
the strict Fin bounds apply after the explicit `zeroBased` conversion. -/
def boundaryCheck : Bool := (subdivision.vertices originalVertices edgeIndices).all fun v =>
  decide (1 ≤ (rotate (coordinate v)).1 ∧ (rotate (coordinate v)).1 ≤ 9337 ∧
    1 ≤ (rotate (coordinate v)).2 ∧ (rotate (coordinate v)).2 ≤ 9061)

theorem boundary_check_success : boundaryCheck = true := by decide +kernel

theorem actual_T_bounds (v : Vertex) :
    1 ≤ (rotate (coordinate v)).1 ∧ (rotate (coordinate v)).1 ≤ 9337 ∧
    1 ≤ (rotate (coordinate v)).2 ∧ (rotate (coordinate v)).2 ≤ 9061 := by
  exact of_decide_eq_true
    ((List.all_eq_true.mp boundary_check_success) v
      (subdivision.mem_vertices originalVertices edgeIndices mem_originalVertices mem_edgeIndices v))

def rectangle : SimpleGraph (Fin 9337 × Fin 9061) :=
  strongProduct (SimpleGraph.pathGraph 9337) (SimpleGraph.pathGraph 9061)

/-- The paper's P_n has n vertices labelled 1,...,n. Mathlib's pathGraph n
also has n vertices, labelled 0,...,n-1. The explicit conversion preserves n. -/
def inducedEmbedding : RoutedGraph ↪g rectangle :=
  oneBasedRectangleEmbedding RoutedGraph coordinate exact_square_routing.1
    exact_square_routing.2 actual_T_bounds

def selected : Set (Fin 9337 × Fin 9061) := Set.range inducedEmbedding

/-- This supplier gives the actual induced graph isomorphism, not just a homomorphism. -/
noncomputable def inducedIso : RoutedGraph ≃g rectangle.induce selected :=
  inducedEmbedding.isoInduceRange

noncomputable instance : Fintype selected := Fintype.ofFinite selected

noncomputable instance : Fintype (rectangle.induce selected).edgeSet := by
  classical
  infer_instance

theorem sum_subdivisions : (∑ e : Edge, subdivision.k e) = 31286 := by decide
theorem sum_fresh_vertices : (∑ e : Edge, 3 * subdivision.k e) = 93858 := by
  rw [subdivision.subdivision_count, sum_subdivisions]
theorem sum_route_lengths : (∑ e : Edge, (3 * subdivision.k e + 1)) = 94036 := by
  rw [Finset.sum_add_distrib, sum_fresh_vertices]
  simp only [Finset.sum_const, Finset.card_univ, edge_card]
  decide

theorem actual_vertex_count : Fintype.card Vertex = 93999 := by
  rw [subdivision.card_vertices, original_card, sum_fresh_vertices]

theorem actual_edge_count : RoutedGraph.edgeFinset.card = 94036 := by
  rw [subdivision.card_edges, sum_route_lengths]

theorem selected_vertex_count : Fintype.card selected = 93999 := by
  rw [← Fintype.card_congr inducedIso.toEquiv, actual_vertex_count]

theorem selected_edge_count : (rectangle.induce selected).edgeFinset.card = 94036 := by
  classical
  rw [← inducedIso.card_edgeFinset_eq, actual_edge_count]


end D5.S3.Combinatorics.Graph.Products.CarneroBravoKingRoutes
