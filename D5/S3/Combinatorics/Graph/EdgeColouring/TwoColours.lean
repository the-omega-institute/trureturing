import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Finset.Card
import Mathlib.Data.Finset.Max
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Algebra.BigOperators.Group.Finset.Sigma
import Mathlib.Algebra.Ring.Parity
import Mathlib.Logic.Relation
import Mathlib.Tactic.ByContra
import Mathlib.Tactic.SimpRw

/-! An edge is an element of `E`, not an unordered pair of vertices. In particular,
parallel original edges remain distinct. The only graph data are two endpoint maps.

The existence argument minimizes monochromatic constrained stars. A flip moves a
remaining defect across an original edge. A finite extension argument excludes a
defect of degree greater than two; transport and incidence counting then identify
the exact odd component. No tour, colouring, or certificate is an input.
-/
namespace D5.S3.Combinatorics.Graph.EdgeColouring.TwoColours

open Finset
open scoped BigOperators

universe u v
variable {V : Type u} {E : Type v} [Fintype V] [Fintype E]
  [DecidableEq V] [DecidableEq E]

/-- All original edge IDs incident with a vertex. -/
def star (l r : E → V) (x : V) : Finset E := univ.filter fun e => l e = x ∨ r e = x

/-- Both colours occur on the original star. -/
def Mixed (l r : E → V) (c : E → Bool) (x : V) : Prop :=
  ∃ e ∈ star l r x, ∃ f ∈ star l r x, c e ≠ c f

/-- Connectivity generated by the original endpoint pairs. -/
def Reach (l r : E → V) : V → V → Prop :=
  Relation.EqvGen fun x y => ∃ e, l e = x ∧ r e = y

/-- Original edge IDs in the component of `x`. Isolated components have no edges. -/
noncomputable def componentEdges (l r : E → V) (x : V) : Finset E := by
  classical
  exact univ.filter fun e => Reach l r x (l e)

/-- An all-constrained degree-two component with an odd number of original edges. -/
def OddComponent (l r : E → V) (C : Finset V) : Prop :=
  ∃ x, (∀ y, Reach l r x y → y ∈ C ∧ (star l r y).card = 2) ∧
    Odd (componentEdges l r x).card

private def flip (c : E → Bool) (e : E) : E → Bool := fun f => if f = e then !c f else c f

private noncomputable def defects (l r : E → V) (C : Finset V) (c : E → Bool) : Finset V := by
  classical
  exact C.filter fun x => ¬Mixed l r c x

private def Optimal (l r : E → V) (C : Finset V) (c : E → Bool) : Prop :=
  ∀ d, (defects l r C c).card ≤ (defects l r C d).card

@[simp] private theorem mem_star {l r : E → V} {e : E} {x : V} :
    e ∈ star l r x ↔ l e = x ∨ r e = x := by simp [star]

@[simp] private theorem mem_defects {l r : E → V} {C : Finset V} {c : E → Bool} {x : V} :
    x ∈ defects l r C c ↔ x ∈ C ∧ ¬Mixed l r c x := by classical simp [defects]

private theorem mono {l r : E → V} {c : E → Bool} {x : V}
    (h : ¬Mixed l r c x) {e f : E} (he : e ∈ star l r x) (hf : f ∈ star l r x) :
    c e = c f := by
  by_contra hn
  exact h ⟨e, he, f, hf, hn⟩

private theorem mixed_congr {l r : E → V} {c d : E → Bool} {x : V}
    (h : ∀ e ∈ star l r x, c e = d e) : Mixed l r c x ↔ Mixed l r d x := by
  unfold Mixed
  constructor <;> rintro ⟨e, he, f, hf, hne⟩
  · exact ⟨e, he, f, hf, by rwa [← h e he, ← h f hf]⟩
  · exact ⟨e, he, f, hf, by rwa [h e he, h f hf]⟩

private theorem mixed_flip_away {l r : E → V} {c : E → Bool} {x : V} {e : E}
    (he : e ∉ star l r x) : Mixed l r (flip c e) x ↔ Mixed l r c x := by
  apply mixed_congr
  intro f hf
  have hne : f ≠ e := fun h => he (h ▸ hf)
  simp [flip, hne]

private theorem another {s : Finset E} (hs : 2 ≤ s.card) {e : E} (he : e ∈ s) :
    ∃ f ∈ s, f ≠ e := by
  by_contra! h
  have hsub : s ⊆ {e} := fun f hf => by simpa using h f hf
  have := card_le_card hsub
  simp at this
  omega

private theorem mono_flip_mixed {l r : E → V} {c : E → Bool} {x : V} {e : E}
    (hd : 2 ≤ (star l r x).card) (he : e ∈ star l r x) (hm : ¬Mixed l r c x) :
    Mixed l r (flip c e) x := by
  obtain ⟨f, hf, hfe⟩ := another hd he
  refine ⟨e, he, f, hf, ?_⟩
  have hc := mono hm he hf
  simp only [flip, ite_eq_left rfl, ite_eq_right hfe]
  cases hce : c e <;> simp_all

private theorem other_end {l r : E → V} (hloop : ∀ e, l e ≠ r e)
    {e : E} {x : V} (he : e ∈ star l r x) :
    ∃ y, e ∈ star l r y ∧ x ≠ y ∧ ∀ z, e ∈ star l r z → z = x ∨ z = y := by
  rcases mem_star.mp he with h | h
  · refine ⟨r e, mem_star.mpr (Or.inr rfl), ?_, ?_⟩
    · simpa [← h] using hloop e
    · intro z hz
      rcases mem_star.mp hz with hz | hz
      · exact Or.inl (hz.symm.trans h)
      · exact Or.inr hz.symm
  · refine ⟨l e, mem_star.mpr (Or.inl rfl), ?_, ?_⟩
    · simpa [← h] using (hloop e).symm
    · intro z hz
      rcases mem_star.mp hz with hz | hz
      · exact Or.inr hz.symm
      · exact Or.inl (hz.symm.trans h)

private theorem optimal_exists (l r : E → V) (C : Finset V) :
    ∃ c, Optimal l r C c := by
  classical
  obtain ⟨c, _, hc⟩ := (univ : Finset (E → Bool)).exists_min_image
    (fun c => (defects l r C c).card) ⟨fun _ => false, mem_univ _⟩
  exact ⟨c, fun d => hc d (mem_univ _)⟩

/- A flip at a defect cannot improve a minimum. It must move the defect to
the other endpoint, and the complete defect inventory changes by that swap. -/
private theorem transfer {l r : E → V} {C : Finset V}
    (hdeg : ∀ x ∈ C, 2 ≤ (star l r x).card)
    {c : E → Bool} (hc : Optimal l r C c) {x y : V} {e : E}
    (hx : x ∈ defects l r C c) (he : e ∈ star l r x)
    (hey : e ∈ star l r y) (hxy : x ≠ y)
    (hend : ∀ z, e ∈ star l r z → z = x ∨ z = y) :
    Optimal l r C (flip c e) ∧ y ∈ defects l r C (flip c e) ∧
      y ∉ defects l r C c ∧
      defects l r C (flip c e) = insert y ((defects l r C c).erase x) := by
  classical
  have hxm := mono_flip_mixed (hdeg x (mem_defects.mp hx).1) he (mem_defects.mp hx).2
  have hxout : x ∉ defects l r C (flip c e) := by simp [hxm]
  have hsub : defects l r C (flip c e) ⊆ insert y ((defects l r C c).erase x) := by
    intro z hz
    by_cases hzy : z = y
    · simp [hzy]
    have hzx : z ≠ x := fun h => hxout (h ▸ hz)
    have hez : e ∉ star l r z := fun h => (hend z h).elim hzx hzy
    have hzold : z ∈ defects l r C c := by
      simpa only [mem_defects, mixed_flip_away hez] using hz
    simp [hzold, hzx]
  have hcarderase : ((defects l r C c).erase x).card + 1 = (defects l r C c).card :=
    card_erase_add_one hx
  have hle : (defects l r C (flip c e)).card ≤ (defects l r C c).card := by
    calc _ ≤ (insert y ((defects l r C c).erase x)).card := card_le_card hsub
      _ ≤ ((defects l r C c).erase x).card + 1 := card_insert_le _ _
      _ = _ := hcarderase
  have hopt : Optimal l r C (flip c e) := fun d => hle.trans (hc d)
  have hy : y ∈ defects l r C (flip c e) := by
    by_contra hy
    have hsub' : defects l r C (flip c e) ⊆ (defects l r C c).erase x := by
      intro z hz
      exact (mem_insert.mp (hsub hz)).resolve_left (fun h => hy (h ▸ hz))
    have h1 := card_le_card hsub'
    have h2 := hc (flip c e)
    omega
  have hyo : y ∉ defects l r C c := by
    intro hyo
    have := mono_flip_mixed (hdeg y (mem_defects.mp hyo).1) hey (mem_defects.mp hyo).2
    exact (mem_defects.mp hy).2 this
  have heq : defects l r C (flip c e) = insert y ((defects l r C c).erase x) := by
    apply eq_of_subset_of_card_le hsub
    rw [card_insert_of_notMem (fun h => hyo (mem_of_mem_erase h)), hcarderase]
    exact hc _
  exact ⟨hopt, hy, hyo, heq⟩


private def DefectPath (l r : E → V) (C : Finset V)
    (c : E → Bool) (U : Finset E) (S : Finset V) (x : V) : Prop :=
  Optimal l r C c ∧ x ∈ defects l r C c ∧ x ∉ S ∧
    (∀ e ∈ U, ∀ z, e ∈ star l r z → z ∈ S ∨ z = x) ∧
    (star l r x ∩ U).card = 1 ∧
    ∀ z ∈ S, ∀ e ∉ U, Mixed l r (flip c e) z

private theorem defect_path_extend {l r : E → V} {C : Finset V}
    (hloop : ∀ e, l e ≠ r e) (hdeg : ∀ x ∈ C, 2 ≤ (star l r x).card)
    {c : E → Bool} {U : Finset E} {S : Finset V} {x : V}
    (hp : DefectPath l r C c U S x) :
    ∃ d U' y, DefectPath l r C d U' (insert x S) y := by
  classical
  rcases hp with ⟨hc, hx, hxS, hcover, hused, hrobust⟩
  obtain ⟨f, hf⟩ := card_eq_one.mp hused
  have hfmem : f ∈ star l r x ∩ U := by rw [hf]; simp
  have hex : ∃ e ∈ star l r x, e ∉ U := by
    by_contra! h
    have heq : star l r x ∩ U = star l r x := inter_eq_left.mpr h
    have hd := hdeg x (mem_defects.mp hx).1
    rw [heq] at hused
    omega
  obtain ⟨e, he, heU⟩ := hex
  obtain ⟨y, hey, hxy, hend⟩ := other_end hloop he
  obtain ⟨hc', hy, _, _⟩ := transfer hdeg hc hx he hey hxy hend
  have hyS : y ∉ S := fun h => (mem_defects.mp hy).2 (hrobust y h e heU)
  have hez : ∀ z ∈ S, e ∉ star l r z := by
    intro z hz hez
    rcases hend z hez with h | h
    · exact hxS (h ▸ hz)
    · exact hyS (h ▸ hz)
  refine ⟨flip c e, insert e U, y, hc', hy, ?_, ?_, ?_, ?_⟩
  · simp [hyS, hxy.symm]
  · intro g hg z hgz
    rcases mem_insert.mp hg with rfl | hg
    · rcases hend z hgz with rfl | rfl <;> simp
    · rcases hcover g hg z hgz with hz | hz
      · exact Or.inl (mem_insert_of_mem hz)
      · exact Or.inl (mem_insert.mpr (Or.inl hz))
  · have heq : star l r y ∩ insert e U = {e} := by
      ext g
      simp only [mem_inter, mem_insert, mem_singleton]
      constructor
      · rintro ⟨hgy, rfl | hgU⟩
        · rfl
        · rcases hcover g hgU y hgy with h | h
          · exact (hyS h).elim
          · exact (hxy h.symm).elim
      · rintro rfl
        exact ⟨hey, Or.inl rfl⟩
    simp [heq]
  · intro z hz g hg
    have hgU : g ∉ U := fun h => hg (mem_insert_of_mem h)
    have hge : g ≠ e := fun h => hg (h ▸ mem_insert_self e U)
    rcases mem_insert.mp hz with rfl | hz
    · have hfe : f ≠ e := fun h => heU (h ▸ (mem_inter.mp hfmem).2)
      have hfg : f ≠ g := fun h => hgU (h ▸ (mem_inter.mp hfmem).2)
      have hce := mono (mem_defects.mp hx).2 he (mem_inter.mp hfmem).1
      refine ⟨e, he, f, (mem_inter.mp hfmem).1, ?_⟩
      simp only [flip, ite_eq_right hge.symm, ite_eq_left rfl, ite_eq_right hfg, ite_eq_right hfe]
      cases hce' : c e <;> simp_all
    · have h := hrobust z hz g hgU
      apply (mixed_congr (c := flip (flip c e) g) (d := flip c g) ?_).mpr h
      intro k hk
      have hke : k ≠ e := fun h => hez z hz (h ▸ hk)
      simp [flip, hke]

private theorem outside_pair {s : Finset E} (hs : 3 ≤ s.card) (e f : E) :
    ∃ g ∈ s, g ≠ e ∧ g ≠ f := by
  by_contra! h
  have hsub : s ⊆ {e, f} := by
    intro g hg
    by_cases hge : g = e
    · simp [hge]
    · simp [h g hg hge]
  have h1 := card_le_card hsub
  have h2 : ({e, f} : Finset E).card ≤ 2 := card_insert_le _ _
  omega

/- A surviving high-degree defect would generate arbitrarily long simple
extensions. Used edges protect the two colours at every departed vertex. -/
private theorem defect_degree_two {l r : E → V} {C : Finset V}
    (hloop : ∀ e, l e ≠ r e) (hdeg : ∀ x ∈ C, 2 ≤ (star l r x).card)
    {c : E → Bool} (hc : Optimal l r C c) {x : V}
    (hx : x ∈ defects l r C c) : (star l r x).card = 2 := by
  classical
  have hd := hdeg x (mem_defects.mp hx).1
  by_contra hne
  have hd3 : 3 ≤ (star l r x).card := by omega
  obtain ⟨e, he⟩ := card_pos.mp (by omega : 0 < (star l r x).card)
  obtain ⟨y, hey, hxy, hend⟩ := other_end hloop he
  obtain ⟨hc', hy, _, _⟩ := transfer hdeg hc hx he hey hxy hend
  have hinit : DefectPath l r C (flip c e) {e} {x} y := by
    refine ⟨hc', hy, by simpa using hxy.symm, ?_, ?_, ?_⟩
    · intro f hf z hz
      have hfe : f = e := mem_singleton.mp hf
      subst f
      rcases hend z hz with rfl | rfl <;> simp
    · simp [hey]
    · intro z hz f hf
      have hz : z = x := mem_singleton.mp hz
      subst z
      have hfe : f ≠ e := by simpa using hf
      obtain ⟨g, hg, hge, hgf⟩ := outside_pair hd3 e f
      have hcg := mono (mem_defects.mp hx).2 he hg
      refine ⟨e, he, g, hg, ?_⟩
      simp only [flip, ite_eq_right hfe.symm, ite_eq_left rfl, ite_eq_right hgf, ite_eq_right hge]
      cases hce : c e <;> simp_all
  let states : Finset (Finset V) := univ.filter fun S =>
    ∃ d U z, DefectPath l r C d U S z
  have hstates : ({x} : Finset V) ∈ states := by
    simp only [states, mem_filter, mem_univ, true_and]
    exact ⟨_, _, _, hinit⟩
  obtain ⟨S, hS, hmax⟩ := states.exists_max_image Finset.card ⟨_, hstates⟩
  obtain ⟨d, U, z, hp⟩ := (mem_filter.mp hS).2
  obtain ⟨d', U', z', hp'⟩ := defect_path_extend hloop hdeg hp
  have hS' : insert z S ∈ states := by
    simp only [states, mem_filter, mem_univ, true_and]
    exact ⟨_, _, _, hp'⟩
  have := hmax _ hS'
  rw [card_insert_of_notMem hp.2.2.1] at this
  omega


private theorem reach_induction {l r : E → V} {P : V → Prop} {x y : V}
    (hx : P x) (hedge : ∀ e, P (l e) ↔ P (r e)) (h : Reach l r x y) : P y := by
  have hi : ∀ a b, Reach l r a b → (P a ↔ P b) := by
    intro a b hab
    induction hab with
    | rel a b hab =>
      obtain ⟨e, rfl, rfl⟩ := hab
      exact hedge e
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  exact (hi x y h).mp hx

private theorem reachable_endpoints (l r : E → V) (x : V) (e : E) :
    Reach l r x (l e) ↔ Reach l r x (r e) := by
  have he : Reach l r (l e) (r e) := .rel _ _ ⟨e, rfl, rfl⟩
  exact ⟨fun h => .trans _ _ _ h he,
    fun h => .trans _ _ _ h (.symm _ _ he)⟩

/- Transport preserves every defect other than the one being moved. Thus a
component containing a defect contains exactly one, and all its vertices
are constrained of degree two. -/
private theorem defective_component {l r : E → V} {C : Finset V}
    (hloop : ∀ e, l e ≠ r e) (hdeg : ∀ x ∈ C, 2 ≤ (star l r x).card)
    {c : E → Bool} (hc : Optimal l r C c) {x : V}
    (hx : x ∈ defects l r C c) :
    ∀ y, Reach l r x y → y ∈ C ∧ (star l r y).card = 2 ∧
      (y ∈ defects l r C c ↔ y = x) := by
  classical
  let F := (defects l r C c).erase x
  let P : V → Prop := fun y => ∃ d, Optimal l r C d ∧
    defects l r C d = insert y F ∧ y ∉ F
  have hstart : P x := by
    refine ⟨c, hc, ?_, by simp [F]⟩
    exact (insert_erase hx).symm
  have hstep : ∀ a b e, e ∈ star l r a → e ∈ star l r b → a ≠ b →
      (∀ z, e ∈ star l r z → z = a ∨ z = b) → P a → P b := by
    intro a b e hea heb hab hend ha
    obtain ⟨d, hd, heq, haF⟩ := ha
    have haD : a ∈ defects l r C d := by rw [heq]; simp
    obtain ⟨hd', hbD, hbOld, heq'⟩ := transfer hdeg hd haD hea heb hab hend
    refine ⟨flip d e, hd', ?_, ?_⟩
    · rw [heq', heq, erase_insert haF]
    · intro hbF
      exact hbOld (heq.symm ▸ mem_insert_of_mem hbF)
  have hedge : ∀ e, P (l e) ↔ P (r e) := by
    intro e
    have hl : e ∈ star l r (l e) := mem_star.mpr (Or.inl rfl)
    have hr : e ∈ star l r (r e) := mem_star.mpr (Or.inr rfl)
    have he : ∀ z, e ∈ star l r z → z = l e ∨ z = r e := by
      intro z hz
      exact (mem_star.mp hz).elim (fun h => Or.inl h.symm) (fun h => Or.inr h.symm)
    exact ⟨hstep _ _ e hl hr (hloop e) he,
      hstep _ _ e hr hl (hloop e).symm (fun z hz => (he z hz).symm)⟩
  intro y hy
  obtain ⟨d, hd, heq, hyF⟩ := reach_induction hstart hedge hy
  have hyD : y ∈ defects l r C d := by rw [heq]; simp
  refine ⟨(mem_defects.mp hyD).1, defect_degree_two hloop hdeg hd hyD, ?_⟩
  constructor
  · intro h
    by_contra hyx
    exact hyF (mem_erase.mpr ⟨hyx, h⟩)
  · rintro rfl
    exact hx

private noncomputable def componentVertices (l r : E → V) (x : V) : Finset V := by
  classical
  exact univ.filter (Reach l r x)

private theorem incidence_sum (l r : E → V) (hloop : ∀ e, l e ≠ r e)
    (x : V) (P : E → Prop) [DecidablePred P] :
    ∑ y ∈ componentVertices l r x, ((star l r y).filter P).card =
      2 * ((componentEdges l r x).filter P).card := by
  classical
  have hstar : ∀ y, ((star l r y).filter P).card =
      ∑ e : E, if (l e = y ∨ r e = y) ∧ P e then 1 else 0 := by
    intro y
    simp [star, filter_filter, sum_boole]
  simp_rw [hstar]
  rw [sum_comm]
  have hterm : ∀ e : E,
      (∑ y ∈ componentVertices l r x,
        if (l e = y ∨ r e = y) ∧ P e then 1 else 0) =
      if Reach l r x (l e) ∧ P e then 2 else 0 := by
    intro e
    have hr := reachable_endpoints l r x e
    have heq : ∀ y : V,
        (if (l e = y ∨ r e = y) ∧ P e then 1 else 0 : ℕ) =
        (if l e = y ∧ P e then 1 else 0) +
        (if r e = y ∧ P e then 1 else 0) := by
      intro y
      by_cases hl : l e = y <;> by_cases hr : r e = y <;> by_cases hp : P e <;>
        simp_all
      exact (hloop e (hl.trans hr.symm)).elim
    simp_rw [heq]
    rw [sum_add_distrib]
    by_cases hp : P e
    · simp only [hp, and_true]
      by_cases hR : Reach l r x (r e) <;> simp [componentVertices, hr, hR]
    · simp [hp]
  simp_rw [hterm]
  rw [show (∑ e : E, if Reach l r x (l e) ∧ P e then 2 else 0) =
      2 * ∑ e : E, if Reach l r x (l e) ∧ P e then 1 else 0 by
        rw [mul_sum]; apply sum_congr rfl; intro e _; split_ifs <;> rfl]
  congr 1
  simp [componentEdges, filter_filter, sum_boole]

private theorem mixed_two_color_count {l r : E → V} {c : E → Bool} {y : V}
    (hd : (star l r y).card = 2) (hm : Mixed l r c y) :
    ((star l r y).filter fun e => c e = true).card = 1 := by
  classical
  obtain ⟨e, he, f, hf, hef⟩ := hm
  have hne : e ≠ f := fun h => hef (congrArg c h)
  have hsub : ({e, f} : Finset E) ⊆ star l r y := by
    intro g hg
    rcases mem_insert.mp hg with h | h
    · exact h ▸ he
    · exact (mem_singleton.mp h) ▸ hf
  have hcard : (star l r y).card ≤ ({e, f} : Finset E).card := by
    simp [hd, hne]
  have hstar : star l r y = {e, f} := (eq_of_subset_of_card_le hsub hcard).symm
  rw [hstar]
  cases hce : c e <;> cases hcf : c f <;> simp_all [filter_insert, filter_singleton]

private theorem component_edge_card {l r : E → V} (hloop : ∀ e, l e ≠ r e)
    {x : V} (hd : ∀ y, Reach l r x y → (star l r y).card = 2) :
    (componentEdges l r x).card = (componentVertices l r x).card := by
  classical
  have hsum := incidence_sum l r hloop x (fun _ => True)
  simp only [filter_true] at hsum
  have heq : ∑ y ∈ componentVertices l r x, (star l r y).card =
      2 * (componentVertices l r x).card := by
    calc _ = ∑ _y ∈ componentVertices l r x, 2 := by
          apply sum_congr rfl
          intro y hy
          exact hd y ((mem_filter.mp hy).2)
      _ = _ := by simp [mul_comm]
  omega


private theorem mono_two_color_count {l r : E → V} {c : E → Bool} {y : V}
    (hd : (star l r y).card = 2) (hm : ¬Mixed l r c y) :
    ((star l r y).filter fun e => c e = true).card = 0 ∨
      ((star l r y).filter fun e => c e = true).card = 2 := by
  classical
  by_cases h : ∃ e ∈ star l r y, c e = true
  · obtain ⟨e, he, hc⟩ := h
    right
    rw [filter_eq_self.mpr (fun f hf => (mono hm hf he).trans hc), hd]
  · left
    rw [card_eq_zero, filter_eq_empty_iff]
    intro e he hc
    exact h ⟨e, he, hc⟩

private theorem colouring_excludes_odd {l r : E → V} {C : Finset V}
    (hloop : ∀ e, l e ≠ r e) {c : E → Bool}
    (hc : ∀ y ∈ C, Mixed l r c y) : ¬OddComponent l r C := by
  classical
  rintro ⟨x, hcomp, hodd⟩
  have heq := component_edge_card hloop (fun y hy => (hcomp y hy).2)
  have hsum := incidence_sum l r hloop x (fun e => c e = true)
  have hsum' : (∑ y ∈ componentVertices l r x,
      ((star l r y).filter fun e => c e = true).card) =
      (componentVertices l r x).card := by
    calc _ = ∑ _y ∈ componentVertices l r x, 1 := by
          apply sum_congr rfl
          intro y hy
          have hy' := hcomp y ((mem_filter.mp hy).2)
          exact mixed_two_color_count hy'.2 (hc y hy'.1)
      _ = _ := by simp
  rw [hsum', ← heq] at hsum
  exact (Nat.not_odd_iff_even.mpr
    ((even_iff_exists_two_mul).mpr ⟨((componentEdges l r x).filter fun e => c e = true).card,
      hsum⟩)) hodd

private theorem defect_forces_odd {l r : E → V} {C : Finset V}
    (hloop : ∀ e, l e ≠ r e) (hdeg : ∀ x ∈ C, 2 ≤ (star l r x).card)
    {c : E → Bool} (hc : Optimal l r C c) {x : V}
    (hx : x ∈ defects l r C c) : OddComponent l r C := by
  classical
  have hcomp := defective_component hloop hdeg hc hx
  refine ⟨x, fun y hy => ⟨(hcomp y hy).1, (hcomp y hy).2.1⟩, ?_⟩
  have heq := component_edge_card hloop (fun y hy => (hcomp y hy).2.1)
  have hxS : x ∈ componentVertices l r x := by
    simp only [componentVertices, mem_filter, mem_univ, true_and]
    exact .refl _
  have hsum := incidence_sum l r hloop x (fun e => c e = true)
  have hothers : (∑ y ∈ (componentVertices l r x).erase x,
      ((star l r y).filter fun e => c e = true).card) =
      ((componentVertices l r x).erase x).card := by
    calc _ = ∑ _y ∈ (componentVertices l r x).erase x, 1 := by
          apply sum_congr rfl
          intro y hy
          obtain ⟨hyx, hyS⟩ := mem_erase.mp hy
          have hyR := (mem_filter.mp hyS).2
          have hm : Mixed l r c y := by
            by_contra h
            have hyD := mem_defects.mpr ⟨(hcomp y hyR).1, h⟩
            exact hyx ((hcomp y hyR).2.2.mp hyD)
          exact mixed_two_color_count (hcomp y hyR).2.1 hm
      _ = _ := by simp
  have hsplit := sum_erase_add (componentVertices l r x)
    (fun y => ((star l r y).filter fun e => c e = true).card) hxS
  have hcard := card_erase_add_one hxS
  have hroot := mono_two_color_count (defect_degree_two hloop hdeg hc hx)
    (mem_defects.mp hx).2
  rw [hothers] at hsplit
  rw [Nat.odd_iff]
  rcases hroot with hroot | hroot <;> omega

/-- A finite loopless multigraph admits a colouring of its ORIGINAL edge IDs
with both colours at every constrained vertex exactly when it has no
all-constrained degree-two component with odd original edge count.

Unconstrained vertices impose no obligation, even if their degree is greater
than one. In particular this includes arbitrary isolated free vertices and
the free-leaf convention. Parallel edges and empty edge types are included. -/
theorem exists_iff_no_odd_component (l r : E → V) (C : Finset V)
    (hloop : ∀ e, l e ≠ r e) (hdeg : ∀ x ∈ C, 2 ≤ (star l r x).card) :
    (∃ c : E → Bool, ∀ x ∈ C, Mixed l r c x) ↔ ¬OddComponent l r C := by
  classical
  constructor
  · rintro ⟨c, hc⟩
    exact colouring_excludes_odd hloop hc
  · intro hno
    obtain ⟨c, hc⟩ := optimal_exists l r C
    refine ⟨c, fun x hx => ?_⟩
    by_contra hm
    exact hno (defect_forces_odd hloop hdeg hc (mem_defects.mpr ⟨hx, hm⟩))

#print axioms exists_iff_no_odd_component

end D5.S3.Combinatorics.Graph.EdgeColouring.TwoColours
