module

public import OmegaBuild.Commands
public import Mathlib.GroupTheory.Perm.ClosureSwap
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Combinatorics.SimpleGraph.Basic

/-!
Omega original.

The definitions of hop and leap group follow Schachner and Udell,
*The group generated by a graph’s derangements*, arXiv:2610.18463v1, p. 2.
The cross-edge and parity-stabilizer proofs use Mathlib's permutation and
stabilizer APIs and apply to arbitrary simple graphs under their stated hypotheses.
-/

compile_only_with_mathlib

set_option autoImplicit false

@[expose] public section

open Equiv Set MulAction Pointwise

namespace D5.S3.Combinatorics.Graph.LeapGroups.LeapGroup

noncomputable section
variable {V : Type*} (G : SimpleGraph V)

/-- A hop on the given labelled graph. -/
def IsHop (g : Perm V) : Prop := ∀ x, G.Adj x (g x)

/-- The subgroup generated by every hop. -/
def leapGroup : Subgroup (Perm V) := Subgroup.closure {g | IsHop G g}

private theorem hop_mem {g : Perm V} (h : IsHop G g) : g ∈ leapGroup G :=
  Subgroup.subset_closure h

/-- The two cross-edges suffice for a pure transposition. -/
theorem swap_mem_of_cross_edges [DecidableEq V] {h : Perm V}
    (hh : IsHop G h) (a c : V)
    (ha : G.Adj (h.symm a) c) (hc : G.Adj (h.symm c) a) :
    swap a c ∈ leapGroup G := by
  have hnew : IsHop G (swap a c * h) := by
    intro x
    rw [Perm.mul_apply]
    by_cases hxa : h x = a
    · have hx : x = h.symm a := by rw [← hxa, h.symm_apply_apply]
      rw [hxa, swap_apply_left, hx]
      exact ha
    by_cases hxc : h x = c
    · have hx : x = h.symm c := by rw [← hxc, h.symm_apply_apply]
      rw [hxc, swap_apply_right, hx]
      exact hc
    rw [swap_apply_of_ne_of_ne hxa hxc]
    exact hh x
  have hm := (leapGroup G).mul_mem (hop_mem G hnew)
    ((leapGroup G).inv_mem (hop_mem G hh))
  simpa [mul_assoc] using hm

/-- The unordered family of the two labelled parity classes. -/
private def parityClasses (p : V → ZMod 2) : Set (Set V) :=
  Set.range (fun t : ZMod 2 => {x | p x = t})

def parityStabilizer (p : V → ZMod 2) : Subgroup (Perm V) :=
  MulAction.stabilizer (Perm V) ({{x | p x = 0}, {x | p x = 1}} : Set (Set V))

private theorem parityClasses_eq_pair (p : V → ZMod 2) :
    parityClasses p = {{x | p x = 0}, {x | p x = 1}} := by
  ext s
  constructor
  · rintro ⟨t, rfl⟩
    rcases (show t = 0 ∨ t = 1 from
      (Fin.exists_fin_two (p := (t = ·))).mp ⟨t, rfl⟩) with rfl | rfl <;> simp
  · intro h
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at h
    rcases h with rfl | rfl
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

private theorem mem_parityStabilizer_iff (p : V → ZMod 2) (g : Perm V) :
    g ∈ parityStabilizer p ↔ ∃ d : ZMod 2, ∀ x, p (g x) = p x + d := by
  rw [parityStabilizer, ← parityClasses_eq_pair, MulAction.mem_stabilizer_iff]
  constructor
  · intro hg
    have h : g • ({x | p x = 0} : Set V) ∈ parityClasses p := by
      rw [← hg]
      exact Set.mem_smul_set.mpr ⟨_, ⟨0, rfl⟩, rfl⟩
    obtain ⟨d, hd⟩ := h
    change ({x | p x = d} : Set V) = g • ({x | p x = 0} : Set V) at hd
    refine ⟨d, fun x => ?_⟩
    have he : p (g x) = d ↔ p x = 0 := by
      change g x ∈ ({y | p y = d} : Set V) ↔ _
      rw [hd]
      constructor
      · intro hx
        obtain ⟨y, hy, hyx⟩ := Set.mem_smul_set.mp hx
        have : y = x := g.injective hyx
        simpa [this] using hy
      · intro hx
        exact Set.mem_smul_set.mpr ⟨x, hx, rfl⟩
    rcases (show p x = 0 ∨ p x = 1 from
      (Fin.exists_fin_two (p := (p x = ·))).mp ⟨p x, rfl⟩) with hz | ho
    · rw [hz, zero_add]
      exact he.mpr hz
    · rw [ho]
      have hn : p (g x) ≠ d := by
        intro heq
        have := he.mp heq
        rw [ho] at this
        exact one_ne_zero this
      rcases (show d = 0 ∨ d = 1 from
        (Fin.exists_fin_two (p := (d = ·))).mp ⟨d, rfl⟩) with hd0 | hd1 <;>
        rcases (show p (g x) = 0 ∨ p (g x) = 1 from
          (Fin.exists_fin_two (p := (p (g x) = ·))).mp ⟨p (g x), rfl⟩) with hx0 | hx1 <;>
        simp_all [show (1 + 1 : ZMod 2) = 0 by decide]
  · rintro ⟨d, hd⟩
    have hf (t : ZMod 2) :
        g • ({x | p x = t} : Set V) = {x | p x = t + d} := by
      ext y
      constructor
      · rintro ⟨x, hx, rfl⟩
        change p x = t at hx
        change p (g x) = t+d
        rw [hd, hx]
      · intro hy
        change p y = t+d at hy
        refine Set.mem_smul_set.mpr ⟨g.symm y, ?_, g.apply_symm_apply y⟩
        change p (g.symm y) = t
        have h := hd (g.symm y)
        rw [g.apply_symm_apply, hy] at h
        exact add_right_cancel h.symm
    ext s
    constructor
    · rintro ⟨a, ⟨t, rfl⟩, rfl⟩
      exact ⟨t+d, (hf t).symm⟩
    · rintro ⟨t, rfl⟩
      refine Set.mem_smul_set.mpr ⟨_, ⟨t-d, rfl⟩, ?_⟩
      rw [hf, sub_add_cancel]

/-- The within-class permutation conclusion of the pinned Mathlib transposition closure
theorem, applied to the swaps already present in a given subgroup. -/
private theorem mem_of_same_class_swaps [Finite V] [DecidableEq V]
    (H : Subgroup (Perm V)) (p : V → ZMod 2)
    (hs : ∀ x y, p x = p y → swap x y ∈ H)
    (g : Perm V) (hg : ∀ x, p (g x) = p x) : g ∈ H := by
  let S : Set (Perm V) := {f | f.IsSwap ∧ f ∈ H}
  have hS : ∀ f ∈ S, f.IsSwap := fun _ h => h.1
  have hcl : Subgroup.closure S ≤ H := (Subgroup.closure_le _).mpr fun _ h => h.2
  apply hcl
  apply (mem_closure_isSwap hS).mpr
  refine ⟨Set.toFinite _, fun x => ?_⟩
  by_cases hx : g x = x
  · rw [hx]
    exact mem_orbit_self x
  have hm : swap x (g x) ∈ Subgroup.closure S :=
    Subgroup.subset_closure ⟨⟨x, g x, Ne.symm hx, rfl⟩, hs _ _ (hg x).symm⟩
  exact ⟨⟨swap x (g x), hm⟩, swap_apply_left x (g x)⟩

/-- Same-class swaps and one hop generate the full parity-class stabilizer. -/
theorem eq_parityStabilizer [Finite V] [DecidableEq V]
    (p : V → ZMod 2) (hflip : ∀ x y, G.Adj x y → p y = p x + 1)
    (hs : ∀ x y, p x = p y → swap x y ∈ leapGroup G)
    (h : Perm V) (hh : IsHop G h) :
    leapGroup G = parityStabilizer p := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    exact (mem_parityStabilizer_iff p g).mpr ⟨1, fun x => hflip _ _ (hg x)⟩
  · intro g hg
    obtain ⟨d, hd⟩ := (mem_parityStabilizer_iff p g).mp hg
    rcases (show d = 0 ∨ d = 1 from
      (Fin.exists_fin_two (p := (d = ·))).mp ⟨d, rfl⟩) with rfl | rfl
    · exact mem_of_same_class_swaps _ p hs g (fun x => by simpa using hd x)
    · have hmem : h * g ∈ leapGroup G := by
        apply mem_of_same_class_swaps _ p hs
        intro x
        rw [Perm.mul_apply, hflip _ _ (hh (g x)), hd, add_assoc]
        simp [CharTwo.add_self_eq_zero]
      have := (leapGroup G).mul_mem ((leapGroup G).inv_mem (hop_mem G hh)) hmem
      simpa [← mul_assoc] using this

end
end D5.S3.Combinatorics.Graph.LeapGroups.LeapGroup
