    ![0,1,2,3,2,1,1,2,3,4,3,2,2,3,4,5,4,3,2,3,4,4,6,6,6,4,6,5,3,5,5,5,5,5,6,6,8,8,8,6,8,7,5,7,7,7,7,7,4,6,6,6,6,6,6,5,5,7,5,7,0,7],
    ![0,1,2,3,2,1,1,2,3,4,3,2,2,3,4,5,4,3,2,3,4,4,6,6,6,4,6,5,3,5,5,5,5,5,6,6,8,8,8,6,8,7,5,7,7,7,7,7,4,6,6,6,6,6,6,5,5,7,5,7,7,0]]

set_option maxRecDepth 200000 in
set_option maxHeartbeats 0 in
-- Kernel checking covers all 62 deletion roots and 62 local vertices.
private theorem parent_facts : ∀ z a : Fin 62, a≠z → parent z a≠z ∧
    (a=root z ∨ ClosedModule.graph.Adj a (parent z a) ∧ rank z (parent z a)<rank z a) := by
  decide +kernel

private theorem root_survives (z : Fin 62) : root z≠z := by
  unfold root
  split <;> simp_all [eq_comm]

/-- Each actual open module remains connected after every one-vertex deletion. -/
theorem module_delete_preconnected (z : Fin 62) :
    (ClosedModule.graph.induce {a | a≠z}).Preconnected := by
  let p : {a : Fin 62 // a≠z} → {a : Fin 62 // a≠z} :=
    fun a => ⟨parent z a,(parent_facts z a a.property).1⟩
  apply FiberConnectivity.preconnected_of_rank _ ⟨root z,root_survives z⟩ p (fun a => rank z a)
  intro a ha
  rcases (parent_facts z a a.property).2 with h | h
  · exact (ha (Subtype.ext h)).elim
  · exact h

private theorem module_preconnected : ClosedModule.graph.Preconnected := by
  intro a b
  have hz : ∀ a b : Fin 62, ∃ z : Fin 62, a≠z ∧ b≠z := by decide +kernel
  obtain ⟨z,ha,hb⟩ := hz a b
  let f : (ClosedModule.graph.induce {a | a≠z}) →g ClosedModule.graph :=
    ⟨fun a => a.val,fun h => h⟩
  exact ((module_delete_preconnected z) ⟨a,ha⟩ ⟨b,hb⟩).map f

variable {I : Type} [Fintype I] [DecidableEq I]

private theorem fiber_reachable (e : Equiv.Perm I) (z : I × Fin 62)
    (a b : {x : I × Fin 62 // x≠z}) (he : a.val.1=b.val.1) :
    ((graph e).induce {x | x≠z}).Reachable a b := by
  rcases a with ⟨⟨i,a⟩,ha⟩
  rcases b with ⟨⟨j,b⟩,hb⟩
  change i=j at he
  subst j
  by_cases hi : i=z.1
  · have ha' : a≠z.2 := fun h => ha (Prod.ext hi h)
    have hb' : b≠z.2 := fun h => hb (Prod.ext hi h)
    let f : (ClosedModule.graph.induce {a | a≠z.2}) →g
        ((graph e).induce {x | x≠z}) :=
      ⟨fun a => ⟨(i,a.val),fun h => a.property (congrArg Prod.snd h)⟩,
        fun h => Or.inl ⟨rfl,h⟩⟩
    exact ((module_delete_preconnected z.2) ⟨a,ha'⟩ ⟨b,hb'⟩).map f
  · let f : ClosedModule.graph →g ((graph e).induce {x | x≠z}) :=
      ⟨fun a => ⟨(i,a),fun h => hi (congrArg Prod.fst h)⟩,
        fun h => Or.inl ⟨rfl,h⟩⟩
    exact (module_preconnected a b).map f

/-- A transitive cyclic interface stays connected after deleting any vertex.
The forward orbit is used unless its target port was deleted; then the inverse
orbit supplies the surviving route. No two-distinct-interfaces premise is used. -/
theorem delete_preconnected (e : Equiv.Perm I)
    (horbit : ∀ i j, ∃ n : ℕ, (e : I → I)^[n] i=j) (z : I × Fin 62) :
    ((graph e).induce {x | x≠z}).Preconnected := by
  let r : {x : I × Fin 62 // x≠z} :=
    ⟨(z.1,root z.2),fun h => root_survives z.2 (congrArg Prod.snd h)⟩
  have path (q : Equiv.Perm I)
      (hq : ∀ i j, ∃ n : ℕ, (q : I → I)^[n] i=j)
      (p t : Fin 62)
      (hedge : ∀ i, i≠z.1 → (i,p)≠z ∧ (q i,t)≠z ∧ (graph e).Adj (i,p) (q i,t)) :
      ∀ a : {x : I × Fin 62 // x≠z}, ((graph e).induce {x | x≠z}).Reachable a r := by
    have hn : ∀ n : ℕ, ∀ i, (q : I → I)^[n] i=z.1 →
        ∀ a : {x : I × Fin 62 // x≠z}, a.val.1=i →
        ((graph e).induce {x | x≠z}).Reachable a r := by
      intro n
      induction n with
      | zero =>
        intro i hi a ha
        exact fiber_reachable e z a r (ha.trans hi)
      | succ n ih =>
        intro i hi a ha
        by_cases he : i=z.1
        · exact fiber_reachable e z a r (ha.trans he)
        · obtain ⟨hp,ht,he'⟩ := hedge i he
          let b : {x : I × Fin 62 // x≠z} := ⟨(i,p),hp⟩
          let c : {x : I × Fin 62 // x≠z} := ⟨(q i,t),ht⟩
          have hec : ((graph e).induce {x | x≠z}).Adj b c := he'
          exact (fiber_reachable e z a b ha).trans
            (hec.reachable.trans (ih (q i) hi c rfl))
    intro a
    obtain ⟨n,hn'⟩ := hq a.val.1 z.1
    exact hn n a.val.1 hn' a rfl
  have hr : ∀ a : {x : I × Fin 62 // x≠z},
      ((graph e).induce {x | x≠z}).Reachable a r := by
    by_cases hz : z.2=17
    · have hi : ∀ i j, ∃ n : ℕ, (e.symm : I → I)^[n] i=j := by
        intro i j
        obtain ⟨n,hn⟩ := horbit j i
        refine ⟨n,?_⟩
        rw [← hn]
        exact (Function.LeftInverse.iterate e.symm_apply_apply n) j
      apply path e.symm hi 17 12
      intro i hi'
      refine ⟨fun h => hi' (congrArg Prod.fst h),?_,Or.inr (Or.inr ⟨rfl,rfl,rfl⟩)⟩
      intro h
      have hh := (congrArg Prod.snd h).trans hz
      exact (by decide : (12 : Fin 62)≠17) hh
    · apply path e horbit 12 17
      intro i hi
      refine ⟨fun h => hi (congrArg Prod.fst h),?_,Or.inr (Or.inl ⟨rfl,rfl,rfl⟩)⟩
      intro h
      exact hz (congrArg Prod.snd h).symm
  intro a b
  exact (hr a).trans (hr b).symm

/-- The same actual cyclic assembly is connected before deletion as well. -/
theorem preconnected (e : Equiv.Perm I)
    (horbit : ∀ i j, ∃ n : ℕ, (e : I → I)^[n] i=j) : (graph e).Preconnected := by
  intro a b
  have hz : ∀ a b : Fin 62, ∃ t : Fin 62, a≠t ∧ b≠t := by decide +kernel
  obtain ⟨t,ha,hb⟩ := hz a.2 b.2
  let z := (a.1,t)
  let f : ((graph e).induce {x | x≠z}) →g graph e := ⟨fun x => x.val,fun h => h⟩
  exact ((delete_preconnected e horbit z)
    ⟨a,fun h => ha (congrArg Prod.snd h)⟩
    ⟨b,fun h => hb (congrArg Prod.snd h)⟩).map f

/-- Complete actual two-connectivity for every nonempty transitive permutation. -/
theorem two_connected [Nonempty I] (e : Equiv.Perm I)
    (horbit : ∀ i j, ∃ n : ℕ, (e : I → I)^[n] i=j) :
    (graph e).Connected ∧
    (∀ z : I × Fin 62, ((graph e).induce {x | x≠z}).Connected) ∧
    3≤Fintype.card (I × Fin 62) := by
  refine ⟨⟨preconnected e horbit⟩,?_,?_⟩
  · intro z
    exact
      { preconnected := delete_preconnected e horbit z
        nonempty := ⟨⟨(z.1,root z.2),fun h => root_survives z.2 (congrArg Prod.snd h)⟩⟩ }
  · have hi := Fintype.card_pos_iff.mpr (inferInstance : Nonempty I)
    simp only [Fintype.card_prod,Fintype.card_fin]
    omega

/-- In particular every positive cyclic size, including one and two. -/
theorem cyclic_two_connected (r : ℕ) (hr : 0<r) :
    (graph (finRotate r)).Connected ∧
    (∀ z : Fin r × Fin 62, ((graph (finRotate r)).induce {x | x≠z}).Connected) ∧
    3≤Fintype.card (Fin r × Fin 62) := by
  letI : NeZero r := ⟨hr.ne'⟩
  apply two_connected
  intro i j
  refine ⟨(j-i).val,?_⟩
  rw [← finCycle_eq_finRotate_iterate]
  simp

