private theorem inverses : ∀ g : Fin 168, ∀ v : Fin 14,
    vertexMap (inverseIndex g) (vertexMap g v)=v ∧
    vertexMap g (vertexMap (inverseIndex g) v)=v := by decide +kernel

private theorem adjacency_transport : ∀ g : Fin 168, ∀ v w : Fin 14,
    base.Adj (vertexMap g v) (vertexMap g w) ↔ base.Adj v w := by decide +kernel

private theorem index_transport : ∀ g : Fin 168, ∀ v w : Fin 14,
    base.Adj v w → edgeIndex (vertexMap g v) (vertexMap g w)=flagMap g (edgeIndex v w) := by
  decide +kernel

/-- These are actual coordinate automorphisms of the fourteen-vertex graph. -/
def automorphism (g : Fin 168) : base ≃g base where
  toFun := vertexMap g
  invFun := vertexMap (inverseIndex g)
  left_inv v := (inverses g v).1
  right_inv v := (inverses g v).2
  map_rel_iff' := by intro v w; exact adjacency_transport g v w

def pull (g : Fin 168) (s : Signing) : Signing := fun e => s (flagMap g e)

/-- Relabeling points and lines transports the actual two-sheet graph. -/
def liftIso (g : Fin 168) (s : Signing) : graph (pull g s) ≃g graph s where
  toEquiv := (automorphism g).toEquiv.prodCongr (Equiv.refl F2)
  map_rel_iff' := by
    intro x y
    change (base.Adj (vertexMap g x.1) (vertexMap g y.1) ∧
      x.2+y.2=s (edgeIndex (vertexMap g x.1) (vertexMap g y.1))) ↔
      (base.Adj x.1 y.1 ∧ x.2+y.2=s (flagMap g (edgeIndex x.1 y.1)))
    rw [adjacency_transport]
    by_cases h : base.Adj x.1 y.1
    · rw [index_transport g x.1 y.1 h]
    · simp [h]

def representative (k : Fin 6) : Signing := fun e =>
  if (HeawoodCertificates.sixTwists k).contains
    ((flags e).1.val+1,(flags e).2.val+1) then 1 else 0

def matrix (a : Fin 8 → F2) : Mat :=
  ![![a 3+a 7,a 0,a 1], ![a 2,a 3,a 4], ![a 5,a 6,a 7]]

