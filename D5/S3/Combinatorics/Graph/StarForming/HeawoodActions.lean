private def code (a : Fin 8 → F2) : Fin 256 :=
  ⟨(a 0).val+2*(a 1).val+4*(a 2).val+8*(a 3).val+
    16*(a 4).val+32*(a 5).val+64*(a 6).val+128*(a 7).val,by
    have h0 := (a 0).val_lt
    have h1 := (a 1).val_lt
    have h2 := (a 2).val_lt
    have h3 := (a 3).val_lt
    have h4 := (a 4).val_lt
    have h5 := (a 5).val_lt
    have h6 := (a 6).val_lt
    have h7 := (a 7).val_lt
    norm_num at h0 h1 h2 h3 h4 h5 h6 h7
    omega⟩

private theorem bits_code : ∀ a : Fin 8 → F2, bits (code a)=a := by decide +kernel

/-- Every nonzero traceless binary matrix is represented by one of the six
original signings under an actual coordinate automorphism. The finite table
checks the entire three-by-three matrix domain, not a sample of cover sizes. -/
theorem classification (M : Mat) (ht : Matrix.trace M=0) (hne : M≠0) :
    ∃ g : Fin 168, ∃ k : Fin 6, phi (pull g (representative k))=M := by
  let a : Fin 8 → F2 := ![M 0 1,M 0 2,M 1 0,M 1 1,M 1 2,M 2 0,M 2 1,M 2 2]
  have hc : ∀ x y z : F2, x+y+z=0 → x=y+z := by decide +kernel
  have hd : M 0 0=M 1 1+M 2 2 := by
    apply hc
    simpa [Matrix.trace,Fin.sum_univ_succ,add_assoc] using ht
  have hm : matrix a=M := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [matrix,a,hd]
  have hn : code a≠0 := by
    intro he
    have hh := bits_code a
    rw [he] at hh
    have hz : bits 0=0 := by funext i; simp [bits]
    have ha : a=0 := hh.symm.trans hz
    apply hne
    rw [← hm,ha]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [matrix]
  refine ⟨actionFor (code a),typeFor (code a),?_⟩
  rw [classification_table _ hn,bits_code,hm]

/-- All nontrivial signings are isomorphic to one of the six actual types. -/
theorem six_isomorphism (s : Signing) (hs : phi s≠0) :
    ∃ k : Fin 6, Nonempty (graph s ≃g graph (representative k)) := by
  obtain ⟨g,k,hg⟩ := classification (phi s) (trace_phi s) hs
  obtain ⟨e⟩ := isomorphic_of_phi_eq s (pull g (representative k)) hg.symm
  exact ⟨k,⟨e.trans (liftIso g (representative k))⟩⟩

end D5.S3.Combinatorics.Graph.StarForming.HeawoodActions
