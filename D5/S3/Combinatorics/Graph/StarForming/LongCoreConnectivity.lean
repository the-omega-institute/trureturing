    ![0,1,2,3,4,5,1,2,3,4,3,4,2,3,4,5,4,5,2,3,4,4,6,6,6,4,6,5,3,5,5,5,5,5,6,6,8,8,8,6,8,7,5,7,7,7,7,7,6,6,8,8,8,6,8,7,5,7,7,7,0,7],
    ![0,1,2,3,4,5,1,2,3,4,3,4,2,3,4,5,4,5,2,3,4,4,6,6,6,4,6,5,3,5,5,5,5,5,6,6,8,8,8,6,8,7,5,7,7,7,7,7,6,6,8,8,8,6,8,7,5,7,7,7,7,0]]

private theorem parent_facts : ∀ z a : Fin 62, a≠z → parent z a≠z ∧
    (a=root z ∨ LongCoreRings.localGraph.Adj a (parent z a) ∧ rank z (parent z a)<rank z a) := by
  decide +kernel

private theorem root_survives (z : Fin 62) : root z≠z := by
  unfold root
  split <;> simp_all [eq_comm]

private theorem local_delete_preconnected (z : Fin 62) :
    (LongCoreRings.localGraph.induce {a | a≠z}).Preconnected := by
  let p : {a : Fin 62 // a≠z} → {a : Fin 62 // a≠z} :=
    fun a => ⟨parent z a,(parent_facts z a a.property).1⟩
  apply FiberConnectivity.preconnected_of_rank _ ⟨root z,root_survives z⟩ p
    (fun a => rank z a)
  intro a ha
  rcases (parent_facts z a a.property).2 with h | h
  · exact (ha (Subtype.ext h)).elim
  · exact h

private theorem local_preconnected : LongCoreRings.localGraph.Preconnected := by
  intro a b
  have hz : ∀ a b : Fin 62, ∃ z : Fin 62, a≠z ∧ b≠z := by decide +kernel
  obtain ⟨z,ha,hb⟩ := hz a b
  let f : (LongCoreRings.localGraph.induce {a | a≠z}) →g LongCoreRings.localGraph := ⟨fun a => a.val,fun h => h⟩
  exact ((local_delete_preconnected z) ⟨a,ha⟩ ⟨b,hb⟩).map f

variable {I : Type} [Fintype I] [DecidableEq I]

/-- Actual cyclic bridges and local paths survive every vertex deletion. -/
theorem two_connected [Nonempty I] (e : Equiv.Perm I)
    (horbit : ∀ i j, ∃ n : ℕ, (e : I → I)^[n] i=j) :
    (graph e).Connected ∧
    (∀ z : I × Fin 62, ((graph e).induce {x | x≠z}).Connected) ∧
    3≤Fintype.card (I × Fin 62) := by
  have hint : ∀ i a b, LongCoreRings.localGraph.Adj a b → (graph e).Adj (i,a) (i,b) :=
    fun _ _ _ h => Or.inl ⟨rfl,h⟩
  have hb : ∀ i, (graph e).Adj (i,5) (e i,0) := fun _ => Or.inr (Or.inl ⟨rfl,Or.inl ⟨rfl,rfl⟩⟩)
  refine ⟨⟨CyclicConnectivity.preconnected _ _ e horbit 5 0 local_preconnected hint hb⟩,?_,?_⟩
  · intro z
    exact
      { preconnected := CyclicConnectivity.delete_preconnected _ _ e horbit 5 0
          (by decide) local_preconnected local_delete_preconnected hint hb z
        nonempty := ⟨⟨(z.1,root z.2),fun h => root_survives z.2 (congrArg Prod.snd h)⟩⟩ }
  · have hi := Fintype.card_pos_iff.mpr (inferInstance : Nonempty I)
    simp only [Fintype.card_prod,Fintype.card_fin]
    omega

/-- Every positive cyclic size, with the singleton case explicitly retained. -/
theorem cyclic_two_connected (r : ℕ) (hr : 0<r) :
    (graph (finRotate r)).Connected ∧
    (∀ z : Fin r × Fin 62, ((graph (finRotate r)).induce {x | x≠z}).Connected) ∧
    3≤Fintype.card (Fin r × Fin 62) := by
  letI : NeZero r := ⟨hr.ne'⟩
  apply two_connected
  intro i j
  refine ⟨(j-i).val,?_⟩
  rw [← finCycle_eq_finRotate_iterate]
  simp

