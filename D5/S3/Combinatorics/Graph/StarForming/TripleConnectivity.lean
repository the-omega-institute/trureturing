private theorem parent_facts : ∀ z a : Fin 48, a≠z → parent z a≠z ∧
    (a=root z ∨ TripleModule.graph.Adj a (parent z a) ∧ rank z (parent z a)<rank z a) := by
  decide +kernel

private theorem root_survives (z : Fin 48) : root z≠z := by
  unfold root
  split <;> simp_all [eq_comm]

private theorem local_delete_preconnected (z : Fin 48) :
    (TripleModule.graph.induce {a | a≠z}).Preconnected := by
  let p : {a : Fin 48 // a≠z} → {a : Fin 48 // a≠z} :=
    fun a => ⟨parent z a,(parent_facts z a a.property).1⟩
  apply FiberConnectivity.preconnected_of_rank _ ⟨root z,root_survives z⟩ p
    (fun a => rank z a)
  intro a ha
  rcases (parent_facts z a a.property).2 with h | h
  · exact (ha (Subtype.ext h)).elim
  · exact h

private theorem local_preconnected : TripleModule.graph.Preconnected := by
  intro a b
  have hz : ∀ a b : Fin 48, ∃ z : Fin 48, a≠z ∧ b≠z := by decide +kernel
  obtain ⟨z,ha,hb⟩ := hz a b
  let f : (TripleModule.graph.induce {a | a≠z}) →g TripleModule.graph := ⟨fun a => a.val,fun h => h⟩
  exact ((local_delete_preconnected z) ⟨a,ha⟩ ⟨b,hb⟩).map f

variable {I : Type} [Fintype I] [DecidableEq I]

/-- Actual cyclic bridges and local paths survive every vertex deletion. -/
theorem two_connected [Nonempty I] (e : Equiv.Perm I)
    (horbit : ∀ i j, ∃ n : ℕ, (e : I → I)^[n] i=j) :
    (graph e).Connected ∧
    (∀ z : I × Fin 48, ((graph e).induce {x | x≠z}).Connected) ∧
    3≤Fintype.card (I × Fin 48) := by
  have hint : ∀ i a b, TripleModule.graph.Adj a b → (graph e).Adj (i,a) (i,b) :=
    fun _ _ _ h => Or.inl ⟨rfl,h⟩
  have hb : ∀ i, (graph e).Adj (i,16) (e i,17) := fun _ => Or.inr (Or.inl ⟨rfl,rfl,rfl⟩)
  refine ⟨⟨CyclicConnectivity.preconnected _ _ e horbit 16 17 local_preconnected hint hb⟩,?_,?_⟩
  · intro z
    exact
      { preconnected := CyclicConnectivity.delete_preconnected _ _ e horbit 16 17
          (by decide) local_preconnected local_delete_preconnected hint hb z
        nonempty := ⟨⟨(z.1,root z.2),fun h => root_survives z.2 (congrArg Prod.snd h)⟩⟩ }
  · have hi := Fintype.card_pos_iff.mpr (inferInstance : Nonempty I)
    simp only [Fintype.card_prod,Fintype.card_fin]
    omega

/-- Every positive cyclic size, with the singleton case explicitly retained. -/
theorem cyclic_two_connected (r : ℕ) (hr : 0<r) :
    (graph (finRotate r)).Connected ∧
    (∀ z : Fin r × Fin 48, ((graph (finRotate r)).induce {x | x≠z}).Connected) ∧
    3≤Fintype.card (Fin r × Fin 48) := by
  letI : NeZero r := ⟨hr.ne'⟩
  apply two_connected
  intro i j
  refine ⟨(j-i).val,?_⟩
  rw [← finCycle_eq_finRotate_iterate]
  simp

