open Data (Piece)

def Data.Piece.eval (p : Piece) (t : ℝ) : ℝ := (p.c : ℝ) + (p.m : ℝ) * t + (p.s : ℝ) * t ^ 2
def Data.Piece.Contains (p : Piece) (t : ℝ) : Prop := (p.lo : ℝ) ≤ t ∧ t ≤ (p.hi : ℝ)

private theorem max_four_eq {H L M T : ℝ}
    (hH : H ≤ T) (h0 : 0 ≤ T) (hL : L ≤ T) (hM : M ≤ T)
    (hT : T ≤ H ∨ T ≤ L ∨ T ≤ M ∨ T ≤ 0) : max H (max 0 (max L M)) = T := by
  apply le_antisymm (max_le hH (max_le h0 (max_le hL hM)))
  rcases hT with h | h | h | h
  · exact h.trans (le_max_left _ _)
  · exact h.trans ((le_max_left _ _).trans ((le_max_right _ _).trans (le_max_right _ _)))
  · exact h.trans ((le_max_right _ _).trans ((le_max_right _ _).trans (le_max_right _ _)))
  · exact h.trans ((le_max_left _ _).trans (le_max_right _ _))

private theorem hump_of_outside (t : ℝ) (ht : q ≤ |t|) :
    c - gamma * (min |t| q) ^ 2 = 0 := by
  rw [min_eq_right ht]
  norm_num [c, gamma, q, Data.c, Data.gamma, Data.q]

private theorem piece_eval (i : Fin 7) (t : ℝ) (ht : (Data.pieces i).Contains t) :
    F t = (Data.pieces i).eval t := by
  fin_cases i <;> norm_num [Data.pieces, Data.Piece.Contains, Data.Piece.eval,
    Data.q, Data.c, Data.gamma, Data.B, Data.C] at ht ⊢
  · have hp := mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)
    have hpos : 0 ≤ (0 / 1 : ℝ) + (0 / 1 : ℝ) * t + (0 / 1 : ℝ) * t ^ 2 := by nlinarith [hp]
    have hH := hump_of_outside t (by
      norm_num [q, Data.q]
      nlinarith [neg_le_abs t, ht.2])
    apply max_four_eq
    · rw [hH] <;> nlinarith [hpos]
    · nlinarith [hpos]
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · right; right; right; norm_num
  · have hp := mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)
    have hpos : 0 ≤ (39 / 5000 : ℝ) + (0 / 1 : ℝ) * t + (-7800 / 11881 : ℝ) * t ^ 2 := by nlinarith [hp]
    have hclip : min |t| q = |t| := by
      apply min_eq_left
      apply abs_le.mpr
      norm_num [q, Data.q]
      exact ht
    apply max_four_eq
    · rw [hclip, sq_abs]
      norm_num [c, gamma, Data.c, Data.gamma, Data.q] <;> linarith
    · nlinarith [hpos]
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · left
      rw [hclip, sq_abs]
      norm_num [c, gamma, Data.c, Data.gamma, Data.q] <;> linarith
  · have hp := mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)
    have hpos : 0 ≤ (0 / 1 : ℝ) + (0 / 1 : ℝ) * t + (0 / 1 : ℝ) * t ^ 2 := by nlinarith [hp]
    have hH := hump_of_outside t (by
      norm_num [q, Data.q]
      nlinarith [le_abs_self t, ht.1])
    apply max_four_eq
    · rw [hH] <;> nlinarith [hpos]
    · nlinarith [hpos]
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · right; right; right; norm_num
  · have hp := mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)
    have hpos : 0 ≤ (-103037 / 10000000 : ℝ) + (493 / 10000 : ℝ) * t + (0 / 1 : ℝ) * t ^ 2 := by nlinarith [hp]
    have hH := hump_of_outside t (by
      norm_num [q, Data.q]
      nlinarith [le_abs_self t, ht.1])
    apply max_four_eq
    · rw [hH] <;> nlinarith [hpos]
    · nlinarith [hpos]
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · right; left
      apply le_min <;> norm_num [Data.B] <;> linarith [ht.1, ht.2]
  · have hp := mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)
    have hpos : 0 ≤ (37961 / 5000000 : ℝ) + (0 / 1 : ℝ) * t + (0 / 1 : ℝ) * t ^ 2 := by nlinarith [hp]
    have hH := hump_of_outside t (by
      norm_num [q, Data.q]
      nlinarith [le_abs_self t, ht.1])
    apply max_four_eq
    · rw [hH] <;> nlinarith [hpos]
    · nlinarith [hpos]
    · exact (min_le_right _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · right; left
      apply le_min <;> norm_num [Data.B] <;> linarith [ht.1, ht.2]
  · have hp := mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)
    have hpos : 0 ≤ (-1276489 / 5000000 : ℝ) + (127 / 250 : ℝ) * t + (0 / 1 : ℝ) * t ^ 2 := by nlinarith [hp]
    have hH := hump_of_outside t (by
      norm_num [q, Data.q]
      nlinarith [le_abs_self t, ht.1])
    apply max_four_eq
    · rw [hH] <;> nlinarith [hpos]
    · nlinarith [hpos]
    · exact (min_le_right _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · exact (min_le_left _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · right; right; left
      apply le_min <;> norm_num [Data.B, Data.C] <;> linarith [ht.1, ht.2]
  · have hp := mul_nonneg (sub_nonneg.mpr ht.1) (sub_nonneg.mpr ht.2)
    have hpos : 0 ≤ (214907 / 1000000 : ℝ) + (0 / 1 : ℝ) * t + (0 / 1 : ℝ) * t ^ 2 := by nlinarith [hp]
    have hH := hump_of_outside t (by
      norm_num [q, Data.q]
      nlinarith [le_abs_self t, ht.1])
    apply max_four_eq
    · rw [hH] <;> nlinarith [hpos]
    · nlinarith [hpos]
    · exact (min_le_right _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · exact (min_le_right _ _).trans (by norm_num [Data.B, Data.C] <;> nlinarith [hpos, ht.1, ht.2])
    · right; right; left
      apply le_min <;> norm_num [Data.B, Data.C] <;> linarith [ht.1, ht.2]

private theorem piece_cover (t : ℝ) (ht : t ∈ Set.Icc (-1 : ℝ) 1) :
    ∃ i : Fin 7, (Data.pieces i).Contains t := by
  rcases ht with ⟨ht0, ht1⟩
  by_cases h0 : t ≤ -(109 / 1000 : ℝ)
  · exact ⟨0, by norm_num [Data.pieces, Data.Piece.Contains, Data.q]; exact ⟨ht0, h0⟩⟩
  by_cases h1 : t ≤ (109 / 1000 : ℝ)
  · exact ⟨1, by norm_num [Data.pieces, Data.Piece.Contains, Data.q]; exact ⟨by linarith, h1⟩⟩
  by_cases h2 : t ≤ (209 / 1000 : ℝ)
  · exact ⟨2, by norm_num [Data.pieces, Data.Piece.Contains, Data.q]; exact ⟨by linarith, h2⟩⟩
  by_cases h3 : t ≤ (363 / 1000 : ℝ)
  · exact ⟨3, by norm_num [Data.pieces, Data.Piece.Contains]; exact ⟨by linarith, h3⟩⟩
  by_cases h4 : t ≤ (207 / 400 : ℝ)
  · exact ⟨4, by norm_num [Data.pieces, Data.Piece.Contains]; exact ⟨by linarith, h4⟩⟩
  by_cases h5 : t ≤ (1157 / 1250 : ℝ)
  · exact ⟨5, by norm_num [Data.pieces, Data.Piece.Contains]; exact ⟨by linarith, h5⟩⟩
  exact ⟨6, by norm_num [Data.pieces, Data.Piece.Contains]; exact ⟨by linarith, ht1⟩⟩

private theorem lower_eval (i j : Fin 7) (y : ℝ) (hy : (Data.pieces j).Contains y) :
    (Data.lower i j).Contains y ∧ (Data.lower i j).eval y ≤ F y := by
  by_cases h : j = 1 ∧ i≠1
  · rcases h with ⟨rfl, hi⟩
    constructor
    · simpa [Data.lower, hi, Data.Piece.Contains] using hy
    · simpa [Data.lower, hi, Data.Piece.eval] using F_nonneg y
  · simp [Data.lower, h, hy, ← piece_eval j y hy]

private theorem side_real {l h x d : ℚ} (H : Data.side l h x d)
    {u : ℝ} (hl : (l : ℝ) ≤ u) (hh : u ≤ (h : ℝ)) :
    0 ≤ (d : ℝ) * (u - (x : ℝ)) := by
  rcases H with ⟨rfl, hd⟩ | ⟨rfl, hd⟩ | hd
  · exact mul_nonneg (by exact_mod_cast hd) (sub_nonneg.mpr hl)
  · exact mul_nonneg_of_nonpos_of_nonpos (by exact_mod_cast hd) (sub_nonpos.mpr hh)
  · simp [hd]

private theorem central_curvature (θ u v h : ℝ) (hθ : 0 ≤ θ) (hθ1 : θ ≤ 1 / 4) :
    0 ≤ nu0 * (v - a * u) ^ 2 + θ * nu1 * (h - v) ^ 2 + gamma * u ^ 2 - θ * lambda * gamma * h ^ 2 := by
  have hn : 0 ≤ θ * lambda * gamma := by
    apply mul_nonneg (mul_nonneg hθ _) <;> norm_num [lambda, gamma, Data.lam,
      Data.rho, Data.a, Data.R, Data.gamma, Data.c, Data.q]
  have hc : h ^ 2 ≤ 3 * ((h - v) ^ 2 + (v - a * u) ^ 2 + (a * u) ^ 2) := by
    nlinarith [sq_nonneg ((h - v) - (v - a * u)), sq_nonneg ((h - v) - a * u),
      sq_nonneg ((v - a * u) - a * u)]
  have h1 : 0 ≤ (nu0 - 3 * θ * lambda * gamma) * (v - a * u) ^ 2 := by
    apply mul_nonneg _ (sq_nonneg _)
    norm_num [nu0, lambda, gamma, Data.nu0, Data.lam, Data.rho,
      Data.a, Data.b, Data.R, Data.gamma, Data.c, Data.q] at *
    linarith
  have h2 : 0 ≤ θ * (nu1 - 3 * lambda * gamma) * (h - v) ^ 2 := by
    apply mul_nonneg (mul_nonneg hθ _) (sq_nonneg _)
    norm_num [nu1, lambda, gamma, Data.nu1, Data.nu0, Data.lam, Data.rho,
      Data.a, Data.b, Data.R, Data.gamma, Data.c, Data.q, Data.I0, Data.v,
      Fin.sum_univ_succ]
  have h3 : 0 ≤ (gamma - 3 * θ * lambda * gamma * a ^ 2) * u ^ 2 := by
    apply mul_nonneg _ (sq_nonneg _)
    norm_num [lambda, gamma, a, Data.lam, Data.rho, Data.a,
      Data.R, Data.gamma, Data.c, Data.q] at *
    linarith
  nlinarith [mul_nonneg hn (sub_nonneg.mpr hc)]

private theorem remainder_nonneg (k : Fin 11) (i : Fin 5) (j : Fin 7) (u v h : ℝ) :
    0 ≤ nu0 * (v - a * u) ^ 2 + (Data.theta k : ℝ) * nu1 * (h - v) ^ 2-
      ((Data.pieces (Data.active i)).s : ℝ) * u ^ 2+
      (Data.theta k : ℝ) * lambda * ((Data.lower (Data.active i) j).s : ℝ) * h ^ 2 := by
  have hθ : 0 ≤ (Data.theta k : ℝ) := by norm_num [Data.theta]; positivity
  have hθ1 : (Data.theta k : ℝ) ≤ 1 / 4 := by
    have hk : (k.val : ℝ) ≤ 10 := by exact_mod_cast Nat.le_of_lt_succ k.isLt
    norm_num [Data.theta]
    linarith
  have hn0 : 0 ≤ nu0 := by norm_num [nu0, Data.nu0, Data.a, Data.b, Data.R]
  have hn1 : 0 ≤ nu1 := by norm_num [nu1, Data.nu1, Data.nu0, Data.rho,
    Data.gamma, Data.c, Data.q, Data.a, Data.b, Data.R, Data.I0, Data.v, Fin.sum_univ_succ]
  have hg : 0 ≤ gamma := by norm_num [gamma, Data.gamma, Data.c, Data.q]
  fin_cases i <;> fin_cases j <;>
    simp [Data.active, Data.lower, Data.pieces, Data.Piece.eval, gamma, Data.gamma,
      Data.c, Data.q] <;>
    first | simpa [gamma, Data.gamma, Data.c, Data.q] using central_curvature (Data.theta k) u v h hθ hθ1
          | positivity

private theorem node_piece_bound (k : Fin 11) (i : Fin 5) (j : Fin 7) (t z y : ℝ)
    (ht : (Data.pieces (Data.active i)).Contains t) (hz : z ∈ Set.Icc (-1 : ℝ) 1)
    (hy : (Data.lower (Data.active i) j).Contains y) :
    (Data.pieces (Data.active i)).eval t ≤ nu0 * (z - a * (1 + t)) ^ 2+
      (Data.theta k : ℝ) * (nu1 * (y - z) ^ 2 + lambda * (Data.lower (Data.active i) j).eval y)+
      (Data.nodes k : ℝ) := by
  let x := Data.certificates k i j
  obtain ⟨hval, hdt, hdz, hdy⟩ := Data.checked k i j
  have hv : (0 : ℝ) ≤ (Data.value k (Data.active i) j x : ℝ) := by exact_mod_cast hval
  have hT := side_real hdt ht.1 ht.2
  have hZ := side_real hdz (u := z) (by simpa using hz.1) (by simpa using hz.2)
  have hY := side_real hdy hy.1 hy.2
  have hR := remainder_nonneg k i j (t - x.t) (z - x.z) (y - x.y)
  simp only [Data.value, Data.dt, Data.dz, Data.dy, Data.Piece.at,
    Rat.cast_add, Rat.cast_sub, Rat.cast_mul, Rat.cast_pow, Rat.cast_neg,
    Rat.cast_ofNat, Rat.cast_one, Rat.cast_zero] at hv hT hZ hY
  dsimp [Data.Piece.eval] at *
  change (0 : ℝ) ≤ _ at hv
  change (0 : ℝ) ≤ _ at hR
  dsimp only [x] at hv hR
  dsimp [nu0, nu1, a, lambda] at *
  nlinarith only [hv, hT, hZ, hY, hR]

private theorem node_bound (k : Fin 11) (t z y : ℝ)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) (hz : z ∈ Set.Icc (-1 : ℝ) 1)
    (hy : y ∈ Set.Icc (-1 : ℝ) 1) :
    F t ≤ nu0 * (z - a * (1 + t)) ^ 2 + (Data.theta k : ℝ) * (nu1 * (y - z) ^ 2 + lambda * F y)+
      (Data.nodes k : ℝ) := by
  obtain ⟨i, hi⟩ := piece_cover t ht
  obtain ⟨j, hj⟩ := piece_cover y hy
  have hθ : 0 ≤ (Data.theta k : ℝ) := by norm_num [Data.theta]; positivity
  have hl : 0 ≤ lambda := by norm_num [lambda, Data.lam, Data.rho, Data.a, Data.R]
  have hn0 : 0 ≤ nu0 := by norm_num [nu0, Data.nu0, Data.a, Data.b, Data.R]
  have hn1 : 0 ≤ nu1 := by norm_num [nu1, Data.nu1, Data.nu0, Data.rho,
    Data.gamma, Data.c, Data.q, Data.a, Data.b, Data.R, Data.I0, Data.v, Fin.sum_univ_succ]
  have hnodes : 0 ≤ (Data.nodes k : ℝ) := by
    exact_mod_cast (show ∀ k, 0 ≤ Data.nodes k by decide +kernel) k
  have hf := F_nonneg y
  have hc : ∀ i : Fin 7, i = 0 ∨ i = 2 ∨ ∃ l, Data.active l = i := by decide +kernel
  rcases hc i with rfl | rfl | ⟨l, rfl⟩
  · rw [piece_eval _ _ hi]
    norm_num [Data.Piece.eval, Data.pieces]
    positivity
  · rw [piece_eval _ _ hi]
    norm_num [Data.Piece.eval, Data.pieces]
    positivity
  · obtain ⟨hyl, hyle⟩ := lower_eval (Data.active l) j y hj
    calc F t = (Data.pieces (Data.active l)).eval t := piece_eval _ _ hi
      _ ≤ _ := node_piece_bound k l j t z y hi hz hyl
      _ ≤ _ := by gcongr

namespace Data
def weights : Fin 10 → ℚ := ![(84993 / 2500000), (361 / 625000), (289 / 500000), (289 / 500000), (289 / 500000), (361 / 625000), (723 / 1250000), (361 / 625000), (21741 / 2500000), (3327 / 156250)]
def center (j : Fin 10) : ℚ := ((j.val : ℚ) + 1) / 40
private theorem weights_nonneg : ∀ j, 0 ≤ weights j := by decide +kernel
end Data

/-- A nonnegative decreasing piecewise affine suffix envelope. -/
def envelope (θ : ℝ) : ℝ :=
  ∑ j : Fin 10, (Data.weights j : ℝ) * max 0 ((Data.center j : ℝ) - θ)

theorem envelope_nonneg (θ : ℝ) : 0 ≤ envelope θ := by
  apply Finset.sum_nonneg
  intro j _
  exact mul_nonneg (by exact_mod_cast Data.weights_nonneg j) (le_max_left _ _)

theorem envelope_antitone : Antitone envelope := by
  intro θ φ h
  apply Finset.sum_le_sum
  intro j _
  apply mul_le_mul_of_nonneg_left _ (by exact_mod_cast Data.weights_nonneg j)
  exact max_le_max le_rfl (by linarith)

theorem envelope_continuous : Continuous envelope := by
  unfold envelope
  fun_prop

private theorem cell_identity (j : Fin 10) (θ : ℝ)
    (h0 : (j.val : ℝ) / 40 ≤ θ) (h1 : θ ≤ ((j.val : ℝ) + 1) / 40) :
    envelope θ = (1 - (40 * θ - j.val)) * (Data.nodes ⟨j.val, by omega⟩ : ℝ)+
      (40 * θ - j.val) * (Data.nodes ⟨j.val + 1, by omega⟩ : ℝ) := by
  have he (i : Fin 10) : max 0 ((Data.center i : ℝ) - θ) =
      if i.val < j.val then 0 else (Data.center i : ℝ) - θ := by
    by_cases hij : i.val < j.val
    · rw [if_pos hij, max_eq_left]
      norm_num [Data.center]
      have hr : (i.val : ℝ) + 1 ≤ j.val := by exact_mod_cast Nat.succ_le_of_lt hij
      linarith
    · rw [if_neg hij, max_eq_right]
      norm_num [Data.center]
      have hr : (j.val : ℝ) ≤ i.val := by exact_mod_cast Nat.le_of_not_gt hij
      linarith
  unfold envelope
  simp_rw [he]
  fin_cases j <;> norm_num [Data.weights, Data.center, Data.nodes, Fin.sum_univ_succ] <;> ring

private theorem envelope_tail (θ : ℝ) (hθ : 1 / 4 ≤ θ) : envelope θ = 0 := by
  unfold envelope
  apply Finset.sum_eq_zero
  intro j _
  have hj : (Data.center j : ℝ) ≤ 1 / 4 := by
    fin_cases j <;> norm_num [Data.center]
  rw [max_eq_left (by linarith)]
  ring

/-- The scalar transfer estimate, uniform over all trial coordinates. -/
theorem scalar_envelope (θ t z y : ℝ) (hθ : 0 ≤ θ)
    (ht : t ∈ Set.Icc (-1 : ℝ) 1) (hz : z ∈ Set.Icc (-1 : ℝ) 1)
    (hy : y ∈ Set.Icc (-1 : ℝ) 1) :
    F t ≤ nu0 * (z - a * (1 + t)) ^ 2 + θ * (nu1 * (y - z) ^ 2 + lambda * F y) + envelope θ := by
  have hc : 0 ≤ nu1 * (y - z) ^ 2 + lambda * F y := by
    have hn1 : 0 ≤ nu1 := by norm_num [nu1, Data.nu1, Data.nu0, Data.rho,
      Data.gamma, Data.c, Data.q, Data.a, Data.b, Data.R, Data.I0, Data.v, Fin.sum_univ_succ]
    have hl : 0 ≤ lambda := by norm_num [lambda, Data.lam, Data.rho, Data.a, Data.R]
    have hf := F_nonneg y
    positivity
  by_cases htail : 1 / 4 ≤ θ
  · have hb := node_bound 10 t z y ht hz hy
    norm_num [Data.theta, Data.nodes] at hb
    rw [envelope_tail θ htail]
    nlinarith [mul_nonneg (sub_nonneg.mpr htail) hc]
  · have h40 : 0 ≤ 40 * θ := by positivity
    let j : Fin 10 := ⟨⌊40 * θ⌋₊, (Nat.floor_lt h40).mpr (by norm_num; linarith)⟩
    have hj0 : j.val / 40 ≤ θ := by have h := Nat.floor_le h40; dsimp [j]; linarith
    have hj1 : θ ≤ (j.val + 1) / 40 := by have h := Nat.lt_floor_add_one (40 * θ); dsimp [j]; linarith
    have hb0 := node_bound ⟨j.val, by omega⟩ t z y ht hz hy
    have hb1 := node_bound ⟨j.val + 1, by omega⟩ t z y ht hz hy
    have hmul0 := mul_nonneg (show 0 ≤ 1 - (40 * θ - j.val) by linarith)
      (sub_nonneg.mpr hb0)
    have hmul1 := mul_nonneg (show 0 ≤ 40 * θ - j.val by linarith)
      (sub_nonneg.mpr hb1)
    rw [cell_identity j θ hj0 hj1]
    norm_num [Data.theta] at hmul0 hmul1
    nlinarith only [hmul0, hmul1]

private theorem integral_hinge (d : ℝ) (h0 : 0 ≤ d) (h1 : d ≤ 1 / 2) :
    (∫ θ in (0 : ℝ)..(1 / 2), max 0 (d - θ)) = d ^ 2 / 2 := by
  have hcont : Continuous (fun θ : ℝ => max 0 (d - θ)) := by fun_prop
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (hcont.intervalIntegrable 0 d) (hcont.intervalIntegrable d (1 / 2))]
  have he0 : (∫ θ in (0 : ℝ)..d, max 0 (d - θ)) = ∫ θ in (0 : ℝ)..d, d - θ := by
    apply intervalIntegral.integral_congr
    intro θ hθ
    rw [Set.uIcc_of_le h0] at hθ
    exact max_eq_right (by linarith [hθ.2])
  have he1 : (∫ θ in d..(1 / 2 : ℝ), max 0 (d - θ)) = 0 := by
    calc (∫ θ in d..(1 / 2 : ℝ), max 0 (d - θ)) = ∫ θ in d..(1 / 2 : ℝ), (0 : ℝ) := by
          apply intervalIntegral.integral_congr
          intro θ hθ
          rw [Set.uIcc_of_le h1] at hθ
          exact max_eq_left (by linarith [hθ.1])
      _ = 0 := by simp
  have hs : (∫ θ in (0 : ℝ)..d, d - θ) =
      (∫ θ in (0 : ℝ)..d, d) - (∫ θ in (0 : ℝ)..d, θ) :=
    intervalIntegral.integral_sub intervalIntegrable_const (continuous_id.intervalIntegrable 0 d)
  rw [he0, he1, hs, intervalIntegral.integral_const, integral_id]
  ring

theorem envelope_integral :
    (∫ θ in (0 : ℝ)..(1 / 2), envelope θ) = 3731247 / 4000000000 := by
  unfold envelope
  rw [intervalIntegral.integral_finsetSum]
  · simp only [intervalIntegral.integral_const_mul]
    have he (j : Fin 10) : (∫ θ in (0 : ℝ)..(1 / 2), max 0 ((Data.center j : ℝ) - θ)) =
        (Data.center j : ℝ) ^ 2 / 2 := by
      apply integral_hinge <;> fin_cases j <;> norm_num [Data.center]
    simp only [he]
    norm_num [Data.center, Data.weights, Fin.sum_univ_succ]
  · intro j _
    exact (by fun_prop : Continuous (fun θ : ℝ =>
      (Data.weights j : ℝ) * max 0 ((Data.center j : ℝ) - θ))).intervalIntegrable 0 (1 / 2)

/-- The strict scalar budget in the insertion induction. -/
theorem closing_budget :
    U - r - rho * c * I / (2 * a) + (∫ θ in (0 : ℝ)..(1 / 2), envelope θ) < -1 / 1000000 := by
  rw [envelope_integral]
  norm_num [U, r, rho, c, I, a, Data.U, Data.r, Data.R, Data.rho, Data.c,
    Data.I, Data.a, Data.v, Fin.sum_univ_succ]

#print axioms F_lipschitz
#print axioms numerical_conditions
#print axioms scalar_envelope
#print axioms closing_budget
end
