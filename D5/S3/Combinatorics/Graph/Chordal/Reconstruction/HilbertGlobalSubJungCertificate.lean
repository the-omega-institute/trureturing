  deriving DecidableEq

def side (l h x d : ℚ) : Prop := (x = l ∧ 0 ≤ d) ∨ (x = h ∧ d ≤ 0) ∨ d = 0
instance (l h x d : ℚ) : Decidable (side l h x d) := by unfold side; infer_instance

def value (k : Fin 11) (i j : Fin 7) (x : Point) : ℚ :=
  nodes k - (pieces i).at x.t + nu0 * (x.z - a * (1 + x.t)) ^ 2+
    theta k * (nu1 * (x.y - x.z) ^ 2 + lam * (lower i j).at x.y)
def dt (i : Fin 7) (x : Point) : ℚ :=
  -(pieces i).m - 2 * (pieces i).s * x.t - 2 * a * nu0 * (x.z - a * (1 + x.t))
def dz (k : Fin 11) (x : Point) : ℚ :=
  2 * nu0 * (x.z - a * (1 + x.t)) - 2 * theta k * nu1 * (x.y - x.z)
def dy (k : Fin 11) (i j : Fin 7) (x : Point) : ℚ :=
  2 * theta k * nu1 * (x.y - x.z) + theta k * lam * ((lower i j).m + 2 * (lower i j).s * x.y)
def check (k : Fin 11) (i j : Fin 7) (x : Point) : Prop :=
  0 ≤ value k i j x ∧ side (pieces i).lo (pieces i).hi x.t (dt i x) ∧
    side (-1) 1 x.z (dz k x) ∧ side (lower i j).lo (lower i j).hi x.y (dy k i j x)
instance (k : Fin 11) (i j : Fin 7) (x : Point) : Decidable (check k i j x) :=
  by unfold check; infer_instance

