private lemma natural_profile_of_enat {I : Type*} (D : I → I → Nat) (x : I → ℕ∞)
    (hmax : ∀ i, x i ≤ 2) (hA : ∀ i, 1 ≤ x i)
    (hB : ∀ j, ∃ i, x i < upperOfCode D i j)
    (hC : ∀ i j, x i ≤ upperOfCode D i j + x j) :
    ∃ y : I → Nat, (∀ i, (y i : ℕ∞) = x i) ∧
      (∀ i, y i ≤ 2) ∧ (∀ i, 1 ≤ y i) ∧
      (∀ j, ∃ i, y i < D i j) ∧ (∀ i j, y i ≤ D i j + y j) := by
  have hfinite : ∀ i, x i ≠ ⊤ := fun i =>
    ne_top_of_lt ((hmax i).trans_lt (ENat.natCast_lt_top 2))
  let y : I → Nat := fun i => (x i).toNat
  have hy : ∀ i, (y i : ℕ∞) = x i := fun i => ENat.natCast_toNat (hfinite i)
  have hymax : ∀ i, y i ≤ 2 := fun i => ENat.toNat_le_of_le_natCast (hmax i)
  refine ⟨y, hy, hymax, ?_, ?_, ?_⟩
  · intro i
    have h := hA i
    rw [← hy i] at h
    exact ENat.natCast_le_natCast.mp h
  · intro j
    obtain ⟨i, hi⟩ := hB j
    refine ⟨i, ?_⟩
    by_cases hd : D i j = 8
    · rw [hd]
      exact (hymax i).trans_lt (by decide : 2 < 8)
    · simp only [upperOfCode, hd, if_false] at hi
      rw [← hy i] at hi
      exact ENat.natCast_lt_natCast.mp hi
  · intro i j
    by_cases hd : D i j = 8
    · rw [hd]
      have h := hymax i
      omega
    · have h := hC i j
      simp only [upperOfCode, hd, if_false] at h
      rw [← hy i, ← hy j] at h
      exact ENat.natCast_le_natCast.mp (by simpa only [ENat.natCast_add] using h)

lemma strong_enat_profile_bound {k : Nat} (D : Fin k → Fin k → Nat)
    (hD : ∀ i j, D i j ≤ 4) (j₀ : Fin k)
    (natBound : ∀ y : Fin k → Nat, (∀ i, 1 ≤ y i) →
      (∀ j, ∃ i, y i < D i j) → (∀ i j, y i ≤ D i j + y j) → ∀ i, y i ≤ 2)
    (x : Fin k → ℕ∞) (hA : ∀ i, 1 ≤ x i)
    (hB : ∀ j, ∃ i, x i < upperOfCode D i j)
    (hC : ∀ i j, x i ≤ upperOfCode D i j + x j) : ∀ i, x i ≤ 2 := by
  have hnot : ∀ i j, D i j ≠ 8 := fun i j => by have := hD i j; omega
  have hB' : ∀ j, ∃ i, x i < (D i j : ℕ∞) := by
    intro j
    obtain ⟨i, hi⟩ := hB j
    exact ⟨i, by simpa only [upperOfCode, hnot i j, if_false] using hi⟩
  have hC' : ∀ i j, x i ≤ (D i j : ℕ∞) + x j := by
    intro i j
    simpa only [upperOfCode, hnot i j, if_false] using hC i j
  obtain ⟨y, hy, _⟩ := profile_finite_bound D hD j₀ x hB' hC'
  have hYA : ∀ i, 1 ≤ y i := by
    intro i
    have h := hA i
    rw [← hy i] at h
    exact ENat.natCast_le_natCast.mp h
  have hYB : ∀ j, ∃ i, y i < D i j := by
    intro j
    obtain ⟨i, hi⟩ := hB' j
    rw [← hy i] at hi
    exact ⟨i, ENat.natCast_lt_natCast.mp hi⟩
  have hYC : ∀ i j, y i ≤ D i j + y j := by
    intro i j
    have h := hC' i j
    rw [← hy i, ← hy j, ← ENat.natCast_add] at h
    exact ENat.natCast_le_natCast.mp h
  intro i
  rw [← hy i]
  exact ENat.natCast_le_natCast.mpr (natBound y hYA hYB hYC i)


lemma card_bound_of_profile_model {V : Type uSolid} [Fintype V]
    {k c : Nat} (R : V → V → Prop) (L : Fin k → V)
    (hL : Function.Injective L) (hS : IsSolidResolving R (Set.range L))
    (D : Fin k → Fin k → Nat)
    (hDist : ∀ i j, directedDistance R (L i) (L j) ≤ upperOfCode D i j)
    (hBound : ∀ x : Fin k → ℕ∞, (∀ i, 1 ≤ x i) →
      (∀ j, ∃ i, x i < upperOfCode D i j) →
      (∀ i j, x i ≤ upperOfCode D i j + x j) → ∀ i, x i ≤ 2)
    (hWidth : ∀ {U : Type uSolid} [Fintype U] (f : U → Fin k → Nat),
      (∀ u i, f u i ≤ 2) → (∀ u i, 1 ≤ f u i) →
      (∀ u j, ∃ i, f u i < D i j) →
      (∀ u i j, f u i ≤ D i j + f u j) →
      (∀ ⦃u v : U⦄, u ≠ v → ¬ f u ≤ f v ∧ ¬ f v ≤ f u) →
      Fintype.card U ≤ c) : Fintype.card V ≤ k+c := by
  classical
  let U := {v // v ∉ Set.range L}
  let x : U → Fin k → ℕ∞ := fun u i => directedDistance R (L i) u.val
  have hCon (u : U) := profile_constraints R L hS u.property (upperOfCode D) hDist
  have hMax (u : U) : ∀ i, x u i ≤ 2 :=
    hBound (x u) (hCon u).1 (hCon u).2.1 (hCon u).2.2
  let W (u : U) := natural_profile_of_enat D (x u) (hMax u)
    (hCon u).1 (hCon u).2.1 (hCon u).2.2
  let f : U → Fin k → Nat := fun u => Classical.choose (W u)
  have hf (u : U) : (∀ i, (f u i : ℕ∞) = x u i) ∧
      (∀ i, f u i ≤ 2) ∧ (∀ i, 1 ≤ f u i) ∧
      (∀ j, ∃ i, f u i < D i j) ∧ (∀ i j, f u i ≤ D i j + f u j) :=
    Classical.choose_spec (W u)
  have hAnti : ∀ ⦃u v : U⦄, u ≠ v → ¬ f u ≤ f v ∧ ¬ f v ≤ f u := by
    intro u v huv
    have hne : u.val ≠ v.val := fun h => huv (Subtype.ext h)
    have hord := (solid_iff_ordered R (Set.range L)).mp hS
    obtain ⟨a, ha, hlt⟩ := hord hne.symm
    obtain ⟨b, hb, hlt'⟩ := hord hne
    obtain ⟨i, rfl⟩ := ha
    obtain ⟨j, rfl⟩ := hb
    have hltN : f v i < f u i := ENat.natCast_lt_natCast.mp (by
      rw [(hf v).1 i, (hf u).1 i]; exact hlt)
    have hltN' : f u j < f v j := ENat.natCast_lt_natCast.mp (by
      rw [(hf u).1 j, (hf v).1 j]; exact hlt')
    exact ⟨fun h => (not_le_of_gt hltN) (h i), fun h => (not_le_of_gt hltN') (h j)⟩
  have hOutside : Fintype.card U ≤ c := hWidth f (fun u => (hf u).2.1)
    (fun u => (hf u).2.2.1) (fun u => (hf u).2.2.2.1)
    (fun u => (hf u).2.2.2.2) hAnti
  have hRange : Fintype.card (Set.range L) = k := by
    simpa using (Fintype.card_congr (Equiv.ofInjective L hL)).symm
  have hSmall : k ≤ Fintype.card V := by
    simpa using Fintype.card_le_of_injective L hL
  have hComp : Fintype.card U = Fintype.card V-k := by
    simpa only [U, Fintype.card_subtype_compl, hRange]
      using (Fintype.card_subtype_compl (fun v => v ∈ Set.range L))
  omega

