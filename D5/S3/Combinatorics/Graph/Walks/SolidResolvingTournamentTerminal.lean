private theorem non_certificate_3_0 :
    (enumTuple (List.finRange 3) 3).all (fun x => !acBool nonD30 x || decide (x ∈ nonChains30.flatten)) = true ∧
    nonChains30.all (fun ch => decide (ch.Pairwise (fun x y => x ≤ y ∨ y ≤ x))) = true ∧ nonChains30.length ≤ 1 := by decide

theorem nonstrong_antichain_bound_3_0 {U : Type*} [Fintype U]
    (f : U → Fin 3 → Nat) (hmax : ∀ u i, f u i ≤ 2)
    (hA : ∀ u i, 1 ≤ f u i)
    (hB : ∀ u j, ∃ i, f u i < nonD30 i j)
    (hC : ∀ u i j, f u i ≤ nonD30 i j + f u j)
    (anti : ∀ ⦃u v : U⦄, u ≠ v → ¬ f u ≤ f v ∧ ¬ f v ≤ f u) :
    Fintype.card U ≤ 1 := by
  have hc := non_certificate_3_0
  apply (cardinal_le_profile_chains f nonChains30 ?_ ?_ anti).trans hc.2.2
  · intro u
    exact profile_mem_of_certificate nonD30 nonChains30.flatten hc.1 (f u)
      (fun i => Nat.lt_succ_iff.mpr (hmax u i)) (hA u) (hB u) (hC u)
  · intro ch hch
    have hp := of_decide_eq_true ((List.all_eq_true.mp hc.2.1) ch hch)
    have hflip := hp.imp (fun h => h.symm)
    have hr : ∀ z ∈ ch, z ≤ z ∨ z ≤ z := fun z _ => Or.inl le_rfl
    intro a ha b hb
    exact List.Pairwise.forall_of_forall_of_flip hr hp hflip ha hb

