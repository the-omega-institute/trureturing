private lemma no_profile_terminal_singleton {k : Nat} (D : Fin k → Fin k → ℕ∞)
    (c : Fin k) (hc : ∀ i, D i c ≤ 1) (x : Fin k → ℕ∞)
    (hA : ∀ i, 1 ≤ x i) (hB : ∀ j, ∃ i, x i < D i j) : False := by
  obtain ⟨i, hi⟩ := hB c
  exact (not_lt_of_ge (hA i)) (hi.trans_le (hc i))

private lemma profile_forced_one {I : Type*} (D : I → I → ℕ∞) (x : I → ℕ∞)
    (a t : I) (hA : ∀ i, 1 ≤ x i)
    (hB : ∃ i, x i < D i t) (ha : D a t ≤ 2)
    (hother : ∀ i, i ≠ a → D i t ≤ 1) : x a = 1 := by
  obtain ⟨i, hi⟩ := hB
  have hia : i = a := by
    by_contra hne
    exact (not_lt_of_ge (hA i)) (hi.trans_le (hother i hne))
  subst i
  have hlt : x a < 2 := hi.trans_le ha
  let n := (x a).toNat
  have hn : (n : ℕ∞) = x a := ENat.natCast_toNat (ne_top_of_lt hlt)
  have hpos := hA a
  rw [← hn] at hpos hlt
  have hnpos : 1 ≤ n := by exact_mod_cast hpos
  have hnlt : n < 2 := by exact_mod_cast hlt
  have hn1 : n = 1 := by omega
  simpa only [hn1, Nat.cast_one] using hn.symm

private lemma profile_le_two_of_terminal {I : Type*} (D : I → I → ℕ∞)
    (x : I → ℕ∞) (a : I) (ha : x a = 1)
    (hC : ∀ i j, x i ≤ D i j + x j)
    (hcol : ∀ i, x i = 1 ∨ D i a ≤ 1) : ∀ i, x i ≤ 2 := by
  intro i
  rcases hcol i with hi | hi
  · rw [hi]; norm_num
  · calc
      x i ≤ D i a + x a := hC i a
      _ ≤ 1+1 := add_le_add hi (le_of_eq ha)
      _ = 2 := by norm_num

def upperOfCode {I : Type*} (D : I → I → Nat) (i j : I) : ℕ∞ :=
  if D i j = 8 then ⊤ else (D i j : ℕ∞)

def nonD30 : Fin 3 → Fin 3 → Nat := ![![0,8,8],![1,0,8],![1,1,0]]

theorem nonstrong_profile_bound_3_0 (x : Fin 3 → ℕ∞)
    (hA : ∀ i, 1 ≤ x i)
    (hB : ∀ j, ∃ i, x i < upperOfCode nonD30 i j) : ∀ i, x i ≤ 2 := by
  exfalso
  exact no_profile_terminal_singleton (upperOfCode nonD30) 0
    (by intro i; fin_cases i <;> norm_num [upperOfCode, nonD30]) x hA hB

