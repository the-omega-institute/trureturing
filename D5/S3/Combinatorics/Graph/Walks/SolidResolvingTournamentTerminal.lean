def nonD42 : Fin 4 → Fin 4 → Nat := ![![0,2,1,8],![1,0,2,8],![2,1,0,8],![1,1,1,0]]

theorem nonstrong_profile_bound_4_2 (x : Fin 4 → ℕ∞)
    (hA : ∀ i, 1 ≤ x i)
    (hB : ∀ j, ∃ i, x i < upperOfCode nonD42 i j)
    (hC : ∀ i j, x i ≤ upperOfCode nonD42 i j + x j) : ∀ i, x i ≤ 2 := by
