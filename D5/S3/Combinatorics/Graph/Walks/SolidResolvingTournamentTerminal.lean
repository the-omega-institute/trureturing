  have hx1 : x 1 = 1 := profile_forced_one (upperOfCode nonD42) x 1 2
    hA (hB 2) (by norm_num [upperOfCode, nonD42])
    (by intro i hi; fin_cases i <;> simp_all [upperOfCode, nonD42])
  have hx2 : x 2 = 1 := profile_forced_one (upperOfCode nonD42) x 2 0
    hA (hB 0) (by norm_num [upperOfCode, nonD42])
    (by intro i hi; fin_cases i <;> simp_all [upperOfCode, nonD42])
  apply profile_le_two_of_terminal (upperOfCode nonD42) x 0 hx0 hC
  intro i
  fin_cases i
  · exact Or.inl hx0
  · exact Or.inl hx1
  · exact Or.inl hx2
  · exact Or.inr (by norm_num [upperOfCode, nonD42])

