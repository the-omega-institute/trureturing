    (hr : ∀ i, q (p i) = i)
    (he : ∀ u v, P5.Adj u v ↔ s(p u, p v) ∈ S ∧ p u ≠ p v) :
    endpointGraph S ≃g P5 where
  toEquiv :=
    { toFun := fun v => q v.val
      invFun := fun i => ⟨p i, hp i⟩
      left_inv := fun v => Subtype.ext (hl v.val v.property)
      right_inv := hr }
  map_rel_iff' := by
    intro u v
    change P5.Adj (q u.val) (q v.val) ↔ s(u.val, v.val) ∈ S ∧ u.val ≠ v.val
    rw [he, hl u.val u.property, hl v.val v.property]

private theorem no_p5_of_card {n : ℕ} (S : Finset (Sym2 (Fin n)))
    (hc : (endpointSet S).card ≠ 5) : ¬ Nonempty (endpointGraph S ≃g P5) := by
  rintro ⟨f⟩
  exact hc (endpoint_iso_card S P5 f)

private theorem no_p5_of_three {n : ℕ} (S : Finset (Sym2 (Fin n)))
    (v a b c : Fin n) (hv : v ∈ endpointSet S)
    (ha : a ∈ endpointSet S) (hb : b ∈ endpointSet S) (hc : c ∈ endpointSet S)
    (hva : s(v,a) ∈ S ∧ v ≠ a) (hvb : s(v,b) ∈ S ∧ v ≠ b)
    (hvc : s(v,c) ∈ S ∧ v ≠ c) (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    ¬ Nonempty (endpointGraph S ≃g P5) := by
  rintro ⟨f⟩
  apply P5_no_three (f ⟨v,hv⟩) (f ⟨a,ha⟩) (f ⟨b,hb⟩) (f ⟨c,hc⟩)
    (f.map_rel_iff.mpr hva) (f.map_rel_iff.mpr hvb) (f.map_rel_iff.mpr hvc)
  · exact fun h => hab (congrArg Subtype.val (f.injective h))
  · exact fun h => hac (congrArg Subtype.val (f.injective h))
  · exact fun h => hbc (congrArg Subtype.val (f.injective h))

