attribute [local instance 10000] Finset.decidableDforallFinset

def independenceComplex {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] :
    Finset (Finset (Fin n)) :=
  (D5.S3.StatisticalMechanics.HardCore.IndependentPartitionDeletion.configurations G univ).filter
    Finset.Nonempty

/- Covering pairs of the nonempty face poset. -/
def coveringPairs {n : ℕ} (F : Finset (Finset (Fin n))) : Finset (Finset (Fin n) × Finset (Fin n)) :=
  (F ×ˢ F).filter fun p => p.1 ⊂ p.2 ∧ p.2.card = p.1.card + 1

/- Two pairs can coexist precisely when all their faces are distinct. -/
def Compatible {α : Type} [DecidableEq α] (p q : α × α) : Prop :=
  p.1 ≠ q.1 ∧ p.1 ≠ q.2 ∧ p.2 ≠ q.1 ∧ p.2 ≠ q.2

private instance {α : Type} [DecidableEq α] : DecidableRel (@Compatible α _) := fun _ _ => inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

/- A topological ranking certificate for the reversed Hasse diagram. -/
def Acyclic {α : Type} (S : Finset α) (R : α → α → Prop) : Prop :=
  ∃ rank : α → ℕ, ∀ a ∈ S, ∀ b ∈ S, R a b → rank a < rank b

/- All face-disjoint covering-pair subsets with an acyclic reversed Hasse diagram. -/
noncomputable def acyclicMatchings {α : Type} [DecidableEq α]
    (F : Finset α) (C : Finset (α × α)) : Finset (Finset (α × α)) := by
  classical
  exact C.powerset.filter fun M =>
    (∀ p ∈ M, ∀ q ∈ M, p ≠ q → Compatible p q) ∧
    Acyclic F (fun a b => (a,b) ∈ M ∨ ((b,a) ∈ C ∧ (b,a) ∉ M))

def Critical {n : ℕ} (M : Finset (Finset (Fin n) × Finset (Fin n))) (s : (Finset (Fin n))) : Prop :=
  ∀ p ∈ M, s ≠ p.1 ∧ s ≠ p.2

private instance {n : ℕ} (M : Finset (Finset (Fin n) × Finset (Fin n))) (s : (Finset (Fin n))) : Decidable (Critical M s) :=
  inferInstanceAs (Decidable (∀ p ∈ M, _))

/- The largest face size, hence alpha for an independence complex. -/
def alpha {n : ℕ} (F : Finset (Finset (Fin n))) : ℕ := F.sup Finset.card

/- Critical i-simplices have cardinality i+1. -/
def criticalCount {n : ℕ} (F : Finset (Finset (Fin n))) (M : Finset (Finset (Fin n) × Finset (Fin n))) (i : ℕ) : ℕ :=
  (F.filter fun s => s.card = i+1 ∧ Critical M s).card

/- The dimensions are exactly 0 through alpha-1; the empty complex has the empty vector. -/
def morseVector {n : ℕ} (F : Finset (Finset (Fin n))) (M : Finset (Finset (Fin n) × Finset (Fin n))) : List ℕ :=
  (List.range (alpha F)).map (criticalCount F M)

/- Each acyclic matching contributes one to its entire Morse vector's coefficient. -/
noncomputable def ensemble {n : ℕ} (F : Finset (Finset (Fin n))) (C : Finset (Finset (Fin n) × Finset (Fin n))) : (List ℕ) →₀ ℕ :=
  ∑ M ∈ acyclicMatchings F C, Finsupp.single (morseVector F M) 1

noncomputable def Phi {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] : (List ℕ) →₀ ℕ :=
  ensemble (independenceComplex G) (coveringPairs (independenceComplex G))

/- Proper colourings counted as actual functions, with no quotient by colour permutations. -/
def chromaticCount {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] (k : ℕ) : ℕ :=
  (univ.filter fun c : Fin n → Fin k => ∀ a b, G.Adj a b → c a ≠ c b).card

noncomputable def claim : Prop := by
  classical
  exact ∀ (n m : ℕ) (G : SimpleGraph (Fin n)) (H : SimpleGraph (Fin m)),
    Phi G = Phi H → ∀ k : ℕ, chromaticCount G k = chromaticCount H k

