  inferInstanceAs (Decidable (∀ c ∈ B, _))

/- Exhaustive certificate normalization uses a finite elaboration budget. -/
set_option maxHeartbeats 4000000 in
theorem result : ¬ claim := by
  have independence_eq {n : ℕ} (G : SimpleGraph (Fin n)) [DecidableRel G.Adj] :
      independenceComplex G = (univ : Finset (Finset (Fin n))).filter
        (fun s : Finset (Fin n) => s.Nonempty ∧ G.IsIndepSet (s : Set (Fin n))) := by
    ext s
    simp only [independenceComplex,
      D5.S3.StatisticalMechanics.HardCore.IndependentPartitionDeletion.configurations,
      mem_filter, mem_powerset, subset_univ, true_and, mem_univ]
    exact and_comm
  have fst_image_card {n : ℕ} (M : Finset (Finset (Fin n) × Finset (Fin n))) (hm : ({p | p ∈ M} : Set _).Pairwise Compatible) :
      (M.image Prod.fst).card = M.card := by
    apply card_image_of_injOn
    intro p hp q hq he
    by_contra hn
    exact (@hm p hp q hq hn).1 he
  have snd_image_card {n : ℕ} (M : Finset (Finset (Fin n) × Finset (Fin n))) (hm : ({p | p ∈ M} : Set _).Pairwise Compatible) :
      (M.image Prod.snd).card = M.card := by
    apply card_image_of_injOn
    intro p hp q hq he
    by_contra hn
    exact (@hm p hp q hq hn).2.2.2 he
  have critical_vertex_count {n : ℕ} (F : Finset (Finset (Fin n))) (M : Finset (Finset (Fin n) × Finset (Fin n)))
      (hm : ({p | p ∈ M} : Set _).Pairwise Compatible)
      (hp : ∀ p ∈ M, p.1 ∈ F ∧ p.1.card = 1 ∧ p.2.card = 2) :
      criticalCount F M 0 = (F.filter fun s => s.card = 1).card - M.card := by
    have hs : M.image Prod.fst ⊆ F.filter (fun s => s.card = 1) := by
      intro s h
      obtain ⟨p, hpm, rfl⟩ := mem_image.mp h
      exact mem_filter.mpr ⟨(hp p hpm).1, (hp p hpm).2.1⟩
    have he : F.filter (fun s => s.card = 1 ∧ Critical M s) =
        (F.filter fun s => s.card = 1) \ M.image Prod.fst := by
      ext s
      simp only [mem_filter, mem_sdiff, mem_image]
      constructor
      · rintro ⟨hF, hd, hc⟩
        refine ⟨⟨hF, hd⟩, ?_⟩
        rintro ⟨p, hpm, he⟩
        exact (hc p hpm).1 he.symm
      · rintro ⟨⟨hF, hd⟩, hc⟩
        refine ⟨hF, hd, ?_⟩
        intro p hpm
        refine ⟨fun he => hc ⟨p, hpm, he.symm⟩, ?_⟩
        intro he
        have htwo := (hp p hpm).2.2
        rw [← he] at htwo
        omega
    change (F.filter (fun s => s.card = 1 ∧ Critical M s)).card = _
    rw [he, card_sdiff, inter_eq_left.mpr hs, fst_image_card M hm]
  have critical_edge_count {n : ℕ} (F : Finset (Finset (Fin n))) (M : Finset (Finset (Fin n) × Finset (Fin n)))
      (hm : ({p | p ∈ M} : Set _).Pairwise Compatible)
      (hp : ∀ p ∈ M, p.2 ∈ F ∧ p.1.card = 1 ∧ p.2.card = 2) :
      criticalCount F M 1 = (F.filter fun s => s.card = 2).card - M.card := by
    have hs : M.image Prod.snd ⊆ F.filter (fun s => s.card = 2) := by
      intro s h
      obtain ⟨p, hpm, rfl⟩ := mem_image.mp h
      exact mem_filter.mpr ⟨(hp p hpm).1, (hp p hpm).2.2⟩
    have he : F.filter (fun s => s.card = 2 ∧ Critical M s) =
        (F.filter fun s => s.card = 2) \ M.image Prod.snd := by
      ext s
      simp only [mem_filter, mem_sdiff, mem_image]
      constructor
      · rintro ⟨hF, hd, hc⟩
        refine ⟨⟨hF, hd⟩, ?_⟩
        rintro ⟨p, hpm, he⟩
        exact (hc p hpm).2 he.symm
      · rintro ⟨⟨hF, hd⟩, hc⟩
        refine ⟨hF, hd, ?_⟩
        intro p hpm
        refine ⟨?_, fun he => hc ⟨p, hpm, he.symm⟩⟩
        intro he
        have hone := (hp p hpm).2.1
        rw [← he] at hone
        omega
    change (F.filter (fun s => s.card = 2 ∧ Critical M s)).card = _
    rw [he, card_sdiff, inter_eq_left.mpr hs, snd_image_card M hm]
  have vector_one_dimensional {n : ℕ} (F : Finset (Finset (Fin n))) (C : Finset (Finset (Fin n) × Finset (Fin n)))
      (ha : alpha F = 2)
      (h0 : (F.filter fun s => s.card = 1).card = 8)
      (h1 : (F.filter fun s => s.card = 2).card = 8)
      (hp : ∀ p ∈ C, p.1 ∈ F ∧ p.2 ∈ F ∧ p.1.card = 1 ∧ p.2.card = 2)
      (M : Finset (Finset (Fin n) × Finset (Fin n))) (hm : M ∈ acyclicMatchings F C) :
      morseVector F M = [8-M.card, 8-M.card] := by
    obtain ⟨hs, hpair, _⟩ := by
      simpa only [acyclicMatchings, mem_filter, mem_powerset, and_assoc] using hm
    have hlow : criticalCount F M 0 = 8-M.card := by
      rw [critical_vertex_count F M hpair (fun p h => ⟨(hp p (hs h)).1,
        (hp p (hs h)).2.2.1, (hp p (hs h)).2.2.2⟩), h0]
    have hupp : criticalCount F M 1 = 8-M.card := by
      rw [critical_edge_count F M hpair (fun p h => ⟨(hp p (hs h)).2.1,
        (hp p (hs h)).2.2.1, (hp p (hs h)).2.2.2⟩), h1]
    simp only [morseVector, ha, List.range_succ, List.range_zero, List.map_cons, List.map_nil, List.nil_append, List.cons_append, hlow, hupp]
  have ensemble_equal_of_size_counts {n m : ℕ} (F : Finset (Finset (Fin n)))
      (C : Finset (Finset (Fin n) × Finset (Fin n))) (F' : Finset ((Finset (Fin m)))) (C' : Finset ((Finset (Fin m) × Finset (Fin m))))
      (hv : ∀ M ∈ acyclicMatchings F C, morseVector F M = [8-M.card,8-M.card])
      (hv' : ∀ M ∈ acyclicMatchings F' C', morseVector F' M = [8-M.card,8-M.card])
      (hb : ∀ M ∈ acyclicMatchings F C, M.card < 9)
      (hb' : ∀ M ∈ acyclicMatchings F' C', M.card < 9)
      (hc : ∀ r < 9,
        ((acyclicMatchings F C).filter fun M => M.card = r).card =
        ((acyclicMatchings F' C').filter fun M => M.card = r).card) :
      ensemble F C = ensemble F' C' := by
    classical
    ext v
    simp only [ensemble, Finsupp.coe_finsetSum, Finset.sum_apply]
    rw [← sum_fiberwise_of_maps_to (fun M hm => mem_range.mpr (hb M hm)),
      ← sum_fiberwise_of_maps_to (fun M hm => mem_range.mpr (hb' M hm))]
    apply sum_congr rfl
    intro r hr
    have he : (∑ M ∈ (acyclicMatchings F C).filter (fun M => M.card = r),
        (Finsupp.single (morseVector F M) 1 : (List ℕ) →₀ ℕ) v) =
        ((acyclicMatchings F C).filter fun M => M.card = r).card *
          (Finsupp.single [8-r,8-r] 1 : (List ℕ) →₀ ℕ) v := by
      apply sum_const_nat
      intro M hm
      obtain ⟨hM, hcard⟩ := mem_filter.mp hm
      rw [hv M hM, hcard]
    have he' : (∑ M ∈ (acyclicMatchings F' C').filter (fun M => M.card = r),
        (Finsupp.single (morseVector F' M) 1 : (List ℕ) →₀ ℕ) v) =
        ((acyclicMatchings F' C').filter fun M => M.card = r).card *
          (Finsupp.single [8-r,8-r] 1 : (List ℕ) →₀ ℕ) v := by
      apply sum_const_nat
      intro M hm
      obtain ⟨hM, hcard⟩ := mem_filter.mp hm
      rw [hv' M hM, hcard]
    rw [he, he', hc r (mem_range.mp hr)]
  have matching_size_bound {n : ℕ} (F : Finset (Finset (Fin n))) (C : Finset (Finset (Fin n) × Finset (Fin n)))
      (h0 : (F.filter fun s => s.card = 1).card = 8)
      (hp : ∀ p ∈ C, p.1 ∈ F ∧ p.1.card = 1)
      (M : Finset (Finset (Fin n) × Finset (Fin n))) (hm : M ∈ acyclicMatchings F C) : M.card < 9 := by
    obtain ⟨hs, hpair, _⟩ := by
      simpa only [acyclicMatchings, mem_filter, mem_powerset, and_assoc] using hm
    have hsub : M.image Prod.fst ⊆ F.filter (fun s => s.card = 1) := by
      intro s h
      obtain ⟨p,hpM,rfl⟩ := mem_image.mp h
      exact mem_filter.mpr (hp p (hs hpM))
    have hle := card_le_card hsub
    rw [fst_image_card M hpair, h0] at hle
    omega
  have chromaticCount_pos_iff {n : ℕ} (G : SimpleGraph (Fin n))
      [DecidableRel G.Adj] (k : ℕ) : 0 < chromaticCount G k ↔ G.Colorable k := by
    rw [chromaticCount, card_pos]
    constructor
    · rintro ⟨c,hc⟩
      exact ⟨SimpleGraph.Coloring.mk c (fun {a b} hab => (mem_filter.mp hc).2 a b hab)⟩
    · rintro ⟨c⟩
      exact ⟨c, mem_filter.mpr ⟨mem_univ _, fun a b => c.valid⟩⟩
  have coloring1_valid : ∀ a b, G1.Adj a b → coloring1 a ≠ coloring1 b := by decide +kernel
  have chromatic1_pos : 0 < chromaticCount G1 4 := by
    apply (chromaticCount_pos_iff G1 4).mpr
    exact ⟨SimpleGraph.Coloring.mk coloring1 (fun {a b} => coloring1_valid a b)⟩
  have clique2 : G2.IsClique (({1,3,4,5,6} : Finset (Fin 8)) : Set (Fin 8)) := by decide +kernel
  have chromatic2_zero : chromaticCount G2 4 = 0 := by
    by_contra hn
    have hc : G2.Colorable 4 := (chromaticCount_pos_iff G2 4).mp (Nat.pos_of_ne_zero hn)
    have hh := clique2.card_le_of_colorable hc
    have he : ({1,3,4,5,6} : Finset (Fin 8)).card = 5 := by decide +kernel
    rw [he] at hh
    omega
  have pairMap_injective {α β : Type} {f : α → β} (hf : Function.Injective f) :
      Function.Injective ((Prod.map f f)) := by
    intro p q h
    apply Prod.ext
    · exact hf (congrArg Prod.fst h)
    · exact hf (congrArg Prod.snd h)
  have compatible_map_iff {α β : Type} [DecidableEq α] [DecidableEq β]
      {f : α → β} (hf : Function.Injective f) (p q : α × α) :
      Compatible ((Prod.map f f) p) ((Prod.map f f) q) ↔ Compatible p q := by
    simp only [Compatible, Prod.map, hf.ne_iff]
  have pairwise_image_iff {α β : Type} [DecidableEq α] [DecidableEq β]
      {f : α → β} (hf : Function.Injective f) (M : Finset (α × α)) :
      ({p | p ∈ M.image (Prod.map f f)} : Set _).Pairwise Compatible ↔ ({p | p ∈ M} : Set _).Pairwise Compatible := by
    constructor
    · intro h p hp q hq hpq
      apply (compatible_map_iff hf p q).mp
      exact @h _ (mem_image_of_mem _ hp) _ (mem_image_of_mem _ hq)
        (fun he => hpq (pairMap_injective hf he))
    · intro h p hp q hq hpq
      obtain ⟨p,hps,rfl⟩ := mem_image.mp hp
      obtain ⟨q,hqs,rfl⟩ := mem_image.mp hq
      apply (compatible_map_iff hf p q).mpr
      exact @h p hps q hqs (fun he => hpq (congrArg ((Prod.map f f)) he))
  have acyclic_image_iff {α β : Type} [DecidableEq α] [DecidableEq β]
      [Nonempty α] {f : α → β} (hf : Function.Injective f) (S : Finset α)
      (R : β → β → Prop) :
      Acyclic (S.image f) R ↔ Acyclic S (fun a b => R (f a) (f b)) := by
    constructor
    · rintro ⟨rank,hr⟩
      exact ⟨rank ∘ f, fun a ha b hb => hr _ (mem_image_of_mem _ ha) _ (mem_image_of_mem _ hb)⟩
    · classical
      rintro ⟨rank,hr⟩
      refine ⟨rank ∘ Function.invFun f, ?_⟩
      intro a ha b hb hab
      obtain ⟨a,has,rfl⟩ := mem_image.mp ha
      obtain ⟨b,hbs,rfl⟩ := mem_image.mp hb
      change rank (Function.invFun f (f a)) < rank (Function.invFun f (f b))
      rw [Function.leftInverse_invFun hf a, Function.leftInverse_invFun hf b]
      exact hr a has b hbs hab
  have edge_map_mem_iff {α β : Type} [DecidableEq α] [DecidableEq β]
      {f : α → β} (hf : Function.Injective f) (C : Finset (α × α)) (a b : α) :
      (f a,f b) ∈ C.image ((Prod.map f f)) ↔ (a,b) ∈ C := by
    rw [mem_image]
    constructor
    · rintro ⟨p,hp,he⟩
      have he' : p = (a,b) := pairMap_injective hf (show (Prod.map f f) p = (Prod.map f f) (a,b) from he)
      exact he' ▸ hp
    · intro h; exact ⟨(a,b),h,rfl⟩
  have acyclic_matching_image_iff {α β : Type} [DecidableEq α] [DecidableEq β]
      [Nonempty α] {f : α → β} (hf : Function.Injective f)
      (F : Finset α) (C M : Finset (α × α)) :
      M.image ((Prod.map f f)) ∈ acyclicMatchings (F.image f) (C.image ((Prod.map f f))) ↔
      M ∈ acyclicMatchings F C := by
    classical
    simp only [acyclicMatchings, mem_filter, mem_powerset]
    change (_ ∧ ({p | p ∈ M.image (Prod.map f f)} : Set _).Pairwise Compatible ∧ _) ↔
      (_ ∧ ({p | p ∈ M} : Set _).Pairwise Compatible ∧ _)
    rw [image_subset_image_iff (pairMap_injective hf), pairwise_image_iff hf]
    rw [acyclic_image_iff hf]
    simp only [edge_map_mem_iff hf]
  have acyclic_matchings_image {α β : Type} [DecidableEq α] [DecidableEq β]
      [Nonempty α] {f : α → β} (hf : Function.Injective f)
      (F : Finset α) (C : Finset (α × α)) :
      acyclicMatchings (F.image f) (C.image ((Prod.map f f))) =
        (acyclicMatchings F C).image (fun M => M.image ((Prod.map f f))) := by
    classical
    ext M
    constructor
    · intro hM
      have hs : M ∈ (C.image ((Prod.map f f))).powerset := by
        exact (mem_filter.mp hM).1
      rw [powerset_image] at hs
      obtain ⟨K,hK,rfl⟩ := mem_image.mp hs
      exact mem_image.mpr ⟨K,(acyclic_matching_image_iff hf F C K).mp hM,rfl⟩
    · intro hM
      obtain ⟨K,hK,rfl⟩ := mem_image.mp hM
      exact (acyclic_matching_image_iff hf F C K).mpr hK
  have size_count_image {α β : Type} [DecidableEq α] [DecidableEq β]
      [Nonempty α] {f : α → β} (hf : Function.Injective f)
      (F : Finset α) (C : Finset (α × α)) (r : ℕ) :
      ((acyclicMatchings (F.image f) (C.image ((Prod.map f f)))).filter fun M => M.card = r).card =
        ((acyclicMatchings F C).filter fun M => M.card = r).card := by
    rw [acyclic_matchings_image hf, filter_image]
    have hcard (M : Finset (α × α)) : (M.image ((Prod.map f f))).card = M.card :=
      card_image_of_injOn (pairMap_injective hf).injOn
    simp_rw [hcard]
    exact card_image_of_injOn (image_injective (pairMap_injective hf)).injOn


  /- Nonempty directed paths, with the intermediate vertices listed explicitly. -/
  have rank_steps {α : Type} (R : α → α → Prop) (rank : α → ℕ)
      (h : ∀ a b, R a b → rank a < rank b) (a b : α) (l : List α)
      (hl : List.IsChain R (a :: (l ++ [b]))) : rank a < rank b := by
    induction l generalizing a with
    | nil => exact h a b (by simpa only [List.nil_append, List.isChain_pair] using hl)
    | cons x xs ih =>
      have hh : R a x ∧ List.IsChain R (x :: (xs ++ [b])) := by
        simpa only [List.cons_append, List.isChain_cons_cons] using hl
      exact lt_trans (h a x hh.1) (ih x hh.2)
  have acyclic_of_RankOK (C M : Finset (Fin 16 × Fin 16)) (hs : M ⊆ C)
      (code : ℕ) (h : RankOK C M code) : Acyclic univ (indexedArrow C M) := by
    refine ⟨decodeRank code, ?_⟩
    intro a _ b _ hab
    rcases hab with hm | ⟨hc,hm⟩
    · have hh := h (a,b) (hs hm)
      simpa only [hm, if_true] using hh
    · have hh := h (b,a) hc
      simpa only [hm, if_false] using hh
  have not_acyclic_of_cycle (C M : Finset (Fin 16 × Fin 16))
      (a : Fin 16) (l : List (Fin 16)) (h : List.IsChain (indexedArrow C M) (a :: (l ++ [a]))) :
      ¬ Acyclic univ (indexedArrow C M) := by
    rintro ⟨rank,hr⟩
    have hh := rank_steps (indexedArrow C M) rank
      (fun a b hab => hr a (mem_univ _) b (mem_univ _) hab) a a l h
    exact (lt_irrefl _) hh
  have certificate_correct (C : Finset (Fin 16 × Fin 16))
      (c : Cert) (hs : c.1 ⊆ C) (hv : CertValid C c) :
      isGood c = true ↔ Acyclic univ (indexedArrow C c.1) := by
    obtain ⟨M,code | ⟨a,l⟩⟩ := c
    · exact ⟨fun _ => acyclic_of_RankOK C M hs code hv, fun _ => rfl⟩
    · exact ⟨fun h => Bool.noConfusion h, fun h => (not_acyclic_of_cycle C M a l hv h).elim⟩
  have certificate_matchings (L : List (Fin 16 × Fin 16)) (_hn : L.Nodup)
      (certs : List Cert) (he : certs.map Prod.fst = candidateList L)
      (hv : ∀ c ∈ certs, CertValid L.toFinset c) :
      acyclicMatchings (univ : Finset (Fin 16)) L.toFinset =
        ((certs.filter isGood).map Prod.fst).toFinset := by
    classical
    ext M
    simp only [List.mem_toFinset, List.mem_map, List.mem_filter]
    constructor
    · intro hm
      obtain ⟨hs,hpair,hcheck⟩ := by
        simpa only [acyclicMatchings, mem_filter, mem_powerset, and_assoc] using hm
      have hcan : M ∈ candidateList L := (mem_candidateList L M).mpr ⟨hs,hpair⟩
      rw [← he, List.mem_map] at hcan
      obtain ⟨c,hc,rfl⟩ := hcan
      refine ⟨c,⟨hc,?_⟩,rfl⟩
      apply (certificate_correct L.toFinset c hs (hv c hc)).mpr
      exact hcheck
    · rintro ⟨c,⟨hc,hgood⟩,rfl⟩
      have hcan : c.1 ∈ candidateList L := he ▸ List.mem_map.mpr ⟨c,hc,rfl⟩
      obtain ⟨hs,hpair⟩ := (mem_candidateList L c.1).mp hcan
      simp only [acyclicMatchings, mem_filter, mem_powerset]
      refine ⟨hs,hpair,?_⟩
      exact (certificate_correct L.toFinset c hs (hv c hc)).mp hgood
  have goodFinset_eq (L : List (Fin 16 × Fin 16)) (hn : L.Nodup)
      (certs : List Cert) (he : certs.map Prod.fst = candidateList L)
      (hv : ∀ c ∈ certs, CertValid L.toFinset c) :
      goodFinset L hn certs he = acyclicMatchings (univ : Finset (Fin 16)) L.toFinset := by
    classical
    rw [certificate_matchings L hn certs he hv]
    ext M
    simp only [goodFinset, goodList, mem_mk, Multiset.mem_coe, List.mem_toFinset]
  have faceMap1_inj : Function.Injective faceMap1 := by decide +kernel
  have faceMap2_inj : Function.Injective faceMap2 := by decide +kernel
  have faceMap1_image : univ.image faceMap1 = facesOfEdges edges1 := by decide +kernel
  have faceMap2_image : univ.image faceMap2 = facesOfEdges edges2 := by decide +kernel
  have indexedC1_image : indexedC1.toFinset.image (Prod.map faceMap1 faceMap1) = coversOfEdges edges1 := by decide +kernel
  have indexedC2_image : indexedC2.toFinset.image (Prod.map faceMap2 faceMap2) = coversOfEdges edges2 := by decide +kernel
  have indexedC1_nodup : indexedC1.Nodup := by decide +kernel
  have indexedC2_nodup : indexedC2.Nodup := by decide +kernel
  have faces1_eq : independenceComplex G1 = facesOfEdges edges1 := by
    rw [independence_eq]
    decide +kernel
  have faces2_eq : independenceComplex G2 = facesOfEdges edges2 := by
    rw [independence_eq]
    decide +kernel
  have covers1_eq : coveringPairs (facesOfEdges edges1) = coversOfEdges edges1 := by decide +kernel
  have covers2_eq : coveringPairs (facesOfEdges edges2) = coversOfEdges edges2 := by decide +kernel
  have dimension_data1 : alpha (facesOfEdges edges1) = 2 ∧
      ((facesOfEdges edges1).filter fun s => s.card = 1).card = 8 ∧
      ((facesOfEdges edges1).filter fun s => s.card = 2).card = 8 ∧
      ∀ p ∈ coversOfEdges edges1, p.1 ∈ facesOfEdges edges1 ∧ p.2 ∈ facesOfEdges edges1 ∧
        p.1.card = 1 ∧ p.2.card = 2 := by decide +kernel
  have dimension_data2 : alpha (facesOfEdges edges2) = 2 ∧
      ((facesOfEdges edges2).filter fun s => s.card = 1).card = 8 ∧
      ((facesOfEdges edges2).filter fun s => s.card = 2).card = 8 ∧
      ∀ p ∈ coversOfEdges edges2, p.1 ∈ facesOfEdges edges2 ∧ p.2 ∈ facesOfEdges edges2 ∧
        p.1.card = 1 ∧ p.2.card = 2 := by decide +kernel
  have certs1_valid : ∀ c ∈ certs1, CertValid indexedC1.toFinset c := by
    rw [certs1, List.forall_mem_flatten]
    change ∀ B ∈ morseCertificateCodesOne, CertBlockValid indexedC1.toFinset B
    simp only [morseCertificateCodesOne, List.forall_mem_cons]
    repeat' apply And.intro
    all_goals decide +kernel
  have certs1_complete : certs1.map Prod.fst = candidateList indexedC1 := by decide +kernel
  have certs2_valid : ∀ c ∈ certs2, CertValid indexedC2.toFinset c := by
    rw [certs2, List.forall_mem_flatten]
    change ∀ B ∈ morseCertificateCodesTwo, CertBlockValid indexedC2.toFinset B
    simp only [morseCertificateCodesTwo, List.forall_mem_cons]
    repeat' apply And.intro
    all_goals decide +kernel
  have certs2_complete : certs2.map Prod.fst = candidateList indexedC2 := by decide +kernel

  let certified1 := goodFinset indexedC1 indexedC1_nodup certs1 certs1_complete

  let certified2 := goodFinset indexedC2 indexedC2_nodup certs2 certs2_complete
  have histogram1 : ∀ r : Fin 9, (certified1.filter fun M => M.card = r.val).card = expectedCounts r := by
    change ∀ r : Fin 9,
      ((goodList certs1).filter fun M => decide (M.card = r.val)).length = expectedCounts r
    intro r
    fin_cases r <;> decide +kernel
  have histogram2 : ∀ r : Fin 9, (certified2.filter fun M => M.card = r.val).card = expectedCounts r := by
    change ∀ r : Fin 9,
      ((goodList certs2).filter fun M => decide (M.card = r.val)).length = expectedCounts r
    intro r
    fin_cases r <;> decide +kernel
  have witness_size_counts (r : ℕ) (hr : r < 9) :
      ((acyclicMatchings (facesOfEdges edges1) (coversOfEdges edges1)).filter fun M => M.card = r).card =
      ((acyclicMatchings (facesOfEdges edges2) (coversOfEdges edges2)).filter fun M => M.card = r).card := by
    rw [← faceMap1_image, ← indexedC1_image, ← faceMap2_image, ← indexedC2_image]
    rw [size_count_image faceMap1_inj, size_count_image faceMap2_inj]
    rw [← goodFinset_eq indexedC1 indexedC1_nodup certs1 certs1_complete certs1_valid,
        ← goodFinset_eq indexedC2 indexedC2_nodup certs2 certs2_complete certs2_valid]
    exact (histogram1 ⟨r,hr⟩).trans (histogram2 ⟨r,hr⟩).symm
  have phi_equal : Phi G1 = Phi G2 := by
    unfold Phi
    rw [faces1_eq, faces2_eq, covers1_eq, covers2_eq]
    obtain ⟨ha1,h01,h11,hp1⟩ := dimension_data1
    obtain ⟨ha2,h02,h12,hp2⟩ := dimension_data2
    refine ensemble_equal_of_size_counts (facesOfEdges edges1) (coversOfEdges edges1)
      (facesOfEdges edges2) (coversOfEdges edges2) ?_ ?_ ?_ ?_ ?_
    · exact vector_one_dimensional _ _ ha1 h01 h11 hp1
    · exact vector_one_dimensional _ _ ha2 h02 h12 hp2
    · exact matching_size_bound _ _ h01 (fun p hp => ⟨(hp1 p hp).1,(hp1 p hp).2.2.1⟩)
    · exact matching_size_bound _ _ h02 (fun p hp => ⟨(hp2 p hp).1,(hp2 p hp).2.2.1⟩)
    · exact witness_size_counts
  have Phi_decidable_irrel {n : ℕ} (G : SimpleGraph (Fin n))
      (a b : DecidableRel G.Adj) : @Phi n G a = @Phi n G b := by
    exact congrArg (@Phi n G) (Subsingleton.elim a b)
  have chromatic_decidable_irrel {n : ℕ} (G : SimpleGraph (Fin n))
      (a b : DecidableRel G.Adj) (k : ℕ) :
      @chromaticCount n G a k = @chromaticCount n G b k := by
    exact congrArg (fun d => @chromaticCount n G d k) (Subsingleton.elim a b)

  /- The chromatic counts are not determined by the entire independence Morse ensemble. -/
  intro h
  have he' : @Phi 8 G1 (fun a b => Classical.propDecidable (G1.Adj a b)) =
      @Phi 8 G2 (fun a b => Classical.propDecidable (G2.Adj a b)) :=
    (Phi_decidable_irrel G1 _ _).trans (phi_equal.trans (Phi_decidable_irrel G2 _ _))
  have hh := h 8 8 G1 G2 he' 4
  have hh' : chromaticCount G1 4 = chromaticCount G2 4 :=
    (chromatic_decidable_irrel G1 _ _ 4).trans (hh.trans (chromatic_decidable_irrel G2 _ _ 4))
  have hpos := chromatic1_pos
  rw [hh', chromatic2_zero] at hpos
  exact (lt_irrefl 0) hpos

end D5.S3.Combinatorics.Graph.MorseEnsembleChromaticRefutation
