/-- Every coefficient of the original denominator, in increasing degree order. -/
def denominator : Fin 49 → ℤ := ![1, -2, -2, -4, 8, -2, -2, -23, 14, 31, 31, -45, 50, 83, 122, -141, -54, -105, 36, -85, -275, -222, 63, 90, -140, 253, 399, 234, 190, -87, 59, -219, -222, -189, -270, 152, 56, 123, 158, -41, 75, -62, -12, 21, -30, 7, 4, -3, 1]

private def rowEval : List (Fin 59 × ℤ) → Vector → ℤ
  | [], _ => 0
  | (j, a) :: rest, v => a * v j + rowEval rest v

private theorem rowEval_add (es : List (Fin 59 × ℤ)) (u v : Vector) :
    rowEval es (u + v) = rowEval es u + rowEval es v := by
  induction es with
  | nil => simp [rowEval]
  | cons e es ih => simp only [rowEval, Pi.add_apply, mul_add, ih]; ring

private theorem rowEval_smul (es : List (Fin 59 × ℤ)) (a : ℤ) (v : Vector) :
    rowEval es (a • v) = a * rowEval es v := by
  induction es with
  | nil => simp [rowEval]
  | cons e es ih => simp only [rowEval, Pi.smul_apply, smul_eq_mul, ih]; ring

/-- Sparse multiplication by the quotient matrix, as an integer linear map. -/
def step : Vector →ₗ[ℤ] Vector where
  toFun v i := rowEval (rows i) v
  map_add' u v := funext fun i => rowEval_add (rows i) u v
  map_smul' a v := funext fun i => rowEval_smul (rows i) a v

/-- The complete finite recurrence certificate; every coordinate is checked. -/
theorem power_steps : ∀ k : Fin 48, ∀ i : Fin 59,
    step (values k.castSucc) i = values k.succ i := by
  decide

/-- The certificate starts at the actual supplied terminal vector. -/
theorem initial_vector : values 0 = terminal := by rfl

/-- The exact integer denominator annihilates all 59 terminal-vector coordinates. -/
theorem finite_annihilator : ∀ i : Fin 59,
    (∑ j : Fin 49, denominator j * values ⟨48 - j.val, by omega⟩ i) = 0 := by
  decide

/-- Iteration of the quotient matrix on its terminal vector. -/
def orbit : ℕ → Vector
  | 0 => terminal
  | n + 1 => step (orbit n)

private theorem orbit_values (k : Fin 49) : orbit k.val = values k := by
  induction k using Fin.induction with
  | zero => exact initial_vector.symm
  | succ k ih =>
    change step (orbit k.val) = values k.succ
    change orbit k.val = values k.castSucc at ih
    rw [ih]
    exact funext (power_steps k)

/-- The annihilator propagates to every nonnegative shift, rather than merely
matching a finite list of scalar coefficients. -/
theorem shifted_annihilator (k : ℕ) :
    (∑ j : Fin 49, denominator j • orbit (k + 48 - j.val)) = 0 := by
  induction k with
  | zero =>
    funext i
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    simp_rw [show ∀ j : Fin 49, orbit (0 + 48 - j.val) = values ⟨48 - j.val, by omega⟩ from
      fun j => orbit_values ⟨48 - j.val, by omega⟩]
    exact finite_annihilator i
  | succ k ih =>
    have hs (j : Fin 49) : orbit (k + 1 + 48 - j.val) = step (orbit (k + 48 - j.val)) := by
      have he : k + 1 + 48 - j.val = (k + 48 - j.val) + 1 := by omega
      rw [he, orbit]
    change (∑ j : Fin 49, denominator j • orbit (k + 1 + 48 - j.val)) = 0
    simp_rw [hs, ← step.map_smul]
    rw [← map_sum, ih, map_zero]

end D5.S3.Combinatorics.Graph.Domination.BarkerMinimalGridQuotient
