theorem certifiedFamily :
    ∃ rows : List (Nat × Nat), familyOrderOK rows = true ∧
      ∀ row ∈ rows, candidateShapeOK .outerNext row.1 = true ∧ rowOK row = true := by
  refine ⟨certificateRows13Part2, certificateOrderOK, ?_⟩
  intro row hr
  obtain ⟨chunk, hchunk, hrow⟩ := List.mem_flatten.mp hr
  obtain ⟨k, hk⟩ := List.mem_iff_get.mp hchunk
  have hklt : k.val < 29 := by
    simpa [show certificateRows13Part2Chunks.length = 29 by decide] using k.isLt
  have hget : certificateRows13Part2Chunks.getD k.val [] = chunk := by
    rw [List.getD_eq_getElem _ _ k.isLt, ← List.get_eq_getElem, hk]
  have hproject {start len j : Nat}
      (hb : chunkBlockOK .outerNext certificateRows13Part2Chunks start len = true)
      (hj : j < len) (hm : row ∈ certificateRows13Part2Chunks.getD (start + j) []) :
      candidateShapeOK .outerNext row.1 = true ∧ rowOK row = true := by
    have hc := List.all_eq_true.mp hb j (List.mem_range.mpr hj)
    have hp := List.all_eq_true.mp hc row hm
    rwa [Bool.and_eq_true] at hp
  by_cases hk₀ : k.val < 10
