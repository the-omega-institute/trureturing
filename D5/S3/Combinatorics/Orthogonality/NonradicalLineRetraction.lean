/- GID: D5/S3/Combinatorics/Orthogonality/NonradicalLineRetraction
   generality: G
   mirror-B: D5/B/S3/Combinatorics/Orthogonality/NonradicalLineRetraction
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: A contained nonradical-line retraction of the binary subspace orthogonality graph. -/

import D5.S3.Combinatorics.Orthogonality.NikandishClique
import Mathlib.Combinatorics.SimpleGraph.Coloring.Vertex

set_option autoImplicit false

namespace D5.S3.Combinatorics.Orthogonality.NonradicalLineRetraction

open Module
open D5.S3.Combinatorics.Orthogonality.NikandishClique
open D5.S3.Fourier.CharacterSelection.BinaryCharacterCodeDuality

/-- Retain every line and every pairwise totally isotropic nonzero subspace. -/
def Retained (n : ℕ) (U : Vertex n) : Prop :=
  finrank (ZMod 2) U.1 = 1 ∨
    ∀ u ∈ U.1, ∀ v ∈ U.1, standardCoordinatePairing (ZMod 2) (Fin n) u v = 0

/-- The original graph induced on precisely the retained vertices. -/
def retainedGraph (n : ℕ) : SimpleGraph {U : Vertex n // Retained n U} :=
  (orthogonalityGraph n).induce {U | Retained n U}

/-- Every dimension admits a retraction with contained images. Every moved vertex
maps to a line outside its own orthogonal, generated by a nonradical vector.
The construction follows the public binary-subspace-orthogonality research note
`notes/nonradical-line-retraction.md`; the note has no individual byline. -/
theorem result (n : ℕ) :
    ∃ r : orthogonalityGraph n →g retainedGraph n,
      (∀ U : {U : Vertex n // Retained n U}, r U.1 = U) ∧
      (∀ U : Vertex n, (r U).1.1 ≤ U.1) ∧
      (∀ U : Vertex n, (r U).1 ≠ U →
        finrank (ZMod 2) (r U).1.1 = 1 ∧
        ¬(r U).1.1 ≤ (standardCoordinatePairing (ZMod 2) (Fin n)).orthogonal U.1 ∧
        ∃ v : Fin n → ZMod 2, v ∈ U.1 ∧ v ≠ 0 ∧ (r U).1.1 = (ZMod 2) ∙ v ∧
          ∃ w : Fin n → ZMod 2, w ∈ U.1 ∧
            standardCoordinatePairing (ZMod 2) (Fin n) v w ≠ 0) := by
  classical
  let B := standardCoordinatePairing (ZMod 2) (Fin n)
  have chooseLine (U : Vertex n) (hU : ¬Retained n U) :
      ∃ L : {U : Vertex n // Retained n U},
        L.1.1 ≤ U.1 ∧ finrank (ZMod 2) L.1.1 = 1 ∧ ¬L.1.1 ≤ B.orthogonal U.1 ∧
        ∃ v : Fin n → ZMod 2, v ∈ U.1 ∧ v ≠ 0 ∧ L.1.1 = (ZMod 2) ∙ v ∧
          ∃ w : Fin n → ZMod 2, w ∈ U.1 ∧ B v w ≠ 0 := by
    have hn : ¬∀ v ∈ U.1, ∀ w ∈ U.1, B v w = 0 := fun h => hU (Or.inr h)
    push Not at hn
    obtain ⟨v, hv, w, hw, hvw⟩ := hn
    have vn : v ≠ 0 := by
      intro hz
      subst v
      exact hvw (by simp)
    let L : Vertex n := ⟨(ZMod 2) ∙ v, by simpa using vn⟩
    have dimL : finrank (ZMod 2) L.1 = 1 := finrank_span_singleton vn
    have nonradical : ¬L.1 ≤ B.orthogonal U.1 := by
      intro h
      have hz := h (Submodule.mem_span_singleton_self v) w hw
      apply hvw
      change dotProduct v w = 0
      rw [dotProduct_comm]
      exact hz
    exact ⟨⟨L, Or.inl dimL⟩, (Submodule.span_singleton_le_iff_mem v U.1).mpr hv,
      dimL, nonradical, v, hv, vn, rfl, w, hw, hvw⟩
  let q (U : Vertex n) : {U : Vertex n // Retained n U} :=
    if h : Retained n U then ⟨U, h⟩ else (chooseLine U h).choose
  have fixed (U : {U : Vertex n // Retained n U}) : q U.1 = U := by
    apply Subtype.ext
    simp [q, U.2]
  have contained (U : Vertex n) : (q U).1.1 ≤ U.1 := by
    dsimp [q]
    split
    · exact le_refl _
    · rename_i hU
      exact (chooseLine U hU).choose_spec.1
  have moved (U : Vertex n) (hU : ¬Retained n U) :
      finrank (ZMod 2) (q U).1.1 = 1 ∧ ¬(q U).1.1 ≤ B.orthogonal U.1 ∧
        ∃ v : Fin n → ZMod 2, v ∈ U.1 ∧ v ≠ 0 ∧ (q U).1.1 = (ZMod 2) ∙ v ∧
          ∃ w : Fin n → ZMod 2, w ∈ U.1 ∧ B v w ≠ 0 := by
    have hq : q U = (chooseLine U hU).choose := dif_neg hU
    rw [hq]
    exact (chooseLine U hU).choose_spec.2
  have edges {U V : Vertex n} (hUV : (orthogonalityGraph n).Adj U V) :
      (retainedGraph n).Adj (q U) (q V) := by
    refine ⟨?_, fun u hu v hv => hUV.2 u (contained U hu) v (contained V hv)⟩
    intro he
    have he' : (q U).1.1 = (q V).1.1 := congrArg Subtype.val he
    by_cases hU : Retained n U
    · by_cases hV : Retained n V
      · apply hUV.1
        exact (congrArg Subtype.val (fixed ⟨U, hU⟩)).symm.trans
          (he.trans (congrArg Subtype.val (fixed ⟨V, hV⟩)))
      · apply (moved V hV).2.1
        intro x hx y hy
        exact ((orthogonalityGraph n).adj_symm hUV).2 y hy x (contained U (he'.symm ▸ hx))
    · apply (moved U hU).2.1
      intro x hx y hy
      exact hUV.2 y hy x (contained V (he' ▸ hx))
  let r : orthogonalityGraph n →g retainedGraph n := ⟨q, fun h => edges h⟩
  refine ⟨r, fixed, contained, fun U h => moved U ?_⟩
  intro hU
  exact h (congrArg Subtype.val (fixed ⟨U, hU⟩))

#print axioms result

end D5.S3.Combinatorics.Orthogonality.NonradicalLineRetraction
