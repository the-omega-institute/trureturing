/- GID: D5/S3/Combinatorics/CayleySumCodes/NormalizerInvolutionCounterexample
   generality: I
   mirror-B: D5/B/S3/Combinatorics/CayleySumCodes/NormalizerInvolutionCounterexample
   mirror-E: none(waiver:kernel-checked-refutation)
   anchors: []
   utility: kind=certified-instance; basis=refutes=gid:D5/S3/Combinatorics/CayleySumCodes/NormalizerInvolutionCounterexample.claim; result=D5/S3/Combinatorics/CayleySumCodes/NormalizerInvolutionCounterexample.result; claim=D5/S3/Combinatorics/CayleySumCodes/NormalizerInvolutionCounterexample.claim
   digest: The actual order-thirty-two central product refutes the involution-normalizer translation claim. -/

import D5.S3.Combinatorics.CayleySumCodes.CentralizingInvolutionTranslation
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.GroupTheory.Subgroup.Center
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.Algebra.Group.TypeTags.Basic
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic

set_option autoImplicit false
set_option maxRecDepth 100000
set_option maxHeartbeats 8000000

namespace D5.S3.Combinatorics.CayleySumCodes.NormalizerInvolutionCounterexample

open D5.S3.Combinatorics.CayleySumCodes.TotalPerfectCriterion

/-- Normal forms x^i y^j t^k, with x^4=y^4=1, y^-1 x y=x^-1,
t central, and t^2=x^2. Coordinates range over all 32 normal forms. -/
structure CentralProduct where
  i : ZMod 4
  j : ZMod 4
  k : ZMod 2
  deriving DecidableEq, Fintype

private def product (a b : CentralProduct) : CentralProduct :=
  ⟨a.i + (if a.j.val % 2 = 0 then b.i else -b.i) + 2 * a.k.val * b.k.val,
    a.j + b.j, a.k + b.k⟩
private def inverse (a : CentralProduct) : CentralProduct :=
  ⟨if a.j.val % 2 = 0 then -a.i - 2 * a.k.val else a.i + 2 * a.k.val,
    -a.j, a.k⟩

instance : Group CentralProduct where
  mul := product
  one := ⟨0, 0, 0⟩
  inv := inverse
  mul_assoc := by decide +kernel
  one_mul := by decide +kernel
  mul_one := by decide +kernel
  inv_mul_cancel := by decide +kernel

/-- The actual order-16 subgroup, consisting of the forms with k=0. -/
def H : Subgroup CentralProduct where
  carrier := {a | a.k = 0}
  one_mem' := rfl
  mul_mem' := by
    intro a b ha hb
    change a.k = 0 at ha
    change b.k = 0 at hb
    change a.k + b.k = 0
    rw [ha, hb]; rfl
  inv_mem' := by intro a ha; exact ha

instance : DecidablePred (fun a => a ∈ H) := fun _ => inferInstanceAs (Decidable (_ = _))

/-- Original generators of H and the central element t. -/
def x : CentralProduct := ⟨1, 0, 0⟩
def y : CentralProduct := ⟨0, 1, 0⟩
def t : CentralProduct := ⟨0, 0, 1⟩
def z : CentralProduct := x ^ 2 * y ^ 2

def connection : Set CentralProduct := {z, t}
private theorem connection_normal : NormalSubset connection := by
  unfold NormalSubset connection
  decide +kernel

/-- The source involution and the specific vertex with the deleted self-loop. -/
def b : CentralProduct := x⁻¹ * t
def v : CentralProduct := y * t

def translated : Set CentralProduct := (fun h => h * b) '' (H : Set CentralProduct)

/-- C4 in the original direct product H times <u>. -/
abbrev C4 := Multiplicative (ZMod 4)

/-- The central-product quotient map (h,u^r) maps to h*t^r. -/
def quotientMap : H × C4 →* CentralProduct where
  toFun a := a.1.1 * t ^ (Multiplicative.toAdd a.2).val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

private theorem quotientMap_surjective : Function.Surjective quotientMap := by
  decide +kernel

def centralGenerator : H × C4 := (⟨x ^ 2, by decide +kernel⟩, Multiplicative.ofAdd 2)

/-- The kernel is the actual subgroup generated by (x^2,u^2), not an
unspecified scalar relation or an assumed quotient cardinality. -/
private theorem kernel_eq : quotientMap.ker = Subgroup.zpowers centralGenerator := by
  apply Subgroup.ext
  intro a
  have ht : orderOf centralGenerator = 2 := by
    apply (orderOf_eq_iff (by decide : 0 < 2)).mpr
    refine ⟨by decide +kernel, ?_⟩
    intro m hm hp
    have he : m = 1 := by omega
    subst m
    decide +kernel
  rw [mem_zpowers_iff_mem_range_orderOf, ht]
  revert a
  decide +kernel

def centralRelation : Subgroup (H × C4) := Subgroup.zpowers centralGenerator

instance : centralRelation.Normal := by
  change (Subgroup.zpowers centralGenerator).Normal
  rw [← kernel_eq]
  infer_instance

/-- An explicit isomorphism with the source's quotient by <(x^2,u^2)>. -/
noncomputable def centralQuotientEquiv :
    (H × C4) ⧸ centralRelation ≃* CentralProduct :=
  (QuotientGroup.quotientMulEquivOfEq
    (show centralRelation = quotientMap.ker from kernel_eq.symm)).trans
    (QuotientGroup.quotientKerEquivOfSurjective quotientMap quotientMap_surjective)

private theorem code : IsTotalPerfectCode (sumGraph connection connection_normal) H := by
  change ∀ g : CentralProduct, ∃! h : CentralProduct, h.k = 0 ∧
    g ≠ h ∧ g * h ∈ connection
  simp only [SetLike.mem_coe, H, Subgroup.mem_mk, Set.mem_setOf_eq,
    connection, Set.mem_insert_iff, Set.mem_singleton_iff, ExistsUnique]
  decide +kernel

private theorem involution_normalizes : b * b = 1 ∧ b ∈ Subgroup.normalizer (H : Set CentralProduct) := by
  simp only [Subgroup.mem_normalizer_iff]
  decide +kernel

private theorem no_translated_neighbor :
    ∀ w : CentralProduct, w ∈ translated → ¬(sumGraph connection connection_normal).Adj v w := by
  change ∀ w : CentralProduct, (∃ h : CentralProduct, h.k = 0 ∧ h * b = w) →
    ¬ (v ≠ w ∧ v * w ∈ connection)
  simp only [SetLike.mem_coe, H, Subgroup.mem_mk, Set.mem_setOf_eq,
    connection, Set.mem_insert_iff, Set.mem_singleton_iff, ExistsUnique]
  decide +kernel

/-- The original normalizer-only assertion, with the graph held fixed.
The sufficient centralizer repair is a separate general theorem. -/
def claim : Prop :=
  ∀ (G : Type) [Group G] [Finite G] (K : Subgroup G) (Y : Set G)
    (hn : NormalSubset Y) (a : G),
    a * a = 1 → a ∈ Subgroup.normalizer (K : Set G) →
    IsTotalPerfectCode (sumGraph Y hn) K →
    IsTotalPerfectCode (sumGraph Y hn) ((fun h => h * a) '' (K : Set G))

/-- The stated order-32 central product is a complete counterexample to
normalizer-only translation in the same graph: v has no neighbor in Hb. -/
theorem result : Not claim := by
  intro hc
  have hbad := hc CentralProduct H connection connection_normal b
    involution_normalizes.1 involution_normalizes.2 code
  obtain ⟨w, ⟨hw, ha⟩, _⟩ := hbad v
  exact no_translated_neighbor w hw ha

#print axioms result

end D5.S3.Combinatorics.CayleySumCodes.NormalizerInvolutionCounterexample
