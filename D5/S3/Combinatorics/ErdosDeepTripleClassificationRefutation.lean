   generality: I
   mirror-B: D5/B/S3/Combinatorics/ErdosDeepTripleClassificationRefutation
   mirror-E: none(waiver:kernel-checked-refutation)
   anchors: [mathlib/module/Mathlib.Data.List.Dedup]
   utility: kind=certified-instance; basis=refutes=gid:D5/S3/Combinatorics/ErdosDeepTripleClassificationRefutation.claim; result=D5/S3/Combinatorics/ErdosDeepTripleClassificationRefutation.result; claim=D5/S3/Combinatorics/ErdosDeepTripleClassificationRefutation.claim
   digest: Three progressions of lengths twelve six and five in Z27 form an Erdos-deep family outside the conjectured list. -/

import Mathlib.Data.List.Dedup
import Mathlib.Data.List.Count
import Mathlib.Tactic

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.ErdosDeepTripleClassificationRefutation

/-
proof_shape: result: content
escape_witness: `witness_deep`, that the three progressions of lengths twelve, six and five
  generated by one, twelve and seven in Z27 realise the multiplicities one through thirteen
  exactly once each; it is not an instantiation, projection or normalisation of a pinned
  upstream statement and it is the sole support of the negation.
admission_basis: open-problem-resolution (issue #9317)
Direct frozen dependencies: none (pinned Mathlib only)
-/

/-! ### Distances in a cyclic group -/

/-- The cyclic distance between `x` and `y` in `Z n`: the smaller of the two arc lengths. -/
def cdist (n x y : ℕ) : ℕ :=
  let d := (x + n - y) % n
  min d (n - d)

/-- The modular arithmetic progression `{0, g, 2g, …, (k-1)g}` in `Z n`. -/
def apList (n g k : ℕ) : List ℕ := (List.range k).map (fun i => i * g % n)

/-- All pairwise cyclic distances inside one list of points. -/
def pairDists (n : ℕ) : List ℕ → List ℕ
  | [] => []
  | x :: rest => rest.map (fun y => cdist n x y) ++ pairDists n rest

/-- The distances of a family of three progressions, as a multiset. -/
def familyDists (n g₁ g₂ g₃ k₁ k₂ k₃ : ℕ) : List ℕ :=
  pairDists n (apList n g₁ k₁) ++ pairDists n (apList n g₂ k₂) ++ pairDists n (apList n g₃ k₃)

/-- The multiplicity of each distance that occurs, one entry per distinct distance. -/
def multiplicities (ds : List ℕ) : List ℕ := (ds.dedup).map (fun d => ds.count d)

/-! ### Erdős-deep families -/

/-- The family of three progressions is Erdős-deep: the multiplicities of the distances that
occur are precisely `1, 2, …, m`, where `m` is the number of distinct distances. -/
private def erdosDeepCheck (n g₁ g₂ g₃ k₁ k₂ k₃ : ℕ) : Bool :=
  let ms := multiplicities (familyDists n g₁ g₂ g₃ k₁ k₂ k₃)
  (List.range' 1 ms.length).all (fun i => ms.count i == 1)

def IsErdosDeep (n g₁ g₂ g₃ k₁ k₂ k₃ : ℕ) : Prop :=
  erdosDeepCheck n g₁ g₂ g₃ k₁ k₂ k₃ = true

/-- The length triples the source conjectures to be the only ones that occur. -/
def allowed : List (ℕ × ℕ × ℕ) :=
  [(4, 4, 3), (6, 3, 3), (6, 5, 3), (6, 6, 4), (6, 6, 6), (7, 7, 3), (9, 4, 3), (8, 7, 4),
   (8, 8, 5), (10, 6, 4), (12, 4, 4), (13, 5, 3), (13, 7, 4), (16, 5, 4), (21, 6, 4)]

/-! ### The conjecture and its refutation -/

/-- Conjecture 1 of Dukes and Gaede, in the stronger form carried by Conjecture 4.5 of the
accompanying thesis: the length triple of any Erdős-deep family of three modular arithmetic
progressions lies in the conjectured list. -/
def claim : Prop :=
  ∀ n g₁ g₂ g₃ k₁ k₂ k₃ : ℕ,
    3 ≤ k₃ → k₃ ≤ k₂ → k₂ ≤ k₁ →
    k₁ ≤ n / (2 * Nat.gcd n g₁) + 1 →
    Nat.gcd (Nat.gcd (Nat.gcd n g₁) g₂) g₃ = 1 →
    (apList n g₁ k₁).Nodup → (apList n g₂ k₂).Nodup → (apList n g₃ k₃).Nodup →
    IsErdosDeep n g₁ g₂ g₃ k₁ k₂ k₃ →
    (k₁, k₂, k₃) ∈ allowed

set_option maxRecDepth 100000 in
private lemma witness_deep : IsErdosDeep 27 1 12 7 12 6 5 := by
  show erdosDeepCheck 27 1 12 7 12 6 5 = true
  rfl

theorem result : ¬ claim := by
  intro h
  have hbad := h 27 1 12 7 12 6 5 (by norm_num) (by norm_num) (by norm_num)
    (by norm_num) (by norm_num) (by decide) (by decide) (by decide) witness_deep
  exact absurd hbad (by decide)

end D5.S3.Combinatorics.ErdosDeepTripleClassificationRefutation
