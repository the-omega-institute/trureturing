import Mathlib.Combinatorics.SimpleGraph.Basic
import Mathlib.Order.Lattice.Nat

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.DihedralRamsey.DihedralRamseyDefs

/-! Fixed public statements: I. Damnjanović and I. Đorđević, *Computation of small reflective and
    dihedral Ramsey numbers*, arXiv:2607.06817v2, Section 4: "Conjecture 4.4. For any a, b ⩾ 2, we
    have R_dih(P_a^alt, P_b^alt) = a + b − 2 − (ab mod 2)." "Conjecture 4.5. For any a, b ⩾ 2, we
    have R_dih(P_a^alt, S_b^sc) = a + b − 2 − (ab mod 2)." and Conjecture 4.9,
    R_dih(P_a^alt, K_b) = 1 + (a − 1)(b − 1) for all a, b ∈ ℕ. Section 1: H is Γ-embeddable in G
    if there is a homomorphism from H to G of the form ψ ∘ φ with φ ∈ Γ and ψ an increasing
    injection; R_dih takes Γ to be the dihedral group generated by the cyclic shift and the
    reflection of the natural vertex order, and is the least n such that every 2-edge-colouring
    of K_n has a first-colour embedding of the first graph or a second-colour embedding of the
    second. Section 2: P_n^alt is the path with underlying path (0, n − 1, 1, n − 2, …), and S_n^sc
    is the star with centre 0. A 2-edge-colouring of K_n is recorded by its first colour class G;
    the second colour class is the complement of G. -/

/-- The dihedral permutations of `Fin k`: `i ↦ i + s` and `i ↦ (k − 1 − i) + s`, modulo `k`. -/
def dihedralPerm {k : ℕ} (s : ℕ) (refl : Bool) (i : Fin k) : Fin k :=
  ⟨((if refl then k - 1 - i.val else i.val) + s) % k, Nat.mod_lt _ (Fin.pos i)⟩

/-- `H` is dihedrally embeddable in `G`: some `ψ ∘ φ` with `φ` dihedral and `ψ` an increasing
injection is a graph homomorphism. -/
def DihedralEmbeddable {k n : ℕ} (H : SimpleGraph (Fin k)) (G : SimpleGraph (Fin n)) : Prop :=
  ∃ (s : ℕ) (refl : Bool) (ψ : Fin k → Fin n), StrictMono ψ ∧
    ∀ i j, H.Adj i j → G.Adj (ψ (dihedralPerm s refl i)) (ψ (dihedralPerm s refl j))

/-- The dihedral Ramsey number `R_dih(H, J)`. -/
noncomputable def dihedralRamsey {a b : ℕ} (H : SimpleGraph (Fin a)) (J : SimpleGraph (Fin b)) :
    ℕ :=
  sInf {N | ∀ G : SimpleGraph (Fin N), DihedralEmbeddable H G ∨ DihedralEmbeddable J Gᶜ}

/-- The `j`-th vertex `0, a − 1, 1, a − 2, …` of the underlying path of `P_a^alt`. -/
def altVertex (a j : ℕ) : ℕ := if j % 2 = 0 then j / 2 else a - 1 - j / 2

/-- The alternating path `P_a^alt`. -/
def altPath (a : ℕ) : SimpleGraph (Fin a) :=
  SimpleGraph.fromRel fun x y =>
    ∃ j, j + 1 < a ∧ x.val = altVertex a j ∧ y.val = altVertex a (j + 1)

/-- The start-central star `S_b^sc`. -/
def startStar (b : ℕ) : SimpleGraph (Fin b) := SimpleGraph.fromRel fun x y => x.val = 0 ∧ y.val ≠ 0

/-- Conjecture 4.4. -/
def claimPathPath : Prop :=
  ∀ a b : ℕ, 2 ≤ a → 2 ≤ b → dihedralRamsey (altPath a) (altPath b) = a + b - 2 - a * b % 2

/-- Conjecture 4.5. -/
def claimPathStar : Prop :=
  ∀ a b : ℕ, 2 ≤ a → 2 ≤ b → dihedralRamsey (altPath a) (startStar b) = a + b - 2 - a * b % 2

/-- Conjecture 4.9. -/
def claimPathClique : Prop :=
  ∀ a b : ℕ, 1 ≤ a → 1 ≤ b →
    dihedralRamsey (altPath a) (⊤ : SimpleGraph (Fin b)) = 1 + (a - 1) * (b - 1)

end D5.S3.Combinatorics.DihedralRamsey.DihedralRamseyDefs
