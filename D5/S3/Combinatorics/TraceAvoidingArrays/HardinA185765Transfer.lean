        ((tables[k]!)[s.val]!)[t.val]! else 0 := by
  unfold fastStep
  split_ifs with h
  · apply Finset.sum_congr rfl
    intro t ht
    exact ite_eq_left ((adjacency_correct r s h t).mp ht).1
