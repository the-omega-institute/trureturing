def fastStep (v : (Fin 64) → (Fin 64) → ℤ) (r s : (Fin 64)) : ℤ :=
  if H r s then ∑ t ∈ (fun r s : Fin 64 => (((adjData[r.val]!)[s.val]!)).toFinset) r s, v s t else 0

private theorem step_fast (v : (Fin 64) → (Fin 64) → ℤ)
    (hv : ∀ r s : (Fin 64), ¬ H r s → v r s = 0) : step v = fastStep v := by
  funext r s
  by_cases hh : H r s
  · simp only [step, fastStep, hh, ite_true]
    calc
      (∑ t : (Fin 64), if V r s t then v s t else 0) =
          ∑ t : (Fin 64), if t ∈ (fun r s : Fin 64 => (((adjData[r.val]!)[s.val]!)).toFinset) r s then v s t else 0 := by
        apply Finset.sum_congr rfl
        intro t _
        by_cases hs : H s t
        · have ha : t ∈ (fun r s : Fin 64 => (((adjData[r.val]!)[s.val]!)).toFinset) r s ↔ V r s t := by
            simpa only [hs, true_and] using adjacency_correct r s hh t
          simp only [ha]
        · simp [hv s t hs]
      _ = ∑ t ∈ (fun r s : Fin 64 => (((adjData[r.val]!)[s.val]!)).toFinset) r s, v s t := Finset.sum_ite_mem_eq _ _
  · simp [step, fastStep, hh]

