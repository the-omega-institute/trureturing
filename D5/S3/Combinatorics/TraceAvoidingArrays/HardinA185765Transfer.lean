import Mathlib.LinearAlgebra.Matrix.Trace
import Mathlib.SetTheory.Cardinal.NatCard



set_option maxRecDepth 8000
set_option maxHeartbeats 0
set_option maxRecDepth 20000

namespace D5.S3.Combinatorics.TraceAvoidingArrays.HardinA185765Transfer
open scoped BigOperators

/-- The ordinary trace of the contiguous 2-by-2 block with origin (i,j).
The entries are coerced to natural numbers before taking the trace. -/
def blockTrace {n : ℕ} (A : (Matrix (Fin (n + 1)) (Fin 6) (Fin 2))) (i : Fin n) (j : Fin 5) : ℕ :=
  Matrix.trace (fun r c : Fin 2 =>
    (A (if r = 0 then i.castSucc else i.succ)
       (if c = 0 then j.castSucc else j.succ)).val)

/-- Unequal traces at every horizontally or vertically adjacent pair of blocks. -/
def Admissible {n : ℕ} (A : (Matrix (Fin (n + 1)) (Fin 6) (Fin 2))) : Prop :=
  (∀ (i : Fin n) (j k : Fin 5), k.val = j.val + 1 →
    blockTrace A i j ≠ blockTrace A i k) ∧
  (∀ (i h : Fin n) (j : Fin 5), h.val = i.val + 1 →
    blockTrace A i j ≠ blockTrace A h j)

/-- The literal finite array count; this is not defined by a recurrence. -/
noncomputable def a (n : ℕ) : ℕ :=
  Nat.card {A : (Matrix (Fin (n + 1)) (Fin 6) (Fin 2)) // Admissible A}



private theorem blockTrace_eq {n : ℕ} (A : (Matrix (Fin (n + 1)) (Fin 6) (Fin 2))) (i : Fin n) (j : Fin 5) :
    blockTrace A i j = (A i.castSucc j.castSucc).val + (A i.succ j.succ).val := by
  simpa [blockTrace] using (Matrix.trace_fin_two (fun r c : Fin 2 =>
    (A (if r = 0 then i.castSucc else i.succ)
      (if c = 0 then j.castSucc else j.succ)).val))

def tau (r s : Fin 64) (j : Fin 5) : ℕ :=
  blockTrace (n := 1) (Fin.cons ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm r)
    (Fin.cons ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s) Fin.elim0)) 0 j

private theorem tau_eq (r s : Fin 64) (j : Fin 5) :
    tau r s j =
      ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm r j.castSucc).val +
      ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s j.succ).val := by
  simpa [tau] using (blockTrace_eq (n := 1) (Fin.cons ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm r)
      (Fin.cons ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s) Fin.elim0)) 0 j)

def H (r s : Fin 64) : Prop := Admissible (n := 1) (Fin.cons ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm r)
    (Fin.cons ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s) Fin.elim0))
def V (r s t : Fin 64) : Prop := ∀ j : Fin 5, tau r s j ≠ tau s t j

private theorem horizontal_iff (r s : Fin 64) :
    H r s ↔ ∀ (j k : Fin 5), k.val = j.val + 1 → tau r s j ≠ tau r s k := by
  constructor
  · intro h j k hjk
    exact h.1 0 j k hjk
  · intro h
    constructor
    · intro i j k hjk
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      exact h j k hjk
    · intro i h j hih
      have hi : i = 0 := Subsingleton.elim _ _
      have hh : h = 0 := Subsingleton.elim _ _
      subst i
      subst h
      simp at hih

private theorem horizontal_short_iff (r s : Fin 64) :
    H r s ↔ ∀ j : Fin 4, tau r s j.castSucc ≠ tau r s j.succ := by
  rw [horizontal_iff]
  constructor
  · intro h j
    exact h j.castSucc j.succ rfl
  · intro h j k hjk
    have hj : j.val < 4 := Nat.lt_of_succ_lt_succ (by simpa only [hjk] using k.isLt)
    let jj : Fin 4 := ⟨j.val, hj⟩
    have h1 : jj.castSucc = j := Fin.ext rfl
    have h2 : jj.succ = k := Fin.ext (by simpa [jj] using hjk.symm)
    simpa only [h1, h2] using h jj

private instance hDecidable (r s : Fin 64) : Decidable (H r s) :=
  decidable_of_iff
    (∀ j : Fin 4, (((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm r (j.castSucc).castSucc).val + ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s (j.castSucc).succ).val) ≠
      (((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm r (j.succ).castSucc).val + ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s (j.succ).succ).val))
    (by rw [horizontal_short_iff]; simp only [tau_eq])
private instance vDecidable (r s t : Fin 64) : Decidable (V r s t) :=
  decidable_of_iff
    (∀ j : Fin 5, (((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm r (j).castSucc).val + ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s (j).succ).val) ≠
      (((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm s (j).castSucc).val + ((finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64).symm t (j).succ).val))
    (by simp only [V, tau_eq])

private def Good (k : ℕ) (f : Fin (k + 2) → (Fin 64)) : Prop :=
  (∀ i : Fin (k + 1), H (f i.castSucc) (f i.succ)) ∧
  (∀ i : Fin k, V (f i.castSucc.castSucc) (f i.castSucc.succ) (f i.succ.succ))

private instance goodDecidable (k : ℕ) (f : Fin (k + 2) → (Fin 64)) : Decidable (Good k f) :=
  inferInstanceAs (Decidable ((∀ i : Fin (k + 1), _) ∧ (∀ i : Fin k, _)))

private theorem admissible_iff (k : ℕ) (A : (Matrix (Fin (k + 1 + 1)) (Fin 6) (Fin 2))) :
    Admissible A ↔ Good k (fun i => (finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64) (A i)) := by
  constructor
  · rintro ⟨hh, hv⟩
    constructor
    · intro i
      apply (horizontal_short_iff _ _).mpr
      intro j
      simpa [tau_eq, blockTrace_eq] using hh i j.castSucc j.succ rfl
    · intro i j
      simpa only [V, tau_eq, blockTrace_eq, Equiv.symm_apply_apply, Fin.castSucc_succ] using
        hv i.castSucc i.succ j rfl
  · rintro ⟨hh, hv⟩
    constructor
    · intro i j l hjl
      have h := (horizontal_iff _ _).mp (hh i) j l hjl
      simpa [tau_eq, blockTrace_eq] using h
    · intro i h j hih
      have hi : i.val < k := Nat.lt_of_succ_lt_succ (by simpa only [hih] using h.isLt)
      let ii : Fin k := ⟨i.val, hi⟩
      have e1 : ii.castSucc = i := Fin.ext rfl
      have e2 : ii.succ = h := Fin.ext (by simpa [ii] using hih.symm)
      have e3 : i.succ = h.castSucc := Fin.ext hih.symm
      have hvv := hv ii j
      simpa only [V, tau_eq, blockTrace_eq, Equiv.symm_apply_apply,
        e1, e2, e3] using hvv

private theorem good_cons (k : ℕ) (r : (Fin 64)) (f : Fin (k + 2) → (Fin 64)) :
    Good (k + 1) (Fin.cons r f) ↔
      H r (f 0) ∧ V r (f 0) (f 1) ∧ Good k f := by
  simp only [Good, Fin.forall_fin_succ, Fin.castSucc_zero, Fin.cons_zero,
    Fin.succ_zero_eq_one, Fin.cons_succ, Fin.castSucc_succ]
  tauto


def step (v : (Fin 64) → (Fin 64) → ℤ) (r s : (Fin 64)) : ℤ :=
  if H r s then ∑ t : (Fin 64), if V r s t then v s t else 0 else 0

def u : ℕ → (Fin 64) → (Fin 64) → ℤ
  | 0, r, s => if H r s then 1 else 0
  | k + 1, r, s => step (u k) r s

private def count (k : ℕ) (r s : (Fin 64)) : ℤ :=
  ∑ f : Fin k → (Fin 64), if Good k (Fin.cons r (Fin.cons s f)) then 1 else 0

private theorem count_zero (r s : (Fin 64)) : count 0 r s = u 0 r s := by
  simp [count, u, Good, Fin.forall_fin_one]

private theorem count_succ (k : ℕ) (r s : (Fin 64)) :
    count (k + 1) r s = step (count k) r s := by
  unfold count
  rw [← (Fin.consEquiv (fun _ : Fin (k + 1) => (Fin 64))).sum_comp
    (fun f => if Good (k + 1) (Fin.cons r (Fin.cons s f)) then (1 : ℤ) else 0),
    Fintype.sum_prod_type]
  change (∑ t : (Fin 64), ∑ f : Fin k → (Fin 64),
    if Good (k + 1) (Fin.cons r (Fin.cons s (Fin.cons t f))) then (1 : ℤ) else 0) = _
  unfold step
  by_cases hh : H r s
  · rw [ite_eq_left hh]
    apply Finset.sum_congr rfl
    intro t _
    by_cases hv : V r s t
    · simp [good_cons, hh, hv]
    · simp [good_cons, hh, hv]
  · simp [good_cons, hh]

private theorem count_eq_u (k : ℕ) : count k = u k := by
  induction k with
  | zero => funext r s; exact count_zero r s
  | succ k ih => funext r s; rw [count_succ, ih]; rfl

theorem counting_bridge (k : ℕ) :
    (a (k + 1) : ℤ) = ∑ r : (Fin 64), ∑ s : (Fin 64), u k r s := by
  classical
  let e : (Matrix (Fin (k + 1 + 1)) (Fin 6) (Fin 2)) ≃ (Fin (k + 2) → (Fin 64)) :=
    Equiv.piCongrRight (fun _ => (finFunctionFinEquiv : (Fin 6 → Fin 2) ≃ Fin 64))
  have he (A : (Matrix (Fin (k + 1 + 1)) (Fin 6) (Fin 2))) : Admissible A ↔ Good k (e A) :=
    admissible_iff k A
  have hc : (a (k + 1) : ℤ) =
      ∑ f : Fin (k + 2) → (Fin 64), if Good k f then (1 : ℤ) else 0 := by
    rw [a, Nat.card_congr (e.subtypeEquiv he), Nat.card_eq_fintype_card,
      Fintype.card_subtype]
    exact Finset.natCast_card_filter _ _
  rw [hc]
  rw [← (Fin.consEquiv (fun _ : Fin (k + 2) => (Fin 64))).sum_comp
    (fun f => if Good k f then (1 : ℤ) else 0), Fintype.sum_prod_type]
  change (∑ r : (Fin 64), ∑ f : Fin (k + 1) → (Fin 64),
    if Good k (Fin.cons r f) then (1 : ℤ) else 0) = _
  apply Finset.sum_congr rfl
  intro r _
  rw [← (Fin.consEquiv (fun _ : Fin (k + 1) => (Fin 64))).sum_comp
    (fun f => if Good k (Fin.cons r f) then (1 : ℤ) else 0), Fintype.sum_prod_type]
  change (∑ s : (Fin 64), count k r s) = _
  rw [count_eq_u]

