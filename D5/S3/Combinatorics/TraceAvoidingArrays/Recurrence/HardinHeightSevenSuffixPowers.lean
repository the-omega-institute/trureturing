private def c7Powers : Vector (Vector ℤ 50) 49 :=
  prefixPowers ++ suffixPowers

set_option maxHeartbeats 6000000 in
/-- The step from exponent 24 to 25 and all subsequent steps are checked
against the same quotient action as the prefix. -/
private theorem suffixSteps (k : Fin 24) :
    asPowerTable c7Powers (Fin.natAdd 24 k).succ =
      (quotientTransfer c7QuotientRows).mulVec (asPowerTable c7Powers (Fin.natAdd 24 k).castSucc) := by
  fin_cases k <;> (apply List.ofFn_inj.mp; simp only [List.ofFn, quotient_mulVec]; rfl)

/-- The two checked ranges together cover every step from zero to 48. -/
private theorem heightSevenSteps (k : Fin 48) :
    asPowerTable c7Powers k.succ =
      (quotientTransfer c7QuotientRows).mulVec (asPowerTable c7Powers k.castSucc) := by
  refine Fin.addCases (m := 24) (n := 24) (fun i => ?_) suffixSteps k
  have h₁ : i.val < 25 := by have := i.isLt; omega
  have h₂ : i.val + 1 < 25 := by have := i.isLt; omega
  have atPrefix (j : Fin 49) (hj : j.val < 25) :
      asPowerTable c7Powers j = asPowerTable prefixPowers ⟨j.val, hj⟩ := by
    funext a
    change (prefixPowers ++ suffixPowers)[j.val][a.val] = prefixPowers[j.val][a.val]
    rw [Vector.getElem_append_left hj]
  rw [atPrefix (Fin.castAdd 24 i).succ h₂, atPrefix (Fin.castAdd 24 i).castSucc h₁]
  exact prefixSteps i

end D5.S3.Combinatorics.TraceAvoidingArrays.HardinHeightSevenSuffixPowers
