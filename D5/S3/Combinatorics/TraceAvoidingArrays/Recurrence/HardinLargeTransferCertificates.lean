private theorem sum_indicators {K : ℕ} (j : Fin K) (s : Multiset (Fin K)) :
    (s.map (fun i => if i = j then (1 : ℤ) else 0)).sum = (s.count j : ℤ) := by
  induction s using Multiset.induction_on with
  | empty => simp
  | cons a s ih =>
    by_cases h : a = j
    · subst a
      simp [ih, add_comm]
    · simp [h, ih, Ne.symm h]

private theorem quotientPowers {A : Type} [Fintype A] [DecidableEq A] {N K : ℕ}
    (T : Matrix A A ℤ) (encode : A → Fin N) (succs : Fin N → Finset (Fin N))
    (action : ∀ (a : A) (w : Fin N → ℤ),
      (∑ j ∈ succs (encode a), w j) = T.mulVec (fun q => w (encode q)) a)
    (labels : Vector (Fin K) N) (rows : Vector (List (Fin K)) K)
    (same : ∀ a : A,
      ((succs (encode a)).val.map (fun j => labels[j.val])) =
        (rows[(labels[(encode a).val]).val] : Multiset (Fin K)))
    (m : ℕ) (a : A) :
    (T ^ m).mulVec (1 : A → ℤ) a =
      ((quotientTransfer rows) ^ m).mulVec (1 : Fin K → ℤ) labels[(encode a).val] := by
  let cls (a : A) := labels[(encode a).val]
  suffices hrows : ∀ a j, (∑ x : A, if cls x = j then T a x else 0) =
      quotientTransfer rows (cls a) j by
    simpa [cls] using (row_fibres_iff_pow_mulVec T (quotientTransfer rows) cls).mp
      hrows (1 : Fin K → ℤ) m a
  intro a j
  calc
    _ = T.mulVec (fun q => if labels[(encode q).val] = j then 1 else 0) a := by
      simp only [Matrix.mulVec, dotProduct, mul_ite, mul_one, mul_zero]
    _ = ∑ i ∈ succs (encode a), if labels[i.val] = j then (1 : ℤ) else 0 :=
      (action a (fun i => if labels[i.val] = j then 1 else 0)).symm
    _ = _ := by
      change (((succs (encode a)).val.map
        (fun i => if labels[i.val] = j then (1 : ℤ) else 0)).sum) = _
      let weigh : Fin K → ℤ := fun i => if i = j then 1 else 0
      let label : Fin N → Fin K := fun i => labels[i.val]
      have hmap := Multiset.map_map weigh label (succs (encode a)).val
      have hi := congrArg (fun s : Multiset (Fin K) => s.map weigh) (same a)
      exact (congrArg (fun s : Multiset ℤ => s.sum) (hmap.symm.trans hi)).trans
        (sum_indicators j (rows[labels[(encode a).val].val] : Multiset (Fin K)))

private theorem lag_of_table {K d : ℕ} (T : Matrix (Fin K) (Fin K) ℤ) (b : ℕ)
    (c : Fin d → ℤ) (W : Fin (b + d + 1) → Fin K → ℤ)
    (h0 : W 0 = 1) (hs : ∀ k : Fin (b + d), W k.succ = T.mulVec (W k.castSucc))
    (relation : W (Fin.last _) = ∑ j : Fin d, c j • W ⟨b + d - (j.val + 1), by omega⟩) :
    IsLagRelation T b c := by
  have h := TransferMatrix.tabulatedPowers T (b + d) W h0 hs
  unfold IsLagRelation
  have lhs : (T ^ (b + d)).mulVec (1 : Fin K → ℤ) = W (Fin.last _) :=
    h (Fin.last _)
  have rhs (j : Fin d) : (T ^ (b + d - (j.val + 1))).mulVec (1 : Fin K → ℤ) =
      W ⟨b + d - (j.val + 1), by omega⟩ := h ⟨_, _⟩
  simpa only [lhs, rhs] using relation

private theorem lag_from_column_quotient (h : ℕ) {K d : ℕ}
    (labels : Vector (Fin K) (3 ^ (h + 1))) (rows : Vector (List (Fin K)) K)
    (same : ∀ i : Fin (3 ^ (h + 1)),
      (columnSuccessors h i).val.map (fun j => labels[j.val]) =
        (rows[labels[i.val].val] : Multiset (Fin K)))
    (c : Fin d → ℤ) (relation : IsLagRelation (quotientTransfer rows) 1 c) :
    IsLagRelation (C h) 1 c :=
  transportLag (C h) (quotientTransfer rows) (fun p => labels[(code (h + 1) p).val])
    (quotientPowers (C h) (code (h + 1)) (columnSuccessors h) (column_action h) labels rows
      (fun p => same (code (h + 1) p))) 1 c relation

private theorem lag_from_word_quotient (k : ℕ) {K d : ℕ}
    (labels : Vector (Fin K) (3 ^ (k + 1))) (rows : Vector (List (Fin K)) K)
    (same : ∀ i : Fin (3 ^ (k + 1)), proper ((code (k + 1)).symm i) →
      (wordSuccessors true k i).val.map (fun j => labels[j.val]) =
        (rows[labels[i.val].val] : Multiset (Fin K)))
    (c : Fin d → ℤ) (relation : IsLagRelation (quotientTransfer rows) 0 c) :
    IsLagRelation (wordTransfer true k) 0 c :=
  transportLag (wordTransfer true k) (quotientTransfer rows) (fun p => labels[(code (k + 1) p.val).val])
    (quotientPowers (wordTransfer true k) (fun p => code (k + 1) p.val) (wordSuccessors true k)
      (word_action true k) labels rows (fun p => same (code (k + 1) p.val)
        (by simpa only [Equiv.symm_apply_apply] using p.property))) 0 c relation

private theorem check_indices {n : ℕ} (P : Fin n → Prop) [DecidablePred P]
    (h : (List.finRange n).all (fun i => decide (P i)) = true) : ∀ i, P i :=
  fun i => of_decide_eq_true ((List.all_eq_true.mp h) i (List.mem_finRange i))

private theorem check_blocks {m n : ℕ} (P : Fin (m * n) → Prop)
    (h : ∀ i : Fin m, ∀ j : Fin n, P (finProdFinEquiv (i,j))) : ∀ k, P k := by
  intro k
  let e : Fin m × Fin n ≃ Fin (m * n) := finProdFinEquiv
  obtain ⟨⟨i,j⟩, rfl⟩ := e.surjective k
  exact h i j

