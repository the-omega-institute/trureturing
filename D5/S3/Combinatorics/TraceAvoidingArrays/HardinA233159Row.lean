set_option maxHeartbeats 10000000 in
private theorem powers_table : ∀ j : Fin 16,
    (quotient ^ j.val).mulVec (1 : Fin 122 → ℤ) = W j := by
  apply TransferMatrix.tabulatedPowers
  · exact List.ofFn_inj.mp rfl
  · have ht : ∀ k : Fin 15, W k.succ =
        fun i => ((successors i).map (W k.castSucc)).sum := by
      intro k
      fin_cases k <;> exact List.ofFn_inj.mp rfl
    intro k
    funext i
    rw [ht k, quotient_certificate.2.2]

set_option maxHeartbeats 10000000 in
private theorem vector_relation :
    (quotient ^ (6 + 9)).mulVec (1 : Fin 122 → ℤ) =
      ∑ j : Fin 9, (![-4128, 17216, -27636, 21056, -6705, -573, 1038, -283, 30] : Fin 9 → ℤ) j •
        (quotient ^ (6 + j.val)).mulVec (1 : Fin 122 → ℤ) := by
  rw [show 6 + 9 = (15 : Fin 16).val from rfl, powers_table]
  have hh (j : Fin 9) : (quotient ^ (6 + j.val)).mulVec (1 : Fin 122 → ℤ) =
      W ⟨6 + j.val, by omega⟩ := powers_table ⟨6 + j.val, by omega⟩
  simp_rw [hh]
  exact List.ofFn_inj.mp (by decide +kernel)

set_option maxHeartbeats 10000000 in
theorem finite_certificate :
    (∀ r : Row 6, ∀ s : Fin 122,
      (∑ c : Row 6, if columnCompatible r c ∧ classify c = s then (1 : ℤ) else 0) =
        quotient (classify r) s) ∧
    (∀ s : Fin 122, (∑ c : Row 6, if classify c = s then (1 : ℤ) else 0) = weights s) ∧
    (quotient ^ (6 + 9)).mulVec (1 : Fin 122 → ℤ) =
      ∑ j : Fin 9, (![-4128, 17216, -27636, 21056, -6705, -573, 1038, -283, 30] : Fin 9 → ℤ) j •
        (quotient ^ (6 + j.val)).mulVec (1 : Fin 122 → ℤ) :=
  ⟨quotient_certificate.1, quotient_certificate.2.1, vector_relation⟩

set_option maxHeartbeats 10000000 in
private theorem counting_bridge (n : ℕ) :
    (U6 (n + 2) : ℤ) = dotProduct weights
      ((quotient ^ (n + 1)).mulVec (1 : Fin 122 → ℤ)) :=
  count_transfer 6 122 classify quotient weights
    finite_certificate.1 finite_certificate.2.1 n

set_option maxHeartbeats 10000000 in
theorem result (n : ℕ) : (U6 (n + 16) : ℤ) =
    30 * (U6 (n + 15) : ℤ) - 283 * (U6 (n + 14) : ℤ) + 1038 * (U6 (n + 13) : ℤ) - 573 * (U6 (n + 12)
    : ℤ) - 6705 * (U6 (n + 11) : ℤ) + 21056 * (U6 (n + 10) : ℤ) - 27636 * (U6 (n + 9) : ℤ) + 17216 *
    (U6 (n + 8) : ℤ) - 4128 * (U6 (n + 7) : ℤ) := by
  have h := TransferMatrix.scalarRelationShift quotient weights 9 6
    (![-4128, 17216, -27636, 21056, -6705, -573, 1038, -283, 30] : Fin 9 → ℤ) finite_certificate.2.2
    n
  have hb (j : ℕ) : dotProduct weights
      ((quotient ^ (n + 6 + j)).mulVec (1 : Fin 122 → ℤ)) =
        (U6 (n + 6 + j + 1) : ℤ) := by
    rw [show n + 6 + j = (n + 5 + j) + 1 by omega]
    exact (counting_bridge (n + 5 + j)).symm
  simp_rw [hb] at h
  norm_num only [Fin.sum_univ_succ, Fin.val_zero, Fin.val_succ,
    Matrix.cons_val_zero, Matrix.cons_val_succ, Finset.sum_empty,
    add_zero, Nat.add_assoc] at h
  linarith only [h]


