  decide +kernel

private theorem rows_24 : ∀ j : Fin 4, RowChecked ⟨24 + j.val, by omega⟩ := by
  decide +kernel

private theorem rows_28 : ∀ j : Fin 4, RowChecked ⟨28 + j.val, by omega⟩ := by
  decide +kernel

private theorem rows_32 : ∀ j : Fin 4, RowChecked ⟨32 + j.val, by omega⟩ := by
  decide +kernel

private theorem rows_36 : ∀ j : Fin 4, RowChecked ⟨36 + j.val, by omega⟩ := by
