/-- Enumerate every six-cell label row by its base-four code. -/
private def edges (i : Fin 58) : List (Fin 58 × ℤ) :=
  List.ofFn fun code : Fin (4^6) =>
    let q := (finFunctionFinEquiv (m := 4) (n := 6)).symm code
    let k := nativeStage i
    if rowProper q ∧ labelCompatible (nativeRepresentative i) q then
      (nativeClassOf (finalStage (rowFinish (seen k) q)) q, rowWeight (seen k) q)
    else (0, 0)

private abbrev Counts := {v : Array ℤ // v.size = 58}

private def accumulate (counts : Counts) (edge : Fin 58 × ℤ) : Counts :=
  ⟨counts.val.modify edge.1.val (· + edge.2), by simp [counts.property]⟩

private def coordinate (counts : Counts) (j : Fin 58) : ℤ :=
  counts.val[j.val]'(by rw [counts.property]; exact j.isLt)

private theorem coordinate_fold (es : List (Fin 58 × ℤ)) (counts : Counts) (j : Fin 58) :
    coordinate (es.foldl accumulate counts) j =
      coordinate counts j + (es.map fun e => if e.1 = j then e.2 else 0).sum := by
  induction es generalizing counts with
  | nil => simp
  | cons edge es ih =>
    simp only [List.foldl_cons, List.map_cons, List.sum_cons, ih]
    have step :
        coordinate (accumulate counts edge) j =
          coordinate counts j + (if edge.1 = j then edge.2 else 0) := by
      by_cases h : edge.1 = j
      · simp [coordinate, accumulate, h, Array.getElem_modify_self]
      · simp only [h, ite_false, add_zero]
        exact Array.getElem_modify_of_ne
          (fun hv => h (Fin.ext hv)) (· + edge.2) _
    rw [step, add_assoc]

private def outgoingCounts (i : Fin 58) : Counts :=
  (edges i).foldl accumulate ⟨Array.replicate 58 0, by simp⟩

private theorem histogram (i j : Fin 58) :
    coordinate (outgoingCounts i) j = nativeT i j := by
  rw [outgoingCounts, coordinate_fold]
  simp only [coordinate, Array.getElem_replicate, zero_add, edges, List.map_ofFn, List.sum_ofFn]
  rw [nativeT, ← (finFunctionFinEquiv (m := 4) (n := 6)).symm.sum_comp]
  apply Finset.sum_congr rfl
  intro code _
  simp only [Function.comp_apply]
  split_ifs <;> simp_all

private def RowChecked (i : Fin 58) : Prop :=
  (outgoingCounts i).val = Array.ofFn (transition i)

private instance (i : Fin 58) : Decidable (RowChecked i) :=
  inferInstanceAs (Decidable (_ = _))

