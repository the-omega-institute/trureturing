private theorem checked_of_window (start width : ℕ) (bound : start + width ≤ 58)
    (rows : ∀ j : Fin width, RowChecked ⟨start + j.val, by omega⟩)
    (i : Fin 58) (lo : start ≤ i.val) (hi : i.val < start + width) :
    RowChecked i := by
  let j : Fin width := ⟨i.val - start, by omega⟩
  have eq : (⟨start + j.val, by omega⟩ : Fin 58) = i := Fin.ext (by
    change start + (i.val - start) = i.val
    omega)
  exact eq ▸ rows j

private theorem transition_rows (i : Fin 58) : RowChecked i := by
  by_cases h00 : i.val < 4
  · exact checked_of_window 0 4 (by decide) rows_00 i (by omega) (by omega)
  by_cases h04 : i.val < 8
  · exact checked_of_window 4 4 (by decide) rows_04 i (by omega) (by omega)
  by_cases h08 : i.val < 12
  · exact checked_of_window 8 4 (by decide) rows_08 i (by omega) (by omega)
  by_cases h12 : i.val < 16
  · exact checked_of_window 12 4 (by decide) rows_12 i (by omega) (by omega)
  by_cases h16 : i.val < 20
  · exact checked_of_window 16 4 (by decide) rows_16 i (by omega) (by omega)
  by_cases h20 : i.val < 24
  · exact checked_of_window 20 4 (by decide) rows_20 i (by omega) (by omega)
  by_cases h24 : i.val < 28
  · exact checked_of_window 24 4 (by decide) rows_24 i (by omega) (by omega)
  by_cases h28 : i.val < 32
  · exact checked_of_window 28 4 (by decide) rows_28 i (by omega) (by omega)
  by_cases h32 : i.val < 36
  · exact checked_of_window 32 4 (by decide) rows_32 i (by omega) (by omega)
  by_cases h36 : i.val < 40
  · exact checked_of_window 36 4 (by decide) rows_36 i (by omega) (by omega)
  by_cases h40 : i.val < 44
  · exact checked_of_window 40 4 (by decide) rows_40 i (by omega) (by omega)
  by_cases h44 : i.val < 48
  · exact checked_of_window 44 4 (by decide) rows_44 i (by omega) (by omega)
  by_cases h48 : i.val < 52
  · exact checked_of_window 48 4 (by decide) rows_48 i (by omega) (by omega)
  by_cases h52 : i.val < 56
  · exact checked_of_window 52 4 (by decide) rows_52 i (by omega) (by omega)
  exact checked_of_window 56 2 (by decide) rows_56 i (by omega) i.isLt

private theorem exact_transition (i j : Fin 58) : nativeT i j = transition i j := by
  rw [← histogram]
  have h := congrArg (fun v : Array ℤ => v[j.val]?) (show (outgoingCounts i).val = _ from
    transition_rows i)
  have hlt : j.val < (outgoingCounts i).val.size := by
    rw [(outgoingCounts i).property]
    exact j.isLt
  rw [Array.getElem?_eq_getElem hlt, Array.getElem?_eq_getElem (by simp)] at h
  exact (Option.some.inj h).trans (Array.getElem_ofFn _)

private theorem powers_zero : powers 0 = (1 : Fin 58 → ℤ) := by
  apply List.ofFn_inj.mp
  decide +kernel

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
-- The kernel reduces every one-step product of the 58-coordinate vectors.
private theorem powers_step : ∀ k : Fin 23, powers k.succ =
    (transition : Matrix (Fin 58) (Fin 58) ℤ).mulVec (powers k.castSucc) := by
  have h : ∀ k : Fin 23, List.ofFn (powers k.succ) = List.ofFn
      ((transition : Matrix (Fin 58) (Fin 58) ℤ).mulVec (powers k.castSucc)) := by
    decide +kernel
  exact fun k => List.ofFn_inj.mp (h k)

private theorem checked_powers (k : Fin 24) : (nativeT ^ k.val).mulVec (1 : Fin 58 → ℤ) =
    powers k := by
  apply TransferMatrix.tabulatedPowers nativeT 23 powers powers_zero
  intro t
  rw [show nativeT = transition from funext fun i => funext fun j => exact_transition i j]
  exact powers_step t

set_option maxRecDepth 50000 in
set_option maxHeartbeats 0 in
-- The kernel compares all coordinates after taking the 22-term signed sum.
private theorem table_relation : powers 23 =
    ∑ j : Fin 22, lagCoefficient j.rev • powers ⟨1+j.val, by omega⟩ := by
  apply List.ofFn_inj.mp
  decide +kernel

private theorem continuation_relation :
    (nativeT ^ (1+22)).mulVec (1 : Fin 58 → ℤ) =
      ∑ j : Fin 22, lagCoefficient j.rev • (nativeT ^ (1+j.val)).mulVec (1 : Fin 58 → ℤ) := by
  rw [show 1+22 = (23 : Fin 24).val from rfl, checked_powers]
  have h (j : Fin 22) : (nativeT ^ (1+j.val)).mulVec (1 : Fin 58 → ℤ) =
      powers ⟨1+j.val, by omega⟩ := checked_powers ⟨1+j.val, by omega⟩
  simp_rw [h]
  exact table_relation

/-- The literal OEIS recurrence, with signed coefficients ordered by lags one through twenty-two. -/
theorem result (n : ℕ+) (hn : 24 ≤ n.val) :
    (a n : ℤ) =
      ∑ j : Fin 22, lagCoefficient j * (a ⟨n.val - (j.val+1), by omega⟩ : ℤ) := by
  let m := n.val - 24
  have hm : m + 24 = n.val := Nat.sub_add_cancel hn
  have start : (⟨m+1+22+1, by omega⟩ : ℕ+) = n := Subtype.ext (by
    change m + 1 + 22 + 1 = n.val
    omega)
  have lag (j : Fin 22) :
      (⟨m+1+j.rev.val+1, by omega⟩ : ℕ+) = ⟨n.val - (j.val+1), by omega⟩ :=
    Subtype.ext (by
      change m + 1 + j.rev.val + 1 = n.val - (j.val + 1)
      simp only [Fin.val_rev]
      omega)
  have shifted := TransferMatrix.scalarRelationShift nativeT nativeInitial 22 1
    (fun j => lagCoefficient j.rev) continuation_relation m
  simp_rw [← native_linear_bridge] at shifted
  rw [start] at shifted
  rw [← Equiv.sum_comp Fin.revPerm (fun j : Fin 22 =>
    lagCoefficient j.rev * (a ⟨m+1+j.val+1, by omega⟩ : ℤ))] at shifted
  change _ = ∑ j : Fin 22, lagCoefficient j.rev.rev * (a ⟨m+1+j.rev.val+1, by omega⟩ : ℤ)
    at shifted
  simp_rw [Fin.rev_rev, lag] at shifted
  exact shifted

end D5.S3.Combinatorics.TraceAvoidingArrays.ComplementaryPairs.HardinA233200Recurrence
