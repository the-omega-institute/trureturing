def T : Matrix Column Column ℤ := fun p q => if Bond p q then 1 else 0

private def coefficients : Fin 10 → ℤ := ![-36,72,192,-514,93,417,-163,-97,31,6]

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem moves_exact : ∀ p q : Column, q ∈ moves p ↔ Bond p q := by
  decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem moves_nodup : ∀ p : Column, (moves p).Nodup := by
  decide +kernel

private theorem step_fast (w : Column → ℤ) (p : Column) :
    T.mulVec w p = ((moves p).map w).sum := by
  classical
  simp only [Matrix.mulVec, dotProduct, T, ite_mul, one_mul, zero_mul]
  simp_rw [← moves_exact]
  rw [← List.sum_toFinset _ (moves_nodup p)]
  calc
    _ = ∑ q ∈ (moves p).toFinset, (if q ∈ moves p then w q else 0) :=
      Finset.sum_subset (Finset.subset_univ _) (by
        intro q _ hq
        exact if_neg (by simpa using hq)) |>.symm
    _ = _ := Finset.sum_congr rfl (fun q hq => if_pos (by simpa using hq))

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem table_base : table 0 = (1 : Column → ℤ) := by decide +kernel

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem table_steps_fast : ∀ k : Fin 11, ∀ p : Column,
    table k.succ p = ((moves p).map (table k.castSucc)).sum := by
  decide +kernel

private theorem table_steps (k : Fin 11) : table k.succ = T.mulVec (table k.castSucc) := by
  funext p
  rw [step_fast]
  exact table_steps_fast k p

private theorem powers_table (k : Fin 12) : (T ^ k.val).mulVec (1 : Column → ℤ) = table k :=
  TransferMatrix.tabulatedPowers T 11 table table_base table_steps k

set_option maxRecDepth 30000 in
set_option maxHeartbeats 0 in
private theorem table_certificate : ∀ p : Column,
    table 11 p = ∑ j : Fin 10, coefficients j * table ⟨1+j.val, by omega⟩ p := by
  decide +kernel

private theorem vector_certificate :
    (T ^ (1+10)).mulVec (1 : Column → ℤ) =
      ∑ j : Fin 10, coefficients j • (T ^ (1+j.val)).mulVec (1 : Column → ℤ) := by
  change (T ^ 11).mulVec (1 : Column → ℤ) = _
  have h11 : (T ^ 11).mulVec (1 : Column → ℤ) = table 11 := powers_table (11 : Fin 12)
  rw [h11]
  have h (j : Fin 10) : (T ^ (1+j.val)).mulVec (1 : Column → ℤ) =
      table ⟨1+j.val, by omega⟩ := powers_table ⟨1+j.val, by omega⟩
  simp_rw [h]
  funext p
  simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using table_certificate p

/-- The number of continuations from each literal five-cell three-label column. -/
def v (n : ℕ) : Column → ℤ := (T ^ n).mulVec 1

/-- Every linear readout of the exact transfer obeys this relation after its transient. -/
theorem result (w : Column → ℤ) (n : ℕ) :
    dotProduct w (v (n+11)) =
      6 * dotProduct w (v (n+10)) + 31 * dotProduct w (v (n+9)) -
      97 * dotProduct w (v (n+8)) - 163 * dotProduct w (v (n+7)) +
      417 * dotProduct w (v (n+6)) + 93 * dotProduct w (v (n+5)) -
      514 * dotProduct w (v (n+4)) + 192 * dotProduct w (v (n+3)) +
      72 * dotProduct w (v (n+2)) - 36 * dotProduct w (v (n+1)) := by
  have h := TransferMatrix.scalarRelationShift T w 10 1 coefficients vector_certificate n
  norm_num [coefficients, Fin.sum_univ_succ, Nat.add_assoc] at h
  change dotProduct w ((T ^ (n+11)).mulVec 1) = _
  dsimp only [v]
  convert h using 1 <;> ring

