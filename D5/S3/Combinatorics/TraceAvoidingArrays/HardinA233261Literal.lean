private def W (k : Fin 17) (a : Col) : ℤ := table k (cls a)
private theorem table_zero : W 0 = (1 : Col → ℤ) := by
  have h : table 0 = (1 : Fin 122 → ℤ) := List.ofFn_inj.mp rfl
  funext a
  exact congrFun h (cls a)
set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
-- The identity checks all raw states and exact integer table coordinates.
private theorem sparse_steps : ∀ k : Fin 16, ∀ a : Col,
    W k.succ a = ∑ b ∈ next a, W k.castSucc b := by
  decide +kernel
private theorem table_steps (k : Fin 16) : W k.succ = T.mulVec (W k.castSucc) := by
  funext a
  rw [sparse_mulVec]
  exact sparse_steps k a
private theorem powers_table : ∀ k : Fin 17,
    (T^k.val).mulVec (1 : Col → ℤ) = W k :=
  TransferMatrix.tabulatedPowers T 16 W table_zero table_steps
private def coefficients : Fin 10 → ℤ :=
  ![4128,-21344,44852,-48692,27761,-6132,-1611,1321,-313,31]
set_option maxRecDepth 100000 in
set_option maxHeartbeats 20000000 in
-- The identity checks all raw states and exact integer table coordinates.
private theorem power_polynomial : (T^(6+10)).mulVec (1 : Col → ℤ) =
    ∑ j : Fin 10, coefficients j • (T^(6+j.val)).mulVec (1 : Col → ℤ) := by
  rw [show 6+10 = (16 : Fin 17).val from rfl, powers_table]
  have hh (j : Fin 10) : (T^(6+j.val)).mulVec (1 : Col → ℤ) =
      W ⟨6+j.val, by omega⟩ := powers_table ⟨6+j.val, by omega⟩
  simp_rw [hh]
  have h : ∀ i : Fin 122, table 16 i =
      ∑ j : Fin 10, coefficients j * table ⟨6+j.val, by omega⟩ i := by
    decide +kernel
  funext a
  exact h (cls a)


private theorem weights_dot (v : Col → ℤ) :
    dotProduct weights v = dotProduct (1 : Col → ℤ) (T.mulVec v) := by
  simp only [weights, dotProduct, Matrix.mulVec, T, Finset.sum_mul,
    Pi.one_apply, one_mul, ite_mul, zero_mul]
  rw [Finset.sum_comm]
private theorem count_transfer_one (n : ℕ) :
    (L (n+2) : ℤ) = dotProduct (1 : Col → ℤ)
      ((T^(n+1)).mulVec (1 : Col → ℤ)) := by
  rw [count_transfer, weights_dot, Matrix.mulVec_mulVec, ← pow_succ']

private theorem pair_tail (n : ℕ) : (L (n+17) : ℤ) + 6 =
    31 * ((L (n+16) : ℤ) + 6) -
      313 * ((L (n+15) : ℤ) + 6) +
      1321 * ((L (n+14) : ℤ) + 6) -
      1611 * ((L (n+13) : ℤ) + 6) -
      6132 * ((L (n+12) : ℤ) + 6) +
      27761 * ((L (n+11) : ℤ) + 6) -
      48692 * ((L (n+10) : ℤ) + 6) +
      44852 * ((L (n+9) : ℤ) + 6) -
      21344 * ((L (n+8) : ℤ) + 6) +
      4128 * ((L (n+7) : ℤ) + 6) := by
  have h := TransferMatrix.scalarRelationShift T (1 : Col → ℤ)
    10 6 coefficients power_polynomial n
  have ht (k : ℕ) : dotProduct (1 : Col → ℤ)
      ((T^(k+1)).mulVec (1 : Col → ℤ)) = (L (k+2) : ℤ) :=
    (count_transfer_one k).symm
  have e0 : n+6+10 = (n+15)+1 := by omega
  have ej (j : Fin 10) : n+6+j.val = (n+5+j.val)+1 := by omega
  rw [e0, ht] at h
  simp_rw [ej, ht] at h
  norm_num [coefficients, Fin.sum_univ_succ, Nat.add_assoc] at h
  linear_combination h

private theorem scale_recurrence (m : ℕ) (hm : 2 ≤ m)
    (h : (L (m + 10) : ℤ) + 6 =
      31 * ((L (m + 9) : ℤ) + 6) -
      313 * ((L (m + 8) : ℤ) + 6) +
      1321 * ((L (m + 7) : ℤ) + 6) -
      1611 * ((L (m + 6) : ℤ) + 6) -
      6132 * ((L (m + 5) : ℤ) + 6) +
      27761 * ((L (m + 4) : ℤ) + 6) -
      48692 * ((L (m + 3) : ℤ) + 6) +
      44852 * ((L (m + 2) : ℤ) + 6) -
      21344 * ((L (m + 1) : ℤ) + 6) +
      4128 * ((L (m + 0) : ℤ) + 6)) :
    (a (m + 10) : ℤ) =
      1984 * (a (m + 9) : ℤ) -
      1282048 * (a (m + 8) : ℤ) +
      346292224 * (a (m + 7) : ℤ) -
      27028094976 * (a (m + 6) : ℤ) -
      6584184864768 * (a (m + 5) : ℤ) +
      1907721393668096 * (a (m + 4) : ℤ) -
      214149680718675968 * (a (m + 3) : ℤ) +
      12624715655426342912 * (a (m + 2) : ℤ) -
      384499321786383466496 * (a (m + 1) : ℤ) +
      4759259971017064316928 * (a (m + 0) : ℤ) := by
  have hb (i : ℕ) : 48 * (a (m+i) : ℤ) =
      (64 : ℤ)^m * 64^i * ((L (m+i) : ℤ) + 6) := by
    rw [← pow_add]
    exact counting_bridge (by omega)
  have h0 := hb 0
  have h1 := hb 1
  have h2 := hb 2
  have h3 := hb 3
  have h4 := hb 4
  have h5 := hb 5
  have h6 := hb 6
  have h7 := hb 7
  have h8 := hb 8
  have h9 := hb 9
  have h10 := hb 10
  norm_num only [Nat.add_zero, pow_zero, pow_one, mul_one] at h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10
  apply (mul_left_cancel₀ (show (48 : ℤ) ≠ 0 by norm_num))
  linear_combination h10 - 1984*h9 + 1282048*h8 - 346292224*h7 + 27028094976*h6 + 6584184864768*h5 - 1907721393668096*h4 + 214149680718675968*h3 - 12624715655426342912*h2 + 384499321786383466496*h1 - 4759259971017064316928*h0 + (64 : ℤ)^m*1152921504606846976*h

private theorem shifted (k : ℕ) :
    (a (k+17) : ℤ) =
      1984 * (a (k+16) : ℤ) -
      1282048 * (a (k+15) : ℤ) +
      346292224 * (a (k+14) : ℤ) -
      27028094976 * (a (k+13) : ℤ) -
      6584184864768 * (a (k+12) : ℤ) +
      1907721393668096 * (a (k+11) : ℤ) -
      214149680718675968 * (a (k+10) : ℤ) +
      12624715655426342912 * (a (k+9) : ℤ) -
      384499321786383466496 * (a (k+8) : ℤ) +
      4759259971017064316928 * (a (k+7) : ℤ) := by
  have h := scale_recurrence (k+7) (by omega) (by
    simpa only [Nat.add_assoc] using pair_tail k)
  simpa only [Nat.add_assoc, Nat.add_zero] using h

/-- The complete original recurrence, with literal finite counts and its exact onset. -/
