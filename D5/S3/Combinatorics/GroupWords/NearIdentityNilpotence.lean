/- GID: D5/S3/Combinatorics/GroupWords/NearIdentityNilpotence
   generality: G
   mirror-B: D5/B/S3/Combinatorics/GroupWords/NearIdentityNilpotence
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: [mathlib/module/Mathlib.Analysis.Normed.Ring.Basic]
   utility: none
   digest: Identity isolation makes the subgroup generated near one nilpotent. -/

import D5.S3.Combinatorics.GroupWords.UniformCommutatorNilpotence
import Mathlib.Analysis.Normed.Ring.Basic
import Mathlib.Analysis.SpecificLimits.Basic

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.GroupWords.NearIdentityNilpotence

open scoped commutatorElement
open Filter

/-- A group represented in normed-ring units with a positive identity isolation gap
has a nilpotent subgroup generated by its represented elements within `1/16` of one.
Neither finite generation nor completeness of the ring is required. -/
theorem result {G R : Type*} [Group G] [NormedRing R] [NormOneClass R]
    (f : G →* Rˣ) (ε : ℝ) (hε : 0 < ε)
    (hgap : ∀ g : G, ‖(f g : R) - 1‖ < ε → g = 1) :
    Group.IsNilpotent (Subgroup.closure {g : G | ‖(f g : R) - 1‖ ≤ 1 / 16}) := by
  let size : G → ℝ := fun g => ‖(f g : R) - 1‖
  have hinv : ∀ u : Rˣ, ‖(u : R) - 1‖ ≤ 1 / 16 → ‖(↑u⁻¹ : R)‖ ≤ 2 := by
    intro u hu
    have hid : (↑u⁻¹ : R) = 1 - ((u : R) - 1) * (↑u⁻¹ : R) := by
      simp [sub_mul]
    have hbound : ‖(↑u⁻¹ : R)‖ ≤ 1 + ‖(u : R) - 1‖ * ‖(↑u⁻¹ : R)‖ := by
      calc
        ‖(↑u⁻¹ : R)‖ = ‖1 - ((u : R) - 1) * (↑u⁻¹ : R)‖ := congrArg norm hid
        _ ≤ ‖(1 : R)‖ + ‖((u : R) - 1) * (↑u⁻¹ : R)‖ := norm_sub_le _ _
        _ ≤ 1 + ‖(u : R) - 1‖ * ‖(↑u⁻¹ : R)‖ := by
          rw [norm_one]
          gcongr
          exact norm_mul_le _ _
    have hm := mul_le_mul_of_nonneg_right hu (norm_nonneg (↑u⁻¹ : R))
    linarith
  have hstep : ∀ a z : G, size a ≤ 1 / 16 → size z ≤ 1 / 16 →
      size ⁅a, z⁆ ≤ (1 / 2) * size z := by
    intro a z ha hz
    have hai := hinv (f a) ha
    have hzi := hinv (f z) hz
    calc
      size ⁅a, z⁆ ≤ 2 * ‖(↑(f a)⁻¹ : R)‖ * ‖(↑(f z)⁻¹ : R)‖ * size a * size z := by
        simpa only [size, commutatorElement_def, map_mul, map_inv] using
          norm_commutator_units_sub_one_le (f a) (f z)
      _ ≤ 2 * 2 * 2 * (1 / 16) * size z := by
        dsimp only [size] at *
        gcongr
      _ = (1 / 2) * size z := by ring
  have hword : ∀ (l : List G), (∀ a ∈ l, size a ≤ 1 / 16) →
      ∀ b : G, size b ≤ 1 / 16 →
      size (l.foldl (fun z a => ⁅a, z⁆) b) ≤ (1 / 2 : ℝ) ^ l.length * size b := by
    intro l
    induction l with
    | nil => intro hl b hb; simp
    | cons a l ih =>
        intro hl b hb
        have ha := hl a (by simp)
        have hs := hstep a b ha hb
        have hc : size ⁅a, b⁆ ≤ 1 / 16 := by linarith
        calc
          size ((a :: l).foldl (fun z a => ⁅a, z⁆) b) ≤
              (1 / 2 : ℝ) ^ l.length * size ⁅a, b⁆ :=
            ih (fun x hx => hl x (by simp [hx])) ⁅a, b⁆ hc
          _ ≤ (1 / 2 : ℝ) ^ l.length * ((1 / 2) * size b) := by gcongr
          _ = (1 / 2 : ℝ) ^ (a :: l).length * size b := by
            simp only [List.length_cons, pow_succ]
            ring
  have hlim : Tendsto (fun n : ℕ => (1 / 2 : ℝ) ^ n / 16) atTop (nhds 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
      (by norm_num : (1 / 2 : ℝ) < 1)).div_const 16
  obtain ⟨N, hN⟩ := (hlim.eventually (gt_mem_nhds hε)).exists
  apply UniformCommutatorNilpotence.result _ N
  intro l hl hlen b hb
  apply hgap
  change size (l.foldl (fun z a => ⁅a, z⁆) b) < ε
  calc
    size (l.foldl (fun z a => ⁅a, z⁆) b) ≤ (1 / 2 : ℝ) ^ N * size b := by
      simpa only [hlen] using hword l hl b hb
    _ ≤ (1 / 2 : ℝ) ^ N * (1 / 16) :=
      mul_le_mul_of_nonneg_left hb (pow_nonneg (by norm_num) N)
    _ = (1 / 2 : ℝ) ^ N / 16 := by ring
    _ < ε := hN

end D5.S3.Combinatorics.GroupWords.NearIdentityNilpotence
