   utility: kind=certified-instance; basis=refutes=gid:D5/S3/Combinatorics/ShrunkenGrassmannianConjectureFifteenRefutation.claim; result=D5/S3/Combinatorics/ShrunkenGrassmannianConjectureFifteenRefutation.result; claim=D5/S3/Combinatorics/ShrunkenGrassmannianConjectureFifteenRefutation.claim
