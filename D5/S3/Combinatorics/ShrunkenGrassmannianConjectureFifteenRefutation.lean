import D5.S3.Combinatorics.ShrunkenGrassmannianThreeCycleDiameter

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.ShrunkenGrassmannianConjectureFifteenRefutation

open D5.S3.Combinatorics.ShrunkenGrassmannianThreeCycleDiameter
  (rotL rotR Step IsVertex)
open D5.S3.ConceptDynamics.Completion.CommutingCompletionExchange (normalWord)
open D5.S1.Digit.Carry.ListInversions (inv inv_window)

/-!
Chervov et al., *CayleyPy-4*, arXiv:2603.22195v1, Conjecture 15 (not inverse-closed case): the
diameters of the Schreier coset graphs `S_n / (S_l × S_{n-l})` generated by consecutive `k`-cycles,
without their inverses, are quasipolynomials in `n` and `t = n - (l + 1)`; its `k = 5` clause reads
"for all `L ≥ 4`, starting from `t + 1 ≥ 9`, that is `N ≥ L + 9`:
`D(L, N) = L ⌊(t + 1) / 4⌋ + 1_{(t + 1) ≡ 0 (mod 4)}`". Vertices and the central state are those of
`ShrunkenGrassmannianThreeCycleDiameter`. The cycle acts on a word either by rotating its window
left or right, depending on the convention; both conventions and both readings of the diameter are
covered. The clause fails at `L = 4`, `N = 13`.
-/

/-- One move of the directed graph: the cycle on a window of `k` consecutive positions, acting by
`rotL` (`left = true`) or by `rotR` (`left = false`). -/
def StepDir (left : Bool) (k : ℕ) (x y : List Bool) : Prop :=
  ∃ i, i + k ≤ x.length ∧ y = if left then rotL k i x else rotR k i x

/-- `ReachDir left k m x y`: `y` is reached from `x` in at most `m` directed moves. -/
def ReachDir (left : Bool) (k : ℕ) : ℕ → List Bool → List Bool → Prop
  | 0, x, y => y = x
  | m + 1, x, y => ReachDir left k m x y ∨ ∃ z, ReachDir left k m x z ∧ StepDir left k z y

/-- The largest directed distance from the central state. -/
noncomputable def eccDir (left : Bool) (k L N : ℕ) : ℕ :=
  sInf {m | ∀ y, IsVertex L N y → ReachDir left k m (normalWord L (N - L)) y}

/-- The directed diameter. -/
noncomputable def diamDir (left : Bool) (k L N : ℕ) : ℕ :=
  sInf {m | ∀ x y, IsVertex L N x → IsVertex L N y → ReachDir left k m x y}

/-- The `k = 5` clause of Conjecture 15 under a reading `D k L N` of the diameter, with
`t + 1 = N - L`. -/
def clauseFive (D : ℕ → ℕ → ℕ → ℕ) : Prop :=
  ∀ L N : ℕ, 4 ≤ L → L + 9 ≤ N →
    D 5 L N = L * ((N - L) / 4) + (if (N - L) % 4 = 0 then 1 else 0)

/-- The `k = 5` clause of Conjecture 15 holds for one action convention and one reading. -/
def claim : Prop := ∃ left : Bool, clauseFive (eccDir left) ∨ clauseFive (diamDir left)

/-- The `k = 5` clause of Conjecture 15 fails at `L = 4`, `N = 13` under either convention and
either reading: the reversal `1^9 0^4` is at least 9 moves from the central state, while the
clause gives `4 ⌊9 / 4⌋ = 8`. -/
theorem result : ¬ claim := by
  -- a rotation of five consecutive letters changes the inversion count by at most 4
  have inv_rot5 : ∀ (P S : List ℕ) (a b c d e : ℕ), a ≤ 1 → b ≤ 1 → c ≤ 1 → d ≤ 1 → e ≤ 1 →
      inv (P ++ [b, c, d, e, a] ++ S) ≤ inv (P ++ [a, b, c, d, e] ++ S) + 4 ∧
        inv (P ++ [e, a, b, c, d] ++ S) ≤ inv (P ++ [a, b, c, d, e] ++ S) + 4 := by
    intro P S a b c d e ha hb hc hd he
    rw [inv_window, inv_window, inv_window]
    rcases (show a = 0 ∨ a = 1 by omega) with rfl | rfl <;>
    rcases (show b = 0 ∨ b = 1 by omega) with rfl | rfl <;>
    rcases (show c = 0 ∨ c = 1 by omega) with rfl | rfl <;>
    rcases (show d = 0 ∨ d = 1 by omega) with rfl | rfl <;>
    rcases (show e = 0 ∨ e = 1 by omega) with rfl | rfl <;>
    simp [inv] <;> omega
  have step_inv : ∀ (x y : List Bool), Step 5 x y →
      inv (y.map Bool.toNat) ≤ inv (x.map Bool.toNat) + 4 := by
    intro x y ⟨i, hi, hy⟩
    obtain ⟨a, b, c, d, e, v, hv⟩ :
        ∃ a b c d e : Bool, ∃ v, x.drop i = a :: b :: c :: d :: e :: v := by
      match h : x.drop i with
      | a :: b :: c :: d :: e :: v => exact ⟨a, b, c, d, e, v, rfl⟩
      | [] => simp at h; omega
      | [_] => have := congrArg List.length h; simp at this; omega
      | [_, _] => have := congrArg List.length h; simp at this; omega
      | [_, _, _] => have := congrArg List.length h; simp at this; omega
      | [_, _, _, _] => have := congrArg List.length h; simp at this; omega
    obtain ⟨u, hu, hx⟩ : ∃ u : List Bool, u.length = i ∧ x = u ++ a :: b :: c :: d :: e :: v :=
      ⟨x.take i, by simp; omega, by rw [← hv, List.take_append_drop]⟩
    subst hu hx
    have hL : rotL 5 u.length (u ++ a :: b :: c :: d :: e :: v) = u ++ [b, c, d, e, a] ++ v := by
      simp only [rotL, List.take_left, List.drop_append,
        List.drop_eq_nil_of_le (show u.length ≤ u.length + 5 by omega), List.nil_append]
      simp [List.rotate]
    have hR : rotR 5 u.length (u ++ a :: b :: c :: d :: e :: v) = u ++ [e, a, b, c, d] ++ v := by
      simp only [rotR, List.take_left, List.drop_append,
        List.drop_eq_nil_of_le (show u.length ≤ u.length + 5 by omega), List.nil_append]
      simp [List.rotate]
    have key := inv_rot5 (u.map Bool.toNat) (v.map Bool.toNat) a.toNat b.toNat c.toNat d.toNat
      e.toNat (Bool.toNat_le a) (Bool.toNat_le b) (Bool.toNat_le c) (Bool.toNat_le d)
      (Bool.toNat_le e)
    have hx : (u ++ a :: b :: c :: d :: e :: v).map Bool.toNat =
        u.map Bool.toNat ++ [a.toNat, b.toNat, c.toNat, d.toNat, e.toNat] ++ v.map Bool.toNat := by
      simp
    rcases hy with rfl | rfl
    · rw [hL, hx]; simpa using key.1
    · rw [hR, hx]; simpa using key.2
  have dir_step : ∀ (left : Bool) (x y : List Bool), StepDir left 5 x y → Step 5 x y := by
    intro left x y ⟨i, hi, hy⟩
    cases left
    · exact ⟨i, hi, Or.inr hy⟩
    · exact ⟨i, hi, Or.inl hy⟩
  have reach_inv : ∀ (left : Bool) (m : ℕ) (x y : List Bool), ReachDir left 5 m x y →
      inv (y.map Bool.toNat) ≤ inv (x.map Bool.toNat) + 4 * m := by
    intro left m
    induction m with
    | zero => intro x y h; rw [show y = x from h]; omega
    | succ m ih =>
      intro x y h
      rcases h with h | ⟨z, hz, hzy⟩
      · have := ih x y h; omega
      · have h1 := ih x z hz
        have h2 := step_inv z y (dir_step left z y hzy)
        omega
  let rev : List Bool := List.replicate 9 true ++ List.replicate 4 false
  have hrev : IsVertex 4 13 rev := ⟨rfl, rfl⟩
  have hcen : IsVertex 4 13 (normalWord 4 (13 - 4)) := ⟨rfl, rfl⟩
  have hinv_rev : inv (rev.map Bool.toNat) = 36 := by decide
  have hinv_cen : inv ((normalWord 4 (13 - 4)).map Bool.toNat) = 0 := by decide
  have far : ∀ (left : Bool) (m : ℕ), ReachDir left 5 m (normalWord 4 (13 - 4)) rev → 9 ≤ m := by
    intro left m h
    have := reach_inv left m _ _ h
    omega
  have hecc : ∀ left : Bool, eccDir left 5 4 13 ≠ 8 := by
    intro left h
    have hne :
        {m | ∀ y, IsVertex 4 13 y → ReachDir left 5 m (normalWord 4 (13 - 4)) y}.Nonempty := by
      by_contra hem
      rw [Set.not_nonempty_iff_eq_empty] at hem
      simp [eccDir, hem] at h
    have hmem := Nat.sInf_mem hne
    rw [show sInf {m | ∀ y, IsVertex 4 13 y → ReachDir left 5 m (normalWord 4 (13 - 4)) y} = 8
      from h] at hmem
    have := far left 8 (hmem _ hrev)
    omega
  have hdiam : ∀ left : Bool, diamDir left 5 4 13 ≠ 8 := by
    intro left h
    have hne :
        {m | ∀ x y, IsVertex 4 13 x → IsVertex 4 13 y → ReachDir left 5 m x y}.Nonempty := by
      by_contra hem
      rw [Set.not_nonempty_iff_eq_empty] at hem
      simp [diamDir, hem] at h
    have hmem := Nat.sInf_mem hne
    rw [show sInf {m | ∀ x y, IsVertex 4 13 x → IsVertex 4 13 y → ReachDir left 5 m x y} = 8
      from h] at hmem
    have := far left 8 (hmem _ _ hcen hrev)
    omega
  rintro ⟨left, h | h⟩
  · exact hecc left (by simpa using h 4 13 le_rfl le_rfl)
  · exact hdiam left (by simpa using h 4 13 le_rfl le_rfl)

end D5.S3.Combinatorics.ShrunkenGrassmannianConjectureFifteenRefutation
