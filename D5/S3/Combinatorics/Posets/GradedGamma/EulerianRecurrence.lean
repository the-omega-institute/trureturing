/- GID: D5/S3/Combinatorics/Posets/GradedGamma/EulerianRecurrence
   generality: G
   mirror-B: D5/B/S3/Combinatorics/Posets/GradedGamma/EulerianRecurrence
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: [mathlib/module/Mathlib.Algebra.Polynomial.Derivative]
   utility: none
   digest: Eulerian insertion recurrence preserves the nonnegative gamma cone. -/

import D5.S3.Combinatorics.Posets.GradedGamma.GammaBasis
import Mathlib.Algebra.Polynomial.Derivative

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.Posets.GradedGamma

open scoped BigOperators
open Polynomial
noncomputable section

/-- The Eulerian differential recurrence, indexed so that `E 0 = 1`. -/
def eulerianRecurrence : ℕ → Polynomial ℤ
  | 0 => 1
  | n + 1 => (1 + C ((n + 1 : ℕ) : ℤ) * X) * eulerianRecurrence n +
      X * (1 - X) * (eulerianRecurrence n).derivative

/-- Gamma coefficients generated by the Eulerian insertion recurrence. -/
def eulerianGamma : ℕ → ℕ → ℕ
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | n + 1, 0 => eulerianGamma n 0
  | n + 1, j + 1 =>
      (j + 2) * eulerianGamma n (j + 1) +
        (2 * n - 4 * j) * eulerianGamma n j

private theorem eulerianGamma_support (n j : ℕ) (h : n < 2 * j) :
    eulerianGamma n j = 0 := by
  induction n generalizing j with
  | zero =>
      cases j with
      | zero => omega
      | succ j => rfl
  | succ n ih =>
      cases j with
      | zero => omega
      | succ j =>
          simp only [eulerianGamma]
          have hfirst : eulerianGamma n (j + 1) = 0 :=
            ih (j + 1) (by omega)
          rw [hfirst, mul_zero, zero_add]
          by_cases hj : n < 2 * j
          · rw [ih j hj, mul_zero]
          · have hz : 2 * n - 4 * j = 0 := by omega
            rw [hz, zero_mul]

/-- The recurrence has a nonnegative integral gamma expansion in every degree. -/
theorem eulerian_recurrence_gamma (n : ℕ) :
    eulerianRecurrence n =
      ∑ j ∈ Finset.range (n + 1),
        C ((eulerianGamma n j : ℕ) : ℤ) * gammaTerm ℤ n j := by
  have eulerian_step_basis (n i : ℕ) (hi : 2 * i ≤ n) :
      (1 + C ((n + 1 : ℕ) : ℤ) * X) * gammaTerm ℤ n i +
        X * (1 - X) * (gammaTerm ℤ n i).derivative =
      C ((i + 1 : ℕ) : ℤ) * gammaTerm ℤ (n + 1) i +
        C ((2 * n - 4 * i : ℕ) : ℤ) * gammaTerm ℤ (n + 1) (i + 1) := by
    obtain ⟨k, rfl⟩ : ∃ k, n = 2 * i + k := ⟨n - 2 * i, by omega⟩
    have hni : 2 * i + k - 2 * i = k := by omega
    have hni' : 2 * i + k + 1 - 2 * i = k + 1 := by omega
    have hni'' : 2 * i + k + 1 - 2 * (i + 1) = k - 1 := by omega
    have hc : 2 * (2 * i + k) - 4 * i = 2 * k := by omega
    simp only [gammaTerm, hni, hni', hni'', hc, derivative_mul,
      derivative_pow, derivative_add, derivative_one, derivative_X, zero_add]
    by_cases hi0 : i = 0
    · subst i
      simp only [zero_add, mul_zero, pow_zero, one_mul, Nat.zero_sub,
        Nat.reduceMul] at *
      by_cases hk0 : k = 0
      · subst k
        norm_num
      · have hk : 0 < k := Nat.pos_of_ne_zero hk0
        have hp : (1 + X : Polynomial ℤ) ^ k =
            (1 + X) ^ (k - 1) * (1 + X) := by
          rw [← pow_succ, Nat.sub_add_cancel hk]
        simp only [hp, map_natCast]
        push_cast
        have hyplus : (1 + X : Polynomial ℤ) ^ (k + 1) =
            (1 + X) ^ (k - 1) * (1 + X) ^ 2 := by
          rw [pow_succ, hp]
          ring
        rw [hyplus]
        ring
    · have hii : 0 < i := Nat.pos_of_ne_zero hi0
      have hx : (X : Polynomial ℤ) ^ i = X ^ (i - 1) * X := by
        rw [← pow_succ, Nat.sub_add_cancel hii]
      by_cases hk0 : k = 0
      · subst k
        norm_num at *
        rw [hx]
        ring
      · have hk : 0 < k := Nat.pos_of_ne_zero hk0
        have hp : (1 + X : Polynomial ℤ) ^ k =
            (1 + X) ^ (k - 1) * (1 + X) := by
          rw [← pow_succ, Nat.sub_add_cancel hk]
        simp only [hx, hp, map_natCast]
        push_cast
        have hyplus : (1 + X : Polynomial ℤ) ^ (k + 1) =
            (1 + X) ^ (k - 1) * (1 + X) ^ 2 := by
          rw [pow_succ, hp]
          ring
        have hxplus : (X : Polynomial ℤ) ^ (i + 1) = X ^ (i - 1) * X ^ 2 := by
          rw [pow_succ, hx]
          ring
        rw [hyplus, hxplus]
        ring
  induction n with
  | zero =>
      simp [eulerianRecurrence, eulerianGamma, gammaTerm]
  | succ n ih =>
      rw [eulerianRecurrence, ih]
      rw [Finset.mul_sum, map_sum, Finset.mul_sum]
      rw [← Finset.sum_add_distrib]
      have hstep :
          ∑ i ∈ Finset.range (n + 1),
            ((1 + C ((n + 1 : ℕ) : ℤ) * X) *
              (C ((eulerianGamma n i : ℕ) : ℤ) * gammaTerm ℤ n i) +
             X * (1 - X) *
              (C ((eulerianGamma n i : ℕ) : ℤ) * gammaTerm ℤ n i).derivative) =
          ∑ i ∈ Finset.range (n + 1),
            C ((eulerianGamma n i : ℕ) : ℤ) *
              (C ((i + 1 : ℕ) : ℤ) * gammaTerm ℤ (n + 1) i +
               C ((2 * n - 4 * i : ℕ) : ℤ) * gammaTerm ℤ (n + 1) (i + 1)) := by
        apply Finset.sum_congr rfl
        intro i hi
        by_cases his : 2 * i ≤ n
        · rw [derivative_C_mul]
          calc
            _ = C ((eulerianGamma n i : ℕ) : ℤ) *
                ((1 + C ((n + 1 : ℕ) : ℤ) * X) * gammaTerm ℤ n i +
                 X * (1 - X) * (gammaTerm ℤ n i).derivative) := by ring
            _ = _ := by rw [eulerian_step_basis n i his]
        · have hzero := eulerianGamma_support n i (by omega)
          simp [hzero]
      rw [hstep]
      simp only [mul_add, Finset.sum_add_distrib]
      let A : ℕ → Polynomial ℤ := fun j =>
        C ((eulerianGamma n j : ℕ) : ℤ) *
          (C ((j + 1 : ℕ) : ℤ) * gammaTerm ℤ (n + 1) j)
      let B : ℕ → Polynomial ℤ := fun j =>
        C ((eulerianGamma n j : ℕ) : ℤ) *
          (C ((2 * n - 4 * j : ℕ) : ℤ) * gammaTerm ℤ (n + 1) (j + 1))
      have hA : (∑ j ∈ Finset.range (n + 1), A j) =
          A 0 + ∑ j ∈ Finset.range (n + 1), A (j + 1) := by
        rw [Finset.sum_range_succ' A n]
        rw [Finset.sum_range_succ]
        have hzero : A (n + 1) = 0 := by
          simp [A, eulerianGamma_support n (n + 1) (by omega)]
        simp only [hzero, add_zero]
        exact add_comm _ _
      change (∑ j ∈ Finset.range (n + 1), A j) +
          (∑ j ∈ Finset.range (n + 1), B j) = _
      rw [hA, Finset.sum_range_succ' (fun j =>
        C ((eulerianGamma (n + 1) j : ℕ) : ℤ) * gammaTerm ℤ (n + 1) j) (n + 1)]
      have hhead : A 0 = C ((eulerianGamma (n + 1) 0 : ℕ) : ℤ) *
          gammaTerm ℤ (n + 1) 0 := by simp [A, eulerianGamma]
      rw [hhead]
      have htail : (∑ j ∈ Finset.range (n + 1), A (j + 1)) +
          (∑ j ∈ Finset.range (n + 1), B j) =
          ∑ j ∈ Finset.range (n + 1),
            C ((eulerianGamma (n + 1) (j + 1) : ℕ) : ℤ) *
              gammaTerm ℤ (n + 1) (j + 1) := by
        rw [← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro j hj
        simp only [A, B, eulerianGamma, Nat.cast_add, Nat.cast_mul,
          map_add, map_mul]
        norm_num
        ring
      calc
        _ = (∑ j ∈ Finset.range (n + 1), A (j + 1)) +
            (∑ j ∈ Finset.range (n + 1), B j) +
            C ((eulerianGamma (n + 1) 0 : ℕ) : ℤ) *
              gammaTerm ℤ (n + 1) 0 := by ac_rfl
        _ = _ := by rw [htail]

end
end D5.S3.Combinatorics.Posets.GradedGamma
