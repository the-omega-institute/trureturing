private theorem K_nonsingular : K.det ≠ 0 := by
  letI : Fact (1 < (7 : ℕ)) := ⟨by decide⟩
  intro h
  have hn := Matrix.det_ne_zero_of_left_inverse inverse_mod_seven
  apply hn
  have hdet : (Int.castRingHom (ZMod 7)) K.det =
      (K.map (Int.castRingHom (ZMod 7))).det :=
    (Int.castRingHom (ZMod 7)).map_det K
  rw [← K_reduction, ← hdet, h, map_zero]

private theorem charpoly_A : A.charpoly = p := by
  exact (Matrix.charpoly_eq_of_mul_eq_mul K_nonsingular intertwine).trans companion_charpoly


private theorem explicit_matrix : explicitD = A := by
  decide +kernel

private theorem charpoly_sixteen : (D 16).charpoly = p := by
  rw [D_sixteen, explicit_matrix]
  exact charpoly_A

/-- The path on sixteen vertices refutes Conjecture 29. -/

theorem result : ¬ claim := by
  intro h
  have hmax : ∀ i : ℕ, i ≤ 2 * 16 - 4 →
      |(D 16).charpoly.coeff i| ≤ |(D 16).charpoly.coeff 16| := by
    intro i hi
    simp only [charpoly_sixteen]
    have hi30 : i < 30 := by omega
    simp only [p, Polynomial.ofFn_coeff_eq_val_of_lt co hi30,
      Polynomial.ofFn_coeff_eq_val_of_lt co (by decide : 16 < 30)]
    have hfinite : ∀ j : Fin 29, |co j.castSucc| ≤ |co 16| := by
      decide +kernel
    exact hfinite ⟨i, by omega⟩
  have hf := h 16 (by decide) 16 (by decide) hmax
  norm_num at hf

end D5.S3.Combinatorics.SpectralGraph.JanaMahatoSivasubramanianPeakRefutation
