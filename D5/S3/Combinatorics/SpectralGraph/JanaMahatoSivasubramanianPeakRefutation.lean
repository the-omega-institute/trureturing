private def p : ℤ[X] := Polynomial.ofFn 30 co

private theorem p_degree : p.natDegree = 29 := by
  apply Polynomial.natDegree_eq_of_le_of_coeff_ne_zero
  · exact Nat.le_of_lt_succ (Polynomial.ofFn_natDegree_lt (by decide) co)
  · rw [p, Polynomial.ofFn_coeff_eq_val_of_lt co (by decide)]
    norm_num [co]

private theorem p_monic : p.Monic := by
  rw [Polynomial.Monic, Polynomial.leadingCoeff, p_degree]
  rw [p, Polynomial.ofFn_coeff_eq_val_of_lt co (by decide)]
  norm_num [co]

private def Cmp : Matrix (Fin 29) (Fin 29) ℤ := fun i j =>
  if j.val + 1 = 29 then -co ⟨i.val, by omega⟩ else if i.val = j.val + 1 then 1 else 0

private theorem companion_charpoly : Cmp.charpoly = p := by
  let q : ℝ[X] := p.map (Int.castRingHom ℝ)
  have hq : q.Monic := p_monic.map _
  have hd : q.natDegree = 29 := by
    rw [Polynomial.natDegree_map_eq_of_injective
      (Int.cast_injective : Function.Injective (Int.castRingHom ℝ)), p_degree]
  have hb := D5.S3.Constants.Moments.CoefficientDrivenJacobiCharacteristicPolynomial.multiplication_matrix_charpoly q hq
  have hc : (Cmp.map (Int.castRingHom ℝ)) =
      (D5.S3.Constants.Moments.CoefficientDrivenJacobiCharacteristicPolynomial.coefficientMultiplicationMatrix q).reindex (finCongr hd) (finCongr hd) := by
    ext i j
    change ((Cmp i j : ℤ) : ℝ) =
      (if j.val + 1 = q.natDegree then -q.coeff i.val else
        if i.val = j.val + 1 then 1 else 0)
    rw [hd]
    simp [Cmp, q, p, show i.val < 30 by omega]
  apply Polynomial.map_injective (Int.castRingHom ℝ) (Int.cast_injective : Function.Injective (Int.castRingHom ℝ))
  rw [← Matrix.charpoly_map, hc, Matrix.charpoly_reindex, hb]

