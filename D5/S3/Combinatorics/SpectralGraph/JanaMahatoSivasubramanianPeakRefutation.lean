private theorem steiner_of_bounds {n a b : ℕ} {S : Finset ℕ}
    (ha : 1 ≤ a) (hab : a ≤ b) (hbn : b ≤ n)
    (haS : a ∈ S) (hbS : b ∈ S)
    (hS : ∀ v ∈ S, a ≤ v ∧ v ≤ b) : steiner n S = b - a := by
  unfold steiner
  apply le_antisymm
  · exact csInf_le (OrderBot.bddBelow _) ⟨a, b, ha, hab, hbn, rfl, hS⟩
  · refine le_csInf ?_ ?_
    · exact ⟨b-a, a, b, ha, hab, hbn, rfl, hS⟩
    · rintro k ⟨c, d, hc, hcd, hdn, rfl, h⟩
      have hca := (h a haS).1
      have hbd := (h b hbS).2
      exact tsub_le_tsub hbd hca

private def explicitD : Matrix (Fin 29) (Fin 29) ℤ := fun i j =>
  ((max (i.val / 2 + if i.val % 2 = 0 then 2 else 3)
        (j.val / 2 + if j.val % 2 = 0 then 2 else 3) -
     min (i.val / 2 + 1) (j.val / 2 + 1) : ℕ) : ℤ)

private theorem D_sixteen : D 16 = explicitD := by
  ext i j
  unfold D explicitD
  congr 1
  apply steiner_of_bounds
  all_goals revert i j; decide +kernel

