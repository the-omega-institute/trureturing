import D5.S3.Constants.Moments.CoefficientDrivenJacobiCharacteristicPolynomial
import Mathlib.Algebra.Polynomial.OfFn

/-! Binding conventions for S. Jana, I. Mahato and S. Sivasubramanian, "Unimodality and peak location of the
characteristic polynomials of two distance matrices of trees", arXiv:2407.03309v1 (Comput. Appl. Math. 44 (2025)
223), Remark (basis of P_n), the matrix `𝔇_{P_n} := 𝔇_2(P_n)[B, B]` and Conjecture 29. -/

namespace D5.S3.Combinatorics.SpectralGraph.JanaMahatoSivasubramanianPeakRefutation

/-- The 2-Steiner distance on the path `P_n` (vertices `1, …, n`, edges `{i, i+1}`): the minimum number of edges
among all connected subtrees of `P_n` whose vertex set contains `S`. The connected subtrees of `P_n` are the
subpaths on `{a, …, b}`, with `b - a` edges. -/
noncomputable def steiner (n : ℕ) (S : Finset ℕ) : ℕ :=
  sInf {k | ∃ a b : ℕ, 1 ≤ a ∧ a ≤ b ∧ b ≤ n ∧ b - a = k ∧ ∀ v ∈ S, a ≤ v ∧ v ≤ b}

/-- The ordered basis `B = (e_1, f_1, e_2, f_2, …, e_{n-2}, f_{n-2}, e_{n-1})`, with `e_i = {i, i+1}` and
`f_j = {j, j+2}`. -/
def basis (n : ℕ) (t : Fin (2 * n - 3)) : Finset ℕ :=
  if t.val % 2 = 0 then {t.val / 2 + 1, t.val / 2 + 2} else {t.val / 2 + 1, t.val / 2 + 3}

/-- `𝔇_{P_n} = 𝔇_2(P_n)[B, B]`: the entry in row `{i, j}` and column `{k, l}` is the 2-Steiner distance of
`{i, j, k, l}`. -/
noncomputable def D (n : ℕ) : Matrix (Fin (2 * n - 3)) (Fin (2 * n - 3)) ℤ :=
  fun t u => (steiner n (basis n t ∪ basis n u) : ℤ)

/-- Conjecture 29: "For a path `P_n` on `n > 5` vertices, if `CharPoly_{𝔇_{P_n}}(x) = Σ_{i=0}^{2n-3} a_i x^i` and
`|a_ℓ| = max{|a_0|, |a_1|, …, |a_{2n-4}|}`, then `ℓ = n - 1`." -/
def claim : Prop :=
  ∀ n : ℕ, 5 < n → ∀ ℓ : ℕ, ℓ ≤ 2 * n - 4 →
    (∀ i : ℕ, i ≤ 2 * n - 4 → |(D n).charpoly.coeff i| ≤ |(D n).charpoly.coeff ℓ|) → ℓ = n - 1

end D5.S3.Combinatorics.SpectralGraph.JanaMahatoSivasubramanianPeakRefutation

