namespace D5.S3.Combinatorics.SpectralGraph.IdealIntersectionSpectralTransport

/-- The literal nonzero proper ideals, without a chosen enumeration. -/
abbrev IdealVertex (n : ℕ) := {I : Ideal (ZMod n) // I ≠ ⊥ ∧ I ≠ ⊤}

/-- Distinct actual ideals are joined precisely when their intersection is nonzero. -/
def idealGraph (n : ℕ) : SimpleGraph (IdealVertex n) where
  Adj I J := I ≠ J ∧ I.val ⊓ J.val ≠ ⊥
  symm := ⟨by intro I J h; exact ⟨h.1.symm, by simpa [inf_comm] using h.2⟩⟩
  loopless := ⟨by intro I h; exact h.1 rfl⟩

/-- A bounded three-coordinate exponent vector. -/
abbrev Box (k : Fin 3 → ℕ) := ∀ i, Fin (k i + 1)

def primeProduct (p t : Fin 3 → ℕ) : ℕ := ∏ i, p i ^ t i

private lemma primeProduct_ne_zero (p t : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) : primeProduct p t ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr fun i _ => pow_ne_zero _ (hp i).ne_zero

private lemma product_factorization (p t : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) :
    (primeProduct p t).factorization = ∑ i, Finsupp.single (p i) (t i) := by
  rw [primeProduct, Nat.factorization_prod (fun i _ => pow_ne_zero _ (hp i).ne_zero)]
  exact Finset.sum_congr rfl fun i _ => (hp i).factorization_pow

private lemma product_factorization_at (p t : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p) (i : Fin 3) :
    (primeProduct p t).factorization (p i) = t i := by
  rw [product_factorization p t hp, Finsupp.finsetSum_apply]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    exact Finsupp.single_eq_of_ne' (fun h => hji (hi h))
  · simp

private lemma product_factorization_outside (p t : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (x : ℕ) (hx : x ∉ Set.range p) :
    (primeProduct p t).factorization x = 0 := by
  rw [product_factorization p t hp, Finsupp.finsetSum_apply]
  apply Finset.sum_eq_zero
  intro i _
  exact Finsupp.single_eq_of_ne' (fun h => hx ⟨i, h⟩)

private lemma product_dvd_iff (p s t : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p) :
    primeProduct p s ∣ primeProduct p t ↔ ∀ i, s i ≤ t i := by
  constructor
  · intro h i
    have hle := (Nat.factorization_le_iff_dvd
      (primeProduct_ne_zero p s hp) (primeProduct_ne_zero p t hp)).mpr h
    simpa only [product_factorization_at p s hp hi,
      product_factorization_at p t hp hi] using hle (p i)
  · intro h
    exact Finset.prod_dvd_prod_of_dvd _ _ fun i _ => Nat.pow_dvd_pow (p i) (h i)

private lemma divisor_has_coordinates (p k : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p)
    (d : ℕ) (hd : d ∣ primeProduct p k) :
    ∃ α : Box k, primeProduct p (fun i => (α i).val) = d := by
  have hn := primeProduct_ne_zero p k hp
  have hd0 := ne_zero_of_dvd_ne_zero hn hd
  have hle := (Nat.factorization_le_iff_dvd hd0 hn).mpr hd
  let α : Box k := fun i => ⟨d.factorization (p i), by
    have := hle (p i)
    rw [product_factorization_at p k hp hi] at this
    omega⟩
  refine ⟨α, Nat.eq_of_factorization_eq (primeProduct_ne_zero p _ hp) hd0 ?_⟩
  intro x
  by_cases hx : x ∈ Set.range p
  · obtain ⟨i, rfl⟩ := hx
    exact product_factorization_at p _ hp hi i
  · have hzero := product_factorization_outside p k hp x hx
    have hdzero : d.factorization x = 0 := Nat.eq_zero_of_le_zero (hzero ▸ hle x)
    rw [product_factorization_outside p _ hp x hx, hdzero]

/-- The ideal generated by the image of a natural number. -/
def divisorIdeal (n d : ℕ) : Ideal (ZMod n) :=
  Ideal.map (Int.castRingHom (ZMod n)) (Ideal.span {(d : ℤ)})

private lemma comap_divisorIdeal (n d : ℕ) (hd : d ∣ n) :
    Ideal.comap (Int.castRingHom (ZMod n)) (divisorIdeal n d) =
      Ideal.span {(d : ℤ)} := by
  rw [divisorIdeal, Ideal.comap_map_of_surjective _ ZMod.intCast_surjective]
  apply sup_eq_left.mpr
  rw [← RingHom.ker_eq_comap_bot, ZMod.ker_intCastRingHom,
    Ideal.span_singleton_le_span_singleton, Int.natCast_dvd_natCast]
  exact hd

private lemma divisorIdeal_le_iff (n d e : ℕ) (hd : d ∣ n) (he : e ∣ n) :
    divisorIdeal n d ≤ divisorIdeal n e ↔ e ∣ d := by
  rw [← Ideal.comap_le_comap_iff_of_surjective
    (Int.castRingHom (ZMod n)) ZMod.intCast_surjective,
    comap_divisorIdeal n d hd, comap_divisorIdeal n e he,
    Ideal.span_singleton_le_span_singleton, Int.natCast_dvd_natCast]

private lemma ideal_has_divisor (n : ℕ) (I : Ideal (ZMod n)) :
    ∃ d : ℕ, d ∣ n ∧ divisorIdeal n d = I := by
  let J := Ideal.comap (Int.castRingHom (ZMod n)) I
  obtain ⟨g, hg⟩ := Submodule.IsPrincipal.principal J
  have hspan : Ideal.span {(g.natAbs : ℤ)} = J := (Int.span_natAbs g).trans hg.symm
  have hnmem : (n : ℤ) ∈ J := by
    simp [J, Ideal.mem_comap]
  have hd : g.natAbs ∣ n := by
    rw [← hspan, Ideal.mem_span_singleton] at hnmem
    exact Int.natCast_dvd_natCast.mp hnmem
  refine ⟨g.natAbs, hd, ?_⟩
  rw [divisorIdeal, hspan]
  exact Ideal.map_comap_of_surjective _ ZMod.intCast_surjective I

/-- The actual ideal represented by a bounded exponent vector. -/
def coordinateIdeal (p k : Fin 3 → ℕ) (α : Box k) :
    Ideal (ZMod (primeProduct p k)) :=
  divisorIdeal (primeProduct p k) (primeProduct p fun i => (α i).val)

private lemma coordinate_dvd (p k : Fin 3 → ℕ) (α : Box k) :
    primeProduct p (fun i => (α i).val) ∣ primeProduct p k := by
  exact Finset.prod_dvd_prod_of_dvd _ _ fun i _ =>
    Nat.pow_dvd_pow (p i) (Nat.le_of_lt_succ (α i).isLt)

private lemma coordinate_le_iff (p k : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p) (α β : Box k) :
    coordinateIdeal p k α ≤ coordinateIdeal p k β ↔ ∀ i, β i ≤ α i := by
  rw [coordinateIdeal, coordinateIdeal,
    divisorIdeal_le_iff _ _ _ (coordinate_dvd p k α) (coordinate_dvd p k β),
    product_dvd_iff p _ _ hp hi]
  rfl

private lemma coordinate_bijective (p k : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p) :
    Function.Bijective (coordinateIdeal p k) := by
  constructor
  · intro α β h
    exact funext fun i => le_antisymm
      ((coordinate_le_iff p k hp hi β α).mp h.ge i)
      ((coordinate_le_iff p k hp hi α β).mp h.le i)
  · intro I
    obtain ⟨d, hd, hI⟩ := ideal_has_divisor (primeProduct p k) I
    obtain ⟨α, hα⟩ := divisor_has_coordinates p k hp hi d hd
    exact ⟨α, by simpa [coordinateIdeal, hα] using hI⟩

def zeroCoordinate (k : Fin 3 → ℕ) : Box k := fun i => ⟨0, Nat.succ_pos _⟩
def lastCoordinate (k : Fin 3 → ℕ) : Box k := fun i => ⟨k i, Nat.lt_succ_self _⟩

private lemma coordinate_top (p k : Fin 3 → ℕ) :
    coordinateIdeal p k (zeroCoordinate k) = ⊤ := by
  have hz : primeProduct p (fun i => (zeroCoordinate k i).val) = 1 := by
    simp [primeProduct, zeroCoordinate]
  unfold coordinateIdeal divisorIdeal
  rw [hz]
  change Ideal.map (Int.castRingHom (ZMod (primeProduct p k)))
    (Ideal.span {(1 : ℤ)}) = ⊤
  rw [Ideal.span_singleton_one]
  exact Ideal.map_top _

private lemma coordinate_bot (p k : Fin 3 → ℕ) :
    coordinateIdeal p k (lastCoordinate k) = ⊥ := by
  apply Ideal.comap_injective_of_surjective (Int.castRingHom _) ZMod.intCast_surjective
  change Ideal.comap (Int.castRingHom (ZMod (primeProduct p k)))
    (divisorIdeal (primeProduct p k) (primeProduct p k)) = _
  rw [comap_divisorIdeal _ _ (dvd_refl _), ← RingHom.ker_eq_comap_bot,
    ZMod.ker_intCastRingHom]

private lemma coordinate_inf (p k : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p) (α β : Box k) :
    coordinateIdeal p k α ⊓ coordinateIdeal p k β =
      coordinateIdeal p k (fun i => max (α i) (β i)) := by
  apply le_antisymm
  · obtain ⟨γ, hγ⟩ := (coordinate_bijective p k hp hi).surjective
      (coordinateIdeal p k α ⊓ coordinateIdeal p k β)
    rw [← hγ]
    apply (coordinate_le_iff p k hp hi _ _).mpr
    intro i
    apply max_le
    · exact (coordinate_le_iff p k hp hi _ _).mp (hγ.le.trans inf_le_left) i
    · exact (coordinate_le_iff p k hp hi _ _).mp (hγ.le.trans inf_le_right) i
  · exact le_inf
      ((coordinate_le_iff p k hp hi _ _).mpr fun i => le_max_left _ _)
      ((coordinate_le_iff p k hp hi _ _).mpr fun i => le_max_right _ _)

abbrev ExponentVertex (k : Fin 3 → ℕ) :=
  {α : Box k // α ≠ zeroCoordinate k ∧ α ≠ lastCoordinate k}

/-- Unique exponent enumeration of every actual nonzero proper ideal. -/
def idealEquiv (p k : Fin 3 → ℕ) (hp : ∀ i, (p i).Prime)
    (hi : Function.Injective p) : ExponentVertex k ≃ IdealVertex (primeProduct p k) :=
  Equiv.subtypeEquiv (Equiv.ofBijective (coordinateIdeal p k)
    (coordinate_bijective p k hp hi)) (by
      intro α
      change (α ≠ zeroCoordinate k ∧ α ≠ lastCoordinate k) ↔
        (coordinateIdeal p k α ≠ ⊥ ∧ coordinateIdeal p k α ≠ ⊤)
      have hinj := (coordinate_bijective p k hp hi).injective
      simp only [ne_eq]
      rw [show coordinateIdeal p k α = ⊥ ↔ α = lastCoordinate k from
        ⟨fun h => hinj (h.trans (coordinate_bot p k).symm), fun h => h ▸ coordinate_bot p k⟩,
        show coordinateIdeal p k α = ⊤ ↔ α = zeroCoordinate k from
        ⟨fun h => hinj (h.trans (coordinate_top p k).symm), fun h => h ▸ coordinate_top p k⟩]
      exact and_comm)

/-- A prime belongs to the support exactly when its exponent is not maximal. -/
def support (k : Fin 3 → ℕ) (α : Box k) : Finset (Fin 3) :=
  Finset.univ.filter fun i => (α i).val < k i

private lemma support_inf (p k : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p) (α β : Box k) :
    coordinateIdeal p k α ⊓ coordinateIdeal p k β ≠ ⊥ ↔
      (support k α ∩ support k β).Nonempty := by
  rw [coordinate_inf p k hp hi]
  have hbot : coordinateIdeal p k (fun i => max (α i) (β i)) = ⊥ ↔
      (fun i => max (α i) (β i)) = lastCoordinate k := by
    exact ⟨fun h => (coordinate_bijective p k hp hi).injective
      (h.trans (coordinate_bot p k).symm), fun h => h ▸ coordinate_bot p k⟩
  rw [ne_eq, hbot]
  constructor
  · intro h
    have : ∃ i, max (α i) (β i) ≠ lastCoordinate k i := Function.ne_iff.mp h
    obtain ⟨i, hi⟩ := this
    have hn : max (α i).val (β i).val ≠ k i := by
      intro heq
      apply hi
      apply Fin.ext
      simpa only [Fin.val_max, lastCoordinate] using heq
    have hm : max (α i).val (β i).val < k i := by
      have ha := (α i).isLt
      have hb := (β i).isLt
      omega
    refine ⟨i, Finset.mem_inter.mpr ⟨?_, ?_⟩⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, (max_lt_iff.mp hm).1⟩
    · exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, (max_lt_iff.mp hm).2⟩
  · rintro ⟨i, hi⟩ h
    have hh := congrArg (fun f => (f i).val) h
    have hi' := Finset.mem_inter.mp hi
    simp only [support, Finset.mem_filter, Finset.mem_univ, true_and] at hi'
    simp only [lastCoordinate, Fin.val_max] at hh
    omega

/-- The graph correspondence retains both exclusions and the distinctness clause. -/
theorem actual_adjacency (p k : Fin 3 → ℕ)
    (hp : ∀ i, (p i).Prime) (hi : Function.Injective p) (α β : ExponentVertex k) :
    (idealGraph (primeProduct p k)).Adj (idealEquiv p k hp hi α)
      (idealEquiv p k hp hi β) ↔
    α ≠ β ∧ (support k α.val ∩ support k β.val).Nonempty := by
  change (_ ≠ _ ∧ coordinateIdeal p k α.val ⊓ coordinateIdeal p k β.val ≠ ⊥) ↔ _
  rw [(idealEquiv p k hp hi).injective.ne_iff, support_inf p k hp hi]

private lemma support_zero (k : Fin 3 → ℕ) (hk : ∀ i, 0 < k i) :
    support k (zeroCoordinate k) = Finset.univ := by
  apply Finset.ext
  intro i
  constructor
  · intro _
    exact Finset.mem_univ i
  · intro _
    change i ∈ Finset.univ.filter (fun j : Fin 3 => 0 < k j)
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ i, hk i⟩

private lemma support_last (k : Fin 3 → ℕ) :
    support k (lastCoordinate k) = ∅ := by
  simp [support, lastCoordinate]

private lemma support_nonempty (k : Fin 3 → ℕ) (α : ExponentVertex k) :
    (support k α.val).Nonempty := by
  by_contra h
  apply α.property.2
  funext i
  apply Fin.ext
  have hh : ¬ (α.val i).val < k i := by
    intro hi
    exact h ⟨i, by simp [support, hi]⟩
  have := (α.val i).isLt
  simp only [lastCoordinate]
  omega

private def coordinateFiberEquiv (k : Fin 3 → ℕ) (s : Finset (Fin 3)) (i : Fin 3) :
    {x : Fin (k i + 1) // (x.val < k i ↔ i ∈ s)} ≃
      (if i ∈ s then Fin (k i) else Unit) := by
  by_cases hi : i ∈ s
  · rw [if_pos hi]
    exact {
      toFun := fun x => ⟨x.val.val, x.property.mpr hi⟩
      invFun := fun x => ⟨⟨x.val, Nat.lt_succ_of_lt x.isLt⟩,
        ⟨fun _ => hi, fun _ => x.isLt⟩⟩
      left_inv := by intro x; rfl
      right_inv := by intro x; rfl }
  · rw [if_neg hi]
    exact {
      toFun := fun _ => ()
      invFun := fun _ => ⟨⟨k i, Nat.lt_succ_self _⟩, by simp [hi]⟩
      left_inv := by
        intro x
        apply Subtype.ext
        apply Fin.ext
        have hx := x.val.isLt
        have hn : ¬ x.val.val < k i := fun h => hi (x.property.mp h)
        simp only
        omega
      right_inv := by intro x; cases x; rfl }

private def supportBoxEquiv (k : Fin 3 → ℕ) (s : Finset (Fin 3)) :
    {α : Box k // support k α = s} ≃
      ∀ i, {x : Fin (k i + 1) // (x.val < k i ↔ i ∈ s)} where
  toFun α i := ⟨α.val i, by
    have h := Finset.ext_iff.mp α.property i
    simpa [support] using h⟩
  invFun α := ⟨fun i => (α i).val, by
    ext i
    simpa [support] using (α i).property⟩
  left_inv := by intro α; rfl
  right_inv := by intro α; rfl

private lemma support_box_card (k : Fin 3 → ℕ) (s : Finset (Fin 3)) :
    Fintype.card {α : Box k // support k α = s} =
      ∏ i, if i ∈ s then k i else 1 := by
  classical
  rw [Fintype.card_congr (supportBoxEquiv k s), Fintype.card_pi]
  apply Finset.prod_congr rfl
  intro i _
  rw [← Nat.card_eq_fintype_card, Nat.card_congr (coordinateFiberEquiv k s i)]
  by_cases hi : i ∈ s <;> simp [hi, Nat.card_eq_fintype_card]

private def properSupportEquiv (k : Fin 3 → ℕ) (hk : ∀ i, 0 < k i)
    (s : Finset (Fin 3)) (hs : s.Nonempty) (hfull : s ≠ Finset.univ) :
    {α : ExponentVertex k // support k α.val = s} ≃
      {α : Box k // support k α = s} where
  toFun α := ⟨α.val.val, α.property⟩
  invFun α := ⟨⟨α.val, ⟨by
    intro h
    exact hfull ((α.property.symm.trans (congrArg (support k) h)).trans (support_zero k hk)), by
    intro h
    have : s = ∅ := (α.property.symm.trans (congrArg (support k) h)).trans (support_last k)
    exact Finset.nonempty_iff_ne_empty.mp hs this⟩⟩, α.property⟩
  left_inv := by intro α; rfl
  right_inv := by intro α; rfl

/-- The six proper nonempty supports in the quotient's original order. -/
def properSupports : Fin 6 → Finset (Fin 3) :=
  ![{0}, {1}, {2}, {0, 1}, {0, 2}, {1, 2}]

/-- Every support cell is an actual ideal fiber, pulled back through the proved enumeration. -/
def actualSupport (p k : Fin 3 → ℕ) (hp : ∀ i, (p i).Prime)
    (hi : Function.Injective p) (I : IdealVertex (primeProduct p k)) : Finset (Fin 3) :=
  support k (idealEquiv p k hp hi |>.symm I).val

private def actualFiberEquiv (p k : Fin 3 → ℕ) (hp : ∀ i, (p i).Prime)
    (hi : Function.Injective p) (s : Finset (Fin 3)) :
    {I : IdealVertex (primeProduct p k) // actualSupport p k hp hi I = s} ≃
      {α : ExponentVertex k // support k α.val = s} :=
  Equiv.subtypeEquiv (idealEquiv p k hp hi).symm (by intro I; rfl)

/-- Exact cardinalities of the six actual proper-support fibers. -/
theorem proper_fiber_card (p k : Fin 3 → ℕ) (hp : ∀ i, (p i).Prime)
    (hi : Function.Injective p) (hk : ∀ i, 0 < k i) (j : Fin 6) :
    Nat.card {I : IdealVertex (primeProduct p k) //
      actualSupport p k hp hi I = properSupports j} =
      (![k 0, k 1, k 2, k 0 * k 1, k 0 * k 2, k 1 * k 2] : Fin 6 → ℕ) j := by
  classical
  let s := properSupports j
  have hs : s.Nonempty := by fin_cases j <;> simp [s, properSupports]
  have hfull : s ≠ Finset.univ := by fin_cases j <;> decide
  rw [Nat.card_congr (actualFiberEquiv p k hp hi s),
    Nat.card_congr (properSupportEquiv k hk s hs hfull),
    Nat.card_eq_fintype_card, support_box_card]
  fin_cases j <;> simp [s, properSupports, Fin.prod_univ_succ]

private def fullSupportEquiv (k : Fin 3 → ℕ) (hk : ∀ i, 0 < k i) :
    {α : ExponentVertex k // support k α.val = Finset.univ} ≃
      {α : ∀ i, Fin (k i) // α ≠ fun i => (⟨0, hk i⟩ : Fin (k i))} where
  toFun α := ⟨fun i => ⟨(α.val.val i).val, by
    have : i ∈ support k α.val.val := by rw [α.property]; exact Finset.mem_univ i
    simpa [support] using this⟩, by
    intro h
    apply α.val.property.1
    funext i
    apply Fin.ext
    exact congrArg (fun f => (f i).val) h⟩
  invFun α := ⟨⟨fun i => ⟨(α.val i).val, Nat.lt_succ_of_lt (α.val i).isLt⟩, ⟨by
    intro h
    apply α.property
    funext i
    apply Fin.ext
    exact congrArg (fun f => (f i).val) h, by
    intro h
    have hh := congrArg (fun f => (f 0).val) h
    have ht := (α.val 0).isLt
    simp only [lastCoordinate] at hh
    omega⟩⟩, by ext i; simp [support, (α.val i).isLt]⟩
  left_inv := by intro α; rfl
  right_inv := by intro α; rfl

/-- The full-support class has `abc - 1` actual ideals, including an empty class at `abc = 1`. -/
theorem full_fiber_card (p k : Fin 3 → ℕ) (hp : ∀ i, (p i).Prime)
    (hi : Function.Injective p) (hk : ∀ i, 0 < k i) :
    Nat.card {I : IdealVertex (primeProduct p k) //
      actualSupport p k hp hi I = Finset.univ} = k 0 * k 1 * k 2 - 1 := by
  classical
  rw [Nat.card_congr (actualFiberEquiv p k hp hi Finset.univ),
    Nat.card_congr (fullSupportEquiv k hk), Nat.card_eq_fintype_card,
    Fintype.card_subtype_compl, Fintype.card_subtype_eq, Fintype.card_pi]
  simp [Fin.prod_univ_succ, mul_assoc]

/-! The following realization is on actual ideals. The six-coordinate matrices
are restrictions of the displayed graph operators, rather than assumptions
about an unspecified equitable partition. No positivity of `abc - 1` is used. -/

private lemma properSupports_nonempty (j : Fin 6) :
    (properSupports j).Nonempty := by fin_cases j <;> decide

private lemma properSupports_ne_full (j : Fin 6) :
    properSupports j ≠ Finset.univ := by fin_cases j <;> decide

private lemma properSupports_injective : Function.Injective properSupports := by
  decide

private lemma properSupports_exhaust (s : Finset (Fin 3))
    (hs : s.Nonempty) (ht : s ≠ Finset.univ) :
    ∃ j : Fin 6, properSupports j = s := by
  have h : ∀ t : Finset (Fin 3), t.Nonempty → t ≠ Finset.univ →
      ∃ j : Fin 6, properSupports j = t := by decide
  exact h s hs ht

/-- The six cell sizes, as natural numbers in the existing quotient order. -/
def cellSizes (k : Fin 3 → ℕ) : Fin 6 → ℕ :=
  ![k 0, k 1, k 2, k 0 * k 1, k 0 * k 2, k 1 * k 2]

def properOrder (k : Fin 3 → ℕ) : ℕ :=
  k 0 + k 1 + k 2 + k 0 * k 1 + k 0 * k 2 + k 1 * k 2

def universalOrder (k : Fin 3 → ℕ) : ℕ := k 0 * k 1 * k 2 - 1

def totalOrder (k : Fin 3 → ℕ) : ℕ := properOrder k + universalOrder k

private lemma cellSizes_pos (k : Fin 3 → ℕ) (hk : ∀ i, 0 < k i) (j : Fin 6) :
    0 < cellSizes k j := by
  fin_cases j
  · exact hk 0
  · exact hk 1
  · exact hk 2
  · exact Nat.mul_pos (hk 0) (hk 1)
  · exact Nat.mul_pos (hk 0) (hk 2)
  · exact Nat.mul_pos (hk 1) (hk 2)

private lemma cellSizes_cast (k : Fin 3 → ℕ) :
    (fun j => (cellSizes k j : ℝ)) =
      SixSupportLaplacianLowRoot.weights (k 0) (k 1) (k 2) := by
  ext j
  fin_cases j <;> simp [cellSizes, SixSupportLaplacianLowRoot.weights]

private lemma sum_cellSizes (k : Fin 3 → ℕ) :
    ∑ j, cellSizes k j = properOrder k := by
  simp [cellSizes, properOrder, Fin.sum_univ_succ, add_assoc]

/-- The complement quotient is the already delivered literal `C`. -/
def complementQuotient (k : Fin 3 → ℕ) : Matrix (Fin 6) (Fin 6) ℝ :=
  SixSupportLaplacianLowRoot.quotient (k 0) (k 1) (k 2)

/-- The proper-support intersection Laplacian quotient `B`. -/
def intersectionQuotient (k : Fin 3 → ℕ) : Matrix (Fin 6) (Fin 6) ℝ :=
  (properOrder k : ℝ) • (1 : Matrix (Fin 6) (Fin 6) ℝ) -
    (Matrix.of (fun (_ : Fin 6) j => (cellSizes k j : ℝ))) - complementQuotient k

private lemma complementQuotient_action (k : Fin 3 → ℕ) (v : Fin 6 → ℝ) (i : Fin 6) :
    (complementQuotient k *ᵥ v) i =
      ∑ j, if Disjoint (properSupports i) (properSupports j)
        then (cellSizes k j : ℝ) * (v i - v j) else 0 := by
  fin_cases i <;>
    simp [complementQuotient, SixSupportLaplacianLowRoot.quotient,
      properSupports, cellSizes, Matrix.mulVec, dotProduct, Fin.sum_univ_succ] <;> ring

private lemma intersectionQuotient_action (k : Fin 3 → ℕ) (v : Fin 6 → ℝ) (i : Fin 6) :
    (intersectionQuotient k *ᵥ v) i =
      ∑ j, if (properSupports i ∩ properSupports j).Nonempty
        then (cellSizes k j : ℝ) * (v i - v j) else 0 := by
  have hsum : (properOrder k : ℝ) = ∑ j, (cellSizes k j : ℝ) := by
    exact_mod_cast (sum_cellSizes k).symm
  simp only [intersectionQuotient, Matrix.sub_mulVec, Matrix.smul_mulVec,
    Matrix.one_mulVec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  change (properOrder k : ℝ) * v i - (∑ j, (cellSizes k j : ℝ) * v j) -
    (complementQuotient k *ᵥ v) i = _
  rw [hsum, Finset.sum_mul, ← Finset.sum_sub_distrib,
    complementQuotient_action, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro j _
  by_cases h : Disjoint (properSupports i) (properSupports j)
  · have hn : ¬(properSupports i ∩ properSupports j).Nonempty := by
      simpa [Finset.disjoint_iff_inter_eq_empty, Finset.nonempty_iff_ne_empty] using h
    simp [h, hn]
    ring
  · have hn : (properSupports i ∩ properSupports j).Nonempty := by
      simpa [Finset.disjoint_iff_inter_eq_empty, Finset.nonempty_iff_ne_empty] using h
    simp [h, hn]
    ring

private lemma quotient_reflection (k : Fin 3 → ℕ) :
    intersectionQuotient k + complementQuotient k =
      (properOrder k : ℝ) • (1 : Matrix (Fin 6) (Fin 6) ℝ) -
        (Matrix.of (fun (_ : Fin 6) j => (cellSizes k j : ℝ))) := by
  simp [intersectionQuotient]

private lemma laplacian_sum {X : Type*} [Fintype X] [DecidableEq X]
    (G : SimpleGraph X) [DecidableRel G.Adj] (f : X → ℝ) (x : X) :
    (G.lapMatrix ℝ *ᵥ f) x = ∑ y, if G.Adj x y then f x - f y else 0 := by
  rw [SimpleGraph.lapMatrix_mulVec_apply']
  rw [SimpleGraph.neighborFinset_eq_filter, Finset.sum_filter]

private lemma sum_cell_function {X : Type*} [Fintype X]
    (d : X → Fin 6) (g : Fin 6 → ℝ) :
    ∑ x, g (d x) = ∑ j, (Fintype.card {x // d x = j} : ℝ) * g j := by
  classical
  rw [← Fintype.sum_fiberwise' d g]
  simp

private def reindexBox (k : Fin 3 → ℕ) (sigma : Equiv.Perm (Fin 3)) :
    Box k ≃ Box (fun i => k (sigma i)) where
  toFun α i := α (sigma i)
  invFun β i := ⟨(β (sigma.symm i)).val, by
    simpa only [sigma.apply_symm_apply] using (β (sigma.symm i)).isLt⟩
  left_inv := by
    intro α
    funext i
    apply Fin.ext
    change (α (sigma (sigma.symm i))).val = (α i).val
    rw [sigma.apply_symm_apply]
  right_inv := by
    intro β
    funext i
    apply Fin.ext
    change (β (sigma.symm (sigma i))).val = (β i).val
    rw [sigma.symm_apply_apply]

private def reindexVertex (k : Fin 3 → ℕ) (sigma : Equiv.Perm (Fin 3)) :
    ExponentVertex k ≃ ExponentVertex (fun i => k (sigma i)) :=
  Equiv.subtypeEquiv (reindexBox k sigma) (by
    intro α
    have hz : reindexBox k sigma (zeroCoordinate k) =
        zeroCoordinate (fun i => k (sigma i)) := by ext i; rfl
    have hl : reindexBox k sigma (lastCoordinate k) =
        lastCoordinate (fun i => k (sigma i)) := by ext i; rfl
    change (α ≠ zeroCoordinate k ∧ α ≠ lastCoordinate k) ↔ _
    rw [← hz, ← hl, (reindexBox k sigma).injective.ne_iff,
      (reindexBox k sigma).injective.ne_iff])

private lemma support_overlap (k : Fin 3 → ℕ) (α β : Box k) :
    (support k α ∩ support k β).Nonempty ↔
      ∃ i, (α i).val < k i ∧ (β i).val < k i := by
  simp [Finset.Nonempty, support]

private lemma reindex_overlap (k : Fin 3 → ℕ) (sigma : Equiv.Perm (Fin 3))
    (α β : ExponentVertex k) :
    (support (fun i => k (sigma i)) (reindexVertex k sigma α).val ∩
      support (fun i => k (sigma i)) (reindexVertex k sigma β).val).Nonempty ↔
      (support k α.val ∩ support k β.val).Nonempty := by
  rw [support_overlap, support_overlap]
  change (∃ i, (α.val (sigma i)).val < k (sigma i) ∧
      (β.val (sigma i)).val < k (sigma i)) ↔ _
  constructor
  · rintro ⟨i, ha, hb⟩
    exact ⟨sigma i, ha, hb⟩
  · rintro ⟨i, ha, hb⟩
    refine ⟨sigma.symm i, ?_, ?_⟩
    · change (α.val (sigma (sigma.symm i))).val < k (sigma (sigma.symm i))
      rw [congrArg (fun j => (α.val j).val) (sigma.apply_symm_apply i),
        sigma.apply_symm_apply]
      exact ha
    · change (β.val (sigma (sigma.symm i))).val < k (sigma (sigma.symm i))
      rw [congrArg (fun j => (β.val j).val) (sigma.apply_symm_apply i),
        sigma.apply_symm_apply]
      exact hb

/-- Any prime assignment and any exponent permutation give isomorphic actual ideal graphs.
No ordering on primes or exponents is imposed, and the rings need not have the same modulus. -/
def graphReindex (p p' k : Fin 3 → ℕ) (hp : ∀ i, (p i).Prime)
    (hi : Function.Injective p) (hp' : ∀ i, (p' i).Prime)
    (hi' : Function.Injective p') (sigma : Equiv.Perm (Fin 3)) :
    idealGraph (primeProduct p k) ≃g
      idealGraph (primeProduct p' (fun i => k (sigma i))) where
  toEquiv := (idealEquiv p k hp hi).symm.trans
    ((reindexVertex k sigma).trans (idealEquiv p' (fun i => k (sigma i)) hp' hi'))
  map_rel_iff' := by
    intro I J
    let α := (idealEquiv p k hp hi).symm I
    let β := (idealEquiv p k hp hi).symm J
    change (idealGraph _).Adj
      (idealEquiv p' _ hp' hi' (reindexVertex k sigma α))
      (idealEquiv p' _ hp' hi' (reindexVertex k sigma β)) ↔ _
    rw [actual_adjacency p' _ hp' hi', (reindexVertex k sigma).injective.ne_iff,
      reindex_overlap]
    simpa only [α, β, Equiv.apply_symm_apply, Equiv.symm_apply_eq,
      (idealEquiv p k hp hi).symm.injective.ne_iff] using
      (actual_adjacency p k hp hi α β).symm

section ActualRealization

variable (p k : Fin 3 → ℕ) (hp : ∀ i, (p i).Prime)
  (hi : Function.Injective p) (hk : ∀ i, 0 < k i)

/-- The finite enumeration of the literal ideal carrier, constructed from the proved equivalence. -/
def actualFintype : Fintype (IdealVertex (primeProduct p k)) := by
  classical
  exact Fintype.ofEquiv (ExponentVertex k) (idealEquiv p k hp hi)

local instance actualDecidableEq : DecidableEq (IdealVertex (primeProduct p k)) :=
  Classical.decEq _

local instance actualDecidableAdj : DecidableRel (idealGraph (primeProduct p k)).Adj :=
  Classical.decRel _

/-- Actual vertices of `H`: delete precisely the actual full-support ideals. -/
abbrev HVertex := {I : IdealVertex (primeProduct p k) // actualSupport p k hp hi I ≠ Finset.univ}

/-- The actual induced graph after deletion of the full-support class. -/
def HGraph : SimpleGraph (HVertex p k hp hi) where
  Adj I J := (idealGraph (primeProduct p k)).Adj I.val J.val
  symm := ⟨by intro I J h; exact (idealGraph _).adj_symm h⟩
  loopless := ⟨by intro I h; exact (idealGraph _).irrefl h⟩

local instance hFintype : Fintype (HVertex p k hp hi) := by
  classical
  letI := actualFintype p k hp hi
  exact Subtype.fintype _

local instance hDecidableEq : DecidableEq (HVertex p k hp hi) := Classical.decEq _

local instance hDecidableAdj : DecidableRel (HGraph p k hp hi).Adj := Classical.decRel _

private lemma actualSupport_nonempty (I : IdealVertex (primeProduct p k)) :
    (actualSupport p k hp hi I).Nonempty :=
  support_nonempty k ((idealEquiv p k hp hi).symm I)

private lemma actual_adj_support (I J : IdealVertex (primeProduct p k)) :
    (idealGraph (primeProduct p k)).Adj I J ↔
      I ≠ J ∧ (actualSupport p k hp hi I ∩ actualSupport p k hp hi J).Nonempty := by
  simpa only [actualSupport, Equiv.apply_symm_apply,
    (idealEquiv p k hp hi).symm.injective.ne_iff] using
    actual_adjacency p k hp hi ((idealEquiv p k hp hi).symm I)
      ((idealEquiv p k hp hi).symm J)

/-- The unique cell number of an actual `H` vertex. -/
def cell (I : HVertex p k hp hi) : Fin 6 :=
  Classical.choose (properSupports_exhaust (actualSupport p k hp hi I.val)
    (actualSupport_nonempty p k hp hi I.val) I.property)

private lemma cell_support (I : HVertex p k hp hi) :
    properSupports (cell p k hp hi I) = actualSupport p k hp hi I.val :=
  Classical.choose_spec (properSupports_exhaust (actualSupport p k hp hi I.val)
    (actualSupport_nonempty p k hp hi I.val) I.property)

private def hFiberEquiv (j : Fin 6) :
    {I : HVertex p k hp hi // cell p k hp hi I = j} ≃
      {I : IdealVertex (primeProduct p k) // actualSupport p k hp hi I = properSupports j} where
  toFun I := ⟨I.val.val, by rw [← cell_support p k hp hi I.val, I.property]⟩
  invFun I := ⟨⟨I.val, by rw [I.property]; exact properSupports_ne_full j⟩,
    properSupports_injective ((cell_support p k hp hi _).trans I.property)⟩
  left_inv := by intro I; rfl
  right_inv := by intro I; rfl

private lemma cell_card (hk : ∀ i, 0 < k i) (j : Fin 6) :
    Fintype.card {I : HVertex p k hp hi // cell p k hp hi I = j} = cellSizes k j := by
  letI := actualFintype p k hp hi
  rw [Fintype.card_congr (hFiberEquiv p k hp hi j), ← Nat.card_eq_fintype_card]
  exact proper_fiber_card p k hp hi hk j

private lemma cell_surjective (hk : ∀ i, 0 < k i) : Function.Surjective (cell p k hp hi) := by
  intro j
  have hpos : 0 < Fintype.card {I : HVertex p k hp hi // cell p k hp hi I = j} := by
    rw [cell_card p k hp hi hk j]
    exact cellSizes_pos k hk j
  obtain ⟨I⟩ := Fintype.card_pos_iff.mp hpos
  exact ⟨I.val, I.property⟩

private lemma h_adj_support (I J : HVertex p k hp hi) :
    (HGraph p k hp hi).Adj I J ↔ I ≠ J ∧
      (properSupports (cell p k hp hi I) ∩ properSupports (cell p k hp hi J)).Nonempty := by
  change (idealGraph _).Adj I.val J.val ↔ _
  rw [actual_adj_support p k hp hi, ← cell_support p k hp hi I,
    ← cell_support p k hp hi J]
  simp only [Subtype.val_injective.ne_iff]

private lemma h_compl_adj_support (I J : HVertex p k hp hi) :
    ((HGraph p k hp hi)ᶜ).Adj I J ↔
      Disjoint (properSupports (cell p k hp hi I)) (properSupports (cell p k hp hi J)) := by
  rw [SimpleGraph.compl_adj, h_adj_support p k hp hi]
  by_cases hij : I = J
  · subst J
    have hsne : properSupports (cell p k hp hi I) ≠ ∅ :=
      Finset.nonempty_iff_ne_empty.mp (properSupports_nonempty (cell p k hp hi I))
    simp [Finset.disjoint_iff_inter_eq_empty, hsne]
  · simp [hij, Finset.disjoint_iff_inter_eq_empty, Finset.nonempty_iff_ne_empty]

/-- The cell-constant linear map into functions on actual ideals of `H`. -/
def cellEmbedding : (Fin 6 → ℝ) →ₗ[ℝ] (HVertex p k hp hi → ℝ) where
  toFun v I := v (cell p k hp hi I)
  map_add' := by intros; rfl
  map_smul' := by intros; rfl

private lemma cellEmbedding_injective (hk : ∀ i, 0 < k i) : Function.Injective (cellEmbedding p k hp hi) := by
  intro v z h
  ext j
  obtain ⟨I, hI⟩ := cell_surjective p k hp hi hk j
  simpa [cellEmbedding, hI] using congrFun h I

private lemma cellEmbedding_nonzero (hk : ∀ i, 0 < k i) (v : Fin 6 → ℝ) (hv : v ≠ 0) :
    cellEmbedding p k hp hi v ≠ 0 := by
  intro h
  apply hv
  apply cellEmbedding_injective p k hp hi hk
  simpa using h

private lemma sum_H_cells (hk : ∀ i, 0 < k i) (v : Fin 6 → ℝ) :
    ∑ I : HVertex p k hp hi, cellEmbedding p k hp hi v I =
      dotProduct (fun j => (cellSizes k j : ℝ)) v := by
  change (∑ I : HVertex p k hp hi, v (cell p k hp hi I)) = _
  rw [sum_cell_function]
  simp only [cell_card p k hp hi hk, dotProduct]

private lemma h_card (hk : ∀ i, 0 < k i) : Fintype.card (HVertex p k hp hi) = properOrder k := by
  have h := sum_H_cells p k hp hi hk (fun _ => 1)
  simp only [cellEmbedding, LinearMap.coe_mk, AddHom.coe_mk, Finset.sum_const,
    Finset.card_univ, nsmul_eq_mul, mul_one, dotProduct] at h
  rw [← Nat.cast_sum, sum_cellSizes] at h
  exact_mod_cast h

private lemma actual_h_restriction (hk : ∀ i, 0 < k i) (v : Fin 6 → ℝ) :
    (HGraph p k hp hi).lapMatrix ℝ *ᵥ cellEmbedding p k hp hi v =
      cellEmbedding p k hp hi (intersectionQuotient k *ᵥ v) := by
  ext I
  rw [laplacian_sum]
  change (∑ J, if (HGraph p k hp hi).Adj I J then
      v (cell p k hp hi I) - v (cell p k hp hi J) else 0) = _
  have hmask : ∀ J, (if (HGraph p k hp hi).Adj I J then
      v (cell p k hp hi I) - v (cell p k hp hi J) else 0) =
      (if (properSupports (cell p k hp hi I) ∩ properSupports (cell p k hp hi J)).Nonempty
        then v (cell p k hp hi I) - v (cell p k hp hi J) else 0) := by
    intro J
    by_cases h : I = J
    · subst J; simp
    · simp only [h_adj_support p k hp hi, ne_eq, h, not_false_eq_true, true_and]
  simp_rw [hmask]
  rw [sum_cell_function (cell p k hp hi)
    (fun j => if (properSupports (cell p k hp hi I) ∩ properSupports j).Nonempty
      then v (cell p k hp hi I) - v j else 0)]
  simp only [cell_card p k hp hi hk]
  change _ = (intersectionQuotient k *ᵥ v) (cell p k hp hi I)
  rw [intersectionQuotient_action]
  apply Finset.sum_congr rfl
  intro j _
  split_ifs <;> simp

private lemma actual_complement_restriction (hk : ∀ i, 0 < k i) (v : Fin 6 → ℝ) :
    ((HGraph p k hp hi)ᶜ).lapMatrix ℝ *ᵥ cellEmbedding p k hp hi v =
      cellEmbedding p k hp hi (complementQuotient k *ᵥ v) := by
  classical
  ext I
  rw [laplacian_sum]
  simp_rw [h_compl_adj_support p k hp hi]
  change (∑ J, if Disjoint (properSupports (cell p k hp hi I))
      (properSupports (cell p k hp hi J)) then
      v (cell p k hp hi I) - v (cell p k hp hi J) else 0) = _
  rw [sum_cell_function (cell p k hp hi)
    (fun j => if Disjoint (properSupports (cell p k hp hi I)) (properSupports j)
      then v (cell p k hp hi I) - v j else 0)]
  simp only [cell_card p k hp hi hk]
  change _ = (complementQuotient k *ᵥ v) (cell p k hp hi I)
  rw [complementQuotient_action]
  apply Finset.sum_congr rfl
  intro j _
  split_ifs <;> simp

/-- The full-support actual ideals, which may form an empty type. -/
abbrev FullVertex :=
  {I : IdealVertex (primeProduct p k) // actualSupport p k hp hi I = Finset.univ}

local instance fullFintype : Fintype (FullVertex p k hp hi) := by
  classical
  letI := actualFintype p k hp hi
  exact Subtype.fintype _

private lemma full_card (hk : ∀ i, 0 < k i) : Fintype.card (FullVertex p k hp hi) = universalOrder k := by
  rw [← Nat.card_eq_fintype_card]
  exact full_fiber_card p k hp hi hk

/-- A partition of the literal ideal carrier, including when the second summand is empty. -/
def joinPartition : IdealVertex (primeProduct p k) ≃
    HVertex p k hp hi ⊕ FullVertex p k hp hi where
  toFun I := if h : actualSupport p k hp hi I ≠ Finset.univ then
    Sum.inl ⟨I, h⟩ else Sum.inr ⟨I, not_ne_iff.mp h⟩
  invFun := Sum.elim Subtype.val Subtype.val
  left_inv := by intro I; dsimp; split_ifs <;> rfl
  right_inv := by
    intro I
    rcases I with I | I
    · dsimp only [Sum.elim_inl]
      simp only [dif_pos I.property]
    · dsimp only [Sum.elim_inr]
      simp only [I.property, ne_eq, not_true_eq_false, dif_neg, not_false_eq_true]

include hp hi in
private lemma total_card (hk : ∀ i, 0 < k i) :
    Nat.card (IdealVertex (primeProduct p k)) = totalOrder k := by
  letI := actualFintype p k hp hi
  calc
    Nat.card (IdealVertex (primeProduct p k)) =
        Fintype.card (IdealVertex (primeProduct p k)) := Nat.card_eq_fintype_card
    _ = Fintype.card (HVertex p k hp hi ⊕ FullVertex p k hp hi) :=
        Fintype.card_congr (joinPartition p k hp hi)
    _ = properOrder k + universalOrder k := by
        rw [Fintype.card_sum, h_card p k hp hi hk, full_card p k hp hi hk]
    _ = totalOrder k := rfl

private lemma actual_partition_sum (f : IdealVertex (primeProduct p k) → ℝ) :
    letI : Fintype (IdealVertex (primeProduct p k)) := actualFintype p k hp hi;
    ∑ I, f I = (∑ I : HVertex p k hp hi, f I.val) +
      ∑ I : FullVertex p k hp hi, f I.val := by
  letI := actualFintype p k hp hi
  have h := (joinPartition p k hp hi).symm.sum_comp f
  rw [Fintype.sum_sum_type] at h
  change (∑ I : HVertex p k hp hi, f I.val) +
    (∑ I : FullVertex p k hp hi, f I.val) = ∑ I, f I at h
  exact h.symm

private lemma full_universal (I : FullVertex p k hp hi)
    (J : IdealVertex (primeProduct p k)) :
    (idealGraph (primeProduct p k)).Adj I.val J ↔ I.val ≠ J := by
  rw [actual_adj_support p k hp hi, I.property, Finset.univ_inter]
  simp [actualSupport_nonempty p k hp hi J]

private lemma h_full_ne (I : HVertex p k hp hi) (J : FullVertex p k hp hi) :
    I.val ≠ J.val := by
  intro h
  exact I.property ((congrArg (actualSupport p k hp hi) h).trans J.property)

private lemma h_full_adj (I : HVertex p k hp hi) (J : FullVertex p k hp hi) :
    (idealGraph (primeProduct p k)).Adj I.val J.val := by
  apply (idealGraph _).adj_symm
  exact (full_universal p k hp hi J I.val).mpr (h_full_ne p k hp hi I J).symm

/-- The literal join with the complete graph on `Fin u`, valid also for `u = 0`. -/
def universalJoin : SimpleGraph (HVertex p k hp hi ⊕ Fin (universalOrder k)) where
  Adj
    | Sum.inl I, Sum.inl J => (HGraph p k hp hi).Adj I J
    | Sum.inr i, Sum.inr j => i ≠ j
    | Sum.inl _, Sum.inr _ => True
    | Sum.inr _, Sum.inl _ => True
  symm := ⟨by
    rintro (I | i) (J | j) h
    · exact (HGraph p k hp hi).adj_symm h
    · trivial
    · trivial
    · exact h.symm⟩
  loopless := ⟨by
    rintro (I | i) h
    · exact (HGraph p k hp hi).irrefl h
    · exact h rfl⟩

/-- The join model is isomorphic to the actual graph, with no inhabitedness
requirement on the universal summand. -/
def universalJoinIso : universalJoin p k hp hi ≃g idealGraph (primeProduct p k) where
  toEquiv := (Equiv.sumCongr (Equiv.refl (HVertex p k hp hi))
    (Fintype.equivFinOfCardEq (full_card p k hp hi hk)).symm).trans
      (joinPartition p k hp hi).symm
  map_rel_iff' := by
    let e := Fintype.equivFinOfCardEq (full_card p k hp hi hk)
    rintro (I | i) (J | j)
    · rfl
    · change (idealGraph _).Adj I.val (e.symm j).val ↔ True
      exact iff_true_intro (h_full_adj p k hp hi I (e.symm j))
    · change (idealGraph _).Adj (e.symm i).val J.val ↔ True
      exact iff_true_intro ((idealGraph _).adj_symm (h_full_adj p k hp hi J (e.symm i)))
    · change (idealGraph _).Adj (e.symm i).val (e.symm j).val ↔ i ≠ j
      rw [full_universal p k hp hi,
        Subtype.val_injective.ne_iff, e.symm.injective.ne_iff]

private lemma quotient_weighted_zero_sum (hk : ∀ i, 0 < k i) (mu : ℝ) (v : Fin 6 → ℝ)
    (hmu : mu ≠ 0) (he : complementQuotient k *ᵥ v = mu • v) :
    dotProduct (fun j => (cellSizes k j : ℝ)) v = 0 := by
  have ha : (0 : ℝ) < k 0 := by exact_mod_cast hk 0
  have hb : (0 : ℝ) < k 1 := by exact_mod_cast hk 1
  have hc : (0 : ℝ) < k 2 := by exact_mod_cast hk 2
  have hleft := (SixSupportLaplacianLowRoot.quotient_geometry
    (k 0) (k 1) (k 2) ha hb hc).1.2.2.2
  rw [← cellSizes_cast k] at hleft
  change vecMul (fun j => (cellSizes k j : ℝ)) (complementQuotient k) = 0 at hleft
  have hz : mu * dotProduct (fun j => (cellSizes k j : ℝ)) v = 0 := by
    calc
      mu * dotProduct (fun j => (cellSizes k j : ℝ)) v =
          dotProduct (fun j => (cellSizes k j : ℝ)) (mu • v) := by
            rw [dotProduct_smul]; rfl
      _ = dotProduct (fun j => (cellSizes k j : ℝ)) (complementQuotient k *ᵥ v) := by rw [he]
      _ = dotProduct (vecMul (fun j => (cellSizes k j : ℝ)) (complementQuotient k)) v :=
        Matrix.dotProduct_mulVec _ _ _
      _ = 0 := by rw [hleft]; simp
  exact (mul_eq_zero.mp hz).resolve_left hmu

private lemma reflected_eigenpair (hk : ∀ i, 0 < k i) (mu : ℝ) (v : Fin 6 → ℝ)
    (hmu : mu ≠ 0) (he : complementQuotient k *ᵥ v = mu • v) :
    intersectionQuotient k *ᵥ v = ((properOrder k : ℝ) - mu) • v := by
  have hz := quotient_weighted_zero_sum k hk mu v hmu he
  ext j
  simp only [intersectionQuotient, Matrix.sub_mulVec, Matrix.smul_mulVec,
    Matrix.one_mulVec, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
  change (properOrder k : ℝ) * v j - dotProduct (fun j => (cellSizes k j : ℝ)) v -
    (complementQuotient k *ᵥ v) j = ((properOrder k : ℝ) - mu) * v j
  rw [hz, he]
  simp only [Pi.smul_apply, smul_eq_mul]
  ring

private lemma actual_H_eigenpair (hk : ∀ i, 0 < k i) (mu : ℝ) (v : Fin 6 → ℝ) (hv : v ≠ 0)
    (hmu : mu ≠ 0) (hN : mu ≠ (properOrder k : ℝ))
    (he : complementQuotient k *ᵥ v = mu • v) :
    cellEmbedding p k hp hi v ≠ 0 ∧ ((properOrder k : ℝ) - mu ≠ 0) ∧
      (HGraph p k hp hi).lapMatrix ℝ *ᵥ cellEmbedding p k hp hi v =
        ((properOrder k : ℝ) - mu) • cellEmbedding p k hp hi v := by
  refine ⟨cellEmbedding_nonzero p k hp hi hk v hv, sub_ne_zero.mpr hN.symm, ?_⟩
  rw [actual_h_restriction p k hp hi hk,
    reflected_eigenpair k hk mu v hmu he, map_smul]

/-- Extend a cell-constant function by zero on all actual universal ideals. -/
def extendByZero (v : Fin 6 → ℝ) (I : IdealVertex (primeProduct p k)) : ℝ :=
  if h : actualSupport p k hp hi I ≠ Finset.univ then
    cellEmbedding p k hp hi v ⟨I, h⟩ else 0

private lemma extend_H (v : Fin 6 → ℝ) (I : HVertex p k hp hi) :
    extendByZero p k hp hi v I.val = cellEmbedding p k hp hi v I := by
  dsimp only [extendByZero]
  rw [dif_pos I.property]

private lemma extend_full (v : Fin 6 → ℝ) (I : FullVertex p k hp hi) :
    extendByZero p k hp hi v I.val = 0 := by simp [extendByZero, I.property]

private lemma extend_nonzero (hk : ∀ i, 0 < k i) (v : Fin 6 → ℝ) (hv : v ≠ 0) :
    extendByZero p k hp hi v ≠ 0 := by
  intro h
  apply cellEmbedding_nonzero p k hp hi hk v hv
  ext I
  have hh := congrFun h I.val
  simpa only [extend_H p k hp hi, Pi.zero_apply] using hh

private lemma join_action_H (hk : ∀ i, 0 < k i) (v : Fin 6 → ℝ) (I : HVertex p k hp hi) :
    letI : Fintype (IdealVertex (primeProduct p k)) := actualFintype p k hp hi;
    ((idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ extendByZero p k hp hi v) I.val =
      ((HGraph p k hp hi).lapMatrix ℝ *ᵥ cellEmbedding p k hp hi v) I +
        (universalOrder k : ℝ) * cellEmbedding p k hp hi v I := by
  letI := actualFintype p k hp hi
  rw [laplacian_sum, actual_partition_sum]
  rw [laplacian_sum]
  congr 1
  · apply Finset.sum_congr rfl
    intro J _
    rw [extend_H p k hp hi, extend_H p k hp hi]
    rfl
  · simp only [h_full_adj p k hp hi, if_true, extend_H p k hp hi,
      extend_full p k hp hi, sub_zero, Finset.sum_const, Finset.card_univ,
      full_card p k hp hi hk, nsmul_eq_mul]

private lemma join_action_full (hk : ∀ i, 0 < k i) (v : Fin 6 → ℝ) (I : FullVertex p k hp hi) :
    letI : Fintype (IdealVertex (primeProduct p k)) := actualFintype p k hp hi;
    ((idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ extendByZero p k hp hi v) I.val =
      -dotProduct (fun j => (cellSizes k j : ℝ)) v := by
  letI := actualFintype p k hp hi
  rw [laplacian_sum, actual_partition_sum]
  have hh : ∀ J : HVertex p k hp hi,
      (idealGraph (primeProduct p k)).Adj I.val J.val := by
    intro J
    exact (idealGraph _).adj_symm (h_full_adj p k hp hi J I)
  simp only [hh, if_true, extend_H p k hp hi, extend_full p k hp hi,
    sub_self, ite_self, Finset.sum_const_zero, zero_sub, add_zero]
  rw [Finset.sum_neg_distrib, sum_H_cells p k hp hi hk]

private lemma actual_eigenpair (hk : ∀ i, 0 < k i) (mu : ℝ) (v : Fin 6 → ℝ) (hv : v ≠ 0)
    (hmu : mu ≠ 0) (hN : mu ≠ (properOrder k : ℝ))
    (he : complementQuotient k *ᵥ v = mu • v) :
    letI : Fintype (IdealVertex (primeProduct p k)) := actualFintype p k hp hi;
    ((properOrder k : ℝ) - mu ≠ 0) ∧
    extendByZero p k hp hi v ≠ 0 ∧
    (idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ extendByZero p k hp hi v =
      ((totalOrder k : ℝ) - mu) • extendByZero p k hp hi v := by
  letI := actualFintype p k hp hi
  refine ⟨sub_ne_zero.mpr hN.symm, extend_nonzero p k hp hi hk v hv, ?_⟩
  have hz := quotient_weighted_zero_sum k hk mu v hmu he
  have href := reflected_eigenpair k hk mu v hmu he
  ext I
  by_cases hI : actualSupport p k hp hi I ≠ Finset.univ
  · let J : HVertex p k hp hi := ⟨I, hI⟩
    have h := join_action_H p k hp hi hk v J
    rw [actual_h_restriction p k hp hi hk, href] at h
    have hh : ((idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ
        extendByZero p k hp hi v) I =
        ((properOrder k : ℝ) - mu) * cellEmbedding p k hp hi v J +
        (universalOrder k : ℝ) * cellEmbedding p k hp hi v J := by
      simpa only [cellEmbedding, LinearMap.coe_mk, AddHom.coe_mk,
        Pi.smul_apply, smul_eq_mul] using h
    rw [hh]
    simp only [Pi.smul_apply, smul_eq_mul]
    rw [show extendByZero p k hp hi v I = cellEmbedding p k hp hi v J from
      extend_H p k hp hi v J]
    simp only [totalOrder, Nat.cast_add]
    ring
  · let J : FullVertex p k hp hi := ⟨I, not_ne_iff.mp hI⟩
    have h := join_action_full p k hp hi hk v J
    rw [hz, neg_zero] at h
    change _ = 0 at h
    have hzero : extendByZero p k hp hi v I = 0 := extend_full p k hp hi v J
    change ((idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ
      extendByZero p k hp hi v) I = 0 at h
    simpa only [Pi.smul_apply, smul_eq_mul, hzero, mul_zero] using h

/-- A nonintegral quotient eigenpair gives a nonintegral eigenpair on actual ideals. -/
private lemma actual_nonintegral_eigenpair (hk : ∀ i, 0 < k i) (mu : ℝ) (v : Fin 6 → ℝ) (hv : v ≠ 0)
    (hmu : ¬∃ z : ℤ, mu = (z : ℝ))
    (he : complementQuotient k *ᵥ v = mu • v) :
    letI : Fintype (IdealVertex (primeProduct p k)) := actualFintype p k hp hi;
    ∃ f : IdealVertex (primeProduct p k) → ℝ, f ≠ 0 ∧
      (idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ f =
        ((totalOrder k : ℝ) - mu) • f ∧
      ¬∃ z : ℤ, (totalOrder k : ℝ) - mu = (z : ℝ) := by
  letI := actualFintype p k hp hi
  have h0 : mu ≠ 0 := by intro h; exact hmu ⟨0, by simpa using h⟩
  have hN : mu ≠ (properOrder k : ℝ) := by
    intro h
    exact hmu ⟨(properOrder k : ℤ), by simpa using h⟩
  have h := actual_eigenpair p k hp hi hk mu v hv h0 hN he
  refine ⟨extendByZero p k hp hi v, h.2.1, h.2.2, ?_⟩
  rintro ⟨z, hz⟩
  apply hmu
  refine ⟨(totalOrder k : ℤ) - z, ?_⟩
  push_cast
  linarith

/-- The complete actual-ideal graph prerequisite. Every clause is on the literal
ideal carrier; the finite-dimensional matrices appear only as proved restrictions. -/
structure SpectralRealization : Prop where
  coordinateEnumeration : Function.Bijective (coordinateIdeal p k)
  vertexEnumeration : Function.Bijective (idealEquiv p k hp hi)
  idealIntersection : ∀ α β : Box k,
    coordinateIdeal p k α ⊓ coordinateIdeal p k β =
      coordinateIdeal p k (fun i => max (α i) (β i))
  adjacency : ∀ α β : ExponentVertex k,
    (idealGraph (primeProduct p k)).Adj (idealEquiv p k hp hi α)
      (idealEquiv p k hp hi β) ↔
        α ≠ β ∧ (support k α.val ∩ support k β.val).Nonempty
  properFibers : ∀ j : Fin 6,
    Nat.card {I : IdealVertex (primeProduct p k) //
      actualSupport p k hp hi I = properSupports j} = cellSizes k j
  fullFiber : Nat.card (FullVertex p k hp hi) = universalOrder k
  hOrder : Fintype.card (HVertex p k hp hi) = properOrder k
  graphOrder : Nat.card (IdealVertex (primeProduct p k)) = totalOrder k
  zeroUniversal : universalOrder k = 0 → IsEmpty (FullVertex p k hp hi)
  fullClique : ∀ I J : FullVertex p k hp hi,
    (idealGraph (primeProduct p k)).Adj I.val J.val ↔ I ≠ J
  joinEdges : ∀ I : HVertex p k hp hi, ∀ J : FullVertex p k hp hi,
    (idealGraph (primeProduct p k)).Adj I.val J.val
  fullUniversal : ∀ I : FullVertex p k hp hi, ∀ J : IdealVertex (primeProduct p k),
    (idealGraph (primeProduct p k)).Adj I.val J ↔ I.val ≠ J
  joinIsomorphism : Nonempty (universalJoin p k hp hi ≃g idealGraph (primeProduct p k))
  embeddingInjective : Function.Injective (cellEmbedding p k hp hi)
  hRestriction : ∀ v : Fin 6 → ℝ,
    (HGraph p k hp hi).lapMatrix ℝ *ᵥ cellEmbedding p k hp hi v =
      cellEmbedding p k hp hi (intersectionQuotient k *ᵥ v)
  complementRestriction : ∀ v : Fin 6 → ℝ,
    ((HGraph p k hp hi)ᶜ).lapMatrix ℝ *ᵥ cellEmbedding p k hp hi v =
      cellEmbedding p k hp hi (complementQuotient k *ᵥ v)
  reflection : intersectionQuotient k + complementQuotient k =
    (properOrder k : ℝ) • (1 : Matrix (Fin 6) (Fin 6) ℝ) -
      (Matrix.of (fun (_ : Fin 6) j => (cellSizes k j : ℝ)))
  hEigenpair : ∀ (mu : ℝ) (v : Fin 6 → ℝ), v ≠ 0 → mu ≠ 0 →
    mu ≠ (properOrder k : ℝ) → complementQuotient k *ᵥ v = mu • v →
    cellEmbedding p k hp hi v ≠ 0 ∧ ((properOrder k : ℝ) - mu ≠ 0) ∧
      (HGraph p k hp hi).lapMatrix ℝ *ᵥ cellEmbedding p k hp hi v =
        ((properOrder k : ℝ) - mu) • cellEmbedding p k hp hi v
  eigenpair : ∀ (mu : ℝ) (v : Fin 6 → ℝ), v ≠ 0 → mu ≠ 0 →
    mu ≠ (properOrder k : ℝ) → complementQuotient k *ᵥ v = mu • v →
    letI : Fintype (IdealVertex (primeProduct p k)) := actualFintype p k hp hi;
      ((properOrder k : ℝ) - mu ≠ 0) ∧
      extendByZero p k hp hi v ≠ 0 ∧
      (idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ extendByZero p k hp hi v =
        ((totalOrder k : ℝ) - mu) • extendByZero p k hp hi v
  nonintegralTransfer : ∀ (mu : ℝ) (v : Fin 6 → ℝ), v ≠ 0 →
    (¬∃ z : ℤ, mu = (z : ℝ)) → complementQuotient k *ᵥ v = mu • v →
    letI : Fintype (IdealVertex (primeProduct p k)) := actualFintype p k hp hi;
    ∃ f : IdealVertex (primeProduct p k) → ℝ, f ≠ 0 ∧
      (idealGraph (primeProduct p k)).lapMatrix ℝ *ᵥ f =
        ((totalOrder k : ℝ) - mu) • f ∧
      ¬∃ z : ℤ, (totalOrder k : ℝ) - mu = (z : ℝ)
  permutations : ∀ (p' : Fin 3 → ℕ), (∀ i, (p' i).Prime) →
    Function.Injective p' → ∀ sigma : Equiv.Perm (Fin 3),
      Nonempty (idealGraph (primeProduct p k) ≃g
        idealGraph (primeProduct p' (fun i => k (sigma i))))

/-- Uniform actual graph, support cells, complement reflection and nonzero spectral
transport for arbitrary distinct primes and positive integer exponents. This is
the graph prerequisite only, with no nonintegrality classification assertion. -/
theorem spectral_realization (hk : ∀ i, 0 < k i) : SpectralRealization p k hp hi := by
  classical
  refine {
    coordinateEnumeration := coordinate_bijective p k hp hi
    vertexEnumeration := (idealEquiv p k hp hi).bijective
    idealIntersection := coordinate_inf p k hp hi
    adjacency := actual_adjacency p k hp hi
    properFibers := proper_fiber_card p k hp hi hk
    fullFiber := full_fiber_card p k hp hi hk
    hOrder := h_card p k hp hi hk
    graphOrder := total_card p k hp hi hk
    zeroUniversal := ?_
    fullClique := ?_
    joinEdges := h_full_adj p k hp hi
    fullUniversal := full_universal p k hp hi
    joinIsomorphism := ⟨universalJoinIso p k hp hi hk⟩
    embeddingInjective := cellEmbedding_injective p k hp hi hk
    hRestriction := actual_h_restriction p k hp hi hk
    complementRestriction := actual_complement_restriction p k hp hi hk
    reflection := quotient_reflection k
    hEigenpair := actual_H_eigenpair p k hp hi hk
    eigenpair := actual_eigenpair p k hp hi hk
    nonintegralTransfer := actual_nonintegral_eigenpair p k hp hi hk
    permutations := fun p' hp' hi' sigma => ⟨graphReindex p p' k hp hi hp' hi' sigma⟩ }
  · intro hu
    exact Fintype.card_eq_zero_iff.mp ((full_card p k hp hi hk).trans hu)
  · intro I J
    simpa only [Subtype.val_injective.ne_iff] using full_universal p k hp hi I J.val

end ActualRealization

