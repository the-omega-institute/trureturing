    have hneg := mul_neg_of_pos_of_neg hden (lt_of_not_ge hn)
    omega
  have g6 : 0 ≤ (((8 * k) + (256 * h * (k ^ 2)) + (4096 * h * (k ^ 3))) : ℤ) := by
    let p : ℤ := ((64 * k) + (512 * (k ^ 2)) + (2048 * h * (k ^ 2)) + (49152 * h * (k ^ 3)) + (262144 * h * (k ^ 4)))
    have heq : 8*(8*k+1) * ((8 * k) + (256 * h * (k ^ 2)) + (4096 * h * (k ^ 3))) = p := by
      dsimp only [p]
      linear_combination 0 * ha
    have hlo : 0 ≤ ((64 * k) + (512 * (k ^ 2)) + (2048 * h * (k ^ 2)) + (49152 * h * (k ^ 3)) + (262144 * h * (k ^ 4))) := by
      calc
        0 ≤ (20054592 + (512 * ((8*k-8) ^ 5)) + (21248 * ((8*k-8) ^ 4)) + (313344 * (h-64*k)) + (352512 * ((8*k-8) ^ 3)) + (2922504 * ((8*k-8) ^ 2)) + (12107912 * (8*k-8)) + (64 * (h-64*k) * ((8*k-8) ^ 4)) + (2144 * (h-64*k) * ((8*k-8) ^ 3)) + (26912 * (h-64*k) * ((8*k-8) ^ 2)) + (150016 * (h-64*k) * (8*k-8))) := by positivity
        _ = ((64 * k) + (512 * (k ^ 2)) + (2048 * h * (k ^ 2)) + (49152 * h * (k ^ 3)) + (262144 * h * (k ^ 4))) := by ring
    have hhi : 0 ≤ ((64 * k) + (512 * (k ^ 2)) + (2048 * h * (k ^ 2)) + (49152 * h * (k ^ 3)) + (262144 * h * (k ^ 4))) := by
      calc
        0 ≤ (20054592 + (512 * ((8*k-8) ^ 5)) + (21248 * ((8*k-8) ^ 4)) + (313344 * (h-64*k)) + (352512 * ((8*k-8) ^ 3)) + (2922504 * ((8*k-8) ^ 2)) + (12107912 * (8*k-8)) + (64 * (h-64*k) * ((8*k-8) ^ 4)) + (2144 * (h-64*k) * ((8*k-8) ^ 3)) + (26912 * (h-64*k) * ((8*k-8) ^ 2)) + (150016 * (h-64*k) * (8*k-8))) := by positivity
        _ = ((64 * k) + (512 * (k ^ 2)) + (2048 * h * (k ^ 2)) + (49152 * h * (k ^ 3)) + (262144 * h * (k ^ 4))) := by ring
    have hinterp : 32*k*p = (32*k+4-S)*((64 * k) + (512 * (k ^ 2)) + (2048 * h * (k ^ 2)) + (49152 * h * (k ^ 3)) + (262144 * h * (k ^ 4)))+(S-4)*((64 * k) + (512 * (k ^ 2)) + (2048 * h * (k ^ 2)) + (49152 * h * (k ^ 3)) + (262144 * h * (k ^ 4))) := by
      dsimp only [p]
      ring
    have hp : 0 ≤ p := by
      have hpw : 0 ≤ 32*k*p := by rw [hinterp]; positivity
      by_contra hn
      have hneg := mul_neg_of_pos_of_neg hwidth (lt_of_not_ge hn)
      omega
    have hpden : 0 ≤ 8*(8*k+1)*((8 * k) + (256 * h * (k ^ 2)) + (4096 * h * (k ^ 3))) := by
      rw [heq]
      exact hp
    by_contra hn
    have hneg := mul_neg_of_pos_of_neg hden (lt_of_not_ge hn)
    omega
  dsimp only [diagonalDoubledGates]
  refine ⟨?_, ?_, ?_, ?_⟩
  · norm_num [Fin.sum_univ_succ] <;> ring
  · norm_num [Fin.sum_univ_succ] <;> ring
  · intro i
    fin_cases i <;> norm_num [Fin.sum_univ_succ] <;>
      nlinarith only [g0, g1, g2]
  · intro i
    fin_cases i <;> norm_num [Fin.sum_univ_succ] <;>
      nlinarith only [g3, g4, g5, g6]


/- Integer recovery of the actual bank matrix.  The dyadic witness k is
   only 2^c=8k, not a changed schedule or a new selector. -/
private theorem diagonal_cast_banks (c delta ell k : ℕ) (hc : 3 ≤ c)
    (hz : 2^c=8*k) :
    (fun i j => (diagonalBanks c delta ell i j : ℤ)) =
      ![![(diagonalAlpha c delta : ℤ),0,
          (diagonalHigh c delta 0 : ℤ)*(diagonalH c delta : ℤ)*(2^ell : ℕ),0],
        ![0,0,2*(diagonalH c delta : ℤ)*(2^ell : ℕ)+
          (diagonalR c delta : ℤ)*(2^ell : ℕ),8*(k : ℤ)-2],
        ![8*(k : ℤ)*(diagonalH c delta : ℤ)-1-(diagonalAlpha c delta : ℤ),0,
          (diagonalHigh c delta 2 : ℤ)*(diagonalH c delta : ℤ)*(2^ell : ℕ),0],
        ![0,4*(k : ℤ)-1,(diagonalHigh c delta 3 : ℤ)*(diagonalH c delta : ℤ)*(2^ell : ℕ)+
          (diagonalH c delta : ℤ)*(2^ell : ℕ)-1-(diagonalR c delta : ℤ)*(2^ell : ℕ),1]] := by
  let z := (2 : ℕ)^c
  let h := diagonalH c delta
  let t := (2 : ℕ)^ell
  let q := h*t
  have hzi : (2 : ℤ)^c = 8*(k : ℤ) := by exact_mod_cast hz
  have hz8 : 8 ≤ z := (diagonal_dyadic c delta hc).1
  have hk : 1 ≤ k := by dsimp only [z] at hz8; omega
  have hhalf : z/2=4*k := by dsimp only [z]; omega
  have ht : 1 ≤ t := by
    have hp : 0 < t := by dsimp only [t]; positivity
    omega
  have hcapa := diagonal_capacities c delta hc
  have hu : (z*h-1-diagonalAlpha c delta)+1+diagonalAlpha c delta=z*h := by
    dsimp only [z, h]
    omega
  have hrt : diagonalR c delta*t+1 ≤ q := by
    have hr : diagonalR c delta+1 ≤ h := by dsimp only [h]; omega
    have hm := Nat.mul_le_mul_right t hr
    dsimp only [q]
    nlinarith only [hm, ht]
  have hw : (diagonalHigh c delta 3*q+q-1-diagonalR c delta*t)+1+
      diagonalR c delta*t=diagonalHigh c delta 3*q+q := by omega
  have hu' : ((z*h-1-diagonalAlpha c delta : ℕ) : ℤ) =
      (z : ℤ)*(h : ℤ)-1-(diagonalAlpha c delta : ℤ) := by
    have hx : ((z*h-1-diagonalAlpha c delta : ℕ) : ℤ)+1+
        (diagonalAlpha c delta : ℤ)=(z : ℤ)*(h : ℤ) := by exact_mod_cast hu
    linarith only [hx]
  have hw' : ((diagonalHigh c delta 3*q+q-1-diagonalR c delta*t : ℕ) : ℤ) =
      (diagonalHigh c delta 3 : ℤ)*(q : ℤ)+(q : ℤ)-1-(diagonalR c delta : ℤ)*(t : ℤ) := by
    have hx : ((diagonalHigh c delta 3*q+q-1-diagonalR c delta*t : ℕ) : ℤ)+1+
        (diagonalR c delta : ℤ)*(t : ℤ)=
        (diagonalHigh c delta 3 : ℤ)*(q : ℤ)+(q : ℤ) := by exact_mod_cast hw
    linarith only [hx]
  have hv' : ((z/2-1 : ℕ) : ℤ)=4*(k : ℤ)-1 := by
    rw [hhalf, Nat.cast_sub (by omega : 1 ≤ 4*k)]
    push_cast
    ring
  have hx' : ((z-2 : ℕ) : ℤ)=8*(k : ℤ)-2 := by
    rw [Nat.cast_sub (by omega : 2 ≤ z)]
    dsimp only [z]
    rw [hz]
    push_cast
    ring
  dsimp only [z, h, t, q] at hu' hw' hv' hx'
  have hp1 : diagonalHigh c delta 1=2 := by
    unfold diagonalHigh
    split_ifs <;> rfl
  funext i j
  fin_cases i <;> fin_cases j <;>
    simp [diagonalBanks, hu', hw', hv', hx', hp1, Nat.cast_add, Nat.cast_mul] <;>
    (try simp only [hzi, hz, Nat.cast_mul, Nat.cast_ofNat]) <;> ring

/--   Every c>=3, delta and ell, for the actual diagonal banks.
    The four boundary charts remain literal.  In the unbounded tail S is
    the original integer selector, not an arbitrary assumed gate witness. -/
theorem diagonal_doubled_gates (c delta ell : ℕ) (hc : 3 ≤ c) :
  let z : ℤ := ((2^c : ℕ) : ℤ)
  let h : ℤ := (diagonalH c delta : ℤ)
  let t : ℤ := ((2^ell : ℕ) : ℤ)
  let M := fun i j => (diagonalBanks c delta ell i j : ℤ)
  let x := 2*z
  let w := 2*z*h
  let y := 4*z*h*t
  let A := 1+x+x*y+x*y*z
  let B := 1+w+w*x+w*x*y
  let L := 1+z+w*z+w*z*x
  let K := 1+y+y*z+y*w*z
  let N := x*y*z*w-1
  let Q := 2*N+1
  let old : Fin 4 → ℤ := ![A,B,L,K]
  let new : Fin 4 → ℤ := ![2*A,2*B-1,2*L-z-1,2*K-y*(z+1)-1]
  let m := fun i => ∑ j : Fin 4, M i j * old j
  let n := fun i => ∑ j : Fin 4, M i j * new j
  let H : Fin 5 → ℤ := ![0,
    2*m 0+B-N,
    2*(m 0+m 1)+B+A-2*N,
    2*(m 0+m 1+m 2)+B+A+K-3*N,
    2*(m 0+m 1+m 2+m 3)+B+A+K+L-4*N]
  let G : Fin 5 → ℤ := ![2*A,
    2*A+2*n 0+(2*B-1)-Q,
    2*A+2*(n 0+n 1)+(2*B-1)+A-2*Q,
    2*A+2*(n 0+n 1+n 2)+(2*B-1)+A+(2*K-y*(z+1)-1)-3*Q,
    2*A+2*(n 0+n 1+n 2+n 3)+(2*B-1)+A+
      (2*K-y*(z+1)-1)+(2*L-z-1)-4*Q]
  H 4 = 0 ∧ G 4 = 0 ∧
    (∀ i : Fin 4, 0 ≤ H i.succ) ∧
    (∀ i : Fin 4, G i.castSucc+2*n i ≤ 2*N)
 := by
  change diagonalDoubledGates ((2^c : ℕ) : ℤ) (diagonalH c delta : ℤ)
    ((2^ell : ℕ) : ℤ) (fun i j => (diagonalBanks c delta ell i j : ℤ))
  have hd := diagonal_dyadic c delta hc
  have hz8Nat := hd.1
  obtain ⟨k, hz⟩ := hd.2.1
  have hk : 1 ≤ k := by omega
  have hk' : (1 : ℤ) ≤ (k : ℤ) := by exact_mod_cast hk
  have hz' : ((2^c : ℕ) : ℤ)=8*(k : ℤ) := by exact_mod_cast hz
  have htNat : 1 ≤ (2 : ℕ)^ell := by
    have hp : 0 < (2 : ℕ)^ell := by positivity
    omega
  have ht : (1 : ℤ) ≤ ((2^ell : ℕ) : ℤ) := by exact_mod_cast htNat
  rw [diagonal_cast_banks c delta ell k hc hz, hz']
  by_cases hb : delta < 4
  · have hs := diagonal_boundary_scales c hc
    have div2 : (8*k)/2=4*k := by omega
    have div3 : 3*(8*k)/8=3*k := by omega
    have div5 : 5*(8*k)/2=20*k := by omega
    have div7 : 7*(8*k)/2=28*k := by omega
    have div17 : 17*(8*k)/4=34*k := by omega
    have divsq : (8*k)*(8*k)/4=16*k*k := by
      have hx : (8*k)*(8*k)=4*(16*k*k) := by ring
      rw [hx]
      omega
    have b3 : 3 ≤ 8*k := by omega
    have b4 : 4 ≤ 8*k := by omega
    have b4' : 4 ≤ 2*(8*k) := by omega
    interval_cases delta
    · have hH : (diagonalH c 0 : ℤ)=4*(k : ℤ) := by
        rw [hs.1,hz]
        norm_num [div2,Nat.cast_mul] <;> ring
      have hAn : diagonalAlpha c 0=16*k*k+3*k-1 := by
        norm_num [diagonalAlpha,hz,divsq,div3]
      have hA : (diagonalAlpha c 0 : ℤ)=16*(k : ℤ)*(k : ℤ)+3*(k : ℤ)-1 := by
        rw [hAn,Nat.cast_sub (by nlinarith only [hk] : 1 ≤ 16*k*k+3*k)]
        push_cast
        ring
      have hR : (diagonalR c 0 : ℤ)=0 := by simp [diagonalR]
      rw [hH]
      convert diagonal_half (k : ℤ) ((2^ell : ℕ) : ℤ) hk' ht using 1 <;>
        ext i j <;> fin_cases i <;> fin_cases j <;>
        simp [hA,hR,diagonalHigh,hz,Nat.cast_sub b3,Nat.cast_sub b4,
          Nat.cast_sub b4',Nat.cast_add,Nat.cast_mul] <;> ring
    · have hH : (diagonalH c 1 : ℤ)=8*(k : ℤ) := by
        rw [hs.2.1,hz]
        norm_num [div2,Nat.cast_mul] <;> ring
      have hA : (diagonalAlpha c 1 : ℤ)=8*(k : ℤ) := by simp [diagonalAlpha,hz]
      have hR : (diagonalR c 1 : ℤ)=8*(k : ℤ)-3 := by
        simp [diagonalR,hz,Nat.cast_sub b3]
      rw [hH]
      convert diagonal_one (k : ℤ) ((2^ell : ℕ) : ℤ) hk' ht using 1 <;>
        ext i j <;> fin_cases i <;> fin_cases j <;>
        simp [hA,hR,diagonalHigh,hz,Nat.cast_sub b3,Nat.cast_sub b4,
          Nat.cast_sub b4',Nat.cast_add,Nat.cast_mul] <;> ring
    · have hH : (diagonalH c 2 : ℤ)=16*(k : ℤ) := by
        rw [hs.2.2.1,hz]
        norm_num [div2,Nat.cast_mul] <;> ring
      have hAn : diagonalAlpha c 2=(8*k)*(8*k)-20*k := by
        norm_num [diagonalAlpha,hz,div5]
      have hA : (diagonalAlpha c 2 : ℤ)=64*(k : ℤ)*(k : ℤ)-20*(k : ℤ) := by
        rw [hAn,Nat.cast_sub (by nlinarith only [hk] : 20*k ≤ (8*k)*(8*k))]
        push_cast
        ring
      have hR : (diagonalR c 2 : ℤ)=0 := by simp [diagonalR]
      rw [hH]
      convert diagonal_two (k : ℤ) ((2^ell : ℕ) : ℤ) hk' ht using 1 <;>
        ext i j <;> fin_cases i <;> fin_cases j <;>
        simp [hA,hR,diagonalHigh,hz,Nat.cast_sub b3,Nat.cast_sub b4,
          Nat.cast_sub b4',Nat.cast_add,Nat.cast_mul] <;> ring
    · have hH : (diagonalH c 3 : ℤ)=32*(k : ℤ) := by
        rw [hs.2.2.2,hz]
        norm_num [div2,Nat.cast_mul] <;> ring
      have hA : (diagonalAlpha c 3 : ℤ)=34*(k : ℤ)+4 := by
        simp [diagonalAlpha,hz,div17,Nat.cast_add,Nat.cast_mul]
      have hR : (diagonalR c 3 : ℤ)=28*(k : ℤ)-16 := by
        simp [diagonalR,hz,div7,Nat.cast_sub (by omega : 16 ≤ 28*k)]
      rw [hH]
      convert diagonal_four (k : ℤ) ((2^ell : ℕ) : ℤ) hk' ht using 1 <;>
        ext i j <;> fin_cases i <;> fin_cases j <;>
        simp [hA,hR,diagonalHigh,hz,Nat.cast_sub b3,Nat.cast_sub b4,
          Nat.cast_sub b4',Nat.cast_add,Nat.cast_mul] <;> ring
  · have hdelta : 4 ≤ delta := by omega
    have hscale := diagonal_tail_scale c delta hc hdelta
    have hh : 64*(k : ℤ) ≤ (diagonalH c delta : ℤ) := by
      have hx : 64*k ≤ diagonalH c delta := by nlinarith only [hscale, hz]
      exact_mod_cast hx
    have h0 : delta ≠ 0 := by omega
    have h1 : delta ≠ 1 := by omega
    have h2 : delta ≠ 2 := by omega
    have h3 : delta ≠ 3 := by omega
    have htr := diagonal_tail_transport (2^c) (diagonalH c delta)
      hd.1 hscale ⟨k,hz⟩ hd.2.2
    have haCast : (diagonalAlpha c delta : ℤ)=
        diagonalAlphaInt ((2^c : ℕ) : ℤ) (diagonalH c delta : ℤ) := by
      simpa [diagonalAlpha,h0,h1,h2,h3] using htr.2.2.1
    have hrCast : (diagonalR c delta : ℤ)=
        (diagonalH c delta : ℤ)-diagonalS ((2^c : ℕ) : ℤ) (diagonalH c delta : ℤ) := by
      simpa [diagonalR,diagonalRInt,h0,h1,h2,h3] using htr.2.2.2
    have hz8 : (8 : ℤ) ∣ ((2^c : ℕ) : ℤ) := by exact_mod_cast (show 8 ∣ (2 : ℕ)^c from ⟨k,hz⟩)
    have hh4 : (4 : ℤ) ∣ (diagonalH c delta : ℤ) := by exact_mod_cast hd.2.2
    have hi := diagonal_selector_integral ((2^c : ℕ) : ℤ) (diagonalH c delta : ℤ) hz8 hh4
    have hs := diagonal_selector_bounds ((2^c : ℕ) : ℤ) (diagonalH c delta : ℤ)
      (by exact_mod_cast hd.1) (by exact_mod_cast hscale)
    rw [hz'] at hi hs haCast hrCast
    have hhalf : 7*(8*(k : ℤ))/2=28*(k : ℤ) := by omega
    rw [hhalf] at hi
    have ha : 8*(8*(k : ℤ)+1)*(diagonalAlpha c delta : ℤ)=
        2*(32*(k : ℤ)+1)*(diagonalH c delta : ℤ)+
        2*(16*(k : ℤ)+1)*diagonalS (8*(k : ℤ)) (diagonalH c delta : ℤ)-56*(k : ℤ) := by
      rw [haCast]
      linear_combination 2*hi
    have hS1 : diagonalS (8*(k : ℤ)) (diagonalH c delta : ℤ) ≤ 32*(k : ℤ)+4 := by
      linarith only [hs.2.1]
    have b4 : 4 ≤ 2*(8*k) := by omega
    convert diagonal_tail (k : ℤ) (diagonalH c delta : ℤ) ((2^ell : ℕ) : ℤ)
      (diagonalAlpha c delta : ℤ) (diagonalS (8*(k : ℤ)) (diagonalH c delta : ℤ))
      hk' hh ht hs.1 hS1 ha using 1 <;>
      ext i j <;> fin_cases i <;> fin_cases j <;>
      simp [diagonalHigh,h0,h2,hz,hrCast,Nat.cast_sub b4,Nat.cast_add,Nat.cast_mul] <;> ring

end D5.S3.Combinatorics.Circle.FourNegative.SecondPeakResidualTails
