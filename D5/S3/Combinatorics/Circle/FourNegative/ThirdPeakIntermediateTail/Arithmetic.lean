/- GID: D5/S3/Combinatorics/Circle/FourNegative/ThirdPeakIntermediateTail/Arithmetic
   generality: I
   mirror-B: none(waiver:private-consumed-full-cone-arithmetic)
   mirror-E: none(waiver:private-consumed-full-cone-arithmetic)
   anchors: [mathlib/module/Mathlib.Data.List.FinRange]
   utility: none
   digest: Universal paired seam and slack polynomials for the original intermediate-tail cone. -/
import D5.S3.Combinatorics.Circle.FourNegative.PacketNormalForm.Source

/-! The 56 exact positive-polynomial certificates are proved by ring and
positivity on the nonnegative offsets of the original intermediate-tail cone.
They give universal inequalities throughout 2≤a≤d<b<c. -/
set_option autoImplicit false
set_option relaxedAutoImplicit false
namespace D5.S3.Combinatorics.Circle.FourNegative.ThirdPeakIntermediateTail

private def A (x r s q : ℚ) : ℚ := 1+x+x*(s*r*x)+x*(s*r*x)*(q*s*r*x)
private def B (x r s q : ℚ) : ℚ := 1+r*x+x*(r*x)+x*(s*r*x)*(r*x)
private def L (x r s q : ℚ) : ℚ := 1+q*s*r*x+(q*s*r*x)*(r*x)+x*(q*s*r*x)*(r*x)
private def K (x r s q : ℚ) : ℚ := 1+s*r*x+(s*r*x)*(q*s*r*x)+(s*r*x)*(q*s*r*x)*(r*x)
private def SU (x r s q : ℚ) : ℚ := 2*B x r s q-1
private def SV (x r s q : ℚ) : ℚ := 2*L x r s q-q*s*r*x-1
private def SW (x r s q : ℚ) : ℚ := 2*K x r s q-(1+s*r*x+(s*r*x)*(q*s*r*x))
private def rowBase (x r s q : ℚ) (side : Bool) : Fin 4 → ℚ :=
  if side then ![2*A x r s q,SU x r s q,SV x r s q,SW x r s q]
  else ![A x r s q,B x r s q,L x r s q,K x r s q]
private def rowHeads (x r s q : ℚ) (side : Bool) : Fin 4 → ℚ :=
  let F:=rowBase x r s q side
  ![F 2,F 3,A x r s q,F 1]
private def reserve (mode : Fin 4) (r s : ℚ) : ℚ :=
  if mode=0 then 3*s/4-1 else if mode=1 then s*r/2-1
  else if mode=2 then r-1 else 1
private def rowSeams (mode : Fin 4) (x r s q : ℚ) (side : Bool) : Fin 4 → ℚ :=
  let F:=rowBase x r s q side
  let e0:=F 2-q*F 1
  let ear:=if side then A x r s q else 0
  ![e0,
    e0+F 3-(reserve mode r s+1)*F 2+(if mode=3 then ear else 0),
    if mode=0 ∨ mode=1 then e0+A x r s q+ear-3*s/4*F 2
    else A x r s q+ear-F 2-q/2*F 1,0]
private def window (e H : ℚ) : Prop := 0≤e ∧ 2*e≤H-1

-- Coefficients of the four original positive banks, before insertion.
private def bankMasses (mode : Fin 4) (x r s q : ℚ) (F : Fin 4 → ℚ) : Fin 4 → ℚ :=
  ![(q*s*r*x/2-q)*F 1,
    (s*r*x/2-(reserve mode r s+1))*F 2,
    (if mode=0 ∨ mode=1 then
      (reserve mode r s-(3*s/4-1))*F 2
     else q/2*F 1+(if mode=2 then r-2 else 0)*F 2)+(x/2-1)*F 3,
    (r*x/2-1)*F 0+(if mode=0 ∨ mode=1 then q-1 else q/2-1)*F 1+
      (if mode=0 ∨ mode=1 then 3*s/4-1 else 1)*F 2]

