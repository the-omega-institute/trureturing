private theorem route_windows (w h v q : ℤ)
    (hw : 4≤w) (hh : 1≤h) (hv : 1≤v) (hq : 1≤q) :
    let V := values w h v q
    let r := if V.gamma ≤ V.Dp then 2*h*v else 3*h*v
    let ear := if V.gamma ≤ V.Dp then 0 else V.A
    (0 ≤ V.D ∧ 2*V.D ≤ V.K-1) ∧
    (0 ≤ V.Dp ∧ 2*V.Dp ≤ V.SW-1) ∧
    (0 ≤ V.D+V.A-r*V.K ∧ 2*(V.D+V.A-r*V.K) ≤ V.A-1) ∧
    (0 ≤ V.Dp+V.A+ear-r*V.SW ∧ 2*(V.Dp+V.A+ear-r*V.SW) ≤ V.A-1) ∧
    (0 ≤ V.E ∧ 2*V.E ≤ V.B-1) ∧
    (0 ≤ V.F ∧ 2*V.F ≤ V.SU-1) := by
  dsimp only
  let V := values w h v q
  obtain ⟨hDp,hDDp,hDH,hKH,hSH,hAH,hga,hal,hac,hgc,hE,hF,hEc,hFc⟩ :=
    arithmetic_windows w h v q hw hh hv hq
  change 0≤V.Dp at hDp
  have ha : 4*h*v*V.K=V.A+V.alpha := by dsimp [V,values]; ring
  have hg : 2*h*v*V.SW=V.A+V.gamma := by dsimp [V,values]; ring
  by_cases hb : V.gamma≤V.Dp
  all_goals dsimp only [V] at *
  all_goals simp only [hb,ite_true,ite_false]
  all_goals refine ⟨⟨by omega,by omega⟩,⟨hDp,by omega⟩,⟨?_,?_⟩,⟨?_,?_⟩,⟨hE,hEc⟩,⟨hF,hFc⟩⟩
  all_goals nlinarith only [ha,hg,hDp,hDDp,hDH,hKH,hSH,hAH,hga,hal,hac,hgc,hb]

