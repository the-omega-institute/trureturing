   anchors: [mathlib/module/Mathlib.Data.Set.Card]
   utility: none
   digest: Every component of two fixed-point-free matchings has cardinality twice one product orbit. -/

import Mathlib.Data.Set.Card
import Mathlib.Tactic
import D5.S3.Combinatorics.PerfectMatchings.InvolutionOrbitSplit

/-! The §3.9 escape registration audit for the public theorem remains
unfinished under https://github.com/the-omega-institute/trureturing/issues/29190.
-/

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.PerfectMatchings.AlternatingComponentParity

open Equiv
open D5.S3.Combinatorics.PerfectMatchings.InvolutionOrbitSplit

variable {X : Type*} [Finite X]

attribute [local instance] Classical.propDecidable

/-- The actual connected component generated by the two matching involutions. -/
def Component (s t : Perm X) (x : X) : Set X := {y | Connected s t x y}

/-!
For two fixed-point-free involutions, the existing orbit-splitting theorem gives a
disjoint union of two product orbits.  The first matching is a bijection between
those two orbits, so the component has exactly twice the cardinality of one orbit.
This is the cardinality statement needed before an alternating-cycle parity
argument; it does not assume a graph embedding or a preselected cycle carrier.
-/

theorem connected_ncard_eq_two_mul
    (s t : Perm X) (hs : Function.Involutive s) (ht : Function.Involutive t)
    (hsl : ∀ x, s x ≠ x) (htr : ∀ x, t x ≠ x) (x : X) :
    (Component s t x).ncard =
      2 * (RotationOrbit (s * t) x).ncard := by
  let A : Set X := RotationOrbit (s * t) x
  let B : Set X := RotationOrbit (s * t) (s x)
  have hsplit := component_split s t hs ht hsl htr x
  have hcard : A.ncard = B.ncard := by
    calc
      A.ncard = (s '' A).ncard :=
        (Set.ncard_image_of_injective A s.injective).symm
      _ = B.ncard := congrArg Set.ncard hsplit.2.2.2.2.1
  calc
    (Component s t x).ncard = A.ncard + B.ncard := by
      change ({y | Connected s t x y} : Set X).ncard = A.ncard + B.ncard
      rw [hsplit.2.2.2.1, Set.ncard_union_eq hsplit.1]
    _ = 2 * A.ncard := by omega
    _ = 2 * (RotationOrbit (s * t) x).ncard := by rfl

#print axioms connected_ncard_eq_two_mul

end D5.S3.Combinatorics.PerfectMatchings.AlternatingComponentParity
