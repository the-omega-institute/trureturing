/-- Digits zero through four represent colours one through five. -/
abbrev Block := Fin 5 → Fin 5

def decode (i : Fin 3125) : Block :=
  fun j => ⟨i.val / 5 ^ j.val % 5, Nat.mod_lt _ (by omega)⟩

/-- The 25 entry–exit constraints, written directly to keep kernel reduction small. -/
def PairOK (d : ℕ) (f g : Block) : Prop :=
  (f 4 = g 0 → (f 4).val + 2 < 2 * d + 0) ∧
  (f 0 = g 0 → (f 0).val + 2 < 2 * d + 1) ∧
  (f 3 = g 0 → (f 3).val + 2 < 2 * d + 1) ∧
  (f 4 = g 1 → (f 4).val + 2 < 2 * d + 1) ∧
  (f 4 = g 4 → (f 4).val + 2 < 2 * d + 1) ∧
  (f 1 = g 0 → (f 1).val + 2 < 2 * d + 2) ∧
  (f 2 = g 0 → (f 2).val + 2 < 2 * d + 2) ∧
  (f 4 = g 2 → (f 4).val + 2 < 2 * d + 2) ∧
  (f 4 = g 3 → (f 4).val + 2 < 2 * d + 2) ∧
  (f 0 = g 1 → (f 0).val + 2 < 2 * d + 2) ∧
  (f 0 = g 4 → (f 0).val + 2 < 2 * d + 2) ∧
  (f 3 = g 1 → (f 3).val + 2 < 2 * d + 2) ∧
  (f 3 = g 4 → (f 3).val + 2 < 2 * d + 2) ∧
  (f 0 = g 2 → (f 0).val + 2 < 2 * d + 3) ∧
  (f 0 = g 3 → (f 0).val + 2 < 2 * d + 3) ∧
  (f 1 = g 1 → (f 1).val + 2 < 2 * d + 3) ∧
  (f 1 = g 4 → (f 1).val + 2 < 2 * d + 3) ∧
  (f 2 = g 1 → (f 2).val + 2 < 2 * d + 3) ∧
  (f 2 = g 4 → (f 2).val + 2 < 2 * d + 3) ∧
  (f 3 = g 2 → (f 3).val + 2 < 2 * d + 3) ∧
  (f 3 = g 3 → (f 3).val + 2 < 2 * d + 3) ∧
  (f 1 = g 2 → (f 1).val + 2 < 2 * d + 4) ∧
  (f 1 = g 3 → (f 1).val + 2 < 2 * d + 4) ∧
  (f 2 = g 2 → (f 2).val + 2 < 2 * d + 4) ∧
  (f 2 = g 3 → (f 2).val + 2 < 2 * d + 4)

instance pairOKDecidable (d : ℕ) (f g : Block) : Decidable (PairOK d f g) := by
  unfold PairOK
  infer_instance

