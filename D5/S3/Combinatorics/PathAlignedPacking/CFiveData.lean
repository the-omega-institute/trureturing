def oneNext (i : Fin 240) : List (Fin 240) :=
  (nextRows.getD i.val []).map (fun j => ⟨j % 240, Nat.mod_lt _ (by omega)⟩)

abbrev State := Fin 240 × Fin 240

def layerTwo : List State :=
  (List.finRange 240).flatMap fun i => (oneNext i).map fun j => (i, j)

def extend (states : List State) : List State :=
  (states.flatMap fun xy =>
    ((oneNext xy.2).filter fun z => decide (PairOK 2 (candidate xy.1) (candidate z))).map
      fun z => (xy.2, z)).eraseDups


def vertex (i j : ℕ) : Vertex 5 5 :=
  (⟨i % 5, Nat.mod_lt _ (by omega)⟩, ⟨j % 5, Nat.mod_lt _ (by omega)⟩)

def cycleRoute (i x y : ℕ) : List (Vertex 5 5) :=
  let forward := (y + 5 - x) % 5
  let backward := (x + 5 - y) % 5
  if forward ≤ backward then
    (List.range forward).map (fun r => vertex i (x + r + 1))
  else (List.range backward).map (fun r => vertex i (x + 5 - (r + 1)))

def forwardRoute (u v : Vertex 5 5) : List (Vertex 5 5) :=
  if u.1 = v.1 then cycleRoute u.1.val u.2.val v.2.val
  else cycleRoute u.1.val u.2.val 4 ++
    (List.range (v.1.val - u.1.val)).flatMap (fun r =>
      let i := u.1.val + 1 + r
      if i = v.1.val then vertex i 0 :: cycleRoute i 0 v.2.val
      else [vertex i 0, vertex i 4])

def route (u v : Vertex 5 5) : List (Vertex 5 5) :=
  if u.1.val ≤ v.1.val then forwardRoute u v
  else (v :: forwardRoute v u).reverse.tail

def encode (f : Block) : Fin 3125 :=
  ⟨(f 0).val + 5 * (f 1).val + 25 * (f 2).val + 125 * (f 3).val + 625 * (f 4).val,
    by have := (f 0).isLt; have := (f 1).isLt; have := (f 2).isLt
       have := (f 3).isLt; have := (f 4).isLt; omega⟩

