/- GID: D5/S3/Combinatorics/Apwenian/GuoHanGeneration
   generality: G
   mirror-B: D5/B/S3/Combinatorics/Apwenian/GuoHanGeneration
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Every binary automatic apwenian sequence has a finite sum-equivalent level generator. -/

import D5.S3.Combinatorics.Apwenian.GuoHanDefs
import D5.S0.Automata.DFAOStateLowerBound
import D5.S1.Recurrence.Raney.MaximalBlockEvolution

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.Apwenian.GuoHanGeneration

open D5.S0.Automata.DFAOStateLowerBound
open GuoHanDefs

/-- Canonical most-significant-first binary input. `zeroDigit` chooses `[0]`
rather than the empty word as the representation of zero. -/
def binaryInput (zeroDigit : Bool) (n : ℕ) : List ℕ :=
  if n = 0 then if zeroDigit then [0] else [] else (Nat.digits 2 n).reverse

/-- A finite canonical-input DFAO computes `u`; only its occurring outputs must
be binary. The natural-valued transition alphabet is used only on digits zero
and one. -/
def IsBinaryAutomatic (u : ℕ → ℕ) : Prop :=
  (∀ n, u n < 2) ∧ ∃ (Q : Type) (_ : Fintype Q) (M : DFAO ℕ ℕ Q),
    ∃ zeroDigit : Bool, ∀ n, M.evalOutput (binaryInput zeroDigit n) = u n

/-- A letter map extends to a free-monoid endomorphism by `List.flatMap`.
On every letter of the alphabet its image has length two, stays in the alphabet,
and has sum congruent to that letter modulo two. -/
def AlphabetMorphism (Sigma : Finset ℕ) :=
  {τ : ℕ → List ℕ // ∀ s ∈ Sigma,
    (τ s).length = 2 ∧ (∀ t ∈ τ s, t ∈ Sigma) ∧ (τ s).sum % 2 = s % 2}

/-- Actual successive levels of a directive, beginning with the word `[1]`. -/
def level (σ : ℕ → ℕ → List ℕ) : ℕ → List ℕ
  | 0 => [1]
  | j + 1 => (level σ j).flatMap (σ j)

/-- The concatenation of the first `j` whole levels, in their original order. -/
def levelPrefix (σ : ℕ → ℕ → List ℕ) : ℕ → List ℕ
  | 0 => []
  | j + 1 => levelPrefix σ j ++ level σ j

/-- An infinite sequence is generated by a directive when every actual
concatenated-level word is its exact initial segment and these lengths are
unbounded. This definition makes no reference to automaticity or parity. -/
def Generates (σ : ℕ → ℕ → List ℕ) (v : ℕ → ℕ) : Prop :=
  (∀ j, List.ofFn (fun i : Fin (levelPrefix σ j).length => v i) = levelPrefix σ j) ∧
  ∀ n, ∃ j, n < (levelPrefix σ j).length

/-- Guo--Han Conjecture 1, with the stronger witness of a constant directive.
The generated sequence is unique, belongs to the alphabet, and agrees with the
source sequence modulo two at every nonnegative index. -/
def claim : Prop :=
  ∀ u : ℕ → ℕ, IsBinaryAutomatic u → IsApwenian u →
    ∃ Sigma : Finset ℕ, 1 ∈ Sigma ∧ ∃ τ : AlphabetMorphism Sigma,
      ∃ v : ℕ → ℕ, Generates (fun _ => τ.val) v ∧
        (∀ n, v n ∈ Sigma) ∧ (∀ n, v n % 2 = u n) ∧
        ∀ w, Generates (fun _ => τ.val) w → w = v

/-- Every binary automatic apwenian sequence admits a finite-alphabet,
two-uniform, sum-equivalent level generator. -/
theorem result : claim := by
  classical
  intro u automatic
  obtain ⟨binary, Q, finiteQ, M, zeroDigit, correct⟩ := automatic
  let : Fintype Q := finiteQ
  -- The fresh zero state and all digit laws use only the source machine.
  let δ : Option Q → ℕ → Option Q := fun q b =>
    match q with
    | none => if b = 0 then none else some (M.step M.start b)
    | some q => some (M.step q b)
  let a : ℕ → Option Q := fun n =>
    if n = 0 then none else some (M.toDFA.eval (Nat.digits 2 n).reverse)
  have state_law (n b : ℕ) (hb : b < 2) : a (2 * n + b) = δ (a n) b := by
    by_cases hn : n = 0
    · subst n
      rcases (show b = 0 ∨ b = 1 by omega) with rfl | rfl
      · simp [a, δ]
      · simp [a, δ, DFA.eval]
    · have hnb : 2 * n + b ≠ 0 := by omega
      have hm : (2 * n + b) % 2 = b := by omega
      have hd : (2 * n + b) / 2 = n := by omega
      rw [show a (2 * n + b) =
        some (M.toDFA.eval (Nat.digits 2 (2 * n + b)).reverse) by simp [a, hn]]
      rw [Nat.digits_eq_cons_digits_div (by omega) hnb, hm, hd,
        List.reverse_cons, DFA.eval_append_singleton]
      simp [a, δ, hn]
  let pair : ℕ → Option Q × Option Q := fun n => (a n, a (n + 1))
  have pair_left (n : ℕ) :
      (δ (pair n).1 1, δ (pair n).2 0) = pair (2 * n + 1) := by
    apply Prod.ext
    · exact (state_law n 1 (by omega)).symm
    · simpa only [pair, show 2 * (n + 1) + 0 = 2 * n + 1 + 1 by omega]
        using (state_law (n + 1) 0 (by omega)).symm
  have pair_right (n : ℕ) :
      (δ (pair n).2 0, δ (pair n).2 1) = pair (2 * n + 2) := by
    apply Prod.ext
    · simpa only [pair, show 2 * (n + 1) + 0 = 2 * n + 2 by omega]
        using (state_law (n + 1) 0 (by omega)).symm
    · simpa only [pair, show 2 * (n + 1) + 1 = 2 * n + 2 + 1 by omega]
        using (state_law (n + 1) 1 (by omega)).symm
  -- The first coordinate of the right child is δ₀ of the second coordinate.
  -- Both children are restricted to pairs that actually occur.
  let P := Set.range pair
  let s : ℕ → P := fun n => ⟨pair n, ⟨n, rfl⟩⟩
  let L : P → P := fun p => ⟨(δ p.val.1 1, δ p.val.2 0), by
    obtain ⟨n, hn⟩ := p.property
    exact ⟨2 * n + 1, by rw [← hn]; exact (pair_left n).symm⟩⟩
  let R : P → P := fun p => ⟨(δ p.val.2 0, δ p.val.2 1), by
    obtain ⟨n, hn⟩ := p.property
    exact ⟨2 * n + 2, by rw [← hn]; exact (pair_right n).symm⟩⟩
  have left_eq (n : ℕ) : L (s n) = s (2 * n + 1) := by
    apply Subtype.ext
    exact pair_left n
  have right_eq (n : ℕ) : R (s n) = s (2 * n + 2) := by
    apply Subtype.ext
    exact pair_right n
  let output : Option Q → ℕ := fun q => q.elim (u 0) M.output
  have output_eq (n : ℕ) : output (a n) = u n := by
    by_cases hn : n = 0
    · simp [hn, a, output]
    · simpa [output, a, hn, DFAO.evalOutput, binaryInput] using correct n
  let : Fintype P := Fintype.ofFinite P
  have card_pos : 0 < Fintype.card P := Fintype.card_pos_iff.mpr ⟨s 0⟩
  let index : P ≃ Fin (Fintype.card P) :=
    (Fintype.equivFin P).setValue (s 0) ⟨0, card_pos⟩
  let e : P → ℕ := fun p => 2 * (index p).val + output p.val.1 % 2
  have parity (n : ℕ) : e (s n) % 2 = u n := by
    have h := output_eq n
    have hu := binary n
    dsimp [e, s, pair]
    rw [h]
    omega
  have injective : Function.Injective e := by
    intro p q h
    apply index.injective
    apply Fin.ext
    have hp : output p.val.1 % 2 < 2 := Nat.mod_lt _ (by omega)
    have hq : output q.val.1 % 2 < 2 := Nat.mod_lt _ (by omega)
    dsimp [e] at h
    omega
  intro apwenian
  have root : e (s 0) = 1 := by
    dsimp [e, index]
    rw [Equiv.setValue_eq]
    simp only [Fin.val_zero, mul_zero, zero_add]
    change output (a 0) % 2 = 1
    rw [output_eq, apwenian.1]
  have child_parity (p : P) :
      (e (L p) + e (R p)) % 2 = e p % 2 := by
    obtain ⟨n, hn⟩ := p.property
    have hp : p = s n := Subtype.ext hn.symm
    rw [hp, left_eq, right_eq]
    have h1 := parity (2 * n + 1)
    have h2 := parity (2 * n + 2)
    have h0 := parity n
    have hrec := apwenian.2 n
    omega
  let Sigma := Finset.univ.image e
  have mem_alphabet (p : P) : e p ∈ Sigma := Finset.mem_image.mpr ⟨p, Finset.mem_univ p, rfl⟩
  let τ : ℕ → List ℕ := fun x =>
    if h : ∃ p, e p = x then [e (L h.choose), e (R h.choose)] else []
  have image_eq (p : P) : τ (e p) = [e (L p), e (R p)] := by
    dsimp [τ]
    rw [dif_pos ⟨p, rfl⟩]
    have h : (Exists.choose (show ∃ q, e q = e p from ⟨p, rfl⟩)) = p :=
      injective (Exists.choose_spec (show ∃ q, e q = e p from ⟨p, rfl⟩))
    rw [h]
  have morphism : ∀ x ∈ Sigma,
      (τ x).length = 2 ∧ (∀ t ∈ τ x, t ∈ Sigma) ∧ (τ x).sum % 2 = x % 2 := by
    intro x hx
    obtain ⟨p, _, rfl⟩ := Finset.mem_image.mp hx
    rw [image_eq]
    refine ⟨rfl, ?_, ?_⟩
    · intro t ht
      simp only [List.mem_cons, List.not_mem_nil, or_false] at ht
      rcases ht with rfl | rfl
      · exact mem_alphabet _
      · exact mem_alphabet _
    · simpa using child_parity p
  let σ : ℕ → ℕ → List ℕ := fun _ => τ
  let v : ℕ → ℕ := fun n => e (s n)
  have powers (j : ℕ) : TrureTuring.Raney.morphismPower τ j [1] = level σ j := by
    induction j with
    | zero => rfl
    | succ j ih => rw [TrureTuring.Raney.morphismPower, ih]; rfl
  have levels (j : ℕ) :
      level σ j = List.ofFn (fun k : Fin (2 ^ j) => v (2 ^ j - 1 + k.val)) := by
    induction j with
    | zero => simpa [level, v] using root.symm
    | succ j ih =>
      rw [← powers (j + 1), TrureTuring.Raney.morphismPower, powers j, ih]
      rw [Nat.pow_succ', List.ofFn_mul', List.flatMap_def, List.map_ofFn]
      apply congrArg List.flatten
      apply congrArg List.ofFn
      funext k
      change τ (e (s (2 ^ j - 1 + k.val))) = _
      rw [image_eq, left_eq, right_eq]
      have hp : 0 < 2 ^ j := by positivity
      have hl : 2 * (2 ^ j - 1 + k.val) + 1 =
          2 * 2 ^ j - 1 + 2 * k.val := by omega
      have hr : 2 * (2 ^ j - 1 + k.val) + 2 =
          2 * 2 ^ j - 1 + (2 * k.val + 1) := by omega
      simp [List.ofFn_succ, v, hl, hr]
  have prefixes (j : ℕ) :
      levelPrefix σ j = List.ofFn (fun k : Fin (2 ^ j - 1) => v k.val) := by
    induction j with
    | zero => simp [levelPrefix]
    | succ j ih =>
      rw [levelPrefix, ih, levels]
      have hp : 0 < 2 ^ j := by positivity
      have hs : (2 ^ j - 1) + 2 ^ j = 2 ^ (j + 1) - 1 := by
        rw [Nat.pow_succ']; omega
      calc
        _ = List.ofFn (fun k : Fin ((2 ^ j - 1) + 2 ^ j) => v k.val) := by
          rw [List.ofFn_add]
          rfl
        _ = _ := by
          rw [List.ofFn_congr hs]
          rfl
  have lengths (j : ℕ) : (levelPrefix σ j).length = 2 ^ j - 1 := by
    rw [prefixes, List.length_ofFn]
  have generated : Generates σ v := by
    constructor
    · intro j
      rw [prefixes]
      simp
    · intro n
      refine ⟨n + 1, ?_⟩
      rw [lengths]
      have h := Nat.lt_two_pow_self (n := n + 1)
      omega
  have unique (w : ℕ → ℕ) (hw : Generates σ w) : w = v := by
    funext n
    obtain ⟨j, hj⟩ := generated.2 n
    have heq := (hw.1 j).trans (generated.1 j).symm
    exact congrFun (List.ofFn_injective heq) ⟨n, hj⟩
  refine ⟨Sigma, ?_, ⟨τ, morphism⟩, v, generated,
    fun n => mem_alphabet (s n), parity, unique⟩
  rw [← root]
  exact mem_alphabet (s 0)

#print axioms result

end D5.S3.Combinatorics.Apwenian.GuoHanGeneration
