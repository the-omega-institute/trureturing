/- GID: D5/S3/Combinatorics/Fishburn/FishburnTenElevenFamily
   generality: G
   mirror-B: D5/B/S3/Combinatorics/Fishburn/FishburnTenElevenFamily
   mirror-E: none(waiver:exceptional-fishburn-pair-construction)
   anchors: []
   utility: none
   digest: The bounded Fishburn pair family is generated by three maximum-insertion branches. -/

import D5.S3.Combinatorics.Fishburn.FishburnTenElevenSites
import D5.S3.Combinatorics.Fishburn.FishburnBasicThreePatterns

set_option autoImplicit false
set_option relaxedAutoImplicit false

namespace D5.S3.Combinatorics.Fishburn.FishburnTenElevenFamily

open D5.S3.Combinatorics Nonnesting FishburnDefs FishburnTenElevenSites
open FishburnBasicThreePatterns

def pairPermutation (n a b : ℕ) : List ℕ :=
  (List.range' (a + 1) (n - a)).reverse ++ [1] ++
    (List.range' (b + 1) (a - b)).reverse ++ List.range' 2 (b - 1)

theorem pair_construction (n a b : ℕ) (hb : 2 ≤ b) (hba : b ≤ a) (han : a ≤ n) :
    pairPermutation n a b ∈ avoiders n [[1, 2, 4, 3], [2, 1, 3, 4]] ∧
    ¬ NonnestingDefs.Occurs [2, 1, 3] (pairPermutation n a b) ∧
    (pairPermutation n a b).getD (n - 1) 0 ≠ 1 := by
  have hleft (size lower upper : ℕ) (hupper : upper ≤ size) :
      pairPermutation (size + 1) upper lower =
        (size + 1) :: pairPermutation size upper lower := by
    have hseq : List.range' (upper + 1) (size + 1 - upper) =
        List.range' (upper + 1) (size - upper) ++ [size + 1] := by
      have hc : size + 1 - upper = size - upper + 1 := by omega
      rw [hc, List.range'_concat]
      congr 1
      congr 1
      omega
    simp only [pairPermutation, hseq, List.reverse_append, List.reverse_singleton,
      List.cons_append, List.nil_append]
  have hmiddle (size lower : ℕ) (hlower : lower ≤ size) :
      pairPermutation (size + 1) (size + 1) lower =
        (pairPermutation size size lower).insertIdx 1 (size + 1) := by
    have hseq : List.range' (lower + 1) (size + 1 - lower) =
        List.range' (lower + 1) (size - lower) ++ [size + 1] := by
      have hc : size + 1 - lower = size - lower + 1 := by omega
      rw [hc, List.range'_concat]
      congr 1
      congr 1
      omega
    simp only [pairPermutation, Nat.sub_self, List.range'_zero, List.reverse_nil,
      List.nil_append, hseq, List.reverse_append,
      List.reverse_singleton, List.cons_append,
      List.insertIdx_succ_cons, List.insertIdx_zero]
  have hidentity (size : ℕ) (hs : 1 ≤ size) :
      pairPermutation size size size = List.range' 1 size := by
    cases size with
    | zero => omega
    | succ size => simp [pairPermutation, List.range'_succ]
  induction n generalizing a b with
  | zero => omega
  | succ size ih =>
    by_cases ha : a ≤ size
    · obtain ⟨hparent, havoid, hlast⟩ := ih a b hb hba ha
      have hlen : (pairPermutation size a b).length = size := by
        simpa using hparent.1.length_eq
      rw [hleft size b a ha]
      have hchild : (pairPermutation size a b).insertIdx 0 (size + 1) ∈
          avoiders (size + 1) [[1, 2, 4, 3], [2, 1, 3, 4]] :=
        (fishburn_active_sites size _ hparent 0 (by omega)).mpr (Or.inl rfl)
      refine ⟨by simpa only [List.insertIdx_zero] using hchild, ?_, ?_⟩
      · intro ho
        have hh := (maximum_213_test size _ hparent.1 0 (by omega)).mp
          (by simpa only [List.insertIdx_zero] using ho)
        rcases hh with hold | ⟨first, second, _, hs, _⟩
        · exact havoid hold
        · omega
      · have hsize : 1 ≤ size := by omega
        have hidx : size + 1 - 1 = size - 1 + 1 := by omega
        simpa only [hidx, List.getD_cons_succ] using hlast
    · have hae : a = size + 1 := by omega
      subst a
      by_cases hbs : b ≤ size
      · obtain ⟨hparent, havoid, hlast⟩ := ih size b hb hbs le_rfl
        let parent := pairPermutation size size b
        have hlen : parent.length = size := by simpa using hparent.1.length_eq
        have hone : parent.getD 0 0 = 1 := by simp [parent, pairPermutation]
        have hchild := (fishburn_active_sites size parent hparent 1 (by omega)).mpr
          (Or.inr (Or.inl ⟨0, by omega, hone, by omega⟩))
        rw [hmiddle size b hbs]
        refine ⟨hchild, ?_, ?_⟩
        · intro ho
          rcases (maximum_213_test size parent hparent.1 1 (by omega)).mp ho with
            hold | ⟨first, second, hfs, hs, _⟩
          · exact havoid hold
          · omega
        · have hbound : size < (parent.insertIdx 1 (size + 1)).length := by
            rw [List.length_insertIdx_of_le_length (by omega)]
            omega
          rw [show size + 1 - 1 = size by omega,
            List.getD_eq_getElem _ 0 hbound, List.getElem_insertIdx_of_gt (by omega),
            ← List.getD_eq_getElem parent 0 (by omega)]
          exact hlast
      · have hbe : b = size + 1 := by omega
        subst b
        rw [hidentity (size + 1) (by omega)]
        have hparent : List.range' 1 size ∈
            avoiders size [[1, 2, 4, 3], [2, 1, 3, 4]] := by
          by_cases hs : 2 ≤ size
          · simpa only [hidentity size (by omega)] using (ih size size hs le_rfl le_rfl).1
          · have hs : size = 1 := by omega
            subst size
            refine ⟨List.Perm.refl _, ?_, ?_⟩
            · intro before later hg hl
              simp only [List.length_range'] at hl
              omega
            · intro pattern hp ho
              obtain ⟨_, _, _, hsub, _⟩ := ho
              have hpat : pattern.length = 4 := by
                have hc : pattern = [1, 2, 4, 3] ∨ pattern = [2, 1, 3, 4] := by
                  simpa using hp
                rcases hc with rfl | rfl <;> rfl
              have := hsub.length_le
              simp only [List.length_map, List.length_range', hpat] at this
              omega
        have havoid : ¬ NonnestingDefs.Occurs [2, 1, 3] (List.range' 1 size) := by
          by_cases hs : 2 ≤ size
          · simpa only [hidentity size (by omega)] using (ih size size hs le_rfl le_rfl).2.1
          · have hs : size = 1 := by omega
            subst size
            intro ho
            obtain ⟨_, _, _, hsub, _⟩ := ho
            have := hsub.length_le
            simp only [List.length_map, List.length_cons, List.length_nil,
              List.length_range'] at this
            omega
        have hchild := (fishburn_active_sites size _ hparent size (by simp)).mpr
          (Or.inr (Or.inr ⟨by simp, havoid⟩))
        have hend : (List.range' 1 size).insertIdx size (size + 1) =
            List.range' 1 (size + 1) := by
          have he := List.insertIdx_length_self (l := List.range' 1 size) (x := size + 1)
          simp only [List.length_range'] at he
          rw [he, List.range'_concat]
          simp [Nat.add_comm]
        refine ⟨by rwa [hend] at hchild, ?_, ?_⟩
        · intro ho
          rw [← hend] at ho
          rcases (maximum_213_test size _ hparent.1 size (by simp)).mp ho with
            hold | ⟨first, second, hfs, hs, hgt⟩
          · exact havoid hold
          · rw [List.getD_eq_getElem _ 0 (by simp; omega : first < (List.range' 1 size).length),
              List.getD_eq_getElem _ 0 (by simp; omega : second < (List.range' 1 size).length),
              List.getElem_range', List.getElem_range'] at hgt
            omega
        · rw [List.getD_eq_getElem _ 0 (by simp), List.getElem_range']
          omega

end D5.S3.Combinatorics.Fishburn.FishburnTenElevenFamily
