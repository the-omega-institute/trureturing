/-- An executable rank/fiber checker on an arbitrary finite directed graph.
    The input supplies vertices, Boolean edges, ranks, fibers and collision triples;
    it supplies no monotonicity, capacity or collision laws. -/
def checkRank {α : Type} [DecidableEq α] (vertices : List α)
    (edge : α → α → Bool) (rank : α → ℕ) (fiber : ℕ → List α)
    (cuts : ℕ → α × α × α) (bound : ℕ) : Bool :=
  vertices.all fun d =>
    let B := fiber (rank d)
    let w := cuts (rank d)
    (B.contains d) && (B.dedup.length == B.length) && decide (B.length ≤ bound+1) &&
    vertices.all (fun e => !(edge d e) || decide (rank e ≤ rank d)) &&
    (decide (B.length ≤ bound) ||
      (B.contains w.1 && B.contains w.2.1 && decide (w.1 ≠ w.2.1) &&
        B.all (fun x => (!(edge w.1 x) || (x == w.2.2)) &&
          (!(edge w.2.1 x) || (x == w.2.2)))))

private theorem checkRank_row {α : Type} [DecidableEq α] (V : List α)
    (E : α → α → Bool) (r : α → ℕ) (F : ℕ → List α)
    (W : ℕ → α × α × α) (b : ℕ) (h : checkRank V E r F W b = true)
    (d : α) (hd : d ∈ V) :
    d ∈ F (r d) ∧ (F (r d)).Nodup ∧ (F (r d)).length ≤ b+1 ∧
      (∀ e ∈ V, E d e = true → r e ≤ r d) ∧
      ((F (r d)).length ≤ b ∨
        ((W (r d)).1 ∈ F (r d) ∧ (W (r d)).2.1 ∈ F (r d) ∧
          (W (r d)).1 ≠ (W (r d)).2.1 ∧
          ∀ x ∈ F (r d), (E (W (r d)).1 x = true → x = (W (r d)).2.2) ∧
            (E (W (r d)).2.1 x = true → x = (W (r d)).2.2))) := by
  have hx := (List.all_eq_true.mp h) d hd
  simp only [Bool.and_eq_true, Bool.or_eq_true, Bool.not_eq_true, List.contains_iff_mem,
    beq_iff_eq, decide_eq_true_eq, List.all_eq_true] at hx
  refine ⟨hx.1.1.1.1, List.nodup_iff_length_dedup_eq.mpr hx.1.1.1.2,
    hx.1.1.2, ?_, ?_⟩
  · intro e he hed
    rcases hx.1.2 e he with hno | hle
    · simp [hed] at hno
    · exact hle
  · rcases hx.2 with hsmall | hcut
    · exact Or.inl hsmall
    · refine Or.inr ⟨hcut.1.1.1, hcut.1.1.2, hcut.1.2, ?_⟩
      intro x hxmem
      obtain ⟨ha,hb⟩ := hcut.2 x hxmem
      constructor
      · intro hed
        rcases ha with hno | heq
        · simp [hed] at hno
        · exact heq
      · intro hed
        rcases hb with hno | heq
        · simp [hed] at hno
        · exact heq

private theorem generic_cycle_edge {α : Type} [Inhabited α] (E : α → α → Bool)
    (c : List α) (hc : (c ++ [c.head!]).IsChain (fun a b => E a b = true))
    (hk : 0 < c.length) (i : Fin c.length) :
    E c[i.val] (getElem c ((i.val+1)%c.length) (Nat.mod_lt _ hk)) = true := by
  have h := (List.isChain_iff_getElem.mp hc) i.val (by simpa using i.isLt)
  by_cases hn : i.val+1 < c.length
  · simpa [List.getElem_append, i.isLt, hn, Nat.mod_eq_of_lt hn] using h
  · have heq : i.val+1 = c.length := by omega
    have hh : c.head! = c[0] := by
      rw [List.head!_eq_getElem!, getElem!_pos c 0 (by omega)]
    simpa [List.getElem_append, i.isLt, hn, heq, hh] using h

private theorem generic_successor_injective {α : Type} (c : List α)
    (hnd : c.Nodup) (hk : 0 < c.length) (i j : Fin c.length)
    (he : getElem c ((i.val+1)%c.length) (Nat.mod_lt _ hk) =
      getElem c ((j.val+1)%c.length) (Nat.mod_lt _ hk)) : i=j := by
  have hm : (i.val+1)%c.length = (j.val+1)%c.length := hnd.getElem_inj_iff.mp he
  letI : NeZero c.length := ⟨by omega⟩
  apply (finRotate c.length).injective
  apply Fin.ext
  simpa [finRotate_apply,Fin.add_def,Nat.add_mod] using hm

/-- Successful arbitrary graph checking bounds every simple cycle, of any length.
    Rank constancy, fiber containment and successor injectivity are proved here. -/
theorem checkRank_sound {α : Type} [DecidableEq α] [Inhabited α]
    (V : List α) (E : α → α → Bool) (r : α → ℕ) (F : ℕ → List α)
    (W : ℕ → α × α × α) (b : ℕ) (h : checkRank V E r F W b = true)
    (c : List α) (hnd : c.Nodup) (hne : c ≠ []) (hsub : c ⊆ V)
    (hc : (c ++ [c.head!]).IsChain (fun a b => E a b = true)) : c.length ≤ b := by
  have hh : c.head! ∈ c := by cases c with | nil => contradiction | cons a l => simp
  have row := checkRank_row V E r F W b h
  have hall : ∀ x ∈ c ++ [c.head!], x ∈ V := by
    intro x hx
    rcases List.mem_append.mp hx with hx | hx
    · exact hsub hx
    · have : x = c.head! := by simpa using hx
      simpa [this] using hsub hh
  let R := fun d e : α => r e ≤ r d
  letI : Trans R R R := ⟨fun h₁ h₂ => le_trans h₂ h₁⟩
  have hp : (c ++ [c.head!]).Pairwise R :=
    (hc.imp_of_mem_imp (fun d e hd he hedge => (row d (hall d hd)).2.2.2.1 e (hall e he) hedge)).pairwise
  have hr : ∀ d ∈ c, r d = r c.head! := by
    cases c with
    | nil => contradiction
    | cons a l =>
      simp only [List.cons_append, List.head!_cons, List.pairwise_cons] at hp
      intro d hd
      rcases List.mem_cons.mp hd with rfl | hd
      · rfl
      · exact le_antisymm (hp.1 d (by simp [hd]))
          ((List.pairwise_append.mp hp.2).2.2 d hd a (by simp))
  let B := F (r c.head!)
  have hB : c ⊆ B := by
    intro d hd
    have hm := (row d (hsub hd)).1
    simpa [B, hr d hd] using hm
  have hrow := row c.head! (hsub hh)
  rcases hrow.2.2.2.2 with hsmall | hcut
  · exact le_trans (hnd.length_le_of_subset hB) hsmall
  by_contra hbad
  have hlen : c.length = B.length := by
    have hl := hnd.length_le_of_subset hB
    have hb : B.length ≤ b+1 := hrow.2.2.1
    omega
  have hfull : ∀ x, x ∈ c ↔ x ∈ B := by
    have hs : c.toFinset ⊆ B.toFinset := by
      intro x hx
      exact List.mem_toFinset.mpr (hB (List.mem_toFinset.mp hx))
    have he : c.toFinset = B.toFinset := Finset.eq_of_subset_of_card_le hs (by
      rw [List.toFinset_card_of_nodup hnd, List.toFinset_card_of_nodup hrow.2.1]
      exact hlen.ge)
    intro x
    have := Finset.ext_iff.mp he x
    simpa using this
  let a := (W (r c.head!)).1
  let d := (W (r c.head!)).2.1
  let z := (W (r c.head!)).2.2
  obtain ⟨i,hi,hia⟩ := List.mem_iff_getElem.mp ((hfull a).mpr hcut.1)
  obtain ⟨j,hj,hjd⟩ := List.mem_iff_getElem.mp ((hfull d).mpr hcut.2.1)
  have hk : 0<c.length := by
    cases c with | nil => contradiction | cons a l => simp
  have hsi : getElem c ((i+1)%c.length) (Nat.mod_lt _ hk) = z :=
    (hcut.2.2.2 _ ((hfull _).mp (List.getElem_mem _))).1 (by
      simpa [a, hia] using generic_cycle_edge E c hc hk ⟨i,hi⟩)
  have hsj : getElem c ((j+1)%c.length) (Nat.mod_lt _ hk) = z :=
    (hcut.2.2.2 _ ((hfull _).mp (List.getElem_mem _))).2 (by
      simpa [d, hjd] using generic_cycle_edge E c hc hk ⟨j,hj⟩)
  have hij := generic_successor_injective c hnd hk ⟨i,hi⟩ ⟨j,hj⟩ (hsi.trans hsj.symm)
  have : i=j := congrArg Fin.val hij
  subst j
  exact hcut.2.2.1 (hia.symm.trans hjd)

private def enumerate (n lo : ℕ) : ℕ → List (List ℕ)
  | 0 => [[]]
  | k+1 => ((List.range (n+1)).filter (lo ≤ ·)).flatMap fun a =>
      (enumerate n a k).map (a :: ·)

private theorem enumerate_complete (n lo k : ℕ) (d : List ℕ)
    (hlen : d.length = k) (hs : d.Pairwise (· ≤ ·))
    (hb : ∀ x ∈ d, lo ≤ x ∧ x ≤ n) : d ∈ enumerate n lo k := by
  induction k generalizing lo d with
  | zero => have : d=[] := List.eq_nil_of_length_eq_zero hlen; subst d; simp [enumerate]
  | succ k ih =>
    cases d with
    | nil => simp at hlen
    | cons a d =>
      have ha := hb a (by simp)
      have ht : ∀ x ∈ d, a ≤ x ∧ x ≤ n := by
        intro x hx
        exact ⟨(List.pairwise_cons.mp hs).1 x hx, (hb x (by simp [hx])).2⟩
      simp only [enumerate, List.mem_flatMap, List.mem_filter, List.mem_range,
        decide_eq_true_eq, List.mem_map]
      exact ⟨a,⟨by omega,ha.1⟩,d,ih a d (by simpa using hlen)
        (List.pairwise_cons.mp hs).2 ht,rfl⟩

private def dice6 : List (List ℕ) := enumerate 6 1 6

private theorem dice6_complete (d : List ℕ) (hd : IsDie 6 d) : d ∈ dice6 :=
  enumerate_complete 6 1 6 d hd.1 hd.2.1 hd.2.2

