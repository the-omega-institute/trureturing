private theorem certificate :
    ∀ d ∈ dice6, d ∈ fiber6 (rank6 d) ∧ (fiber6 (rank6 d)).Nodup ∧
      (fiber6 (rank6 d)).length ≤ 7 ∧
      (∀ e ∈ dice6, winCount d e = 19 → rank6 e ≤ rank6 d) := by
  decide

private theorem rank_edge (d e : List ℕ) (h : Edge 6 d e) : rank6 e ≤ rank6 d := by
  have hd := dice6_complete d h.1
  have he := dice6_complete e h.2.1
  exact (certificate d hd).2.2.2 e he ((edge_iff 6 (by decide) d e h.1 h.2.1).mp h)

private theorem constant_rank (c : List (List ℕ)) (hne : c ≠ [])
    (hc : (c ++ [c.head!]).IsChain (Edge 6)) :
    ∀ d ∈ c, rank6 d = rank6 c.head! := by
  let R := fun d e : List ℕ => rank6 e ≤ rank6 d
  letI : Trans R R R := ⟨fun _ _ _ h₁ h₂ => le_trans h₂ h₁⟩
  have hp : (c ++ [c.head!]).Pairwise R := (hc.imp (fun h => rank_edge _ _ h)).pairwise
  cases c with
  | nil => contradiction
  | cons a l =>
    simp only [List.cons_append, List.head!_cons, List.pairwise_cons] at hp
    intro d hd
    rcases List.mem_cons.mp hd with rfl | hd
    · rfl
    · have h₁ : rank6 d ≤ rank6 a := hp.1 d (by simp [hd])
      have h₂ : rank6 a ≤ rank6 d := (List.pairwise_append.mp hp.2).2.2 d hd a (by simp)
      exact le_antisymm h₁ h₂

private theorem valid_member (c : List (List ℕ))
    (hc : (c ++ [c.head!]).IsChain (Edge 6)) (d : List ℕ) (hd : d ∈ c) : IsDie 6 d := by
  obtain ⟨i,hi,rfl⟩ := List.mem_iff_getElem.mp hd
  have h := hc.getElem i (by simp; omega)
  have hv := h.1
  simpa [List.getElem_append,hi] using hv

private theorem equal_fiber (d e : List ℕ) (hd : d ∈ dice6) (he : e ∈ dice6)
    (hr : rank6 d = rank6 e) : e ∈ fiber6 (rank6 d) := by
  rw [hr]
  exact (certificate e he).1

private def blockA : List (List ℕ) := [[1,1,2,5,5,5],[1,1,2,5,5,6],[1,2,2,3,6,6],[1,3,3,4,4,4],[1,3,4,4,4,4],[2,2,2,3,6,6],[2,2,3,3,3,6]]
private def blockB : List (List ℕ) := [[1,1,4,5,5,5],[1,1,4,5,5,6],[1,2,2,5,6,6],[1,4,4,4,5,5],[2,2,2,5,6,6],[3,3,3,3,4,6],[3,3,3,4,4,6]]

private theorem large_fiber (d : List ℕ) (hd : d ∈ dice6)
    (hlarge : 7 ≤ (fiber6 (rank6 d)).length) :
    fiber6 (rank6 d) = blockA ∨ fiber6 (rank6 d) = blockB := by
  have h : ∀ d ∈ dice6, 7 ≤ (fiber6 (rank6 d)).length →
      fiber6 (rank6 d) = blockA ∨ fiber6 (rank6 d) = blockB := by decide
  exact h d hd hlarge

private theorem successor_injective (c : List (List ℕ)) (hnd : c.Nodup) (hk : 0 < c.length)
    (i j : Fin c.length)
    (he : c[(i.val+1)%c.length] = c[(j.val+1)%c.length]) : i=j := by
  have hm : (i.val+1)%c.length = (j.val+1)%c.length := hnd.getElem_inj_iff.mp he
  letI : NeZero c.length := ⟨by omega⟩
  apply (finRotate c.length).injective
  apply Fin.ext
  simpa [finRotate_apply,Fin.add_def,Nat.add_mod] using hm

private theorem collision_excludes (B : List (List ℕ)) (a b z : List ℕ)
    (ha : a ∈ B) (hb : b ∈ B) (hab : a ≠ b)
    (hs : ∀ x ∈ B, winCount a x = 19 → x=z)
    (ht : ∀ x ∈ B, winCount b x = 19 → x=z)
    (c : List (List ℕ)) (hnd : c.Nodup) (hk : 0<c.length)
    (hc : (c ++ [c.head!]).IsChain (Edge 6)) (heq : ∀ x, x ∈ c ↔ x ∈ B) : False := by
  obtain ⟨i,hi,hia⟩ := List.mem_iff_getElem.mp ((heq a).mpr ha)
  obtain ⟨j,hj,hjb⟩ := List.mem_iff_getElem.mp ((heq b).mpr hb)
  have hI := cycle_edge_at 6 c.length c rfl hc hk ⟨i,hi⟩
  have hJ := cycle_edge_at 6 c.length c rfl hc hk ⟨j,hj⟩
  have hsi : c[(i+1)%c.length] = z := hs _
    ((heq _).mp (List.getElem_mem _)) (by
      have h := (edge_iff 6 (by decide) _ _ hI.1 hI.2.1).mp hI
      simpa [hia] using h)
  have hsj : c[(j+1)%c.length] = z := ht _
    ((heq _).mp (List.getElem_mem _)) (by
      have h := (edge_iff 6 (by decide) _ _ hJ.1 hJ.2.1).mp hJ
      simpa [hjb] using h)
  have hij := successor_injective c hnd hk ⟨i,hi⟩ ⟨j,hj⟩ (hsi.trans hsj.symm)
  have : i=j := congrArg Fin.val hij
  subst j
  exact hab (hia.symm.trans hjb)

/-- Every simple cycle for six-face dice has length at most six. -/
theorem six_cycle_bound (k : ℕ) (hc : HasCycle 6 k) : k ≤ 6 := by
  by_contra hbad
  obtain ⟨c,hlen,hnd,hne,hchain⟩ := hc
  have hk : 0<c.length := by omega
  have hhead : c.head! ∈ c := by cases c with | nil => contradiction | cons a l => simp
  have hvalid := valid_member c hchain c.head! hhead
  have hd := dice6_complete _ hvalid
  let B := fiber6 (rank6 c.head!)
  have hsub : c ⊆ B := by
    intro d hdmem
    exact equal_fiber c.head! d hd (dice6_complete d (valid_member c hchain d hdmem))
      (constant_rank c hne hchain d hdmem).symm
  have hle := hnd.length_le_of_subset hsub
  have hcap : B.length ≤ 7 := (certificate c.head! hd).2.2.1
  have hfull : ∀ x, x ∈ c ↔ x ∈ B := by
    have hlen' : c.length = B.length := by omega
    have hs : c.toFinset ⊆ B.toFinset := by simpa using hsub
    have he : c.toFinset = B.toFinset := Finset.eq_of_subset_of_card_le hs (by
      rw [List.toFinset_card_of_nodup hnd,
        List.toFinset_card_of_nodup (certificate c.head! hd).2.1]
      omega)
    intro x
    have := Finset.ext_iff.mp he x
    simpa using this
  rcases large_fiber c.head! hd (by change 7≤B.length; omega) with hA | hB
  · have heq : ∀ x, x∈c ↔ x∈blockA := by simpa [B,hA] using hfull
    exact collision_excludes blockA [1,2,2,3,6,6] [2,2,3,3,3,6] [1,1,2,5,5,5]
      (by decide) (by decide) (by decide) (by decide) (by decide)
      c hnd hk hchain heq
  · have heq : ∀ x, x∈c ↔ x∈blockB := by simpa [B,hB] using hfull
    exact collision_excludes blockB [1,1,4,5,5,6] [1,1,4,5,5,5] [3,3,3,3,4,6]
      (by decide) (by decide) (by decide) (by decide) (by decide)
      c hnd hk hchain heq

/-- The six-face global bound is attained by a six-cycle. -/
theorem S_six : S 6 := ⟨finite_cycle_witnesses.1,fun k hk hc => by
  have := six_cycle_bound k hc
  omega⟩

/-- Easlick's complete conjecture holds for the exact unconditional dice graph. -/
theorem conjecture_one : ConjectureOne := ⟨S_six,not_S_above_six⟩

end D5.S3.Combinatorics.Dice.EaslickSixBound
