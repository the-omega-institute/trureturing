universe u v
variable {A : Type u} {I : Type v} [AddCommGroup A] [Fintype A] [Fintype I]

private theorem lift_from_fair_columns {J : Type*} [Fintype J] (two : ∀ a : A, a + a = 0)
    (H : AddSubgroup A) [Fintype (A ⧸ H)] (d : J → H)
    (hspan : ∀ χ : AddChar A ℂ, (∀ j, χ (d j) = 1) → ∀ a ∈ H, χ a = 1)
    (c : I → A ⧸ H) (s : A) (q : I → ℝ) :
    ∃ k : J ⊕ I → A, ∃ r : J ⊕ I → ℝ,
      (∀ j : J ⊕ I, |r j| ≤ 1 ↔ match j with
        | .inl _ => True
        | .inr i => |q i| ≤ 1) ∧
      (∀ φ : AddChar (A ⧸ H) ℂ,
        let χ := φ.compAddMonoidHom (QuotientAddGroup.mk' H)
        moment (law k s r) χ = sign χ s * moment (law c (0 : A ⧸ H) q) φ) ∧
      ∀ χ : AddChar A ℂ, (∃ a ∈ H, χ a ≠ 1) → moment (law k s r) χ = 0 := by
  classical
  let π := QuotientAddGroup.mk' H
  choose l hl using QuotientAddGroup.mk'_surjective H
  let k : J ⊕ I → A := Sum.elim (fun j => (d j : A)) (l ∘ c)
  let r : J ⊕ I → ℝ := Sum.elim (fun _ => 0) q
  refine ⟨k, r, ?_, ?_, ?_⟩
  · intro j
    cases j <;> simp [r]
  · intro φ χ
    have hs (x : H) : π x = 0 := by
      change (x : A) ∈ π.ker
      rw [QuotientAddGroup.ker_mk']
      exact x.property
    have h0 : sign φ 0 = 1 := by simp [sign]
    have hLeft : (∏ x : J, if sign χ (k (.inl x)) = -1 then r (.inl x) else 1) = 1 := by
      apply Finset.prod_eq_one
      intro x _
      have hx : sign χ (k (.inl x)) = 1 := by
        change (φ (π (d x))).re = 1
        simp [hs (d x)]
      norm_num [hx]
    have hRight (i : I) : sign χ (k (.inr i)) = sign φ (c i) := by
      change (φ (π (l (c i)))).re = (φ (c i)).re
      rw [hl]
    rw [moment_from_inputs two, moment_from_inputs (quotient_two H two), h0, one_mul,
      Fintype.prod_sum_type, hLeft, one_mul]
    congr 1
    apply Finset.prod_congr rfl
    intro i _
    rw [hRight]
    rfl
  · intro χ hex
    obtain ⟨a, ha, hχ⟩ := hex
    by_contra hzero
    have h := (support_iff_trivial_on_fair_columns two k s r χ).mp hzero
    exact hχ (hspan χ (fun j => h (.inl j) rfl) a ha)

/-- The subgroup generated by the output columns of the fair inputs. -/
def fairSpan (c : I → A) (q : I → ℝ) : AddSubgroup A :=
  AddSubgroup.closure {a | ∃ i, q i = 0 ∧ c i = a}

/-- The elements on which every character with a nonzero moment is trivial. -/
def spectralAnnihilator (μ : A → ℝ) : AddSubgroup A where
  carrier := {a | ∀ χ : AddChar A ℂ, moment μ χ ≠ 0 → χ a = 1}
  zero_mem' := by simp
  add_mem' := by
    intro a b ha hb χ hχ
    rw [AddChar.map_add_eq_mul, ha χ hχ, hb χ hχ, one_mul]
  neg_mem' := by
    intro a ha χ hχ
    rw [AddChar.map_neg_eq_inv, ha χ hχ, inv_one]

/-- Every representation has the same fair subgroup, recovered from the nonzero moments. -/
theorem fairSpan_eq_spectralAnnihilator (two : ∀ a : A, a + a = 0)
    (c : I → A) (s : A) (q : I → ℝ) :
    fairSpan c q = spectralAnnihilator (law c s q) := by
  classical
  let H := fairSpan c q
  let π := QuotientAddGroup.mk' H
  let _ : Fintype (A ⧸ H) := Fintype.ofFinite _
  apply le_antisymm
  · intro a ha χ hχ
    apply trivial_on_closure χ _ _ a ha
    rintro x ⟨i, hi, rfl⟩
    exact (support_iff_trivial_on_fair_columns two c s q χ).mp hχ i hi
  intro a ha
  by_contra hn
  have hπ : π a ≠ 0 := by
    intro hz
    apply hn
    change a ∈ H
    rw [← QuotientAddGroup.ker_mk' H]
    exact hz
  obtain ⟨φ, hφ⟩ := exists_negative_sign (quotient_two H two) (π a) hπ
  let χ := φ.compAddMonoidHom π
  have hχ : moment (law c s q) χ ≠ 0 := by
    apply (support_iff_trivial_on_fair_columns two c s q χ).mpr
    intro i hi
    have hci : π (c i) = 0 := by
      change c i ∈ π.ker
      rw [QuotientAddGroup.ker_mk']
      exact AddSubgroup.subset_closure ⟨i, hi, rfl⟩
    change φ (π (c i)) = 1
    rw [hci, AddChar.map_zero_eq_one]
  have hone : χ a = 1 := ha χ hχ
  change φ (π a) = 1 at hone
  norm_num [sign, hone] at hφ

/-- The bias factor of a quotient column recovered by logarithmic Fourier inversion. -/
noncomputable def visibleBias (H : AddSubgroup A) (μ : A → ℝ) (u : A ⧸ H) : ℝ := by
  classical
  let _ : Fintype (A ⧸ H) := Fintype.ofFinite _
  let _ : Fintype (AddChar (A ⧸ H) ℂ) := Fintype.ofFinite _
  exact Real.exp ((-2 / (Fintype.card (A ⧸ H) : ℝ)) *
    ∑ ψ : AddChar (A ⧸ H) ℂ, sign ψ u *
      Real.log |moment μ (ψ.compAddMonoidHom (QuotientAddGroup.mk' H))|)

private theorem grouped_abs_eq_of_fiber {B : Type*} (f : I → B) (q r : I → ℝ)
    (u : B) (h : ∀ i, f i = u → r i = |q i|) :
    groupBias f r u = |groupBias f q u| := by
  classical
  unfold groupBias
  rw [Finset.abs_prod]
  exact Finset.prod_congr rfl fun i hi => h i (Finset.mem_filter.mp hi).2

/-- At a nonzero quotient column, logarithmic inversion recovers the absolute grouped bias. -/
theorem visibleBias_recovered (two : ∀ a : A, a + a = 0)
    (c : I → A) (s : A) (q : I → ℝ)
    (u : A ⧸ fairSpan c q) (hu : u ≠ 0) :
    visibleBias (fairSpan c q) (law c s q) u =
      |groupBias (QuotientAddGroup.mk' (fairSpan c q) ∘ c) q u| := by
  classical
  let H := fairSpan c q
  let _ : Fintype (A ⧸ H) := Fintype.ofFinite _
  let _ : Fintype (AddChar (A ⧸ H) ℂ) := Fintype.ofFinite _
  let f := QuotientAddGroup.mk' H ∘ c
  let r (i : I) : ℝ := if f i = 0 then 1 else |q i|
  have hfair (i : I) (hi : q i = 0) : f i = 0 := by
    change c i ∈ (QuotientAddGroup.mk' H).ker
    rw [QuotientAddGroup.ker_mk']
    exact AddSubgroup.subset_closure ⟨i, hi, rfl⟩
  have hpos (i : I) : 0 < r i := by
    by_cases hi : f i = 0
    · simp [r, hi]
    · rw [show r i = |q i| by simp [r, hi]]
      exact abs_pos.mpr (fun h => hi (hfair i h))
  have hspec (ψ : AddChar (A ⧸ H) ℂ) :
      |moment (law f (0 : A ⧸ H) r) ψ| =
        |moment (law c s q) (ψ.compAddMonoidHom (QuotientAddGroup.mk' H))| := by
    rw [moment_pushforward two, moment_from_inputs (quotient_two H two),
      moment_from_inputs (quotient_two H two), abs_mul, abs_mul]
    have hs : ∀ x : A ⧸ H, |sign ψ x| = 1 := by
      intro x
      rcases value_cases (quotient_two H two) ψ x with h | h <;> norm_num [sign, h]
    rw [hs, hs, one_mul, one_mul, Finset.abs_prod, Finset.abs_prod]
    apply Finset.prod_congr rfl
    intro i _
    change |(if sign ψ (f i) = -1 then r i else 1)| =
      |(if sign ψ (f i) = -1 then q i else 1)|
    by_cases h : f i = 0
    · have h0 : sign ψ 0 = 1 := by simp [sign]
      norm_num [h, h0]
    · rw [show r i = |q i| by simp [r, h]]
      split_ifs <;> simp
  have hg : groupBias f r u = |groupBias f q u| :=
    grouped_abs_eq_of_fiber f q r u fun i heq => by simp [r, heq, hu]
  have hEq := loginvert (quotient_two H two) f 0 r hpos u hu
  simp_rw [hspec] at hEq
  unfold visibleBias
  change Real.exp _ = _
  have hgroup : 0 < groupBias f r u := Finset.prod_pos (fun i _ => hpos i)
  rw [← hEq, Real.exp_log hgroup, hg]

/-- Two offsets correcting the same surviving signs differ by an element of the spectral annihilator. -/
theorem signed_offsets_agree_modulo_annihilator (two : ∀ a : A, a + a = 0)
    (μ : A → ℝ) (s t : A)
    (hs : ∀ χ : AddChar A ℂ, moment μ χ ≠ 0 → 0 < sign χ s * moment μ χ)
    (ht : ∀ χ : AddChar A ℂ, moment μ χ ≠ 0 → 0 < sign χ t * moment μ χ) :
    s - t ∈ spectralAnnihilator μ := by
  intro χ hχ
  rcases value_cases two χ s with h₁ | h₁ <;>
    rcases value_cases two χ t with h₂ | h₂
  · rw [sub_eq_add_neg, AddChar.map_add_eq_mul, AddChar.map_neg_eq_inv, h₁, h₂]
    norm_num
  · have hp := hs χ hχ
    have hn := ht χ hχ
    simp [sign, h₁] at hp
    simp [sign, h₂] at hn
    linarith
  · have hn := hs χ hχ
    have hp := ht χ hχ
    simp [sign, h₁] at hn
    simp [sign, h₂] at hp
    linarith
  · rw [sub_eq_add_neg, AddChar.map_add_eq_mul, AddChar.map_neg_eq_inv, h₁, h₂]
    norm_num

private theorem criterion_subgroup_eq_annihilator (two : ∀ a : A, a + a = 0)
    (μ : A → ℝ) (H : AddSubgroup A) (s : A) (h : quotientCriterion H s μ) :
    H = spectralAnnihilator μ := by
  classical
  let π := QuotientAddGroup.mk' H
  let _ : Fintype (A ⧸ H) := Fintype.ofFinite _
  apply le_antisymm
  · intro a ha χ hχ
    by_contra hn
    exact hχ (h.1 χ ⟨a, ha, hn⟩)
  intro a ha
  by_contra hn
  have hu : π a ≠ 0 := by
    intro hz
    apply hn
    rw [← QuotientAddGroup.ker_mk' H]
    exact hz
  obtain ⟨φ, hφ⟩ := exists_negative_sign (quotient_two H two) (π a) hu
  let χ := φ.compAddMonoidHom π
  have hp := h.2.1 φ
  rw [moment_shiftedQuotient two] at hp
  have hnz : moment μ χ ≠ 0 := by
    intro hz
    change 0 < sign χ s * moment μ χ at hp
    rw [hz, mul_zero] at hp
    exact (lt_irrefl 0) hp
  have hone : χ a = 1 := ha χ hnz
  change φ (π a) = 1 at hone
  norm_num [sign, hone] at hφ

/-- The offsets that make all surviving moments positive form exactly the coset specified by
the quotient criterion. -/
theorem adjusted_offset_coset_exact (two : ∀ a : A, a + a = 0)
    (μ : A → ℝ) (H : AddSubgroup A) (s t : A) (h : quotientCriterion H s μ) :
    (∀ χ : AddChar A ℂ, moment μ χ ≠ 0 → 0 < sign χ t * moment μ χ) ↔ t - s ∈ H := by
  classical
  have htrivial (χ : AddChar A ℂ) (hχ : moment μ χ ≠ 0) : ∀ a ∈ H, χ a = 1 := by
    intro a ha
    by_contra hne
    exact hχ (h.1 χ ⟨a, ha, hne⟩)
  have hs (χ : AddChar A ℂ) (hχ : moment μ χ ≠ 0) : 0 < sign χ s * moment μ χ := by
    obtain ⟨φ, rfl⟩ := trivial_character_descends H χ (htrivial χ hχ)
    have hp := h.2.1 φ
    rwa [moment_shiftedQuotient two] at hp
  constructor
  · intro ht
    rw [criterion_subgroup_eq_annihilator two μ H s h]
    exact signed_offsets_agree_modulo_annihilator two μ t s ht hs
  · intro hmem χ hχ
    have hphase : χ t = χ s := by
      calc
        χ t = χ ((t - s) + s) := by rw [sub_add_cancel]
        _ = χ s := by rw [AddChar.map_add_eq_mul, htrivial χ hχ _ hmem, one_mul]
    simpa only [sign, hphase] using hs χ hχ

private abbrev activeClasses (H : AddSubgroup A) (μ : A → ℝ) : Type _ :=
  {u : A ⧸ H // u ≠ 0 ∧ visibleBias H μ u < 1}

/-- The fair dimension plus the number of nonzero quotient columns with bias below one. -/
noncomputable def minimumInputCount [Module (ZMod 2) A] (μ : A → ℝ) : ℕ :=
  let H := spectralAnnihilator μ
  Module.finrank (ZMod 2) (AddSubgroup.toZModSubmodule 2 H) + Nat.card (activeClasses H μ)

omit [Fintype A] in
private theorem fair_rank_le_count [Module (ZMod 2) A]
    (c : I → A) (q : I → ℝ) :
    Module.finrank (ZMod 2) (AddSubgroup.toZModSubmodule 2 (fairSpan c q)) ≤
      Nat.card {i : I // q i = 0} := by
  classical
  let f : {i : I // q i = 0} → A := fun i => c i
  let _ : Fintype {i : I // q i = 0} := Fintype.ofFinite _
  have hrange : Set.range f = {x | ∃ i, q i = 0 ∧ c i = x} := by
    ext x
    constructor
    · rintro ⟨⟨i, hi⟩, hx⟩
      exact ⟨i, hi, hx⟩
    · rintro ⟨i, hi, hx⟩
      exact ⟨⟨i, hi⟩, hx⟩
  have hspan : Submodule.span (ZMod 2) (Set.range f) =
      AddSubgroup.toZModSubmodule 2 (fairSpan c q) := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rw [hrange]
      intro a ha
      exact AddSubgroup.subset_closure ha
    · change fairSpan c q ≤ (Submodule.span (ZMod 2) (Set.range f)).toAddSubgroup
      apply (AddSubgroup.closure_le _).mpr
      rw [← hrange]
      exact Submodule.subset_span
  rw [← hspan, Nat.card_eq_fintype_card]
  exact finrank_range_le_card (R := ZMod 2) f

private theorem group_bias_eq_one_without_column {B : Type*} (f : I → B) (q : I → ℝ)
    (u : B) (h : ¬ ∃ i, f i = u) : groupBias f q u = 1 := by
  classical
  unfold groupBias
  apply Finset.prod_eq_one
  intro i hi
  exact (h ⟨i, (Finset.mem_filter.mp hi).2⟩).elim

private theorem active_classes_le_nonfair_count (two : ∀ a : A, a + a = 0)
    (c : I → A) (s : A) (q : I → ℝ) :
    Nat.card (activeClasses (fairSpan c q) (law c s q)) ≤ Nat.card {i : I // q i ≠ 0} := by
  classical
  let H := fairSpan c q
  let K := activeClasses H (law c s q)
  let f := QuotientAddGroup.mk' H ∘ c
  let _ : Fintype K := Fintype.ofFinite _
  let _ : Fintype {i : I // q i ≠ 0} := Fintype.ofFinite _
  have hgroup (u : K) : |groupBias f q u.val| < 1 := by
    exact (visibleBias_recovered two c s q u.val u.property.1) ▸ u.property.2
  have hfiber (u : K) : ∃ i, f i = u.val := by
    by_contra h
    have hone : groupBias f q u.val = 1 := group_bias_eq_one_without_column f q u.val h
    have hlt := hgroup u
    norm_num [hone] at hlt
  choose g hg using hfiber
  have hnonzero (u : K) : q (g u) ≠ 0 := by
    intro hz
    have hc : f (g u) = 0 := by
      change c (g u) ∈ (QuotientAddGroup.mk' H).ker
      rw [QuotientAddGroup.ker_mk']
      exact AddSubgroup.subset_closure ⟨g u, hz, rfl⟩
    exact u.property.1 ((hg u).symm.trans hc)
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card]
  apply Fintype.card_le_of_injective (fun u : K => (⟨g u, hnonzero u⟩ : {i : I // q i ≠ 0}))
  intro u v h
  have hgv : g u = g v := congrArg Subtype.val h
  apply Subtype.ext
  exact (hg u).symm.trans ((congrArg f hgv).trans (hg v))

private theorem minimum_input_count_le [Module (ZMod 2) A] (two : ∀ a : A, a + a = 0)
    (c : I → A) (s : A) (q : I → ℝ) :
    minimumInputCount (law c s q) ≤ Fintype.card I := by
  classical
  let _ : Fintype {i : I // q i = 0} := Fintype.ofFinite _
  let _ : Fintype {i : I // q i ≠ 0} := Fintype.ofFinite _
  unfold minimumInputCount
  rw [← fairSpan_eq_spectralAnnihilator two c s q]
  have h := Nat.add_le_add (fair_rank_le_count c q) (active_classes_le_nonfair_count two c s q)
  refine h.trans ?_
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Fintype.card_subtype_compl]
  exact (Nat.add_sub_of_le (Fintype.card_subtype_le (fun i => q i = 0))).le

omit [Fintype A] in
private theorem fair_basis_reads_subgroup [Module (ZMod 2) A] (H : AddSubgroup A)
    {J : Type*} (d : Module.Basis J (ZMod 2) (AddSubgroup.toZModSubmodule 2 H))
    (χ : AddChar A ℂ) (hd : ∀ j, χ (d j) = 1) :
    ∀ a ∈ H, χ a = 1 := by
  let V := AddSubgroup.toZModSubmodule 2 H
  let K : AddSubgroup V :=
    (AddChar.toAddMonoidHomEquiv χ).ker.comap V.subtype.toAddMonoidHom
  have hK : Submodule.span (ZMod 2) (Set.range d) ≤ AddSubgroup.toZModSubmodule 2 K := by
    apply Submodule.span_le.mpr
    rintro x ⟨j, rfl⟩
    exact hd j
  rw [d.span_eq] at hK
  intro a ha
  exact hK (show (⟨a, ha⟩ : V) ∈ (⊤ : Submodule (ZMod 2) V) from Submodule.mem_top)

private theorem law_prune_columns {B : Type*} [AddCommGroup B] [Fintype B]
    (two : ∀ x : B, x + x = 0) (r : B → ℝ) (hr : ∀ a, r a ≤ 1)
    [Fintype {a : B // a ≠ 0 ∧ r a < 1}] :
    law (fun a : {a : B // a ≠ 0 ∧ r a < 1} => a.val) 0 (fun a => r a.val) = law id 0 r := by
  classical
  apply law_from_moments two
  intro χ
  have h0 : sign χ 0 = 1 := by simp [sign]
  rw [moment_from_inputs two, moment_from_inputs two, h0, one_mul, one_mul]
  let f (a : B) : ℝ := if sign χ a = -1 then r a else 1
  have hsub : (∏ x : {a : B // a ≠ 0 ∧ r a < 1}, f x.val) =
      ∏ a with a ≠ 0 ∧ r a < 1, f a := by
    symm
    exact Finset.prod_subtype _ (by simp) _
  change (∏ x : {a : B // a ≠ 0 ∧ r a < 1}, f x.val) = ∏ a, f a
  rw [hsub, Finset.prod_filter]
  apply Finset.prod_congr rfl
  unfold f
  intro a _
  by_cases ha : a = 0
  · subst a
    norm_num [h0]
  by_cases hlt : r a < 1
  · simp [ha, hlt]
  · have heq := le_antisymm (hr a) (le_of_not_gt hlt)
    simp [ha, heq]

private theorem minimum_input_count_attained [Module (ZMod 2) A]
    (two : ∀ a : A, a + a = 0) (μ : A → ℝ) (hnorm : ∑ a, μ a = 1)
    (H : AddSubgroup A) (s' : A) (hh : quotientCriterion H s' μ) :
    ∃ (J : Type u) (_ : Fintype J) (d : J → A) (t : A) (r : J → ℝ),
      (∀ j, |r j| ≤ 1) ∧ law d t r = μ ∧
      Fintype.card J = minimumInputCount μ := by
  classical
  have hH : H = spectralAnnihilator μ := criterion_subgroup_eq_annihilator two μ H s' hh
  let Q := A ⧸ H
  let π := QuotientAddGroup.mk' H
  let _ : Fintype Q := Fintype.ofFinite _
  let _ : Fintype (AddChar Q ℂ) := Fintype.ofFinite _
  obtain ⟨hVanish, hPos, hTest⟩ := hh
  have hm : ∑ a, shiftedQuotient H s' μ a = 1 :=
    (sum_shiftedQuotient H s' μ).trans hnorm
  obtain ⟨r, hr, hLaw⟩ := (positive_moment_realizability.{u,u} (quotient_two H two)
    (shiftedQuotient H s' μ) hm hPos).2 hTest
  have hrec (u : Q) (hu : u ≠ 0) : r u = visibleBias H μ u := by
    have hey := loginvert (quotient_two H two) id 0 r (fun a => (hr a).1) u hu
    rw [singleton_group_bias] at hey
    rw [hLaw] at hey
    have hAbs (φ : AddChar Q ℂ) :
        |moment (shiftedQuotient H s' μ) φ| =
          |moment μ (φ.compAddMonoidHom π)| := by
      rw [moment_shiftedQuotient two, abs_mul]
      rcases value_cases two (φ.compAddMonoidHom π) s' with h | h <;> norm_num [sign, h, π]
    simp_rw [hAbs] at hey
    unfold visibleBias
    change r u = Real.exp _
    rw [← hey, Real.exp_log (hr u).1]
  let K := {a : Q // a ≠ 0 ∧ r a < 1}
  let _ : Fintype K := Fintype.ofFinite _
  have hActive : K = activeClasses H μ := by
    dsimp only [K, activeClasses]
    congr 1
    funext a
    by_cases ha : a = 0
    · simp [ha]
    · rw [hrec a ha]
  let V := AddSubgroup.toZModSubmodule 2 H
  let n := Module.finrank (ZMod 2) V
  have : Module.Finite (ZMod 2) V := Module.Finite.of_finite
  let b : Module.Basis (Fin n) (ZMod 2) V := Module.finBasis (ZMod 2) V
  let d (j : Fin n) : H := ⟨b j, (b j).property⟩
  obtain ⟨k, t, hBounds, hIn, hOut⟩ :=
    lift_from_fair_columns two H d (fair_basis_reads_subgroup H b)
      (fun u : K => u.val) s' (fun u => r u.val)
  refine ⟨Fin n ⊕ K, inferInstance, k, s', t, ?_, ?_, ?_⟩
  · intro j
    apply (hBounds j).mpr
    cases j with
    | inl _ => trivial
    | inr i =>
      change |r i.val| ≤ 1
      rw [abs_of_pos (hr i.val).1]
      exact (hr i.val).2
  · apply law_from_moments two
    intro χ
    by_cases hc : ∀ a ∈ H, χ a = 1
    · obtain ⟨φ, rfl⟩ := trivial_character_descends H χ hc
      rw [hIn, law_prune_columns (quotient_two H two) r (fun a => (hr a).2), hLaw,
        moment_shiftedQuotient two, ← mul_assoc, sign_sq_eq_one two, one_mul]
    · obtain ⟨a, ha⟩ := not_forall.mp hc
      obtain ⟨haH, haχ⟩ := Classical.not_imp.mp ha
      have hbad : ∃ a ∈ H, χ a ≠ 1 := ⟨a, haH, haχ⟩
      rw [hOut _ hbad, hVanish _ hbad]
  · unfold minimumInputCount
    rw [← hH, Fintype.card_sum, Fintype.card_fin]
    change n + Fintype.card K = n + Nat.card (activeClasses H μ)
    have hCard : Nat.card K = Nat.card (activeClasses H μ) := congrArg (fun W : Type u => Nat.card W) hActive
    rw [← hCard, Nat.card_eq_fintype_card]

/-- For a normalized affine parity law, the fair dimension and the recovered quotient biases
give a lower bound on every representation and a representation attaining that bound. -/
theorem minimum_input_count_exact [Module (ZMod 2) A]
    (μ : A → ℝ) (hnorm : ∑ a, μ a = 1) (hreal : ∃ H : AddSubgroup A, ∃ s : A,
      quotientCriterion H s μ) :
    (∀ {J : Type v} [Fintype J] (d : J → A) (t : A) (r : J → ℝ),
      law d t r = μ → minimumInputCount μ ≤ Fintype.card J) ∧
    (∃ (J : Type u) (_ : Fintype J) (d : J → A) (t : A) (r : J → ℝ),
      (∀ j, |r j| ≤ 1) ∧ law d t r = μ ∧ Fintype.card J = minimumInputCount μ) := by
  have two (x : A) : x + x = 0 := by
    calc
      x + x = ((1 : ZMod 2) + 1) • x := by rw [add_smul, one_smul]
      _ = 0 := by rw [show (1 : ZMod 2) + 1 = 0 by decide, zero_smul]
  constructor
  · intro J _ d t r h
    rw [← h]
    exact minimum_input_count_le two d t r
  · obtain ⟨H, s, h⟩ := hreal
    exact minimum_input_count_attained two μ hnorm H s h

end D5.S3.TotalVariation.MinimumParityInputs
