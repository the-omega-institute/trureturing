/-- Absolute-difference summability transfers to the squared square-root gaps. -/
theorem summable_sq_sqrt_sub_sqrt_of_summable_abs_sub
    {ι : Type*} (p q : ι → ℝ)
    (h : Summable (fun i => |p i - q i|)) :
    Summable (fun i => (Real.sqrt (p i) - Real.sqrt (q i)) ^ 2) :=
  Summable.of_nonneg_of_le
    (fun i => sq_nonneg (Real.sqrt (p i) - Real.sqrt (q i)))
    (fun i => sq_sqrt_sub_sqrt_le_abs_sub (p i) (q i)) h

/-- The countable squared Hellinger series is bounded by the absolute-difference series. -/
theorem tsum_sq_sqrt_sub_sqrt_le_tsum_abs_sub
    {ι : Type*} (p q : ι → ℝ)
    (h : Summable (fun i => |p i - q i|)) :
    (∑' i, (Real.sqrt (p i) - Real.sqrt (q i)) ^ 2) ≤
      ∑' i, |p i - q i| :=
  (summable_sq_sqrt_sub_sqrt_of_summable_abs_sub p q h).tsum_le_tsum
    (fun i => sq_sqrt_sub_sqrt_le_abs_sub (p i) (q i)) h

/-- The converse transfer fails on `ℕ`: the root gaps form a shifted `p`-series,
while the absolute differences are bounded below by two. -/
theorem summable_sq_sqrt_sub_sqrt_not_summable_abs_sub_witness :
    ∃ p q : ℕ → ℝ,
      Summable (fun i => (Real.sqrt (p i) - Real.sqrt (q i)) ^ 2) ∧
        ¬Summable (fun i => |p i - q i|) := by
  let q : ℕ → ℝ := fun n => ((n : ℝ) + 1) ^ 2
  let p : ℕ → ℝ := fun n => ((n : ℝ) + 1 + 1 / ((n : ℝ) + 1)) ^ 2
  refine ⟨p, q, ?_, ?_⟩
  · have hseries : Summable (fun n : ℕ => ((((n : ℝ) + 1) ^ 2)⁻¹)) := by
      have hbase : Summable (fun n : ℕ => (((n : ℝ) ^ 2)⁻¹)) :=
        Real.summable_nat_pow_inv.mpr (by norm_num)
      simpa [Nat.cast_add, Nat.cast_one] using
        (summable_nat_add_iff (f := fun n : ℕ => (((n : ℝ) ^ 2)⁻¹)) 1).2 hbase
    refine hseries.congr (fun n => ?_)
    have hx : 0 < (n : ℝ) + 1 := by positivity
    dsimp [p, q]
    rw [Real.sqrt_sq (by positivity), Real.sqrt_sq hx.le]
    field_simp [hx.ne']
    ring
  · intro habs
    have hge : ∀ n : ℕ, (2 : ℝ) ≤ |p n - q n| := by
      intro n
      have hx : 0 < (n : ℝ) + 1 := by positivity
      have hcalc :
          p n - q n = 2 + 1 / ((n : ℝ) + 1) ^ 2 := by
        dsimp [p, q]
        field_simp [hx.ne']
        ring
      rw [hcalc, abs_of_nonneg (by positivity)]
      have hsquare : 0 ≤ 1 / ((n : ℝ) + 1) ^ 2 := by positivity
      linarith
    have hconst : Summable (fun _ : ℕ => (2 : ℝ)) :=
      Summable.of_nonneg_of_le (fun _ => by norm_num) hge habs
    have hzero := hconst.tendsto_atTop_zero
    have htwo : Filter.Tendsto (fun _ : ℕ => (2 : ℝ)) Filter.atTop (nhds 2) :=
      tendsto_const_nhds
    have : (0 : ℝ) = 2 := tendsto_nhds_unique hzero htwo
    norm_num at this

end D5.S3.TotalVariation.Countable.HellingerCountableComparison
