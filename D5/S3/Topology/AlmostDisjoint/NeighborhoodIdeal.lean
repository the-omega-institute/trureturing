/-- The ideal generated by a family and all finite sets. -/
def InFiniteUnionIdeal {α ι : Type*} (M : ι → Set α) (E : Set α) : Prop :=
  ∃ F : Finset ι, ∃ K : Set α, K.Finite ∧ E ⊆ (⋃ i ∈ F, M i) ∪ K

private theorem ideal_mono {α ι : Type*} {M : ι → Set α} {E E' : Set α}
    (hE : InFiniteUnionIdeal M E) (hsub : E' ⊆ E) : InFiniteUnionIdeal M E' := by
  obtain ⟨F, K, hK, h⟩ := hE
  exact ⟨F, K, hK, hsub.trans h⟩

private theorem ideal_union {α ι : Type*} {M : ι → Set α} {E E' : Set α}
    (hE : InFiniteUnionIdeal M E) (hE' : InFiniteUnionIdeal M E') :
    InFiniteUnionIdeal M (E ∪ E') := by
  classical
  obtain ⟨F, K, hK, h⟩ := hE
  obtain ⟨F', K', hK', h'⟩ := hE'
  refine ⟨F ∪ F', K ∪ K', hK.union hK', ?_⟩
  intro a ha
  rcases ha with ha | ha
  · rcases h ha with hF | hK
    · left
      obtain ⟨i, hi⟩ := mem_iUnion.mp hF
      obtain ⟨hiF, hai⟩ := mem_iUnion.mp hi
      exact mem_iUnion.mpr ⟨i, mem_iUnion.mpr ⟨Finset.mem_union_left _ hiF, hai⟩⟩
    · exact Or.inr (Or.inl hK)
  · rcases h' ha with hF | hK
    · left
      obtain ⟨i, hi⟩ := mem_iUnion.mp hF
      obtain ⟨hiF, hai⟩ := mem_iUnion.mp hi
      exact mem_iUnion.mpr ⟨i, mem_iUnion.mpr ⟨Finset.mem_union_right _ hiF, hai⟩⟩
    · exact Or.inr (Or.inr hK)

/-- A value belongs to the color support if every neighborhood has a colored
preimage escaping the family ideal. -/
def ColorSupport {α ι Y : Type*} [TopologicalSpace Y]
    (M : ι → Set α) (u : α → Y) (D : Set α) : Set Y :=
  {r | ∀ V ∈ 𝓝 r, ¬ InFiniteUnionIdeal M (u ⁻¹' V ∩ D)}

private theorem colorSupport_closed {α ι Y : Type*} [TopologicalSpace Y]
    (M : ι → Set α) (u : α → Y) (D : Set α) : IsClosed (ColorSupport M u D) := by
  classical
  apply isOpen_compl_iff.mp
  apply isOpen_iff_mem_nhds.mpr
  intro r hr
  obtain ⟨V, hV, hsmall⟩ : ∃ V ∈ 𝓝 r, InFiniteUnionIdeal M (u ⁻¹' V ∩ D) := by
    simpa only [ColorSupport, mem_compl_iff, mem_ofPred_eq, not_forall,
      not_not, exists_prop] using hr
  obtain ⟨U, hUV, hU, hrU⟩ := mem_nhds_iff.mp hV
  apply Filter.mem_of_superset (hU.mem_nhds hrU)
  intro s hs hsupport
  exact hsupport U (hU.mem_nhds hs) (ideal_mono hsmall (by
    rintro a ⟨ha, haD⟩
    exact ⟨hUV ha, haD⟩))

private theorem colorSupport_cover {α ι Y : Type*} [TopologicalSpace Y]
    (M : ι → Set α) (u : α → Y)
    (hlarge : ∀ r V, V ∈ 𝓝 r → ¬ InFiniteUnionIdeal M (u ⁻¹' V)) (D : Set α) :
    ColorSupport M u D ∪ ColorSupport M u Dᶜ = univ := by
  classical
  apply eq_univ_of_forall
  intro r
  by_contra hr
  have h0 : r ∉ ColorSupport M u D := fun h => hr (Or.inl h)
  have h1 : r ∉ ColorSupport M u Dᶜ := fun h => hr (Or.inr h)
  obtain ⟨V0, hV0, hsmall0⟩ : ∃ V ∈ 𝓝 r, InFiniteUnionIdeal M (u ⁻¹' V ∩ D) := by
    simpa only [ColorSupport, mem_ofPred_eq, not_forall, not_not, exists_prop] using h0
  obtain ⟨V1, hV1, hsmall1⟩ : ∃ V ∈ 𝓝 r, InFiniteUnionIdeal M (u ⁻¹' V ∩ Dᶜ) := by
    simpa only [ColorSupport, mem_ofPred_eq, not_forall, not_not, exists_prop] using h1
  apply hlarge r (V0 ∩ V1) (inter_mem hV0 hV1)
  apply ideal_mono (ideal_union hsmall0 hsmall1)
  intro a ha
  by_cases haD : a ∈ D
  · exact Or.inl ⟨ha.1, haD⟩
  · exact Or.inr ⟨ha.2, haD⟩

/-- In a connected value space, opposite endpoint exclusions force a common
color support. No partitioner or descriptive-set hypothesis is used here. -/
private theorem common_color_support {α ι Y : Type*}
    [TopologicalSpace Y] [PreconnectedSpace Y]
    (M : ι → Set α) (u : α → Y)
    (hlarge : ∀ r V, V ∈ 𝓝 r → ¬ InFiniteUnionIdeal M (u ⁻¹' V))
    (D : Set α) (a b : Y)
    (ha : a ∉ ColorSupport M u Dᶜ) (hb : b ∉ ColorSupport M u D) :
    (ColorSupport M u D ∩ ColorSupport M u Dᶜ).Nonempty := by
  have hcover := colorSupport_cover M u hlarge D
  have ha0 : a ∈ ColorSupport M u D := by
    have h : a ∈ ColorSupport M u D ∪ ColorSupport M u Dᶜ := by rw [hcover]; trivial
    exact h.resolve_right ha
  have hb1 : b ∈ ColorSupport M u Dᶜ := by
    have h : b ∈ ColorSupport M u D ∪ ColorSupport M u Dᶜ := by rw [hcover]; trivial
    exact h.resolve_left hb
  have h := isPreconnected_closed_iff.mp (isPreconnected_univ : IsPreconnected (univ : Set Y))
    (ColorSupport M u D) (ColorSupport M u Dᶜ)
    (colorSupport_closed M u D) (colorSupport_closed M u Dᶜ)
    (by rw [hcover]) ⟨a, mem_univ a, ha0⟩ ⟨b, mem_univ b, hb1⟩
  simpa only [univ_inter] using h

/-- For the exact separating thresholds, the common support point lies in the
unit interval. This statement concerns ideal supports, before the later
maximality diagonal and continuum color-fiber argument. -/
theorem threshold_common_color_support (M : Branch → Set ℕ)
    (hlarge : ∀ r V, V ∈ 𝓝 r → ¬ InFiniteUnionIdeal M (natValue ⁻¹' V))
    (D : Set ℕ)
    (hlower : {n | (natValue n : ℝ) ≤ (1 : ℝ) / 3} ⊆ D)
    (hupper : D ⊆ {n | (natValue n : ℝ) < (2 : ℝ) / 3}) :
    (ColorSupport M natValue D ∩ ColorSupport M natValue Dᶜ).Nonempty := by
  apply common_color_support M natValue hlarge D (0 : unitInterval) (1 : unitInterval)
  · intro hs
    let V : Set unitInterval := {t | (t : ℝ) < (1 : ℝ) / 3}
    have hV : V ∈ 𝓝 (0 : unitInterval) := by
      apply (isOpen_lt continuous_subtype_val continuous_const).mem_nhds
      norm_num [V]
    apply hs V hV
    refine ⟨∅, ∅, finite_empty, ?_⟩
    rintro n ⟨hnV, hnD⟩
    change (natValue n : ℝ) < (1 : ℝ) / 3 at hnV
    exact (hnD (hlower (show (natValue n : ℝ) ≤ (1 : ℝ) / 3 from hnV.le))).elim
  · intro hs
    let V : Set unitInterval := {t | (2 : ℝ) / 3 < (t : ℝ)}
    have hV : V ∈ 𝓝 (1 : unitInterval) := by
      apply (isOpen_lt continuous_const continuous_subtype_val).mem_nhds
      norm_num [V]
    apply hs V hV
    refine ⟨∅, ∅, finite_empty, ?_⟩
    rintro n ⟨hnV, hnD⟩
    change (2 : ℝ) / 3 < (natValue n : ℝ) at hnV
    have hnupper : (natValue n : ℝ) < (2 : ℝ) / 3 := hupper hnD
    exact (not_lt_of_gt hnV hnupper).elim

private theorem not_in_ideal_of_infinite_limit_fiber {α ι Y : Type*}
    [TopologicalSpace Y] (M : ι → Set α) (u : α → Y) (l : ι → Y)
    (hinf : ∀ i, (M i).Infinite)
    (had : ∀ i j, i ≠ j → (M i ∩ M j).Finite)
    (hc : ∀ i, ConvergesOn u (M i) (l i))
    (r : Y) (hfiber : {i | l i = r}.Infinite) (V : Set Y) (hV : V ∈ 𝓝 r) :
    ¬ InFiniteUnionIdeal M (u ⁻¹' V) := by
  classical
  rintro ⟨F, K, hK, hcover⟩
  obtain ⟨i, hi, hiF⟩ : ∃ i, l i = r ∧ i ∉ F := by
    by_contra h
    apply hfiber
    apply F.finite_toSet.subset
    intro i hi
    by_contra hiF
    exact h ⟨i, hi, hiF⟩
  have hlocal : (M i ∩ u ⁻¹' V).Infinite :=
    (hinf i).inter_of_finite_sdiff (hc i V (by simpa only [hi] using hV))
  have hbound : (⋃ j ∈ F, M i ∩ M j).Finite :=
    F.finite_toSet.biUnion (fun j hj => had i j (fun hij => hiF (hij ▸ hj)))
  apply hlocal
  apply (hbound.union hK).subset
  rintro a ⟨hai, haV⟩
  rcases hcover haV with hF | hKa
  · left
    obtain ⟨j, hj⟩ := mem_iUnion.mp hF
    obtain ⟨hjF, haj⟩ := mem_iUnion.mp hj
    exact mem_iUnion.mpr ⟨j, mem_iUnion.mpr ⟨hjF, hai, haj⟩⟩
  · exact Or.inr hKa

/-- The actual convergent branch-labeled family has no value neighborhood in
its finite-union-plus-finite ideal. The full maximal family and the branch
containments are retained in the conclusion. -/
theorem exists_mad_with_no_small_neighborhood :
    ∃ M : Branch → Set ℕ,
      (∀ x, natBranch x ⊆ M x) ∧
      (∀ x y, x ≠ y → (M x ∩ M y).Finite) ∧ MADFamily (range M) ∧
      (∀ x, ConvergesOn natValue (M x) (limitValue x)) ∧
      ∀ (r : unitInterval) (V : Set unitInterval), V ∈ 𝓝 r →
        ¬ InFiniteUnionIdeal M (natValue ⁻¹' V) := by
  obtain ⟨M, hbranch, had, hmad, hc⟩ := exists_branch_labeled_mad
  refine ⟨M, hbranch, had, hmad, hc, ?_⟩
  intro r V hV
  have hcard := (branch_system 0).2.2.2.2.2.2 r
  have hfiber : {x : Branch | limitValue x = r}.Infinite := by
    apply Set.infinite_coe_iff.mp
    apply Cardinal.aleph0_le_mk_iff.mp
    change Cardinal.aleph0 ≤ Cardinal.mk {x : Branch // limitValue x = r}
    rw [hcard]
    exact Cardinal.aleph0_le_continuum
  exact not_in_ideal_of_infinite_limit_fiber M natValue limitValue
    (fun x => hmad.1.1 (M x) (mem_range_self x)) had hc r hfiber V hV

