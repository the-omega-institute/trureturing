private theorem check17_11 : contraction17.check cached17 11 = true := by
  apply Contraction.check_of_blocks _ _ _ 6 (by decide) (by decide) (by decide)
  intro b hb
  interval_cases b
  · exact check17_11_block0
  · exact check17_11_block1
  · exact check17_11_block2
  · exact check17_11_block3
  · exact check17_11_block4
  · exact check17_11_block5
private theorem basis17_12 : replayStageBasis 17 12 = b17 12 := by decide +kernel
private theorem matrix17_12 :
    calculateMatrix replayResolution (b17 12) (b17 (12 + 1)) =
      cached17.matrix 12 := rfl
private theorem check17_12 : contraction17.check cached17 12 = true := by decide +kernel
private theorem allBasis17 (t : Nat) : replayStageBasis 17 t = b17 t := by
  by_cases ht : t < 13
  · interval_cases t
    · exact basis17_0
    · exact basis17_1
    · exact basis17_2
    · exact basis17_3
    · exact basis17_4
    · exact basis17_5
    · exact basis17_6
    · exact basis17_7
    · exact basis17_8
    · exact basis17_9
    · exact basis17_10
    · exact basis17_11
    · exact basis17_12
  · have ht' : 13 ≤ t := by omega
    cases t with
    | zero => omega
    | succ k =>
      have hk : ¬ k < crossings + 1 := by norm_num [crossings, braid]; omega
      simp only [replayStageBasis, ite_eq_right hk]
      simp [b17, show ¬k + 1 < 13 by omega]
private theorem allMatrix17 (t : Nat) : calculateMatrix replayResolution (b17 t) (b17 (t + 1)) = cached17.matrix t := by
  by_cases ht : t < 13
  · interval_cases t
    · exact matrix17_0
    · exact matrix17_1
    · exact matrix17_2
    · exact matrix17_3
    · exact matrix17_4
    · exact matrix17_5
    · exact matrix17_6
    · exact matrix17_7
    · exact matrix17_8
    · exact matrix17_9
    · exact matrix17_10
    · exact matrix17_11
    · exact matrix17_12
  · have h₀ : b17 t = #[] := by simp [b17, ht]
    have h₁ : d17 t = #[] := by simp [d17, ht]
    simp [cached17, calculateMatrix, h₀, h₁]
private theorem allChecks17 (t : Nat) : contraction17.check cached17 t = true := by
  by_cases ht : t < 13
  · interval_cases t
    · exact check17_0
    · exact check17_1
    · exact check17_2
    · exact check17_3
    · exact check17_4
    · exact check17_5
    · exact check17_6
    · exact check17_7
    · exact check17_8
    · exact check17_9
    · exact check17_10
    · exact check17_11
    · exact check17_12
  · have h₀ : (cached17.basis t).size = 0 := by simp [cached17, b17, ht]
    have h₁ : (cached17.basis (t + 1)).size = 0 := by
      simp [cached17, b17, show ¬ t + 1 < 13 by omega]
    have h₂ : contraction17.rank t = 0 := by
      simp [contraction17, rank17, show t ≠ 7 by omega, show t ≠ 8 by omega]
    exact Contraction.check_empty _ _ _ h₀ h₁ h₂
private theorem cached17_eq : cached17 = integralRow 17 := by
  have hb : replayStageBasis 17 = b17 := funext allBasis17
  have hs := replayStageBasis_eq 17 (by decide)
  have hm : (fun t => (cached17).matrix t) = stageMatrix 17 := by
    funext t
    rw [stageMatrix_eq_replay 17 t (by decide), hb]
    exact (allMatrix17 t).symm
  exact congrArg₂ IntegralRow.mk (hb.symm.trans hs) hm

theorem quantum17_integral : (integralRow 17).Computes
    (fun k => if k = 7 then 2 else if k = 8 then 1 else 0) := by
  rw [← cached17_eq]
  exact contraction17.sound _ (fun _ => rfl) allChecks17


