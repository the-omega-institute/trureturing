/- GID: D5/S3/Topology/FourBraidKhovanovResolutionData
   generality: I
   mirror-B: D5/B/S3/Topology/FourBraidKhovanovResolutionData
   mirror-E: none(waiver:algebraically-proved)
   anchors: [lake/module/Mathlib.Logic.Relation]
   utility: none
   digest: Kernel evaluation of the resolution partitions and quantum gradings. -/

import D5.S3.Topology.FourBraidKhovanovCube

/-!
Partitions are evaluated in blocks to share the geometric work between rows.
Geometry below quantum degree seventeen is needed only for the grading bound.
-/

set_option autoImplicit false

namespace D5.S3.Topology.FourBraidKhovanovCube

abbrev ResolutionEntry := Nat × Partition

def resolutionEntry (s : Nat) : ResolutionEntry :=
  let roots := resolve s
  let q := upperQuantum s roots
  (q, if q ≥ 17 then roots else [])

def calculateBlock (b : Nat) : Array ResolutionEntry :=
  ((List.range' (32 * b) 32).map resolutionEntry).toArray

set_option maxRecDepth 8192
set_option linter.style.setOption false
set_option maxHeartbeats 2000000
set_option linter.style.longLine false

