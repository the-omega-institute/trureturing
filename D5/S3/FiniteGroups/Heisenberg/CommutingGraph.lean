import D5.S3.FiniteGroups.Heisenberg.Basic
import Mathlib.Combinatorics.SimpleGraph.Maps

/-! # Full commuting graphs and source isoclinism -/

namespace D5.S3.FiniteGroups.Heisenberg

open scoped commutatorElement

variable {G H : Type*} [Group G] [Group H]

/-- The source convention for the group commutator. -/
def sourceCommutator (x y : G) : G := x⁻¹ * y⁻¹ * x * y

private theorem sourceCommutator_native (x y : G) :
    sourceCommutator x y = ⁅x⁻¹, y⁻¹⁆ := by
  simp [sourceCommutator, commutatorElement_def]

/-- The subgroup generated by the source commutators. -/
def sourceDerived (G : Type*) [Group G] : Subgroup G :=
  Subgroup.closure {z | ∃ x y : G, sourceCommutator x y = z}

/-- Inversion reparameterizes the generating set, identifying the two conventions. -/
private theorem sourceDerived_native (G : Type*) [Group G] :
    sourceDerived G = commutator G := by
  rw [sourceDerived, commutator_eq_closure]
  congr 1
  ext z
  constructor
  · rintro ⟨x, y, rfl⟩
    exact ⟨x⁻¹, y⁻¹, sourceCommutator_native x y |>.symm⟩
  · rintro ⟨x, y, rfl⟩
    exact ⟨x⁻¹, y⁻¹, by simp [sourceCommutator_native]⟩

private theorem sourceCommutator_mem (x y : G) : sourceCommutator x y ∈ sourceDerived G :=
  Subgroup.subset_closure ⟨x, y, rfl⟩

/-- Compatible isomorphisms on the central quotients and source derived subgroups. -/
def Isoclinic (G H : Type*) [Group G] [Group H] : Prop :=
  ∃ (a : (G ⧸ Subgroup.center G) ≃* (H ⧸ Subgroup.center H))
    (b : sourceDerived G ≃* sourceDerived H),
    ∀ (x y : G) (u v : H),
      a (QuotientGroup.mk x) = QuotientGroup.mk u →
      a (QuotientGroup.mk y) = QuotientGroup.mk v →
      (b ⟨sourceCommutator x y, sourceCommutator_mem x y⟩ : H) = sourceCommutator u v

/-- Vertices are all elements, including identity and centre. -/
def commutingGraph (G : Type*) [Group G] : SimpleGraph G where
  Adj x y := x ≠ y ∧ x * y = y * x
  symm := ⟨by rintro x y ⟨hne, h⟩; exact ⟨hne.symm, h.symm⟩⟩
  loopless := ⟨by intro x h; exact h.1 rfl⟩

variable {A B : Type*} [CommRing A] [CommRing B]

private theorem heisenberg_commutes (a b : HeisenbergGroup A) :
    a * b = b * a ↔ a.x * b.y = b.x * a.y := by
  constructor
  · intro h
    have hz := congrArg HeisenbergGroup.z h
    change a.z + b.z + a.x * b.y = b.z + a.z + b.x * a.y at hz
    simpa only [add_comm b.z a.z, add_right_inj] using hz
  · intro h
    ext
    · change a.x + b.x = b.x + a.x
      exact add_comm _ _
    · change a.y + b.y = b.y + a.y
      exact add_comm _ _
    · change a.z + b.z + a.x * b.y = b.z + a.z + b.x * a.y
      rw [h, add_comm a.z b.z]

private def baseCentral (A : Type*) : HeisenbergGroup A ≃ (A × A) × A where
  toFun a := ((a.x, a.y), a.z)
  invFun a := ⟨a.1.1, a.1.2, a.2⟩

noncomputable def liftEquiv (e : (A × A) ≃ (B × B)) (f : A ≃ B) :
    HeisenbergGroup A ≃ HeisenbergGroup B :=
  (baseCentral A).trans ((Equiv.prodCongr e f).trans (baseCentral B).symm)

/-- A determinant-incidence bijection, together with a central-coordinate bijection,
preserves adjacency on whole triples. -/
noncomputable def liftGraphIso (e : (A × A) ≃ (B × B)) (f : A ≃ B)
    (he : ∀ v w : A × A, v.1 * w.2 = w.1 * v.2 ↔
      (e v).1 * (e w).2 = (e w).1 * (e v).2) :
    commutingGraph (HeisenbergGroup A) ≃g commutingGraph (HeisenbergGroup B) :=
  RelIso.mk (liftEquiv e f) (by
    intro x y
    change (liftEquiv e f x ≠ liftEquiv e f y ∧ _) ↔ (x ≠ y ∧ _)
    rw [(liftEquiv e f).injective.ne_iff, heisenberg_commutes, heisenberg_commutes]
    exact and_congr_right fun _ => (he (x.x, x.y) (y.x, y.y)).symm)

variable (A) in
theorem sourceDerived_axis : sourceDerived (HeisenbergGroup A) = HeisenbergGroup.zAxis := by
  rw [sourceDerived_native, HeisenbergGroup.commutator_eq_zAxis]

end D5.S3.FiniteGroups.Heisenberg
