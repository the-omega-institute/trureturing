import D5.S3.FiniteGroups.GroupAlgebra.PGroupAugmentation
import D5.S3.FiniteGroups.FiniteCharacterAlgebra
import Mathlib.Data.Nat.Find
import Mathlib.RepresentationTheory.Invariants
import Mathlib.RepresentationTheory.Irreducible

/-!
The least ideal power annihilating a supplied nonzero vector produces a
nonzero vector killed by the ideal. Applied to the actual augmentation kernel,
the existing cardinal nilpotence bound gives a fixed vector. Normality makes
the subgroup invariants an ambient subrepresentation, so irreducibility makes
the whole representation fixed under the subgroup.

These are structural arguments, not finite computations, bounded enumeration,
checkers or numerical reductions; hence every declaration has utility none.
The nilpotent-action mechanism is classical. The existing Library note
webb2016pgroups supports the reused augmentation-nilpotence input; it is not
claimed to state each full telescope below verbatim. No novelty is claimed.
-/

set_option autoImplicit false

namespace D5.S3.FiniteGroups.GroupAlgebra.PGroupInvariants

universe uA uM uR uP uV uG

/-- A nilpotent two-sided ideal kills a nonzero vector in any module containing
a supplied nonzero vector. Minimality produces the new vector in the cyclic
submodule generated by that input; the whole module need not be cyclic. -/
theorem exists_nonzero_killed_by_ideal
    {A : Type uA} {M : Type uM} [Semiring A] [AddCommMonoid M] [Module A M]
    (I : Ideal A) [I.IsTwoSided] (hnil : ∃ n : ℕ, I ^ n = ⊥)
    (x : M) (hx : x ≠ 0) :
    ∃ y : M, y ≠ 0 ∧ ∀ a : A, a ∈ I → a • y = 0 := by
  classical
  obtain ⟨N, hN⟩ := hnil
  let kills : ℕ → Prop := fun n => ∀ a : A, a ∈ I ^ n → a • x = 0
  have hex : ∃ n : ℕ, kills n := by
    refine ⟨N, ?_⟩
    intro a ha
    have ha0 : a = 0 := by simpa only [hN, Submodule.mem_bot] using ha
    simp only [ha0, zero_smul]
  have hleast : ∀ a : A, a ∈ I ^ Nat.find hex → a • x = 0 := Nat.find_spec hex
  have hn0 : Nat.find hex ≠ 0 := by
    intro h0
    have hone : (1 : A) ∈ I ^ Nat.find hex := by
      rw [h0, Submodule.pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top
    exact hx (by simpa only [one_smul] using hleast 1 hone)
  obtain ⟨m, hm⟩ := Nat.exists_eq_succ_of_ne_zero hn0
  have hprev : ¬ kills m := Nat.find_min hex (by rw [hm]; exact Nat.lt_succ_self m)
  change ¬ ∀ a : A, a ∈ I ^ m → a • x = 0 at hprev
  push Not at hprev
  obtain ⟨a, ha, hax⟩ := hprev
  refine ⟨a • x, hax, ?_⟩
  intro b hb
  have hba : b * a ∈ I ^ Nat.find hex := by
    rw [hm, Ideal.IsTwoSided.pow_succ]
    exact Ideal.mul_mem_mul hb ha
  rw [← mul_smul]
  exact hleast (b * a) hba

/-- A representation of a finite p-group over any commutative ring of
characteristic p has a nonzero invariant whenever a nonzero vector is supplied.
Neither the ring nor the module is assumed finite, and no dimension is fixed. -/
theorem exists_nonzero_mem_invariants_of_isPGroup
    {R : Type uR} {P : Type uP} {V : Type uV}
    [CommRing R] [Group P] [Finite P] [AddCommGroup V] [Module R V]
    (p : ℕ) [Fact p.Prime] [CharP R p]
    (hP : IsPGroup p P) (σ : Representation R P V) (x : V) (hx : x ≠ 0) :
    ∃ y : V, y ≠ 0 ∧ y ∈ σ.invariants := by
  classical
  let I : Ideal (MonoidAlgebra R P) :=
    RingHom.ker (MonoidAlgebra.lift R R P (1 : P →* R)).toRingHom
  have : I.IsTwoSided := by dsimp [I]; infer_instance
  have hnil : ∃ n : ℕ, I ^ n = ⊥ := by
    refine ⟨Nat.card P, ?_⟩
    exact PGroupAugmentation.augmentation_ideal_pow_card (R := R) p hP
  have hx' : σ.asModuleEquiv.symm x ≠ 0 := by
    intro h
    apply hx
    simpa only [LinearEquiv.apply_symm_apply, map_zero] using congrArg σ.asModuleEquiv h
  obtain ⟨y, hy, hIy⟩ :=
    exists_nonzero_killed_by_ideal I hnil (σ.asModuleEquiv.symm x) hx'
  refine ⟨σ.asModuleEquiv y, ?_, ?_⟩
  · intro h
    apply hy
    apply σ.asModuleEquiv.injective
    simpa only [map_zero] using h
  · apply (Representation.mem_invariants σ (σ.asModuleEquiv y)).mpr
    intro g
    have hmem : MonoidAlgebra.of R P g - 1 ∈ I := by
      change MonoidAlgebra.lift R R P (1 : P →* R) (MonoidAlgebra.of R P g - 1) = 0
      simp only [map_sub, map_one, MonoidAlgebra.lift_of, MonoidHom.one_apply, sub_self]
    have haction :
        σ.asModuleEquiv ((MonoidAlgebra.of R P g - 1) • y) =
          σ g (σ.asModuleEquiv y) - σ.asModuleEquiv y := by
      rw [Representation.asModuleEquiv_map_smul, map_sub,
        Representation.asAlgebraHom_of, map_one, LinearMap.sub_apply, Module.End.one_apply]
    have hzero : σ g (σ.asModuleEquiv y) - σ.asModuleEquiv y = 0 := by
      calc
        _ = σ.asModuleEquiv ((MonoidAlgebra.of R P g - 1) • y) := haction.symm
        _ = 0 := by rw [hIy _ hmem, map_zero]
    exact sub_eq_zero.mp hzero

/-- A finite normal p-subgroup acts trivially in any irreducible representation
over a field of characteristic p. The ambient group and module are arbitrary,
and the coefficient field, ambient group and module have independent universes. -/
theorem isTrivial_restrict_normal_p_subgroup
    {k : Type uR} {G : Type uG} {V : Type uV}
    [Field k] [Group G] [AddCommGroup V] [Module k V]
    (p : ℕ) [Fact p.Prime] [CharP k p]
    (ρ : Representation k G V) [ρ.IsIrreducible]
    (P : Subgroup G) [P.Normal] [Finite P] (hP : IsPGroup p P) :
    Representation.IsTrivial (ρ.comp P.subtype) := by
  classical
  let : Nontrivial V :=
    D5.S3.FiniteGroups.FiniteCharacterAlgebra.Representation.IsIrreducible.nontrivial
      (ρ := ρ) inferInstance
  obtain ⟨x, hx⟩ := exists_ne (0 : V)
  obtain ⟨y, hy, hyfix⟩ :=
    exists_nonzero_mem_invariants_of_isPGroup p hP (ρ.comp P.subtype) x hx
  let W : Subrepresentation ρ :=
    { toSubmodule := Representation.invariants (ρ.comp P.subtype)
      apply_mem_toSubmodule := by
        intro g v hv
        exact Representation.le_comap_invariants ρ P g hv }
  have hW : W ≠ ⊥ := by
    intro hbot
    have hyW : y ∈ W := hyfix
    rw [hbot] at hyW
    change y ∈ (⊥ : Submodule k V) at hyW
    exact hy (by simpa only [Submodule.mem_bot] using hyW)
  have htop : W = ⊤ := (eq_bot_or_eq_top W).resolve_left hW
  refine ⟨fun g => LinearMap.ext fun v => ?_⟩
  have hvW : v ∈ W := by
    rw [htop]
    change v ∈ (⊤ : Submodule k V)
    exact Submodule.mem_top
  have hvfix : v ∈ Representation.invariants (ρ.comp P.subtype) := hvW
  exact (Representation.mem_invariants (ρ.comp P.subtype) v).mp hvfix g

end D5.S3.FiniteGroups.GroupAlgebra.PGroupInvariants
