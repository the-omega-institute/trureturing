import Mathlib.Algebra.Ring.Aut
import Mathlib.Algebra.BigOperators.Intervals
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Tactic

/-!
Finite additive norms for a ring automorphism. The construction follows the cyclic
norm-one argument of E. Aljadeff and C. Kassel, *Explicit elements of norm one for
cyclic groups*, https://arxiv.org/abs/math/0012038 (Theorem and Lemmas 1--3).
The period-free formulation below uses literal inverse automorphisms and
reflection of a finite interval, rather than
replacing an inverse by a positive power modulo a group order.

Write tau = sigma^q, T = norm tau r and S = norm sigma q. From T(x) = 1 and
r = c*q, set z = c • S(x) - 1 and

  w = sum_{i<r} sum_{j<i} tau^j (x * (tau^i).symm z),
  b = c • x + w - sigma(w),       y = b*x.

The factor x is on the LEFT inside w and on the RIGHT in y. The proof uses only
additive finite sums and multiplication in that order. In particular A may be a
noncommutative ring, including the zero ring. No period, characteristic, scalar
invertibility, finiteness or finite-generation assumption is used.

For the intended cyclic-p application with k >= 2, take q = p, r = p^(k-1),
c = p^(k-2), and let sigma be conjugation by a generator on End_R(M). A norm-one
element for the action of the subgroup generated by sigma^p lifts to one for the
whole cyclic group. Iteration starts with the order-p subgroup. Turning this ring
identity into a module-projectivity detection theorem also needs the usual
relative-projectivity/splitting argument AND projectivity of M over R. The present
declaration proves the ring identity only; it does not assert that full
projectivity theorem.
-/

set_option autoImplicit false

namespace D5.S3.FiniteGroups.GroupAlgebra.CyclicNormOne

open Finset

universe u

variable {A : Type u} [Ring A]

/-- The finite norm is bundled additively so its subtraction and nsmul laws can
be reused without expanding the noncommutative construction. -/
def norm (sigma : A ≃+* A) (n : ℕ) : A →+ A where
  toFun a := ∑ i ∈ range n, (sigma ^ i) a
  map_zero' := by simp
  map_add' a b := by simp [map_add, sum_add_distrib]

private theorem norm_apply (sigma : A ≃+* A) (n : ℕ) (a : A) :
    norm sigma n a = ∑ i ∈ range n, (sigma ^ i) a := rfl

private theorem norm_one (sigma : A ≃+* A) (n : ℕ) :
    norm sigma n 1 = n • (1 : A) := by
  simp only [norm_apply, map_one, sum_const, card_range]

private theorem power_apply_comm (sigma : A ≃+* A) (m n : ℕ) (a : A) :
    (sigma ^ m) ((sigma ^ n) a) = (sigma ^ n) ((sigma ^ m) a) := by
  calc
    (sigma ^ m) ((sigma ^ n) a) = (sigma ^ (m + n)) a := by
      rw [pow_add, RingAut.mul_apply]
    _ = (sigma ^ (n + m)) a := by rw [Nat.add_comm m n]
    _ = (sigma ^ n) ((sigma ^ m) a) := by rw [pow_add, RingAut.mul_apply]

private theorem norm_power_comm (sigma : A ≃+* A) (n m : ℕ) (a : A) :
    norm sigma n ((sigma ^ m) a) = (sigma ^ m) (norm sigma n a) := by
  simp only [norm_apply, map_sum]
  exact sum_congr rfl fun i _ => power_apply_comm sigma i m a

theorem norm_comm (sigma : A ≃+* A) (q r : ℕ) (a : A) :
    norm (sigma ^ q) r (norm sigma q a) =
      norm sigma q (norm (sigma ^ q) r a) := by
  simp only [norm_apply, map_sum, ← pow_mul]
  rw [sum_comm]
  apply sum_congr rfl
  intro j _
  exact sum_congr rfl fun i _ => power_apply_comm sigma (q * j) i a

/-- A finite telescope; neither the automorphism nor a has to be periodic. -/
private theorem norm_shift (sigma : A ≃+* A) (n : ℕ) (a : A) :
    sigma (norm sigma n a) - norm sigma n a = (sigma ^ n) a - a := by
  simp only [norm_apply, map_sum]
  rw [← sum_sub_distrib]
  calc
    (∑ i ∈ range n, (sigma ((sigma ^ i) a) - (sigma ^ i) a)) =
        ∑ i ∈ range n, ((sigma ^ (i + 1)) a - (sigma ^ i) a) := by
      apply sum_congr rfl
      intro i _
      rw [pow_succ', RingAut.mul_apply]
    _ = (sigma ^ n) a - a := by
      simpa only [pow_zero, RingAut.one_apply] using
        (sum_range_sub (fun i : ℕ => (sigma ^ i) a) n)

/-- Reflection is the only inverse-norm step. In particular no identity
tau^r = 1, on all of A or just on a, is being assumed. -/
private theorem inverse_norm_eq (tau : A ≃+* A) (r : ℕ) (hr : 0 < r) (a : A) :
    (∑ i ∈ range r, (tau ^ i).symm a) =
      (tau ^ (r - 1)).symm (norm tau r a) := by
  apply (tau ^ (r - 1)).injective
  rw [RingEquiv.apply_symm_apply, map_sum]
  calc
    (∑ i ∈ range r, (tau ^ (r - 1)) ((tau ^ i).symm a)) =
        ∑ i ∈ range r, (tau ^ (r - 1 - i)) a := by
      apply sum_congr rfl
      intro i hi
      have hi' : i ≤ r - 1 := by
        have := mem_range.mp hi
        omega
      have hp : tau ^ (r - 1) = tau ^ (r - 1 - i) * tau ^ i := by
        rw [← pow_add, Nat.sub_add_cancel hi']
      rw [hp, RingAut.mul_apply, RingEquiv.apply_symm_apply]
    _ = norm tau r a := by
      exact sum_range_reflect (fun i : ℕ => (tau ^ i) a) r

private def primitive (tau : A ≃+* A) (r : ℕ) (x z : A) : A :=
  ∑ i ∈ range r, norm tau i (x * (tau ^ i).symm z)

/-- Each inner sum telescopes before any ring product is distributed. -/
private theorem primitive_shift (tau : A ≃+* A) (r : ℕ) (x z : A) :
    tau (primitive tau r x z) - primitive tau r x z =
      norm tau r x * z - x * (∑ i ∈ range r, (tau ^ i).symm z) := by
  change tau (∑ i ∈ range r, norm tau i (x * (tau ^ i).symm z)) -
      (∑ i ∈ range r, norm tau i (x * (tau ^ i).symm z)) = _
  rw [map_sum, ← sum_sub_distrib]
  calc
    (∑ i ∈ range r,
        (tau (norm tau i (x * (tau ^ i).symm z)) -
          norm tau i (x * (tau ^ i).symm z))) =
        ∑ i ∈ range r, ((tau ^ i) x * z - x * (tau ^ i).symm z) := by
      apply sum_congr rfl
      intro i _
      rw [norm_shift, map_mul, RingEquiv.apply_symm_apply]
    _ = norm tau r x * z - x * (∑ i ∈ range r, (tau ^ i).symm z) := by
      rw [sum_sub_distrib, ← sum_mul, ← mul_sum, norm_apply]

private theorem norm_mul_of_fixed (tau : A ≃+* A) (r : ℕ) (b x : A)
    (hb : tau b = b) : norm tau r (b * x) = b * norm tau r x := by
  have hbpow (i : ℕ) : (tau ^ i) b = b := by
    induction i with
    | zero => simp
    | succ i ih => rw [pow_succ', RingAut.mul_apply, ih, hb]
  simp only [norm_apply, mul_sum]
  exact sum_congr rfl fun i _ => by rw [map_mul, hbpow i]

/-- The digit decomposition k = q*i + j, proved by consecutive q-blocks.
It is valid even for q = 0 and avoids any group-period reduction of exponents. -/
theorem norm_blocks (sigma : A ≃+* A) (q r : ℕ) (a : A) :
    norm sigma (q * r) a = norm sigma q (norm (sigma ^ q) r a) := by
  induction r with
  | zero => simp [norm_apply]
  | succ r ih =>
    have hT : norm (sigma ^ q) (r + 1) a =
        norm (sigma ^ q) r a + (sigma ^ (q * r)) a := by
      simp only [norm_apply, sum_range_succ, ← pow_mul]
    rw [Nat.mul_succ, hT, map_add, ← ih]
    change (∑ k ∈ range (q * r + q), (sigma ^ k) a) =
      (∑ k ∈ range (q * r), (sigma ^ k) a) +
        ∑ j ∈ range q, (sigma ^ j) ((sigma ^ (q * r)) a)
    rw [sum_range_add]
    congr 1
    apply sum_congr rfl
    intro j _
    rw [Nat.add_comm (q * r) j, pow_add, RingAut.mul_apply]

/-- Lift norm one from the q-step finite norm to the full finite norm.
Positivity of q also follows from hr and hrc. No finite-order hypothesis
on sigma is needed. -/
theorem exists_norm_one_lift (sigma : A ≃+* A) (q r c : ℕ)
    (_hq : 0 < q) (hr : 0 < r) (hrc : r = c * q) (x : A)
    (hx : (∑ i ∈ range r, (sigma ^ (q * i)) x) = 1) :
    ∃ y : A, (∑ k ∈ range (q * r), (sigma ^ k) y) = 1 := by
  let tau : A ≃+* A := sigma ^ q
  let z : A := c • norm sigma q x - 1
  let w : A := primitive tau r x z
  let b : A := c • x + w - sigma w
  have hxT : norm tau r x = 1 := by
    change norm (sigma ^ q) r x = 1
    simpa only [norm_apply, ← pow_mul] using hx
  have hzT : norm tau r z = 0 := by
    calc
      norm tau r z = c • norm tau r (norm sigma q x) - r • (1 : A) := by
        change norm tau r (c • norm sigma q x - 1) = _
        rw [map_sub, map_nsmul, norm_one]
      _ = c • norm sigma q (norm tau r x) - r • (1 : A) := by
        rw [norm_comm sigma q r x]
      _ = 0 := by
        rw [hxT, norm_one, smul_smul, ← hrc, sub_self]
  have hzinv : (∑ i ∈ range r, (tau ^ i).symm z) = 0 := by
    rw [inverse_norm_eq tau r hr z, hzT, map_zero]
  have hw : tau w - w = z := by
    have h := primitive_shift tau r x z
    rw [hxT, hzinv, one_mul, mul_zero, sub_zero] at h
    exact h
  have hzsigma : sigma z - z = c • (tau x - x) := by
    change sigma (c • norm sigma q x - 1) - (c • norm sigma q x - 1) = _
    rw [map_sub, map_nsmul, map_one]
    calc
      (c • sigma (norm sigma q x) - 1) - (c • norm sigma q x - 1) =
          c • (sigma (norm sigma q x) - norm sigma q x) := by
        rw [smul_sub]
        abel
      _ = c • (tau x - x) := by rw [norm_shift]
  have hw_add : tau w = w + z := by
    calc
      tau w = z + w := (sub_eq_iff_eq_add.mp hw)
      _ = w + z := add_comm _ _
  have hcomm (a : A) : tau (sigma a) = sigma (tau a) := by
    simpa only [pow_one] using power_apply_comm sigma q 1 a
  have hb : tau b = b := by
    change tau (c • x + w - sigma w) = c • x + w - sigma w
    simp only [map_sub, map_add, map_nsmul, hcomm, hw_add]
    apply sub_eq_zero.mp
    calc
      (c • tau x + (w + z) - (sigma w + sigma z)) -
          (c • x + w - sigma w) =
          (c • tau x - c • x) - (sigma z - z) := by abel
      _ = 0 := by rw [hzsigma, smul_sub, sub_self]
  have hSw : norm sigma q (sigma w) - norm sigma q w = z := by
    have hc : norm sigma q (sigma w) = sigma (norm sigma q w) := by
      simpa only [pow_one] using norm_power_comm sigma q 1 w
    calc
      norm sigma q (sigma w) - norm sigma q w =
          sigma (norm sigma q w) - norm sigma q w := by rw [hc]
      _ = tau w - w := norm_shift sigma q w
      _ = z := hw
  have hSb : norm sigma q b = 1 := by
    change norm sigma q (c • x + w - sigma w) = 1
    rw [map_sub, map_add, map_nsmul]
    calc
      c • norm sigma q x + norm sigma q w - norm sigma q (sigma w) =
          c • norm sigma q x - (norm sigma q (sigma w) - norm sigma q w) := by abel
      _ = 1 := by
        rw [hSw]
        change c • norm sigma q x - (c • norm sigma q x - 1) = 1
        abel
  refine ⟨b * x, ?_⟩
  change norm sigma (q * r) (b * x) = 1
  rw [norm_blocks, norm_mul_of_fixed tau r b x hb, hxT, mul_one, hSb]

end D5.S3.FiniteGroups.GroupAlgebra.CyclicNormOne
