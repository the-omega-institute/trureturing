import Mathlib.Algebra.MonoidAlgebra.Basic
import Mathlib.Algebra.CharP.Lemmas
import Mathlib.Algebra.CharP.Algebra
import Mathlib.GroupTheory.PGroup
import Mathlib.RingTheory.Ideal.Quotient.Operations
import Mathlib.RingTheory.Ideal.Operations
import Mathlib.Tactic

/-!
The central cyclic quotient identifies its group-algebra kernel with the
principal ideal generated by the central element minus one. Induction on the
group order sends an entire augmentation-ideal power into this principal ideal.
The characteristic-p identity then kills its pth ideal power.

The quotient-kernel method is classical; see Webb, *A Course in Finite Group
Representation Theory*, Chapter 6, Exercises 15–17. No field or commutativity
assumption on the group is used.
-/

namespace D5.S3.FiniteGroups.GroupAlgebra.PGroupAugmentation

open MonoidAlgebra

universe u v
variable {R : Type u} {G : Type v} [CommRing R] [Group G]

private theorem central_difference_commute (z : G) (hz : z ∈ Subgroup.center G)
    (a : MonoidAlgebra R G) : Commute (of R G z - 1) a := by
  apply Commute.sub_left _ (Commute.one_left a)
  exact MonoidAlgebra.single_commute
    (fun g => (Subgroup.mem_center_iff.mp hz g).symm) (Commute.one_left) a

private def centralDifferenceTwoSided (z : G) (hz : z ∈ Subgroup.center G) :
    (Ideal.span {of R G z - 1} : Ideal (MonoidAlgebra R G)).IsTwoSided where
  mul_mem_of_left := by
    intro a b ha
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
    apply Ideal.mem_span_singleton'.mpr
    refine ⟨c * b, ?_⟩
    rw [mul_assoc, ← (central_difference_commute z hz b).eq, ← mul_assoc]

private theorem central_quotient_kernel (z : G) (hz : z ∈ Subgroup.center G) :
    letI : (Subgroup.zpowers z).Normal :=
      Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr hz)
    RingHom.ker (mapDomainAlgHom R R (QuotientGroup.mk' (Subgroup.zpowers z))).toRingHom =
      Ideal.span {of R G z - 1} := by
  letI : (Subgroup.zpowers z).Normal :=
    Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr hz)
  let J : Ideal (MonoidAlgebra R G) := Ideal.span {of R G z - 1}
  letI : J.IsTwoSided := centralDifferenceTwoSided z hz
  let q : MonoidAlgebra R G →ₐ[R] MonoidAlgebra R G ⧸ J := Ideal.Quotient.mkₐ R J
  let f : G →* MonoidAlgebra R G ⧸ J := q.toMonoidHom.comp (of R G)
  have hfz : f z = 1 := by
    have hzero : q (of R G z - 1) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
    change q (of R G z) = 1
    simpa only [map_sub, map_one, sub_eq_zero] using hzero
  have hfC : Subgroup.zpowers z ≤ f.ker := Subgroup.zpowers_le.mpr hfz
  let back := MonoidAlgebra.lift R (MonoidAlgebra R G ⧸ J)
    (G ⧸ Subgroup.zpowers z) (QuotientGroup.lift (Subgroup.zpowers z) f hfC)
  let pi := mapDomainAlgHom R R (QuotientGroup.mk' (Subgroup.zpowers z))
  have hback : back.comp pi = q := by
    ext g
    simp [back, pi, q, f]
  apply le_antisymm
  · intro a ha
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change q a = 0
    rw [← hback]
    change back (pi a) = 0
    rw [show pi a = 0 from ha, map_zero]
  · apply Ideal.span_le.mpr
    rintro a (rfl : a = of R G z - 1)
    change pi (of R G z - 1) = 0
    rw [map_sub, map_one]
    change mapDomain (QuotientGroup.mk' (Subgroup.zpowers z)) (single z (1 : R)) - 1 = 0
    rw [mapDomain_single]
    have hzq : QuotientGroup.mk' (Subgroup.zpowers z) z = 1 :=
      (QuotientGroup.eq_one_iff z).mpr (Subgroup.mem_zpowers z)
    rw [hzq]
    simp only [← one_def, sub_self]

-- Powers of left ideals do not form a semiring in a noncommutative ring.
-- These two-sided and transport arguments use the actual multiplication API.
private theorem ideal_pow_mul {A : Type*} [Ring A] (I : Ideal A) [I.IsTwoSided]
    (m n : ℕ) : I ^ (m * n) = (I ^ m) ^ n := by
  induction n with
  | zero => simp only [Nat.mul_zero, Submodule.pow_zero]
  | succ n ih =>
    rw [Nat.mul_succ, Ideal.IsTwoSided.pow_add, ih, Submodule.pow_succ]

theorem pow_le_comap {A B : Type*} [Ring A] [Ring B] (f : A →+* B)
    (I : Ideal A) (J : Ideal B) (h : I ≤ J.comap f) (n : ℕ) :
    I ^ n ≤ (J ^ n).comap f := by
  induction n with
  | zero => simp only [Submodule.pow_zero, Ideal.one_eq_top, Ideal.comap_top, le_refl]
  | succ n ih =>
    rw [Submodule.pow_succ, Submodule.pow_succ]
    apply Ideal.mul_le.mpr
    intro a ha b hb
    change f (a * b) ∈ J ^ n * J
    rw [map_mul]
    exact Ideal.mul_mem_mul (ih ha) (h hb)

/-- Over any commutative ring of characteristic `p`, the augmentation ideal of
a finite `p`-group vanishes at its group-order power, including order one. -/
theorem augmentation_ideal_pow_card (p : ℕ) [Fact p.Prime] [CharP R p] [Finite G]
    (hG : IsPGroup p G) :
    (RingHom.ker (MonoidAlgebra.lift R R G (1 : G →* R)).toRingHom) ^ Nat.card G = ⊥ := by
  classical
  suffices h : ∀ n, ∀ (H : Type v) [Group H] [Finite H], Nat.card H = n →
      IsPGroup p H →
      (RingHom.ker (MonoidAlgebra.lift R R H (1 : H →* R)).toRingHom) ^ n = ⊥ from
    h _ G rfl hG
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro H _ _ hcard hH
    let I : Ideal (MonoidAlgebra R H) :=
      RingHom.ker (MonoidAlgebra.lift R R H (1 : H →* R)).toRingHom
    by_cases hs : Subsingleton H
    · letI := hs
      have hI : I = ⊥ := by
        apply le_antisymm _ bot_le
        intro a ha
        change a = 0
        have heq : a = single (1 : H)
            (MonoidAlgebra.lift R R H (1 : H →* R) a) := by
          clear ha
          induction a using MonoidAlgebra.induction_linear with
          | zero => simp
          | add a b ha hb => rw [map_add, single_add, ← ha, ← hb]
          | single g r => simp [Subsingleton.elim g 1]
        rw [heq, show MonoidAlgebra.lift R R H (1 : H →* R) a = 0 from ha]
        simp
      rw [← hcard]
      change I ^ Nat.card H = ⊥
      simpa only [Nat.card_unique, Submodule.pow_one] using hI
    · letI : Nontrivial H := not_subsingleton_iff_nontrivial.mp hs
      letI : Nontrivial (Subgroup.center H) := hH.center_nontrivial
      have hc : IsPGroup p (Subgroup.center H) := hH.to_subgroup _
      have hpdvd : p ∣ Nat.card (Subgroup.center H) :=
        hc.card_eq_or_dvd.resolve_left (ne_of_gt Finite.one_lt_card)
      obtain ⟨z, hzorder⟩ := exists_prime_orderOf_dvd_card' p hpdvd
      let C := Subgroup.zpowers (z : H)
      letI : C.Normal := Subgroup.normal_of_le_center (Subgroup.zpowers_le.mpr z.property)
      have hzorder' : orderOf (z : H) = p :=
        (orderOf_injective (Subgroup.center H).subtype Subtype.coe_injective z).trans hzorder
      have hCcard : Nat.card C = p := (Nat.card_zpowers (z : H)).trans hzorder'
      have hmul : Nat.card (H ⧸ C) * p = n := by
        rw [← hCcard, ← Subgroup.card_eq_card_quotient_mul_card_subgroup, hcard]
      have hlt : Nat.card (H ⧸ C) < n := by
        rw [← hmul]
        have hpos : 0 < Nat.card (H ⧸ C) := Nat.card_pos
        nlinarith [(Fact.out : p.Prime).one_lt]
      have hind := ih _ hlt (H ⧸ C) rfl (hH.to_quotient C)
      let pi := mapDomainAlgHom R R (QuotientGroup.mk' C)
      let J : Ideal (MonoidAlgebra R H) := Ideal.span {of R H (z : H) - 1}
      letI : J.IsTwoSided := centralDifferenceTwoSided (z : H) z.property
      have haug : (MonoidAlgebra.lift R R (H ⧸ C) (1 : (H ⧸ C) →* R)).comp pi =
          MonoidAlgebra.lift R R H (1 : H →* R) := by
        ext g
        simp [pi]
      have hle : I ≤ (RingHom.ker
          (MonoidAlgebra.lift R R (H ⧸ C) (1 : (H ⧸ C) →* R)).toRingHom).comap
          pi.toRingHom := by
        intro a ha
        change MonoidAlgebra.lift R R (H ⧸ C) (1 : (H ⧸ C) →* R) (pi a) = 0
        exact congrArg (fun f : MonoidAlgebra R H →ₐ[R] R => f a) haug ▸ ha
      have hpower : I ^ Nat.card (H ⧸ C) ≤ J := by
        have h := pow_le_comap pi.toRingHom I _ hle (Nat.card (H ⧸ C))
        rw [hind] at h
        change I ^ Nat.card (H ⧸ C) ≤ RingHom.ker pi.toRingHom at h
        exact h.trans (central_quotient_kernel (z : H) z.property).le
      have hzero : (of R H (z : H) - 1) ^ p = 0 := by
        letI : CharP (MonoidAlgebra R H) p :=
          charP_of_injective_ringHom (f := singleOneRingHom)
            (single_right_injective (m := (1 : H))) p
        rw [sub_pow_char_of_commute p (Commute.one_right _), one_pow, ← map_pow]
        have hzpow : (z : H) ^ p = 1 := by
          exact orderOf_dvd_iff_pow_eq_one.mp (hzorder' ▸ dvd_refl p)
        rw [hzpow, map_one, sub_self]
      have hJ : J ^ p = ⊥ := by
        rw [Ideal.span_singleton_pow, hzero, Ideal.span_singleton_eq_bot.mpr rfl]
      apply le_antisymm _ bot_le
      change I ^ n ≤ ⊥
      rw [← hmul, ideal_pow_mul]
      exact (Ideal.pow_right_mono hpower p).trans hJ.le

end D5.S3.FiniteGroups.GroupAlgebra.PGroupAugmentation
