import D5.S3.FiniteGroups.NikolovSegal.TypeA.RootGeometry.PartIISLnRootGraph

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1800000

namespace NikolovSegal.SLnRootAction
open Matrix NikolovSegal.SLnNormalizer
universe u
variable {F : Type u} [Field F] {n : ℕ}
local notation "G" => SpecialLinearGroup (Fin n) F

private theorem right_root_entry (g : G) (r : PositiveIndex n) (t : F) (i j : Fin n) :
    (g*root r t).val i j = g.val i j + if j=r.val.2 then g.val i r.val.1*t else 0 := by
  change (g.val*(1+Matrix.single r.val.1 r.val.2 t)) i j = _
  rw [Matrix.mul_add,Matrix.mul_one,Matrix.add_apply]
  by_cases h : j=r.val.2
  · subst j; simp
  · simp [Matrix.mul_single_apply_of_ne t _ _ _ _ h,h]

/-- Literal Gaussian column clearing proves full U is generated by its
actual positive transvections, in all ranks and fields. -/
theorem Uplus_le_of_roots (H : Subgroup G)
    (hroot : ∀ (r : PositiveIndex n) (t : F), root r t ∈ H) : Uplus n F ≤ H := by
  classical
  have hmain : ∀ k : ℕ, ∀ g : G, g ∈ Uplus n F →
      (∀ r c : Fin n, k ≤ r.val → g.val r c=(1:Matrix (Fin n) (Fin n) F) r c) → g ∈ H := by
    intro k
    induction k with
    | zero =>
      intro g hg hs
      have he : g=1 := by apply SpecialLinearGroup.ext; intro r c; exact hs r c (Nat.zero_le _)
      rw [he]; exact H.one_mem
    | succ k ih =>
      intro g hg hs
      by_cases hk : k<n
      · let i : Fin n := ⟨k,hk⟩
        have hclear : ∀ l : ℕ, l ≤ n → ∃ v : G,
            v ∈ Uplus n F ∧
            (∀ r c : Fin n, k+1 ≤ r.val → v.val r c=(1:Matrix (Fin n) (Fin n) F) r c) ∧
            (∀ c : Fin n, c.val<l → v.val i c=(1:Matrix (Fin n) (Fin n) F) i c) ∧
            (g ∈ H ↔ v ∈ H) := by
          intro l
          induction l with
          | zero => exact fun _ => ⟨g,hg,hs,by intro c hc; omega,Iff.rfl⟩
          | succ l ihl =>
            intro hl
            obtain ⟨v,hv,hvs,hvc,he⟩ := ihl (by omega)
            let j : Fin n := ⟨l,by omega⟩
            by_cases hij : k<l
            · let r : PositiveIndex n := ⟨(i,j),hij⟩
              let w := v*root r (-v.val i j)
              have hw : w ∈ Uplus n F := (Uplus n F).mul_mem hv (root_mem_Uplus r (-v.val i j))
              have hws : ∀ r' c : Fin n, k+1 ≤ r'.val → w.val r' c=(1:Matrix (Fin n) (Fin n) F) r' c := by
                intro r' c hr'
                rw [right_root_entry]
                have hz : v.val r' i=0 := hv.1 r' i (by change k<r'.val; omega)
                rw [hvs r' c hr',hz,zero_mul]
                simp
              have hwc : ∀ c : Fin n, c.val<l+1 → w.val i c=(1:Matrix (Fin n) (Fin n) F) i c := by
                intro c hc
                rw [right_root_entry]
                by_cases hcj : c=j
                · subst c
                  rw [if_pos rfl,hv.2 i,mul_neg,one_mul,add_neg_cancel]
                  simp [Matrix.one_apply,ne_of_lt (show i<j from hij)]
                · rw [if_neg hcj,add_zero]
                  apply hvc c
                  have hcne : c.val ≠ l := fun he => hcj (Fin.ext he)
                  omega
              have hew : v ∈ H ↔ w ∈ H := by
                constructor
                · intro hm; exact H.mul_mem hm (hroot r _)
                · intro hm
                  have h := H.mul_mem hm (H.inv_mem (hroot r (-v.val i j)))
                  simpa only [w,mul_inv_cancel_right] using h
              exact ⟨w,hw,hws,hwc,he.trans hew⟩
            · refine ⟨v,hv,hvs,?_,he⟩
              intro c hc
              by_cases hci : c=i
              · subst c; simpa using hv.2 i
              · have hcv : c.val<k := by
                  have hne : c.val ≠ k := fun he => hci (Fin.ext he)
                  omega
                simp [hv.1 i c hcv,Matrix.one_apply,Ne.symm hci]
        obtain ⟨v,hv,hvs,hvc,he⟩ := hclear n (le_refl n)
        apply he.mpr
        apply ih v hv
        intro r c hr
        by_cases hri : r=i
        · subst r; exact hvc c c.isLt
        · apply hvs r c
          have hne : r.val ≠ k := fun he => hri (Fin.ext he)
          omega
      · apply ih g hg
        intro r c hr
        have hb:=r.isLt
        omega
  intro g hg
  apply hmain n g hg
  intro r c hr
  have hb:=r.isLt
  omega

/-- Agreement on genuine positive roots implies agreement on the whole U. -/
theorem hom_ext_on_Uplus {K : Type*} [Group K] (f g : G →* K)
    (h : ∀ r t, f (root r t)=g (root r t)) :
    ∀ x ∈ Uplus n F, f x=g x := by
  let H : Subgroup G := {
    carrier := {x | f x=g x}
    one_mem' := by simp
    mul_mem' := by intro x y hx hy; simp only [Set.mem_setOf_eq,map_mul] at *; rw [hx,hy]
    inv_mem' := by intro x hx; simp only [Set.mem_setOf_eq,map_inv] at *; rw [hx]}
  exact Uplus_le_of_roots H h

/-- Genuine simple roots generate the other positive roots by their
matrix commutators, with no generation premise. -/
theorem hom_ext_on_simple_roots {K : Type*} [Group K] (f g : G →* K)
    (h : ∀ (i : Fin (n-1)) (t : F), f (root (simpleRoot i) t)=g (root (simpleRoot i) t)) :
    ∀ x ∈ Uplus n F, f x=g x := by
  apply hom_ext_on_Uplus f g
  have hall : ∀ d : ℕ, ∀ (i j : Fin n) (hij : i<j), j.val-i.val=d →
      ∀ t : F, f (root ⟨(i,j),hij⟩ t)=g (root ⟨(i,j),hij⟩ t) := by
    intro d
    induction d using Nat.strong_induction_on with
    | h d ih =>
      intro i j hij hd t
      by_cases hadj : j.val=i.val+1
      · let a : Fin (n-1) := ⟨i.val,by have hb:=j.isLt; omega⟩
        have he : simpleRoot a=(⟨(i,j),hij⟩ : PositiveIndex n) :=
          Subtype.ext (Prod.ext (Fin.ext rfl) (Fin.ext hadj.symm))
        rw [← he]; exact h a t
      · let k : Fin n := ⟨j.val-1,by have hb:=j.isLt; omega⟩
        have hik : i<k := by change i.val<j.val-1; have hi:=hij; change i.val<j.val at hi; omega
        have hkj : k<j := by change j.val-1<j.val; have hi:=hij; change i.val<j.val at hi; omega
        have h1 := ih (k.val-i.val) (by dsimp [k]; have hi:=hij; change i.val<j.val at hi; omega) i k hik rfl t
        have h2 := ih (j.val-k.val) (by dsimp [k]; have hi:=hij; change i.val<j.val at hi; omega) k j hkj rfl 1
        have hc := transvection_commutator_chain hik hkj t (1:F)
        rw [mul_one] at hc
        change root ⟨(i,k),hik⟩ t*root ⟨(k,j),hkj⟩ 1*(root ⟨(i,k),hik⟩ t)⁻¹*
          (root ⟨(k,j),hkj⟩ 1)⁻¹ = root ⟨(i,j),hij⟩ t at hc
        rw [← hc]
        simp only [map_mul,map_inv,h1,h2]
  intro r t
  exact hall _ r.val.1 r.val.2 r.property rfl t
end NikolovSegal.SLnRootAction
