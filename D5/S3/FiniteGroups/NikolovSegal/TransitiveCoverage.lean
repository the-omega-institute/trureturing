import D5.S3.FiniteGroups.NikolovSegal.FactorOrbits
import D5.S3.FiniteGroups.NikolovSegal.InvariantBlockReduction
import D5.S3.FiniteGroups.NikolovSegal.GeneratorDecomposition

set_option autoImplicit false
namespace NikolovSegal
universe u

/-- UNPROVED centerless Proposition 10.2 supplier. The finite nonempty index
`ι` represents S^r, r = card ι > 0. The coordinate law describes the genuine
prescribed factor action, including its component automorphisms. Transitivity
is required only for the permutations generated by this prescribed tuple.
Corrections precede the arbitrary target in PrescribedCommutatorCoverage. -/
def TransitiveSimpleCommutatorSupplier (q m C : ℕ) : Prop :=
  ∀ (S : Type u) [Group S] [Finite S] [IsSimpleGroup S],
    ¬IsMulCommutative S → C < Nat.card S →
    ∀ (ι : Type u) [Finite ι] [Nonempty ι],
    ∀ (k : Fin m → MulAut (ι → S)) (σ : Fin m → Equiv.Perm ι)
      (β : Fin m → ι → MulAut S),
      (∀ i x j, k i x (σ i j) = β i j (x j)) →
      (∀ j l, ∃ p : Subgroup.closure (Set.range σ), p.val j = l) →
      PrescribedCommutatorCoverage (ι → S) q m k

/-- Uniform quantitative statement still open: m and C are chosen before S,
rank, factor count and tuple. Positivity is the paper's prerequisite. -/
def UniformTransitiveSimpleCommutatorSupplier : Prop :=
  ∀ q : ℕ, 0 < q → ∃ m C : ℕ, 0 < m ∧ TransitiveSimpleCommutatorSupplier.{u} q m C

variable {A : Type u} [Group A] {m : ℕ}

private noncomputable def orbitFactorEquiv (k : Fin m → MulAut A) (o : FactorOrbit k)
    (α : prescribedActionGroup k) (M : OrbitFactor k o) :
    M.val.val ≃* (α • M).val.val :=
  M.val.val.equivMapOfInjective α.val.toMonoidHom α.val.injective

private theorem orbitBlockAut_coordinate (k : Fin m → MulAut A) (o : FactorOrbit k)
    (α : prescribedActionGroup k) (x : OrbitBlock k o) (M : OrbitFactor k o) :
    orbitBlockAut k o α x (α • M) = orbitFactorEquiv k o α M (x M) := by
  apply Subtype.ext
  change α.val ((fun L => (x L : A)) (α⁻¹ • (α • M))) = α.val (x M)
  rw [inv_smul_smul]

private def homogeneousBlockEquiv {S : Type u} [Group S]
    (k : Fin m → MulAut A) (o : FactorOrbit k)
    (e : ∀ M : OrbitFactor k o, M.val.val ≃* S) :
    OrbitBlock k o ≃* (OrbitFactor k o → S) := MulEquiv.piCongrRight e

private def homogeneousBlockAut {S : Type u} [Group S]
    (k : Fin m → MulAut A) (o : FactorOrbit k)
    (e : ∀ M : OrbitFactor k o, M.val.val ≃* S) :
    Fin m → MulAut (OrbitFactor k o → S) := fun i =>
  ((homogeneousBlockEquiv k o e).symm.trans (prescribedOrbitAut k o i)).trans
    (homogeneousBlockEquiv k o e)

private noncomputable def homogeneousComponentAut {S : Type u} [Group S]
    (k : Fin m → MulAut A) (o : FactorOrbit k)
    (e : ∀ M : OrbitFactor k o, M.val.val ≃* S) :
    Fin m → OrbitFactor k o → MulAut S := fun i M =>
  ((e M).symm.trans (orbitFactorEquiv k o
    ⟨k i, Subgroup.subset_closure ⟨i, rfl⟩⟩ M)).trans
      (e (prescribedOrbitPermutation k o i M))

private theorem homogeneousBlockAut_coordinate {S : Type u} [Group S]
    (k : Fin m → MulAut A) (o : FactorOrbit k)
    (e : ∀ M : OrbitFactor k o, M.val.val ≃* S)
    (i : Fin m) (x : OrbitFactor k o → S) (M : OrbitFactor k o) :
    homogeneousBlockAut k o e i x (prescribedOrbitPermutation k o i M) =
      homogeneousComponentAut k o e i M (x M) := by
  exact congrArg (e (prescribedOrbitPermutation k o i M))
    (orbitBlockAut_coordinate k o ⟨k i, Subgroup.subset_closure ⟨i, rfl⟩⟩
      ((homogeneousBlockEquiv k o e).symm x) M)

private theorem prescribed_coverage_of_equiv
    {B P : Type u} [Group B] [Group P] (q m : ℕ)
    (k : Fin m → MulAut B) (l : Fin m → MulAut P) (e : B ≃* P)
    (he : ∀ i x, e (k i x) = l i (e x))
    (hc : PrescribedCommutatorCoverage P q m l) :
    PrescribedCommutatorCoverage B q m k := by
  let e' : B ≃* (Unit → P) :=
    { toFun := fun x _ => e x
      invFun := fun x => e.symm (x ())
      left_inv := fun x => e.symm_apply_apply x
      right_inv := fun x => by funext j; cases j; exact e.apply_symm_apply _
      map_mul' := fun x y => by funext j; exact e.map_mul x y }
  exact prescribed_coverage_of_equivariant_product q m k (fun _ => l) e'
    (fun i x _ => he i x) (fun _ => hc)

/-- Actual orbit construction consumes the transitive finite-simple supplier.
Ambient conjugacy supplies genuine isomorphisms to the chosen simple factor
of each block. No orbit decomposition/equivariance/transitivity premise occurs. -/
theorem minimal_normal_coverage_of_transitive_supplier
    {G : Type u} [Group G] [Finite G] (N : Subgroup G)
    (hN : Minimal (fun K : Subgroup G => K.Normal ∧ K ≠ ⊥) N)
    (q m C : ℕ) (supplier : TransitiveSimpleCommutatorSupplier.{u} q m C)
    (hna : ¬IsMulCommutative N)
    (hf : ∀ M : MinimalNormalFactor N,
      IsSimpleGroup M.val ∧ ¬IsMulCommutative M.val ∧ C < Nat.card M.val)
    (k : Fin m → MulAut N) : PrescribedCommutatorCoverage N q m k := by
  classical
  let := hN.prop.1
  have hs := socle_of_finite_minimal_normal N hN
  have hz := (perfect_centerless_minimal_normal N hN hna).2
  apply prescribed_coverage_of_equivariant_product q m k (prescribedOrbitAut k)
    (orbitProductEquiv hs hz k) (orbitProductEquiv_prescribed hs hz k)
  intro o
  let R : MinimalNormalFactor N := o.out
  let S := R.val
  let : IsSimpleGroup S := (hf R).1
  let e : ∀ M : OrbitFactor k o, M.val.val ≃* S := fun M =>
    Classical.choice (minimal_normal_factors_isomorphic N hN hna M.val R)
  have hc : PrescribedCommutatorCoverage (OrbitFactor k o → S) q m
      (homogeneousBlockAut k o e) :=
    supplier S (hf R).2.1 (hf R).2.2 (OrbitFactor k o)
      (homogeneousBlockAut k o e) (prescribedOrbitPermutation k o)
      (homogeneousComponentAut k o e) (homogeneousBlockAut_coordinate k o e)
      (prescribedOrbitPermutation_transitive k o)
  apply prescribed_coverage_of_equiv q m (prescribedOrbitAut k o)
    (homogeneousBlockAut k o e) (homogeneousBlockEquiv k o e) _ hc
  intro i x
  simp [homogeneousBlockAut]

/-- The original exact large-minimal-normal absorption interface, conditional
only on the genuinely independent transitive commutator-value supplier. -/
theorem absorption_of_transitive_supplier (q m C cutoff : ℕ)
    (hcutoff : 4 ≤ cutoff) (hfac : 2 * C < cutoff.factorial)
    (supplier : TransitiveSimpleCommutatorSupplier.{u} q m C) :
    LargeMinimalNormalAbsorption.{u} q m cutoff := by
  intro G _ _ N hN hα a x hx
  let := hN.prop.1
  have hna := noncommutative_of_large_alpha hcutoff hα
  obtain ⟨_, _, hf, _⟩ := large_minimal_normal_structure N hN C cutoff hcutoff hfac hα
  obtain ⟨h, hh⟩ := hx
  have hc := minimal_normal_coverage_of_transitive_supplier N hN q m C supplier hna hf
    (correctedAutomorphisms N q h)
  obtain ⟨b, hb⟩ := coset_power_surjective_of_prescribed_commutator_coverage N q m h hc a
  exact ⟨fun i => (b i : G) * h i, hb.trans (congrArg (fun z : G => (a : G) * z) hh)⟩

end NikolovSegal
