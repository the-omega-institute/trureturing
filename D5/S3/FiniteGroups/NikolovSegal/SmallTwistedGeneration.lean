import D5.S3.FiniteGroups.NikolovSegal.Equation47WordCoupling
import Mathlib.GroupTheory.Subgroup.Simple

set_option autoImplicit false

namespace NikolovSegal.SmallTwistedProduct
open Equation47WordCoupling
open scoped commutatorElement
universe u
variable {S : Type u} [Group S]

def twistedSet (a b : MulAut S) : Set S :=
  {t | ∃ x y, twistedValue a b x y = t}

theorem one_mem_twistedSet (a b : MulAut S) : 1 ∈ twistedSet a b := by
  exact ⟨1,1,by simp [twistedValue]⟩

/-- The literal printed identity, with forward automorphism conventions. -/
theorem ordinary_from_twisted (a b : MulAut S) (x y : S) :
    (twistedValue a b x 1)⁻¹ * twistedValue a b x y * (twistedValue a b 1 y)⁻¹ =
      (a x)⁻¹ * y⁻¹ * a x * y := by
  simp only [twistedValue,map_one,inv_one,mul_one,one_mul]
  group

/-- Every ordinary commutator lies in the subgroup generated by the actual
fixed twisted-value set. Surjectivity of a supplies its first coordinate. -/
theorem commutator_mem_twisted_closure (a b : MulAut S) (x y : S) :
    ⁅x,y⁆ ∈ Subgroup.closure (twistedSet a b) := by
  let u := a.symm x⁻¹
  let H := Subgroup.closure (twistedSet a b)
  have h1 : twistedValue a b u 1 ∈ H := Subgroup.subset_closure ⟨u,1,rfl⟩
  have h2 : twistedValue a b u y⁻¹ ∈ H := Subgroup.subset_closure ⟨u,y⁻¹,rfl⟩
  have h3 : twistedValue a b 1 y⁻¹ ∈ H := Subgroup.subset_closure ⟨1,y⁻¹,rfl⟩
  have h := H.mul_mem (H.mul_mem (H.inv_mem h1) h2) (H.inv_mem h3)
  rw [ordinary_from_twisted] at h
  simpa [u,commutatorElement_def] using h

theorem commutator_le_twisted_closure (a b : MulAut S) :
    _root_.commutator S ≤ Subgroup.closure (twistedSet a b) := by
  rw [_root_.commutator_def,Subgroup.commutator_le]
  intro x _ y _
  exact commutator_mem_twisted_closure a b x y

/-- Real simple-group perfectness, from Mathlib's normal dichotomy and the
commutator=bot iff commutative criterion. No perfectness input is assumed. -/
theorem noncommutative_simple_commutator_top [IsSimpleGroup S]
    (hn : ¬IsMulCommutative S) : _root_.commutator S = ⊤ := by
  have h := (inferInstance : (_root_.commutator S).Normal).eq_bot_or_eq_top
  exact h.resolve_left (fun hb => hn ((_root_.commutator_eq_bot_iff S).mp hb))

theorem twisted_closure_top [IsSimpleGroup S] (hn : ¬IsMulCommutative S)
    (a b : MulAut S) : Subgroup.closure (twistedSet a b) = ⊤ := by
  apply top_unique
  rw [← noncommutative_simple_commutator_top hn]
  exact commutator_le_twisted_closure a b

end NikolovSegal.SmallTwistedProduct
