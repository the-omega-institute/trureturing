/- GID: D5/S3/FiniteGroups/CycleNineThreeObstruction
   generality: G
   mirror-B: D5/B/S3/FiniteGroups/CycleNineThreeObstruction
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: A finite group of order dividing 72 cannot be generated by elements with exact orders 9, 3 and product order 2. -/

import Mathlib.GroupTheory.Sylow
import Mathlib.Tactic.IntervalCases
import Mathlib.GroupTheory.OrderOfElement
import Mathlib.GroupTheory.SpecificGroups.Cyclic
import Mathlib.GroupTheory.GroupAction.ConjAct
import Mathlib.Tactic.NormNum
import Mathlib.Tactic.Group

namespace CycleNineThreeObstruction

set_option maxHeartbeats 800000
macro "grp" : tactic => `(tactic| (simp only [pow_succ, pow_zero, mul_one] <;> group))

theorem result {H : Type*} [Group H] [Finite H] (r s : H)
    (hgen : Subgroup.closure ({r,s} : Set H) = ⊤) (hcard : Nat.card H ∣ 72)
    (hr : orderOf r = 9) (hs : orderOf s = 3) (ht : orderOf (r*s) = 2) : False := by
  classical
  have central_lift_cube_one (r s : H)
      (hr : r ^ 9 = 1) (hs : s ^ 3 = 1) (ht : (r * s) ^ 2 = 1)
      (hzs : Commute (r ^ 3) s) : r ^ 3 = 1 := by
    let z := r ^ 3
    let u := r * s
    let v := r * u * r⁻¹
    let w := r ^ 2 * u * (r ^ 2)⁻¹
    have hz3 : z ^ 3 = 1 := by dsimp [z]; simpa only [← pow_mul] using hr
    have hu2 : u ^ 2 = 1 := ht
    have hv2 : v ^ 2 = 1 := by
      calc
        v ^ 2 = r * u ^ 2 * r⁻¹ := by dsimp [v]; grp
        _ = 1 := by rw [hu2]; grp
    have hw2 : w ^ 2 = 1 := by
      calc
        w ^ 2 = r ^ 2 * u ^ 2 * (r ^ 2)⁻¹ := by dsimp [w]; grp
        _ = 1 := by rw [hu2]; grp
    have hzu : Commute z u := (Commute.pow_self r 3).mul_right hzs
    have hzw : Commute z w := by
      dsimp [w]
      exact ((Commute.pow_pow_self r 3 2).mul_right hzu).mul_right
        (Commute.pow_pow_self r 3 2).inv_right
    have hprod : w * v * u = z := by
      calc
        w * v * u = r ^ 3 * s ^ 3 := by dsimp [w, v, u]; grp
        _ = z := by rw [hs, mul_one]
    have hvu : v * u = w * z := by
      calc
        v * u = w ^ 2 * (v * u) := by rw [hw2, one_mul]
        _ = w * (w * v * u) := by grp
        _ = w * z := by rw [hprod]
    have hvu2 : (v * u) ^ 2 = z ^ 2 := by
      rw [hvu, hzw.symm.mul_pow, hw2, one_mul]
    have hui : u⁻¹ = u := by
      apply inv_eq_of_mul_eq_one_left
      simpa only [pow_two] using hu2
    have hvi : v⁻¹ = v := by
      apply inv_eq_of_mul_eq_one_left
      simpa only [pow_two] using hv2
    have huv2 : (u * v) ^ 2 = z ^ 2 := by
      calc
        (u * v) ^ 2 = u * (v * u) ^ 2 * u := by
          calc
            (u * v) ^ 2 = u * v * u * v * u ^ 2 := by rw [hu2]; grp
            _ = u * (v * u) ^ 2 * u := by grp
        _ = u * (v * u) ^ 2 * u⁻¹ := by rw [hui]
        _ = u * z ^ 2 * u⁻¹ := by rw [hvu2]
        _ = z ^ 2 := by rw [← (hzu.pow_left 2).eq]; grp
    have hz4 : z ^ 4 = 1 := by
      calc
        z ^ 4 = (v * u) ^ 2 * (u * v) ^ 2 := by rw [hvu2, huv2]; grp
        _ = (v * u) ^ 2 * ((v * u) ^ 2)⁻¹ := by
          rw [← inv_pow, mul_inv_rev, hui, hvi]
        _ = 1 := mul_inv_cancel _
    calc
      r ^ 3 = z := rfl
      _ = z ^ 4 := by rw [show z ^ 4 = z ^ 3 * z by grp, hz3, one_mul]
      _ = 1 := hz4
  have scratch_normal_application (r s : H)
      (hr : orderOf r = 9) (hs : s ^ 3 = 1) (ht : (r * s) ^ 2 = 1)
      (hn : (Subgroup.zpowers (r ^ 3)).Normal) : False := by
    classical
    let L := Subgroup.zpowers (r ^ 3)
    have : L.Normal := hn
    have hzord : orderOf (r ^ 3) = 3 := by
      rw [orderOf_pow' _ (by decide : 3 ≠ 0), hr]
      decide
    have hcard : Nat.card L = 3 := by
      dsimp [L]
      rw [Nat.card_zpowers, hzord]
    have : Finite L := Nat.finite_of_card_ne_zero (by omega)
    have hauto : Nat.card (MulAut L) = 2 := by
      rw [IsCyclic.card_mulAut, hcard]
      decide
    let phi : H →* MulAut L := MulAut.conjNormal
    have hp3 : (phi s) ^ 3 = 1 := by rw [← map_pow, hs, map_one]
    have hd2 : orderOf (phi s) ∣ 2 := hauto ▸ orderOf_dvd_natCard (phi s)
    have hd3 : orderOf (phi s) ∣ 3 := orderOf_dvd_of_pow_eq_one hp3
    have ho : orderOf (phi s) = 1 := by
      have hd : orderOf (phi s) ∣ 1 := by
        simpa only [show Nat.gcd 2 3 = 1 by decide] using Nat.dvd_gcd hd2 hd3
      exact Nat.dvd_one.mp hd
    have hp : phi s = 1 := orderOf_eq_one_iff.mp ho
    have hc : s * r ^ 3 * s⁻¹ = r ^ 3 := by
      have hh := congrArg (fun f : MulAut L => ((f ⟨r ^ 3, Subgroup.mem_zpowers _⟩ : L) : H)) hp
      simpa [phi, MulAut.conjNormal_apply] using hh
    have hzcomm : Commute (r ^ 3) s := by
      change r ^ 3 * s = s * r ^ 3
      calc
        r ^ 3 * s = (s * r ^ 3 * s⁻¹) * s := by rw [hc]
        _ = s * r ^ 3 := by group
    have hr9 : r ^ 9 = 1 := by simpa only [hr] using pow_orderOf_eq_one r
    have hz := central_lift_cube_one r s hr9 hs ht hzcomm
    have hd := orderOf_dvd_of_pow_eq_one hz
    rw [hr] at hd
    norm_num at hd
  have scratch_kernel_normality_application (K : Subgroup H) [K.Normal] [Finite K]
      (hc : Nat.card K = 3 ∨ Nat.card K = 6) (z : H)
      (hz : orderOf z = 3) (hzk : z ∈ K) : (Subgroup.zpowers z).Normal := by
    classical
    have : Fact (Nat.Prime 3) := ⟨by decide⟩
    let zz : K := ⟨z, hzk⟩
    have hzz : orderOf zz = 3 := by
      simpa only [zz, Subgroup.orderOf_mk] using hz
    let L := Subgroup.zpowers zz
    have hL : Nat.card L = 3 := by rw [Nat.card_zpowers]; exact hzz
    have hpg : IsPGroup 3 L := IsPGroup.of_card (hL.trans (pow_one 3).symm)
    have hidx : ¬ 3 ∣ L.index := by
      have hmul := L.card_mul_index
      rw [hL] at hmul
      have hcases : L.index = 1 ∨ L.index = 2 := by
        rcases hc with hc | hc <;> omega
      rcases hcases with hi | hi <;> rw [hi] <;> decide
    let P : Sylow 3 K := hpg.toSylow hidx
    have hpidx : P.index = 1 ∨ P.index = 2 := by
      have hmul := (P : Subgroup K).card_mul_index
      have hpcard : Nat.card P = 3 := by
        change Nat.card L = 3
        exact hL
      rw [hpcard] at hmul
      rcases hc with hc | hc <;> omega
    have hsyl : Nat.card (Sylow 3 K) = 1 := by
      have hd := P.card_dvd_index
      have hm := card_sylow_modEq_one 3 K
      have hn : 0 < Nat.card (Sylow 3 K) := Nat.card_pos
      have hbound : Nat.card (Sylow 3 K) ≤ 2 := by
        rcases hpidx with hi | hi
        · rw [hi] at hd
          exact (Nat.le_of_dvd (by decide) hd).trans (by decide)
        · rw [hi] at hd
          exact Nat.le_of_dvd (by decide) hd
      have hmod : Nat.card (Sylow 3 K) % 3 = 1 := hm
      omega
    have : Subsingleton (Sylow 3 K) := (Nat.card_eq_one_iff_unique.mp hsyl).1
    have : L.Characteristic := P.characteristic_of_subsingleton
    have hn : (L.map K.subtype).Normal := inferInstance
    have heq : L.map K.subtype = Subgroup.zpowers z := by
      dsimp [L]
      rw [MonoidHom.map_zpowers]
      rfl
    rw [heq] at hn
    exact hn
  have : Fact (Nat.Prime 3) := ⟨by decide⟩
  have hd9 : 9 ∣ Nat.card H := hr ▸ orderOf_dvd_natCard r
  have hd2 : 2 ∣ Nat.card H := ht ▸ orderOf_dvd_natCard (r*s)
  have hpos : 0 < Nat.card H := Nat.card_pos
  have hbound : Nat.card H ≤ 72 := Nat.le_of_dvd (by decide) hcard
  have hc : Nat.card H = 18 ∨ Nat.card H = 36 ∨ Nat.card H = 72 := by
    have hcases : Nat.card H = 18 ∨ Nat.card H = 36 ∨ Nat.card H = 54 ∨ Nat.card H = 72 := by omega
    rcases hcases with h | h | h | h
    · exact Or.inl h
    · exact Or.inr (Or.inl h)
    · rw [h] at hcard; norm_num at hcard
    · exact Or.inr (Or.inr h)
  let R := Subgroup.zpowers r
  have hR : Nat.card R = 9 := by rw [Nat.card_zpowers]; exact hr
  have hpg : IsPGroup 3 R := IsPGroup.of_card (n := 2) (hR.trans (by norm_num))
  have hidx : ¬ 3 ∣ R.index := by
    have hm := R.card_mul_index
    rw [hR] at hm
    have hcases : R.index = 2 ∨ R.index = 4 ∨ R.index = 8 := by rcases hc with h | h | h <;> omega
    rcases hcases with h | h | h <;> rw [h] <;> decide
  let P : Sylow 3 H := hpg.toSylow hidx
  have hPcard : Nat.card P = 9 := hR
  have hPidx : P.index = 2 ∨ P.index = 4 ∨ P.index = 8 := by
    have hm := (P : Subgroup H).card_mul_index
    rw [hPcard] at hm
    rcases hc with h | h | h <;> omega
  have hns : Nat.card (Sylow 3 H) = 1 ∨ Nat.card (Sylow 3 H) = 4 := by
    have hd := P.card_dvd_index
    have hm : Nat.card (Sylow 3 H) % 3 = 1 := card_sylow_modEq_one 3 H
    have hp : 0 < Nat.card (Sylow 3 H) := Nat.card_pos
    have hb : Nat.card (Sylow 3 H) ≤ 8 := by
      rcases hPidx with h | h | h <;> rw [h] at hd <;>
        exact (Nat.le_of_dvd (by decide) hd).trans (by decide)
    have hh : Nat.card (Sylow 3 H) = 1 ∨ Nat.card (Sylow 3 H) = 4 ∨ Nat.card (Sylow 3 H) = 7 := by omega
    rcases hh with hh | hh | hh
    · exact Or.inl hh
    · exact Or.inr hh
    · rw [hh] at hd
      rcases hPidx with hh | hh | hh <;> rw [hh] at hd <;> norm_num at hd
  rcases hns with hns | hns
  · have : Subsingleton (Sylow 3 H) := (Nat.card_eq_one_iff_unique.mp hns).1
    have hS : IsPGroup 3 (Subgroup.zpowers s) := IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hs]; exact (pow_one 3).symm)
    obtain ⟨Q, hQ⟩ := hS.exists_le_sylow
    have hsP : s ∈ (P : Subgroup H) := by
      rw [Subsingleton.elim P Q]
      exact hQ (Subgroup.mem_zpowers s)
    have hrP : r ∈ (P : Subgroup H) := Subgroup.mem_zpowers r
    have hh := orderOf_dvd_natCard (⟨r*s, (P : Subgroup H).mul_mem hrP hsP⟩ : P)
    rw [Subgroup.orderOf_mk, ht] at hh
    change 2 ∣ Nat.card (P : Subgroup H) at hh
    rw [hPcard] at hh
    norm_num at hh
  · let X := Sylow 3 H
    let alpha : H →* Equiv.Perm X := MulAction.toPermHom H X
    have hpperm : Nat.card (Equiv.Perm X) = 24 := by
      letI := Fintype.ofFinite X
      rw [Nat.card_eq_fintype_card, Fintype.card_perm, ← Nat.card_eq_fintype_card]
      change (Nat.card (Sylow 3 H)).factorial = 24
      rw [hns]; decide
    have hro3 : (alpha r)^3 = 1 := by
      have h9 : orderOf (alpha r) ∣ 9 := hr ▸ orderOf_map_dvd alpha r
      have h24 : orderOf (alpha r) ∣ 24 := hpperm ▸ orderOf_dvd_natCard (alpha r)
      have hd : orderOf (alpha r) ∣ 3 := by simpa using Nat.dvd_gcd h9 h24
      exact orderOf_dvd_iff_pow_eq_one.mp hd
    have hso3 : (alpha s)^3 = 1 := by
      rw [← map_pow]
      have hh : s^3 = 1 := hs ▸ pow_orderOf_eq_one s
      rw [hh, map_one]
    have hzker : r^3 ∈ alpha.ker := by simpa only [MonoidHom.mem_ker, map_pow] using hro3
    let I := alpha.range
    have htrans : MulAction.IsPretransitive I X := by
      haveI : MulAction.IsPretransitive H (Sylow 3 H) := Sylow.isPretransitive_of_finite
      constructor
      intro A B
      obtain ⟨g, hg⟩ := MulAction.exists_smul_eq H A B
      exact ⟨⟨alpha g, ⟨g, rfl⟩⟩, hg⟩
    have hi4 : 4 ∣ Nat.card I := by
      letI := htrans
      letI := Fintype.ofFinite I
      letI := Fintype.ofFinite X
      letI := Fintype.ofFinite (MulAction.orbit I P)
      letI := Fintype.ofFinite (MulAction.stabilizer I P)
      have hm := MulAction.card_orbit_mul_card_stabilizer_eq_card_group I P
      have ho : Fintype.card (MulAction.orbit I P) = 4 := by
        rw [← Nat.card_eq_fintype_card, MulAction.orbit_eq_univ, Nat.card_eq_fintype_card, Fintype.card_setUniv, ← Nat.card_eq_fintype_card]
        exact hns
      rw [ho] at hm
      simp only [← Nat.card_eq_fintype_card] at hm
      exact ⟨_, hm.symm⟩
    have hi24 : Nat.card I ∣ 24 := hpperm ▸ I.card_subgroup_dvd_card
    have hi3 : 3 ∣ Nat.card I := by
      have hnon : alpha r ≠ 1 ∨ alpha s ≠ 1 := by
        by_contra hh
        have hh' : alpha r = 1 ∧ alpha s = 1 := by simpa using hh
        have hker : alpha.ker = ⊤ := by
          apply top_unique
          rw [← hgen]
          apply (Subgroup.closure_le alpha.ker).2
          intro x hx
          simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
          rcases hx with rfl | rfl
          · exact hh'.1
          · exact hh'.2
        have hi1 : Nat.card I = 1 := by
          rw [← Subgroup.index_ker, hker, Subgroup.index_top]
        rw [hi1] at hi4
        norm_num at hi4
      rcases hnon with hn | hn
      · let a : I := ⟨alpha r, ⟨r, rfl⟩⟩
        have ha3 : a^3 = 1 := by apply Subtype.ext; exact hro3
        have ha1 : a ≠ 1 := by intro hh; exact hn (congrArg Subtype.val hh)
        have hao : orderOf a = 3 := by
          have hd := orderOf_dvd_of_pow_eq_one ha3
          have he := orderOf_eq_one_iff.not.mpr ha1
          exact ((Nat.dvd_prime (by decide : Nat.Prime 3)).mp hd).resolve_left he
        exact hao ▸ orderOf_dvd_natCard a
      · let a : I := ⟨alpha s, ⟨s, rfl⟩⟩
        have ha3 : a^3 = 1 := by apply Subtype.ext; exact hso3
        have ha1 : a ≠ 1 := by intro hh; exact hn (congrArg Subtype.val hh)
        have hao : orderOf a = 3 := by
          have hd := orderOf_dvd_of_pow_eq_one ha3
          have he := orderOf_eq_one_iff.not.mpr ha1
          exact ((Nat.dvd_prime (by decide : Nat.Prime 3)).mp hd).resolve_left he
        exact hao ▸ orderOf_dvd_natCard a
    have hi : Nat.card I = 12 ∨ Nat.card I = 24 := by
      have hb := Nat.le_of_dvd (by decide : 0 < 24) hi24
      have hp : 0 < Nat.card I := Nat.card_pos
      omega
    have hk : Nat.card alpha.ker = 3 ∨ Nat.card alpha.ker = 6 := by
      have hm := alpha.ker.card_mul_index
      rw [Subgroup.index_ker] at hm
      rcases hc with hc | hc | hc <;> rcases hi with hi | hi <;> rw [hi, hc] at hm <;> omega
    have hzord : orderOf (r^3) = 3 := by
      rw [orderOf_pow' _ (by decide : 3 ≠ 0), hr]; decide
    have hn := scratch_kernel_normality_application alpha.ker hk (r^3) hzord hzker
    apply scratch_normal_application r s hr _ _ hn
    · exact hs ▸ pow_orderOf_eq_one s
    · exact ht ▸ pow_orderOf_eq_one (r*s)

#print axioms result

set_option pp.universes true in
#check @result

end CycleNineThreeObstruction
