/-! Fixed spaces of prime-order subgroups and central involutions in special linear groups. -/

namespace ExtremalC48

open scoped Pointwise
open Module

section FixedRank

variable {G k V : Type*} [Group G] [Field k] [AddCommGroup V] [Module k V]

private theorem action_mul (ρ : Representation k G V) (g h : G) (v : V) :
    ρ (g * h) v = ρ g (ρ h v) := by
  rw [map_mul]
  rfl

/-- Conjugation of subgroups transports the corresponding fixed spaces by the
    ambient representation's action of the conjugating element. -/
def invariantsEquivConj (ρ : Representation k G V) (P Q : Subgroup G) (g : G)
    (h : MulAut.conj g • P = Q) :
    (Representation.invariants (ρ.comp P.subtype)) ≃ₗ[k] (Representation.invariants (ρ.comp Q.subtype)) := by
  subst Q
  let f (v : (Representation.invariants (ρ.comp P.subtype))) :
      (Representation.invariants (ρ.comp (MulAut.conj g • P).subtype)) :=
    ⟨ρ g v, by
      intro q
      obtain ⟨p, hp, he⟩ := (Subgroup.mem_smul_pointwise_iff_exists _ _ _).mp q.property
      change g * p * g⁻¹ = (q : G) at he
      change ρ (q : G) (ρ g v) = ρ g v
      rw [← he, ← action_mul, inv_mul_cancel_right, action_mul]
      have hv := v.property ⟨p, hp⟩
      change ρ p v = v at hv
      rw [hv]⟩
  let b (v : (Representation.invariants (ρ.comp (MulAut.conj g • P).subtype))) :
      (Representation.invariants (ρ.comp P.subtype)) :=
    ⟨ρ g⁻¹ v, by
      intro p
      let q : (MulAut.conj g • P : Subgroup G) := ⟨MulAut.conj g (p : G),
        Subgroup.smul_mem_pointwise_smul _ _ _ p.property⟩
      have hv := v.property q
      change ρ (g * (p : G) * g⁻¹) v = v at hv
      change ρ (p : G) (ρ g⁻¹ v) = ρ g⁻¹ v
      calc
        ρ (p : G) (ρ g⁻¹ v) = ρ ((p : G) * g⁻¹) v := (action_mul _ _ _ _).symm
        _ = ρ (g⁻¹ * (g * (p : G) * g⁻¹)) v := by congr 1; group
        _ = ρ g⁻¹ (ρ (g * (p : G) * g⁻¹) v) := action_mul _ _ _ _
        _ = ρ g⁻¹ v := by rw [hv]⟩
  exact {
    toFun := f
    invFun := b
    left_inv := fun v => Subtype.ext (by change ρ g⁻¹ (ρ g v) = v; rw [← action_mul, inv_mul_cancel]; simp)
    right_inv := fun v => Subtype.ext (by change ρ g (ρ g⁻¹ v) = v; rw [← action_mul, mul_inv_cancel]; simp)
    map_add' := fun v w => Subtype.ext (by change ρ g ((v : V) + w) = _; exact map_add _ _ _)
    map_smul' := fun a v => Subtype.ext (by change ρ g (a • (v : V)) = _; exact map_smul _ _ _) }

/-- If the group order is divisible by a prime exactly once, all cyclic
    subgroups of that prime order have linearly equivalent invariant spaces. -/
theorem primeOrder_fixedSpace_equiv (ρ : Representation k G V) [Finite G]
    (p : ℕ) [Fact p.Prime] (h : ¬ p ^ 2 ∣ Nat.card G)
    (x y : G) (hx : orderOf x = p) (hy : orderOf y = p) :
    Nonempty ((Representation.invariants (ρ.comp (Subgroup.zpowers x).subtype)) ≃ₗ[k]
      (Representation.invariants (ρ.comp (Subgroup.zpowers y).subtype))) := by
  have hp : p.Prime := Fact.out
  have hpd : p ∣ Nat.card G := hx ▸ orderOf_dvd_natCard x
  have hf : (Nat.card G).factorization p = 1 := by
    have h₁ := (hp.dvd_iff_one_le_factorization Nat.card_pos.ne').mp hpd
    have h₂ : ¬ 2 ≤ (Nat.card G).factorization p := fun h' =>
      h ((hp.pow_dvd_iff_le_factorization Nat.card_pos.ne').mpr h')
    omega
  let P := Sylow.ofCard (Subgroup.zpowers x) (p := p) (by rw [Nat.card_zpowers, hx, hf, pow_one])
  let Q := Sylow.ofCard (Subgroup.zpowers y) (p := p) (by rw [Nat.card_zpowers, hy, hf, pow_one])
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G P Q
  have hPQ : MulAut.conj g • Subgroup.zpowers x = Subgroup.zpowers y :=
    congrArg Sylow.toSubgroup hg
  exact ⟨invariantsEquivConj ρ _ _ g hPQ⟩

/-- The fixed space of the cyclic subgroup generated by an element equals the
    ordinary fixed space of that element. -/
theorem cyclic_invariants_eq_ker (ρ : Representation k G V) (x : G) :
    (Representation.invariants (ρ.comp (Subgroup.zpowers x).subtype)) = LinearMap.ker (ρ x - 1) := by
  ext v
  have hx : x ∈ Subgroup.zpowers x := Subgroup.mem_zpowers x
  let x' : Subgroup.zpowers x := ⟨x, hx⟩
  have hgen (z : Subgroup.zpowers x) : z ∈ Subgroup.zpowers x' := by
    obtain ⟨n, hn⟩ := z.property
    exact ⟨n, Subtype.ext (by simpa [x'] using hn)⟩
  rw [Representation.mem_invariants_iff_of_forall_mem_zpowers _ x' hgen]
  change ρ x v = v ↔ _
  simp [LinearMap.mem_ker, LinearMap.sub_apply, sub_eq_zero]

/-- A single prime-order witness supplies the fixed rank for every element of
    that order when the prime divides the group order only once. -/
theorem primeOrder_fixedRank_eq (ρ : Representation k G V) [Finite G]
    (p : ℕ) [Fact p.Prime] (h : ¬ p ^ 2 ∣ Nat.card G)
    (x y : G) (hx : orderOf x = p) (hy : orderOf y = p) :
    finrank k (LinearMap.ker (ρ x - 1)) = finrank k (LinearMap.ker (ρ y - 1)) := by
  obtain ⟨e⟩ := primeOrder_fixedSpace_equiv ρ p h x y hx hy
  rw [← cyclic_invariants_eq_ker ρ x, ← cyclic_invariants_eq_ker ρ y]
  exact e.finrank_eq

end FixedRank

section Involution

open Matrix

/-- A determinant-one two-by-two involution over a field of characteristic
    different from two is scalar. Use the explicit adjugate formula for its inverse. -/
theorem SL2_involution_scalar {k : Type*} [Field k] (h2 : (2 : k) ≠ 0)
    (A : SpecialLinearGroup (Fin 2) k) (hA : A ^ 2 = 1) :
    (A : Matrix (Fin 2) (Fin 2) k) = 1 ∨ (A : Matrix (Fin 2) (Fin 2) k) = -1 := by
  have hInv : A⁻¹ = A := by
    apply inv_eq_of_mul_eq_one_left
    simpa [pow_two] using hA
  have h := congrArg (fun B : SpecialLinearGroup (Fin 2) k => (B : Matrix (Fin 2) (Fin 2) k)) hInv
  rw [SpecialLinearGroup.coe_inv, Matrix.adjugate_fin_two] at h
  have hd : A.1 1 1 = A.1 0 0 := by
    simpa using congrArg (fun M : Matrix (Fin 2) (Fin 2) k => M 0 0) h
  have hb : -A.1 0 1 = A.1 0 1 := by
    simpa using congrArg (fun M : Matrix (Fin 2) (Fin 2) k => M 0 1) h
  have hc : -A.1 1 0 = A.1 1 0 := by
    simpa using congrArg (fun M : Matrix (Fin 2) (Fin 2) k => M 1 0) h
  have hb0 : A.1 0 1 = 0 := by
    apply (mul_eq_zero.mp (show (2 : k) * A.1 0 1 = 0 by linear_combination -hb)).resolve_left h2
  have hc0 : A.1 1 0 = 0 := by
    apply (mul_eq_zero.mp (show (2 : k) * A.1 1 0 = 0 by linear_combination -hc)).resolve_left h2
  have hdet := A.det_coe
  rw [Matrix.det_fin_two, hd, hb0, hc0, zero_mul, sub_zero] at hdet
  rcases mul_self_eq_one_iff.mp hdet with he | he
  · left
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hd, hb0, hc0, he]
  · right
    ext i j
    fin_cases i <;> fin_cases j <;> simp [hd, hb0, hc0, he]

/-- A nonidentity involution is central in the special linear group. -/
theorem SL2_orderTwo_negOne {k : Type*} [Field k] (h2 : (2 : k) ≠ 0)
    (A : SpecialLinearGroup (Fin 2) k) (hA : orderOf A = 2) :
    (A : Matrix (Fin 2) (Fin 2) k) = -1 ∧
      ∀ B : SpecialLinearGroup (Fin 2) k, Commute A B := by
  have hp : Fact (Nat.Prime 2) := ⟨by decide⟩
  have hsq := (orderOf_eq_prime_iff.mp hA)
  rcases SL2_involution_scalar h2 A hsq.1 with he | he
  · exact (hsq.2 (Subtype.ext he)).elim
  · refine ⟨he, fun B => ?_⟩
    apply Subtype.ext
    simp [SpecialLinearGroup.coe_mul, he]

end Involution

abbrev SL47 := Matrix.SpecialLinearGroup (Fin 2) (ZMod 47)

local instance : Fact (Nat.Prime 47) := ⟨by decide⟩
local instance : Fact (Nat.Prime 3) := ⟨by decide⟩
local instance : Fact (Nat.Prime 2) := ⟨by decide⟩

private theorem card_SL2_ZMod (p : ℕ) [Fact p.Prime] [NeZero p] :
    Nat.card (Matrix.SpecialLinearGroup (Fin 2) (ZMod p)) =
      ((p ^ 2 - 1) * (p ^ 2 - p)) / (p - 1) := by
  have h := Matrix.card_SL_field (𝔽 := ZMod p) 2
  simpa [Fin.prod_univ_two, ZMod.card] using h

theorem card_SL47 : Nat.card SL47 = 103776 := by
  calc
    Nat.card SL47 = ((47 ^ 2 - 1) * (47 ^ 2 - 47)) / (47 - 1) := card_SL2_ZMod 47
    _ = 103776 := by decide

/-- Transport Nebe's external fixed-rank input from any single order-three
    witness in the ambient group to every other order-three element. -/
theorem SL47_orderThree_fixedRank {k V : Type*} [Field k] [AddCommGroup V] [Module k V]
    (ρ : Representation k SL47 V) (x y : SL47) (hx : orderOf x = 3) (hy : orderOf y = 3)
    (hNebe : finrank k (LinearMap.ker (ρ x - 1)) = 16) :
    finrank k (LinearMap.ker (ρ y - 1)) = 16 := by
  rw [← hNebe]
  symm
  exact primeOrder_fixedRank_eq ρ 3 (by rw [card_SL47]; decide) x y hx hy

/-- A complex irreducible representation of degree divisible by six forces
    elements of orders two and three in the finite group. -/
theorem degree_forces_orders {G W : Type*} [Group G] [Finite G] [AddCommGroup W]
    [Module ℂ W] [FiniteDimensional ℂ W] (σ : Representation ℂ G W) [σ.IsIrreducible]
    (hW : 6 ∣ finrank ℂ W) : ∃ a b : G, orderOf a = 2 ∧ orderOf b = 3 := by
  have hd := D5.S3.FiniteGroups.CharacterDegreeDivisibility.TauCeti.Representation.finrank_dvd_card σ
  have h6 : 6 ∣ Nat.card G := dvd_trans hW hd
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' 2 (dvd_trans (by decide : 2 ∣ 6) h6)
  obtain ⟨b, hb⟩ := exists_prime_orderOf_dvd_card' 3 (dvd_trans (by decide : 3 ∣ 6) h6)
  exact ⟨a, b, ha, hb⟩

/-- Any faithful embedding into SL₂ over a field of odd characteristic makes
    the involution forced by the complex degree central. -/
theorem subgroup_witnesses {G W k : Type*} [Group G] [Finite G] [AddCommGroup W]
    [Module ℂ W] [FiniteDimensional ℂ W] [Field k] (h2 : (2 : k) ≠ 0)
    (ι : G →* Matrix.SpecialLinearGroup (Fin 2) k) (hι : Function.Injective ι)
    (σ : Representation ℂ G W) [σ.IsIrreducible]
    (hW : finrank ℂ W = 24 ∨ finrank ℂ W = 48) :
    ∃ a b : G, orderOf a = 2 ∧ orderOf b = 3 ∧
      (ι a : Matrix (Fin 2) (Fin 2) k) = -1 ∧ Commute a b := by
  have h6 : 6 ∣ finrank ℂ W := by
    rcases hW with h | h
    · rw [h]; decide
    · rw [h]; decide
  obtain ⟨a, b, ha, hb⟩ := degree_forces_orders σ h6
  have ha' : orderOf (ι a) = 2 := (orderOf_injective ι hι a).trans ha
  obtain ⟨hn, hc⟩ := SL2_orderTwo_negOne h2 (ι a) ha'
  refine ⟨a, b, ha, hb, hn, ?_⟩
  apply hι
  simpa only [map_mul] using (hc (ι b)).eq

/-- The two forced subgroup elements have commuting lifts, and the order-three
    element has the fixed rank specified by Nebe's ambient witness. -/
theorem lifted_subgroup_obstruction {G L W V : Type*} [Group G] [Finite G] [Group L]
    [AddCommGroup W] [Module ℂ W] [FiniteDimensional ℂ W]
    [AddCommGroup V] [Module ℝ V]
    (ι : G →* SL47) (hι : Function.Injective ι) (lift : G →* L)
    (σ : Representation ℂ G W) [σ.IsIrreducible]
    (hW : finrank ℂ W = 24 ∨ finrank ℂ W = 48)
    (ρ : Representation ℝ SL47 V) (x : SL47) (hx : orderOf x = 3)
    (hNebe : finrank ℝ (LinearMap.ker (ρ x - 1)) = 16) :
    ∃ a b : G, orderOf a = 2 ∧ orderOf b = 3 ∧
      (ι a : Matrix (Fin 2) (Fin 2) (ZMod 47)) = -1 ∧
      Commute (lift a) (lift b) ∧ finrank ℝ (LinearMap.ker (ρ (ι b) - 1)) = 16 := by
  obtain ⟨a, b, ha, hb, hn, hc⟩ := subgroup_witnesses (by decide : (2 : ZMod 47) ≠ 0) ι hι σ hW
  have hb' : orderOf (ι b) = 3 := (orderOf_injective ι hι b).trans hb
  exact ⟨a, b, ha, hb, hn, hc.map lift, SL47_orderThree_fixedRank ρ x (ι b) hx hb' hNebe⟩

end ExtremalC48

