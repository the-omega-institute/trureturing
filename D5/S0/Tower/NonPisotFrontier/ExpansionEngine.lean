/- GID: D5/S0/Tower/NonPisotFrontier/ExpansionEngine
   generality: I
   mirror-B: D5/B/S0/Tower/NonPisotFrontier/ExpansionEngine
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   digest: Multiplying by the frontier base is an integer map on its coordinate pair. -/

import D5.S0.Tower.NonPisotFrontier.BetaThirteen

/- Library-search audit trail (2026-08-18):
   * Repository search found no beta-expansion machinery for bases outside the
     d-bonacci family; the frontier base needs its own, and this module supplies
     only the algebraic step, not the expansion itself.
   * Pinned Mathlib has no beta-expansion development to reuse, so the step is
     derived directly from the quadratic satisfied by the base. -/

namespace D5.S0.Tower.NonPisotFrontier.ExpansionEngine

open D5.S0.Tower.NonPisotFrontier.BetaThirteen

local notation "β" => betaThirteen

/-- Every element of the ring generated by the frontier base is `p + q β` for a
unique integer pair.  Multiplying by the base is then the integer map
`(p, q) ↦ (3 q, p + q)`, because the base squares to itself plus three. -/
theorem beta_mul_coordinates (p q : Real) :
    β * (p + q * β) = 3 * q + (p + q) * β := by
  have hq := betaThirteen_quadratic
  have hexpand : β * (p + q * β) = p * β + q * β ^ 2 := by ring
  rw [hexpand, hq]; ring

/-- Subtracting a digit keeps the pair integral, so one greedy step is
`(p, q) ↦ (3 q - d, p + q)`. -/
theorem beta_step_coordinates (p q d : Real) :
    β * (p + q * β) - d = (3 * q - d) + (p + q) * β := by
  rw [beta_mul_coordinates]; ring

/-- The base lies strictly between two and three, so the first greedy digit of
one is two. -/
theorem betaThirteen_lt_three : β < 3 := by
  have h := sqrt_thirteen_bounds.2
  simp only [betaThirteen]
  linarith

theorem betaThirteen_first_remainder :
    β - 2 = (-2 : Real) + 1 * β := by ring

theorem betaThirteen_first_remainder_mem : 0 < β - 2 ∧ β - 2 < 1 := by
  have hlo := two_lt_betaThirteen
  have hhi := sqrt_thirteen_bounds.2
  constructor
  · linarith
  · simp only [betaThirteen]; linarith

/-- The second coordinate pair, obtained by one application of the step with
digit zero.  Its value lies in the unit interval, which is what makes the digit
zero correct. -/
theorem betaThirteen_second_remainder :
    β * (β - 2) = 3 + (-1 : Real) * β := by
  have hq := betaThirteen_quadratic
  have hexpand : β * (β - 2) = β ^ 2 - 2 * β := by ring
  rw [hexpand, hq]; ring

theorem betaThirteen_second_remainder_mem :
    0 < 3 - β ∧ 3 - β < 1 := by
  have hlo := betaThirteen_lt_three
  have hhi := two_lt_betaThirteen
  constructor <;> linarith

/-- The engine, stated as one proposition: the multiplication rule, the greedy
step, and the two facts that pin the first two digits at two and zero. -/
theorem frontier_expansion_engine :
    (∀ p q : Real, β * (p + q * β) = 3 * q + (p + q) * β) ∧
      (2 < β ∧ β < 3) ∧
      (0 < β - 2 ∧ β - 2 < 1) ∧
      (0 < 3 - β ∧ 3 - β < 1) :=
  ⟨beta_mul_coordinates, ⟨two_lt_betaThirteen, betaThirteen_lt_three⟩,
    betaThirteen_first_remainder_mem, betaThirteen_second_remainder_mem⟩

end D5.S0.Tower.NonPisotFrontier.ExpansionEngine
