   generality: G
   mirror-B: D5/B/S0/Computability/Coding/PrefixHull
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: Finite prefix bases and exact coefficients for least right-unitary word monoids. -/

module

public import Mathlib.Data.List.Basic
public import Mathlib.Data.Fin.Tuple.Basic
public import Mathlib.Algebra.Order.BigOperators.Group.Finset

/-! Least right-unitary submonoids generated by finite labelled word families. -/

public section

namespace D5.S0.Computability.Coding.PrefixHull

open scoped BigOperators

universe u

private def Admissible {α : Type u} {n : ℕ}
    (f : Fin n → List α) (M : Set (List α)) : Prop :=
  [] ∈ M ∧
    (∀ x y, x ∈ M → y ∈ M → x ++ y ∈ M) ∧
    (∀ x y, x ∈ M → x ++ y ∈ M → y ∈ M) ∧
    ∀ i, f i ∈ M

/-- The reduction preserves membership in every admissible containing monoid. -/
private theorem reduce_generators {α : Type u} {n : ℕ} (f : Fin n → List α) :
    ∃ m : ℕ, m ≤ n ∧ ∃ g : Fin m → List α,
      ∃ c : Fin n → List (Fin m),
        (∀ i, g i ≠ []) ∧
        (∀ i j, List.IsPrefix (g i) (g j) → i = j) ∧
        (∀ i, f i = (c i).flatMap g) ∧
        ∀ M, Admissible f M → ∀ i, g i ∈ M := by
  classical
  induction n with
  | zero =>
    refine ⟨0, le_rfl, Fin.elim0, Fin.elim0, ?_, ?_, ?_, ?_⟩
    · intro i
      exact Fin.elim0 i
    · intro i
      exact Fin.elim0 i
    · intro i
      exact Fin.elim0 i
    · intro M hM i
      exact Fin.elim0 i
  | succ n outer =>
    suffices ∀ k : ℕ, ∀ h : Fin (n + 1) → List α,
        (∑ i, (h i).length) = k →
        ∃ m : ℕ, m ≤ n + 1 ∧ ∃ g : Fin m → List α,
          ∃ c : Fin (n + 1) → List (Fin m),
            (∀ i, g i ≠ []) ∧
            (∀ i j, List.IsPrefix (g i) (g j) → i = j) ∧
            (∀ i, h i = (c i).flatMap g) ∧
            ∀ M, Admissible h M → ∀ i, g i ∈ M from
      this _ f rfl
    intro k
    induction k using Nat.strong_induction_on with
    | h k inner =>
      intro h hlen
      by_cases hz : ∃ z, h z = []
      · obtain ⟨z, hz⟩ := hz
        obtain ⟨m, hm, g, c, hne, hp, hc, hM⟩ :=
          outer (fun a => h (z.succAbove a))
        refine ⟨m, Nat.le_trans hm (Nat.le_succ n), g, Fin.insertNth z [] c,
          hne, hp, ?_, ?_⟩
        · intro a
          refine Fin.succAboveCases z ?_ (fun b => ?_) a
          · simpa using hz
          · simpa using hc b
        · intro M hcont
          exact hM M ⟨hcont.1, hcont.2.1, hcont.2.2.1,
            fun a => hcont.2.2.2 (z.succAbove a)⟩
      · have hne : ∀ i, h i ≠ [] := by simpa using hz
        by_cases hp : ∀ i j, List.IsPrefix (h i) (h j) → i = j
        · refine ⟨n + 1, le_rfl, h, (fun i => [i]), hne, hp, ?_, ?_⟩
          · intro i
            simp
          · intro M hM
            exact hM.2.2.2
        · have hpair : ∃ i j, List.IsPrefix (h i) (h j) ∧ i ≠ j := by
            simpa only [not_forall, not_imp, exists_prop] using hp
          obtain ⟨i, j, hij, hneij⟩ := hpair
          obtain ⟨r, hr⟩ := hij
          let q := Function.update h j r
          let σ : Fin (n + 1) → List (Fin (n + 1)) :=
            fun a => if a = j then [i, j] else [a]
          have hq : ∀ a, h a = (σ a).flatMap q := by
            intro a
            by_cases haj : a = j
            · subst a
              simpa [σ, q, hneij] using hr.symm
            · simp [σ, q, haj]
          have hshort : (∑ a, (q a).length) < k := by
            rw [← hlen]
            apply Finset.sum_lt_sum
            · intro a _
              by_cases haj : a = j
              · subst a
                simp only [q, Function.update_self]
                rw [← hr, List.length_append]
                omega
              · simp [q, haj]
            · refine ⟨j, Finset.mem_univ j, ?_⟩
              simp only [q, Function.update_self]
              have hi : 0 < (h i).length := List.length_pos_iff_ne_nil.mpr (hne i)
              rw [← hr, List.length_append]
              omega
          obtain ⟨m, hm, g, c, hgne, hgp, hc, hM⟩ := inner _ hshort q rfl
          refine ⟨m, hm, g, (fun a => (σ a).flatMap c), hgne, hgp, ?_, ?_⟩
          · intro a
            rw [hq a, List.flatMap_assoc]
            exact List.flatMap_congr (fun b _ => hc b)
          · intro M hcont
            apply hM M
            refine ⟨hcont.1, hcont.2.1, hcont.2.2.1, ?_⟩
            intro a
            by_cases haj : a = j
            · subst a
              have hrM : r ∈ M := hcont.2.2.1 (h i) r
                (hcont.2.2.2 i) (by rw [hr]; exact hcont.2.2.2 j)
              simpa [q] using hrM
            · simpa [q, haj] using hcont.2.2.2 a

/-- Cancellation of an arbitrary word suffix, rather than only of another codeword string. -/
private theorem prefix_language_suffix {α : Type u} {m : ℕ}
    (g : Fin m → List α) (hne : ∀ i, g i ≠ [])
    (hp : ∀ i j, List.IsPrefix (g i) (g j) → i = j)
    (s t : List (Fin m)) (y : List α)
    (h : s.flatMap g ++ y = t.flatMap g) :
    ∃ r : List (Fin m), y = r.flatMap g := by
  induction s generalizing t with
  | nil =>
    exact ⟨t, by simpa using h⟩
  | cons i s ih =>
    cases t with
    | nil =>
      have hz : (g i ++ s.flatMap g) ++ y = [] := by simpa using h
      exact (hne i ((List.append_eq_nil_iff.mp
        (List.append_eq_nil_iff.mp hz).1).1)).elim
    | cons j t =>
      have hleft : List.IsPrefix (g i) (g j ++ t.flatMap g) :=
        ⟨s.flatMap g ++ y, by
          simpa only [List.flatMap_cons, List.append_assoc] using h⟩
      have hright : List.IsPrefix (g j) (g j ++ t.flatMap g) :=
        List.prefix_append _ _
      have hij : i = j := by
        rcases List.prefix_or_prefix_of_prefix hleft hright with hpre | hpre
        · exact hp i j hpre
        · exact (hp j i hpre).symm
      subst j
      apply ih t
      exact List.append_cancel_left (by
        simpa only [List.flatMap_cons, List.append_assoc] using h)

/-- The literal intersection of all containing right-unitary submonoids has a finite
prefix-separated basis of nonempty words, with exact coefficients and at most the input label count. -/
theorem finite_prefix_basis_least_right_unitary_hull
    {α : Type u} {n : ℕ} (f : Fin n → List α) :
    let H : Set (List α) := {w | ∀ M : Set (List α),
      [] ∈ M →
      (∀ x y, x ∈ M → y ∈ M → x ++ y ∈ M) →
      (∀ x y, x ∈ M → x ++ y ∈ M → y ∈ M) →
      (∀ i, f i ∈ M) → w ∈ M}
    ∃ m : ℕ, m ≤ n ∧ ∃ g : Fin m → List α,
      ∃ c : Fin n → List (Fin m),
        (∀ i, g i ≠ []) ∧
        (∀ i j, List.IsPrefix (g i) (g j) → i = j) ∧
        (∀ i, f i = (c i).flatMap g) ∧
        ∀ w : List α, w ∈ H ↔ ∃ s : List (Fin m), w = s.flatMap g := by
  dsimp only
  obtain ⟨m, hm, g, c, hne, hp, hc, hmem⟩ := reduce_generators f
  refine ⟨m, hm, g, c, hne, hp, hc, ?_⟩
  intro w
  constructor
  · intro hw
    let L : Set (List α) := {v | ∃ s : List (Fin m), v = s.flatMap g}
    apply hw L
    · exact ⟨[], rfl⟩
    · rintro x y ⟨s, rfl⟩ ⟨t, rfl⟩
      exact ⟨s ++ t, by simp only [List.flatMap_append]⟩
    · rintro x y ⟨s, rfl⟩ ⟨t, ht⟩
      exact prefix_language_suffix g hne hp s t y ht
    · intro i
      exact ⟨c i, hc i⟩
  · rintro ⟨s, rfl⟩ M hnil hmul hru hf
    have hg : ∀ i, g i ∈ M := hmem M ⟨hnil, hmul, hru, hf⟩
    induction s with
    | nil => exact hnil
    | cons i s ih =>
      simpa only [List.flatMap_cons] using hmul (g i) (s.flatMap g) (hg i) ih

end D5.S0.Computability.Coding.PrefixHull
