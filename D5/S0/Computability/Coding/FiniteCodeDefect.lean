/- GID: D5/S0/Computability/Coding/FiniteCodeDefect
   generality: G
   mirror-B: D5/B/S0/Computability/Coding/FiniteCodeDefect
   mirror-E: none(waiver:evidence-not-specified-by-formal-manifest)
   anchors: []
   utility: none
   digest: A noninjective finite labelled word morphism factors through fewer generators. -/

import D5.S0.Computability.Coding.PrefixFreeCode
import Mathlib.Data.Fin.Tuple.Basic

namespace D5.S0.Computability.Coding.FiniteCodeDefect

open PrefixFreeCode
open scoped BigOperators

universe u

private theorem labelled_decoding {β : Type*} {α : Type*} (f : β → List α)
    (hf : Function.Injective f)
    (hd : InformationTheory.UniquelyDecodable (Set.range f)) :
    Function.Injective (fun s : List β => s.flatMap f) := by
  intro s t h
  apply List.map_injective_iff.mpr hf
  apply hd
  · intro w hw
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hw
    exact ⟨i, rfl⟩
  · intro w hw
    obtain ⟨i, _, rfl⟩ := List.mem_map.mp hw
    exact ⟨i, rfl⟩
  · simpa only [List.flatten_map] using h

private theorem prefix_pair {n : ℕ} (f : Fin n → List α)
    (hne : ∀ i, f i ≠ [])
    (hamb : ¬ Function.Injective (fun s : List (Fin n) => s.flatMap f)) :
    ∃ i j, i ≠ j ∧ f i <+: f j := by
  classical
  by_contra h
  have hp : ∀ i j, f i <+: f j → i = j := by
    intro i j hij
    by_contra hn
    exact h ⟨i, j, hn, hij⟩
  apply hamb
  apply labelled_decoding f
  · intro i j hij
    exact hp i j (hij ▸ List.prefix_refl (f i))
  · apply uniquelyDecodable_of_isPrefixFree
    · rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ hij
      rw [hp i j hij]
    · rintro ⟨i, hi⟩
      exact hne i hi

private theorem substitution_injective {n : ℕ} (i j : Fin n) :
    Function.Injective (fun s : List (Fin n) =>
      s.flatMap (fun k => if k = j then [i,j] else [k])) := by
  classical
  let σ : Fin n → List (Fin n) := fun k => if k = j then [i,j] else [k]
  have last : ∀ k, (σ k).getLast? = some k := by
    intro k
    by_cases h : k = j <;> simp [σ, h]
  have inj : Function.Injective σ := by
    intro a b hab
    have := congrArg List.getLast? hab
    simpa only [last, Option.some.injEq] using this
  apply labelled_decoding σ inj
  apply uniquelyDecodable_of_isSuffixFree
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩ ⟨t, ht⟩
    have he := congrArg List.getLast? ht
    have hn : σ a ≠ [] := by
      intro hz
      have := last a
      simp [hz] at this
    have hab : a = b := by
      rw [List.getLast?_append_of_ne_nil t hn, last, last] at he
      exact Option.some.inj he
    rw [hab]
  · rintro ⟨k, hk⟩
    have := last k
    simp [hk] at this

/-- A finite labelled family with ambiguous concatenations is generated by fewer words. -/
theorem finite_code_defect {α : Type u} {n : ℕ} (f : Fin n → List α)
    (hamb : ¬ Function.Injective (fun s : List (Fin n) => s.flatMap f)) :
    ∃ m : ℕ, m < n ∧ ∃ g : Fin m → List α,
      ∃ c : Fin n → List (Fin m), ∀ i, f i = (c i).flatMap g := by
  classical
  suffices ∀ k : ℕ, ∀ h : Fin n → List α,
      (∑ i, (h i).length) = k →
      ¬ Function.Injective (fun s : List (Fin n) => s.flatMap h) →
      ∃ m : ℕ, m < n ∧ ∃ g : Fin m → List α,
        ∃ c : Fin n → List (Fin m), ∀ i, h i = (c i).flatMap g from
    this _ f rfl hamb
  intro k
  induction k using Nat.strong_induction_on with
  | h k ih =>
    intro h hlen ha
    by_cases hz : ∃ z, h z = []
    · obtain ⟨z, hz⟩ := hz
      cases n with
      | zero => exact Fin.elim0 z
      | succ n =>
        refine ⟨n, Nat.lt_succ_self n, (fun a => h (z.succAbove a)),
          Fin.insertNth z [] (fun a => [a]), ?_⟩
        intro a
        refine Fin.succAboveCases z ?_ (fun b => ?_) a
        · simpa using hz
        · simp
    · have hne : ∀ i, h i ≠ [] := by simpa using hz
      obtain ⟨i, j, hij, r, hr⟩ := prefix_pair h hne ha
      let q := Function.update h j r
      let σ : Fin n → List (Fin n) := fun a => if a = j then [i,j] else [a]
      have hq : ∀ a, h a = (σ a).flatMap q := by
        intro a
        by_cases haj : a = j
        · subst a
          simpa [σ, q, hij] using hr.symm
        · simp [σ, q, haj]
      have htransport : ∀ s : List (Fin n), s.flatMap h = (s.flatMap σ).flatMap q := by
        intro s
        rw [List.flatMap_assoc]
        exact List.flatMap_congr (fun a _ => hq a)
      have hqa : ¬ Function.Injective (fun s : List (Fin n) => s.flatMap q) := by
        intro hqi
        apply ha
        intro s t hst
        apply substitution_injective i j
        apply hqi
        rw [← htransport, ← htransport, hst]
      have hshort : (∑ a, (q a).length) < k := by
        rw [← hlen]
        apply Finset.sum_lt_sum
        · intro a _
          by_cases haj : a = j
          · subst a
            simp only [q, Function.update_same]
            rw [← hr, List.length_append]
            omega
          · simp [q, haj]
        · refine ⟨j, Finset.mem_univ j, ?_⟩
          simp only [q, Function.update_same]
          have hi : 0 < (h i).length := List.length_pos_iff_ne_nil.mpr (hne i)
          rw [← hr, List.length_append]
          omega
      obtain ⟨m, hm, g, c, hc⟩ := ih _ hshort q rfl hqa
      refine ⟨m, hm, g, (fun a => (σ a).flatMap c), ?_⟩
      intro a
      rw [hq a, List.flatMap_assoc]
      exact List.flatMap_congr (fun b _ => hc b)

end D5.S0.Computability.Coding.FiniteCodeDefect
