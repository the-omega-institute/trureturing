import Mathlib.Algebra.Group.End
import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Algebra.Ring.Parity
import Mathlib.Combinatorics.SimpleGraph.Acyclic
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected
import Mathlib.Logic.Equiv.Basic
import Lean.Elab.Tactic.Omega

namespace PrefixReversalTripleOddNonGeneration

/-- The zero-based prefix reversal formula, before packaging it as a permutation. -/
def reverseIndex {n : ℕ} (L : ℕ) (hL : L ≤ n) (i : Fin n) : Fin n :=
  if hi : i.val < L then ⟨L - 1 - i.val, by omega⟩ else i

/-- Reflecting twice restores the index, including the fixed part of the domain. -/
theorem reverseIndex_involutive {n L : ℕ} (hL : L ≤ n) :
    Function.Involutive (reverseIndex L hL) := by
  intro i
  by_cases hi : i.val < L
  · have hj : L - 1 - i.val < L := by omega
    apply Fin.ext
    simp only [reverseIndex, dif_pos hi, dif_pos hj]
    omega
  · simp only [reverseIndex, dif_neg hi]

/-- Prefix reversal of length `L` as a permutation of the `n` positions. -/
def prefixReversal {n : ℕ} (L : ℕ) (hL : L ≤ n) : Equiv.Perm (Fin n) :=
  (reverseIndex_involutive hL).toPerm (reverseIndex L hL)

/-- The exchanged pairs are graph edges on positions, not additional group generators. -/
def auxiliaryGraph (n m k : ℕ) : SimpleGraph (Fin n) where
  Adj i j := i ≠ j ∧ ∃ L ∈ ({n, m, k} : Set ℕ),
    i.val < L ∧ i.val + j.val = L - 1
  symm := ⟨by
    rintro i j ⟨hij, L, hL, hi, hs⟩
    exact ⟨hij.symm, L, hL, by omega, by omega⟩⟩
  loopless := ⟨fun i h => h.1 rfl⟩

/-- Every edge is represented by its length and the smaller of its endpoints. -/
theorem auxiliaryGraph_edge_bound {n m k : ℕ} (hm : m ≤ n) (hk : k ≤ n) :
    Nat.card (auxiliaryGraph n m k).edgeSet ≤ n / 2 + m / 2 + k / 2 := by
  classical
  let pairs (L : ℕ) (hL : L ≤ n) : Finset (Sym2 (Fin n)) :=
    Finset.univ.image (fun i : Fin (L / 2) =>
      s((⟨i.val, by omega⟩ : Fin n), (⟨L - 1 - i.val, by omega⟩ : Fin n)))
  have pairs_card (L : ℕ) (hL : L ≤ n) : (pairs L hL).card ≤ L / 2 := by
    dsimp [pairs]
    exact Finset.card_image_le.trans_eq (by simp)
  have mem_pairs {L : ℕ} (hL : L ≤ n) {i j : Fin n}
      (hij : i ≠ j) (hi : i.val < L) (hs : i.val + j.val = L - 1) :
      s(i, j) ∈ pairs L hL := by
    have hval : i.val ≠ j.val := fun h => hij (Fin.ext h)
    by_cases hlt : i.val < j.val
    · have hit : i.val < L / 2 := by omega
      apply Finset.mem_image.mpr
      refine ⟨⟨i.val, hit⟩, Finset.mem_univ _, ?_⟩
      apply congrArg₂ Sym2.mk
      · exact Fin.ext rfl
      · apply Fin.ext
        dsimp
        omega
    · have hjt : j.val < L / 2 := by omega
      rw [Sym2.eq_swap (a := i) (b := j)]
      apply Finset.mem_image.mpr
      refine ⟨⟨j.val, hjt⟩, Finset.mem_univ _, ?_⟩
      apply congrArg₂ Sym2.mk
      · exact Fin.ext rfl
      · apply Fin.ext
        dsimp
        omega
  have hcover : (auxiliaryGraph n m k).edgeFinset ⊆
      pairs n le_rfl ∪ pairs m hm ∪ pairs k hk := by
    intro e
    refine Sym2.inductionOn e ?_
    intro i j he
    have hadj : (auxiliaryGraph n m k).Adj i j :=
      SimpleGraph.mem_edgeFinset.mp he
    rcases hadj with ⟨hij, L, hL, hi, hs⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hL
    simp only [Finset.mem_union]
    rcases hL with rfl | rfl | rfl
    · exact Or.inl (Or.inl (mem_pairs le_rfl hij hi hs))
    · exact Or.inl (Or.inr (mem_pairs hm hij hi hs))
    · exact Or.inr (mem_pairs hk hij hi hs)
  rw [Nat.card_eq_fintype_card, ← SimpleGraph.edgeFinset_card]
  calc
    (auxiliaryGraph n m k).edgeFinset.card ≤
        (pairs n le_rfl ∪ pairs m hm ∪ pairs k hk).card := Finset.card_mono hcover
    _ ≤ (pairs n le_rfl).card + (pairs m hm).card + (pairs k hk).card :=
      (Finset.card_union_le _ _).trans
        (Nat.add_le_add_right (Finset.card_union_le _ _) _)
    _ ≤ n / 2 + m / 2 + k / 2 := by
      have hn' := pairs_card n le_rfl
      have hm' := pairs_card m hm
      have hk' := pairs_card k hk
      omega

/-- The subgroup generated by exactly the three prefix reversals. -/
def tripleSubgroup (n m k : ℕ) (hm : m ≤ n) (hk : k ≤ n) :
    Subgroup (Equiv.Perm (Fin n)) :=
  Subgroup.closure {prefixReversal n le_rfl, prefixReversal m hm, prefixReversal k hk}

/-- Every generated permutation preserves each component; inverses give preservation onto it. -/
theorem tripleSubgroup_preserves_components {n m k : ℕ} (hm : m ≤ n) (hk : k ≤ n)
    {g : Equiv.Perm (Fin n)} (hg : g ∈ tripleSubgroup n m k hm hk) :
    ∀ i, (auxiliaryGraph n m k).connectedComponentMk (g i) =
      (auxiliaryGraph n m k).connectedComponentMk i := by
  let G := auxiliaryGraph n m k
  have generator (L : ℕ) (hL : L ≤ n) (hmem : L ∈ ({n, m, k} : Set ℕ)) (i : Fin n) :
      G.connectedComponentMk (prefixReversal L hL i) = G.connectedComponentMk i := by
    apply SimpleGraph.ConnectedComponent.sound
    apply SimpleGraph.Reachable.symm
    by_cases hfix : prefixReversal L hL i = i
    · rw [hfix]
    · apply SimpleGraph.Adj.reachable
      have hi : i.val < L := by
        by_contra hge
        apply hfix
        change reverseIndex L hL i = i
        simp only [reverseIndex, dif_neg hge]
      refine ⟨Ne.symm hfix, L, hmem, hi, ?_⟩
      change i.val + (reverseIndex L hL i).val = L - 1
      simp only [reverseIndex, dif_pos hi]
      omega
  change g ∈ Subgroup.closure _ at hg
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
      rcases hg with rfl | rfl | rfl
      · exact generator n le_rfl (by simp)
      · exact generator m hm (by simp)
      · exact generator k hk (by simp)
  | one =>
      intro i
      rfl
  | mul g h _ _ hg hh =>
      intro i
      exact (hg (h i)).trans (hh i)
  | inv g _ hg =>
      intro i
      simpa only [Equiv.Perm.inv_def, Equiv.apply_symm_apply] using (hg (g.symm i)).symm

/-- A disconnected position graph excludes a transposition, so the subgroup is proper. -/
theorem tripleSubgroup_ne_top_of_not_connected {n m k : ℕ}
    (hn : 0 < n) (hm : m ≤ n) (hk : k ≤ n)
    (hdisc : ¬(auxiliaryGraph n m k).Connected) :
    tripleSubgroup n m k hm hk ≠ ⊤ := by
  classical
  intro htop
  apply hdisc
  let u : Fin n := ⟨0, hn⟩
  apply (SimpleGraph.connected_iff_exists_forall_reachable _).mpr
  refine ⟨u, fun v => ?_⟩
  have hswap : Equiv.swap u v ∈ tripleSubgroup n m k hm hk := by
    rw [htop]
    trivial
  have hcomp := tripleSubgroup_preserves_components hm hk hswap u
  rw [Equiv.swap_apply_left] at hcomp
  exact SimpleGraph.ConnectedComponent.exact hcomp.symm

/-- Conjecture 4, first clause for odd `n`: if `2 ≤ k < m < n` and `m + k < n - 1`,
the three prefix reversals generate a proper subgroup of the symmetric group on `Fin n`. -/
theorem odd_prefix_reversal_triple_ne_top {n m k : ℕ}
    (hk : 2 ≤ k) (hkm : k < m) (hmn : m < n) (hodd : Odd n)
    (hsmall : m + k < n - 1) :
    tripleSubgroup n m k (Nat.le_of_lt hmn) (Nat.le_of_lt (hkm.trans hmn)) ≠ ⊤ := by
  apply tripleSubgroup_ne_top_of_not_connected (by omega)
  intro hconn
  have hlower := hconn.card_vert_le_card_edgeSet_add_one
  rw [Nat.card_fin] at hlower
  have hupper := auxiliaryGraph_edge_bound (Nat.le_of_lt hmn)
    (Nat.le_of_lt (hkm.trans hmn))
  obtain ⟨a, ha⟩ := hodd
  omega

#print axioms odd_prefix_reversal_triple_ne_top

end PrefixReversalTripleOddNonGeneration
