import Mathlib.GroupTheory.Torsion
import Mathlib.Algebra.Group.Pointwise.Finset.Basic

set_option autoImplicit false
set_option relaxedAutoImplicit false

open scoped Pointwise

namespace D5.S0.Certificates.Groups.MohanNeetuSmallDoublingRefutation

/-- `Z semidirect Z` with `(r, n)(s, m) = (r + (-1)^n s, n + m)`: the
paper's section 5 law at `q = -1`, also known as `BS(1, -1)` or the Klein
bottle group. For `n : Z`, `(-1)^n` is represented by `Int.negOnePow n`. -/
@[ext]
structure KleinBottleGroup where
  r : ℤ
  n : ℤ
  deriving DecidableEq

private def kleinBottleMul (a b : KleinBottleGroup) : KleinBottleGroup :=
  ⟨a.r + (a.n.negOnePow : ℤ) * b.r, a.n + b.n⟩

private def kleinBottleInv (a : KleinBottleGroup) : KleinBottleGroup :=
  ⟨-((a.n.negOnePow : ℤ) * a.r), -a.n⟩

/-- The group law, identity, and inverse for the Klein bottle group. -/
instance instGroupKleinBottleGroup : Group KleinBottleGroup where
  mul := kleinBottleMul
  one := ⟨0, 0⟩
  inv := kleinBottleInv
  mul_assoc := by
    rintro ⟨ar, an⟩ ⟨br, bn⟩ ⟨cr, cn⟩
    ext
    · change ar + (an.negOnePow : ℤ) * br +
          ((an + bn).negOnePow : ℤ) * cr =
        ar + (an.negOnePow : ℤ) *
          (br + (bn.negOnePow : ℤ) * cr)
      rw [Int.negOnePow_add]
      push_cast
      ring
    · change an + bn + cn = an + (bn + cn)
      omega
  one_mul := by
    intro a
    ext
    · change 0 + (Int.negOnePow 0 : ℤ) * a.r = a.r
      simp
    · change 0 + a.n = a.n
      omega
  mul_one := by
    intro a
    ext
    · change a.r + (a.n.negOnePow : ℤ) * 0 = a.r
      ring
    · change a.n + 0 = a.n
      omega
  inv_mul_cancel := by
    intro a
    ext
    · change -((a.n.negOnePow : ℤ) * a.r) +
          ((-a.n).negOnePow : ℤ) * a.r = 0
      rw [Int.negOnePow_neg]
      ring
    · change -a.n + a.n = 0
      omega

/-- A torsion-free group has no finite-order element other than the identity. -/
def IsTorsionFreeGroup (G : Type) [Group G] : Prop :=
  ∀ g : G, g ≠ 1 → ¬ IsOfFinOrder g

/-- The paper's "abelian set": the subgroup generated by the set is abelian. -/
def IsAbelianSet {G : Type} [Group G] (X : Set G) : Prop :=
  ∀ a ∈ Subgroup.closure X, ∀ b ∈ Subgroup.closure X, a * b = b * a

/-- Conjecture 6.3 of Mohan-Neetu, with the finite set represented as a `Finset`. -/
def claim63 : Prop :=
  ∀ (G : Type) [Group G] [DecidableEq G], IsTorsionFreeGroup G →
    ∀ S : Finset G, 3 ≤ S.card → (1 : G) ∈ S →
      (S * S).card ≤ 3 * S.card - 3 → IsAbelianSet (S : Set G)

/-- Conjecture 6.1 of Mohan-Neetu, with `k = |S|`. -/
def claim61 : Prop :=
  ∀ (G : Type) [Group G] [DecidableEq G], IsTorsionFreeGroup G →
    ∀ S A B : Finset G, S.Nonempty → S = A ∪ B → Disjoint A B →
      IsAbelianSet (A : Set G) → IsAbelianSet (B : Set G) →
      (S * S).card ≤ 3 * S.card - 3 → IsAbelianSet (S : Set G)

/-- Conjecture 6.2 of Mohan-Neetu, with `k = |S|`. -/
def claim62 : Prop :=
  ∀ (G : Type) [Group G] [DecidableEq G], IsTorsionFreeGroup G →
    ∀ S A B C : Finset G, S.Nonempty → S = A ∪ B ∪ C →
      Disjoint A B → Disjoint A C → Disjoint B C →
      IsAbelianSet (A : Set G) → IsAbelianSet (B : Set G) →
      IsAbelianSet (C : Set G) →
      (S * S).card ≤ 3 * S.card - 4 → IsAbelianSet (S : Set G)

private theorem kleinBottleGroup_torsionFree :
    IsTorsionFreeGroup KleinBottleGroup := by
  rintro ⟨r, n⟩ hne hfin
  obtain ⟨k, hk, hpow⟩ := isOfFinOrder_iff_pow_eq_one.mp hfin
  have hone_n : (1 : KleinBottleGroup).n = 0 := rfl
  have hpown : ∀ j : ℕ, ((KleinBottleGroup.mk r n) ^ j).n = (j : ℤ) * n := by
    intro j
    induction j with
    | zero => simpa using hone_n
    | succ j ih =>
        rw [pow_succ]
        change ((KleinBottleGroup.mk r n) ^ j).n + n = ((j + 1 : ℕ) : ℤ) * n
        rw [ih]
        push_cast
        ring
  have hnprod : (k : ℤ) * n = 0 := by
    rw [← hpown k, hpow]
    rfl
  have hn : n = 0 := by
    rcases mul_eq_zero.mp hnprod with hkzero | hnzero
    · have hkz : (k : ℤ) ≠ 0 := by exact_mod_cast hk.ne'
      exact False.elim (hkz hkzero)
    · exact hnzero
  subst n
  have hone_r : (1 : KleinBottleGroup).r = 0 := rfl
  have hpowr : ∀ j : ℕ, ((KleinBottleGroup.mk r 0) ^ j).r = (j : ℤ) * r := by
    intro j
    induction j with
    | zero => simpa using hone_r
    | succ j ih =>
        rw [pow_succ]
        change ((KleinBottleGroup.mk r 0) ^ j).r +
            ((((KleinBottleGroup.mk r 0) ^ j).n).negOnePow : ℤ) * r =
          ((j + 1 : ℕ) : ℤ) * r
        have hnzero : ((KleinBottleGroup.mk r 0) ^ j).n = 0 := by
          simpa using hpown j
        rw [hnzero, ih]
        simp
        ring
  have hrprod : (k : ℤ) * r = 0 := by
    rw [← hpowr k, hpow]
    rfl
  have hr : r = 0 := by
    rcases mul_eq_zero.mp hrprod with hkzero | hrzero
    · have hkz : (k : ℤ) ≠ 0 := by exact_mod_cast hk.ne'
      exact False.elim (hkz hkzero)
    · exact hrzero
  subst r
  exact hne rfl

/-- The three-element counterexample refutes Conjecture 6.3. -/
theorem result63 : ¬ claim63 := by
  intro hclaim
  let x : KleinBottleGroup := ⟨0, 1⟩
  let y : KleinBottleGroup := ⟨1, 1⟩
  let S : Finset KleinBottleGroup := {1, x, y}
  have hx : x ∈ Subgroup.closure (S : Set KleinBottleGroup) :=
    Subgroup.subset_closure (by simp [S])
  have hy : y ∈ Subgroup.closure (S : Set KleinBottleGroup) :=
    Subgroup.subset_closure (by simp [S])
  have hnoncomm : x * y ≠ y * x := by decide
  have hab := hclaim KleinBottleGroup kleinBottleGroup_torsionFree S
    (by decide) (by decide) (by decide)
  exact hnoncomm (hab x hx y hy)

/-- Splitting the same counterexample into a two-element piece and a singleton
refutes Conjecture 6.1. -/
theorem result61 : ¬ claim61 := by
  intro hclaim
  let x : KleinBottleGroup := ⟨0, 1⟩
  let y : KleinBottleGroup := ⟨1, 1⟩
  let S : Finset KleinBottleGroup := {1, x, y}
  let A : Finset KleinBottleGroup := {1, x}
  let B : Finset KleinBottleGroup := {y}
  have hA : IsAbelianSet (A : Set KleinBottleGroup) := by
    let hcomm : IsMulCommutative (Subgroup.closure (A : Set KleinBottleGroup)) :=
      Subgroup.isMulCommutative_closure (by
        intro a ha b hb
        simp only [A, Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
          Set.mem_singleton_iff] at ha hb
        rcases ha with rfl | rfl <;> rcases hb with rfl | rfl <;> decide)
    intro a ha b hb
    exact congrArg Subtype.val (hcomm.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hB : IsAbelianSet (B : Set KleinBottleGroup) := by
    let hcomm : IsMulCommutative (Subgroup.closure (B : Set KleinBottleGroup)) :=
      Subgroup.isMulCommutative_closure (by
        intro a ha b hb
        simp only [B, Finset.coe_singleton, Set.mem_singleton_iff] at ha hb
        subst a
        subst b
        rfl)
    intro a ha b hb
    exact congrArg Subtype.val (hcomm.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hx : x ∈ Subgroup.closure (S : Set KleinBottleGroup) :=
    Subgroup.subset_closure (by simp [S])
  have hy : y ∈ Subgroup.closure (S : Set KleinBottleGroup) :=
    Subgroup.subset_closure (by simp [S])
  have hnoncomm : x * y ≠ y * x := by decide
  have hab := hclaim KleinBottleGroup kleinBottleGroup_torsionFree S A B
    (by decide) (by decide) (by decide) hA hB (by decide)
  exact hnoncomm (hab x hx y hy)

/-- Three singleton pieces in the paper's own family at `k = 3` refute
Conjecture 6.2. -/
theorem result62 : ¬ claim62 := by
  intro hclaim
  let x : KleinBottleGroup := ⟨1, 1⟩
  let y : KleinBottleGroup := ⟨2, 1⟩
  let z : KleinBottleGroup := ⟨3, 1⟩
  let S : Finset KleinBottleGroup := {x, y, z}
  let A : Finset KleinBottleGroup := {x}
  let B : Finset KleinBottleGroup := {y}
  let C : Finset KleinBottleGroup := {z}
  have singletonAbelian (w : KleinBottleGroup) :
      IsAbelianSet (({w} : Finset KleinBottleGroup) : Set KleinBottleGroup) := by
    let hcomm : IsMulCommutative
        (Subgroup.closure (({w} : Finset KleinBottleGroup) : Set KleinBottleGroup)) :=
      Subgroup.isMulCommutative_closure (by
        intro a ha b hb
        simp only [Finset.coe_singleton, Set.mem_singleton_iff] at ha hb
        subst a
        subst b
        rfl)
    intro a ha b hb
    exact congrArg Subtype.val (hcomm.is_comm.comm ⟨a, ha⟩ ⟨b, hb⟩)
  have hx : x ∈ Subgroup.closure (S : Set KleinBottleGroup) :=
    Subgroup.subset_closure (by simp [S])
  have hy : y ∈ Subgroup.closure (S : Set KleinBottleGroup) :=
    Subgroup.subset_closure (by simp [S])
  have hnoncomm : x * y ≠ y * x := by decide
  have hab := hclaim KleinBottleGroup kleinBottleGroup_torsionFree S A B C
    (by decide) (by decide) (by decide) (by decide) (by decide)
    (by simpa [A] using singletonAbelian x)
    (by simpa [B] using singletonAbelian y)
    (by simpa [C] using singletonAbelian z)
    (by decide)
  exact hnoncomm (hab x hx y hy)

example :
    (({1, KleinBottleGroup.mk 0 1, KleinBottleGroup.mk 1 1} :
        Finset KleinBottleGroup) *
      {1, KleinBottleGroup.mk 0 1, KleinBottleGroup.mk 1 1}) =
      {KleinBottleGroup.mk (-1) 2, KleinBottleGroup.mk 0 0,
        KleinBottleGroup.mk 0 1, KleinBottleGroup.mk 0 2,
        KleinBottleGroup.mk 1 1, KleinBottleGroup.mk 1 2} := by
  decide

example :
    (({KleinBottleGroup.mk 1 1, KleinBottleGroup.mk 2 1,
        KleinBottleGroup.mk 3 1} : Finset KleinBottleGroup) *
      {KleinBottleGroup.mk 1 1, KleinBottleGroup.mk 2 1,
        KleinBottleGroup.mk 3 1}) =
      {KleinBottleGroup.mk (-2) 2, KleinBottleGroup.mk (-1) 2,
        KleinBottleGroup.mk 0 2, KleinBottleGroup.mk 1 2,
        KleinBottleGroup.mk 2 2} := by
  decide

example :
    (KleinBottleGroup.mk 0 1) ^ 2 = (KleinBottleGroup.mk 1 1) ^ 2 := by
  decide

example :
    KleinBottleGroup.mk 0 1 * KleinBottleGroup.mk 1 1 =
      KleinBottleGroup.mk (-1) 2 := by
  decide

example :
    KleinBottleGroup.mk 1 1 * KleinBottleGroup.mk 0 1 =
      KleinBottleGroup.mk 1 2 := by
  decide

example :
    KleinBottleGroup.mk 1 1 * KleinBottleGroup.mk 2 1 =
      KleinBottleGroup.mk (-1) 2 := by
  decide

example :
    KleinBottleGroup.mk 2 1 * KleinBottleGroup.mk 1 1 =
      KleinBottleGroup.mk 1 2 := by
  decide

