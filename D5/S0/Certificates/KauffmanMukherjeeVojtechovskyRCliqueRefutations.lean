/-- Every right translation is bijective, and multiplication is right self-distributive. -/
def IsRack {Q : Type} (mul : Q → Q → Q) : Prop :=
  (∀ y, Function.Bijective (fun x => mul x y)) ∧
    ∀ x y z, mul (mul x y) z = mul (mul x z) (mul y z)

/-- The two right translations commute as permutations, expressed pointwise. -/
def RCommute {Q : Type} (mul : Q → Q → Q) (a b : Q) : Prop :=
  ∀ x, mul (mul x a) b = mul (mul x b) a

/-- Every two members, including equal members, R-commute. -/
def IsRClique {Q : Type} (mul : Q → Q → Q) (C : Finset Q) : Prop :=
  ∀ a ∈ C, ∀ b ∈ C, RCommute mul a b

/-- Maximality is with respect to inclusion, not maximum cardinality. -/
def IsMaximalRClique {Q : Type} (mul : Q → Q → Q) (C : Finset Q) : Prop :=
  IsRClique mul C ∧ ∀ D, IsRClique mul D → C ⊆ D → D = C

/-- Transitivity encoded by finite positive words of right translations.
For finite racks each right translation has finite order, so its inverse is a
positive power: this is the page-17 right-multiplication-group reading. -/
def Connected {Q : Type} (mul : Q → Q → Q) : Prop :=
  ∀ x y : Q, ∃ l : List Q, l.foldl mul x = y

/-- The universal equal-size reading of Problem 5.22. -/
def claim22 : Prop :=
  ∀ (Q : Type) [Fintype Q] [DecidableEq Q] (mul : Q → Q → Q),
    IsRack mul → Connected mul → ∀ C D : Finset Q,
      IsMaximalRClique mul C → IsMaximalRClique mul D → C.card = D.card

/-- The negation of the existential assertion asked about in Problem 5.24.
Refuting this universal divisibility assertion answers that question Yes. -/
def claim24 : Prop :=
  ∀ (Q : Type) [Fintype Q] [DecidableEq Q] (mul : Q → Q → Q),
    IsRack mul → Connected mul → ∀ C : Finset Q,
      IsMaximalRClique mul C → C.card ∣ Fintype.card Q

