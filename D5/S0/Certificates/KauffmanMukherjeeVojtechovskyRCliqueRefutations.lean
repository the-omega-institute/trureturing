private def words22 : Fin 105 → List (Fin 105) :=
  ![[], [5, 12], [4, 9], [7, 8], [13], [10], [4, 5], [12], [9], [8], [5], [4, 7], [7], [4], [5, 8], [33, 36], [55], [58], [63], [8, 39], [7, 42], [48], [5, 40], [4, 43], [5, 33], [4, 59], [95], [4, 33], [5, 56], [80], [18, 21], [56], [59], [60], [5, 101], [4, 86], [45], [4, 26], [5, 29], [8, 19], [5, 22], [92], [7, 20], [4, 23], [77], [36], [8, 78], [7, 93], [21], [5, 74], [4, 71], [18, 33], [24], [27], [99], [4, 22], [5, 28], [84], [5, 23], [4, 25], [33], [5, 79], [4, 94], [18], [4, 24], [5, 27], [21, 36], [25], [28], [96], [7, 19], [4, 50], [81], [8, 20], [5, 49], [5, 35], [4, 98], [44], [8, 46], [5, 61], [29], [72], [4, 21], [5, 91], [57], [7, 18], [4, 35], [20, 23], [19], [22], [4, 34], [5, 83], [41], [7, 47], [4, 62], [26], [69], [5, 21], [4, 76], [54], [8, 18], [5, 34], [19, 22], [20], [23]]

private def back22 (i : Fin 105) : List (Fin 105) :=
  (words22 i).reverse

private def clique22A : Finset (Fin 105) := {0, 16, 32, 52, 68, 88, 104}

private def clique22B : Finset (Fin 105) := {0, 1, 2, 15, 16, 17, 30, 31, 32}

/-- Refutation of the universal reading of Problem 5.22. -/
theorem result22 : ¬ claim22 := by
  have hpoint : ∀ i j : Fin 105, ∀ x : Fin 8,
      elt22 (table22 i j) x = ((elt22 j)⁻¹ * elt22 i * elt22 j) x := by
    intro i
    fin_cases i <;> decide +kernel
  have htable : ∀ i j, elt22 (table22 i j) = (elt22 j)⁻¹ * elt22 i * elt22 j := by
    intro i j
    exact Equiv.ext (hpoint i j)
  have hinj : Function.Injective elt22 := by
    have h : ∀ i j : Fin 105, (∀ x : Fin 8, elt22 i x = elt22 j x) → i = j := by
      intro i
      fin_cases i <;> decide +kernel
    intro i j hij
    exact h i j (fun x => congrArg (fun p : Equiv.Perm (Fin 8) => p x) hij)
  have hrack : IsRack table22 := by
    refine ⟨?_, ?_⟩
    · intro y
      have hi : Function.Injective (fun x => table22 x y) := by
        intro a b hab
        apply hinj
        have he := congrArg elt22 hab
        rw [htable, htable] at he
        exact mul_left_cancel (mul_right_cancel he)
      exact ⟨hi, (Finite.injective_iff_surjective).mp hi⟩
    · intro x y z
      apply hinj
      simp only [htable]
      group
  have hforward : ∀ i : Fin 105, (words22 i).foldl table22 0 = i := by
    decide +kernel
  have hback : ∀ i : Fin 105, (back22 i).foldl table22 i = 0 := by
    decide +kernel
  have hconnected : Connected table22 := by
    intro x y
    refine ⟨back22 x ++ words22 y, ?_⟩
    rw [List.foldl_append, hback, hforward]
  have hmax : ∀ C : Finset (Fin 105), IsRClique table22 C →
      (∀ b, b ∉ C → ∃ a ∈ C, ¬ RCommute table22 a b) →
      IsMaximalRClique table22 C := by
    intro C hc hb
    refine ⟨hc, ?_⟩
    intro D hd hCD
    apply Finset.Subset.antisymm
    · intro b hbD
      by_contra hbC
      obtain ⟨a, haC, hab⟩ := hb b hbC
      exact hab (hd a (hCD haC) b hbD)
    · exact hCD
  have hA : IsMaximalRClique table22 clique22A := by
    apply hmax
    · unfold IsRClique RCommute
      decide +kernel
    · unfold RCommute
      decide +kernel
  have hB : IsMaximalRClique table22 clique22B := by
    apply hmax
    · unfold IsRClique RCommute
      decide +kernel
    · unfold RCommute
      decide +kernel
  intro hclaim
  have heq := hclaim (Fin 105) table22 hrack hconnected clique22A clique22B hA hB
  exact (by decide +kernel : clique22A.card ≠ clique22B.card) heq

end D5.S0.Certificates.KauffmanMukherjeeVojtechovskyRCliqueRefutations
