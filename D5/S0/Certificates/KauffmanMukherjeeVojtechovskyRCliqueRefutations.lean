/-- Refutation of the universal reading of Problem 5.24. -/
theorem result24 : ¬ claim24 := by
  have hpoint : ∀ i j : Fin 70, ∀ x : Fin 7,
      elt24 (table24 i j) x = ((elt24 j)⁻¹ * elt24 i * elt24 j) x := by
    intro i
    fin_cases i <;> decide +kernel
  have htable : ∀ i j, elt24 (table24 i j) = (elt24 j)⁻¹ * elt24 i * elt24 j := by
    intro i j
    exact Equiv.ext (hpoint i j)
  have hinj : Function.Injective elt24 := by
    have h : ∀ i j : Fin 70, (∀ x : Fin 7, elt24 i x = elt24 j x) → i = j := by
      intro i
      fin_cases i <;> decide +kernel
    intro i j hij
    exact h i j (fun x => congrArg (fun p : Equiv.Perm (Fin 7) => p x) hij)
  have hrack : IsRack table24 := by
    refine ⟨?_, ?_⟩
    · intro y
      have hi : Function.Injective (fun x => table24 x y) := by
        intro a b hab
        apply hinj
        have he := congrArg elt24 hab
        rw [htable, htable] at he
        exact mul_left_cancel (mul_right_cancel he)
      exact ⟨hi, (Finite.injective_iff_surjective).mp hi⟩
    · intro x y z
      apply hinj
      simp only [htable]
      group
  have hforward : ∀ i : Fin 70, (words24 i).foldl table24 0 = i := by
    decide +kernel
  have hback : ∀ i : Fin 70, (back24 i).foldl table24 i = 0 := by
    decide +kernel
  have hconnected : Connected table24 := by
    intro x y
    refine ⟨back24 x ++ words24 y, ?_⟩
    rw [List.foldl_append, hback, hforward]
  have hmax : ∀ C : Finset (Fin 70), IsRClique table24 C →
      (∀ b, b ∉ C → ∃ a ∈ C, ¬ RCommute table24 a b) →
      IsMaximalRClique table24 C := by
    intro C hc hb
    refine ⟨hc, ?_⟩
    intro D hd hCD
    apply Finset.Subset.antisymm
    · intro b hbD
      by_contra hbC
      obtain ⟨a, haC, hab⟩ := hb b hbC
      exact hab (hd a (hCD haC) b hbD)
    · exact hCD
  have hA : IsMaximalRClique table24 clique24A := by
    apply hmax
    · unfold IsRClique RCommute
      decide +kernel
    · unfold RCommute
      decide +kernel
  intro hclaim
  have hdiv := hclaim (Fin 70) table24 hrack hconnected clique24A hA
  exact (by decide +kernel : ¬ (clique24A.card ∣ Fintype.card (Fin 70))) hdiv

